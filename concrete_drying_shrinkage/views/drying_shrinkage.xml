<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="dring_shrinkage_mechanical1_view" model="ir.ui.view">
        <field name="name">drying.shrinkage.form</field>
        <field name="model">drying.shrinkage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                   <div >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade"/>
                    </group>
                    <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    
                    <!-- Drying Shrinkage -->

                    <div  invisible = "drying_shrinkage_visible == False">
                        <h1 class="text-center"> 
                            <field name="drying_shrinkage_name" readonly="1" nolabel="1"/>
                            <field name="drying_shrinkage_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="custom_table_borders" invisible = "drying_shrinkage_visible == False">
                        <field name="drying_child_lines" nolabel="1" >
                        <tree editable="bottom">
                           <field name="sr_no" />
                          <field name="id_mark" class="blue-input" decoration-info="id_mark != 0" width="200"/>
                          <field name="original_length" class="blue-input" decoration-info="original_length != 0"/>
                          <field name="dry_mesurment" class="blue-input" decoration-info="dry_mesurment != 0"/>
                          <field name="dry_length" class="blue-input" decoration-info="dry_length != 0"/>
                          <field name="initial_drying" />
                        </tree>
                        </field>
                    </div>


                    <table invisible = "drying_shrinkage_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                    <td><label class="fw-bold" for="average1">Average</label></td>
                                    <td><field name="average1"/></td>
                                </tr>
                         
                            <tr>
                                <td><label class="fw-bold" for="drying_shrinkage_conformity"></label></td>
                                <td>
                                    <field name="drying_shrinkage_conformity"
                                        decoration-success="drying_shrinkage_conformity == 'pass'"
                                        decoration-danger="drying_shrinkage_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="drying_shrinkage_nabl"></label></td>
                                <td><field name="drying_shrinkage_nabl"
                                            decoration-success="drying_shrinkage_nabl == 'pass'"
                                            decoration-danger="drying_shrinkage_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                           
                        </tbody>
                    </table>
                    
                    


                    <!-- Moisture Movement -->
                    <div  invisible = "moisture_movement_visible == False">
                        <h1 class="text-center"> 
                            <field name="moisture_movement_name" readonly="1" nolabel="1"/>
                            <field name="moisture_movement_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="custom_table_borders" invisible = "moisture_movement_visible == False">
                        <field name="moisture_child_lines" nolabel="1" >
                        <tree editable="bottom">
                          <field name="sr_no" />
                          <field name="id_mark" class="blue-input" decoration-info="id_mark != 0" width="200"/>
                          <field name="final_wet" class="blue-input" decoration-info="final_wet != 0"/>
                          <field name="moisture_movement" />
                        </tree>
                        </field>
                    </div>


                    <table invisible = "moisture_movement_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                    <td><label class="fw-bold" for="average2">Average</label></td>
                                    <td><field name="average2"/></td>
                                </tr>
                         
                            <tr>
                                <td><label class="fw-bold" for="moisture_movement_conformity"></label></td>
                                <td>
                                    <field name="moisture_movement_conformity"
                                        decoration-success="moisture_movement_conformity == 'pass'"
                                        decoration-danger="moisture_movement_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="moisture_movement_nabl"></label></td>
                                <td><field name="moisture_movement_nabl"
                                            decoration-success="moisture_movement_nabl == 'pass'"
                                            decoration-danger="moisture_movement_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                           
                        </tbody>
                    </table>

                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>
                    
                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                    />

                </sheet>
            </form>
        </field>
        </record>

