<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="stainless_steel_tmt_bar_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->
				<div class="container_eln" style="padding-top:20px">
					<div t-foreach="eln" t-as="o">
						<table style="margin-top:10px; border:none">
							<tr>
								<td colspan="2" style=" font-weight: bold;">Client Details:</td>
								<td colspan="10">
									<span t-field="o.srf_id.customer.name"/><br />
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
									,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style=" font-weight: bold;">Client Reference:</td>
								<td colspan="10"><span t-field="o.srf_id.client_refrence"/></td>
							</tr>

							<tr>
								<td colspan="2" style=" font-weight: bold;">Name of Work:</td>
								<td colspan="10"><span t-field="o.srf_id.name_work"/></td>
							</tr>
							<tr>
								<td colspan="2" style=" font-weight: bold;">Date of Testing:</td>
								<td colspan="10">
									<span t-field="o.start_date"/> to <span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Size:</td>
								<td colspan="10">
									<span t-field="o.sample_id.size_id"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Grade:</td>
								<td colspan="10">
									<span t-field="o.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Material/Test Name:</td>
								<td colspan="10">
									<span t-field="o.material.name"/>
								</td>
							</tr>

							<!-- Source of Sample (only if value exists) -->
							<tr t-if="o.material.source_sample">
								<td colspan="2" style="font-weight: bold;">Source of Sample</td>
								<td colspan="10">
									<span t-field="o.material.source_sample"/>
								</td>
							</tr>

							<!-- Test method adopted (only if value exists) -->
							<tr t-if="o.material.test_method_adopted">
								<td colspan="2" style="font-weight: bold;">Test method adopted:</td>
								<td colspan="10">
									<span t-field="o.material.test_method_adopted"/>
								</td>
							</tr>

						</table>

					</div>
				
					<div style="">
						<table class="table table-sm table-bordered" style="margin-top:20px; width: 100%;">
							<thead>
								<tr>
									<th style="text-align: center;">Dia of Bar</th>
									<th style="text-align: center;">Yield Stress</th>
									<th style="text-align: center;">Ultimate Tensile Stress</th>
									<th style="text-align: center;">Elongation</th>
									<th style="text-align: center;">Weight kg/m (Min.)</th>
									<th style="text-align: center;">Bend &amp; Rebend Test</th>
								</tr>
							</thead>
							<tbody>
								<!-- <t t-foreach="data.bar_test_line_ids.filtered(lambda l: l.yield_stress &gt; 0 and l.ultimate_tensile_stress &gt; 0 and l.elongation &gt; 0)" t-as="line">
									<tr>
										<td><t t-esc="line.dia_of_bar"/></td>
										<td><t t-esc="line.yield_stress"/></td>
										<td><t t-esc="line.ultimate_tensile_stress"/></td>
										<td><t t-esc="line.elongation"/></td>
										<td><t t-esc="line.weight_kg_min"/></td>
										<td><t t-esc="line.bend_test"/></td>
									</tr>
								</t> -->
								<t t-foreach="grouped_bar_lines" t-as="group">
									<t t-set="dia" t-value="group[0]"/>
									<t t-set="lines" t-value="group[1]"/>
									<t t-set="first" t-value="True"/>
									<t t-foreach="lines" t-as="line">
										<tr >
											<t t-if="first">
												<td t-att-rowspan="len(lines)" style="text-align: center; vertical-align: middle;"><t t-esc="dia"/></td>
											</t>
											<td style="text-align: center;"><t t-esc="line.yield_stress"/></td>
											<td style="text-align: center;"><t t-esc="line.ultimate_tensile_stress"/></td>
											<td style="text-align: center;"><t t-esc="line.elongation"/></td>
											
										<!-- Weight kg/m (merged) -->
											<t t-if="first">
												<td t-att-rowspan="len(lines)" style="text-align: center; vertical-align: middle;"><t t-esc="line.weight_kg_min"/></td>
											</t>
											
											<!-- Bend Test (merged) -->
											<t t-if="first">
												<td t-att-rowspan="len(lines)" style="text-align: center; vertical-align: middle;"><t t-esc="line.bend_test"/></td>
												<t t-set="first" t-value="False"/>
											</t>
										</tr>
									</t>
								</t>

							</tbody>
						</table>
						<table class="table table-sm table-bordered" style="width: 100%; text-align: center; font-size: 12px;">
							<thead>
								<tr>
									<th rowspan="2">Grade</th>
									<th rowspan="2">0.2 % Proof/ Yield Stress<br/>(N/mm<sup>2</sup>) (Min.)</th>
									<th rowspan="2">Ultimate Tensile Stress<br/>(N/mm<sup>2</sup>) (Min.)</th>
									<th rowspan="2">Elongation (%)<br/>(Min.)</th>
									<!-- <th t-att-colspan="len(bar_lines)">Dia (mm)</th>
									<th t-att-colspan="len(bar_lines)">Unit Weight (Kg/m)</th> -->

								</tr>
								<tr>
									<t t-foreach="bar_lines" t-as="line">
										<td><t t-esc="line.dia_of_bar"/></td>
									</t>
									<t t-foreach="bar_lines" t-as="line">
										<td><t t-esc="line.weight_kg_min"/></td>
									</t>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Fe 500D</td>
									<td>500</td>
									<td>≥ 1.10, but UTS not less than 565.0 N/mm²</td>
									<td>16.00</td>
									<t t-foreach="bar_lines" t-as="line">
										<td>-</td> <!-- empty placeholder to maintain structure -->
									</t>
									<t t-foreach="bar_lines" t-as="line">
										<td>-</td>
									</t>
								</tr>
							</tbody>
						</table>
					</div>
						
					<div style="margin-top:5px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Note:-</b>
									&#160;&#160;(i) The results relate only to the items tested 
									&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
									&#160;&#160;(iii) Any corrections invalidate the test reports 
									&#160;&#160;(iv) Any Query regarding the report must be reported immediately. 
									&#160;&#160;(v) * mark indicate tests which are not in the scope of NABL. 
									&#160;&#160;(vi) # mark indicates Details given by Client.
									<t t-if="eln.has_witness">
										&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
									</t>
									<t t-if="eln.remarks">
										&#160;&#160;<span t-esc="eln.remarks"/>
									</t>
								</td>
							</tr>
						</table>
					</div>
					<div class="signatureContainer girdgird">
						<div>
							<div>
								<b>
									Checked By
								</b>
							</div>
							<div style="height:40px">

							</div>
							<div>
								<b>
									<span t-esc="eln.technician.name"/>
								</b>
							</div>
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
						<div>
							<div>
								<b>
									Approved By 
								</b>
								
							</div>
							<div style="height:40px">

							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>
						
							<div>
								<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>
					<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>
				</div>


			</t>
		</t>
	</template>



