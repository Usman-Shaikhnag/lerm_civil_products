<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_stainless_stee_view" model="ir.ui.view">
        <field name="name">mechanical.stainless.steel.tmt.bar.form</field>
        <field name="model">mechanical.stainless.steel.tmt.bar</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                        <h1>
                            <field name='name' readonly="1"/>
                        </h1>                       
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                         <field name='eln_ref' readonly="1"/>
                         
                            <group>
                                <group>
                                    <field name='Id_no' invisible="1"/>
                                </group>
                                <group>
                                    <field name='grade'/>
                                </group>
                                <group>
                                    <field name='size'/>
                                </group>
                                
                            </group>
                            <group>
                                <field name="sample_parameters">
                                    <tree>
                                        <field name="parameter_name"/>
                                        <field name="test_method"/>
                                    </tree>
                                </field>
                            </group>
                             <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                            <field name="bar_test_line_ids">
                                <tree editable="botttom"> 
                                    <field name="dia_of_bar"  class="blue-input" decoration-info="dia_of_bar != 0"/>
                                    <field name="yield_stress"  class="blue-input" decoration-info="yield_stress != 0"/>
                                    <field name="ultimate_tensile_stress"  class="blue-input" decoration-info="ultimate_tensile_stress != 0" />
                                    <field name="elongation"  class="blue-input" decoration-info="elongation != 0" />
                                    <field name="weight_per_meter"/>
                                    <field name="weight_kg_min"/>
                                    <field name="bend_test"/>
                                </tree>
                            </field>
                            <button name="open_add_bar_line_wizard"
                                    string="Add TMT Line"
                                    type="object"
                                    class="oe_highlight"/>




                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                            <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
              

                </sheet>
            </form>
        </field>
    </record>

   
    <record id="view_stainless_tmt_bar_wizard_form" model="ir.ui.view">
        <field name="name">stainless.tmt.bar.wizard.form</field>
        <field name="model">stainless.tmt.bar.wizard</field>
        <field name="arch" type="xml">
            <form string="Add TMT Bar Line">
                <group>
                    <field name="dia_of_bar"  class="blue-input" decoration-info="dia_of_bar != 0"/>
                    <field name="yield_stress"  class="blue-input" decoration-info="yield_stress != 0"/>
                    <field name="ultimate_tensile_stress"  class="blue-input" decoration-info="ultimate_tensile_stress != 0"/>
                    <field name="elongation"  class="blue-input" decoration-info="elongation != 0"/>
                </group>
                <footer>
                    <button name="action_add_bar_line" type="object" string="Add Line" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="view_ss_tmt_prefill_data_form" model="ir.ui.view">
            <field name="name">stainless.steel.tmt.bar.prefill.data.form</field>
            <field name="model">stainless.steel.tmt.bar.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_ss_tmt_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stainless.steel.tmt.bar.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_ss_tmt_prefill_data_form"/>
            <field name="target">new</field>
        </record>



    </data>
</odoo>