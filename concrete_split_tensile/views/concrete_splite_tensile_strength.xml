<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_concrete_split_tensile" model="ir.ui.view">
        <field name="name">mechanical.concrete.split.tensile.form</field>
        <field name="model">mechanical.concrete.split.tensile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                   <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" exception="grade"  string="Grade" identity="extra"/> 
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_casting"></label></td>
                                    <td><field name="date_of_casting" /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_testing"></label></td>
                                    <td><field name="date_of_testing" class="blue-input" decoration-info="date_of_testing != 0" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        </div>

                        <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="age_of_days"></label></td>
                                    <td><field name="age_of_days" /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="age_of_test"></label></td>
                                    <td><field name="age_of_test" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        </div>

                        <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="difference"></label></td>
                                    <td><field name="difference" /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                       
                        </div>


                    <!-- <group>
                        <group>
                            <field name="date_of_casting"  string="Date of Casting" identity="extra"/>
                        </group>
                        <group style="width:30%">
                            <field name="date_of_testing"  string="Date of Testing" identity="extra"/>
                        </group>
                        <group>
                            <field name="age_of_days"/>
                        </group>
                        <group>
                            <field name="age_of_test"/>
                        </group>
                        <group>
                            <field name="difference"/>
                        </group> -->
                         <!-- <group>
                         <field name='sample_condition'/>
                        </group> -->
                    <!-- </group> -->
                    
                    <!-- Splite Tensile -->
                    <div invisible="not splite_tensile_visible">
                        <h1 class="text-center">
                            <field name="splite_tensile_name" readonly="1" nolabel="1"/>
                            <field name="splite_tensile_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible="not splite_tensile_visible">

                        <field name="child_lines" nolabel="1" class="custom_table_borders">
                            <tree editable="bottom">
                                <field name='sr_no' string="Sr. NO"/>
                                <field name='id_mark' string="ID Mark/Location" class="blue-input" decoration-info="id_mark != 0"/>

                                <field name='wt_of_cylender' class="blue-input" decoration-info="wt_of_cylender != 0"/>

                                <field name='height' class="blue-input" decoration-info="height != 0"/>

                                <field name='diameter' class="blue-input" decoration-info="diameter != 0"/>
                                
                                <field name='breaking_load' class="blue-input" decoration-info="breaking_load != 0"/>
                                
                                <field name='split_strength'/>
                            </tree>
                        </field> 
                       
                    </div>


                        <table invisible="not splite_tensile_visible" class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_split_tensile"></label></td>
                                    <td><field name="average_split_tensile"  /></td>
                                </tr>
                                <tr>
                                   <td><label for="confirmity"></label></td>
                                   <td><field name='confirmity' decoration-success="confirmity == 'pass'"  decoration-danger="confirmity == 'fail'"  readonly="1"/></td>
                                </tr>
                                 <tr>
                                   <td><label for="nabl"></label></td>
                                   <td><field name='nabl' decoration-success="nabl == 'pass'"  decoration-danger="nabl == 'fail'"  readonly="1"/></td>
                                </tr>
                              </tbody>                     
                             </table>


                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>
                        

                    
                   
                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
               
            
                </sheet>
            </form>
        </field>
        </record>

         <record id="mechanical_concrete_split_tensile_line_view" model="ir.ui.view">
        <field name="name">mechanical.concrete.split.tensile.line.form</field>
        <field name="model">mechanical.concrete.split.tensile.line</field>
        <field name="arch" type="xml">
            <form>
            <group>
            <group>
            <field name='sr_no' string="Sr. NO"/>
                <field name='id_mark' string="ID Mark/Location"/>
                <field name='wt_of_cylender' string="Weight of Cylinder Kg"/>
                <field name='height' string="Height mm"/>
                <field name='diameter' string="Diameter mm"/>
            </group>
            <group>
                <field name='breaking_load' string="Breaking Load KN"/>
                <field name="split_strength" string="Split Tensile Strength N/mm2"/>
                <!-- <field name='compressive_strength' string="Compressive Strength N/mm²"/> -->
                <field name="parent_id" invisible="1"/>
            </group>
            </group>
                
            </form>
        </field>
    </record>
  

    </data>
</odoo>