<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	   <template id="ferrous_inclusion_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:2px;">
					<div class="" t-foreach="eln" t-as="o">
						 	<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr style="height:10px;">
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">--</t>
		                            <br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 60px;"/>
									</td>
								
							</tr>
							<tr t-if="o.srf_id.name_work">
								<td colspan="1" >Project Name:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
									</td>
							</tr>

							<tr t-if="o.srf_id.client">
								<td colspan="1" >Name of Agency:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
									</td>
							</tr>
							
							<tr>
								

								<td style="width:20%;">Letter No :-</td>
								<td style="width:20%;">

								  <t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">--</t>
								
								</td>
								<td>Letter Date :-</td>
								<td>
									

									<t t-if="o.srf_id.letter_date">
											<span t-field="o.srf_id.letter_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>

							<tr>

								<td>SRF No. :-</td>
										<td >

											<t t-if="o.srf_id">
											<span t-field="o.srf_id"/>
										</t>
									<t t-else="">--</t>
										</td>
								<td>SRF Date:-</td>
								<td>

									<t t-if="o.srf_date">
											<span t-field="o.srf_date"/>
										</t>
								</td>

								
								
							</tr>
								

								<td style="width:20%;">Temperature :-</td>
								<td style="width:20%;">

								  <t t-if="data.temprature">
											<span t-field="data.temprature"/> (°C)
										</t>
									<t t-else="">--</t>
								
								</td>
								<td>Humidity :-</td>
								<td>
									

									<t t-if="data.humidity">
											<span t-field="data.humidity"/>  (%)
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								<td style="width:20%;">Discipline :
									
								</td>
								<td style="width:20%;">
								<span t-field="o.discipline.discipline"/>
								</td>

								<td style="width:20%;">Group :	
								</td>
								<td style="width:20%;">
									<span t-field="o.group.group"/>
								
								</td>
							</tr>

							<tr>
								<td>Brand &amp; Grade :-</td>
								<td>
								<t t-if="o.sample_id.grade_id.grade">
											<span t-field="o.sample_id.grade_id.grade"/>
										</t>
									<t t-else="">--</t>
									</td>

								<td>Size  :-</td>
								<td>

										<t t-if="o.sample_id.size_id.size">
											<span t-field="o.sample_id.size_id.size"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							

							<tr>
								<td>Date of Samples Received :-</td>
								<td>

									<t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								</td>

									<td>Sample Condition :-</td>
										<td >

											<t t-if="data.sample_condition">
											<span t-field="data.sample_condition"/>
										</t>
									<t t-else="">--</t>
										</td>
								
							</tr>

							<tr>
								

								<td colspan="1">Samples Description :-</td>
								<td colspan="3">

								        <t t-if="data.product_name">
											<span t-field="data.product_name"/>
										</t>
								      
								</td>
								
							</tr>
							<tr>
								

								<td colspan="1">Sub Group  :-</td>
								<td colspan="3">
								      <t t-if="o.material and o.material.lab_name">
											<span t-field="o.material.lab_name"/>
										</t>
								</td>
								
							</tr>

							<tr>

								<td >Sample Status :-</td>
								<td >

								        <t t-if="data.sample_status">
											<span t-field="data.sample_status"/>
										</t>
								      
								</td>
								
								<td>No. of Sample :-</td>
								<td>

								<t t-if="o.sample_id.sample_qty">
											<span t-field="o.sample_id.sample_qty"/>
										</t>
									<t t-else="">--</t>

								<t t-if="o.sample_id.uom_id">
											<span t-field="o.sample_id.uom_id"/>
										</t>
									<t t-else="">--</t>
								
								</td>

							

								
							</tr>

							

							<tr>
								
								<td>Test Start Date  :-</td>
								<td>

									<t t-if="o.start_date">
											<span t-field="o.start_date"/>
										</t>
									<t t-else="">--</t>
								</td>

								<td>Test Completion Date  :-</td>
								<td>

									<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							
						
							<tr t-if="o.material.test_method_adopted" >
								

									<td >Test method adopted:</td>
									<td colspan="3"><span t-field="o.material.test_method_adopted"/></td>

							
							</tr>
							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

								<tr t-if="o.material.specification_code">
									<td style="font-weight: bold;">Specifications</td>
									<td colspan="3"><span t-field="o.material.specification_code"/></td>
								</tr>

						</table>
					</div>

                   

                   <div style="text-align: center; font-weight: bold; margin-top: 2px; font-size: 16px;">
					INCLUSION TEST RESULT 
					</div>


					<div style="margin-top:2px"  invisible="feroous_inclusion_visible == False">
                       
                        <table>

						<tr >
                  <td colspan="10">
                  <b>Inclusion rating A to D by microscopic method</b>
                 </td>
                                
                                
                </tr>
					<tr cols="12">
                    <td  style="text-align: center;"><b>Sr No.</b></td>
                    <td   style="text-align: center;"><b>Sample  Identity</b></td>
                    <td   style="text-align: center;" colspan="2"><b>Type-A (Sulphide) </b></td>
                    <td   style="text-align: center;" colspan="2"><b>Type-B ( Alumina)</b></td>
                    <td   style="text-align: center;" colspan="2"><b>Type-C ( Silicate)</b></td>
                    <td   style="text-align: center;" colspan="2"><b>Type-D ( Globular Oxide)</b></td>
                    
                    
                </tr>

                <tr>
					
                    <td  style="text-align: center;">--</td>
                    <td   style="text-align: center;">--</td>
                    <td   style="text-align: center;" colspan="1"><b>Thin</b></td>
                    <td   style="text-align: center;" colspan="1"><b>Thick</b></td>

                     <td   style="text-align: center;" colspan="1"><b>Thin</b></td>
                    <td   style="text-align: center;" colspan="1"><b>Thick</b></td>

                     <td   style="text-align: center;" colspan="1"><b>Thin</b></td>
                    <td   style="text-align: center;" colspan="1"><b>Thick</b></td>

                     <td   style="text-align: center;" colspan="1"><b>Thin</b></td>
                    <td   style="text-align: center;" colspan="1"><b>Thick</b></td>
                  
                    
                    
                </tr>

							

                            
						
                    <t t-set="f" t-value="0"/>
                    <tr t-foreach="data.feroous_inclusion_lines" t-as="r">
                        <td  style="text-align: center;">
                            <div>
                                <span t-esc="f + 1" />
                                <t t-set="f" t-value="f + 1"/>
                            </div>
                        </td>
                        <td  style="text-align: center;">
                            <span t-esc="r['sample_identity']"/>
                        </td>
                      <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_a_thin']"/>
                        </td>
                        <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_a_thick']"/>
                        </td>
                        <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_b_thin']"/>
                        </td>
                        <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_b_thick']"/>
                        </td>

                        <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_c_thin']"/>
                        </td>
                        <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_c_thick']"/>
                        </td>
                        <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_d_thin']"/>
                        </td>
                        <td  style="text-align: center;" colspan="1">
                            <span t-esc="r['type_d_thick']"/>
                        </td>
                       
                        
                        
                    </tr>



							
                        </table>
                       
                    </div>

					 <!-- Images below table -->
							<div style="margin-top: 10px; text-align: center;">
						<table style="width: 100%; border-collapse: collapse;">
							<tr>
								<td style="width: 50%; text-align: center;">
									<b>Original Image</b>
								</td>
								<td style="width: 50%; text-align: center;">
									<b>Processed Image</b>
								</td>
							</tr>
							<tr>
								<td style="width: 50%; text-align: center; vertical-align: middle;">
									<t t-if="data.original_image">
										<img t-att-src="'data:image/png;base64,' + data.original_image.decode('utf-8')"
											style="width: 150px; height: 150px; object-fit: contain;"/>
									</t>
								</td>

								<td style="width: 50%; text-align: center; vertical-align: middle;">
									<t t-if="data.processed_image">
										<img t-att-src="'data:image/png;base64,' + data.processed_image.decode('utf-8')"
											style="width: 150px; height: 150px; object-fit: contain;"/>
									</t>
								</td>
							</tr>
						</table>
					</div>

										

				
					<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>
							


					


						<div style="margin-top:0;padding:0;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 30px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 30px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<!-- <span t-esc="eln.technician.name"/> -->
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

								<!-- QR Code -->
							<!-- <div style="text-align:center; margin-bottom:10px;">
								<img t-att-src="'data:image/png;base64,%s' % (qrcode_static or '')"
									style="width:75px; height:70px;"/>
							</div> -->

							<t t-if="o.sample_id.stamp_attached">
							<div >
								<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div>
							</div>
						</t>


							<div>
								<div>
									<b>
										Approved By 
									</b>
								</div>
								<div style="height: 30px;">
									<t t-if="eln.sample_id.approveby_signature_required">
										<div t-if="eln.sample_id.approved_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 30px;margin-top:1px;margin-bottom:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
							</div>
						</div>
						
					</div>
				<!-- </div> -->
			</t>
		</t>
	</template>
</odoo>