<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <record id="mechanical_cover_block_form" model="ir.ui.view">
        <field name="name">mechanical.cover.block.form</field>
        <field name="model">mechanical.cover.block</field>
        <field name="arch" type="xml">
            <form create="false"> 

                <sheet>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="size_id"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;
                            border-color: #3b82f6 !important;
                        }

                        .o_list_view .o_data_cell.blue-input {
                            background-color: #d8ecff !important;
                            border-color: #3b82f6 !important;
                        }

                        .o_list_view .o_data_cell.blue-input input {
                            background-color: #d8ecff !important;
                            border-color: #3b82f6 !important;
                        }
                    </style>

                    <!-- Water Absorption -->

                    <group invisible="not water_absorption_visible" style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                        </h1>
                    </group>

                    <div class="custom_table_borders" style="width: 100%;" invisible="not water_absorption_visible">
                        <field name="water_absorption_child_lines" mode="tree" nolabel="1">
                            <tree editable="bottom" class="custom_table_borders" style="width: 100%; border-collapse: collapse;">
                                <field name="serial_no"/>
                                <field name="sample_identification" class="blue-input" decoration-info="sample_identification != 0"/>
                                <field name="dry_wt_w1" class="blue-input" decoration-info="dry_wt_w1 != 0"/>
                                <field name="wet_w2" class="blue-input" decoration-info="wet_w2 != 0"/>
                                <field name="water_absorption"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"
                           style="margin-top:20px;" invisible="not water_absorption_visible">
                        <tbody>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avg_water_absorption">Avg. Water Absorption</label>
                                </td>
                                <td>
                                    <field name="avg_water_absorption"/> <span> %</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"
                           style="margin-top:20px;" invisible="not water_absorption_visible">
                        <tbody>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avg_water_absorption_conformity">NABL</label>
                                </td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                           decoration-success="avg_water_absorption_conformity == 'pass'"
                                           decoration-danger="avg_water_absorption_conformity == 'fail'"
                                           readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avg_water_absorption_nabl">NABL</label>
                                </td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                           decoration-success="avg_water_absorption_nabl == 'pass'"
                                           decoration-danger="avg_water_absorption_nabl == 'fail'"
                                           readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Crushing Value -->

                    <div invisible="not crushing_visible">
                        <h1 class="text-center">
                            <field name="crushing_name" readonly="1" nolabel="1"/>
                            <field name="crushing_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible="not crushing_visible" class="custom_table_borders">
                        <field name="crushing_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name="sample_no"/>
                                <field name="total_wt_aggregate" class="blue-input" decoration-info="total_wt_aggregate != 0"/>
                                <field name="wt_of_aggregate_retained" class="blue-input" decoration-info="wt_of_aggregate_retained != 0"/>
                                <field name="wt_of_aggregate_passing"/>
                                <field name="crushing_value"/>
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders"
                           invisible="not crushing_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td>
                                    <span class="fw-bold">Average Crushing Value</span>
                                </td>
                                <td>
                                    <field name="average_crushing"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"/>
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <button
                        type="object"
                        class="oe_highlight" 
                        name="open_eln_page"
                        string="Submit"
                    />

                </sheet>
            </form>
        </field>
     </record>

    </data>
</odoo>