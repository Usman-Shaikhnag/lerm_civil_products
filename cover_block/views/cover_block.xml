<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <record id="mechanical_cover_block_form" model="ir.ui.view">
        <field name="name">mechanical.cover.block.form</field>
        <field name="model">mechanical.cover.block</field>
        <field name="arch" type="xml">
            <form create="false"> 





                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    <group>
                       <field name="grade"/>
                    </group>



                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="size_id"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <!-- <group class="custom_table_borders"> -->
                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="week_no"></label></td>
                                    <td><field name="week_no" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="other_details"></label></td>
                                    <td><field  name="other_details" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="condition"></label></td>
                                    <td><field name="condition" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                 
       

 <!-- Water Absorption -->

<div class="text-center" invisible="not water_absorption_visible">
    <h1>
        <field name="water_absorption_name" readonly="1" nolabel="1"/>
        <field name="water_absorption_visible" invisible="1"/>
    </h1>
</div>

<!-- Main Table -->
<table class="table table-sm table-bordered custom_table_borders"
       invisible="not water_absorption_visible"
       style="white-space:nowrap;">
    <thead>
        <tr>
            <th>Parameters</th>
            <th>Trial 1</th>
            <th>Trial 2</th>
            <th>Result</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><span class="fw-bold">Weight of Sample in Water (A)</span></td>
            <td><field name="wt_sample_inwater" class="blue-input"/></td>
            <td><field name="wt_sample_inwater_2" class="blue-input"/></td>
            <td><field name="result_wt_sample_inwater"/></td>
        </tr>
        <tr>
            <td><span class="fw-bold">Weight of Surface Dry Sample (B)</span></td>
            <td><field name="wt_surface_dry" class="blue-input"/></td>
            <td><field name="wt_surface_dry_2" class="blue-input"/></td>
            <td><field name="result_wt_surface_dry"/></td>
        </tr>
        <tr>
            <td><span class="fw-bold">Oven Dried Weight (C)</span></td>
            <td><field name="oven_dried_wt" class="blue-input"/></td>
            <td><field name="oven_dried_wt_2" class="blue-input"/></td>
            <td><field name="result_oven_dried_wt"/></td>
        </tr>
    </tbody>
</table>

<!-- Result Table -->
<table class="table table-sm table-bordered custom_table_borders"
       invisible="not water_absorption_visible">
    <tbody>
        <tr>
            <td><span class="fw-bold">Water Absorption (%)</span></td>
            <td><field name="water_absorption"/></td>
        </tr>
    </tbody>
</table>







                    <!-- Crushing Value  -->
                    <div invisible= "crushing_visible == False">
                        <h1 class="text-center">
                            <field name="crushing_name" readonly="1" nolabel="1"/>
                            <field name="crushing_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible= "crushing_visible == False" class="custom_table_borders">
                        <field name="crushing_child_lines" nolabel="1">
                                <tree editable="bottom">
                                    <field name='sample_no'/>
                                    <field name='total_wt_aggregate' class="blue-input" decoration-info="total_wt_aggregate != 0"/>
                                    <field name='wt_of_aggregate_retained' class="blue-input" decoration-info="wt_of_aggregate_retained != 0"/>
                                    <field name='wt_of_aggregate_passing'/>
                                    <field name='crushing_value'/>
                                </tree>
                        </field> 
                    </div>

                    <!-- Crushing Value Table -->
                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not crushing_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Average Crushing Value</span></td>
                                <td><field name="average_crushing"/></td>
                            </tr>
                        </tbody>
                    </table>



                           <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>


                    
                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
        </field>
     </record>

     <record id="view_cover_block_prefill_data_form" model="ir.ui.view">
            <field name="name">mechanical.cover.block.prefill.data.form</field>
            <field name="model">mechanical.cover.block.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>




                    
				



                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cover_block_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mechanical.cover.block.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_cover_block_prefill_data_form"/>
            <field name="target">new</field>
        </record>

    
    </data>
</odoo>