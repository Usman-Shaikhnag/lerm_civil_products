<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="cover_block_datasheet">
    <t t-call="web.html_container">
        
        <t t-call="lerm_civil.mechanical_data_sheet_header">
            
            <div style="text-align:center;font-size:18px">
                cover block
            </div>

            <div class="container_eln" style="margin-top:5px">

                <!-- Water Absorption  -->
                <div t-if="data.water_absorption_visible" style="margin-top: 30px; font-family: Arial, sans-serif;page-break-before: always;">
                    
                    <div style="text-align: center; font-size: 18px; font-weight: bold; margin-bottom: 15px;">
                        Water Absorption
                    </div>

                    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <tr>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">
                                Weight of Sample in Water (A):
                            </td>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px;">
                                <span t-field="data.wt_surface_dry"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">
                                Weight of Surface Dry Sample (B):
                            </td>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px;">
                                <span t-field="data.wt_sample_inwater"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">
                                Oven Dried Weight (C):
                            </td>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px;">
                                <span t-field="data.oven_dried_wt"/>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">
                                Water Absorption % :
                            </td>
                            <td colspan="6" style="border: 1px solid #ccc; padding: 6px;">
                                <span t-field="data.water_absorption" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                        </tr>
                    </table>

                </div>

                <!-- Crushing Value -->
                <div t-if="data.crushing_visible" style="display: flex; gap: 20px; margin-top: 30px; font-family: Arial, sans-serif; justify-content: space-between; flex-wrap: wrap;page-break-before: always;">

                    <div style="flex: 1; min-width: 45%;">
                        <div style="text-align: center; font-size: 18px; font-weight: bold; margin-bottom: 15px;">
                            Crushing Value
                        </div>

                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <thead>
                                <tr style="background-color: #f0f0f0; text-align: center;">
                                    <th style="border: 1px solid #ccc; padding: 6px;">Sr. No.</th>
                                    <th colspan="2" style="border: 1px solid #ccc; padding: 6px;">W1</th>
                                    <th colspan="2" style="border: 1px solid #ccc; padding: 6px;">W2</th>
                                    <th colspan="2" style="border: 1px solid #ccc; padding: 6px;">W3</th>
                                    <th style="border: 1px solid #ccc; padding: 6px;">Crushing Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="a" t-value="0"/>
                                <tr t-foreach="data.crushing_value_child_lines" t-as="r1" style="text-align: center;">
                                    <td style="border: 1px solid #ccc; padding: 6px;">
                                        <span t-esc="a + 1"/>
                                        <t t-set="a" t-value="a+1"/>
                                    </td>
                                    <td colspan="2"><span t-esc="r1['total_wt_aggregate']"/></td>
                                    <td colspan="2"><span t-esc="r1['wt_of_aggregate_passing']"/></td>
                                    <td colspan="2"><span t-esc="r1['wt_of_aggregate_retained']"/></td>
                                    <td><span t-esc="r1['crushing_value']"/></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>

                </div>

            </div>

        </t> <!-- ✅ FIX: closing t-call properly -->

    </t>
</template>






<!-- report  -->
    <template id="cover_block_report">
		<t t-call="web.html_container">
			
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln" style="padding-top:70px">
					<div t-foreach="eln" t-as="o">
						<table style="margin-top:10px; border:none">
							<tr>
								<td colspan="2" style=" font-weight: bold;">Client Details:</td>
								<td colspan="10">
									<span t-field="o.srf_id.customer.name"/><br />
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
									,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
							
								<td colspan="2" style=" font-weight: bold;">Client Reference:</td>
								<td colspan="10"><span t-field="o.srf_id.client_refrence"/></td>
							</tr>

							<tr>
								<td colspan="2" style=" font-weight: bold;">Name of Work:</td>
								<td colspan="10"><span t-field="o.srf_id.name_work"/></td>
							</tr>
					
							<tr>
								<td colspan="2" style=" font-weight: bold;">Date of Testing:</td>
								<td colspan="10">
									<span t-field="o.start_date"/> to <span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Size:</td>
								<td colspan="10">
									<span t-field="o.sample_id.size_id"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Grade:</td>
								<td colspan="10">
									<span t-field="o.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Material/Test Name:</td>
								<td colspan="10">
									<span t-field="o.material.name"/>
								</td>
							</tr>

						
							<tr t-if="o.material.source_sample">
								<td colspan="2" style="font-weight: bold;">Source of Sample</td>
								<td colspan="10">
									<span t-field="o.material.source_sample"/>
								</td>
							</tr>

						
							<tr t-if="o.material.test_method_adopted">
								<td colspan="2" style="font-weight: bold;">Test method adopted:</td>
								<td colspan="10">
									<span t-field="o.material.test_method_adopted"/>
								</td>
							</tr>

						</table>



					</div>
				
					 
					
					

								<tr t-if="data.specific_gravity_visible and (data.specific_gravity_nabl == 'pass' and nabl or (data.specific_gravity_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="water_absorption" t-value="env['lerm.parameter.master'].search([('internal_id','=','a43a33a4-834e-40d4-afb3-80a4e61ece05')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="water_absorption.parameter_name"/>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="water_absorption.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="water_absorption.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<span t-field="data.water_absorption" t-options='{"widget": "float", "precision": 2}'/>
										</span>									
									</td>
									<td style="text-align: center;">
										<span>
											<t t-foreach="water_absorption.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

							
								

					
					<div style="page-break-inside: avoid;">
                        <div style="margin-top:10px; padding:0" class="noteContainer">
                            <table class="table table-bordered">
								<tr>
									<td style="padding: 5px; font-style: italic; font-size: 12px;">
										<b>Note:-</b>
										&#160;&#160;(i) The results relate only to the items tested 
										&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
										&#160;&#160;(iii) Any corrections invalidate the test reports 
										&#160;&#160;(iv) Any Query regarding the report must be reported immediately. 
										&#160;&#160;(v) * mark indicate tests which are not in the scope of NABL. 
										&#160;&#160;(vi) # mark indicates Details given by Client.
										<t t-if="eln.has_witness">
											&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
										</t>
										<t t-if="eln.remarks">
											&#160;&#160;<span t-esc="eln.remarks"/>
										</t>
									</td>
								</tr>
							</table>
                        </div>
                        <div style="margin-top:10px; page-break-inside: avoid;" class="signatureContainer girdgird">

                            <div>
                                <div>
                                    <b>
								Checked By
                                    </b>
                                </div>
                                <div style="height:40px">

                                </div>
                                <div>
                                    <b>
                                        <span t-esc="eln.sample_id.check_by.name"/>
                                    </b>
                                </div>
                                <div>
                                    <b>
								        (<span t-esc="eln.sample_id.check_by.job_title"/>)
                                    </b>
                                </div>
                            </div>

							<div>
						<div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div>
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
                            <div>
                                <div>
                                    <b>
								Approved By 
                                    </b>

                                </div>
                                <div style="height:40px">

                                </div>
                                <div>
                                    <b>
                                        <span t-esc="eln.sample_id.approved_by.name"/>
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="eln.sample_id.approved_by.job_title"/>)
                                    </b>
                                </div>
                                
                            </div>
                        </div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
                        </div>
                    </div>
                        
				</div>
			</t>
		</t>
	</template>
</odoo>