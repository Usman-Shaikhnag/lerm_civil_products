<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="lerm_brick_clay_datasheet">
    <t t-call="web.html_container">
	<t t-call="lerm_civil.mechanical_data_sheet_header">
		<div style="text-align:center;font-size:18px;font-weight: bold">
			Burnt Clay Bricks
		</div>
		<div class="container_eln" style="margin-top:5px">
            <table style="margin-top:20px">
				<tr cols="12">
					
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>

				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                    <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>



                <!-- Compressive Strength -->

           
             <div t-if="data.compressive_strength_visible" style="margin-top:20px; ">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>

                         <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="2" style="text-align: center;font-weight: bold">Sample
                                </td>
                                  <td colspan="2" style="text-align: center;font-weight: bold">Identification Mark
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Length, mm 
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Width, mm
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold">Height, mm
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold"> Area (mm²)
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold"> Load in, KN
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold">Compressive strength, MPa
                                </td>
                            
                            </tr>

                            <t t-set="k" t-value="0"/>
                            <tr t-foreach="data.compressive_strength_lines" t-as="r">
                                <td colspan="2" style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['identification_mark']"/>
                                </td>
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['length']"/>
                                </td>
                                
                              
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['width']"/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['height']"/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['load']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                             
                               
                            </tr>
                        </table>

                        <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="6" style="font-weight: bold">Average Compressive Strength  :
                              <![CDATA[&nbsp;]]>
                                </td>
                                <td colspan="6" style="text-align: center">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    

                    </div>



                    <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>



                
                <!-- Dimension -->

            <div t-if="data.dimension_visible" style="margin-top:20px; page-break-before: always;">
				<div style="text-align:center;font-size:18px;font-weight: bold">
						Dimension (mm) 
                        <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','9f1689be-107d-4e30-9d3d-2aff6292264d')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>

				</div>
                <table style="margin-top:30px;width:100%">
                
                    <thead>
                        <tr>
                            <th colspan="2" style="text-align: center;max-width:200px">
                                <span style="font-weight: bold;">
                                    Sr.No
                                </span>
                            </th>
                            <th colspan="2" style="text-align: center;max-width:100px">
                                <span style="font-weight: bold;">
                                     No. of Bricks
                                </span>
                            </th>
                            <th colspan="2" style="text-align: center;max-width:100px">
                                <span style="font-weight: bold;">
                                     Length in mm
                                </span>
                            </th>
                            <th colspan="2" style="text-align: center;">
                                <span style="font-weight: bold;">
                                     Width in mm
                                </span>
                            </th>
                            <th colspan="2" style="text-align: center;">
                                <span style="font-weight: bold;">
                                     Height in mm
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    <t t-set="k" t-value="0"/>
								<tr t-foreach="data.dimension_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
                                    <td style="border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['no_bricks']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['lengthh']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['width']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['height']"/>
									</td>
								</tr>
                    </tbody>
				
				</table>	
			</div>

            <table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average Length :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.avrg_length"/>
								</td>
							</tr>
                            <tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average Width :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.avrg_width"/>
								</td>
							</tr>
                            <tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average Height :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.avrg_height"/>
								</td>
							</tr>
						</table>


            <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>

            <!-- Visual Observation -->

       
                <div t-if="data.efflorescence_visible" style="page-break-before: always;">
				<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
						Efflorescence

				</div>
                <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                
                    <thead>
                        <tr style="background-color: #f0f0f0; text-align: center;">
                            <th style="padding: 8px;" colspan="2">
                                    Sr.No
                            </th>
                            <th style="padding: 8px;" colspan="2">
                                    Brick Identification No.  
                            </th>
                            <th style="padding: 8px;" colspan="2">
                                    Water Level (mm)
                            </th>
                            <th style="padding: 8px;" colspan="2">
                                    1st Cycle Observation
                            </th>
                            <th style="padding: 8px;" colspan="2">
                                    2nd Cycle Observation
                            </th>
                            <th style="padding: 8px;" colspan="2">
                                    Efflorescence Rating
                            </th>
                            <th style="padding: 8px;" colspan="2">
                                    Remarks
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    <t t-set="k" t-value="0"/>
								<tr t-foreach="data.efflorescence_line_ids" t-as="r" style="text-align: center;">
									<td style="padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
                                    <td style="padding: 6px;" colspan="2">
										<span t-esc="r['brick_identification_no']"/>
									</td>
									<td style="padding: 6px;" colspan="2">
										<span t-esc="r['water_level']"/>
									</td>
									<td style="padding: 6px;" colspan="2">
										<span t-esc="r['first_cycle']"/>
									</td>
									<td style="padding: 6px;" colspan="2">
										<span t-esc="r['second_cycle']"/>
									</td>
                                    <td style="padding: 6px;" colspan="2">
										<span t-esc="r['efflorescence_rating']"/>
									</td>
                                    <td style="padding: 6px;" colspan="2">
										<span t-esc="r['remarks']"/>
									</td>
								</tr>
                    </tbody>
				
				</table>	
			</div>


            <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>




                <!-- Water Absorption 					 -->

             <div t-if="data.water_absorbtion_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>

                         <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="2" style="text-align: center;font-weight: bold">Sample
                                </td>
                                  <td colspan="2" style="text-align: center;font-weight: bold">Identification Mark
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Initial wt ater 24 hr emersion water (W1)
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Final wt after 24 hr oven (W2)
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold">Water Absorption, % = [(W1-W2)/W2 * 100]
                                </td>
                               
                            
                            </tr>

                            <t t-set="k" t-value="0"/>
                            <tr t-foreach="data.water_absorption_lines" t-as="r">
                                <td colspan="2" style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                 <td colspan="2" style="text-align: center">
                                    <span t-esc="r['identification_mark']"/>
                                </td>
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['initial_wt']"/>
                                </td>
                              
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['final_wt']"/>
                                </td>
                             
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  
                               
                            </tr>
                        </table>

                        <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="6" style="font-weight: bold">Average Water Absorption :
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align: center">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    

                    </div>



                    
                
				<!-- authorizeRowDataSheet -->
				
			
            <div class="authorizeRowDataSheet">
                <div>
                    <div>
                        <b>
                            Tested By 
                        </b>
                        
                    </div>
                    <div style="height:40px">

                    </div>
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.filled_by.name"/>
                        </b>
                    </div>
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                        </b>
                    </div>
                </div>
                <div style="margin-left:500px">
                    
                    <div>
                        <b>
                            Checked By
                        </b>
                    </div>
                    <div style="height:40px">

                    </div>
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.check_by.name"/>
                        </b>
                    </div>
                    
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.check_by.job_title"/>)
                        </b>
                    </div>
                </div>
            </div>

		</div>

	</t>
</t>
</template>
</odoo>
