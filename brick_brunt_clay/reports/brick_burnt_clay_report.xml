<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_bricks_burnt_clay_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->

			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>TEST REPORT</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:20px;">
					
					<div t-foreach="eln" t-as="o">
						
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 70px;"/>
									</td>
								
							</tr>
							<tr>
								<td style="width:25%;">Samples Description :-</td>
								<td style="width:25%;"><span t-field="o.material.lab_name"/></td>

								<td style="width:20%;">Customer's Ref. No :-</td>
								<td style="width:20%;"><span t-field="o.srf_id.client_refrence"/></td>
							</tr>

							<tr>
								<!-- <td>Quantity of Samples :-</td>
								<td>Litre</td> -->
								<td>No. of Samples :-</td>
								<td><span t-field="o.sample_id.quantity"/></td>

								<td>Letter Date :-</td>
								<td>
									
								</td>
							</tr>

							<tr>
								<td>Date of Samples Received :-</td>
								<td>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>

									<td>SRF No. :-</td>
										<td >
											<span t-field="o.srf_id"/>
										</td>
								
							</tr>

							<tr>
								<td>Brand &amp; Grade :-</td>
								<td><span t-field="o.sample_id.grade_id.grade"/></td>

								<td>Date of Test Initiation  :-</td>
								<td>
									<span t-field="o.start_date"/>
								</td>
							</tr>

							<tr>
								<td>Week No. :-</td>
								<td></td>

								<td>Date of Test Completion  :-</td>
								<td>
									<span t-field="o.end_date"/>
								</td>
							</tr>

							<!-- <tr>
								<td t-if="o.material.source_sample">Source of Sample :-</td>
								<td><span t-field="o.material.source_sample"/></td>

								<td t-if="o.material.test_method_adopted" >Test method adopted  :-</td>
								<td>
									<span t-field="o.material.test_method_adopted"/>
								</td>
							</tr> -->

							<tr t-if="o.material.test_method_adopted" >
								

									<td >Test method adopted:</td>
									<td colspan="3"><span t-field="o.material.test_method_adopted"/></td>

							
							</tr>
							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

						</table>
					</div>


					<!-- 1 Compressive strength  -->

					<div t-if="data.compressive_strength_visible and (data.comp_strength_nabl == 'pass' and nabl or (data.comp_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)" style="margin-top:20px;">
						<td>
							<span>
								<strong>Compressive strength :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table t-if="data.compressive_strength_visible" style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Crushing Load, KN
										</span>
									</th>

									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Area of Brick, mm2
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Compressive Strength,  N/mm²
										</span>
									</th>
									
									
								</tr>
							</thead>
							<tbody>

							<t t-set="k" t-value="0"/>
                            <tr t-foreach="data.compressive_strength_lines" t-as="r">
                                <td style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                
                                  
                                  <td style="text-align: center">
                                    <span t-esc="r['load']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
								<td style="text-align: center">
                                    <span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td style="text-align: center">
                                    <span t-esc="r['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                             
                               
                            
								
									</tr>
								
							</tbody>
						</table>
						<table t-if="data.compressive_strength_visible" style="margin-top: 20px;max-width:400px">
							<tr>
								<td style="font-weight: bold;">Average Compressive Strength</td>
								<td style="text-align: center;">
									<span t-field="data.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).unit.name"/>
								</td>
							</tr>
						</table>
					</div>

					<!-- Efflorence -->
					<div t-if="data.efflorescence_visible" style="margin-top:50px;page-break-inside: avoid;">

						<td>
							<span>
								<strong>Efflorescence :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','9dda88ca-75fa-4e60-bcac-3cf6609386ce')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											1 Observation
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											2 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											3 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											4 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											5 Observation
										</span>

									</th>
									<!-- <th>
										<span style="font-weight: bold;">
											Specification
										</span>
									</th> -->
								
								</tr>
							</thead>
							<tbody>

								<tr t-if="data.efflorescence_visible">
									<td style="text-align: center;padding:0px">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td style="text-align: center;max-width:200px">
										<span style="text-align: center;">
											<span t-field="data.visual_observation_1"/>
										</span>
									</td>

									<td style="text-align: center;max-width:100px">
										<span style="text-align: center;">
											<span t-field="data.visual_observation_2"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="data.visual_observation_3"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="data.visual_observation_4"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="data.visual_observation_5"/>
										</span>
									</td>
									
								
								</tr>

							</tbody>
						</table>
					</div>

					<!-- Dimension -->
					<div t-if="data.dimension_visible" style="margin-top:20px; page-break-inside: avoid;">
						<td>
							<span>
								<strong>Dimension :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','9f1689be-107d-4e30-9d3d-2aff6292264d')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Length in mm
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Width in mm
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Height in mm
										</span>
									</th>
									<!-- <th style="text-align: center;">
										<span style="font-weight: bold;">
											Specification
										</span>
									</th> -->
								
								</tr>
							</thead>
							<tbody>

								<tr t-if="data.dimension_visible">
									<td style="text-align: center;padding:0px">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td style="text-align: center;max-width:200px">
										<span style="text-align: center;">
											<span t-field="data.length_in_mm"/>
										</span>
									</td>

									<td style="text-align: center;max-width:100px">
										<span style="text-align: center;">
											<span t-field="data.width_in_mm"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="data.height_in_mm"/>
										</span>
									</td>
									
								
								</tr>


							</tbody>
						</table>
					</div>

					<!-- Water Absorption -->
					<div t-if="data.water_absorbtion_visible and (data.water_absorption_nabl == 'pass' and nabl or data.water_absorption_nabl == 'fail' and not nabl)" style="margin-top:20px; page-break-inside: avoid;">

						<td t-if="data.water_absorbtion_visible and (data.water_absorption_nabl == 'pass' and nabl or data.water_absorption_nabl == 'fail' and not nabl)">
							<span>
								<strong>Water Absorption :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:10px;" t-if="data.water_absorbtion_visible and (data.water_absorption_nabl == 'pass' and nabl or data.water_absorption_nabl == 'fail' and not nabl)">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Initial wt after 24 hr emersion water
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Final wt after 24 hr oven
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Water Absorption, %
										</span>
									</th>
									
								
								</tr>
							</thead>
							<tbody>

							<t t-set="k" t-value="0"/>
                            <tr t-foreach="data.water_absorption_lines" t-as="r">
                                <td style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                
                                <td style="text-align: center">
                                    <span t-esc="r['initial_wt']"/>
                                </td>
                              
                                <td style="text-align: center">
                                    <span t-esc="r['final_wt']"/>
                                </td>
                             
                                  <td style="text-align: center">
                                    <span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  
                               </tr>

							

							</tbody>
						</table>

						<table style="margin-top: 20px;max-width:400px" t-if="data.water_absorbtion_visible and (data.water_absorption_nabl == 'pass' and nabl or data.water_absorption_nabl == 'fail' and not nabl)">
							<tr>
								<td style="font-weight: bold;">Average Water Absorption, %</td>
								<td style="text-align: center;">
									<span t-field="data.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>   <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).unit.name"/>
								</td>
							</tr>
						</table>
					</div>

					<div>
					</div>


					<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>
							


					<div style="margin-top:5px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<table class="table table-bordered">
						<tr>
							<td style="padding: 5px; font-style: italic; font-size: 12px;">
								
								<!-- <t t-if="cement.notes_id">
									<t t-foreach="cement.notes_id" t-as="n">
										<div>
											&#160;&#160;(<t t-esc="n.sr_no"/>) 
											<t t-esc="n.notes"/>
										</div>
									</t>
								</t> -->
								<t t-if="data.notes_id">
									<b>Conditions:-</b>

									<t t-foreach="data.notes_id" t-as="n">
										<span>
											(<t t-esc="n.sr_no"/>) 
											<t t-esc="n.notes"/>
											&#160;&#160;
										</span>
									</t>
								</t>
							
								<t t-if="eln.has_witness">
									&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
								</t>
								<t t-if="eln.remarks">
									&#160;&#160;<span t-esc="eln.remarks"/>
								</t>
							
							</td>
						</tr>
					</table>
					</div>


					
						 <!-- Remarks Section -->

                    






					<div class="signatureContainer girdgird">
						<div>
							<div>
								<b>
									Checked By
								</b>
							</div>
							<div style="height:30px">

							</div>
							<div>
								<b>
									<span t-esc="eln.technician.name"/>
								</b>
							</div>
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>

						<!-- QR Code -->
							<div style="text-align:center; margin-bottom:10px;">
								<img t-att-src="'data:image/png;base64,%s' % (qrcode_static or '')"
									style="width:75px; height:70px;"/>
							</div>

						<t t-if="o.sample_id.stamp_attached">
							<div >
								<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div>
							</div>
						</t>
						<div>
							<div>
								<b>
									Approved By 
								</b>
								
							</div>
							<div style="height:30px">

							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>
						
							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							
							<!-- <div>
								<b>
									(Authorized Signatory)
								</b>
							</div> -->
						</div>
					</div>
					</div>
					

	</t>
</t>

</template>

</odoo>