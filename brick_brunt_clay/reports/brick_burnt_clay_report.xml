<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_bricks_burnt_clay_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->

			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>TEST REPORT</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:20px;">
					
					<div t-foreach="eln" t-as="o">

					<table>
							<tr>	
								<td colspan="8" rowspan="6">Issued to :<br/>  
									
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
								
								</td>
								<td colspan="5">Sample Receipt Date :</td>

								<td colspan="5"><span t-field="o.sample_id.sample_received_date"/></td>
							</tr>

							<tr>
							    <td colspan="5">Date of testing :</td>

								<td colspan="5"><span t-field="o.start_date"/></td>
							</tr>

							<tr>
								<td colspan="5"> Size :
								</td>
								<td>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								
							</tr>

							<tr>
							   <td colspan="5"> Grade :
									</td>
								<td>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>

							<tr>
							    <td colspan="5">Lab Id :</td>

								<td colspan="5">
								<!-- <span t-field="o.sample_id.sample_received_date"/> -->
								</td>
							</tr>

							<tr>
							    <td colspan="5">Tested at :</td>

								<!-- <td colspan="5">
								<span t-field="o.sample_id.sample_received_date"/>
								</td> -->
								<td>

								<t t-if="brick.lab_id">
								 <t t-foreach="brick.lab_id.lab_location_line" t-as="loc">
								   <div>
                                     <span t-esc="loc.location_name"/>
                                       <!-- (<span t-esc="loc.location_code"/>) -->
                                    </div>
									 </t>
                                  </t>
								  </td>

						
							</tr>
						</table>
						
						<table style="margin-top:10px;">
							<tr>
								<td colspan="12"> Contractor Name :	
									</td>
								<td>
									<span t-field="o.srf_id.customer.name"/><br/>
								</td>
							</tr>
							<tr>
								<td colspan="12"> Sample Description: </td>
								<td>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
							<tr>
							
								<td colspan="12"> Project Name : </td>
								<td>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
							
								<td colspan="12"> Name of Work/Subject : </td>
								<td>
									<span t-field="o.material.name"/>
								</td>
							</tr>
							<!-- <tr>
								<td colspan="12"> Size :
								</td>
								<td>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								
							</tr>

							<tr>
							   <td colspan="12"> Grade :
									</td>
								<td>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr> -->
							
						</table>
					</div> 


					<!-- 1 Compressive strength  -->

					<div t-if="brick.compressive_strength_visible and (brick.comp_strength_nabl == 'pass' and nabl or (brick.comp_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)" style="margin-top:20px;">
						<td>
							<span>
								<strong>Compressive strength :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table t-if="brick.compressive_strength_visible" style="margin-top:10px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Crushing Load, KN
										</span>
									</th>

									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Area of Brick, mm2
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Compressive Strength,  N/mm²
										</span>
									</th>
									
									
								</tr>
							</thead>
							<tbody>

							<t t-set="k" t-value="0"/>
                            <tr t-foreach="brick.compressive_strength_lines" t-as="r">
                                <td style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                
                                  
                                  <td style="text-align: center">
                                    <span t-esc="r['load']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
								<td style="text-align: center">
                                    <span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td style="text-align: center">
                                    <span t-esc="r['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                             
                               
                            
								
									</tr>
								
							</tbody>
						</table>
						<table t-if="brick.compressive_strength_visible" style="margin-top: 10px;max-width:400px">
							<tr>
								<td style="font-weight: bold;">Average Compressive Strength</td>
								<td style="text-align: center;">
									<span t-field="brick.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).unit.name"/>
								</td>
							</tr>
						</table>
					</div>

					<!-- Efflorence -->
					<div t-if="brick.efflorescence_visible" style="margin-top:50px;page-break-inside: avoid;">

						<td>
							<span>
								<strong>Efflorescence :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','9dda88ca-75fa-4e60-bcac-3cf6609386ce')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											1 Observation
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											2 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											3 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											4 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											5 Observation
										</span>

									</th>
									<!-- <th>
										<span style="font-weight: bold;">
											Specification
										</span>
									</th> -->
								
								</tr>
							</thead>
							<tbody>

								<tr t-if="brick.efflorescence_visible">
									<td style="text-align: center;padding:0px">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td style="text-align: center;max-width:200px">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_1"/>
										</span>
									</td>

									<td style="text-align: center;max-width:100px">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_2"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_3"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_4"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_5"/>
										</span>
									</td>
									
								
								</tr>

							</tbody>
						</table>
					</div>

					<!-- Dimension -->
					<div t-if="brick.dimension_visible" style="margin-top:20px; page-break-inside: avoid;">
						<td>
							<span>
								<strong>Dimension :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','9f1689be-107d-4e30-9d3d-2aff6292264d')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Length in mm
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Width in mm
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Height in mm
										</span>
									</th>
									<!-- <th style="text-align: center;">
										<span style="font-weight: bold;">
											Specification
										</span>
									</th> -->
								
								</tr>
							</thead>
							<tbody>

								<tr t-if="brick.dimension_visible">
									<td style="text-align: center;padding:0px">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td style="text-align: center;max-width:200px">
										<span style="text-align: center;">
											<span t-field="brick.length_in_mm"/>
										</span>
									</td>

									<td style="text-align: center;max-width:100px">
										<span style="text-align: center;">
											<span t-field="brick.width_in_mm"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.height_in_mm"/>
										</span>
									</td>
									
								
								</tr>


							</tbody>
						</table>
					</div>

					<!-- Water Absorption -->
					
					


					<div t-if="brick.water_absorbtion_visible and (brick.water_absorption_nabl == 'pass' and nabl or brick.water_absorption_nabl == 'fail' and not nabl)"
                    style="margin-top:20px; page-break-inside: avoid;">

                       <table style="width:100%; border-collapse:collapse;" border="1">

    
                        <thead>
                            <tr>
                              <th style="text-align:center;font-weight:bold;">Sr.No.</th>
                              <th style="text-align:center;font-weight:bold;">Test Parameters</th>
                              <th style="text-align:center;font-weight:bold;">Results</th>
                              <th style="text-align:center;font-weight:bold;">Test Method</th>
                            </tr>
                        </thead>

                        <tbody>
            
                           <tr>
                 
                               <td style="text-align:center;vertical-align:middle;" 
                                 t-att-rowspan="len(brick.water_absorption_lines) + 2">
                                     1.
                                </td>

               
                                <td style="text-align:center; font-weight:bold;">
                                  Water Absorption, % by wt.
                                </td>

               
                                <td></td>

                
                                <td style="text-align:center;vertical-align:middle;"  t-att-rowspan="len(brick.water_absorption_lines) + 2">
                                   IS 3495 (P-2):2019
                                </td>
                           </tr>

            
                           <t t-set="k" t-value="0"/>
                            <tr t-foreach="brick.water_absorption_lines" t-as="r">
                
                     
                               <td style="text-align:center;">
                                 <span t-esc="brick.to_roman(k+1)"/>
                                 <t t-set="k" t-value="k+1"/>
                               </td>

                
                                <td style="text-align:center;">
                                  <span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/> 
							    </td>

                           </tr>

           
                           <tr>
                               <td style="font-weight:bold; text-align:center;">
                                      Average:-
                               </td>
                               <td style="text-align:center; font-weight:bold;">
                                  <span t-field="brick.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
                               </td>
                            </tr>
 
                         </tbody>
                       </table>

                     </div>

					<div>

					</div>
					<div style="margin-top:20px; page-break-inside: avoid;" class="noteContainer">
						<div>
							<b>Remarks: -</b>
						</div>
						<!-- <div>
							<ul>
								<li>
								The Test Report(s) is/are valid only to the sample submitted to the laboratory.
								</li>
								<li>
								Sample(s) was/were not drawn by laboratory.
								</li>
