					<!-- 1 Compressive strength  -->

					<table class="table table-bordered" style="width: 100%; text-align: center; border: 1px solid black; border-collapse: collapse;">
						<thead>
							<tr>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">S.No</th>
								<th colspan="3" style="border: 1px solid black; text-align: center;">Dimensions<br/>
								<span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','9f1689be-107d-4e30-9d3d-2aff6292264d')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
							</th>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">Compressive Strength, N/mm²<br/>
								<span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
							</th>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">Water Absorption, %<br/>
									<span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
							</th>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">Efflorescence<br/>
								<span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','9dda88ca-75fa-4e60-bcac-3cf6609386ce')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
								</th>
							</tr>
							<tr>
								<th style="border: 1px solid black; text-align: center;">Length</th>
								<th style="border: 1px solid black; text-align: center;">Breadth</th>
								<th style="border: 1px solid black; text-align: center;">Height</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td style="border: 1px solid black; text-align: center;">1</td>
