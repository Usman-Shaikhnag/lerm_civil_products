<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_bricks_burnt_clay_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->

			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>TEST REPORT</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:20px;">
					
					<div t-foreach="eln" t-as="o">
						
						<table style="margin-top:10px;">
							<tr>
								<td colspan="12">#Customer Party Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
							
								<td colspan="12">#Project / Site Address : <![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Sample Description : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td colspan="6">Test Start Date :<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
								<td colspan="6">Test End Date :<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Sample Id Mark: <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.client_sample_id"/>
								</td>
								<td colspan="6">Sample Receipt Date :<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Size :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								<td colspan="6">#Grade :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Brand :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.brand"/>
								</td>
								<td colspan="6">#Consultant Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.consultant_name1"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Client Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
								</td>
								<td colspan="6">#Client Reference :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client_refrence"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Discipline :
									<![CDATA[&nbsp;]]>
									<span t-field="o.discipline.discipline"/>
								</td>
								<td colspan="6">Group :
									<![CDATA[&nbsp;]]>
									<span t-field="o.group.group"/>
								</td>
							</tr>

							<tr>
								<td colspan="12">Material/Test Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
							</tr>
						</table>
					</div>


					<!-- 1 Compressive strength  -->

					<div t-if="brick.compressive_strength_visible and (brick.comp_strength_nabl == 'pass' and nabl or (brick.comp_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)" style="margin-top:20px;">
						<td>
							<span>
								<strong>Compressive strength :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table t-if="brick.compressive_strength_visible" style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Crushing Load, KN
										</span>
									</th>

									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Area of Brick, mm2
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Compressive Strength,  N/mm²
										</span>
									</th>
									
									
								</tr>
							</thead>
							<tbody>

							<t t-set="k" t-value="0"/>
                            <tr t-foreach="brick.compressive_strength_lines" t-as="r">
                                <td style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                
                                  
                                  <td style="text-align: center">
                                    <span t-esc="r['load']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
								<td style="text-align: center">
                                    <span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td style="text-align: center">
                                    <span t-esc="r['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                             
                               
                            
								
									</tr>
								
							</tbody>
						</table>
						<table t-if="brick.compressive_strength_visible" style="margin-top: 20px;max-width:400px">
							<tr>
								<td style="font-weight: bold;">Average Compressive Strength</td>
								<td style="text-align: center;">
									<span t-field="brick.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','97928829-9b1f-4091-aa7f-4b76f98eb47f')]).unit.name"/>
								</td>
							</tr>
						</table>
					</div>

					<!-- Efflorence -->
					<div t-if="brick.efflorescence_visible" style="margin-top:50px;page-break-inside: avoid;">

						<td>
							<span>
								<strong>Efflorescence :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','9dda88ca-75fa-4e60-bcac-3cf6609386ce')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											1 Observation
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											2 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											3 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											4 Observation
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											5 Observation
										</span>

									</th>
									<!-- <th>
										<span style="font-weight: bold;">
											Specification
										</span>
									</th> -->
								
								</tr>
							</thead>
							<tbody>

								<tr t-if="brick.efflorescence_visible">
									<td style="text-align: center;padding:0px">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td style="text-align: center;max-width:200px">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_1"/>
										</span>
									</td>

									<td style="text-align: center;max-width:100px">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_2"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_3"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_4"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.visual_observation_5"/>
										</span>
									</td>
									
								
								</tr>

							</tbody>
						</table>
					</div>

					<!-- Dimension -->
					<div t-if="brick.dimension_visible" style="margin-top:20px; page-break-inside: avoid;">
						<td>
							<span>
								<strong>Dimension :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','9f1689be-107d-4e30-9d3d-2aff6292264d')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:30px;">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Length in mm
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Width in mm
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Height in mm
										</span>
									</th>
									<!-- <th style="text-align: center;">
										<span style="font-weight: bold;">
											Specification
										</span>
									</th> -->
								
								</tr>
							</thead>
							<tbody>

								<tr t-if="brick.dimension_visible">
									<td style="text-align: center;padding:0px">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td style="text-align: center;max-width:200px">
										<span style="text-align: center;">
											<span t-field="brick.length_in_mm"/>
										</span>
									</td>

									<td style="text-align: center;max-width:100px">
										<span style="text-align: center;">
											<span t-field="brick.width_in_mm"/>
										</span>
									</td>
									<td style="text-align: center;">
										<span style="text-align: center;">
											<span t-field="brick.height_in_mm"/>
										</span>
									</td>
									
								
								</tr>


							</tbody>
						</table>
					</div>

					<!-- Water Absorption -->
					<div t-if="brick.water_absorbtion_visible and (brick.water_absorption_nabl == 'pass' and nabl or brick.water_absorption_nabl == 'fail' and not nabl)" style="margin-top:20px; page-break-inside: avoid;">

						<td t-if="brick.water_absorbtion_visible and (brick.water_absorption_nabl == 'pass' and nabl or brick.water_absorption_nabl == 'fail' and not nabl)">
							<span>
								<strong>Water Absorption :</strong><![CDATA[&nbsp;]]>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>

						<table style="margin-top:10px;" t-if="brick.water_absorbtion_visible and (brick.water_absorption_nabl == 'pass' and nabl or brick.water_absorption_nabl == 'fail' and not nabl)">
							<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;max-width:200px">
										<span style="font-weight: bold;">
											Initial wt after 24 hr emersion water
										</span>
									</th>
									<th style="text-align: center;max-width:100px">
										<span style="font-weight: bold;">
											Final wt after 24 hr oven
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Water Absorption, %
										</span>
									</th>
									
								
								</tr>
							</thead>
							<tbody>

							<t t-set="k" t-value="0"/>
                            <tr t-foreach="brick.water_absorption_lines" t-as="r">
                                <td style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                
                                <td style="text-align: center">
                                    <span t-esc="r['initial_wt']"/>
                                </td>
                              
                                <td style="text-align: center">
                                    <span t-esc="r['final_wt']"/>
                                </td>
                             
                                  <td style="text-align: center">
                                    <span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  
                               </tr>

							

							</tbody>
						</table>

						<table style="margin-top: 20px;max-width:400px" t-if="brick.water_absorbtion_visible and (brick.water_absorption_nabl == 'pass' and nabl or brick.water_absorption_nabl == 'fail' and not nabl)">
							<tr>
								<td style="font-weight: bold;">Average Water Absorption, %</td>
								<td style="text-align: center;">
									<span t-field="brick.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>   <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).unit.name"/>
								</td>
							</tr>
						</table>
					</div>

					<div>

					</div>
					<div style="margin-top:20px; page-break-inside: avoid;" class="noteContainer">
						<div>
							<b>Remarks: -</b>
						</div>
						<div>
							<ul>
								<li>
								The Test Report(s) is/are valid only to the sample submitted to the laboratory.
								</li>
								<li>
								Sample(s) was/were not drawn by laboratory.
								</li>
								<li>
								This Report may not be reproduced in except full/ part without the permission of the Lab Head of the Laboratory.
								</li>
									<li>
										# - Information provided by the customer.
									</li>

								<li t-if="eln.has_witness">
										Test witnessed by : <span t-esc="eln.witness_name"/>
										
									</li>
									<li t-if="eln.remarks">
										<span t-esc="eln.remarks"/>
									</li>
							</ul>
						</div>
					</div>

					<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
								<b>
								Checked By
								</b>
							</div>
							<div style="height: 40px;">
							<t t-if="eln.sample_id.checkby_signature_required">
								<div t-if="eln.sample_id.check_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>

							<div>
								<b>
									<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>

							<div>
								<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
						<div>
							<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div>
							<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
							</div>
						</div>
						<div>
							<div>
								<b>
										Approved By
								</b>
							</div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.approveby_signature_required">
									<div t-if="eln.sample_id.approved_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							<div>
								<b>
										(Authorized Signatory)
								</b>
							</div>
						</div>
					</div>
					
				<!-- </div> -->
			</div>

			<div style="margin-top: 10px; text-align: center;">
				<p style="border-top: 1px dashed #000; padding-top: 10px;">
						...... End Of Report......
				</p>
			</div>
		<!-- </div> -->

	</t>
</t>

</template>

</odoo>