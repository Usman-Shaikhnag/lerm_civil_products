								<li t-if="eln.has_witness">
										Test witnessed by : <span t-esc="eln.witness_name"/>
										
									</li>
									<li t-if="eln.remarks">
										<span t-esc="eln.remarks"/>
									</li>
							</ul>
						</div> -->


						<div>
							<ul>
								<li>
								This test report relates only to the samples tested.
								</li>
								<li>
								The results are valid only for specific items and conditions tested and shall not be used to claim product certification or endorsement by the laboratory.
								</li>
								<li>
								This report shall not be reproduced, except in full, without prior written approval of the laboratory.
								</li>
									<li>
										 The laboratory assumes no responsibility for the selection, sampling, or interpretation of the results by any third party.
									</li>
									<li>
										 Any alteration, editing, or misuse of this report will render it invalid.
									</li>

								<li t-if="eln.has_witness">
										Test witnessed by : <span t-esc="eln.witness_name"/>
										
									</li>
									<li t-if="eln.remarks">
										<span t-esc="eln.remarks"/>
									</li>
							</ul>
						</div>

						
					</div>

					<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
								<b>
								Checked By
								</b>
							</div>
							<div style="height: 40px;">
							<t t-if="eln.sample_id.checkby_signature_required">
								<div t-if="eln.sample_id.check_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>

							<div>
								<b>
									<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>

							<div>
								<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
						<div>
							<!-- <div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div> -->
							<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
							</div>
						</div>
						<div>
							<div>
								<b>
										Approved By
								</b>
							</div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.approveby_signature_required">
									<div t-if="eln.sample_id.approved_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							<div>
								<b>
										(Authorized Signatory)
								</b>
							</div>
						</div>
					</div>
					
				<!-- </div> -->
			</div>

			<div style="margin-top: 10px; text-align: center;">
				<p style="border-top: 1px dashed  000; padding-top: 10px;">
						...... End Of Report......
				</p>
			</div>
		<!-- </div> -->

	</t>
</t>

</template>

