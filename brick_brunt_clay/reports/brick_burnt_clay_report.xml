<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_bricks_burnt_clay_report">
		<t t-call="web.html_container">
			
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
			
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">--</t>
								</td>

                                <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td>
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else=""></t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td>
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">-</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
											<span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">-</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<!-- <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">-</t> -->
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>

									<td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<t t-if="brick.brick_temperature is not None">
											<span t-field="brick.brick_temperature"/>   °C
										</t>
									<t t-else="">-</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="brick.brick_humidity is not None">
											<span t-field="brick.brick_humidity"/>   °C
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">-</t>
								</td>
								
							</tr>

							</table>
					</div>


					<!-- 1 Compressive strength  -->

					<div  t-if="brick.compressive_strength_visible and (brick.comp_strength_nabl == 'pass' and nabl or (brick.comp_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 10px;margin-top: 20px;">
							Compressive Strength
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Sr No.</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Length in mm</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Width in  mm</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Height in  mm</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Area in mm2</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Load in KN</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Compressive Strength (N/mm2)</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"  >
									  Average Compressive Strength (N/mm²)
                                     </th>
									 <th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;" >
									  Test Method/Specifications
                                     </th>
								</tr>
							</thead>
							
							<tbody>
								<t t-set="k" t-value="0"/>
								<t t-set="total_rows" t-value="len(brick.compressive_strength_lines)"/>
								<tr t-foreach="brick.compressive_strength_lines" t-as="r" style="text-align: center;">
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['length']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['width']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['height']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['load']" />
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; ">
                                          <span t-field="brick.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
                                      </td>
                                  </t>
								  <!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" >
                                          <!-- <span t-field="o.material.test_method_adopted"/> -->
										  IS 3495 (Part 1) :2019
                                      </td>
                                  </t>
								</tr>
								
								
							</tbody>
						</table>

						</div>


						<!-- Water Absorption  -->

					<div  t-if="brick.water_absorbtion_visible and (brick.water_absorption_nabl == 'pass' and nabl or (brick.water_absorption_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 10px;margin-top: 20px;">
							Water Absorption
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Sr No.</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Identification No.</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Initial wt after 24 hr emersion water</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Final wt after 24 hr oven</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Water Absorption %</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"  >
									  Average Water Absorption
                                     </th>
									 <th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;" >
									  Test Method/Specifications
                                     </th>
								</tr>
							</thead>
							
							<tbody>
								<t t-set="k" t-value="0"/>
								<t t-set="total_rows" t-value="len(brick.water_absorption_lines)"/>
								<tr t-foreach="brick.water_absorption_lines" t-as="r" style="text-align: center;">
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['identification_mark']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['initial_wt']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['final_wt']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; ">
                                          <span t-field="brick.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
                                      </td>
                                  </t>
								  <!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" >
                                          <!-- <span t-field="o.material.test_method_adopted"/> -->
										  IS 3495 (Part 2) :2019
                                      </td>
                                  </t>
								</tr>
								
								
							</tbody>
						</table>

						</div>


						<!-- Dimension  -->

					<t t-set="length_nabl" t-value="(brick.avrg_length_nabl == 'pass' and nabl) or ((brick.avrg_length_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>

                    <t t-set="width_nabl" t-value="(brick.avrg_width_nabl == 'pass' and nabl) or ((brick.avrg_width_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>

                   <t t-set="height_nabl" t-value="(brick.avrg_height_nabl == 'pass' and nabl) or ((brick.avrg_height_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>

				<style>
.dimension-section {
    page-break-inside: avoid !important;
}
</style>

				   

					<div class="dimension-section"  t-if="brick.dimension_visible and (length_nabl or width_nabl or height_nabl)">
					<div style="text-align: center; font-size: 20px; font-weight: bold;margin-bottom: 10px;margin-top: 20px;">
							Dimension
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="text-align:center;border: 1px solid black; padding: 2px;vertical-align: middle;" width="100">Sample No</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Length</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Width</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Height</th>

									<th  style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"  >
									  Average Length
                                     </th>
									 <th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"  >
									  Average Width
                                     </th>
									 <th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"  >
									  Average Height
                                     </th>
									 <th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;" >
									  Test Method/Specifications
                                     </th>
								</tr>
							</thead>
							
							<tbody>
								<t t-set="k" t-value="0"/>
								<t t-set="total_rows" t-value="len(brick.dimension_lines)"/>
								<tr t-foreach="brick.dimension_lines" t-as="r" style="text-align: center;">
									<td style="text-align:center;border: 1px solid black; padding: 2px;" width="100">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['lengthh']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['width']"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" colspan="2">
										<span t-esc="r['height']"/>
									</td>
									<!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; ">
                                          <span t-field="brick.avrg_length" t-options='{"widget": "float", "precision": 2}'/>
                                      </td>
                                  </t>

								  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; ">
                                          <span t-field="brick.avrg_width" t-options='{"widget": "float", "precision": 2}'/>
                                      </td>
                                  </t>

								  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; ">
                                          <span t-field="brick.avrg_height" t-options='{"widget": "float", "precision": 2}'/>
                                      </td>
                                  </t>

								  <!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" >
                                          <!-- <span t-field="o.material.test_method_adopted"/> -->
										  IS 1077 : 2025
                                      </td>
                                  </t>
								</tr>
								
								
							</tbody>
						</table>

						</div>


						<!-- Efflorescence  -->

					<div  t-if="brick.efflorescence_visible">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 10px;margin-top: 20px;">
							Efflorescence
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<tbody>
								<tr style="text-align: center;">
									<th style="text-align:center;border: 1px solid black; padding: 2px;vertical-align: middle;" colspan="2"></th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2">Observation 1</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" width="260" >
									  Test Method/Specifications
                                     </th>
								</tr>
								<tr style="text-align: center;">
								   <th style="text-align:center;border: 1px solid black; padding: 2px;vertical-align: middle;" colspan="2">Observation</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" colspan="2"><span t-field="brick.visual_observation_1"/></th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" width="260" >
									  IS 3495 (Part 3) :2019
                                     </th>
								</tr>
							</tbody>
						</table>

						</div>



					

					<div style="margin-top:50px" class="noteContainer">
						<table >
							<tr>
							
								<td style="padding: 5px; font-style: italic; ">

									<b>Notes:-</b>
										<t t-if="brick.notes_id">
										<t t-foreach="brick.notes_id" t-as="n">
											<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
										</t>
									</t>
								</td>
							</tr>
							</table>
						</div>

					<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
								<b>
								Checked By
								</b>
							</div>
							<div style="height:40px">

							</div>

							<div>
								<b>
									<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>

						<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>

						<div>
							<div>
								<b>
									Approved By
								</b>
							</div>
							<div style="height:40px">

							</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							
						</div>
					</div>
					
				

				



				
			</div>

			<div t-if="stamp_image" style="text-align:center;margin-bottom:10px">
				<img t-att-src="'data:image/png;base64,%s' % stamp_image" style="width:200px;"/>
			</div>
			<div style="margin-top: 10px; text-align: center;">
				<p style="padding-top: 10px;">
						...... End Of Report......
				</p>
			</div>
		<!-- </div> -->

	</t>
</t>

</template>

</odoo>