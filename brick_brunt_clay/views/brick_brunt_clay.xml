                    </notebook>

                    

                 
                      <div style="display:flex;">
                      <div style="width:50%">
                       <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                      </div>
                      
                      <div style="width:50%">
                        <field name="submit_mode" invisible="1"/>

                      </div>
                    </div>


                </sheet>
            </form>
        </field>
        </record>




        <record id="view_clay_brick_prefill_data_form" model="ir.ui.view">
            <field name="name">clay.brick.prefill.data.form</field>
            <field name="model">clay.brick.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_clay_brick_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">clay.brick.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_clay_brick_prefill_data_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>