<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_brick_burnt_clay_test_view" model="ir.ui.view">
        <field name="name">mechanical.bricks.burnt.clay.form</field>
        <field name="model">mechanical.bricks.burnt.clay</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id"  readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade"/>
                        <field name="eln_state" />
                        <field name="parameter_id" invisible="1"/>
                    </group>

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                  <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                        <!-- compressive Strength -->

                        <div invisible = "compressive_strength_visible == False">
                          <h1>
                              <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                              <field name="compressive_strength_visible" invisible='1'/>
                          </h1>
                      
                    </div>

                    <table invisible="compressive_strength_visible == False" class="table table-sm table-bordered w-100 mt-2 custom_table_borders">
                        <tbody>
                           <tr>
                                <td></td>
                                <td>Sample 1</td>
                                <td>Sample 2</td>
                                <td>Sample 3</td>
                                <td>Sample 4</td>
                                <td>Sample 5</td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="length"></label></td>
                                <td><field name="length" nolabel="1" class="blue-input"/></td>
                                <td><field name="length_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="length_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="length_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="length_5" nolabel="1" class="blue-input"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="width"></label></td>
                                <td><field name="width" nolabel="1" class="blue-input"/></td>
                                <td><field name="width_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="width_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="width_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="width_5" nolabel="1" class="blue-input"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="height"></label></td>
                                <td><field name="height" nolabel="1" class="blue-input"/></td>
                                <td><field name="height_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="height_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="height_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="height_5" nolabel="1" class="blue-input"/></td>
                            </tr>

                             <tr>
                                <td><label class="fw-bold" for="area"></label></td>
                                <td><field name="area" nolabel="1" class="blue-input"/></td>
                                <td><field name="area_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="area_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="area_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="area_5" nolabel="1" class="blue-input"/></td>
                            </tr>

                            

                             <tr>
                                <td><label class="fw-bold" for="load"></label></td>
                                <td><field name="load" nolabel="1" class="blue-input"/></td>
                                <td><field name="load_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="load_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="load_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="load_5" nolabel="1" class="blue-input"/></td>
                            </tr>

                             <tr>
                                <td><label class="fw-bold" for="comp_strength_1"></label></td>
                                <td><field name="comp_strength_1" nolabel="1" class="blue-input"/></td>
                                <td><field name="comp_strength_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="comp_strength_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="comp_strength_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="comp_strength_5" nolabel="1" class="blue-input"/></td>
                            </tr>

                          
                        </tbody>
                    </table>

                    <table invisible="compressive_strength_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                          
                            <tr>
                                <td><label class="fw-bold" for="avrg_compressive_strength"></label></td>
                                <td><field name="avrg_compressive_strength" nolabel="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="comp_strength_confirmity"></label></td>
                                <td>
                                    <field name="comp_strength_confirmity"
                                        decoration-success="comp_strength_confirmity == 'pass'"
                                        decoration-danger="comp_strength_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="comp_strength_nabl"></label></td>
                                <td><field name="comp_strength_nabl"
                                            decoration-success="comp_strength_nabl == 'pass'"
                                            decoration-danger="comp_strength_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                           
                        </tbody>
                    </table>
                  
                    
                    
                    

                             <!-- visual_observation -->

                    <div  invisible = "efflorescence_visible == False">
                        <h1>
                            <field name="visual_observation_name_efflorescence" readonly="1" nolabel="1"/>
                            <field name="efflorescence_visible" invisible='1'/>
                        </h1>
                    </div>



                     <table invisible="efflorescence_visible == False" class="table table-sm table-bordered w-100 mt-2 custom_table_borders">
                        <tbody>
                           <tr>
                                <td></td>
                                <td>Observation 1</td>
                                <td>Observation 2</td>
                                <td>Observation 3</td>
                                <td>Observation 4</td>
                                <td>Observation 5</td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="visual_observation_1"></label></td>
                                <td><field name="visual_observation_1" nolabel="1" class="blue-input"/></td>
                                <td><field name="visual_observation_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="visual_observation_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="visual_observation_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="visual_observation_5" nolabel="1" class="blue-input"/></td>
                            </tr>
                           
                          
                        </tbody>
                    </table>

                      <!--Dimension -->

                    <div invisible = "dimension_visible == False">
                        <h1>
                            <field name="dimension_name1" readonly="1" nolabel="1"/>
                          <h1>
                            20 Bricks
                          </h1>
                            <field name="dimension_visible" invisible='1'/>
                        </h1>
                    </div>

                     <div invisible="not dimension_visible">
                     <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                        <tbody>
                          <tr>
                           
                            <td><span>Length in (mm)</span></td>
                            <td><span>Width in (mm)</span></td>
                            <td><span>Height in (mm)</span></td>
                            
                          </tr>
                          <tr>
                           
                            <td><field  name="avrg_length"  colspan="3"  nolabel="1" class="blue-input"/></td>
                            <td><field  name="avrg_width"  colspan="3"  nolabel="1" class="blue-input"/></td>
                            <td> <field  name="avrg_height"  colspan="3"  nolabel="1" class="blue-input"/></td>

                          </tr>
                        </tbody>
                      </table>
                    </div>

                      <!-- Water Absorbtion -->
                      
                    <div invisible = "water_absorbtion_visible == False" >
                        <h1>
                            <field name="wt_absorption_name" readonly="1" nolabel="1"/>
                              <field name="water_absorbtion_visible" invisible='1'/>

                        </h1>
                    </div>


                    <table invisible="water_absorbtion_visible == False" class="table table-sm table-bordered w-100 mt-2 custom_table_borders">
                        <tbody>
                           <tr>
                                <td></td>
                                <td>Sample 1</td>
                                <td>Sample 2</td>
                                <td>Sample 3</td>
                                <td>Sample 4</td>
                                <td>Sample 5</td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="initial_wt"></label></td>
                                <td><field name="initial_wt" nolabel="1" class="blue-input"/></td>
                                <td><field name="initial_wt_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="initial_wt_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="initial_wt_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="initial_wt_5" nolabel="1" class="blue-input"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="final_wt"></label></td>
                                <td><field name="final_wt" nolabel="1" class="blue-input"/></td>
                                <td><field name="final_wt_2" nolabel="1" class="blue-input"/></td>
                                <td><field name="final_wt_3" nolabel="1" class="blue-input"/></td>
                                <td><field name="final_wt_4" nolabel="1" class="blue-input"/></td>
                                <td><field name="final_wt_5" nolabel="1" class="blue-input"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="water_absorption"></label></td>
                                <td><field name="water_absorption" nolabel="1" /></td>
                                <td><field name="water_absorption_2" nolabel="1" /></td>
                                <td><field name="water_absorption_3" nolabel="1" /></td>
                                <td><field name="water_absorption_4" nolabel="1" /></td>
                                <td><field name="water_absorption_5" nolabel="1" /></td>
                            </tr>

                            
                          
                        </tbody>
                    </table>

                     <table invisible="water_absorbtion_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                          
                            <tr>
                                <td><label class="fw-bold" for="avrg_water_absorption"></label></td>
                                <td><field name="avrg_water_absorption" nolabel="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="water_absorption_confirmity"></label></td>
                                <td>
                                    <field name="water_absorption_confirmity"
                                        decoration-success="water_absorption_confirmity == 'pass'"
                                        decoration-danger="water_absorption_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="water_absorption_nabl"></label></td>
                                <td><field name="water_absorption_nabl"
                                            decoration-success="water_absorption_nabl == 'pass'"
                                            decoration-danger="water_absorption_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                           
                        </tbody>
                    </table>
                  
                  

                     <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>
                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>