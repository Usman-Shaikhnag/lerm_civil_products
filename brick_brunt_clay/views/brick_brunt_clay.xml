<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_brick_burnt_clay_view" model="ir.ui.view">
        <field name="name">mechanical.bricks.burnt.clay.form</field>
        <field name="model">mechanical.bricks.burnt.clay</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                     <h1>
                        <field name="name2" readonly="1" nolabel="1"/>
                    </h1>

                      <group style="white-space: nowrap; width:70%;">
                     
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                       
                        </group>

                      <group>
                       <field name="grade"/>
                        <field name="size_id"/>
                    </group>



                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <!-- <field name="size_id"/> -->
                        <field name="lab_id" invisible="1" />
                        <field name="parameter_id" invisible="1"/>
                    </group>
                       <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>
                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <button name="action_generate_options_brick_clay" 
                            type="object" 
                            string="Show Lab ID" 
                            class="oe_highlight"/>

                    <field name="lab_brick_clay_ids" invisible="1">
                        <tree editable="bottom">
                            <field name="lab"/>
                        </tree>
                    </field>
                    

                    <!--  Compressive Strength  -->

                    <div invisible=" not compressive_strength_visible">
                        <h1 class="text-center">
                            <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                            <field name="compressive_strength_visible" invisible="1"/>
                            
                        </h1>
                    </div>



                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="is_lab_compressive_strength"></label></td>
                                    <td><field name="is_lab_compressive_strength"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not compressive_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_lab_brickclay1"></label></td>
                                    <td ><field name="selected_lab_brickclay1"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                    <div class="d-flex gap-2" invisible="not compressive_strength_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_compressive_strength">Temp.°C</label></td>
                                    <td><field name="temp_compressive_strength" class="blue-input" invisible="not compressive_strength_visible" required = "calc_mode == False or is_lab_compressive_strength == True "/></td>
                                                                                     
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_compressive_strength">Humidity %</label></td>
                                    <td><field name="humidity_compressive_strength" class="blue-input" invisible="not compressive_strength_visible" required = "calc_mode == False or is_lab_compressive_strength == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                          
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><field name="calc_mode" class="blue-input" invisible="not compressive_strength_visible"  /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>
                        
                    

                   

                    <div invisible="compressive_strength_visible == False" class="custom_table_borders">
                        <field name="compressive_strength_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name="serial_no"/>
                                <field name='sample1' width="100px" class="blue-input" decoration-info="sample1 != 0"/>
                                <field name='length' class="blue-input" decoration-info="length != 0"/>
                                <field name='width'  class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                <field name='area'/>
                                <field name='load' class="blue-input" decoration-info="load != 0"/>
                                <!-- <field name='correction_factor'/> -->
                                <field name='compressive_strength' />
                                
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="not compressive_strength_visible" style="white-space:nowrap;">
                        <tbody>
                        <tr>
                                <td><label class="fw-bold" for="avg_compressive_strength">Average Compressive Strength N/mm²</label></td>
                                <td>
                                    <field name="avg_compressive_strength"/> <span><field name="compressive_strength_unit" readonly="1" nolabel="1"/></span>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_compressive_strength_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_compressive_strength_conformity"
                                        decoration-success="avg_compressive_strength_conformity == 'pass'" 
                                        decoration-danger="avg_compressive_strength_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_compressive_strength_nabl">NABL Status</label></td>
                                <td>
                                    <field name="avg_compressive_strength_nabl"
                                        decoration-success="avg_compressive_strength_nabl == 'pass'" 
                                        decoration-danger="avg_compressive_strength_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <group/>



                 
                   <!-- Water Absorption -->

                    <div invisible=" not water_absorption_visible">
                        <h1 class="text-center">
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                            
                        </h1>
                    </div>


                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="is_lab_water_absorption"></label></td>
                                    <td><field name="is_lab_water_absorption"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>



                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not water_absorption_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_lab_brickclay2"></label></td>
                                    <td ><field name="selected_lab_brickclay2"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                    <div class="d-flex gap-2" invisible="not water_absorption_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_water_absorption">Temp.°C</label></td>
                                    <td><field name="temp_water_absorption" class="blue-input" invisible="not water_absorption_visible" required = "calc_mode == False or is_lab_water_absorption == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_water_absorption">Humidity %</label></td>
                                    <td><field name="humidity_water_absorption" class="blue-input" invisible="not water_absorption_visible" required = "calc_mode == False or is_lab_water_absorption == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>


                    <div invisible="water_absorption_visible == False" class="custom_table_borders">
                        <field name="water_absorption_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name="serial_no" width="30px" />
                                <field name='sample' width="100px" class="blue-input" decoration-info="sample != 0"/>
                                <field name='dry_weight' class="blue-input" decoration-info="dry_weight != 0"/>
                                <field name='sat_weight' class="blue-input" decoration-info="sat_weight != 0"/>

                                <field name='sat_dry_weight'/>
                                <field name='water_absorption'/>
                                
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="not water_absorption_visible" style="white-space:nowrap;">
                        <tbody>
                        <tr>
                                <td><label class="fw-bold" for="avg_water_absorption">Average Water Absorption %</label></td>
                                <td>
                                    <field name="avg_water_absorption"/> <span><field name="water_absorption_unit" readonly="1" nolabel="1"/></span>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                        decoration-success="avg_water_absorption_conformity == 'pass'" 
                                        decoration-danger="avg_water_absorption_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_nabl">NABL Status</label></td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                        decoration-success="avg_water_absorption_nabl == 'pass'" 
                                        decoration-danger="avg_water_absorption_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <group/>

                    <!-- Dimensions -->

                     <div invisible=" not dimension_visible">
                        <h1 class="text-center">
                            <field name="dimension_name" readonly="1" nolabel="1"/>
                            <field name="dimension_visible" invisible="1"/>
                            <field name="length_visible" invisible="1"/>
                            <field name="width_visible" invisible="1"/>
                            <field name="height_visible" invisible="1"/>
                            
                        </h1>
                    </div>


                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="is_lab_dimension"></label></td>
                                    <td><field name="is_lab_dimension"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>



                      <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not dimension_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_lab_brickclay3"></label></td>
                                    <td ><field name="selected_lab_brickclay3"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                    <div class="d-flex gap-2" invisible="not dimension_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_dimension">Temp.°C</label></td>
                                    <td><field name="temp_dimension" class="blue-input" invisible="not dimension_visible" required = "calc_mode == False or is_lab_dimension == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_dimension">Humidity %</label></td>
                                    <td><field name="humidity_dimension" class="blue-input" invisible="not dimension_visible" required = "calc_mode == False or is_lab_dimension == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>

                    <div invisible="not dimension_visible">
                     <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr class="text-center" >
                           <td >Sr No</td>
                           <td >Dimensions (mm)</td>
                           <td ><span> 1</span></td>
                           <td ><span> 2</span></td>
                           <td ><span> 3</span></td>
                           <td ><span> Average </span></td>
                         </tr>
                         <tr class="text-center">
                         <td ><span> 1</span></td>
                           <td><label for="length1"></label></td>
                           <td><field  name="length1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="length2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="length3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="avg_length"  colspan="1"  nolabel="1"/></td>
                          </tr>
                         <tr class="text-center">
                         <td ><span> 2</span></td>
                           <td><label for="width1"></label></td>
                           <td><field  name="width1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="width2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="width3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="avg_width"  colspan="1"  nolabel="1"/></td>
                         </tr>
                         <tr class="text-center"> 
                          <td ><span> 3</span></td>
                           <td><label for="height1"></label></td>
                           <td><field  name="height1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="height2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="height3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="avg_height"  colspan="1"  nolabel="1"/></td>
                         </tr>

                         
                      
                         
                        

                       </tbody>
                     </table>
                    </div>

                    <div class="d-flex gap-2" invisible="not dimension_visible">
                        <table class="table table-sm o_form_table table-bordered flex-fill custom_table_borders" style="width:33%">
                            <tbody>
                                

                                <tr>
                                <td><label class="fw-bold" for="avg_length_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_length_conformity"
                                        decoration-success="avg_length_conformity == 'pass'" 
                                        decoration-danger="avg_length_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_length_nabl">NABL Status</label></td>
                                <td>
                                    <field name="avg_length_nabl"
                                        decoration-success="avg_length_nabl == 'pass'" 
                                        decoration-danger="avg_length_nabl == 'fail'"/>
                                </td>
                            </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered flex-fill custom_table_borders" style="width:33%">
                            <tbody>
                                

                                <tr>
                                <td><label class="fw-bold" for="avg_width_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_width_conformity"
                                        decoration-success="avg_width_conformity == 'pass'" 
                                        decoration-danger="avg_width_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_width_nabl">NABL Status</label></td>
                                <td>
                                    <field name="avg_width_nabl"
                                        decoration-success="avg_width_nabl == 'pass'" 
                                        decoration-danger="avg_width_nabl == 'fail'"/>
                                </td>
                            </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered  custom_table_borders" style="width:33%">
                            <tbody>
                                

                                <tr>
                                <td><label class="fw-bold" for="avg_height_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_height_conformity"
                                        decoration-success="avg_height_conformity == 'pass'" 
                                        decoration-danger="avg_height_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_height_nabl">NABL Status</label></td>
                                <td>
                                    <field name="avg_height_nabl"
                                        decoration-success="avg_height_nabl == 'pass'" 
                                        decoration-danger="avg_height_nabl == 'fail'"/>
                                </td>
                            </tr>
                                
                            </tbody>
                        </table>
                    </div>



                      <!-- efforescence visual_observation -->
                    <div invisible="efforescence_visible == False" style="text-align:center">
                        <h1>
                            <field name="visual_observation_name_efforescence" readonly="1" nolabel="1"/>
                            <field name="efforescence_visible" invisible='1'/>
                        </h1>
                    </div>

                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not efforescence_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_lab_brickclay4"></label></td>
                                    <td ><field name="selected_lab_brickclay4"/></td>
                                </tr>
                                
                            </tbody>
                        </table>



                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="is_lab_efforescence"></label></td>
                                    <td><field name="is_lab_efforescence"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>


                    <div class="d-flex gap-2" invisible="not efforescence_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_efforescence">Temp.°C</label></td>
                                    <td><field name="temp_efforescence" class="blue-input" invisible="not efforescence_visible" required = "calc_mode == False or is_lab_efforescence == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_efforescence">Humidity %</label></td>
                                    <td><field name="humidity_efforescence" class="blue-input" invisible="not efforescence_visible" required = "calc_mode == False or is_lab_efforescence == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>

                    <div invisible="efforescence_visible == False" class="mb-3">
                        <table class="table custom_table_borders o_form_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Observation 1</th>
                                </tr>
                            </thead>
                            <tbody>
                            
                             <tr>
                                    <td><strong>Observation</strong></td>
                                    <td><field name="visual_observation_1" nolabel="1" class="blue-input"/></td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
