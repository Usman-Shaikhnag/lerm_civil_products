<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_brick_burnt_clay_view" model="ir.ui.view">
        <field name="name">mechanical.bricks.burnt.clay.form</field>
        <field name="model">mechanical.bricks.burnt.clay</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                     <h1>
                        <field name="name2" readonly="1" nolabel="1"/>
                    </h1>

                      <group>
                       <field name="grade"/>
                    </group>




                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>

                        <field name="parameter_id" invisible="1"/>
                    </group>


                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>



                       <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                 
                    <table class="table o_form_table custom_table_borders">
                        <thead>
                            <tr>
                                <th></th>
                                <th style="text-align: center;">L</th>
                                <th style="text-align: center;">B</th>
                                <th style="text-align: center;">H</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Size of the Brick :- (mm)</td>
                                <td style="text-align: center;"><field name="length_in_mm" nolabel="1" class="blue-input"/></td>
                                <td style="text-align: center;"><field name="width_in_mm" nolabel="1" class="blue-input"/></td>
                                <td style="text-align: center;"><field name="height_in_mm" nolabel="1" class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>
         
                        <!-- compressive Strength -->

                    <div invisible="compressive_strength_visible == False" style="text-align:center">
                      <h1>
                          <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                          <field name="compressive_strength_visible" invisible='1'/>
                      </h1>
                    </div>
                    
                   
                     <div invisible = "compressive_strength_visible == False"  >
                    <field name="compressive_strength_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no" />
                                <field name="identification_mark" class="blue-input" decoration-info="identification_mark != 0"/>
                                <field name='length' class="blue-input" decoration-info="length != 0"/>
                                <field name='width' class="blue-input" decoration-info="height != 0"/>
                                <field name='height' class="blue-input" decoration-info="height != 0"/>
                                <field name='area' />
                                <field name='load' class="blue-input" decoration-info="load != 0"/>
                                <field name='comp_strength_1' />
                                
                            </tree>
                    </field>
                    </div>

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not compressive_strength_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Compressive Strength</strong></td>
                                <td>
                                    <field name="avrg_compressive_strength"/>  <span><field name="compressive_strength_unit" readonly="1" nolabel="1"/></span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Compressive Strength Conformity</strong></td>
                                <td>
                                    <field name="comp_strength_confirmity"
                                        decoration-success="comp_strength_confirmity == 'pass'"
                                        decoration-danger="comp_strength_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong for="comp_strength_nabl">Compressive Strength NABL</strong></td>
                                <td>
                                    <field name="comp_strength_nabl"
                                        decoration-success="comp_strength_nabl == 'pass'"
                                        decoration-danger="comp_strength_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <!--  -->

                  
                    <div invisible="water_absorbtion_visible == False" style="text-align:center">
                        <h1>
                          <field name="wt_absorption_name" readonly="1" nolabel="1"/>
                          <field name="water_absorbtion_visible" invisible='1'/>
                        </h1>
                    </div>
                                    
                      <div invisible = "water_absorbtion_visible == False"  >
                            <field name="water_absorption_lines" nolabel="1" >
                                    <tree editable="bottom"  class="custom_table_borders">
                                        <field name="serial_no" />
                                        <field name="identification_mark" class="blue-input" decoration-info="identification_mark != 0"/>
                                        <field name='initial_wt' class="blue-input" decoration-info="initial_wt != 0"/>
                                        <field name='final_wt' class="blue-input" decoration-info="final_wt != 0"/>
                                        <field name='water_absorption' />
                                    
                                    </tree>
                            </field>
                            </div>
                    

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_absorbtion_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Water Absorption</strong></td>
                                <td>
                                    <field name="avrg_water_absorption"/>  <span><field name="water_absorption_unit" readonly="1" nolabel="1"/></span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Water Absorption Conformity</strong></td>
                                <td>
                                    <field name="water_absorption_confirmity"
                                        decoration-success="water_absorption_confirmity == 'pass'"
                                        decoration-danger="water_absorption_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Water Absorption NABL</strong></td>
                                <td>
                                    <field name="water_absorption_nabl"
                                        decoration-success="water_absorption_nabl == 'pass'"
                                        decoration-danger="water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                      <!-- visual_observation -->
                    <div invisible="efflorescence_visible == False" style="text-align:center">
                        <h1>
                            <field name="visual_observation_name_efflorescence" readonly="1" nolabel="1"/>
                            <field name="efflorescence_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible="efflorescence_visible == False" class="mb-3">
                        <table class="table custom_table_borders o_form_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Observation 1</th>
                                    <th>Observation 2</th>
                                    <th>Observation 3</th>
                                    <th>Observation 4</th>
                                    <th>Observation 5</th>
                                </tr>
                            </thead>
                            <tbody>
                            
                             <tr>
                                    <td><strong>Observation</strong></td>
                                    <td><field name="visual_observation_1" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_5" nolabel="1" class="blue-input"/></td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                    <!-- Initial Rate Of Absorption -->

                     <div invisible="ini_rate_absorption_visible == False" style="text-align:center">
                      <h1>
                          <field name="ini_rate_absorption_name" readonly="1" nolabel="1"/>
                          <field name="ini_rate_absorption_visible" invisible='1'/>
                      </h1>
                    </div>
                    
                   
                     <div invisible = "ini_rate_absorption_visible == False"  >
                    <field name="absorption_line_ids" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no" />
                                <field name="iW1" class="blue-input" decoration-info="iW1 != 0"/>
                                <field name='W2' class="blue-input" decoration-info="W2 != 0"/>
                                <field name='W2_W1'/>
                                <field name='area'/>
                                <field name='initial_rate_absorp' />
                                
                            </tree>
                    </field>
                    </div>

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not ini_rate_absorption_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Initial Rate of Absorption (g/min/100 cm²)</strong></td>
                                <td>
                                    <field name="average_ira" readonly="1" nolabel="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>



                    
                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>




                  <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>