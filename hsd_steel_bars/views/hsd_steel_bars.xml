<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_hsd_steel_bars_form" model="ir.ui.view">
        <field name="name">mechanical.hsd.steel.bars.form</field>
        <field name="model">mechanical.hsd.steel.bars</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>

                <div>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="grade"/>
                        <field name="eln_state" />

                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temp"></label>
                                    </td>
                                    <td>
                                        <field name="temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>


                    <!-- Mass Per Meter Of High Strength Deformed Steel Bars -->

                    <div class="text-center" invisible="mass_per_meter_visible == False">
                        <h1>
                            <field name="mass_per_meter_name" readonly="1" nolabel="1"/>
                            <field name="mass_per_meter_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "mass_per_meter_visible == False" class="custom_table_borders">
                        <field name="mass_per_meter_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='bar_dia' class="blue-input" decoration-info="bar_dia != 0"/>
                                <field name='sample_length' class="blue-input" decoration-info="sample_length != 0"/>
                                <field name='mass' class="blue-input" decoration-info="mass != 0"/>
                                <field name='standard_mass'/>
                                <field name='remark' class="blue-input" decoration-info="remark != 0" width="100px"/>
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not mass_per_meter_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_standard_mass">Average Standard Mass (kg/m)</label></td>
                                <td><field name="avg_standard_mass"/><span>(kg/m)</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_standard_mass_confirmity">Conformity</label></td>
                                <td>
                                    <field name="avg_standard_mass_confirmity"
                                        decoration-success="avg_standard_mass_confirmity == 'pass'" 
                                        decoration-danger="avg_standard_mass_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_standard_mass_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_standard_mass_nabl"
                                        decoration-success="avg_standard_mass_nabl == 'pass'" 
                                        decoration-danger="avg_standard_mass_nabl == 'fail'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="standard_mass_report_type">Report Type</label></td>
                                <td><field name="standard_mass_report_type" class="blue-input" decoration-info="standard_mass_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>



                    
                    
                    

                   
                        


                

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
        </field>
        </record>

        <record id="view_aac_block_prefill_data_form" model="ir.ui.view">
            <field name="name">aac.block.prefill.data.form</field>
            <field name="model">aac.block.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_aac_block_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">aac.block.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_aac_block_prefill_data_form"/>
            <field name="target">new</field>
        </record>


       
    </data>
</odoo>