<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="routine_pile_load_report">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="o">

      <div t-attf-style="position:relative; width:210mm; height:297mm; overflow:hidden; margin:0; padding:0; #{'page-break-after: always;' if not o_last else ''}">

          <!-- Background image, full bleed -->
          <img t-att-src="cover_image" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;"/>

          <!-- Foreground content -->
          <div style="position:relative; padding:40px;">
              <h1>Report Title</h1>
              <p>Content goes here...</p>
          </div>

          <!-- Footer image -->
          <div style="position:absolute; left:0; bottom:0; width:100%; z-index:10;">
              <img t-att-src="footer_image" style="width:100%; display:block;"/>
          </div>

      </div>

    </t>
  </t>
</template>
</odoo>