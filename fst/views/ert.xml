<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="soil_borehole_parent_tree_view" model="ir.ui.view">
            <field name="name">soil.borehole.parent.tree</field>
            <field name="model">soil.borehole.parent</field>
            <field name="arch" type="xml">
                <tree>
                    <field name='name'/>
                    <field name="rec_date" optional="show" />
                    <button name="action_duplicate_parent" string="Duplicate Project" type="object" class="btn-secondary" icon="fa-copy"/>
                </tree>
            </field>
        </record>

        <record id="soil_borehole_parent_view" model="ir.ui.view">
            <field name="name">soil.borehole.parent.form</field>
            <field name="model">soil.borehole.parent</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="print_report" string="Print Project Report" type="object" class="btn-primary"/>
                        <button name="print_cross_hatching" string="Cross Section" type="object" class="btn-primary"/>
                        <button name="print_corrected_spt" string="Corrected N value" type="object" class="btn-primary"/>
                        <button name="print_grain_size" string="Grain Size" type="object" class="btn-primary"/>
                        <button name="print_direct_shear" string="Direct Shear" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="rec_date"/>
                        </group>
                        <button type="object"
                                class="oe_highlight"
                                name="create_ert"
                                string="Borehole"/>
                        <notebook>
                            <page string="">
                                <field name="borehole_lines" readonly="1">
                                    <tree editable="bottom">
                                        <field name="soil_borehole_id" widget="many2one" options="{'no_open': False}"/>
                                        <field name="create_date" readonly="1"/>
                                        <button name="action_duplicate_borehole" string="Duplicate" type="object" class="btn-secondary me-5" icon="fa-copy"/>
                                        <button name="action_delete_line" string="Delete" type="object" icon="fa-trash" class="btn-danger" confirm="Are you sure you want to delete this line?"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ert_dashboard" model="ir.actions.act_window">
            <field name="name">FST Dashboard</field>
            <field name="res_model">lerm.ert.dashboard</field>
            <field name="view_mode">kanban</field>
            <field name="target">current</field>
            <field name="limit">1</field>
        </record>

        <record id="action_temp_monitoring" model="ir.actions.act_window">
            <field name="name">Temperature Monitoring</field>
            <field name="res_model">lerm.temp.monitoring</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="fst_root"
            name="FST"
            sequence="11"
            action="action_ert_dashboard"
            />

        <record id="view_ert_dashboard" model="ir.ui.view">
            <field name="name">lerm.ert.dashboard.view</field>
            <field name="model">lerm.ert.dashboard</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard o_kanban_dashboard_background" create="false" delete="false">
                    <templates>
                        <t t-name="kanban-box">
                            <div style="width:100%; max-width:100%; display:grid; grid-template-columns:repeat(auto-fit,minmax(350px,1fr)); gap:15px;">
                                <!-- Temperature -->
                                <div class="card-box" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;">
                                    <h3 class="title">Temperature Monitoring</h3>
                                    <a type="action"
                                    name="%(action_temp_monitoring)d"
                                    class="btn btn-lg"
                                    style="background:#ffb300; color:#000;">
                                        Records
                                    </a>
                                </div>

                            </div>

                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Ensure one record exists -->
        <record id="lerm_ert_dashboard_record" model="lerm.ert.dashboard"/>

        <menuitem id="menu_ert_dashboard"
          name="FST Dashboard"
          parent="fst_root"
          action="action_ert_dashboard"
          sequence="1"/>

    </data>
</odoo>
