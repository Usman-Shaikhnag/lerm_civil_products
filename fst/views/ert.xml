<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_open_ert_report_wizard" model="ir.actions.act_window">
            <field name="name">ERT Report Wizard</field>
            <field name="res_model">ert.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_ert_report_wizard_form" model="ir.ui.view">
            <field name="name">ert.report.wizard.form</field>
            <field name="model">ert.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Download ERT Reports">
                    <sheet>
                        <group>
                            <field name="parent_id" readonly="1"/>
                        </group>
                        <field name="line_ids">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="selected"/>
                                <field name="soil_resistivity_id" readonly="1"/>
                                <field name="line_id" invisible="1" optional="hide"/>
                            </tree>
                        </field>
                    </sheet>
                    <footer>
                        <button string="Download Reports"
                                type="object"
                                name="action_print_reports"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="ert_parent_view" model="ir.ui.view">
            <field name="name">lerm.ert.parent.form</field>
            <field name="model">lerm.ert.parent</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <!-- <button name="%(action_open_ert_report_wizard)d"
                            string="Print ERT Reports"
                            type="action"
                            class="btn-primary"/> -->
                            <button name="print_report"
                            string="Print Project Report"
                            type="object"
                            class="btn-primary"/>

                    </header>
              
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="rec_date"/>
                        </group>

                        
                        <button
                            type="object"
                            class="oe_highlight" 
                            name="create_ert"
                            string="Create ERT"
                            />

                        <field name="ert_lines" readonly="1">
                            <tree editable="bottom">
                                <field name="soil_resistivity_id" widget="many2one" options="{'no_open': False}"/>
                                <field name="create_date" readonly="1"/>
                                <button name="action_duplicate_ert" string="Duplicate" type="object" icon="fa-copy" class="btn-secondary me-5"/>
                                <button name="action_delete_line" string="Delete" type="object" icon="fa-trash" class="btn-danger" confirm="Are you sure you want to delete this line?"/>
                            </tree>
                        </field>
                    
                    
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="soil_borehole_parent_tree_view" model="ir.ui.view">
            <field name="name">soil.borehole.parent.tree</field>
            <field name="model">soil.borehole.parent</field>
            <field name="arch" type="xml">
                <tree>
                    <field name='name'/>
                    <field name="rec_date" optional="show" />
                    <button name="action_duplicate_parent" string="Duplicate Project" type="object" class="btn-secondary" icon="fa-copy"/>
                </tree>
            </field>
        </record>


        <record id="soil_borehole_parent_view" model="ir.ui.view">
            <field name="name">soil.borehole.parent.form</field>
            <field name="model">soil.borehole.parent</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="print_report" string="Print Project Report" type="object" class="btn-primary"/>
                        <button name="print_cross_hatching" string="Cross Section" type="object" class="btn-primary"/>
                        <button name="print_corrected_spt" string="Corrected N value" type="object" class="btn-primary"/>
                        <button name="print_grain_size" string="Grain Size" type="object" class="btn-primary"/>
                        <button name="print_direct_shear" string="Direct Shear" type="object" class="btn-primary"/>
                        <!-- <button name="action_open_react" string="Open in React" type="object" class="btn-primary"/> -->

                    </header>

                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="rec_date"/>
                        </group>

                        <button type="object"
                                class="oe_highlight"
                                name="create_ert"
                                string="Borehole"/>

                        <!-- <field name="borehole_lines" readonly="1"> 
                            <tree editable="bottom"> 
                                <field name="soil_borehole_id" widget="many2one" options="{'no_open': False}"/> 
                                <field name="create_date" readonly="1"/> 
                            </tree> 
                        </field> -->
                        <notebook>
                            <page string="">
                                <field name="borehole_lines" readonly="1">
                                    <tree editable="bottom">
                                        <field name="soil_borehole_id" widget="many2one" options="{'no_open': False}"/>
                                        <field name="create_date" readonly="1"/>

                                        <button name="action_duplicate_borehole" string="Duplicate" type="object" class="btn-secondary me-5" icon="fa-copy"/>
                                        <button name="action_delete_line" string="Delete" type="object" icon="fa-trash" class="btn-danger" confirm="Are you sure you want to delete this line?"/>
                                    
                                    </tree>
                                </field>
                            </page>

                            <!-- <page string="Combined Images">
                                <field name="combined_images">
                                    <tree>
                                        <field name="sequence"/>
                                        <field name="image" widget="image"/>
                                    </tree>
                                    <form>
                                        <sheet>
                                            <field name="sequence"/>
                                            <field name="image" widget="image" class="oe_avatar"/>
                                        </sheet>
                                    </form>
                                </field>
                            </page> -->
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_print_report" model="ir.actions.server">
            <field name="name">Print Report</field>
            <field name="model_id" ref="model_lerm_ert_parent"/>   <!-- your model -->
            <field name="binding_model_id" ref="model_lerm_ert_parent"/>  <!-- bind to model -->
            <field name="binding_view_types">list</field>   <!-- will appear in Action menu of tree view -->
            <field name="state">code</field>
            <field name="code">records.print_report()</field>
        </record>

        <record id="ert_parent_tree_view" model="ir.ui.view">
            <field name="name">lerm.ert.parent.tree</field>
            <field name="model">lerm.ert.parent</field>
            <field name="arch" type="xml">
                <tree>
                    <!-- <header>
                        <button name="print_report" string="Print Report" type="object" class="btn-primary"/>
