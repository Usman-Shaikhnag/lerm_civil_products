<odoo>

    <record id="view_pile_load_import_wizard" model="ir.ui.view">
        <field name="name">pile.load.import.wizard.form</field>
        <field name="model">pile.load.import.wizard</field>
        <field name="arch" type="xml">

            <form string="Import Excel">

                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>

                <footer>
                    <button
                        string="Import"
                        type="object"
                        name="action_import_excel"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                    />
                </footer>

            </form>

        </field>
    </record>

</odoo>