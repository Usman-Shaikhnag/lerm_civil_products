<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_routine_pullout_pile_load_test_parent_tree" model="ir.ui.view">
        <field name="name">routine.pullout.pile.load.test.parent.tree</field>
        <field name="model">routine.pullout.pile.load.test.parent</field>
        <field name="arch" type="xml">
            <tree string="Routine Pullout Pile Load Test Reports">

                <field name="name"/>
                <button
                    name="action_duplicate_parent"
                    type="object"
                    string="Duplicate"
                    icon="fa-copy"
                    class="btn-secondary"
                />
                
                <button 
                    name="action_delete_line" 
                    string="Delete" 
                    type="object" 
                    icon="fa-trash" 
                    class="btn-danger" 
                    confirm="Are you sure you want to delete this line?"
                />

            </tree>
        </field>
    </record>

    <record id="view_routine_pullout_pile_load_test_parent_form" model="ir.ui.view">
        <field name="name">routine.pullout.pile.load.test.parent.form</field>
        <field name="model">routine.pullout.pile.load.test.parent</field>
        <field name="arch" type="xml">

            <form string="Routine Pull-Out Pile Load Test Report">
                <!-- ================= HEADER ================= -->
                <header>
                    <button name="print_report"
                            string="Print Report"
                            type="object"
                            class="btn-primary"/>
                </header>

                <sheet>

                    <!-- ================= COVER ================= -->
                    <div style="text-align:center; margin-top:30px; margin-bottom:40px;">
                        <h1 style="font-size:26px;">
                            <field name="name" style="width:100%; display:block; text-align:center; font-size:26px; letter-spacing:1px;"/>
                        </h1>
                        <h2>ROUTINE PULL OUT PILE LOAD TEST</h2>
                    </div>

                    <group col="2" style="margin-bottom:30px;">
                        <field name="report_no"/>
                        <field name="rec_date"/>
                        <field name="test_standard"/>
                        <field name="site_location" colspan="2"/>
                    </group>

                    <!-- ================= INTRODUCTION ================= -->
                    <h3 style="border-bottom:2px solid #000;">INTRODUCTION</h3>
                    <div style="border:1px solid #ccc; padding:12px;">
                        <field name="introduction" widget="text" nolabel="1"/>
                    </div>

                    <!-- ================= OBJECTIVE ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:30px;">OBJECTIVE</h3>
                    <div style="border:1px solid #ccc; padding:12px;">
                        <field name="objective" widget="text" nolabel="1"/>
                    </div>

                    <!-- ================= TESTING EQUIPMENT ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:30px;">
                        TESTING EQUIPMENTS
                    </h3>
                    <div style="border:1px solid #ccc; padding:12px;">
                        <field name="test_equipment" widget="text" nolabel="1"/>
                    </div>

                    <!-- ================= TEST PROCEDURE ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:30px;">
                        TEST PROCEDURE
                    </h3>
                    <div style="border:1px solid #ccc; padding:12px;">
                        <field name="test_procedure" widget="text" nolabel="1"/>
                    </div>

                    <!-- ================= TABLE 1 ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:35px;">
                        TABLE 1 : BASIC DATA
                    </h3>

                    <field name="basic_data_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sr_no"/>
                            <field name="parameter"/>
                            <field name="value"/>
                        </tree>
                    </field>

                    <!-- ================= TABLE 2A ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:35px;">
                        TABLE 2A : DIAL GAUGE READING CORRESPONDING TO LOADING
                    </h3>

                    <field name="loading_reading_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="date"/>
                            <field name="time_hours"/>
                            <field name="load_tonne"/>
                            <field name="dial_a"/>
                            <field name="dial_b"/>
                            <field name="mean_mm" readonly="1"/>
                        </tree>
                    </field>

                    <!-- ================= TABLE 2B ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:35px;">
                        TABLE 2B : DIAL GAUGE READING CORRESPONDING TO UNLOADING
                    </h3>

                    <field name="unloading_reading_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="date"/>
                            <field name="time_hours"/>
                            <field name="load_tonne"/>
                            <field name="dial_a"/>
                            <field name="dial_b"/>
                            <field name="mean_mm" readonly="1"/>
                        </tree>
                    </field>

                    <!-- ================= GRAPH BUTTON ================= -->
                    <div style="margin-top:30px; margin-bottom:10px;">
                        <button name="action_generate_graph"
                                type="object"
                                string="Generate Graph"
                                class="btn-primary"/>
                    </div>

                    <!-- ================= GRAPH ================= -->
                    <h3 style="border-bottom:2px solid #000;">
                        LOAD – DISPLACEMENT GRAPH
                    </h3>

                    <field name="graph_image" widget="image"/>

                    <!-- ================= SUMMARY ================= -->
                    <div style="margin-top:20px; font-weight:bold;">
                        Gross Displacement =
                        <field name="gross_displacement" readonly="1"/> mm<br/>
                        Net Displacement =
                        <field name="net_displacement" readonly="1"/> mm<br/>
                        Rebound =
                        <field name="rebound" readonly="1"/> mm
                    </div>

                    <!-- ================= INTERPRETATION ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:35px;">
                        INTERPRETATION
                    </h3>
                    <div style="border:1px solid #ccc; padding:12px;">
                        <field name="interpretation" widget="text" nolabel="1"/>
                    </div>

                    <!-- ================= CONCLUSION ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:35px;">
                        CONCLUSION
                    </h3>
                    <div style="border:1px solid #ccc; padding:12px;">
                        <field name="conclusion" widget="text" nolabel="1"/>
                    </div>

                    <!-- ================= SITE PHOTOGRAPHS ================= -->
                    <h3 style="border-bottom:2px solid #000; margin-top:40px;">
                        SITE PHOTOGRAPHS
                    </h3>

                    <field name="site_image_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="sequence" width="60"/>
                            <field name="image" widget="image" class="oe_avatar"/>
                            <field name="caption"/>
                        </tree>
                    </field>

                </sheet>
            </form>

        </field>
    </record>

</odoo>
