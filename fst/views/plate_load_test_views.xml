<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- FORM VIEW -->
        <record id="view_plate_load_test_form" model="ir.ui.view">
            <field name="name">lerm.plate.load.test.form</field>
            <field name="model">lerm.plate.load.test</field>
            <field name="arch" type="xml">
                <form string="Plate Load Test">
                    <sheet>
                    <h1>
                        <field name="project_name" nolabel="1"/>
                    </h1>
                        <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:12px;">

                            <!-- Row 1 -->
                            <tr>
                                <td style="width:30%; border:1px solid black;">
                                    <strong>Project / Site Address:</strong>
                                </td>
                                <td colspan="3" style="border:1px solid black;">
                                    <field name="site_address" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 2 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>Test Start Date:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="test_start_date" nolabel="1"/>
                                </td>

                                <td style="border:1px solid black;">
                                    <strong>Test End Date:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="test_end_date" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 3 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>Location:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="location" nolabel="1"/>
                                </td>

                                <td style="border:1px solid black;">
                                    <strong>Strata:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="strata" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 4 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>Size of Plate:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="plate_size" nolabel="1"/>
                                </td>

                                <td style="border:1px solid black;">
                                    <strong>Concessionaire:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="concessionaire" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 5 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>PMC Name:</strong>
                                </td>
                                <td colspan="3" style="border:1px solid black;">
                                    <field name="pmc_name" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 6 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>EPC Contractor:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="epc_contractor" nolabel="1"/>
                                </td>

                                <td style="border:1px solid black;">
                                    <strong>Letter Dated On:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="letter_dated" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 7 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>Discipline:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="discipline" nolabel="1"/>
                                </td>

                                <td style="border:1px solid black;">
                                    <strong>Group:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="group" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 8 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>References:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="references" nolabel="1"/>
                                </td>

                                <td style="border:1px solid black;">
                                    <strong>Test Name:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="test_name" nolabel="1"/>
                                </td>
                            </tr>

                            <!-- Row 9 -->
                            <tr>
                                <td style="border:1px solid black;">
                                    <strong>Test Report No:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="report_no" nolabel="1"/>
                                </td>

                                <td style="border:1px solid black;">
                                    <strong>Report Issue Date:</strong>
                                </td>
                                <td style="border:1px solid black;">
                                    <field name="report_issue_date" readonly="1" nolabel="1"/>
                                </td>
                            </tr>
                        </table>                    
                        
                        <field name="plate_test_id" invisible="1"/>

                            <field name="contents_ids">
                                <tree editable="bottom">
                                    <field name="sr_no"/>
                                    <field name="item"/>
                                    <field name="page"/>
                                </tree>
                            </field>

                            <group string="Summary">
                                <field name="safe_bearing_capacity"/>
                                <field name="factor_of_safety"/>
                                <field name="ultimate_bearing_capacity"/>
                                <field name="max_load_intensity"/>
                                <field name="allowable_bearing_capacity"/>
                                <field name="total_settlement"/>
                            </group>

                            <group string="Signatures">
                                <field name="checked_by_name"/>
                                <field name="checked_by_title"/>
                                <field name="approved_by_name"/>
                                <field name="approved_by_title"/>
                            </group>

                            <group string="Annexures">
                                <field name="graph"/>
                                <field name="image_sections" widget="json"/>
                            </group>

                            <button name="open_form" type="object" string="Open Plate Load Form" class="oe_highlight"/>
                            <!-- <field name="pdf_report" filename="pdf_filename" readonly="1"/> -->
                    </sheet>
                </form>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="view_plate_load_test_tree" model="ir.ui.view">
            <field name="name">lerm.plate.load.test.tree</field>
            <field name="model">lerm.plate.load.test</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="project_name"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>