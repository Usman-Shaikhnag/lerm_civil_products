<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         TREE (same buttons + behavior)
    ========================================================== -->
    <record id="view_routine_pile_load_test_tree" model="ir.ui.view">
        <field name="name">routine.pile.load.test.tree</field>
        <field name="model">routine.pile.load.test</field>
        <field name="arch" type="xml">

            <tree string="Routine Pile Load Test Reports">

                <field name="name"/>

                <button
                    name="action_duplicate_parent"
                    type="object"
                    string="Duplicate"
                    icon="fa-copy"
                    class="btn-secondary"
                />

                <button
                    name="action_delete_line"
                    string="Delete"
                    type="object"
                    icon="fa-trash"
                    class="btn-danger"
                    confirm="Are you sure you want to delete this line?"
                />

            </tree>

        </field>
    </record>



    <!-- =========================================================
         FORM (EXACT COPY OF INITIAL)
    ========================================================== -->
    <record id="view_routine_pile_load_test_form" model="ir.ui.view">
        <field name="name">routine.pile.load.test.form</field>
        <field name="model">routine.pile.load.test</field>
        <field name="arch" type="xml">

            <form string="Routine Vertical Pile Load Test Report">

                <header>
                    <button name="action_generate_ulr_no" string="Generate ULR No" type="object" class="btn-primary"/>
                    <button name="action_generate_report_no" string="Generate Report No" type="object" class="btn-primary"/>
                    <button name="print_report" string="Print Report" type="object" class="btn-primary"/>
                </header>

                <sheet>

                    <!-- ================= COVER ================= -->
                    <div style="text-align:center; margin-top:30px; margin-bottom:40px;">
                        <h1 style="font-size:26px; letter-spacing:1px;">
                            <field name="name"
                                   style="width:100%; display:block; text-align:center; font-size:26px; letter-spacing:1px;"/>
                        </h1>
                        <h2 style="margin-top:15px;">
                            ROUTINE VERTICAL PILE LOAD TEST
                        </h2>
                        <h2 style="margin-top:10px;">
                            OF PILE NO -
                            <field name="pile_no" nolabel="1"/>
                        </h2>
                    </div>

                    <!-- ================================================= -->
                    <!-- HEADER DETAILS -->
                    <!-- ================================================= -->

                    <div style="margin-top:40px; border:1px solid black; padding:15px;">

                        <group col="2">

                            <field name="contractor" string="Issued To"/>
                            <field name="client" string="Name of Client"/>

                            <field name="report_no"/>
                            <field name="rec_date"/>

                            <field name="pile_no"/>
                            <field name="site_location"/>

                            <field name="test_standard"/>
                            <field name="ulr"/>

                            <field name="work_name" colspan="2"/>

                        </group>

                    </div>

                    <!-- ================================================= -->
                    <!-- INDEX -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2 style="border-bottom:2px solid black;">
                            INDEX
                        </h2>
                    </div>

                    <field name="content_ids" nolabel="1">

                        <tree editable="bottom">

                            <field name="sequence" string="Clause No"/>
                            <field name="description"/>
                            <field name="page_no"/>

                        </tree>

                    </field>

                    <!-- ================================================= -->
                    <!-- INTRODUCTION -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>1. INTRODUCTION</h2>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="introduction"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- PURPOSE -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>2. PURPOSE</h2>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="purpose"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- SCOPE -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>3. SCOPE</h2>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="scope"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- SELECTION OF PILES -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>4. SELECTION OF PILES FOR PILE LOAD TEST</h2>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="selection_of_piles"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- PROCEDURE -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>5. PROCEDURE ADOPTED FOR TESTING</h2>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="procedure_adopted"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- PROCEDURE STEPS -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h3>THE PROCEDURE INCLUDES FOLLOWING STEPS:</h3>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="test_procedure"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- FEATURES OF TEST PILE -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>7. FEATURES OF TEST PILE</h2>
                    </div>

                    <div style="border:1px solid #bfbfbf; padding:20px;">

                        <group col="2">

                            <div class="o_form_label">
                                Test Pile Diameter
                            </div>
                            <div>
                                <field name="pile_diameter" nolabel="1"/>
                                mm
                            </div>

                            <div class="o_form_label">
                                Type of Pile
                            </div>
                            <field name="pile_type" nolabel="1"/>

                            <div class="o_form_label">
                                Location of Pile
                            </div>
                            <field name="pile_coordinates" nolabel="1"/>

                            <div class="o_form_label">
                                Grade of Concrete
                            </div>
                            <field name="concrete_grade" nolabel="1"/>

                            <div class="o_form_label">
                                Depth of Pile from Cut-off Level
                            </div>
                            <div>
                                <field name="pile_depth" nolabel="1"/>
                                Mtr
                            </div>

                            <div class="o_form_label">
                                Estimated Safe Design Load
                            </div>
                            <div>
                                <field name="design_load" nolabel="1"/>
                                MT
                            </div>

                            <div class="o_form_label">
                                Test Load
                            </div>
                            <div>
                                <field name="test_load" nolabel="1"/>
                                MT
                            </div>

                            <div class="o_form_label">
                                Kentledge Load
                            </div>
                            <div>
                                <field name="kentledge_load" nolabel="1"/>
                                MT
                            </div>

                            <div class="o_form_label">
                                Date of Casting
                            </div>
                            <field name="date_of_casting" nolabel="1"/>

                            <div class="o_form_label">
                                Date of Testing
                            </div>
                            <field name="date_of_testing" nolabel="1"/>

                        </group>

                    </div>
                   
                    <div style="margin-top:35px;">
                        <h2>8.	INCREMENTAL LOAD CALCULATIONS </h2>
                    </div>

                    <div style="border:1px solid #bfbfbf; padding:20px;">

                        <group col="2">

                            <div class="o_form_label">
                                Design Load
                            </div>
                            <div>
                                <field name="design_load" nolabel="1"/>
                                MT
                            </div>

                            <div class="o_form_label">
                                Test Load
                            </div>
                            <field name="test_load" nolabel="1"/>

                            <div class="o_form_label">
                                Incremental Load in Every Stage
                            </div>
                            <field name="incremental_load" nolabel="1"/>

                            <div class="o_form_label">
                                Jack Capacity
                            </div>
                            <field name="jack_capacity" nolabel="1"/>

                            <div class="o_form_label">
                                Jack Ram Dia
                            </div>
                            <div>
                                <field name="jack_ram_dia" nolabel="1"/>
                                mm
                            </div>

                            <div class="o_form_label">
                                Jack Ram Area
                            </div>
                            <div>
                                <field name="jack_ram_area" nolabel="1"/>
                                mm2
                            </div>

                            <div class="o_form_label">
                                Efficiency of Jack
                            </div>
                            <div>
                                <field name="jack_efficiency" nolabel="1"/>
                                %
                            </div>

                            <div class="o_form_label">
                                Pressure Gauge Range
                            </div>
                            <div>
                                <field name="pressure_gauge_range" nolabel="1"/>
                                kg/cm2
                            </div>

                            <div class="o_form_label">
                                Pressure Gauge Least Count (1division)
                            </div>
                            <field name="pressure_gauge_least_count" nolabel="1"/>

                            <div class="o_form_label">
                                Load per division of Pressure gauge
                            </div>
                            <field name="load_per_division" nolabel="1"/>

                            <div class="o_form_label">
                                Nos.  Divisions per Loading stage
                            </div>
                            <field name="division_per_stage" nolabel="1"/>

                            <div class="o_form_label">
                                So, Load per Each Stage
                            </div>
                            <field name="actual_stage_load" nolabel="1"/>
                        </group>

                    </div>
                    <!-- ================================================= -->
                    <!-- TEST PROCEDURE -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>3. TEST PROCEDURE</h2>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="test_procedure"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- TEST EQUIPMENT -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>4. DETAILS OF EQUIPMENTS USED</h2>
                    </div>

                    <field name="equipment_ids" nolabel="1">

                        <tree editable="bottom">

                            <field name="equipment_name"/>
                            <field name="quantity"/>
                            <field name="details"/>

                        </tree>

                    </field>

                    <!-- ================================================= -->
                    <!-- LOADING TABLE -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>6. LOAD DEFLECTION OBSERVATION - LOADING</h2>
                    </div>

                    <field
                        name="loading_reading_ids"
                        nolabel="1"
                        context="{'default_parent_id': id}">

                        <tree editable="bottom" limit="50">

                            <field
                                name="reading_datetime"
                                widget="datetime"
                                options="{'format': 'dd/MM/yy HH:mm'}"/>

                            <field
                                name="load_tonne"
                                string="Applied Load (MT)"/>

                            <field name="dial_a"/>
                            <field name="dial_b"/>
                            <field name="dial_c"/>
                            <field name="dial_d"/>

                            <field
                                name="mean_mm"
                                string="Average Settlement (mm)"
                                readonly="1"/>

                        </tree>

                    </field>

                    <!-- ================================================= -->
                    <!-- UNLOADING TABLE -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>7. LOAD DEFLECTION OBSERVATION - UNLOADING</h2>
                    </div>

                    <field
                        name="unloading_reading_ids"
                        nolabel="1"
                        context="{'default_parent_id': id}">

                        <tree editable="bottom" limit="50">

                            <field
                                name="reading_datetime"
                                widget="datetime"
                                options="{'format': 'dd/MM/yy HH:mm'}"/>

                            <field
                                name="load_tonne"
                                string="Applied Load (MT)"/>

                            <field name="dial_a"/>
                            <field name="dial_b"/>
                            <field name="dial_c"/>
                            <field name="dial_d"/>

                            <field
                                name="mean_mm"
                                string="Average Settlement (mm)"
                                readonly="1"/>

                        </tree>

                    </field>

                    <button
                        name="action_generate_graph"
                        string="Generate Graph"
                        type="object"
                        class="btn-primary"/>
                    <!-- ================================================= -->
                    <!-- GRAPH -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>8. LOAD VS DEFLECTION GRAPH</h2>
                    </div>

                    <div style="text-align:center; margin-top:20px;">
                        <field name="graph_image" widget="image"/>
                    </div>

                    <!-- ================================================= -->
                    <!-- ANALYSIS -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>9. ANALYSIS OF SAFE VERTICAL LOAD</h2>
                    </div>
                    <h3>•	From Load-Deflection Graph, we found: -</h3>
                    <div style="border:1px solid #bfbfbf; padding:20px;">
                        <group col="2">
                            <div class="o_form_label">
                                Maximum Applied Load/Test Load
                            </div>

                            <div>
                                <field name="elastic_rebound" nolabel="1"/>
                                MT
                            </div>

                            <div class="o_form_label">
                                Maximum/ Total Settlement
                            </div>
                            <field name="max_settlement" nolabel="1"/>
                            
                            <div class="o_form_label">
                                Residual Deflection (RD)
                            </div>
                            <field name="rd" nolabel="1"/>
                            
                            <div class="o_form_label">
                                Elastic Deflection (ED)
                            </div>
                            <field name="ed" nolabel="1"/>
                        </group>

                    </div>
                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="analysis_text"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- SETTLEMENT SUMMARY -->
                    <!-- ================================================= -->

                    <div style="margin-top:25px; border:1px solid #d3d3d3; padding:15px;">

                        <div style="margin-bottom:10px; font-size:15px;">
                            <strong>
                                Gross Settlement :
                            </strong>

                            <field
                                name="gross_settlement"
                                readonly="1"/> mm
                        </div>

                        <div style="margin-bottom:10px; font-size:15px;">
                            <strong>
                                Net Settlement :
                            </strong>

                            <field
                                name="net_settlement"
                                readonly="1"/> mm
                        </div>

                        <div style="font-size:15px;">
                            <strong>
                                Rebound :
                            </strong>

                            <field
                                name="rebound"
                                readonly="1"/> mm
                        </div>

                    </div>

                    <!-- ================================================= -->
                    <!-- CONCLUSION -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>10. CONCLUSION</h2>
                    </div>

                    <div style="border:1px solid #d3d3d3; padding:15px;">

                        <field
                            name="conclusion"
                            widget="text"
                            nolabel="1"/>

                    </div>

                    <!-- ================================================= -->
                    <!-- SITE PHOTOGRAPHS -->
                    <!-- ================================================= -->

                    <div style="margin-top:35px;">
                        <h2>SITE PHOTOGRAPHS</h2>
                    </div>

                    <field name="site_image_ids" nolabel="1">

                        <tree editable="bottom">

                            <field name="sequence"/>
                            <field
                                name="image"
                                widget="image"
                                options="{'size':[100,100]}"/>

                            <field name="caption"/>

                        </tree>

                    </field>

                </sheet>

            </form>

        </field>
    </record>

</odoo>
