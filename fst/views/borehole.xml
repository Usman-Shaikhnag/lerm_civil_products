<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="soil_borehole" model="ir.ui.view">
        <field name="name">soil.borehole.form</field>
        <field name="model">soil.borehole</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                     <!-- SBC Table -->
                    <group string="Safe Bearing Capacity">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="depth"/>
                                <field name="footing_size"/>
                                <field name="shear_criteria"/>
                                <field name="settlement_criteria"/>
                                <field name="recommended_sbc"/>
                            </tree>
                        </field>
                    </group>

                    <!-- N-Values for Graph -->
                    <group string="N-Values">
                        <field name="nvalue_ids">
                            <tree editable="bottom">
                                <field name="top_depth"/>
                                <field name="bottom_depth"/>
                                <field name="n_value"/>
                                <field name="soil_pattern"/>
                            </tree>
                        </field>
                    </group>

                    <!-- Graph -->
                    <group string="Borehole Graph">
                        <field name="graph_image" widget="image" />
                    </group>
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>