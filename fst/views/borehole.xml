<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="soil_borehole" model="ir.ui.view">
        <field name="name">soil.borehole.form</field>
        <field name="model">soil.borehole</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                     <!-- SBC Table -->
                    <div>
                        <field name="line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="depth"/>
                                <field name="footing_size"/>
                                <field name="shear_criteria"/>
                                <field name="settlement_criteria"/>
                                <field name="recommended_sbc"/>
                            </tree>
                        </field>
                    </div>

                    <!-- N-Values for Graph -->
                    <div>
                        <field name="nvalue_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="top_depth"/>
                                <field name="bottom_depth"/>
                                <field name="sample_type"/>
                                <field name="n30"/>
                                <field name="n45"/>
                                <field name="n_value"/>
                                <field name="classification"/>
                            </tree>
                        </field>
                        <button name="generate_borehole_graph" type="object" string="Generate Graph" class="btn-primary"/>
                    </div>
                    <!-- Graph -->
                    <div>
                        <field name="graph_image" widget="image" />
                    </div>

                    <div>
                        <field name="spt_n_value_ids">
                            <tree editable="bottom">
                                <field name="depth"/>
                                <field name="bulk_den"/>
                                <field name="overburden_pressure"/>
                                <field name="effective_overburden_pressure"/>
                                <field name="observed_n_value"/>
                                <field name="corrected_n_value"/>
                            </tree>
                        </field>
                    </div>

                    <div>
                        <field name="direct_shear_ids">
                            <tree editable="bottom">
                                <field name="applied_normal_stress"/>
                                <field name="shear_stress"/>
                                </tree>
                        </field>
                        <field name="direct_shear_graph" widget="image"/>
                    </div>
                    
                    <div>
                        <field name="grain_size_ids">
                            <tree editable="bottom">
                                <field name="depth"/>
                                <field name="gravel_percentage"/>
                                <field name="silt_percentage"/>
                                </tree>
                        </field>
                        <field name="grain_size_graph" widget="image"/>
                    </div>

                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>