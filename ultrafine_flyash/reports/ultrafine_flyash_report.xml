						<tbody>


						<!-- Normal Consistency -->
						<tr t-if="data.normal_consistency_visible and (data.normal_consistency_nabl == 'pass' and nabl or (data.normal_consistency_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl) and not fromEln">


								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','6f88512a-72fb-43ee-9b47-ff3936b6675b')]).parameter_name"/>
									</span>

								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="data.normal_consistency_fly_1" t-options='{"widget": "float", "precision": 2}'/>
									</span>
								</td>

								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','6f88512a-72fb-43ee-9b47-ff3936b6675b')]).unit.name"/>
									</span>
								</td> 

								<td style="text-align: center;">
									<span>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','6f88512a-72fb-43ee-9b47-ff3936b6675b')]).parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</span>
								</td>
								<td style="text-align: center;">
									<span>
