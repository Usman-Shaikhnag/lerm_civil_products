<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="lerm_civil_srf_ftp_form" model="ir.ui.view">
        <field name="name">lerm.civil.srf.ftp.form</field>
        <field name="model">lerm.civil.srf</field>
        <field name="inherit_id" ref="lerm_civil.lerm_civil_srf_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='button_box']/following-sibling::group[1]/group[2]" position="inside">
                <field name="attachment_path" readonly="1"/>
                <button name="open_file_upload" type="object" string="Upload" class="btn-primary"/>
                <button name="download_attachment" type="object" string="Download" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>