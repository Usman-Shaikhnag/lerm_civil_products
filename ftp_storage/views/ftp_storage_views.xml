<odoo>
    <record id="view_ftp_storage_tree" model="ir.ui.view">
        <field name="name">ftp.storage.tree</field>
        <field name="model">ftp.storage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="host"/>
                <field name="port"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_ftp_storage_form" model="ir.ui.view">
        <field name="name">ftp.storage.form</field>
        <field name="model">ftp.storage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="host"/>
                        <field name="port"/>
                        <field name="username"/>
                        <field name="password" password="True"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action and Menu -->
    <record id="action_ftp_storage" model="ir.actions.act_window">
        <field name="name">FTP Connections</field>
        <field name="res_model">ftp.storage</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_ftp_storage_root" name="FTP Storage" parent="base.menu_custom"/>
    <menuitem id="menu_ftp_storage" name="FTP Connections" parent="menu_ftp_storage_root" action="action_ftp_storage"/>

    
</odoo>