<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_cement_psc" model="ir.ui.view">
        <field name="name">cement.psc.form</field>
        <field name="model">cement.psc</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    <group>
                       <field name="grade"/>
                    </group>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="size_id"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                        
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>



                    <!-- Fineness of Cement by Dry Sieving -->

                    <div class="text-center" invisible="fineness_cement_visible == False">
                        <h1>
                            <field name="fineness_cement_name" readonly="1" nolabel="1"/>
                            <field name="fineness_cement_visible" invisible="1"/>

                        </h1>
                    </div>


                    <div invisible = "fineness_cement_visible == False" class="custom_table_borders">
                        <field name="fneness_cement_lines" nolabel="1">
                            <tree editable="bottom" >
                                <field name="serial_no"/>
                                <field name="wt_of_sample_taken" class="blue-input" decoration-info="wt_of_sample_taken != 0"/>
                                <field name="wt_of_residue" class="blue-input" decoration-info="wt_of_residue != 0"/>
                                <field name="fineness"/>
                            </tree>
                        </field>
                    </div>

                    <table invisible="fineness_cement_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_fineness">Avg Fineness Cement (%)</label></td>
                                <td><field name="avg_fineness" nolabel="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_fineness_confirmity">Conformity</label></td>
                                <td>
                                    <field name="avg_fineness_confirmity"
                                        decoration-success="avg_fineness_confirmity == 'pass'"
                                        decoration-danger="avg_fineness_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_fineness_nabl">NABL</label></td>
                                <td><field name="avg_fineness_nabl"
                                            decoration-success="avg_fineness_nabl == 'pass'"
                                            decoration-danger="avg_fineness_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>


                    <!-- Consistency of cement -->

                    <div invisible = "consistency_cement_visible == False">
                        <h1 class="text-center">
                            <field name="consistency_cement_name" readonly="1" nolabel="1"/>
                            <field name="consistency_cement_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div invisible = "consistency_cement_visible == False" class="custom_table_borders">
                        <field name="consistency_cement_lines">
                            <tree editable="bottom">
                                <field name="serial_no"/>
                                <field name="weight_of_cement"   class="blue-input" decoration-info="weight_of_cement != 0"/>
                                <field name="weight_of_water"  class="blue-input" decoration-info="weight_of_water != 0"/>
                                <field name="plunger_penetration" class="blue-input" decoration-info="plunger_penetration != 0"/>
                                <field name="time_taken"  class="blue-input" decoration-info="time_taken != 0"/>
                                <field name="consistency"/>
                            </tree>
                        </field>
                    </div>

                    <table invisible="consistency_cement_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_consistency"> Average Consistency of Cement (%)</label></td>
                                <td>
                                    <field name="average_consistency" nolabel="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_consistency_confirmity">Conformity</label></td>
                                <td>
                                    <field name="average_consistency_confirmity"
                                        decoration-success="average_consistency_confirmity == 'pass'"
                                        decoration-danger="average_consistency_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_consistency_nabl">NABL</label></td>
                                <td>
                                    <field name="average_consistency_nabl"
                                        decoration-success="average_consistency_nabl == 'pass'"
                                        decoration-danger="average_consistency_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Setting Time Start -->
                    <div class="text-center" invisible="setting_time_visible == False">
                        <h1>
                            <field name="setting_time_name" readonly="1" nolabel="1"/>
                            <field name="setting_time_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div class="d-flex gap-2" invisible="not setting_time_visible">

                      <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not setting_time_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="cement_weight">Weight of Cement (g)</label></td>
                                <td><field name="cement_weight"/></td>
                            </tr>
                        </tbody>
                      </table>

                      <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not setting_time_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="set_normal_consistency">Normal Consistency (%)</label></td>
                                <td><field name="set_normal_consistency"/></td>
                            </tr>
                        </tbody>
                      </table>

                      <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not setting_time_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="weight_of_water">Weight of Water Added (0.85 x Normal Consistency)</label></td>
                                <td><field name="weight_of_water"/></td>
                            </tr>
                        </tbody>
                      </table>

                    </div>



                     <div class="d-flex gap-2" style="gap:10px; margin-bottom:20px; align-items:stretch;"  invisible="setting_time_visible == False">

                        <!-- Left side -->
                       <div style="width:50%; text-align:center;" class="equal-box">
                            <div class="o_form_label"
                                style="font-weight:bold; background:#f0f0f0; padding:6px; margin-bottom:0; border:1px solid #ccc; border-bottom:0;">
                                Initial Setting Time
                            </div>
                            <field name="intial_time_lines" class="custom_table_borders" style="margin-top:0; margin-bottom:0; width:100%;">
                                <tree editable="bottom">
                                    <field name="time" class="blue-input" decoration-info="time != 0"/>
                                    <field name="elapsed_time" class="blue-input" decoration-info="elapsed_time != 0"/>
                                    <field name="needle_penetration" class="blue-input" decoration-info="needle_penetration != 0"/>
                                </tree>
                            </field>
                        </div>


                  


                        <!-- Right side -->

                         <div style="width:50%; text-align:center;" class="equal-box">
                            <div class="o_form_label"
                                style="font-weight:bold; background:#f0f0f0; padding:6px; margin-bottom:0; border:1px solid #ccc; border-bottom:0;">
                              Final Setting Time
                            </div>
                            <field name="final_time_lines" class="custom_table_borders" style="margin-top:0; margin-bottom:0; width:100%;">
                                <tree editable="bottom">
                                    <field name="time" class="blue-input" decoration-info="time != 0"/>
                                    <field name="elapsed_time" class="blue-input" decoration-info="elapsed_time != 0"/>
                                    <field name="immersion_status" class="blue-input" decoration-info="immersion_status != 0"/>
                                </tree>
                            </field>
                        </div>


                    </div>

                    <div class="d-flex gap-2" invisible="not setting_time_visible">

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not setting_time_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="initial_setting_time">Initial Setting Time (Min)</label></td>
                                <td><field name="initial_setting_time"/><span>(Min)</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="initial_setting_time_confirmity">Conformity</label></td>
                                <td>
                                    <field name="initial_setting_time_confirmity"
                                        decoration-success="initial_setting_time_confirmity == 'pass'" 
                                        decoration-danger="initial_setting_time_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="initial_setting_time_nabl">NABL</label></td>
                                <td>
                                    <field name="initial_setting_time_nabl"
                                        decoration-success="initial_setting_time_nabl == 'pass'" 
                                        decoration-danger="initial_setting_time_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not setting_time_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="final_setting_time">Final Setting Time (Min)</label></td>
                                <td><field name="final_setting_time"/><span>(Min)</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="final_setting_time_confirmity">Conformity</label></td>
                                <td>
                                    <field name="final_setting_time_confirmity"
                                        decoration-success="final_setting_time_confirmity == 'pass'" 
                                        decoration-danger="final_setting_time_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="final_setting_time_nabl">NABL</label></td>
                                <td>
                                    <field name="final_setting_time_nabl"
                                        decoration-success="final_setting_time_nabl == 'pass'" 
                                        decoration-danger="final_setting_time_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    </div>


                     <!-- Cement Compressive Strength -->
                    

                    <div invisible = "compressive_visible == False" >
                        <h1 class="text-center">
                            <field name="compressive_name" readonly="1" nolabel="1"/>
                            <field name="compressive_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div invisible = "compressive_visible == False">
                        <field name="compressive_lines">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="days" class="blue-input" decoration-info="days != 0" />
                                <field name="wt_of_cube" class="blue-input" decoration-info="wt_of_cube != 0"/>
                                <field name="density" />
                                <field name="load" class="blue-input" decoration-info="load != 0"/>
                                <field name="compressive_strength" />
                            </tree>
                        </field>
                    </div>

                     <div class="d-flex gap-2" invisible="not compressive_visible">

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not compressive_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_3_days">Avg Compressive Strength (3 Days)</label></td>
                                <td><field name="avg_3_days"/><span>N/mm²</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_3_days_confirmity">Compressive Strength (3 Days) Conformity</label></td>
                                <td>
                                    <field name="avg_3_days_confirmity"
                                        decoration-success="avg_3_days_confirmity == 'pass'" 
                                        decoration-danger="avg_3_days_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_3_days_nabl">Compressive Strength (3 Days) NABL</label></td>
                                <td>
                                    <field name="avg_3_days_nabl"
                                        decoration-success="avg_3_days_nabl == 'pass'" 
                                        decoration-danger="avg_3_days_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not compressive_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_7_days">Avg Compressive Strength (7 Days)</label></td>
                                <td><field name="avg_7_days"/><span>N/mm²</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_7_days_confirmity">Compressive Strength (7 Days) Conformity</label></td>
                                <td>
                                    <field name="avg_7_days_confirmity"
                                        decoration-success="avg_7_days_confirmity == 'pass'" 
                                        decoration-danger="avg_7_days_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_7_days_nabl">Compressive Strength (7 Days) NABL</label></td>
                                <td>
                                    <field name="avg_7_days_nabl"
                                        decoration-success="avg_7_days_nabl == 'pass'" 
                                        decoration-danger="avg_7_days_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not compressive_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_14_days">Avg Compressive Strength (14 Days)</label></td>
                                <td><field name="avg_14_days"/><span>N/mm²</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_14_days_confirmity">Compressive Strength (14 Days) Conformity</label></td>
                                <td>
                                    <field name="avg_14_days_confirmity"
                                        decoration-success="avg_14_days_confirmity == 'pass'" 
                                        decoration-danger="avg_14_days_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_14_days_nabl">Compressive Strength (14 Days) NABL</label></td>
                                <td>
                                    <field name="avg_14_days_nabl"
                                        decoration-success="avg_14_days_nabl == 'pass'" 
                                        decoration-danger="avg_14_days_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not compressive_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_28_days">Avg Compressive Strength (28 Days)</label></td>
                                <td><field name="avg_28_days"/><span>N/mm²</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_28_days_confirmity">Compressive Strength (28 Days) Conformity</label></td>
                                <td>
                                    <field name="avg_28_days_confirmity"
                                        decoration-success="avg_28_days_confirmity == 'pass'" 
                                        decoration-danger="avg_28_days_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_28_days_nabl">Compressive Strength (28 Days) NABL</label></td>
                                <td>
                                    <field name="avg_28_days_nabl"
                                        decoration-success="avg_28_days_nabl == 'pass'" 
                                        decoration-danger="avg_28_days_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    </div>

                   

                    <!-- SOUNDNESS OF CEMENT BY LE-CHATELIER METHOD -->


                    <div class="text-center" invisible="soundness_cement_visible == False">
                        <h1>
                            <field name="soundness_cement_name" readonly="1" nolabel="1"/>
                            <field name="soundness_cement_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "soundness_cement_visible == False" class="custom_table_borders">
                        <field name="soundness_cement_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='l1'  class="blue-input" decoration-info="l1 != 0" />
                                <field name='l2' class="blue-input" decoration-info="l2 != 0"/>
                                <field name='expansion'  />
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not soundness_cement_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_soundness_expansion">Average Expansion (mm)</label></td>
                                <td><field name="avg_soundness_expansion"/><span>  (mm)</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_soundness_expansion_confirmity">Conformity</label></td>
                                <td>
                                    <field name="avg_soundness_expansion_confirmity"
                                        decoration-success="avg_soundness_expansion_confirmity == 'pass'" 
                                        decoration-danger="avg_soundness_expansion_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_soundness_expansion_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_soundness_expansion_nabl"
                                        decoration-success="avg_soundness_expansion_nabl == 'pass'" 
                                        decoration-danger="avg_soundness_expansion_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    

                    <!-- SPECIFIC GRAVITY OF CEMENT -->
                      <div class="text-center" invisible="specific_gravity_visible == False">
                        <h1>
                            <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "specific_gravity_visible == False" class="custom_table_borders">
                        <field name="specific_gravity_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='weight_cement'  class="blue-input" decoration-info="weight_cement != 0" />
                                <field name='initial_reading' class="blue-input" decoration-info="initial_reading != 0"/>
                                <field name='final_reading' class="blue-input" decoration-info="final_reading != 0"/>
                                <field name='volume_cement'  />
                                <field name='weight_equal_volume_water' />
                                <field name='specific_gravity'/>
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not specific_gravity_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_specific_gravity">Average Specific Gravity</label></td>
                                <td><field name="average_specific_gravity"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_specific_gravity_confirmity">Conformity</label></td>
                                <td>
                                    <field name="average_specific_gravity_confirmity"
                                        decoration-success="average_specific_gravity_confirmity == 'pass'" 
                                        decoration-danger="average_specific_gravity_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_specific_gravity_nabl">NABL</label></td>
                                <td>
                                    <field name="average_specific_gravity_nabl"
                                        decoration-success="average_specific_gravity_nabl == 'pass'" 
                                        decoration-danger="average_specific_gravity_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                   

                    <!-- Density of Cement  -->
                      <div class="text-center" invisible="density_cement_visible == False">
                        <h1>
                            <field name="density_cement_name" readonly="1" nolabel="1"/>
                            <field name="density_cement_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "density_cement_visible == False" class="custom_table_borders">
                        <field name="density_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='weight_cement'  class="blue-input" decoration-info="weight_cement != 0" />
                                <field name='initial_reading' class="blue-input" decoration-info="initial_reading != 0"/>
                                <field name='final_reading' class="blue-input" decoration-info="final_reading != 0"/>
                                <field name='volume_cement'  />
                                <field name='weight_equal_volume_water' />
                                <field name='specific_gravity'/>
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not density_cement_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_density">Average Specific Gravity</label></td>
                                <td><field name="average_density"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_density_confirmity">Conformity</label></td>
                                <td>
                                    <field name="average_density_confirmity"
                                        decoration-success="average_density_confirmity == 'pass'" 
                                        decoration-danger="average_density_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_density_nabl">NABL</label></td>
                                <td>
                                    <field name="average_density_nabl"
                                        decoration-success="average_density_nabl == 'pass'" 
                                        decoration-danger="average_density_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                     <!-- FINENESS OF CEMENT BY BLAINE AIR PERMEABILITY METHOD -->


                    <div class="text-center" invisible="fineness_blaine_visible == False">
                        <h1>
                            <field name="fineness_blaine_name" readonly="1" nolabel="1"/>
                            <field name="fineness_blaine_visible" invisible="1"/>

                        </h1>
                    </div>

                     <div class="d-flex gap-2" invisible="not fineness_blaine_visible">

                      <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not fineness_blaine_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="e">e</label></td>
                                <td><field name="e" class="blue-input"/></td>
                            </tr>
                        </tbody>
                     </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not fineness_blaine_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="eta">η (is the viscosity of air at the test temperature)</label></td>
                                <td><field name="eta" class="blue-input"/></td>
                            </tr>
                        </tbody>
                     </table>
                     <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not fineness_blaine_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="density">Density of Sample (ρ)</label></td>
                                <td><field name="density" class="blue-input"/></td>
                            </tr>
                        </tbody>
                     </table>
                     <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not fineness_blaine_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="apparatus_constant">Apparatus Constant (K)</label></td>
                                <td><field name="apparatus_constant" class="blue-input"/></td>
                            </tr>
                        </tbody>
                     </table>

                    </div>


                    <div invisible = "fineness_blaine_visible == False" class="custom_table_borders">
                        <field name="fineness_blaine_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='mass'  class="blue-input" decoration-info="mass != 0" />
                                <field name='time' class="blue-input" decoration-info="time != 0"/>
                            </tree>
                        </field> 
                    </div>

                     <div class="d-flex gap-2" invisible="not fineness_blaine_visible">

                      <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not fineness_blaine_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_time">Average Time (t)</label></td>
                                <td><field name="average_time"/></td>
                            </tr>
                        </tbody>
                     </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not fineness_blaine_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="sqrt_time">√t</label></td>
                                <td><field name="sqrt_time"/></td>
                            </tr>
                        </tbody>
                     </table>

                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not fineness_blaine_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="specific_surface">Specific Surface (cm²/g)</label></td>
                                <td><field name="specific_surface"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="specific_surface_confirmity">Conformity</label></td>
                                <td>
                                    <field name="specific_surface_confirmity"
                                        decoration-success="specific_surface_confirmity == 'pass'" 
                                        decoration-danger="specific_surface_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="specific_surface_nabl">NABL</label></td>
                                <td>
                                    <field name="specific_surface_nabl"
                                        decoration-success="specific_surface_nabl == 'pass'" 
                                        decoration-danger="specific_surface_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                   

                     <!-- Drying Skrinkage  -->
                    <div class="text-center" invisible="drying_shrinkage_visible == False">
                        <h1 >
                            <field name="drying_shrinkage_name" readonly="1" nolabel="1"/>
                            <field name="drying_shrinkage_visible" invisible="1"/>                     
                        </h1>
                    </div>

                    <div invisible="drying_shrinkage_visible == False" class="custom_table_borders">
                       <field name="drying_child_lines" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='initial_length' class="blue-input" decoration-info="initial_length != 0"/>
                                <field name='final_length' class="blue-input" decoration-info="final_length != 0"/>
                                <field name='delta_l'/>
                               
                            </tree>
                       </field> 
                    </div>

                    <table invisible="drying_shrinkage_visible == False" class="table table-sm table-bordered w-50 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_delta_l">Average ΔL (mm)</label></td>
                                <td>
                                    <field name="average_delta_l" nolabel="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table invisible="drying_shrinkage_visible == False" class="table table-sm table-bordered w-50 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="drying_shrinkage">Average</label></td>
                                <td>
                                    <field name="drying_shrinkage" nolabel="1"/>
                                </td>
                            </tr>
                          
                            <tr>
                                <td><label class="fw-bold" for="drying_shrinkage_conformity"> Conformity</label></td>
                                <td>
                                    <field name="drying_shrinkage_conformity"
                                        decoration-success="drying_shrinkage_conformity == 'pass'"
                                        decoration-danger="drying_shrinkage_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="drying_shrinkage_nabl"> NABL</label></td>
                                <td>
                                    <field name="drying_shrinkage_nabl"
                                        decoration-success="drying_shrinkage_nabl == 'pass'"
                                        decoration-danger="drying_shrinkage_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                  


                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
    </record>

        <record id="view_cement_ppc_prefill_data_form" model="ir.ui.view">
            <field name="name">cement.ppc.prefill.data.form</field>
            <field name="model">cement.ppc.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cement_ppc_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cement.ppc.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_cement_ppc_prefill_data_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>