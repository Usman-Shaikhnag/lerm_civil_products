<odoo>
    <data>
        <record id="module_category_audit_trail" model="ir.module.category">
            <field name="name">Audit Trail</field>
            <field name="sequence">90</field>
        </record>
        <record id="group_audit_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="module_category_audit_trail"/>
        </record>
        <record id="group_audit_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_audit_trail"/>
            <field name="implied_ids" eval="[(4, ref('group_audit_viewer'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
