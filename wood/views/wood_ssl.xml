<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_wood_ssl_form" model="ir.ui.view">
        <field name="name">mechanical.wood.form</field>
        <field name="model">mechanical.wood</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>

                    <div>
                      <h1>
                        <field name="name_wood" readonly="1"  string="WOOD"/>
                      </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    
                  <!-- Plastic Limit -->
                <group invisible = "moisture_content_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="moisture_content_name" readonly="1" nolabel="1"/>
                            <field name="moisture_content_visible" invisible="1"/>

                        </h1>
                </group>
                <div invisible = "moisture_content_visible == False" style="white-space: nowrap; width:100%;">
                    <field name="wood_child_lines" class="custom_table_borders" nolabel="1">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='initial_we' class="blue-input" decoration-info="initial_we != 0"/>
                                <field name='oven_dry' class="blue-input" decoration-info="oven_dry != 0"/>
                                <field name='per_moisture'/>
                            </tree>
                    </field> 
                </div>
                 
                <group  invisible = "specific_gravity_visible == False" string="Result"  style="white-space: nowrap; width:70%;"/>
                    <div>
                     <table style="border: 2px solid black; width: 50%;">
                           <tr>
                             <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Average Moisture Content</span></td>
                              <td style="padding: 8px; width:350px;"><field name="average_moisture" nolabel="1"/></td>
                           </tr>                     
                          </table>
                        </div>
                    <group/>
                

                    <div>
                          <table style="width: 50%; margin-top:10px;">
                           <tr>
                             <td style="border: 2px solid black;padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="border: 2px solid black;padding: 8px;"><field  name="moisture_content_conformity"
                                        decoration-success="moisture_content_conformity == 'pass'" 
                                        decoration-danger="moisture_content_conformity == 'fail'" 
                                        readonly="1" /></td>
                           </tr>
                           <tr>
                            <td style="border: 2px solid black;padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="border: 2px solid black;padding: 5px;"><field  name="moisture_content_nabl" /></td>
                           </tr>
                          </table>
                        </div>
                        <group/>
                        <group/>
                 
                 



                      <!-- Specific Limit -->
                <group invisible = "specific_gravity_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>

                        </h1>
                </group>
                <group invisible = "specific_gravity_visible == False" style="white-space: nowrap; width:100%;">
                    <field name="specific_gravity_child_lines"  class="custom_table_borders" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='length' class="blue-input" decoration-info="length != 0" />
                                <field name='width' class="blue-input" decoration-info="width != 0" />
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0" />
                                  <field name='volume'/>
                                <field name='oven_dry' class="blue-input" decoration-info="oven_dry != 0" />
                                <field name='specific_gravity'/>
                            </tree>
                    </field> 
                </group>

                 
                <group  invisible = "specific_gravity_visible == False" string="Result"  style="white-space: nowrap; width:70%;"/>
                    <div>
                     <table style="border: 2px solid black; width: 50%;">
                           <tr>
                             <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Average Specific Gravity</span></td>
                              <td style="padding: 8px; width:350px;"><field name="average_specific_gravity" nolabel="1"/></td>
                           </tr>                     
                          </table>
                        </div>
                    <group/>
               

                    <div>
                          <table style="width: 50%; margin-top:10px;">
                           <tr>
                             <td style="border: 2px solid black;padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="border: 2px solid black;padding: 8px;"><field  name="specific_gravity_conformity"
                                        decoration-success="specific_gravity_conformity == 'pass'" 
                                        decoration-danger="specific_gravity_conformity == 'fail'" 
                                        readonly="1" /></td>
                           </tr>
                           <tr>
                            <td style="border: 2px solid black;padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="border: 2px solid black;padding: 5px;"><field  name="specific_gravity_nabl" /></td>
                           </tr>
                          </table>
                        </div>
                        <group/>
                        <group/>
                 
                

                  <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>