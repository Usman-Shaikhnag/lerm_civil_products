<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	   <template id="wood_report_ssl">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->

				<div class="container_eln">
					<div class="" t-foreach="eln" t-as="o">
						<table style="margin-top:10px; width: 100%; border-collapse: collapse;">
							<tbody>
								<tr>
									<td style="width: 30%; padding: 5px;"><strong>Client Details</strong></td>
									<td style="padding-left: 10px;">
										<span t-field="o.srf_id.customer.name"/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
									</td>
								
								</tr>
								
								<tr>
									<td><strong>Client's Reference</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.srf_id.client_refrence"/></td>
								</tr>

								<tr>
									<td><strong>Name of Work</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.srf_id.name_work"/></td>
								</tr>

								<tr>
									<td><strong>Date of Testing</strong></td>
									<td style="padding-left: 10px;">
										<span t-field="o.start_date" style="margin-right:10px;"/> to 
										<span t-field="o.end_date" style="margin-left:10px;"/>
									</td>
								</tr>

								<tr>
									<td><strong>Type of Sample</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>
								</tr>

								<tr>
									<td><strong>Grade of Sample</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.grade_id.grade"/></td>
								</tr>

								<!-- Source of Sample (only if value exists) -->
								<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td><span t-field="o.material.source_sample"/></td>
								</tr>

								<!-- Test method adopted (only if value exists) -->
								<tr t-if="o.material.test_method_adopted">
									<td style="font-weight: bold;">Test method adopted:</td>
									<td><span t-field="o.material.test_method_adopted"/></td>
								</tr>
							</tbody>
						</table>
					</div>

                     <table style="margin-top:15px">
					<thead>

                        <tr style="height:20px;">
                            <td   >Sr.No</td>
                            <td  >
							<span t-esc="eln.material.test_parameter"/>
							<!-- Test Parameters -->
							</td>
							 <td >
							 <span t-esc="eln.material.result_remark"/>
							  <!-- Result -->
							  </td>
                            <td  >
							<span t-esc="eln.material.unit"/>
							<!-- Unit -->
							</td>
							 <td style="width:25%" >
								<!-- <span t-field="eln.material.specifications"></span> -->
								<span t-field="eln.material.specifications"/>
							</td>
                            <td  >
							<span t-esc="eln.material.method_reference"/>
							<!-- Test Method -->
							</td>
                          
                            <td  t-if="eln.conformity">Conformity</td>

						</tr>
					</thead>
					  <tbody>
                     <t t-set="i" t-value="0"/>
                    	<tr t-if="data.specific_gravity_visible and (data.specific_gravity_nabl == 'pass' and nabl or (data.specific_gravity_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							 <td >
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
                  			</td>
                            <td>
								<span>
									<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','769b7052-d658-4d14-a5cc-c21dbe1487gbhjt')]).parameter_name"/>
								</span>
							</td>
							<td>
								<span t-field="data.average_specific_gravity" t-options='{"widget": "float", "precision": 3}'/>
							</td>
                            <td>
								<span>
									<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','769b7052-d658-4d14-a5cc-c21dbe1487gbhjt')]).unit.name"/>
								</span>
							</td>
                          
							<td >
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','769b7052-d658-4d14-a5cc-c21dbe1487gbhjt')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
                                                <span t-field="parameter.permissable_limit"/>
                                        </t>
									</t>
								</span>
							</td>
							<td style="text-align: center;">
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','769b7052-d658-4d14-a5cc-c21dbe1487gbhjt')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
                                                <span t-field="parameter.specification"/>
                                        </t>
									</t>
								</span>
							</td>
                          

                        <td t-if="eln.conformity">
								<span t-field="data.specific_gravity_conformity"/>
							</td>

						</tr>



                        	<tr t-if="data.moisture_content_visible and (data.moisture_content_nabl == 'pass' and nabl or (data.moisture_content_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							 <td >
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
                  			</td>
                            <td>
								<span>
									<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','a90cdbd7-3fa3-4b83-ae31-9d28120458tyu32')]).parameter_name"/>
								</span>
							</td>
							<td>
								<span t-field="data.average_moisture" t-options='{"widget": "float", "precision": 2}'/>
							</td>
                            <td>
								<span>
									<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','a90cdbd7-3fa3-4b83-ae31-9d28120458tyu32')]).unit.name"/>
								</span>
							</td>
                          
							<td >
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','a90cdbd7-3fa3-4b83-ae31-9d28120458tyu32')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
                                                <span t-field="parameter.permissable_limit"/>
                                        </t>
									</t>
								</span>
							</td>
							<td style="text-align: center;">
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','a90cdbd7-3fa3-4b83-ae31-9d28120458tyu32')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
                                                <span t-field="parameter.specification"/>
                                        </t>
									</t>
								</span>
							</td>
                          

                        <td t-if="eln.conformity">
								<span t-field="data.moisture_content_conformity"/>
							</td>

						</tr>
					</tbody>
                    </table>



				
						<div style="margin-top:20px" class="noteContainer">
							<table>
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div>
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
						</div>

				</div>
			</t>
		</t>
	</template>
</odoo>