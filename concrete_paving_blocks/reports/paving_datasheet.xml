<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="paving_block_datasheet">

        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">

                <t t-set="eln" t-value="doc"/>

                <div class="page">

                    <div style="text-align:center;font-size:18px;font-weight:bold;">
                        Concrete Paving Block
                    </div>

                    <div class="container_eln" style="margin-top:5px">
                        <table style="margin-top:20px; width:100%; border-collapse:collapse;">

                            <tr>
                                <td colspan="6">
                                    Job No : <span t-field="eln.kes_no"/>
                                </td>
                                <td colspan="6">
                                    Test Start Date :
                                    <span t-field="eln.start_date"/>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="6">
                                    Material : <span t-field="eln.material"/>
                                </td>
                                <td colspan="6">
                                    Test End Date : <span t-field="eln.end_date"/>
                                </td>
                            </tr>

                            <tr style="height:50px">
                                <td colspan="4">
                                    Performed By :
                                    <span t-field="eln.technician.name"/>
                                </td>

                                <td colspan="4">
                                    Witness Name :
                                    <span t-field="eln.witness_name"/>
                                </td>

                                <td colspan="4">
                                    Witness Signature :
                                    <span style="padding:20px"/>
                                </td>
                            </tr>

                        </table>
                    </div>

                    <!-- 3. Water Absorption -->

                    <div t-if="data.water_absorption_visible"
                         style="margin-top:20px; page-break-before: always;">

                        <div style="text-align:center;font-size:18px">

                            <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','5bd8b6a3-4097-4125-befe-36c633ce7ae8')]).parameter_name"/>

                            <span>
                                <t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','5bd8b6a3-4097-4125-befe-36c633ce7ae8')]).parameter_table"
                                   t-as="parameter">
                                    <t t-if="parameter.grade.id == eln.grade_id.id">
                                        <span t-field="parameter.specification"/>
                                    </t>
                                </t>
                            </span>

                        </div>

                        <table style="margin-top:20px">
                            <thead>
                                <tr cols="12">
                                    <td>Sr no</td>
                                    <td style="text-align:center;">Sample Identification</td>
                                    <td style="text-align:center;">Dry wt (W1)</td>
                                    <td style="text-align:center;">Wet wt (W2)</td>
                                    <td style="text-align:center;"> Water Absorption %</td>
                                </tr>
                            </thead>

                            <tbody>

                                <t t-set="i" t-value="0"/>

                                <tr t-foreach="data.water_absorption_child_lines" t-as="r">

                                    <td style="text-align:center;">
                                        <div>
                                            <span t-esc="i + 1"/>
                                            <t t-set="i" t-value="i+1"/>
                                        </div>
                                    </td>

                                    <td style="text-align:center;">
                                        <span t-esc="r['sample_identification']"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <span t-esc="r['dry_wt_w1']"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <span t-esc="r['wet_w2']"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <span t-esc="r['water_absorption']"/>
                                    </td>

                                </tr>

                            </tbody>
                        </table>

                    </div>

                    

                    <div style="display:flex; justify-content:space-between; margin-top:40px;">

                        <div>
                            <b>Prepared By</b>

                            <div style="height:40px;">
                                <t t-if="eln.tested_by_signature_datasheet and eln.sample_id.filled_by.employee_id.signature">
                                    <img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature"
                                         style="max-width:200px;max-height:35px;"/>
                                </t>
                            </div>

                            <div>
                                <b><span t-esc="eln.sample_id.filled_by.name"/></b>
                            </div>

                            <div>
                                (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                            </div>
                        </div>

                        <div>
                            <b>Checked By</b>

                            <div style="height:40px;">
                                <t t-if="eln.sample_id.checked_by_signature_datasheet and eln.sample_id.check_by.employee_id.signature">
                                    <img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature"
                                         style="max-width:200px;max-height:35px;"/>
                                </t>
                            </div>

                            <div>
                                <b><span t-esc="eln.sample_id.approved_by.name"/></b>
                            </div>

                            <div>
                                (<span t-esc="eln.sample_id.approved_by.job_title"/>)
                            </div>
                        </div>

                    </div>

                </div>

            </t>
        </t>

    </template>














