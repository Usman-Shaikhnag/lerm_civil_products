<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_pt_grout_form" model="ir.ui.view">
        <field name="name">mechanical.pt.grout.form</field>
        <field name="model">mechanical.pt.grout</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                  <div>
                      <h1>
                          <field name="name_fly" readonly="1" nolabel="1"/>
                      </h1>
                  </div>
                    <group>
                    <field name="grade"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div class="custom_table_borders" style="margin-top:20px;">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                     
                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <!--  -->
                    <group invisible="not fludity_visible">
                        <h1>
                            <field name="fluidity_name" readonly="1" nolabel="1"/>
                            <field name="fludity_visible" invisible="1"/>
                        </h1>
                    </group>

                    <group/>
                    <div style="display:flex;">
                    <div style="width:50%;">
                      <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                         <tbody>
                            <tr>
                              <td><span>Temperature °c</span></td>
                              <td><field name="temp_percent_fluidity" class="blue-input"/></td>
                            </tr>
                            <tr>
                            <td><span>Humidity %</span></td>
                            <td><field name="humidity_percent_fludity" class="blue-input"/></td>
                            </tr>
                         </tbody>
                      </table>
                    </div>


                    <div style="width:50%;">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                         <tbody>
                            <tr>
                              <td><span>Start Date</span></td>
                              <td><field name="start_date_fludity" class="blue-input"/></td>
                            </tr>
                            <tr>
                            <td><span>End Date</span></td>
                            <td><field name="end_date_fludity" class="blue-input"/></td>
                            </tr> 
                         </tbody>
                      </table>
                    </div>

                    </div>
                    <group/>


                    <div>
                      <table class="table table-sm o_form_table table-bordered  custom_table_borders" style="width:70%;">
                         <tbody>
                           <tr>
                             <td></td>
                             <td style="text-align:center;"><span>Trail 1</span></td>
                           </tr>
                           <tr>
                             <td><span>Water Cement Ratio (w/c)</span></td>
                             <td style="text-align:center;"><field  name="water_cement_ratio"  colspan="1"  nolabel="1"/></td>
                           </tr>
                           <tr>
                             <td><span>Wt. of Cement (g)</span></td>
                             <td style="text-align:center;"><field  name="wt_of_cement"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           </tr>
                           <tr>
                             <td><span>Wt.of water (g)</span></td>
                             <td style="text-align:center;"><field  name="wt_of_water"  colspan="1"  nolabel="1" class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>CEBEX 100 (g)</span></td>
                             <td style="text-align:center;"><field  name="cebex"  colspan="1"  nolabel="1" class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>Water Temperature °c</span></td>
                             <td style="text-align:center;"><field  name="water_temperature"  colspan="1"  nolabel="1" class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>Grout Temperature °c</span></td>
                             <td style="text-align:center;"><field  name="grout_temperature"  colspan="1"  nolabel="1" class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>Flow (Sec)</span></td>
                             <td style="text-align:center;"><field  name="flow_sec"  colspan="1"  nolabel="1" class="blue-input" /></td>
                           </tr>
                         </tbody>
                      </table>
                    </div>

                    <div>
                      <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                      <tbody>
                         <tr>
                         <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                         <td><field name="fludity_nabl"/></td>
                         </tr>
                         </tbody>                     
                      </table>
                    </div>

                    
                       
                    <!-- </group> -->
                    <!-- Initial Setting Time -->
                     <div>
                        <field name="initial_setting_time_visible" readonly="1" invisible="1" />
                        <field name="final_setting_time_visible" readonly="1" invisible="1" />
                        <h1>
                            <field name="setting_time_name" readonly="1" nolabel="1"   modifiers="{'readonly': true, 'nolabel': true, 'invisible': ['|', ['initial_setting_time_visible', '=', false], ['final_setting_time_visible', '=', false]]}"/>
                        </h1>
                    </div>
                    <group/>



                    <div  style="display:flex; margin-top:15px">
                      <div style="width:52%;">
                       <div>
                          <h3>
                            <field name="initial_setting_time_name" readonly="1" nolabel="1"   invisible="not initial_setting_time_visible"/>
                        </h3>
                        </div>
                        <div>
                        <group/>
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%">
                         <tbody>
                            <tr>
                              <td><span>The Time When water is added to cement (t1)</span></td>
                              <td><field name="time_water_added" invisible="not initial_setting_time_visible" class="blue-input" /></td>
                            </tr>
                            <tr>
                            <td><span>The time at which needle fails to penetrate the test block to a point 5 ± 0.5 mm (t2)</span></td>
                            <td><field name="time_needle_fails" invisible="not initial_setting_time_visible" class="blue-input"/></td>
                            </tr>
                            <tr>
                            <td><span>Initial Setting Time (t2-t1) (Hours)</span></td>
                            <td><field name="initial_setting_time_hours" invisible="not initial_setting_time_visible" /></td>
                            </tr>
                            </tbody>
                            </table>
                        </div>
                        <div>
                          <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                          <tbody>
                           <tr>
                            <td><span>Conformity</span></td>
                             <td><field   name="initial_setting_conformity"
                               decoration-success="initial_setting_conformity == 'pass'" 
                               decoration-danger="initial_setting_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><span>NABL</span></td>
                           <td><field name="initial_setting_nabl"/> </td>
                          </tr>
                          </tbody>                     
                          </table>
                        </div>
                        </div>
                        <div style="width:48%;">
                        <div style="margin-top:8px;">
                          <h2>
                            <field name="final_setting_time_name" readonly="1" nolabel="1"   invisible="not final_setting_time_visible" />
                        </h2>
                        </div>
                        <div> 
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                         <tbody>
                            <tr>
                              <td><span>The Time at which the needle make an impression on the surface of test block while attachment fails to do (t3)</span></td>
                              <td style="width:250px;"><field name="time_needle_make_impression" invisible="not final_setting_time_visible" class="blue-input"/></td>
                            </tr>
                            <tr>
                            <td><span>Final Setting Time (t2-t1) (Hours)</span></td>
                            <td style="width:250px;"><field name="final_setting_time_hours" invisible="not final_setting_time_visible"/></td>
                            </tr>
                         </tbody>
                      </table>
                        </div>

                        <div style="margin-left:7px;margin-top:50px;">
                          <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><span>Conformity</span></td>
                             <td><field name="final_setting_conformity"
                               decoration-success="final_setting_conformity == 'pass'" 
                               decoration-danger="final_setting_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><span>NABL</span></td>
                           <td><field name="final_setting_nabl"/></td>
                          </tr>
                          </tbody>                     
                          </table>
                        </div>
                      </div>
                    </div>



                    <!-- Bleeding -->
                    <group/>
                     <div>
                        <field name="bleeding_visible" readonly="1" invisible="1" />
                        <h1>
                            <field name="bleeding_name" readonly="1" nolabel="1"   invisible="not bleeding_visible"/>
                        </h1>
                    </div>
                    <group/>
                    

                    <div> 
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                         <tbody>
                            <tr>
                              <td><span>Volume of sample at begning of test (mL)</span></td>
                              <td><field name="vl_sample" invisible="not bleeding_visible" class="blue-input"/></td>
                            </tr>
                            <tr>
                            <td><span>Volume of decanted bleed water (mL)</span></td>
                            <td> <field name="vl_decanted" invisible="not bleeding_visible" class="blue-input"/></td>
                            </tr>
                         </tbody>
                      </table>
                        </div>
                    
                     <div class="custom_table_borders" invisible="not bleeding_visible">
                     <h4 style="white-space: nowrap;">Bleeding</h4><br/>
                      <field name="bleeding_table" nolabel="1" colspan="2">
                        <tree editable="bottom">
                          <field name="test" class="blue-input" decoration-info="test != 0"/>
                          <field name="vl_of_sample" class="blue-input" decoration-info="vl_of_sample != 0"/>
                          <field name="vl_of_grout" class="blue-input" decoration-info="vl_of_grout != 0"/>
                          <field name="bleeding_precent"/>
                        </tree>
                      </field>
                      </div>

                      <div> 
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                         <tbody>
                            <tr>
                              <td><span>Final Bleeding %</span></td>
                              <td><field name="final_bleeding"/></td>
                            </tr>
                         </tbody>
                      </table>
                        </div>
                        <group/>

                        <div >
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><span>Conformity</span></td>
                             <td><field name="bleeding_confirmity"
                               decoration-success="bleeding_confirmity == 'pass'" 
                               decoration-danger="bleeding_confirmity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><span>NABL</span></td>
                           <td><field name="bleeding_nabl"/></td>
                          </tr>
                          </tbody>                     
                          </table>
                        </div>
                    <group/>

                  
                      
                    

                    <!-- Volume Change -->

                     <div>
                        <field name="volume_change_visible" readonly="1" invisible="1" />
                        <h1>
                            <field name="volume_change_name" readonly="1" nolabel="1"   invisible="not volume_change_visible"/>
                        </h1>
                    </div>
                    <group/>
                    
                   

                    <div> 
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                         <tbody>
                            <tr>
                              <td><span>Thickness of Glass Plate</span></td>
                              <td><field name="thickness_of_glass_plate" class="blue-input" /></td>
                            </tr>
                         </tbody>
                      </table>
                        </div>
                        <group/>
                    
                     <div class="custom_table_borders" invisible="not volume_change_visible">
                      

                      <h4 style="white-space: nowrap;">Height Change</h4><br/>
                      <field name="volume_change_table" colspan="2" nolabel="1">
                        <tree editable="bottom">
                          <field name="initial_reading" class="blue-input" decoration-info="initial_reading != 0"/>
                          <field name="days_3" class="blue-input" decoration-info="days_3 != 0"/>
                          <field name="days_14" class="blue-input" decoration-info="days_14 != 0"/>
                          <field name="days_28" class="blue-input" decoration-info="days_28 != 0"/>
                          <field name="height" class="blue-input" decoration-info="height != 0"/>
                          <field name="height_change" />
                        </tree>
                      </field>
                      </div>

                      <div> 
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                         <tbody>
                            <tr>
                              <td><span>Average Height Change</span></td>
                              <td><field name="height_change_average"/></td>
                            </tr>
                         </tbody>
                      </table>
                        </div>
                        <group/>

                        <div >
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><span>Conformity</span></td>
                             <td><field name="volume_change_confirmity"
                               decoration-success="volume_change_confirmity == 'pass'" 
                               decoration-danger="volume_change_confirmity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><span>NABL</span></td>
                           <td><field name="volume_nabl_1"/></td>
                          </tr>
                          </tbody>                     
                          </table>
                        </div>
                    
                    

                     <!-- compressive strength -->
                    <div invisible="not compressive_strength_visible">
                        <h1>
                            <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                            <field name="compressive_strength_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>
                  

                    <div>
                      <table class="table table-sm o_form_table table-bordered  custom_table_borders" style="width:70%">
                         <tbody>
                           <tr>
                             <td><span>Water Cement Ratio (w/c)</span></td>
                             <td style="text-align:center;"><field  name="water_cement_ratio_1"  colspan="1" /></td>
                           </tr>
                           <tr>
                             <td><span>Wt. of Cement (g)</span></td>
                             <td style="text-align:center;"><field  name="wt_of_cement_1"  colspan="1" class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>Wt.of water (g)</span></td>
                             <td style="text-align:center;"><field  name="wt_of_water_1"  colspan="1"  class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>CEBEX 100 (g)</span></td>
                             <td style="text-align:center;"><field  name="cebex_1"  colspan="1" class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>Water Temperature °c</span></td>
                             <td style="text-align:center;"><field  name="water_temperature_1"  colspan="1" class="blue-input" /></td>
                           </tr>
                           <tr>
                             <td><span>Grout Temperature °c</span></td>
                             <td style="text-align:center;"><field  name="grout_temperature_1"  colspan="1" class="blue-input" /></td>
                           </tr>
                         </tbody>
                      </table>
                    </div>
                    <group/>
                    <group/>


                     <div>
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><span>Done</span></td>
                        <td><field name="status_7days" class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span>Date of Casting</span></td>
                        <td><field name="casting_date_7days" class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span>Date of Testing</span></td>
                        <td><field name="testing_date_7days" class="blue-input"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>

                    <div class="custom_table_borders" style="margin-top:20px;">
                    <h4 style="white-space: nowrap;">7 Days</h4><br/>
                    <field name="casting_7_days_tables" nolabel="1" colspan="2">
                        <tree editable="bottom">
                          <field name="length" class="blue-input" decoration-info="length != 0"/>
                          <field name="width" class="blue-input" decoration-info="width != 0"/>
                          <field name="crosssectional_area"/>
                          <field name="wt_of_cement_cube" class="blue-input" decoration-info="wt_of_cement_cube != 0"/>
                          <field name="crushing_load" class="blue-input" decoration-info="crushing_load != 0"/>
                          <field name="compressive_strength" />
                        </tree>
                      </field>
                    </div>

                         <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                         <tbody>
                          <tr>
                            <td><span>Average</span></td>
                            <td><field name="average_casting_7days"/></td>
                           </tr>
                           <tr>
                            <td><span>Compressive Strength</span></td>
                            <td><field name="compressive_strength_7_days"/></td>
                           </tr>
                           </tbody>
                          </table>
                          

                          <div >
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><span>Conformity</span></td>
                             <td><field name="compressive_strength_7days_confirmity"
                               decoration-success="compressive_strength_7days_confirmity == 'pass'" 
                               decoration-danger="compressive_strength_7days_confirmity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><span>NABL</span></td>
                           <td><field name="days7_nabl"/>
                           </td>
                          </tr>
                          </tbody>                     
                          </table>
                        </div>
                    <group/>

                    <div>
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><span>Done</span></td>
                        <td><field name="status_28days"  class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span>Date of Casting</span></td>
                        <td><field name="casting_date_28days"   class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span>Date of Testing</span></td>
                        <td><field name="testing_date_28days"  class="blue-input"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>

                    <div class="custom_table_borders" style="margin-top:20px;">
                    <h4 style="white-space: nowrap;">28 Days</h4><br/>
                    <field name="casting_28_days_tables" colspan="2" nolabel="1">
                        <tree editable="bottom">
                          <field name="length" class="blue-input" decoration-info="length != 0"/>
                          <field name="width" class="blue-input" decoration-info="width != 0"/>
                          <field name="crosssectional_area"/>
                          <field name="wt_of_cement_cube" class="blue-input" decoration-info="wt_of_cement_cube != 0"/>
                          <field name="crushing_load" class="blue-input" decoration-info="crushing_load != 0"/>
                          <field name="compressive_strength" />
                        </tree>
                      </field>
                    </div>

                         <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                         <tbody>
                          <tr>
                            <td><span>Average</span></td>
                            <td><field name="average_casting_28days"/></td>
                           </tr>
                           <tr>
                            <td><span>Compressive Strength</span></td>
                            <td><field name="compressive_strength_28_days"/></td>
                           </tr>
                           </tbody>
                          </table>
                          

                          <div >
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><span>Conformity</span></td>
                             <td><field name="compressive_strength_28days_confirmity"
                               decoration-success="compressive_strength_28days_confirmity == 'pass'" 
                               decoration-danger="compressive_strength_28days_confirmity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><span>NABL</span></td>
                           <td><field name="days28_nabl"/>
                           </td>
                          </tr>
                          </tbody>                     
                          </table>
                        </div>
                    <group/>









