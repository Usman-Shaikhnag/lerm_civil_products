                                <td colspan="6" style="font-weight: bold">% Reduction in Area :
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align: center">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.reduction_in_area_percent" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','1ddc7095-da2d-44a2-a70a-ab97216aee77')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    

                    </div>

                <div t-if="data.proof_stress_visible" >
