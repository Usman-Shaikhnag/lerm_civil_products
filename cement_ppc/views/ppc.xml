<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_cement_ppc" model="ir.ui.view">
        <field name="name">cement.ppc.form</field>
        <field name="model">cement.ppc</field>
        <field name="arch" type="xml">
            <form create="false">
