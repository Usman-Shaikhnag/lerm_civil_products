                      <!-- Setting Time Start -->
                    <div invisible="not initial_setting_time_visible or not final_setting_time_visible">
                        <field name="initial_setting_time_visible" readonly="1" invisible="1" />
                        <field name="final_setting_time_visible" readonly="1" invisible="1" />
                        <h1 class="text-center">
                            <field name="setting_time_name" readonly="1" nolabel="1"   invisible="not initial_setting_time_visible or not final_setting_time_visible"/>
                        </h1>
                    </div>

                    <div class="d-flex" style="gap:10px; margin-bottom:20px; align-items:stretch;"  invisible="not initial_setting_time_visible or not final_setting_time_visible">

                        <!-- Left side -->
                       <div style="width:50%; text-align:center;" class="equal-box">
                            <div class="o_form_label"
                                style="font-weight:bold; background:#f0f0f0; padding:6px; margin-bottom:0; border:1px solid #ccc; border-bottom:0;">
                                Initial Setting Time
                            </div>
                            <field name="intial_time_lines" class="custom_table_borders" style="margin-top:0; margin-bottom:0; width:100%;">
                                <tree editable="bottom">
                                    <field name="serial_no"/>
                                    <field name="clock_time" />
                                    <field name="time_in_minutes"/>
                                    <field name="penetration_intial"/>
                                </tree>
                            </field>
                        </div>


                  


                        <!-- Right side -->

                         <div style="width:50%; text-align:center;" class="equal-box">
                            <div class="o_form_label"
                                style="font-weight:bold; background:#f0f0f0; padding:6px; margin-bottom:0; border:1px solid #ccc; border-bottom:0;">
                              Final Setting Time
                            </div>
                            <field name="final_time_lines" class="custom_table_borders" style="margin-top:0; margin-bottom:0; width:100%;">
                                <tree editable="bottom">
                                    <field name="serial_no"/>
                                    <field name="clock_time1" />
                                     <field name="time_in_minutes1" />
                                    <field name="impression_intial1"/>
                                </tree>
                            </field>
                        </div>

                       

                    </div>

                    <div class="d-flex gap-2 align-items-start" style="width:100%;">
    
                            <!-- Initial Setting Time Table -->
                            <table class="table table-sm o_form_table table-bordered custom_table_borders flex-fill"
                                invisible="initial_setting_time_visible == False">
                                <thead>
                                    <tr>
                                        <th colspan="2" class="text-center">
                                            <field name="initial_setting_time_name" readonly="1" nolabel="1"
                                                invisible="initial_setting_time_visible == False"/>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><label for="time_water_added">The Time When water is added to cement (t1)</label></td>
                                        <td><field name="time_water_added"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="time_needle_fails">The time at which needle fails to penetrate the test block to a point 5 ± 0.5 mm (t2)</label></td>
                                        <td><field name="time_needle_fails"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="initial_setting_time_hours">Initial Setting Time (t2-t1) (Hours)</label></td>
                                        <td><field name="initial_setting_time_hours"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="initial_setting_time_minutes_unrounded">Initial Setting Time</label></td>
                                        <td><field name="initial_setting_time_minutes_unrounded"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="initial_setting_time_minutes">Initial Setting Time Rounded</label></td>
                                        <td><field name="initial_setting_time_minutes"/>  <span><field name="initial_time_unit" readonly="1" nolabel="1"/></span></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Final Setting Time Table -->
                            <table class="table table-sm o_form_table table-bordered custom_table_borders flex-fill"
                                invisible="final_setting_time_visible == False">
                                <thead>
                                    <tr>
                                        <th colspan="2" class="text-center">
                                            <field name="final_setting_time_name" readonly="1" nolabel="1"
                                                invisible="final_setting_time_visible == False"/>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><label for="time_needle_make_impression">The Time at which the needle make an impression on the surface of test block while attachment fails to do (t3)</label></td>
                                        <td><field name="time_needle_make_impression"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="final_setting_time_hours">Final Setting Time (t2-t1) (Hours)</label></td>
                                        <td><field name="final_setting_time_hours"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="final_setting_time_minutes_unrounded">Final Setting Time</label></td>
                                        <td><field name="final_setting_time_minutes_unrounded"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="final_setting_time_minutes">Final Setting Time Rounded</label></td>
                                        <td><field name="final_setting_time_minutes"/>  <span><field name="final_time_unit" readonly="1" nolabel="1"/></span></td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>

                    <div class="d-flex gap-2 align-items-start" style="width:100%;">
                        <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="initial_setting_time_visible == False">
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="initial_setting_conformity">Initial Setting Time Conformity</label></td>
                                <td>
                                    <field name="initial_setting_conformity"
                                        decoration-success="initial_setting_conformity == 'pass'"
                                        decoration-danger="initial_setting_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="initial_setting_nabl">Initial Setting Time NABL</label></td>
                                <td>
                                    <field name="initial_setting_nabl"
                                        decoration-success="initial_setting_nabl == 'pass'"
                                        decoration-danger="initial_setting_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                     <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="final_setting_time_visible == False">
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="final_setting_conformity">Final Setting Time Conformity</label></td>
                                <td>
                                    <field name="final_setting_conformity"
                                        decoration-success="final_setting_conformity == 'pass'"
                                        decoration-danger="final_setting_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="final_setting_nabl">Final Setting Time NABL</label></td>
                                <td>
                                    <field name="final_setting_nabl"
                                        decoration-success="final_setting_nabl == 'pass'"
                                        decoration-danger="final_setting_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>


                    <div class="text-center" invisible="specific_gravity_visible == False">
                        <h1>
                            <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>

                        </h1>
                    </div>
                    
                <div  invisible="specific_gravity_visible == False">
                    <table class="table table-sm table-bordered custom_table_borders" invisible="not specific_gravity_visible" style="white-space:nowrap;">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Trial 1</th>
                                <th>Trial 2</th>
                                <!-- <th>Result</th> -->
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="fw-bold"> Weight of empty bottle (W₁ g)</span></td>
                                <td><field name="wt_of_empty_bottle"/></td>
                                <td><field name="wt_of_empty_bottle1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of bottle + Cement ( W₂ g)</span></td>
                                <td><field name="wt_of_bottle_cement"/></td>
                                <td><field name="wt_of_bottle_cement1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of Specific gravity bottle + Cement + Kerosene ( W₃ g)</span></td>
                                <td><field name="wt_of_specific_bpttle"/></td>
                                <td><field name="wt_of_specific_bpttle1"/></td>
                            </tr>

                             <tr>
                                <td><span class="fw-bold">Weight of bottle + Full Kerosene( W₄ g)</span></td>
                                <td><field name="wt_of_kerosene"/></td>
                                <td><field name="wt_of_kerosene1"/></td>
                            </tr>

                              <tr>
                                <td><span class="fw-bold">Weight of bottle + Full Water ( W₅ g)</span></td>
                                <td><field name="wt_of_bottle_water"/></td>
                                <td><field name="wt_of_bottle_water1"/></td>
                            </tr>

                               <tr>
                                <td><span class="fw-bold">Specific gravity</span></td>
                                <td><field name="specific_gravity"/></td>
                                <td><field name="specific_gravity1"/></td>
                            </tr>

                           

                           
