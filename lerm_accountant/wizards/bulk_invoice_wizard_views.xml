<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="bulk_invoice_wizard_line_tree" model="ir.ui.view">
            <field name="name">bulk.invoice.wizard.line.tree</field>
            <field name="model">bulk.invoice.wizard.line</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false">
                    <field name="kes_no"/>
                    <field name="material_id"/>
                    <field name="pricing_preview"/>
                    <field name="total_price" widget="monetary" sum="Total"/>
                    <field name="has_fallback" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="bulk_invoice_wizard_form" model="ir.ui.view">
            <field name="name">bulk.invoice.wizard.form</field>
            <field name="model">bulk.invoice.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <div class="alert alert-warning" role="alert"
                        invisible="has_fallback_pricing == False">
                        <strong>⚠️ Missing Pricelist Entries</strong><br/>
                        <field name="fallback_warning_message" nolabel="1"
                            class="text-break"/>
                        <p class="mt-2 mb-0 text-muted">
                            <small>Using default pricing based on product list price.
                            Review the invoice lines after generation.</small>
                        </p>
                    </div>

                    <field name="has_fallback_pricing" invisible="1"/>
                    <group>
                        <group>
                            <field name="billing_customer"/>
                            <field name="pricelist_id"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                    </group>

                    <field name="line_ids" nolabel="1"
                        context="{'tree_view_ref': 'lerm_accountant.bulk_invoice_wizard_line_tree'}"/>

                    <footer>
                        <button name="action_generate_invoice" type="object"
                            string="Generate Invoice" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="bulk_invoice_wizard_action" model="ir.actions.act_window">
            <field name="name">Generate Invoice</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bulk.invoice.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="bulk_invoice_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
