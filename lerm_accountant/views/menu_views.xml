<odoo>
    <data>

        <record id="lerm_accountant_sample_action" model="ir.actions.act_window">
            <field name="name">Samples</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">lerm.srf.sample</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="lerm_accountant_sample_tree"/>
            <field name="search_view_id" ref="lerm_accountant_sample_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Samples</p>
            </field>
        </record>

        <menuitem id="lerm_accounting_section"
            name="LERM"
            parent="account.menu_finance"
            sequence="100"/>

        <menuitem id="lerm_accountant_sample_menu"
            name="Samples"
            parent="lerm_accounting_section"
            action="lerm_accountant_sample_action"
            groups="lerm_accountant.lerm_accountant_group"
            sequence="10"/>

    </data>
</odoo>
