<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="alccofine_datasheet">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px">
                    ALCCOFINE
                </div>

				<div class="container_eln" style="margin-top:7px">


				  <table style="margin-top:20px">
                        <tr cols="12">
				        <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
							
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>
                        <tr style="height:50px" cols="12">
								<td colspan="4">Performed By :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.technician.name"/>
								</td>
								<td colspan="4">Witness Name :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.witness_name"/>
								</td>
								<td colspan="4">Witness Signature :
									<![CDATA[&nbsp;]]>
									<span style='padding:20px'></span>
								</td>
							</tr>
					</table>



						<!-- Specific Gravity -->
					
					<div t-if="data.specific_gravity_visible" style="page-break-inside: avoid;">
						<div style="text-align:center;font-size:18px;margin-top: 20px;page-break-inside: avoid;">
							Specific Gravity
						</div>
						
						<table style="margin-top: 10px; width: 100%; border-collapse: collapse; font-size: 15px;page-break-inside: avoid; break-inside: avoid;">
							<tr>
								  <td colspan="6" style="font-weight: bold;text-align: left; padding: 8px; ">Temperature : 
								  <![CDATA[&nbsp;]]>
									<span t-field="data.temp_specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
								  </td>	
								  <td colspan="6" style="font-weight: bold;text-align: left; padding: 8px; ">Humidity : 
								  <![CDATA[&nbsp;]]>
									<span t-field="data.humidity_specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
								  </td>	
							</tr>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 15px;page-break-inside: avoid; break-inside: avoid;">
							<tr>
								<td colspan="6" style="font-weight: bold;text-align: left; padding: 8px;">Weight of UGGBS Sample (g) </td>
								<td colspan="6" style="padding: 8px;text-align: center;">
									<span t-field="data.mass_alccofine"/>
								</td>
							</tr>
							<tr>
								<td colspan="6" style="font-weight: bold;text-align: left; padding: 8px;">Initial Volume of Kerosine (ml) V1 </td>
								<td colspan="6" style="padding: 8px;text-align: center;">
									<span t-field="data.initial_volume" />
								</td>
							</tr>
							<tr>
								<td colspan="6" style="font-weight: bold;text-align: left; padding: 8px;">Final Volume of Kerosine + Sample (ml) V2" </td>
								<td colspan="6" style="padding: 8px;text-align: center;">
									<span t-field="data.final_volume" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
							<tr>
								<td colspan="6" style="font-weight: bold;text-align: left; padding: 8px;">Displaced Volume of Sample (cm³)</td>
								<td colspan="6" style="padding: 8px;text-align: center;">
									<span t-field="data.displaced_volume" />
								</td>
							</tr>
							<tr>
								<td width="100%" colspan="12" style="font-weight: bold;text-align: center; padding: 8px;">Specific Gravity  : 
								<![CDATA[&nbsp;]]>
									<span t-field="data.specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>

						</div>
					
					


					<!-- Dry Loose Bulk Density -->
					
					<div t-if="data.dry_loose_bulk_density_visible">
						<div style="text-align:center;font-size:18px;margin-top: 20px;">
							Dry Loose Bulk Density
						</div>
						
						<table style="margin-top: 10px; width: 100%; border-collapse: collapse; font-size: 15px;page-break-inside: avoid; break-inside: avoid;">
							<tr>
								  <td colspan="6" style="font-weight: bold;text-align: left; padding: 8px; ">Temperature : 
								  <![CDATA[&nbsp;]]>
									<span t-field="data.temp_percent_normal" t-options='{"widget": "float", "precision": 2}'/>
								  </td>	
								  <td colspan="6" style="font-weight: bold;text-align: left; padding: 8px; ">Humidity : 
								  <![CDATA[&nbsp;]]>
									<span t-field="data.humidity_percent_normal" t-options='{"widget": "float", "precision": 2}'/>
								  </td>	
							</tr>
						</table>

						<table style="width: 100%; border-collapse: collapse; font-size: 15px;margin-top: 10px;page-break-inside: avoid; break-inside: avoid;">
							<thead>
								<tr>
									<th style="font-weight: bold;padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Sr No.</th>
									<th style="font-weight: bold;padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of empty Cylinder (w1) (kg)</th>
									<th style="font-weight: bold;padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of empty Cylinder + Microsilica (w2) (kg)</th>
									<th style="font-weight: bold;padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of Microsilica (w3) (kg)</th>
									<th style="font-weight: bold;padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Volume of Cylinder (m³)</th>
									<th style="font-weight: bold;padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Dry Loose Bulk Density (kg/m³)</th>
									
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.dry_trial_ids" t-as="r" style="text-align: center;">
									<td style="padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['weight_empty_cylinder']"/>
									</td>
									<td style="padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['weight_cylinder_microsilica']"/>
									</td>
									<td style="padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['weight_microsilica']" t-options='{"widget": "float", "precision": 3}'/>
									</td>

									<td style="padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['cylinder_volume']" />
									</td>

									<td style="padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['dry_loose_bulk_density']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 10px; width: 100%; border-collapse: collapse; font-size: 15px;page-break-inside: avoid; break-inside: avoid;">
							<tr>
								<td width="100%" colspan="6" style="font-weight: bold;text-align: center; padding: 8px;">Average Dry Loose Bulk Density (kg/m³) : 
								<![CDATA[&nbsp;]]>
									<span t-field="data.average_density" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
							
						</table>
						
						</div>


					

					

					

                    <!-- authorizeRowDataSheet -->
                    
                     <div class="authorizeRowDataSheet">
						<div>
                            <div>
                                <b>
                                    Tested By 
                                </b>
                                
                            </div>
                            <div style="height:40px">
								<t t-if="eln.tested_by_signature_datasheet">
									<div t-if="eln.technician and eln.technician.employee_id and eln.technician.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.technician.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
								</t>
                            </div>
                            <div>
                                <b>
									<span t-esc="eln.technician.employee_id.name"/> 
                                <!-- <span t-esc="eln.sample_id.filled_by.name"/> -->
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.technician.employee_id.job_title"/>)
                                </b>
                            </div>
						</div>
						<div style="margin-left:500px">
							
							<div>
								<b>
									Checked By
								</b>
							</div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checkby_signature_required or eln.sample_id.checkby_signature_required">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>



				</div>  
			</t>
		</t>
	</template>
</odoo>