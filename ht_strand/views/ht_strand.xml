<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="ht_strand_view" model="ir.ui.view">
        <field name="name">ht.strand.form</field>
        <field name="model">ht.strand</field>
        <field name="arch" type="xml">
            <form create="false">

                <sheet>
                   <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                     <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <!-- <field name="grade" readonly="1"/> -->
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                        <field name="grade"/>
                    </group>
                    
                   

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                           
                           <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="sample_parameters" nolabel="1">
                                    <tree>
                                        <field name="parameter_name"/>
                                        <field name="test_method"/>
                                    </tree>
                                </field>
                            </div>


                           

                                <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                     

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="sample_submitted"></label></td>
                                    <td><field name="sample_submitted" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="sample_status"></label></td>
                                    <td><field  name="sample_status" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="No_of_sample"></label></td>
                                    <td><field name="No_of_sample" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>


                    

                    <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="product_name"></label></td>
                                    <td><field  name="product_name" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                  <div invisible="ht_strand_visible == False" style="text-align:center">
                        <h1>
                          
                          <field name="ht_strand_visible" invisible='1'/>
                          <field name="ht_strand_name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>



                    <div class="d-flex gap-2" invisible="ht_strand_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="nominal_specification"></label></td>
                                    <td><field  name="nominal_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="cross_specification"></label></td>
                                    <td><field  name="cross_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         </div>



                         <div class="d-flex gap-2" invisible="ht_strand_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="mass_specification"></label></td>
                                    <td><field  name="mass_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="braking_specification"></label></td>
                                    <td><field  name="braking_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         </div>
                         <div class="d-flex gap-2" invisible="ht_strand_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="uts_specification"></label></td>
                                    <td><field  name="uts_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="yield_specification"></label></td>
                                    <td><field  name="yield_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         </div>
                         <div class="d-flex gap-2" invisible="ht_strand_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="proof_specification"></label></td>
                                    <td><field  name="proof_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="elongation_specification"></label></td>
                                    <td><field  name="elongation_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         </div>

                

                

                    <div invisible="ht_strand_visible == False" class="mb-3">
                    <field name="ht_strand_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="sr_no" />
                                <field name="test_parameter" class="blue-input" decoration-info="test_parameter != 0"/>
                                <field name="nominal_dia"  class="blue-input" decoration-info="nominal_dia != 0"/>
                                <field name="cross_section"  class="blue-input" decoration-info="cross_section != 0"/>
                                <field name="mass_per"  class="blue-input" decoration-info="mass_per != 0"/>

                                <field name="breaking_load"  class="blue-input" decoration-info="breaking_load != 0"/>
                                <field name="uts"  class="blue-input" decoration-info="uts != 0"/>
                                <field name="yield_stress"  class="blue-input" decoration-info="yield_stress != 0"/>
                                <field name="proof_load"  class="blue-input" decoration-info="proof_load != 0"/>
                                <field name="elongation"  class="blue-input" decoration-info="elongation != 0"/>
                                
                              
                            </tree>
                    </field>
                  

                    </div>

                

                    <notebook>

                        <page string="Notes" invisible="1">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                         <page string="Remark" >
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="remark_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="remark"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
              

                </sheet>
            </form>
        </field>
    </record>
   


    </data>
</odoo>