<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="ht_strand_datasheet">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px">
                  HT STAY WIRE DATASHEET
                </div>
				<div class="container_eln" style="margin-top:5px">
					<div t-foreach="eln" t-as="o">
						<table>
							<tr cols="12">
								<td colspan="6">Job no :
									<![CDATA[&nbsp;]]>
									<span t-field="o.eln_id"/>
								</td>
								<td colspan="6">Test Start Date :
									<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
							</tr>
							<tr cols="12">
								<td colspan="6">Material :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
								<td colspan="6">Test End Date :
									<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr style="height:50px" cols="12">
								<td colspan="4">Performed By :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.technician.name"/>
								</td>
								<td colspan="4">Witness Name :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.witness_name"/>
								</td>
								<td colspan="4">Witness Signature :
									<![CDATA[&nbsp;]]>
									<span style='padding:20px'></span>
								</td>
							</tr>
							
						</table>
					</div>


						<div style="margin-top:20px"  invisible="ht_strand_visible == False">
                       
                        <table>
                       
                             
							  <tr cols="12">
                                <td  style="text-align: center;"><b>Sr No.</b></td>
                                <td   style="text-align: center;"><b>TEST PARAMETER</b></td>
                                <td   style="text-align: center;"><b>NOMINAL DIAMETER</b></td>
								<td   style="text-align: center;"><b>CROSS SECTION  Area  mm2</b></td>
                                <td   style="text-align: center;"><b>MASS PER METERE Kg/MTR</b></td>
                                <td   style="text-align: center;"><b>Braking Load (N)</b></td>
                                <td   style="text-align: center;"><b>UTS N/MM2</b></td>
                                <td  style="text-align: center;"><b>YIELD STRESS N/MM2</b></td>
                                <td   style="text-align: center;"><b>0.2% PROOF LOAD(N)</b></td>
                                <td   style="text-align: center;"><b>% Elongation at maximum load</b></td>
								
                               
                            </tr>

							

                             <tr>
								<td colspan="2" style="text-align: center;">
									<b>Specification as per </b>
								</td>

							
								<td style="text-align: center;">
								&#160;<span t-field="data.nominal_specification"/>
								</td> <!-- UTS -->

								<td style="text-align: center;">
									&#160;<span t-field="data.cross_specification"/>
								</td>
								<td style="text-align: center;">
									&#160;<span t-field="data.mass_specification"/>
								</td>
								<td style="text-align: center;">
									&#160;<span t-field="data.braking_specification"/>
								</td>

								<td style="text-align: center;">	
								&#160;<span t-field="data.uts_specification"/>
									</td> <!-- elongation -->
								<td style="text-align: center;">
								&#160;<span t-field="data.yield_specification"/>
									</td> <!-- bend -->

                                    <td style="text-align: center;">
									&#160;<span t-field="data.proof_specification"/>
									</td> <!-- bend -->

									<td style="text-align: center;">
									&#160;<span t-field="data.elongation_specification"/>
									</td>
							</tr>
                            <t t-set="f" t-value="0"/>
                            <tr t-foreach="data.ht_strand_lines" t-as="r">
                                <td  style="text-align: center;">
                                    <div>
                                        <span t-esc="f + 1" />
                                        <t t-set="f" t-value="f + 1"/>
                                    </div>
                                </td>
                                <td  style="text-align: center;">
                                    <span t-esc="r['test_parameter']"/>
                                </td>
								

								<td style="text-align: center;">
									<span t-esc="r['nominal_dia'] if r['nominal_dia'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['cross_section'] if r['cross_section'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['mass_per'] if r['mass_per'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['breaking_load'] if r['breaking_load'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['uts'] if r['uts'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['yield_stress'] if r['yield_stress'] not in (None, 0, 0.0) else '--'"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r['proof_load'] if r['proof_load'] not in (None, 0, 0.0) else '--'"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r['elongation'] if r['elongation'] not in (None, 0, 0.0) else '--'"/>
								</td>
								

								
                               
                            </tr>




							
                        </table>
						</div>
                    
                    <div class="authorizeRowDataSheet">
						<div>
                            <div>
                                <b>
                                    Tested By 
                                </b>
                                
                            </div>
                            <div style="height: 40px;">
									<t t-if="eln.sample_id.testedby_signature_required">
										<div t-if="eln.sample_id.filled_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
						</div>
						<div style="margin-left:500px">
							
							<div>
								<b>
									Checked By
								</b>
							</div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checkby_signature_required">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>
                    
				</div>
			</t>
		</t>
	</template>
</odoo>