											<t t-if="data.temp is not None">
											<span t-field="data.temp"/>   °C
										</t>
									<t t-else="">NA</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="data.humidity is not None">
											<span t-field="data.humidity"/>   %
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">NA</t>
								</td>
								
							</tr>

							</table>
