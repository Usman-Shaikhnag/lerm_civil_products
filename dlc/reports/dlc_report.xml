										</t>
									<t t-else="">NA</t>
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>

