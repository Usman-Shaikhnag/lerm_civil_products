<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_gl_report" model="ir.module.category">
            <field name="name">General Ledger Report</field>
            <field name="description">General Ledger Report Management</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_gl_report_user" model="res.groups">
            <field name="name">GL Report User</field>
            <field name="category_id" ref="module_category_gl_report"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_gl_report_admin" model="res.groups">
            <field name="name">GL Report Admin</field>
            <field name="category_id" ref="module_category_gl_report"/>
            <field name="implied_ids" eval="[(4, ref('group_gl_report_user'))]"/>
        </record>

        <record id="gl_report_preset_company_rule" model="ir.rule">
            <field name="name">Preset: multi-company</field>
            <field name="model_id" ref="model_account_gl_report_preset"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="gl_report_preset_user_rule" model="ir.rule">
            <field name="name">Preset: user own</field>
            <field name="model_id" ref="model_account_gl_report_preset"/>
            <field name="groups" eval="[(4, ref('group_gl_report_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
        </record>

        <record id="gl_report_preset_admin_rule" model="ir.rule">
            <field name="name">Preset: admin all</field>
            <field name="model_id" ref="model_account_gl_report_preset"/>
            <field name="groups" eval="[(4, ref('group_gl_report_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
