<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gl_report_preset_tree" model="ir.ui.view">
            <field name="name">account.gl.report.preset.tree</field>
            <field name="model">account.gl.report.preset</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="is_default"/>
                    <field name="create_date"/>
                </tree>
            </field>
        </record>

        <record id="view_gl_report_preset_form" model="ir.ui.view">
            <field name="name">account.gl.report.preset.form</field>
            <field name="model">account.gl.report.preset</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="is_default"/>
                    </group>
                    <field name="params_json" nolabel="1" readonly="1"
                           invisible="params_json == ''"/>
                </form>
            </field>
        </record>

        <record id="view_gl_report_preset_search" model="ir.ui.view">
            <field name="name">account.gl.report.preset.search</field>
            <field name="model">account.gl.report.preset</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="user_id"/>
                    <separator/>
                    <filter name="my_presets" string="My Presets"
                            domain="[('user_id', '=', uid)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
