										<span t-esc="r['wt_of_residue']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['fineness']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

