									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Wt. of Sample taken (W1) gm</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Wt. of residue on 90μ sieve (W Max. 10% 2) gm</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Fineness (%) (W2/W1) X100</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.fneness_cement_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
