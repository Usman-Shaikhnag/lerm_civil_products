<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="opc_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">NA</t>
								</td>

                                <!-- <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td> -->
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">NA</t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <!-- <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td> -->
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id or o.sample_id.grade_id">
											  <span t-field="o.material.lab_name"/><![CDATA[&nbsp;]]><span t-field="o.sample_id.grade_id"/><![CDATA[&nbsp;]]> Grade
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.sample_id.source_of_sample">
											<span t-field="o.sample_id.source_of_sample"/>
										</t>
									<t t-else="">NA</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date" t-options='{"widget": "date"}'/>
											<span style="display:inline-block; padding:0 3px;">to</span>
											<span t-field="o.end_date" t-options='{"widget": "date"}'/>
										</t>
									<t t-else="">NA</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.sample_condition">
											<span t-field="o.sample_id.sample_condition"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="3">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<!-- <td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">NA</t>
										</td> -->
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<t t-if="data.temp is not None">
											<span t-field="data.temp"/>   °C
										</t>
									<t t-else="">NA</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="data.humidity is not None">
											<span t-field="data.humidity"/>   %
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">NA</t>
								</td>
								
							</tr>

							
							

							</table>
					</div>


					<div style="">
						<table style="margin-top:10px;">
						<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">Sr. No</th>
									<th style="text-align: center;">
									<span t-esc="eln.material.test_parameter"/>
									<!-- Test Parameter -->
									</th>

                                    <th style="text-align: center;">
									<span t-esc="eln.material.result_remark"/>
									<!-- Test Result -->
									</th>

									<th style="text-align: center;">
									<span t-esc="eln.material.unit"/>
									<!-- Unit -->
									</th>

                                    <th style="text-align: center;"><span t-esc="eln.material.specifications"/></th>

									<th style="text-align: center;"><span t-esc="eln.material.method_reference"/></th>
									
								</tr>
							</thead>
							<tbody>

							<!-- Compressive Strength -->
                            <t t-set="show_3_days" t-value="data.avg_3_days_final_report == 'nabl' and nabl or data.avg_3_days_final_report == 'non_nabl' and not nabl"/>

                            <t t-set="show_7_days" t-value="data.avg_7_days_final_report == 'nabl' and nabl or data.avg_7_days_final_report == 'non_nabl' and not nabl"/>

							

							<t t-set="show_28_days" t-value="data.avg_28_days_final_report == 'nabl' and nabl or data.avg_28_days_final_report == 'non_nabl' and not nabl"/>

                            <!-- 🔹 Step 2: Rowspan calculation -->
					      <t t-set="rowspan_count" t-value="1 + int(show_3_days) + int(show_7_days) + int(show_28_days)"/>

                          <tr t-if="(data.compressive_visible) and (show_3_days or show_7_days or show_28_days)">

									<t t-set="bulk" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','2014587ghty1-372f-4775-9bcb-e9dd723547htui')])"/>
									
									<td t-att-rowspan="rowspan_count"  style="text-align: center;vertical-align:middle;">
						                 <span t-esc="i + 1"/>
							             <t t-set="i" t-value="i+1"/>
						            </td>
									<td colspan="5">
										<span t-esc="bulk.parameter_name"/>
									</td>
								</tr>

					
							 <!-- Compressive Strength (3 Days) -->
                             <tr t-if="data.compressive_visible and show_3_days">
									<t t-set="three_days" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','0124578hgggt-372f-4775-9bcb-e9dd723547htui')])"/>
									
									<td>
										<span t-esc="three_days.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_3_days" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="three_days.unit.name"/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<t t-foreach="three_days.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="three_days.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Compressive Strength (7 Days) -->
							<tr t-if="data.compressive_visible and show_7_days">
									<t t-set="seven_days" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','30124587hhhy-372f-4775-9bcb-e9dd723547htui')])"/>
									
									<td>
										<span t-esc="seven_days.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_7_days" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="seven_days.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="seven_days.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="seven_days.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								
								<!-- Compressive Strength (28 Days) -->
							<tr t-if="data.compressive_visible and show_28_days">
									<t t-set="two_eight_days" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','b48d3c45-a2d6-4b69-a277-4f771724efdb')])"/>
									
									<td>
										<span t-esc="two_eight_days.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_28_days" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="two_eight_days.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="two_eight_days.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="two_eight_days.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- Setting Time -->
                            <t t-set="show_initial_setting_time" t-value="data.initial_setting_final_report == 'nabl' and nabl or data.initial_setting_final_report == 'non_nabl' and not nabl"/>

                            <t t-set="show_final_setting_time" t-value="data.final_setting_final_report == 'nabl' and nabl or data.final_setting_final_report == 'non_nabl' and not nabl"/>

                            <!-- 🔹 Step 2: Rowspan calculation -->
					      <t t-set="rowspan_count" t-value="1 + int(show_initial_setting_time) + int(show_final_setting_time)"/>

                          <tr t-if="(data.setting_time_visible) and (show_initial_setting_time or show_final_setting_time)">

									<t t-set="bulk" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','12457888yui14-372f-4775-9bcb-e9dd723547htui2')])"/>
									
									<td t-att-rowspan="rowspan_count"  style="text-align: center;vertical-align:middle;">
						                 <span t-esc="i + 1"/>
							             <t t-set="i" t-value="i+1"/>
						            </td>
									<td colspan="5">
										<span t-esc="bulk.parameter_name"/>
									</td>
								</tr>

					
							 <!-- Initial Setting Time -->
                             <tr t-if="data.setting_time_visible and show_initial_setting_time">
									<t t-set="initial_setting" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','40ce7425-30fe-4043-b518-015f5c60d916')])"/>
									
									<td>
										<span t-esc="initial_setting.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.initial_setting_time" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="initial_setting.unit.name"/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<t t-foreach="initial_setting.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="initial_setting.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Final Setting Time -->
							<tr t-if="data.setting_time_visible and show_final_setting_time">
									<t t-set="final_setting" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','d339933c-5e9c-4335-9ea2-2d87624c3061')])"/>
									
									<td>
										<span t-esc="final_setting.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.final_setting_time" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="final_setting.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="final_setting.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="final_setting.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Fineness of Cement by Dry Sieving -->
							<tr t-if="data.fineness_cement_visible and (data.avg_fineness_final_report == 'nabl' and nabl or data.avg_fineness_final_report == 'non_nabl' and not nabl)">
									<t t-set="fine_dry" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','a9e97cea-372f-4775-9bcb-e9dd70e6e6df')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
										<span t-esc="fine_dry.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_fineness" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="fine_dry.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="fine_dry.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="fine_dry.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Consistency of Cement -->
							<tr t-if="data.consistency_cement_visible and (data.average_consistency_final_report == 'nabl' and nabl or data.average_consistency_final_report == 'non_nabl' and not nabl)">
									<t t-set="consistency" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','3214578nbhgt2-372f-4775-9bcb-e9dd723547htui')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
										<span t-esc="consistency.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_consistency" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="consistency.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="consistency.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="consistency.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- SOUNDNESS OF CEMENT BY LE-CHATELIER METHOD -->
							<tr t-if="data.soundness_cement_visible and (data.soundness_expansion_final_report == 'nabl' and nabl or data.soundness_expansion_final_report == 'non_nabl' and not nabl)">
									<t t-set="soundness" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','23547gtyu-372f-4775-9bcb-e9dd723547htui')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
										<span t-esc="soundness.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_soundness_expansion" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="soundness.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="soundness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="soundness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- SPECIFIC GRAVITY OF CEMENT -->
							<tr t-if="data.specific_gravity_visible and (data.specific_gravity_final_report == 'nabl' and nabl or data.specific_gravity_final_report == 'non_nabl' and not nabl)">
