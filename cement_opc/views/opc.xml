<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_cement_opc" model="ir.ui.view">
        <field name="name">cement.opc.form</field>
        <field name="model">cement.opc</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <group>
                       <field name="grade"/>
                    </group>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="size_id"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                 
                    <div invisible = "density_cement_visible == False"  style="margin-top: 20px;">
                        <h1 class="text-center">
                            <field name="density_cement_name" readonly="1" nolabel="1"/>
                            <field name="density_cement_visible" invisible="1"/>
                        </h1>
                    </div>


                     <div class="d-flex gap-2" invisible="not density_cement_name">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_specific">Temp.°C</label></td>
                                    <td><field name="temp_specific"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_specific">Humidity %</label></td>
                                    <td><field name="humidity_specific"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>


                    <div invisible="not density_cement_name">
                     <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr>
                           <td>Observations</td>
                           <td><span>Trial 1</span></td>
                           <td><span>Trial 2</span></td>
                         </tr>
                         <tr>
                           <td><label for="temp_water1">Temperature of Water Bath  when Flask kept in bath – 0C</label></td>
                           <td><field  name="temp_water1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water2"  colspan="1"  nolabel="1"/></td>
                          </tr>
                         <tr>
                           <td><label for="temp_water_after1">Temperature of Water Bath  after One Hour when Flask kept in bath – 0C  </label></td>
                           <td><field  name="temp_water_after1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water_after2"  colspan="1"  nolabel="1"/></td>
                         </tr>
                         <tr> 
                           <td><label for="initial_kerosene1">Initial Level of Kerosene after one hour kept in Water Bath(A) – ml</label></td>
                           <td><field  name="initial_kerosene1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="initial_kerosene2"  colspan="1"  nolabel="1"/></td>
                         </tr>
                      
                         <tr>
                           <td><label for="mass1">Mass of Cement Sample Added in Flask (M) – gms</label></td>
                           <td><field  name="mass1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="mass2"  colspan="1"  nolabel="1"/></td>
                         </tr>      

                         <tr>
                           <td><label for="temp_water_flask1">Temperature of water bath  when Flask kept in bath after Adding Cement – 0C</label></td>
                           <td><field  name="temp_water_flask1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water_flask2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="temp_water_one1">Temperature of water bath  after one hour when Flask kept in bath after Adding Cement – 0C</label></td>
                           <td><field  name="temp_water_one1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water_one2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="final_kerosene1">Final Level of Kerosene after one hour kept in water bath(B) – ml</label></td>
                           <td><field  name="final_kerosene1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="final_kerosene2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="displaced1">Displaced Volume after Adding Cement (V) = (B – A) – cm3</label></td>
                           <td><field  name="displaced1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="displaced2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="density1">Density of Cement Sample (    ) – gms/ cm3</label></td>
                           <td><field  name="density1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="density2"  colspan="1"  nolabel="1"/></td>
                         </tr>      

                         <tr>
                                  <td>
                                   Average Density of Cement Sample – gms/ cm3
                                  </td>
                                  <td style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;" colspan="2"> <field name="avg_density" nolabel="1"/></td>
                              </tr>
                        

                       </tbody>
                     </table>
                    </div>



                    


                    <table invisible="density_cement_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <!-- <tr>
                                <td><label class="fw-bold" for="avg_density">Density of Cement</label></td>
                                <td>
                                    <field name="avg_density" nolabel="1"/>
                                    <span>g/cm³</span>
                                </td>
                            </tr> -->
                          
                            <tr>
                                <td><label class="fw-bold" for="avg_density_conformity"> Conformity</label></td>
                                <td>
                                    <field name="avg_density_conformity"
                                        decoration-success="avg_density_conformity == 'pass'"
                                        decoration-danger="avg_density_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_density_nabl"> NABL</label></td>
                                <td>
                                    <field name="avg_density_nabl"
                                        decoration-success="avg_density_nabl == 'pass'"
                                        decoration-danger="avg_density_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    
                    <div invisible = "consistency_cement_visible == False">
                        <h1 class="text-center">
                            <field name="consistency_cement_name" readonly="1" nolabel="1"/>
                            <field name="consistency_cement_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div invisible = "consistency_cement_visible == False">
                        <field name="consistency_cement_lines" class="custom_table_borders">
                            <tree editable="bottom">
                                <field name="serial_no"/>
                                <field name="lab_id" width="100px"/>
                                <field name="trial_no"/>

                                <field name="mass_of_cement"  />
                                <field name="water_added"  />
                                <field name="water_mix" />
                                <field name="needle_penitration" />
                                <!-- <field name="duration"/> -->
                            </tree>
                        </field>
                    </div>

                    <table invisible="consistency_cement_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <!-- <tr>
                                <td><label class="fw-bold" for="consitency_of_cement">Consistency of Cement</label></td>
                                <td>
                                    <field name="consitency_of_cement" nolabel="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="consitency_of_cement_conformity">Consistency Conformity</label></td>
                                <td>
                                    <field name="consitency_of_cement_conformity"
                                        decoration-success="consitency_of_cement_conformity == 'pass'"
                                        decoration-danger="consitency_of_cement_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="consitency_of_cement_nabl">Consistency NABL</label></td>
                                <td>
                                    <field name="consitency_of_cement_nabl"
                                        decoration-success="consitency_of_cement_nabl == 'pass'"
                                        decoration-danger="consitency_of_cement_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr> -->
                        </tbody>
                    </table>

       
                     <!-- Setting Time Start -->
                    <div invisible="not initial_setting_time_visible ">
                        <field name="initial_setting_time_visible" readonly="1" invisible="1" />
                        <h1 class="text-center">
                            <field name="initial_setting_time_name" readonly="1" nolabel="1"   invisible="not initial_setting_time_visible "/>
                        </h1>
                    </div>

                      <div invisible = "initial_setting_time_visible == False">
                        <field name="intial_time_lines">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="lab_id" width="100px"/>
                                <field name="time_water_t1" />
                                <field name="time_needle_t2" />
                                <field name="time_needle_t3" />
                                <field name="initial" />
                                <field name="final" />
                            </tree>
                        </field>
                    </div>

          

                    <!-- <div invisible = "compressive_visible == False" >
                        <h1 class="text-center">
                            <field name="compressive_name" readonly="1" nolabel="1"/>
                            <field name="compressive_visible" invisible="1"/>
                        </h1>
                    </div> -->


                    

                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
    </record>

    </data>
</odoo>