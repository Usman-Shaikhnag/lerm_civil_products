<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_fine_aggregate_ssl" model="ir.ui.view">
        <field name="name">mechanical.fine.aggregate.form</field>
        <field name="model">mechanical.fine.aggregate</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name_aggregate" readonly="1" nolabel="1"/>
                    </h1>
                    <group >
                       <field name="grade"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>
                  
                    <div invisible="sieve_visible == False" >
                        <h1 style="text-align: center;">
                            <field name="sieve_analysis_name" readonly="1" nolabel="1"/>
                            <field name="sieve_visible" invisible="1"/>

                        </h1>
                    </div>
                   
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" invisible="not sieve_visible">
                        <tbody>
                            <tr>
                                <td class="w-25"><label for="wt_of_sample"/></td>
                                <td  class="w-25">
                                    <field name="wt_of_sample"/>
                                </td>
                                <td class="w-25"><label for="zone_type"/></td>
                                <td  class="w-25">
                                    <field name="zone_type"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <div invisible="sieve_visible == False">
                        <field name="sieve_analysis_child_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders ">
                                <field class="" name="serial_no" string="Sr.No"/>
                                <field class="" name='sieve_size' string="IS Sieve Size"/>
                                <field class="" name='wt_retained' string="Wt. Retained in gms"/>
                                <field class="" name='percent_retained' string="% Retained"/>
                                <field class="" name='cumulative_retained' context="{'default_cumulative_retained': cumulative_retained}" string="Cum. Retained %"/>
                                <field class="" name='passing_percent' string="Passing %" readonly="1"/>
                                <field class=" oe_center" name='specific_limt' string="Specified Limits"/>
                                
                            </tree>
                        </field>
                    </div>
                    <div invisible="sieve_visible == False">
                        <button string="Calculate" type="object" name="calculate_sieve" class="oe_highlight">
                            <i class="fa fa-calculator"/> Calculate
                        </button>
                    </div>

                <table class="table table-sm o_form_table w-50 table-bordered custom_table_borders mt-2" invisible="not sieve_visible">
                    <tbody>
                        <tr>
                            <td class=""><label for="grading"/></td>
                            <td  class=""><field name="grading"/></td>
                        </tr>
                        <tr>
                            <td class=""><label for="fineness_modulus"/></td>
                            <td  class=""><field name="fineness_modulus"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Soundness Na2So4  -->
                <div invisible="specific_gravity_visible == False">
                    <h1 class="text-center">
                        <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                        <field name="specific_gravity_visible" invisible="1"/>

                    </h1>
                </div>
                <div invisible="specific_gravity_visible == False">
                    <field name="specific_gravity_child_lines" nolabel="1"  style="width:100%" >
                        <tree editable="bottom"  class="custom_table_borders">
                            <field name="serial_no"/>
                            <field name="wt_of_staurated_a"/>
                            <field name="wt_of_pycnometer_b" />
                            <field name="wt_of_pycnometer_c"/>
                            <field name="wt_of_oven_d"/>
                        </tree>
                    </field>
                
                </div>
                        <!-- Left-side table for A, B, C, D -->
                <div style="display: flex; gap: 20px;" invisible="not specific_gravity_visible">
                    <!-- Left table -->
                    <table class="table table-sm o_form_table table-bordered custom_table_borders w-50">
                        <tbody>
                            <tr>
                                <td><label for="avg_staurated_a">Wt of Saturated surface dry Aggregate in Air: (A)</label></td>
                                <td><field name="avg_staurated_a"/></td>
                            </tr>
                            <tr>
                                <td><label for="avg_pycnometer_b">Wt of Pycnometer containing sample and Water: (B)</label></td>
                                <td><field name="avg_pycnometer_b"/></td>
                            </tr>
                            <tr>
                                <td><label for="avg_pycnometer_c">Wt of Pycnometer containing Water: (C)</label></td>
                                <td><field name="avg_pycnometer_c"/></td>
                            </tr>
                            <tr>
                                <td><label for="avg_oven_d">Wt of Oven Dried Aggregate: (D)</label></td>
                                <td><field name="avg_oven_d"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Right table -->
                    <table class="table table-sm o_form_table table-bordered custom_table_borders w-50">
                        <tbody>
                            <tr>
                                <td><label for="specific_gravity">Avg Specific Gravity</label></td>
                                <td><field name="specific_gravity"/>  <span><field name="specific_gravity_unit" readonly="1" nolabel="1"/></span></td>
                            </tr>
                            <tr>
                                <td><label for="water_absorption">Water Absorption %</label></td>
                                <td><field name="water_absorption" nolabel="1"/></td>
                            </tr>
                            <tr>
                                <td><label for="specific_gravity_conformity">Specific Gravity Conformity</label></td>
                                <td>
                                    <field name="specific_gravity_conformity"
                                        decoration-success="specific_gravity_conformity == 'pass'"
                                        decoration-danger="specific_gravity_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="specific_gravity_nabl">Specific Gravity NABL</label></td>
                                <td>
                                    <field name="specific_gravity_nabl" readonly="1"
                                        decoration-success="specific_gravity_nabl == 'pass'"
                                        decoration-danger="specific_gravity_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- loose_bulk_visible -->

                     <div invisible="loose_bulk_visible == False">
                        <h1 class="text-center">
                            <field name="loose_bulk_name" readonly="1" nolabel="1"/>
                            <field name="loose_bulk_visible" invisible="1"/>
                        </h1>
                    </div>
                   
                   
                   

                    <!-- <group invisible = "loose_bulk_visible == False" style="white-space: nowrap; width:50%;" >
                        <field name="weight_bucket" />
                        <field name="empty_bucket" />
                        <field name="bucket_compact"  />
                        <field name="bucket_loos"   />
                        <field name="loose_bulk_density" />
                          <field name="compact_bulk_density" />
                    </group> -->
              
                   <table class="table table-sm table-bordered custom_table_borders" invisible="not loose_bulk_visible" style="white-space:nowrap;">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Sample 1</th>
                                <th>Sample 2</th>
                                <!-- <th>Result</th> -->
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="fw-bold"> Volume of measuring cylinder (v) (lit)</span></td>
                                <td><field name="volume_of_cylender"/></td>
                                <td><field name="volume_of_cylender1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Wt of empty measuring cylinder (A) (Kg)</span></td>
                                <td><field name="weight_empty_cylender"/></td>
                                <td><field name="weight_empty_cylender1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Wt of loose aggregrage +measuring cylinder(B) (Kg)</span></td>
                                <td><field name="loose_measuring_cylender"/></td>
                                <td><field name="loose_measuring_cylender1"/></td>
                            </tr>

                             <tr>
                                <td><span class="fw-bold">Loose Bulk Density (Kg)</span></td>
                                <td><field name="loose_bulk_density"/></td>
                                <td><field name="loose_bulk_density1"/></td>
                            </tr>

                           

                           
                        </tbody>
                    </table>

                     <div class="d-flex gap-2" invisible="not loose_bulk_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_bulk_density">Avg loose density Kg/lit</label> </td>
                                    <td><field name="avg_bulk_density"/>  <span><field name="bulk_density_unit" readonly="1" nolabel="1"/></span></td>
                                </tr>
                              
                            </tbody>
                        </table>
                        
                       
                    </div>
                            <table invisible="loose_bulk_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                                <tbody>
                                  
                                    <tr>
                                        <td><label class="fw-bold" for="loose_bulk_density_conformity"/></td>
                                        <td><field name="loose_bulk_density_conformity" 
                                                            decoration-success="loose_bulk_density_conformity == 'pass'" 
                                                            decoration-danger="loose_bulk_density_conformity == 'fail'" 
                                                            readonly="1"/></td>
                                    </tr>
                                    <tr>
                                        <td><label class="fw-bold" for="loose_bulk_density_nabl"/></td>
                                        <td><field name="loose_bulk_density_nabl" 
                                                            decoration-success="loose_bulk_density_nabl == 'pass'" 
                                                            decoration-danger="loose_bulk_density_nabl == 'fail'" 
                                                            readonly="1"/></td>
                                    </tr>
                                </tbody>
                            </table>

                             <div class="text-center" invisible="compacted_density_visible == False">
                        <h1>
                            <field name="compacted_density_name1" readonly="1" nolabel="1"/>
                            <field name="compacted_density_visible" invisible="1"/>

                        </h1>
                    </div>
                    
                    <!-- Main Table: Specific Gravity Measurements -->
                    <table class="table table-sm table-bordered custom_table_borders" invisible="not compacted_density_visible" style="white-space:nowrap;">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Sample 1</th>
                                <th>Sample 2</th>
                                <!-- <th>Result</th> -->
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="fw-bold"> Wt of compacted aggregrage +measuring cylinder(C) (Kg)</span></td>
                                <td><field name="wt_of_compact"/></td>
                                <td><field name="wt_of_compact1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Compacted bulk density (Kg)</span></td>
                                <td><field name="compact_bulk"/></td>
                                <td><field name="compact_bulk1"/></td>
                            </tr>
                           
                           

                           
                        </tbody>
                    </table>

                    <div class="d-flex gap-2" invisible="not compacted_density_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_compacted">Avg Compacted Density </label></td>
                                    <td><field name="avg_compacted"/>  <span><field name="avg_compacted_unit" readonly="1" nolabel="1"/></span></td>
                                </tr>
                              
                            </tbody>
                        </table>
                        
                       
                    </div>


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="compacted_density_visible == False">
                            <tbody>
                                <tr>
                                <td><label for="avg_compacted_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_compacted_conformity"
                                        decoration-success="avg_compacted_conformity == 'pass'"
                                        decoration-danger="avg_compacted_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="avg_compacted_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_compacted_nabl" readonly="1"
                                        decoration-success="avg_compacted_nabl == 'pass'"
                                        decoration-danger="avg_compacted_nabl == 'fail'"/>
                                </td>
                            </tr>
                            </tbody>
                        </table>


                    <!-- Bulking of Sand -->
                    <div invisible = "bulking_sand_visible == False">
                        <h1 class="text-center">
                            <field name="bulking_sand_name" readonly="1"/>
                            <field name="bulking_sand_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible="bulking_sand_visible == False">
                        <field name="bulking_sand_child_lines"  style="width:100%" nolabel="1">
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="height_of_sand"/>
                                <field name="height_of_settled"/>
                                <field name="loss_off_height"/>
                                <!-- <field name="bulking_of_sand"/> -->
                            </tree>
                        </field>
                   
                    </div>

                    <!-- <group invisible = "bulking_sand_visible == False" string="Result" colspan="4"  style="white-space: nowrap; width:70%; margin-top: 10px">
                     
                        <field name="avg_height_sand_a" readonly="1"/>
                        <field name="avg_height_sattled_b" readonly="1"/>
                        <field name="avg_loss_c" readonly="1"/>
                  
                    </group> -->
               <table invisible="bulking_sand_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                    <tbody>
                        <tr>
                            <td><label class="fw-bold" for="avg_height_sand_a">Height of Sand in Cylinder (A)</label></td>
                            <td><field name="avg_height_sand_a"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_height_sattled_b">Height of Settled Sand (B)</label></td>
                            <td><field name="avg_height_sattled_b"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_loss_c">Loss of Height of Sand (A - B)</label></td>
                            <td><field name="avg_loss_c"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_bulking_of_sand">Average Bulking of Sand </label></td>
                            <td><field name="avg_bulking_of_sand"/>  <span><field name="avg_bulking_of_sand_unit" readonly="1" nolabel="1"/></span></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_bulking_of_sand_conformity">Bulking Conformity</label></td>
                            <td>
                                <field name="avg_bulking_of_sand_conformity"
                                    decoration-success="avg_bulking_of_sand_conformity == 'pass'"
                                    decoration-danger="avg_bulking_of_sand_conformity == 'fail'"
                                    readonly="1"/>
                            </td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_bulking_of_sand_nabl">Bulking NABL</label></td>
                            <td><field name="avg_bulking_of_sand_nabl"
                                        decoration-success="avg_bulking_of_sand_nabl == 'pass'"
                                    decoration-danger="avg_bulking_of_sand_nabl == 'fail'"
                                    readonly="1"/></td>
                        </tr>
                    </tbody>
                </table>

                    <!-- site_content_visible -->
                <div invisible = "site_content_visible == False">
                    <h1 class="text-center">
                        <field name="site_content_name" readonly="1" nolabel="1"/>
                        <field name="site_content_visible" invisible="1"/>

                    </h1>
                </div>

                <div invisible = "site_content_visible == False">
                    <field name="site_content_child_lines"  nolabel="1" >
                        <tree editable="bottom"  class="custom_table_borders">
                            <field name="serial_no"/>
                            <field name="heigh_sand_silt"/>
                            <field name="height_of_sand" />
                            <field name="height_silt"/>
                            <!-- <field name="bulking_of_sand1"/> -->
                        </tree>
                    </field>   
                </div>

                    <table invisible="site_content_visible == False or loose_bulk_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="content_height_sand_a">Height of Sand + Silt in the Cylinder (A)</label></td>
                                <td><field name="content_height_sand_a" /></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="content_height_sand_b">Height of Sand (B)</label></td>
                                <td><field name="content_height_sand_b" /></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="content_slit_c">Height of Silt (A - B)</label></td>
                                <td><field name="content_slit_c" /></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_bulking_of_sand1">Silt Content</label></td>
                                <td>
                                    <!-- <div class="d-flex"> -->
                                        <field name="avg_bulking_of_sand1" />   <span><field name="silt_contect_unit" readonly="1" nolabel="1"/></span>
                                      
                                    <!-- </div> -->
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_bulking_of_sand1_conformity">Silt Content Conformity</label></td>
                                <td>
                                    <field name="avg_bulking_of_sand1_conformity"
                                        decoration-success="avg_bulking_of_sand1_conformity == 'pass'"
                                        decoration-danger="avg_bulking_of_sand1_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_bulking_of_sand1_nabl">Silt Content NABL</label></td>
                                <td><field name="avg_bulking_of_sand1_nabl"
                                        decoration-success="avg_bulking_of_sand1_nabl == 'pass'"
                                        decoration-danger="avg_bulking_of_sand1_nabl == 'fail'" 
                                        readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>

                     <!-- Moisture Content -->
                    <div invisible = "moisture_content_visible == False">
                        <h1 class="text-center">
                            <field name="moisture_content_name1" readonly="1" nolabel="1"/>
                            <field name="moisture_content_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible = "moisture_content_visible == False">
                        <field name="moisture_content_child_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="wt_sand"/>
                                <field name="wt_dry" />
                                <field name="diff_wet_sand"/>
                                <!-- <field name="moisture_content"/> -->
                            </tree>
                        </field>
                    </div>

                      <table invisible="moisture_content_visible == False or loose_bulk_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="wet_dry">Weight of Wet Sand Sample (W1)</label></td>
                                <td><field name="wet_dry" nolabel="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="wet_sand">Weight of Dry Sand Sample (W2)</label></td>
                                <td><field name="wet_sand" nolabel="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="diff_wd">Diff. Between Wet and Dry Sand (W1 - W2)</label></td>
                                <td><field name="diff_wd" nolabel="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_moisture">Average Moisture Content</label></td>
                                <td>
                                    <!-- <div class="d-flex"> -->
                                        <field name="avg_moisture" nolabel="1"/>    <span><field name="avg_moisture_unit" readonly="1" nolabel="1"/></span>
                                       
                                    <!-- </div> -->
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_moisture_conformity">Moisture Content Conformity</label></td>
                                <td>
                                    <field name="avg_moisture_conformity"
                                        decoration-success="avg_moisture_conformity == 'pass'"
                                        decoration-danger="avg_moisture_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_moisture_nabl">Moisture Content NABL</label></td>
                                <td><field name="avg_moisture_nabl" 
                                            decoration-success="avg_moisture_nabl == 'pass'"
                                            decoration-danger="avg_moisture_nabl == 'fail'" readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>