<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="fine_agg_datasheet_ssl">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
        
                <div style="text-align:center;font-size:18px;font-weight: bold">
                 Fine Aggregate DataSheet 
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>

                          <tr style="height:50px" cols="12">
								<td colspan="4">Performed By :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.technician.name"/>
								</td>
								<td colspan="4">Witness Name :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.witness_name"/>
								</td>
								<td colspan="4">Witness Signature :
									<![CDATA[&nbsp;]]>
									<span style='padding:20px'></span>
								</td>
							</tr>
                    </table>

                    <!-- Sieve Analysis  -->
                    <div t-if="data.sieve_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                            Sieve Analysis
                            <!-- added -->
                            <span>
                                    <t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','318d72a1-7188-4086-b132-62b50e63f5d1')]).parameter_table" t-as="parameter">
                                        <t t-if="parameter.grade.id == eln.grade_id.id">
                                            <span t-field="parameter.specification"/>
                                        </t>
                                    </t>
                            </span>
                        </div>
                        <table>
                            <tr cols="12">
                                <td colspan="2">Sr No.
                                </td>
                                <td colspan="2">IS Sieve Size
                                </td>
                                <td colspan="2">Wt. Retained in gms
                                </td>
                                <td colspan="2">% Retained
                                </td>
                                <td colspan="2">Cum. Retained %
                                </td>
                                <td colspan="2">Passing %
                                </td>
                                <td colspan="2">Specified Limits
                                </td>


                            </tr>

                            <t t-set="k" t-value="0"/>
                            <tr t-foreach="data.sieve_analysis_child_lines" t-as="r">
                                <td colspan="2">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <span t-esc="r['sieve_size']"/>
                                </td>
                                <td colspan="2">
                                    <span t-esc="r['wt_retained']"/>
                                </td>
                                <td colspan="2">
                                    <span t-esc="r['percent_retained']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td colspan="2">
                                    <span t-esc="r['cumulative_retained']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td colspan="2">
                                    <span t-esc="r['passing_percent']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td colspan="2">
                                    <span t-esc="r['specific_limt']" />
                                </td>
                            </tr>
                        </table>
                        
                        <!-- added -->
                        <table style="margin-top:20px">
                            <tr cols="12">
                                 <td colspan="6">Grading Zone :
                                    <![CDATA[&nbsp;]]>
                                </td>
                                <td colspan="6">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.grading"/>
                                </td>
                            </tr>
                        </table> 
                        
                       <table style="margin-top:20px">
                            <tr cols="12">
                                <td colspan="6">Fineness Modulus :
                                                                                                            <![CDATA[&nbsp;]]>
                                </td>
                                <td colspan="6">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.fineness_modulus"/>
                                </td>
                            </tr>
                        </table> 
                    </div>

                       <!-- Dimension  -->
                    
                    <div t-if="data.specific_gravity_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','45875ght-7188-4086-b132-62b50e63f1245gt')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','45875ght-7188-4086-b132-62b50e63f1245gt')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
                    <table style="margin-top:20px">
					<thead >
						<tr cols="12">
							<td >Sr no 
							</td>

							<td  style="text-align:center;">Wt of Saturated surface dry  Aggregate in Air:- (A)
							</td>

                            <td  style="text-align:center;">Wt of Pycnometer containing sample and Water:- (B)

							</td>
                          
                            <td  style="text-align:center;">Wt of Pycnometer containing Water:- (C)
							</td>

                            <td  style="text-align:center;">Wt of Oven Dried Aggregate :- ( D )
							</td>

                         
						</tr>
						
						</thead>
						  <tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.specific_gravity_child_lines" t-as="r">
							<td >
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td >
								<span t-esc="r['wt_of_staurated_a']" />
							</td>
                            <td >
								<span t-esc="r['wt_of_pycnometer_b']" />
							</td>
                            <td >
								<span t-esc="r['wt_of_pycnometer_c']" />
							</td>
                            <td >
								<span t-esc="r['wt_of_oven_d']" />
							</td>

                           

							
						</tr>
						</tbody>
					</table>

                    <table style="margin-top:5px">
                            <tr cols="12">
                                <td colspan="6"><b>Avg Specific Gravity:</b></td>
                                <td colspan="6" style="text-align: center;">
                                    <span t-field="data.specific_gravity" t-options='{"widget": "float", "precision": 1}'/>
                                </td>
                            </tr>
                            <tr cols="12">
                                <td colspan="6"><b>Avg Water Absorption:</b></td>
                                <td colspan="6" style="text-align: center;">
                                    <span t-field="data.water_absorption" t-options='{"widget": "float", "precision": 3}'/>
                                </td>
                            </tr>
                          
                        </table>

                       
                    </div>



                    <!--density  -->
                    
                <div t-if="data.loose_bulk_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','4587tyhloos-3fa3-4b83-ae31-9d281767188c')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','4587tyhloos-3fa3-4b83-ae31-9d281767188c')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
                   
                  
                       <table class="table table-sm table-bordered custom_table_borders" invisible="not loose_bulk_visible" style="white-space:nowrap;">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Sample 1</th>
                                <th>Sample 2</th>
                                <!-- <th>Result</th> -->
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="fw-bold"> Volume of measuring cylinder (v) (lit)</span></td>
                                
								<td><span t-field="data.volume_of_cylender"/></td>
								<td><span t-field="data.volume_of_cylender1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Wt of empty measuring cylinder (A) (Kg)</span></td>
                                
								<td><span t-field="data.weight_empty_cylender"/></td>
								<td><span t-field="data.weight_empty_cylender1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Wt of loose aggregrage +measuring cylinder(B) (Kg)</span></td>
                               
								<td><span t-field="data.loose_measuring_cylender"/></td>
								<td><span t-field="data.loose_measuring_cylender1"/></td>
                            </tr>

                             <tr>
                                <td><span class="fw-bold">Loose Bulk Density (Kg)</span></td>
                                
								 <td><span t-field="data.loose_bulk_density"/></td>
								  <td><span t-field="data.loose_bulk_density1"/></td>
                            </tr>

                           

                           
                        </tbody>
                    </table>

                     
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_bulk_density">Avg loose density Kg/lit</label></td>
                                 
									  <td><span t-field="data.avg_bulk_density"/></td>
                                </tr>
                             
                            </tbody>
                        </table>
                    </div>


                    <div t-if="data.compacted_density_visible" style="margin-top: 30px; font-family: Arial, sans-serif;">
					<div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','6987456gg-a310-4015-bc11-28a85c53ac83')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','6987456gg-a310-4015-bc11-28a85c53ac83')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>

				
					<table class="table table-sm table-bordered custom_table_borders" invisible="not compacted_density_visible" style="white-space:nowrap;">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Sample 1</th>
                                <th>Sample 2</th>
                                <!-- <th>Result</th> -->
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="fw-bold"> Wt of compacted aggregrage +measuring cylinder(C) (Kg)</span></td>
                                
								<td><span t-field="data.wt_of_compact"/></td>
								<td><span t-field="data.wt_of_compact1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Compacted bulk density (Kg)</span></td>
                                
								<td><span t-field="data.compact_bulk"/></td>
								<td><span t-field="data.compact_bulk1"/></td>
                            </tr>
                           

                           

                           
                        </tbody>
                    </table>

                     
                       

						 <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_compacted">Avg Compacted Density (Kg)</label></td>
                                 
									  <td><span t-field="data.avg_compacted"/></td>
                                </tr>
                             
                            </tbody>
                        </table>
			

					</div>


                        <!-- 4. Bulking of Sand -->
                    
                    <div t-if="data.bulking_sand_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','45789bhgt25-3fa3-4b83-ae31-9d28176718457')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','45789bhgt25-3fa3-4b83-ae31-9d28176718457')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
                    <table style="margin-top:20px">
					<thead >
						<tr cols="12">
							<td >Sr no 
							</td>

							<td  style="text-align:center;">Height of Sand in Cylinder:- (A)
							</td>

                            <td  style="text-align:center;">Height of Settled Sand:- (B)

							</td>
                          
                            <td  style="text-align:center;">Loss of Height of Sand:- (A-B)
							</td>

                         
						</tr>
						
						</thead>
						  <tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.bulking_sand_child_lines" t-as="r">
							<td >
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td >
								<span t-esc="r['height_of_sand']" />
							</td>
                            <td >
								<span t-esc="r['height_of_settled']" />
							</td>
                            <td >
								<span t-esc="r['loss_off_height']" />
							</td>
                         

							
						</tr>
						</tbody>
					</table>

                    <table style="margin-top:5px">
                            <tr cols="12">
                                <td colspan="6"><b>Average Bulking of Sand (%):</b></td>
                                <td colspan="6" style="text-align: center;">
                                    <span t-field="data.avg_bulking_of_sand" t-options='{"widget": "float", "precision": 1}'/>
                                </td>
                            </tr>
                            
                          
                        </table>

                       
                    </div>




                      <!-- 5. Silt Content-->
                    
                    <div t-if="data.site_content_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','2547ghty124m-3fa3-4b83-ae31-9d281457nhy14')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','2547ghty124m-3fa3-4b83-ae31-9d281457nhy14')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
                    <table style="margin-top:20px">
					<thead >
						<tr cols="12">
							<td >Sr no 
							</td>

							<td  style="text-align:center;">Height of Sand + Silt in the glass Cylinder:- (A)
							</td>

                            <td  style="text-align:center;">Height of Sand:- (B)

							</td>
                          
                            <td  style="text-align:center;">Height of Silt:- (A-B)
							</td>

                         
						
						</tr>
						
						</thead>
						  <tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.site_content_child_lines" t-as="r">
							<td >
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td >
								<span t-esc="r['heigh_sand_silt']" />
							</td>
                            <td >
								<span t-esc="r['height_of_sand']" />
							</td>
                            <td >
								<span t-esc="r['height_silt']" />
							</td>
                           
                         

							
						</tr>
						</tbody>
					</table>

                    <table style="margin-top:5px">
                            <tr cols="12">
                                <td colspan="6"><b>Average Bulking of Sand (%):</b></td>
                                <td colspan="6" style="text-align: center;">
                                    <span t-field="data.avg_bulking_of_sand1" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                            
                          
                        </table>

                       
                    </div>


                     <!-- 6. Moisture Content-->
                    
                    <div t-if="data.moisture_content_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','1457htyu1245-3fa3-4b83-ae31-9d281457457hy')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','1457htyu1245-3fa3-4b83-ae31-9d281457457hy')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
                    <table style="margin-top:20px">
					<thead >
						<tr cols="12">
							<td >Sr no 
							</td>

							<td  style="text-align:center;">Weight of Wet Sand Sample, (W1)

							</td>

                            <td  style="text-align:center;">Weight of Dry Sand Sample, (W2)

							</td>
                          
                            <td  style="text-align:center;">Diff. Between Wet and Dry Sand:- (W1-W2)
							</td>

                        
                           
						
						</tr>
						
						</thead>
						  <tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.moisture_content_child_lines" t-as="r">
							<td >
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td >
								<span t-esc="r['wt_sand']" />
							</td>
                            <td >
								<span t-esc="r['wt_dry']" />
							</td>
                            <td >
								<span t-esc="r['diff_wet_sand']" />
							</td>
                          

							
						</tr>
						</tbody>
					</table>

                    <table style="margin-top:5px">
                            <tr cols="12">
                                <td colspan="6"><b>Average Moisture Content (%):</b></td>
                                <td colspan="6" style="text-align: center;">
                                    <span t-field="data.avg_moisture" t-options='{"widget": "float", "precision": 1}'/>
                                </td>
                            </tr>
                            
                          
                        </table>

                       
                    </div>

     
               
                    
                    <!-- authorizeRowDataSheet -->
                    
                   <div class="authorizeRowDataSheet">
						<div>
                            <div>
                        <b>
                            Tested By 
                        </b>
                        
                    </div>
                    <div style="height: 40px;">
						<!-- <t t-if="eln.sample_id.testedby_signature_required"> -->
							<t t-if="eln.tested_by_signature_datasheet">

								<div t-if="eln.sample_id.filled_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                     </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>
                    
                </div>

            </t>
        </t>
    </template>
    </odoo>