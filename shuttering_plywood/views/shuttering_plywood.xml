<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_shuttering_plywood" model="ir.ui.view">
        <field name="name">mechanical.shuttering.plywood.form</field>
        <field name="model">mechanical.shuttering.plywood</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                   <div >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                         <field name="eln_state" />
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                     <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                   
       



                    <!--  Dimensions -->

                       <group  invisible = "dimensions_shuttering_visible == False">
                        <h1>
                            <field name="dimensions_shuttering_name" readonly="1" nolabel="1"/>
                            <field name="dimensions_shuttering_visible" invisible="1"/>
                        </h1>
                    </group>

               


                        <field name="child_lines_dimensions_shuttering" nolabel="1" class="custom_table_borders" invisible="dimensions_shuttering_visible == False" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='lenght' class="blue-input" decoration-info="lenght != 0"/>
                                <field name='width' class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                <field name='squareness' class="blue-input" decoration-info="squareness != 0"/>
                                   <field name='edge_straightness' class="blue-input" decoration-info="edge_straightness != 0"/>
                              
                
                            </tree>
                           
                         </field> 

                         <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_length"></label></td>
                                    <td><field name="average_length" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_width"></label></td>
                                    <td><field name="average_width"  /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

                     <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_thickness"></label></td>
                                    <td><field name="average_thickness" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_squareness"></label></td>
                                    <td><field name="average_squareness"  /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

                    <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_edge_straightness"></label></td>
                                    <td><field name="average_edge_straightness" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                      

                          
                    </div>


                    <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="length_pecification"></label></td>
                                    <td><field name="length_pecification" class="blue-input" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="width_pecification"></label></td>
                                    <td><field name="width_pecification" class="blue-input" /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

                     <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="thickness_pecification"></label></td>
                                    <td><field name="thickness_pecification" class="blue-input" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="squareness_pecification"></label></td>
                                    <td><field name="squareness_pecification" class="blue-input" /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

                    <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="edge_straightness_pecification"></label></td>
                                    <td><field name="edge_straightness_pecification"  class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                      

                          
                    </div>

                    <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                       <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_length_conformity"></label></td>
                            <td><field name='average_length_conformity'
                               decoration-success="average_length_conformity == 'pass'" 
                               decoration-danger="average_length_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_length_nabl"></label></td>
                            <td><field name='average_length_nabl'
                               decoration-success="average_length_nabl == 'pass'" 
                               decoration-danger="average_length_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>


                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_width_conformity"></label></td>
                            <td><field name='average_width_conformity'
                               decoration-success="average_width_conformity == 'pass'" 
                               decoration-danger="average_width_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_width_nabl"></label></td>
                            <td><field name='average_width_nabl'
                               decoration-success="average_width_nabl == 'pass'" 
                               decoration-danger="average_width_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>

                          
                    </div>


                    <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                      


                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_thickness_conformity"></label></td>
                            <td><field name='average_thickness_conformity'
                               decoration-success="average_thickness_conformity == 'pass'" 
                               decoration-danger="average_thickness_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_thickness_nabl"></label></td>
                            <td><field name='average_thickness_nabl'
                               decoration-success="average_thickness_nabl == 'pass'" 
                               decoration-danger="average_thickness_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>


                           <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_squareness_conformity"></label></td>
                            <td><field name='average_squareness_conformity'
                               decoration-success="average_squareness_conformity == 'pass'" 
                               decoration-danger="average_squareness_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_squareness_nabl"></label></td>
                            <td><field name='average_squareness_nabl'
                               decoration-success="average_squareness_nabl == 'pass'" 
                               decoration-danger="average_squareness_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>

                          
                    </div>


                     <div class="d-flex gap-2" invisible="dimensions_shuttering_visible == False" >
                      


                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_edge_straightness_conformity"></label></td>
                            <td><field name='average_edge_straightness_conformity'
                               decoration-success="average_edge_straightness_conformity == 'pass'" 
                               decoration-danger="average_edge_straightness_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_edge_straightness_nabl"></label></td>
                            <td><field name='average_edge_straightness_nabl'
                               decoration-success="average_edge_straightness_nabl == 'pass'" 
                               decoration-danger="average_edge_straightness_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>


                         
                          
                    </div>

                           
                       

                 
                    
                       <div  invisible="adhesion_plies_visible == False">
                        <h1>
                            <field name="adhesion_plies_name" readonly="1" nolabel="1"/>
                            <field name="adhesion_plies_visible" invisible="1"/>
                        </h1>
                    </div>


                      <div class="d-flex gap-2" invisible="adhesion_plies_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="adhesion_plies"></label></td>
                                    <td><field name="adhesion_plies" class="blue-input" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="adhesion_plies_pecification"></label></td>
                                    <td><field name="adhesion_plies_pecification" class="blue-input" /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

               
                       <!--  Resistance to dry heat-->

                       <div  invisible="resistance_heat_visible == False">
                        <h1>
                            <field name="resistance_heat_name" readonly="1" nolabel="1"/>
                            <field name="resistance_heat_visible" invisible="1"/>
                        </h1>
                    </div>

                     <div class="d-flex gap-2" invisible="resistance_heat_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="resistance_heat"></label></td>
                                    <td><field name="resistance_heat" class="blue-input" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="resistance_heat_pecification"></label></td>
                                    <td><field name="resistance_heat_pecification" class="blue-input" /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

               

                       <!--  Water Resistance Test-->

                       <div invisible="water_resistance_visible == False">
                        <h1>
                            <field name="water_resistance_name" readonly="1" nolabel="1"/>
                            <field name="water_resistance_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div class="d-flex gap-2" invisible="water_resistance_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="water_resistance"></label></td>
                                    <td><field name="water_resistance" class="blue-input" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="water_resistance_pecification"></label></td>
                                    <td><field name="water_resistance_pecification" class="blue-input" /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

               


                     <!--  density -->

                       <div  invisible="density_shuttering_visible == False">
                        <h1>
                            <field name="density_shuttering_name" readonly="1" nolabel="1"/>
                            <field name="density_shuttering_visible" invisible="1"/>
                        </h1>
                    </div>

               


                        <field name="child_lines_density_shuttering" nolabel="1" class="custom_table_borders" invisible="density_shuttering_visible == False">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='lenght' class="blue-input" decoration-info="lenght != 0"/>
                                <field name='width' class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                <field name='initial_weight' class="blue-input" decoration-info="initial_weight != 0"/>
                                   <field name='oven_dry_weight' class="blue-input" decoration-info="oven_dry_weight != 0"/>
                                <field name='density_shuttering'/>
                
                            </tree>
                           
                         </field> 

                          <div class="d-flex gap-2" invisible="density_shuttering_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_density_shuttering"></label></td>
                                    <td><field name="average_density_shuttering"  /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="density_shuttering_pecification"></label></td>
                                    <td><field name="density_shuttering_pecification" class="blue-input" /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

                    <div invisible="not density_shuttering_visible">
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_density_shuttering_conformity"></label></td>
                            <td><field name='average_density_shuttering_conformity'
                               decoration-success="average_density_shuttering_conformity == 'pass'" 
                               decoration-danger="average_density_shuttering_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_density_shuttering_nabl"></label></td>
                            <td><field name='average_density_shuttering_nabl'
                               decoration-success="average_density_shuttering_nabl == 'pass'" 
                               decoration-danger="average_density_shuttering_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div> 

                        <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                           
                      

                

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     


                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>