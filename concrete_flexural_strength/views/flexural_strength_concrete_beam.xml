<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="flexural_strength_concrete_beam_view" model="ir.ui.view">
        <field name="name">mechanical.flexural.strength.concrete.beam.form</field>
        <field name="model">mechanical.flexural.strength.concrete.beam</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <!-- <field name="parameter_id" invisible="1"/> -->
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade"/>
                    </group>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="d-flex gap-2">
                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                    <td><label class="fw-bold" for="date_of_casting"></label></td>
                                    <td><field name="date_of_casting"/></td>
                            </tr>
                             <tr>
                                    <td><label class="fw-bold" for="date_of_testing"></label></td>
                                    <td><field name="date_of_testing"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                    <td><label class="fw-bold" for="age_of_days"></label></td>
                                    <td><field name="age_of_days"/></td>
                            </tr>
                            <tr>
                                    <td><label class="fw-bold" for="age_of_test"></label></td>
                                    <td><field name="age_of_test"/></td>
                            </tr>
                        </tbody>
                    </table>
                      </div>


                    <div class="custom_table_borders" >
                        <field name="child_lines" nolabel="1" >
                        <tree editable="bottom">
                           <field name="sr_no" />
                          <field name="id_mark" class="blue-input" decoration-info="id_mark != 0" width="200"/>
                          <field name="length" class="blue-input" decoration-info="length != 0"/>
                          <field name="depth" class="blue-input" decoration-info="depth != 0"/>
                          <field name="width" class="blue-input" decoration-info="width != 0"/>
                          <field name="wt_of_sample" class="blue-input" decoration-info="wt_of_sample != 0"/>
                          <field name="fracture_distance" class="blue-input" decoration-info="fracture_distance != 0"/>
                          <field name="failure_load" class="blue-input" decoration-info="failure_load != 0"/>
                          <field name="flexural_strength" />
                        </tree>
                        </field>
                    </div>
                    
                       
<!-- 

                    <field name="child_lines" nolabel="1" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='id_mark'/>
                                <field name='length'/>
                                <field name='depth'/>
                                <field name='width'/>
                                <field name='wt_of_sample'/>
                                <field name='fracture_distance'/>
                                <field name='failure_load'/>
                                <field name='flexural_strength'/>
                                
                            </tree>
                    </field> -->



                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                    <td><label class="fw-bold" for="average_flexural_strength">Average</label></td>
                                    <td><field name="average_flexural_strength"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="flexural_strength_conformity"></label></td>
                                <td>
                                    <field name="flexural_strength_conformity"
                                        decoration-success="flexural_strength_conformity == 'pass'"
                                        decoration-danger="flexural_strength_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="flexural_strength_nabl"></label></td>
                                <td><field name="flexural_strength_nabl"
                                            decoration-success="flexural_strength_nabl == 'pass'"
                                            decoration-danger="flexural_strength_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                           
                        </tbody>
                    </table>

                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>
                    
                    
                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>