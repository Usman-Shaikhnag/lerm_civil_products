                                    <td style="text-align: center;">
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span t-esc="length.parameter_name"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <t t-foreach="data.dimension_line_ids.mapped('length')" t-as="val">
                                            <div t-att-style="'text-align:center;' + ('border-bottom:1px solid #000;' if not val_last else '')">
                                                <span t-esc="'%.0f' % val"/>
                                            </div>
                                        </t>
                                    </td>
                                    <td style="text-align: center;">
                                        <div style="text-align:center;">
                                            <span t-field="data.avg_length" t-options='{"widget": "float", "precision": 0}'/>
                                        </div>
                                    </td>
