<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hollow_solid_block_report">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
                <div class="container_eln" style="padding-top:20px;">

                    <div class="" t-foreach="eln" t-as="o">
                        <table style="width:100%; border-collapse: collapse;" border="1">

                            <tr>
                                <td colspan="1">#Project Name/Site Name :</td>
                                <td colspan="3" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="o.srf_id.name_work"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">#Customer Name :</td>
                                <td colspan="1" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
                                        <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">--</t>
                                </td>
                                <td colspan="1">ULR NO:</td>
                                <td colspan="1" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="o.sample_id.ulr_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">Address:</td>
                                <td colspan="1" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="o.srf_id.customer.street"/>
                                    <span t-field="o.srf_id.customer.street2"/>
                                    <span t-field="o.srf_id.customer.city"/>
                                    <span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
                                    <span t-field="o.srf_id.customer.state_id"/>,
                                    <span t-field="o.srf_id.customer.country_id"/>
                                </td>
                                <td colspan="1">Test Report No :</td>
                                <td colspan="1" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="o.sample_id.kes_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">Location of Performance :-</td>
                                <td colspan="1">
                                    <t t-if="o.sample_id.location_name">
                                        <span t-field="o.sample_id.location_name"/>
                                    </t>
                                    <t t-else="">--</t>
                                </td>
                                <td colspan="1">Sample ID :-</td>
                                <td colspan="1">
                                    <t t-if="o.sample_id.client_sample_id">
                                        <span t-field="o.sample_id.client_sample_id"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">Samples Description :-</td>
                                <td colspan="1">
                                    <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
                                        <span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
                                    </t>
                                    <t t-else="">--</t>
                                </td>
                                <td colspan="1">Date of Receipt :-</td>
                                <td colspan="1">
                                    <t t-if="o.sample_id.sample_received_date">
                                        <span t-field="o.sample_id.sample_received_date"/>
                                    </t>
                                    <t t-else="">--</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">#Source of Sample :-</td>
                                <td colspan="1">
                                    <t t-if="o.material.source_sample">
                                        <span t-field="o.material.source_sample"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td colspan="1">Date of Performance of Test :-</td>
                                <td colspan="1">
                                    <t t-if="o.start_date and o.end_date">
                                        <span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">Condition of Sample :-</td>
                                <td colspan="1">
                                </td>
                                <td colspan="1">Date of Report Issue :-</td>
                                <td colspan="1">
                                    <t t-if="o.end_date">
                                        <span t-field="o.end_date"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">Discipline :-</td>
                                <td colspan="1">
                                    <t t-if="o.sample_id.group_id">
                                        <span t-field="o.sample_id.group_id"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td colspan="1">Test Method Followed :-</td>
                                <td colspan="1">
                                    <t t-if="o.material.test_method_adopted">
                                        <span t-field="o.material.test_method_adopted"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">Temperature :-</td>
                                <td colspan="1">
                                    <t t-if="data.hollow_solid_temp is not None">
                                        <span t-field="data.hollow_solid_temp"/>   °C
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td colspan="1">Humidity :-</td>
                                <td colspan="1">
                                    <t t-if="data.hollow_solid_humidity is not None">
                                        <span t-field="data.hollow_solid_humidity"/>   °C
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1">Reference No. :-</td>
                                <td colspan="3">
                                    <t t-if="o.srf_id.client_refrence">
                                        <span t-field="o.srf_id.client_refrence"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                        </table>
                    </div>

                    <div style="">
                        <table style="margin-top:10px;">
                            <t t-set="i" t-value="0"/>
                            <thead>
                                <tr>
                                    <th style="text-align: center;">Sr. No</th>
                                    <th style="text-align: center;">
                                        <span t-esc="eln.material.test_parameter"/>
                                    </th>
                                    <th style="text-align: center;">
                                        <span t-esc="eln.material.result_remark"/>
                                    </th>
                                    <th style="text-align: center;">
                                        <span t-esc="eln.material.unit"/>
                                    </th>
                                    <th style="text-align: center;"><span t-esc="eln.material.specifications"/></th>
                                    <th style="text-align: center;"><span t-esc="eln.material.method_reference"/></th>
                                </tr>
                            </thead>
                            <tbody>

                                <!-- Dimension Length -->

                                <tr t-if="data.length_dimen_visible and (data.avg_measured_length_nabl == 'pass' and nabl or (data.avg_measured_length_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
                                    <t t-set="length" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','916c70fe-57ff-4f2a-9361-41a687b54f85')])"/>

                                    <td style="text-align: center;">
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td>
                                        <span t-esc="length.parameter_name"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-field="data.avg_measured_length" t-options='{"widget": "float", "precision": 3}'/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-esc="length.unit.name"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="length.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="length.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.specification"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>

                                </tr>

                                <!-- Dimension Height -->

                                <tr t-if="data.height_dimen_visible and (data.avg_measured_height_nabl == 'pass' and nabl or (data.avg_measured_height_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
                                    <t t-set="height" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','6c0d4ef6-867f-4e79-baf1-690338654f26')])"/>

                                    <td style="text-align: center;">
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td>
                                        <span t-esc="height.parameter_name"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-field="data.avg_measured_height" t-options='{"widget": "float", "precision": 3}'/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-esc="height.unit.name"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="height.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="height.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.specification"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>

                                </tr>

                                <!-- Dimension Width -->

                                <tr t-if="data.width_dimen_visible and (data.avg_measured_width_nabl == 'pass' and nabl or (data.avg_measured_width_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
                                    <t t-set="width" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','ffa13e28-aab7-400a-9885-22b12783ca07')])"/>

                                    <td style="text-align: center;">
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td>
                                        <span t-esc="width.parameter_name"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-field="data.avg_measured_width" t-options='{"widget": "float", "precision": 3}'/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-esc="width.unit.name"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="width.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="width.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.specification"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>

                                </tr>

                                <!-- Block Density -->

                                <tr t-if="data.block_density_visible and (data.mean_block_density_nabl == 'pass' and nabl or (data.mean_block_density_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
                                    <t t-set="block_density" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','eaea5db1-dda0-4516-a043-322050d93537')])"/>

                                    <td style="text-align: center;">
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td>
                                        <span t-esc="block_density.parameter_name"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-field="data.mean_block_density" t-options='{"widget": "float", "precision": 3}'/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-esc="block_density.unit.name"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="block_density.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="block_density.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.specification"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>

                                </tr>

                                <!-- Compressive Strength -->

                                <tr t-if="data.compressive_strength_visible and (data.compressive_strength_nabl == 'pass' and nabl or (data.compressive_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
                                    <t t-set="compressive_strength" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','692bb4da-26eb-4701-9ad7-b341c974c8e8')])"/>

                                    <td style="text-align: center;">
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td>
                                        <span t-esc="compressive_strength.parameter_name"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-field="data.average_compressive_strength" t-options='{"widget": "float", "precision": 3}'/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-esc="compressive_strength.unit.name"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="compressive_strength.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="compressive_strength.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.specification"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>

                                </tr>

                                <!-- Water Absorption -->

                                <tr t-if="data.water_absorbtion_visible and (data.mean_water_absorption_nabl == 'pass' and nabl or (data.mean_water_absorption_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
                                    <t t-set="water" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','fc4c19c4-3a3a-45f3-a099-f33a4b8e57a9')])"/>

                                    <td style="text-align: center;">
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </td>
                                    <td>
                                        <span t-esc="water.parameter_name"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-field="data.mean_water_absorption" t-options='{"widget": "float", "precision": 3}'/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <span t-esc="water.unit.name"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="water.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span>
                                            <t t-foreach="water.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.specification"/>
                                                </t>
                                            </t>
                                        </span>
                                    </td>

                                </tr>

                            </tbody>
                        </table>
                    </div>

                    <div style="margin-top:0;margin-bottom:0;padding:0; page-break-inside: avoid;">
                        <div style="margin-top:5px; page-break-inside: avoid;" class="noteContainer">
                            <table class="table table-bordered">
                                <tr>
                                    <td style="padding: 5px; font-style: italic; font-size: 12px;">
                                        <t t-if="data.notes_id">
                                            <b>Notes:-</b>

                                            <t t-foreach="data.notes_id" t-as="n">
                                                <span>
                                                    (<t t-esc="n.sr_no"/>) 
                                                    <t t-esc="n.notes"/>
                                                    &#160;&#160;
                                                </span><br/>
                                            </t>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
                            <div>
                                <div>
                                    <b>
                                        Reviewed By
                                    </b>
                                </div>
                                <div style="height: 50px;">
                                    <t t-if="eln.sample_id.checkby_signature_required and eln.sample_id.check_by.employee_id.signature">
                                        <img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')"
                                            style="max-width: 200px; max-height: 45px; margin-top: 1px; z-index: -10;"/>
                                    </t>
                                </div>
                                <div>
                                    <b>
                                        <span t-esc="eln.sample_id.check_by.name"/>
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="eln.sample_id.check_by.job_title"/>)
                                    </b>
                                </div>
                            </div>

                            <div>
                            </div>

                            <div>
                                <div>
                                    <b>
                                        Per pro GEONYMS INDIA PRIVATE LIMITED.
                                    </b>
                                </div>
                                <div style="height: 50px;">
                                    <t t-if="eln.sample_id.approveby_signature_required">
                                        <div t-if="eln.sample_id.approved_by.employee_id.signature">
                                            <img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
                                        </div>
                                    </t>
                                </div>
                                <div>
                                    <b>
                                        <span t-esc="eln.sample_id.approved_by.name"/>
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="eln.sample_id.approved_by.job_title"/>)
                                    </b>
                                </div>
                            </div>
                        </div>
                        <div style="margin-top: 5px; text-align: center;">
                            <p style="font-weight:800;">...... End Of Report......</p>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
