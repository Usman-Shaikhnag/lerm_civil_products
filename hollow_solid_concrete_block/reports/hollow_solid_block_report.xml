<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hollow_solid_block_report">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
                <div class="container_eln" style="padding-top:2px;">

                    <div class="" t-foreach="eln" t-as="o">
                        <table style="width:100%; border-collapse: collapse;" border="1">
 
                            <tr>
                                <td colspan="3">Project Name/Site Name :</td>
                                <td colspan="3" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="o.srf_id.name_work"/>
                                </td>
                                <td colspan="3">Customer Name :</td>
                                <td colspan="2" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
                                        <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.srf_id.client"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align:left;">Address:</td>
                                <td colspan="8" style="font-weight:bold;text-align:left;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="o.srf_id.customer.street"/>
                                    <span t-field="o.srf_id.customer.street2"/>
                                    <span t-field="o.srf_id.customer.city"/>
                                    <span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
                                    <span t-field="o.srf_id.customer.state_id"/>,
                                    <span t-field="o.srf_id.customer.country_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align:left;">Location of Performance :-</td>
                                <td colspan="8" style="font-weight:bold;text-align:left;">
                                    <![CDATA[&nbsp;]]>
                                    <t t-if="o.sample_id.location_name">
                                        <span t-field="o.sample_id.location_name"/>
                                    </t>
                                    <t t-else="">--</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3">SRF ID :</td>
                                <td colspan="3" style="font-weight:bold;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-esc="o.sample_id.srf_id.display_name.split('-')[0]"/>
                                </td>
                                <td colspan="3">Client Sample Id :-</td>
                                <td colspan="2">
                                    <t t-if="o.sample_id.client_sample_id">
                                        <span t-field="o.sample_id.client_sample_id"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align:left;">Samples Description :-</td>
                                <td colspan="8" style="font-weight:bold;text-align:left;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="o.sample_id.sample_description"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="text-align:left;">Reference No. :-</td>
                                <td colspan="3" style="text-align:left;">
                                    <t t-if="o.srf_id.client_refrence">
                                        <span t-field="o.srf_id.client_refrence"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <td colspan="3">Brand:</td>
                                <td colspan="2">
                                    <span t-field="o.sample_id.brand"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3">Source of Sample :-</td>
                                <td colspan="3">
                                    <!-- <t t-if="o.material.source_sample">
                                        <span t-field="o.material.source_sample"/>
                                    </t>
                                    <t t-else="">-</t> -->
                                    <span t-field="o.sample_id.source_of_sample"/>
                                </td>

                                <td colspan="3">Date of Receipt :-</td>
                                <td colspan="2">
                                    <t t-if="o.sample_id.sample_received_date">
                                        <span t-field="o.sample_id.sample_received_date"/>
                                    </t>
                                    <t t-else="">--</t>
                                </td>
                                
                            </tr>
                            <tr>
                                <td colspan="3">Condition of Sample :-</td>
                                <td colspan="3">
                                    <span t-field="o.sample_id.sample_condition"/>
                                </td>
                                <td colspan="3">Date of Performance of Test :-</td>
                                <td colspan="2">
                                    <t t-if="o.start_date and o.end_date">
											
											<span t-field="o.start_date" t-options='{"widget": "date"}'/>
											<span style="display:inline-block; padding:0 3px;">to</span>
											<span t-field="o.end_date" t-options='{"widget": "date"}'/>
										</t>
                                    <t t-else="">-</t>
                                </td>
                                
                            </tr>
                            
                            <tr>
                                <td colspan="3">Discipline :-</td>
                                <td colspan="3">
                                    <t t-if="o.sample_id.group_id">
                                        <span t-field="o.sample_id.group_id"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                                <!-- <td colspan="1">Test Method Followed :-</td>
                                <td colspan="1">
                                    <t t-if="o.material.test_method_adopted">
                                        <span t-field="o.material.test_method_adopted"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td> -->

                                <td colspan="3">Date of Report Issue :-</td>
                                <td colspan="2">
                                    <t t-if="o.end_date">
                                        <span t-field="o.end_date"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                               
                            </tr>


                        </table>
                    </div>

                    <div style="">
                        <table style="margin-top:10px;">
