                    Hollow And Solid Concrete Block
                </div>
                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date:
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>
                        <tr style="height:50px" cols="12">
                            <td colspan="4">Performed By :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.technician.name"/>
                            </td>
                            <td colspan="4">Witness Name :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.witness_description"/>
                            </td>
                            <td colspan="4">Witness Signature :
                                <![CDATA[&nbsp;]]>
                                <span style='padding:20px'></span>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="container_eln pageSeperater" style="margin-top:5px">

                    <!-- Dimension Length -->
                    <div t-if="data.dimension_visible">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;margin-top: 15px">
                            Dimension
                        </div>

                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <thead>
                                <tr style="background-color: #f0f0f0;">
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Sr No.</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Length (mm)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Width (mm)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Height (mm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="k" t-value="0"/>
                                <tr t-foreach="data.dimension_line_ids" t-as="r" style="text-align: center;">
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
                                        <span t-esc="r['length']"/>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
                                        <span t-esc="r['width']"/>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
                                        <span t-esc="r['height']" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr style="font-weight: bold; background-color: #f9f9f9;">
                                <td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Length (mm) :</td>
                                <td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
                                    <span t-field="data.avg_length" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                            <tr style="font-weight: bold; background-color: #f9f9f9;">
                                <td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Height (mm) :</td>
                                <td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
                                    <span t-field="data.avg_height" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                            <tr style="font-weight: bold; background-color: #f9f9f9;">
                                <td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Width (mm) :</td>
                                <td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
                                    <span t-field="data.avg_width" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </table>

                        <t t-set="prepared_by_obj" t-value="env['eln.parameters.result'].sudo().search([('eln_id','=', eln.id), ('parameter.internal_id','=','916c70fe-57ff-4f2a-9361-41a687b54f85')], limit=1).technician"/>
