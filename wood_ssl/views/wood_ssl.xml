<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_wood_ssl_form" model="ir.ui.view">
        <field name="name">mechanical.wood.ssl.form</field>
        <field name="model">mechanical.wood.ssl</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>

                <group >
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <group class="custom_table_borders">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </group>
                    
                  <!-- Plastic Limit -->
                <group invisible = "moisture_content_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="moisture_content_name" readonly="1" nolabel="1"/>
                            <field name="moisture_content_visible" invisible="1"/>

                        </h1>
                </group>
                <group invisible = "moisture_content_visible == False" style="white-space: nowrap; width:100%;">
                    <field name="wood_child_lines" class="custom_table_borders" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='initial_we'/>
                                <field name='oven_dry'/>
                                <field name='per_moisture'/>
                              
                            </tree>
                           
                    </field> 
                </group>

                  <!-- <group invisible = "moisture_content_visible == False" style="white-space: nowrap; width:70%;">
                       <field name='average_moisture'/>
                </group> -->
                <group  invisible = "specific_gravity_visible == False" string="Result"  style="white-space: nowrap; width:70%;">
                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 50%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                          Average Moisture Content

                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="average_moisture" nolabel="1"/>
                                                </div>
                                            </td>
                                            
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </group>
                 
                 <group invisible = "moisture_content_visible == False" >
                       
                        <field  name="moisture_content_conformity"
                                        decoration-success="moisture_content_conformity == 'pass'" 
                                        decoration-danger="moisture_content_conformity == 'fail'" 
                                        readonly="1" />
                        <field  name="moisture_content_nabl" />
                         
                    </group>



                      <!-- Specific Limit -->
                <group invisible = "specific_gravity_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>

                        </h1>
                </group>
                <group invisible = "specific_gravity_visible == False" style="white-space: nowrap; width:100%;">
                    <field name="specific_gravity_child_lines"  class="custom_table_borders">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='length'/>
                                <field name='width'/>
                                <field name='thickness'/>
                                  <field name='volume'/>
                                <field name='oven_dry'/>
                                <field name='specific_gravity'/>
                              
                            </tree>
                           
                    </field> 
                </group>

                  <!-- <group invisible = "specific_gravity_visible == False" style="white-space: nowrap; width:70%;">
                       <field name='average_specific_gravity'/>
                </group> -->
                <group  invisible = "specific_gravity_visible == False" string="Result"  style="white-space: nowrap; width:70%;">
                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 50%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                             Average Specific Gravity

                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="average_specific_gravity" nolabel="1"/>
                                                </div>
                                            </td>
                                            
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </group>
                 
                 <group invisible = "specific_gravity_visible == False">
                       
                        <field  name="specific_gravity_conformity"
                                        decoration-success="specific_gravity_conformity == 'pass'" 
                                        decoration-danger="specific_gravity_conformity == 'fail'" 
                                        readonly="1" />
                        <field  name="specific_gravity_nabl" />
                         
                    </group>
              

                  <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>