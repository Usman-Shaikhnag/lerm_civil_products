                    <div style="display:flex;">
                    <div style="width:50%;">
                          <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                          <tbody>
                           <tr>
                             <td><span>Flexural Breaking Load in Longitudinal Direction, N</span></td>
                              <td><field name='average_flexural_longitudinal' col="1"/></td>
