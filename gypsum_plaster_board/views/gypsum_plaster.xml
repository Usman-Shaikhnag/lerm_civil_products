<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_gupsum_plaster_board1" model="ir.ui.view">
        <field name="name">mechanical.gypsum.plaster.form</field>
        <field name="model">mechanical.gypsum.plaster</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                   <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div class="custom_table_borders" style="margin-top:10px;">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                   
       



                    <!--  density -->

                       <group invisible="not density_visible">
                        <h1>
                            <field name="density_name" readonly="1" nolabel="1"/>
                            <field name="density_visible" invisible="1"/>
                        </h1>
                    </group>

                       <div class="custom_table_borders" invisible="not density_visible">
                        <field name="child_lines_density" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='lenght'/>
                                <field name='width'/>
                                <field name='thickness'/>
                                <field name='initial_weight'/>
                                   <field name='oven_dry_weight'/>
                                <field name='density'/>
                
                            </tree>
                           
                         </field> 
                    </div>
                     <group/>

                     <div style="display:flex;">
                    <div style="width:50%;">
                          <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                          <tbody>
                           <tr>
                             <td><span>Density, g/cm3</span></td>
                              <td><field name='average_density' col="1"/></td>
                           </tr>
                           <tr>
                            <td><span>Requirement, Density</span></td>
                            <td><field name='requirement_density' col="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div>
                      
                      <div style="width:50%;">
                          <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:100%;"> 
                          <tbody>
                           <tr>
                             <td><span>Conformity</span></td>
                              <td><field name='average_density_conformity'
                                       decoration-success="average_density_conformity == 'pass'" 
                                       decoration-danger="average_density_conformity == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field name="average_density_nabl"
                                       decoration-success="average_density_nabl == 'pass'" 
                                       decoration-danger="average_density_nabl == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div>
                      </div>
                      <group/>
                      <group/>

                    <!-- <group invisible="not density_visible"  style="white-space: nowrap; width:70%;">
