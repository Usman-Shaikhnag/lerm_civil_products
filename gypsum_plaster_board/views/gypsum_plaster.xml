<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_gupsum_plaster_board" model="ir.ui.view">
        <field name="name">mechanical.gypsum.plaster.form</field>
        <field name="model">mechanical.gypsum.plaster</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                   <div >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                         <field name="eln_state" />
                        <field name="parameter_id" invisible="1"/>
                    </group>

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>
                   <div class="custom_table_borders">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>


               <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>
                   
       



                    <!--  density -->

                       <div invisible="not density_visible" >
                        <h1>
                            <field name="density_name" readonly="1" nolabel="1"/>
                            <field name="density_visible" invisible="1"/>
                        </h1>
                    </div>

               


                        <field name="child_lines_density" nolabel="1"  class="custom_table_borders" invisible="density_visible == False">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='lenght' class="blue-input" decoration-info="lenght != 0"/>
                                <field name='width' class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                <field name='initial_weight' class="blue-input" decoration-info="initial_weight != 0"/>
                                   <field name='oven_dry_weight' class="blue-input" decoration-info="oven_dry_weight != 0"/>
                                <field name='density'/>
                
                            </tree>
                           
                         </field> 

                          <div class="d-flex gap-2" invisible="density_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_density"></label></td>
                                    <td><field name="average_density" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="requirement_density"></label></td>
                                    <td><field name="requirement_density"  class="blue-input"/></td>
                                </tr>
                              
                            </tbody>
                        </table>
                    </div>

                    <div invisible="not density_visible">
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_density_conformity">Conformity</label></td>
                            <td><field name='average_density_conformity'
                               decoration-success="average_density_conformity == 'pass'" 
                               decoration-danger="average_density_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_density_nabl">NABL</label></td>
                            <td><field name='average_density_nabl'
                               decoration-success="average_density_nabl == 'pass'" 
                               decoration-danger="average_density_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div> 
                           
                       

                    
                    


                          <!-- water absorption-->

                       <div invisible="not water_absorption_visible" >
                        <h1>
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                        </h1>
                    </div>

               


                        <field name="child_lines_water_absorption" nolabel="1"  class="custom_table_borders" invisible="water_absorption_visible == False">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='initial_weight' class="blue-input" decoration-info="initial_weight != 0"/>
                                <field name='oven_dry_weight' class="blue-input" decoration-info="oven_dry_weight != 0"/>
                                <field name='water_absorption'/>
                              
                
                            </tree>
                           
                         </field> 


                         <div class="d-flex gap-2" invisible="water_absorption_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_water_absorption"></label></td>
                                    <td><field name="average_water_absorption" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="requirement_water_absorption"></label></td>
                                    <td><field name="requirement_water_absorption"  class="blue-input"/></td>
                                </tr>
                              
                            </tbody>
                        </table>
                    </div>


                     <div invisible="not water_absorption_visible">
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_water_absorption_conformity">Conformity</label></td>
                            <td><field name='average_water_absorption_conformity'
                               decoration-success="average_water_absorption_conformity == 'pass'" 
                               decoration-danger="average_water_absorption_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_water_absorption_nabl">NABL</label></td>
                            <td><field name='average_water_absorption_nabl'
                               decoration-success="average_water_absorption_nabl == 'pass'" 
                               decoration-danger="average_water_absorption_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div> 
                           
                       

                  

                   


                          <!-- Flexural Breaking Load in Tranverse Direction-->

                       <div invisible="not flexural_tranverse_visible" >
                        <h1>
                            <field name="flexural_tranverse_name" readonly="1" nolabel="1"/>
                            <field name="flexural_tranverse_visible" invisible="1"/>
                        </h1>
                    </div>

               


                        <field name="child_lines_flexural_tranverse" nolabel="1" class="custom_table_borders" invisible="flexural_tranverse_visible == False" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='lenght' class="blue-input" decoration-info="lenght != 0"/>
                                <field name='width' class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                   <field name='flexural_tranverse' class="blue-input" decoration-info="flexural_tranverse != 0"/>
                              
                
                            </tree>
                           
                         </field> 

                           <div class="d-flex gap-2" invisible="flexural_tranverse_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_flexural_tranverse"></label></td>
                                    <td><field name="average_flexural_tranverse" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="requirement_flexural_tranverse"></label></td>
                                    <td><field name="requirement_flexural_tranverse" class="blue-input"/></td>
                                </tr>
                              
                            </tbody>
                        </table>
                    </div>

                      <div invisible="not flexural_tranverse_visible">
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_flexural_tranverse_conformity">Conformity</label></td>
                            <td><field name='average_flexural_tranverse_conformity'
                               decoration-success="average_flexural_tranverse_conformity == 'pass'" 
                               decoration-danger="average_flexural_tranverse_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_flexural_tranverse_nabl">NABL</label></td>
                            <td><field name='average_flexural_tranverse_nabl'
                               decoration-success="average_flexural_tranverse_nabl == 'pass'" 
                               decoration-danger="average_flexural_tranverse_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div> 
                           
                       

                    

                    


                          <!-- Flexural Breaking Load in Longitudinal Direction-->

                       <div invisible="not flexural_longitudinal_visible" >
                        <h1>
                            <field name="flexural_longitudinal_name" readonly="1" nolabel="1"/>
                            <field name="flexural_longitudinal_visible" invisible="1"/>
                        </h1>
                    </div>

               


                        <field name="child_lines_flexural_longitudinal" nolabel="1" class="custom_table_borders" invisible="flexural_longitudinal_visible == False" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='lenght' class="blue-input" decoration-info="lenght != 0"/>
                                <field name='width' class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                   <field name='flexural_longitudinal' class="blue-input" decoration-info="flexural_longitudinal != 0"/>
                              
                
                            </tree>
                           
                         </field> 


                            <div class="d-flex gap-2" invisible="flexural_tranverse_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_flexural_longitudinal"></label></td>
                                    <td><field name="average_flexural_longitudinal" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="requirement_flexural_longitudinal"></label></td>
                                    <td><field name="requirement_flexural_longitudinal" class="blue-input" /></td>
                                </tr>
                              
                            </tbody>
                        </table>
                    </div>


                    <div invisible="not flexural_longitudinal_visible">
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_flexural_longitudinal_conformity">Conformity</label></td>
                            <td><field name='average_flexural_longitudinal_conformity'
                               decoration-success="average_flexural_longitudinal_conformity == 'pass'" 
                               decoration-danger="average_flexural_longitudinal_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_flexural_longitudinal_nabl">NABL</label></td>
                            <td><field name='average_flexural_longitudinal_nabl'
                               decoration-success="average_flexural_longitudinal_nabl == 'pass'" 
                               decoration-danger="average_flexural_longitudinal_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div> 
                           
                       

                   

                   

                        <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>





   




                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     


                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>