                        <tr  t-if="data.flexural_longitudinal_visible and (data.average_flexural_longitudinal_nabl == 'pass' and nabl or (data.average_flexural_longitudinal_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
