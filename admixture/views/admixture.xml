                             <td>pH 2</td>
                             <td>pH 3</td>
                             <td>pH 4</td>
                             <td>pH 5</td>
                           </tr>
                           <tr>
                             <td></td>
                             <td><field  name="ph_a"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ph_b"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ph_c"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ph_d"  colspan="1"  nolabel="1" class="blue-input"/></td>
