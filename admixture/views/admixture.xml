                           </tr>
                         </tbody>
                      </table>
                    </div>

                    <div nvisible="not ph_visible">
                      <table  class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                      <tbody>
                      <tr>
                          <td ><span>Average</span></td>
                          <td style="padding: 8px;"><field name="ph_average"/></td>
                         </tr>
                        <tr>
                          <td><span>Conformity</span></td>
                          <td><field name='ph_average_conformity'
