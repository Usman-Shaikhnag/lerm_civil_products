<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_admixture_view" model="ir.ui.view">
        <field name="name">mechanical.admixture.form</field>
        <field name="model">mechanical.admixture</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group >
                        <h1>
                            <field name="name_admixture" readonly="1" nolabel="1"/>
                        </h1>
                    </group>
                    
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <!-- <group>
                    <group>
                     <field name="room_temp"/>
                    </group>
                    <group>
                     <field name="room_rh"/>
                    </group>
                    </group> -->

                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="admixture_temp"></label>
                                    </td>
                                    <td>
                                        <field name="admixture_temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="admixture_humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="admixture_humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Bleeding Test -->
                    <div invisible=" not bleeding_visible">
                        <h1 class="text-center">
                            <field name="bleeding_name" readonly="1" nolabel="1"/>
                            <field name="bleeding_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="custom_table_borders" invisible="not bleeding_visible">
                        <field name="bleeding_lines_ids" nolabel="1" >
                        <tree editable="bottom">
                        <field name="sample_no" width="200"/>

                          <field name="w1" class="blue-input" decoration-info="w1 != 0" width="200"/>

                          <field name="w2" class="blue-input" decoration-info="w2 != 0" width="200"/>

                          <field name="net_weight" width="200"/>

                          <field name="volume" class="blue-input" decoration-info="volume != 0" width="200"/>

                          <field name="mixing_water" class="blue-input" decoration-info="mixing_water != 0" width="200"/>

                          <field name="bleed_water_ml" class="blue-input" decoration-info="bleed_water_ml != 0" width="200"/>

                          <field name="bleed_water_kg"  width="200"/>

                          <field name="bleeding_percent"  width="200"/>
                        </tree>
                        </field>
                    </div>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not bleeding_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="avg_bleeding_percent">Average Bleeding (%)</label></td>
                                    <td><field name="avg_bleeding_percent"/></td>
                                </tr>
                                <tr>
                            <td><label for="avg_bleeding_percent_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="avg_bleeding_percent_confirmity"
                                        decoration-success="avg_bleeding_percent_confirmity == 'pass'" 
                                        decoration-danger="avg_bleeding_percent_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="avg_bleeding_percent_nabl" class="text-bold">NABL</label></td>
                           <td><field name="avg_bleeding_percent_nabl"
                                        decoration-success="avg_bleeding_percent_nabl == 'pass'" 
                                        decoration-danger="avg_bleeding_percent_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                            </tbody>
                        </table>


                    <!-- Slump Test -->
