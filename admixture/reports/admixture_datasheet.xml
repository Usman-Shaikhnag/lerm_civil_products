									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Bleeding of concrete (%)</th>
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
