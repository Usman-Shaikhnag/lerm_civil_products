<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="flexural_strength_concrete_beam_view" model="ir.ui.view">
        <field name="name">mechanical.concrete.beam.form</field>
        <field name="model">mechanical.concrete.beam</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <!-- <field name="parameter_id"/> -->
                        <field name="grade"/>
                        <field name="eln_state" />
                    </group>

                     <div class="custom_table_borders" style="margin-top: 15px;">
                            <field name="sample_parameters" nolabel="1">
                                <tree>
                                    <field name="parameter_name"/>
                                    <field name="test_method"/>
                                </tree>
                            </field>
                        </div> 

                         <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>
                        
                    <!-- Flexural Strength -->
                    <div invisible=" not flexural_strength_visible">
                        <h1 class="text-center">
                            <field name="flexural_strength_name" readonly="1" nolabel="1"/>
                            <field name="flexural_strength_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not flexural_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="span_length">Span Length</label></td>
                                    <td><field name="span_length" class="blue-input"/><span>  mm</span></td>
                                </tr>
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not flexural_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="flex_size_id">Size</label></td>
                                    <td><field name="flex_size_id" class="blue-input"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not flexural_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="beam_depth">Depth of Specimen</label></td>
                                    <td><field name="beam_depth" class="blue-input"/><span>  mm</span></td>
                                </tr>
                            </tbody>
                        </table> -->
                    </div>

                    <div class="custom_table_borders" invisible="not flexural_strength_visible">
                        <field name="flexural_strength_line_ids" nolabel="1" >
                        <tree editable="bottom">
                        <field name="age" width="200" readonly="id"/>

                          <field name="weight" class="blue-input" decoration-info="weight != 0" width="200"/>

                          <field name="volume" width="200"/>

                          <field name="fail_point" class="blue-input" decoration-info="fail_point != 0" width="200"/>

                          <field name="density" width="200"/>
                          <field name="test_area" width="200"/>

                          <field name="load_kn" class="blue-input" decoration-info="load_kn != 0" width="200"/>

                          <field name="flexural_strength" width="200"/>
                        </tree>
                        </field>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not flexural_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="avg_3_days_flexural">Average 3 Days Flexural Strength</label></td>
                                    <td><field name="avg_3_days_flexural"/><span>  N/mm²</span></td>
                                </tr>
                                <tr>
                            <td><label for="avg_3_days_flexural_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="avg_3_days_flexural_confirmity"
                                        decoration-success="avg_3_days_flexural_confirmity == 'pass'" 
                                        decoration-danger="avg_3_days_flexural_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="avg_3_days_flexural_nabl" class="text-bold">NABL</label></td>
                           <td><field name="avg_3_days_flexural_nabl"
                                        decoration-success="avg_3_days_flexural_nabl == 'pass'" 
                                        decoration-danger="avg_3_days_flexural_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not flexural_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="avg_7_days_flexural">Average 7 Days Flexural Strength</label></td>
                                    <td><field name="avg_7_days_flexural"/><span>  N/mm²</span></td>
                                </tr>
                                <tr>
                            <td><label for="avg_7_days_flexural_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="avg_7_days_flexural_confirmity"
                                        decoration-success="avg_7_days_flexural_confirmity == 'pass'" 
                                        decoration-danger="avg_7_days_flexural_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="avg_7_days_flexural_nabl" class="text-bold">NABL</label></td>
                           <td><field name="avg_7_days_flexural_nabl"
                                        decoration-success="avg_7_days_flexural_nabl == 'pass'" 
                                        decoration-danger="avg_7_days_flexural_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not flexural_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="avg_14_days_flexural">Average 14 Days Flexural Strength</label></td>
                                    <td><field name="avg_14_days_flexural"/><span>  N/mm²</span></td>
                                </tr>
                                <tr>
                            <td><label for="avg_14_days_flexural_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="avg_14_days_flexural_confirmity"
                                        decoration-success="avg_14_days_flexural_confirmity == 'pass'" 
                                        decoration-danger="avg_14_days_flexural_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="avg_14_days_flexural_nabl" class="text-bold">NABL</label></td>
                           <td><field name="avg_14_days_flexural_nabl"
                                        decoration-success="avg_14_days_flexural_nabl == 'pass'" 
                                        decoration-danger="avg_14_days_flexural_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not flexural_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="avg_28_days_flexural">Average 28 Days Flexural Strength</label></td>
                                    <td><field name="avg_28_days_flexural"/><span>  N/mm²</span></td>
                                </tr>
                                <tr>
                            <td><label for="avg_28_days_flexural_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="avg_28_days_flexural_confirmity"
                                        decoration-success="avg_28_days_flexural_confirmity == 'pass'" 
                                        decoration-danger="avg_28_days_flexural_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="avg_28_days_flexural_nabl" class="text-bold">NABL</label></td>
                           <td><field name="avg_28_days_flexural_nabl"
                                        decoration-success="avg_28_days_flexural_nabl == 'pass'" 
                                        decoration-danger="avg_28_days_flexural_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                            </tbody>
                        </table>
                    </div>

                    

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>