<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	
	<template id="lerm_cocncrete_beam_report">

		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">NA</t>
								</td>

                                <!-- <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td> -->
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">NA</t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <!-- <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td> -->
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
									       <span t-field="o.material.lab_name"/> <![CDATA[&nbsp;]]>
											<span t-field="o.sample_id.size_id"/>   
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">NA</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date" t-options='{"widget": "date"}'/>
											<span style="display:inline-block; padding:0 3px;">to</span>
											<span t-field="o.end_date" t-options='{"widget": "date"}'/>
										</t>
									<t t-else="">NA</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.sample_condition">
											<span t-field="o.sample_id.sample_condition"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="3">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<!-- <td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">NA</t>
										</td> -->
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<t t-if="data.temp is not None">
											<span t-field="data.temp"/>   °C
										</t>
									<t t-else="">NA</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="data.humidity is not None">
											<span t-field="data.humidity"/>   °C
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">NA</t>
								</td>
								
							</tr>

							</table>
					</div>


					<div style="">
						<table style="margin-top:10px;">
						<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">Sr. No</th>
									<th style="text-align: center;">
									<span t-esc="eln.material.test_parameter"/>
									<!-- Test Parameter -->
									</th>

                                    <th style="text-align: center;">
									<span t-esc="eln.material.result_remark"/>
									<!-- Test Result -->
									</th>

									<th style="text-align: center;">
									<span t-esc="eln.material.unit"/>
									<!-- Unit -->
									</th>

                                    <th style="text-align: center;"><span t-esc="eln.material.specifications"/></th>

									<th style="text-align: center;"><span t-esc="eln.material.method_reference"/></th>
									
								</tr>
							</thead>
							<tbody>


							<!-- Flexural Strength -->
                            <t t-set="fshow_3days" t-value="data.avg_3_days_flexural_final_report == 'nabl' and nabl or data.avg_3_days_flexural_final_report == 'non_nabl' and not nabl"/>

							<t t-set="fshow_7days" t-value="data.avg_7_days_flexural_final_report == 'nabl' and nabl or data.avg_7_days_flexural_final_report == 'non_nabl' and not nabl"/>

							<t t-set="fshow_14days" t-value="data.avg_14_days_flexural_final_report == 'nabl' and nabl or data.avg_14_days_flexural_final_report == 'non_nabl' and not nabl"/>

							<t t-set="fshow_28days" t-value="data.avg_28_days_flexural_final_report == 'nabl' and nabl or data.avg_28_days_flexural_final_report == 'non_nabl' and not nabl"/>

                            

                            <!-- 🔹 Step 2: Rowspan calculation -->
					      <t t-set="rowspan_count" t-value="1 + int(fshow_3days) + int(fshow_7days) + int(fshow_14days) + int(fshow_28days)"/>

                          <tr t-if="(data.flexural_strength_visible) and (fshow_3days or fshow_7days or fshow_14days or fshow_28days)">

									<t t-set="flexural" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','19edc74f-c7b2-45b6-8696-e97c19e81993')])"/>
									
									<td t-att-rowspan="rowspan_count"  style="text-align: center;vertical-align:middle;">
						                 <span t-esc="i + 1"/>
							             <t t-set="i" t-value="i+1"/>
						            </td>
									<td colspan="5">
										<span t-esc="flexural.parameter_name"/>
									</td>
								</tr>

					
							 <!-- 3 Days -->
                             <tr t-if="data.flexural_strength_visible and fshow_3days">
									<t t-set="threedays" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','ace70b39-15b5-4c58-8d7b-915d978c0a1a')])"/>
									
									<td>
										<span t-esc="threedays.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_3_days_flexural" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="threedays.unit.name"/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<t t-foreach="threedays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="threedays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- 7 Days -->
							<tr t-if="data.flexural_strength_visible and fshow_7days">
									<t t-set="sevendays" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','2fd3a24a-a5e6-4496-a4d3-3f9cc78cac57')])"/>
									
									<td>
										<span t-esc="sevendays.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_7_days_flexural" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="sevendays.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="sevendays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="sevendays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

							<!-- 14 Days -->
							<tr t-if="data.flexural_strength_visible and fshow_14days">
									<t t-set="fourteendays" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','846557b2-3403-4b12-a698-33987d6fb835')])"/>
									
									<td>
										<span t-esc="fourteendays.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_14_days_flexural" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="fourteendays.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="fourteendays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="fourteendays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- 28 Days -->
							<tr t-if="data.flexural_strength_visible and fshow_28days">
									<t t-set="twoeightdays" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','73312b11-7690-40ce-82f1-dfe8a51e57dc')])"/>
									
									<td>
										<span t-esc="twoeightdays.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_28_days_flexural" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="twoeightdays.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="twoeightdays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="twoeightdays.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

							






								
								</tbody>
			              	</table>

		            	</div>
					
                    

								


					

				
				<div style="margin-top:50px" class="noteContainer">
					<table >
						<tr>
							<td style="padding: 5px; font-style: italic; ">

								<b>Notes:-</b>
									<t t-if="data.notes_id">
									<t t-foreach="data.notes_id" t-as="n">
										<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
									</t>
								</t>
							</td>
						</tr>
					</table>
				</div>


				<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<!-- <div style="height:20px">

								</div> -->
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>

				<div style="margin-top: 50px; text-align: center;">
					<p style="border-top: 1px dashed #000; padding-top: 10px;">
						...... End Of Report......
					</p>
				</div>
				
														
				</div>

				
				
			</t>
		</t>
		
</template>
	
</odoo>