<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="lerm_cocncrete_beam_datasheet">
    <t t-call="web.html_container">
	<!-- <t t-call="lerm_civil.data_sheet_header_generaltemplate"> -->
	<t t-call="lerm_civil.mechanical_data_sheet_header">

		<div style="text-align:center;font-size:18px;font-weight: bold">
			Concrete Beam										
		</div>
		<div class="container_eln" style="margin-top:5px">
			<table style="margin-top:20px">
				<tr>
					<td colspan="6">Job No  :  <span t-field="eln.kes_no"></span>
					</td>
					<td colspan="6">Grade  :  <span t-field="data.grade"></span>
					</td>
					
				</tr>
				<tr>
					<td colspan="4">Material: <span t-field="eln.material"></span>
					</td>
					<td colspan="4">Test Start Date  :  <span t-field="eln.start_date"></span>
					</td>
					<td colspan="4">Test End Date   :  <span t-field="eln.end_date"></span>
					</td>
				</tr>
				<tr style="height:50px" cols="12">
					<td colspan="4">Performed By :
						<![CDATA[&nbsp;]]>
						<span t-field="eln.technician.name"/>
					</td>
					<td colspan="4">Witness Name :
						<![CDATA[&nbsp;]]>
						<span t-field="eln.witness_name"/>
					</td>
					<td colspan="4">Witness Signature :
						<![CDATA[&nbsp;]]>
						<span style='padding:20px'></span>
					</td>
				</tr>
			</table>
			
                <!-- Flexural Strength -->

					<div  t-if="data.flexural_strength_visible">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;margin-top: 15px">
							Flexural Strength
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Age Of Beam.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight (Kg)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Volume (cm³)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Failure At Point</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Density (g/cc)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Test Area (mm²)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Load Observed (kN)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Flexural Strength (N/mm²)</th>
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.flexural_strength_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['age']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['weight']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['volume']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['fail_point']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['density']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['test_area']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['load_kn']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['flexural_strength']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average 3 Days Flexural Strength :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_3_days_flexural" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average 7 Days Flexural Strength :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_7_days_flexural" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average 14 Days Flexural Strength :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_14_days_flexural" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average 28 Days Flexural Strength :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_28_days_flexural" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
						</table>

						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								<!-- <div style="height: 40px;">
							<t t-if="eln.tested_by_signature_datasheet">

								<div t-if="eln.sample_id.filled_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div> -->
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<!-- <div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div> -->
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
					</div>

            
				<!-- authorizeRowDataSheet -->
				
			<div class="authorizeRowDataSheet">
				<div>
					<div>
						<b>
							Tested By 
						</b>
						
					</div>
					 <div style="height: 40px;">
						<!-- <t t-if="eln.sample_id.testedby_signature_required"> -->
								<t t-if="eln.tested_by_signature_datasheet">

									<div t-if="eln.sample_id.filled_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
					<div>
						<b>
						<span t-esc="eln.sample_id.check_by.name"/>
						</b>
					</div>
					
					 <div>
						<b>
							(<span t-esc="eln.sample_id.check_by.job_title"/>)
						</b>
					</div>
				</div>
			</div>

		</div>

	</t>
</t>
</template>
</odoo>