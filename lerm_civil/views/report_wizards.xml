<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sample_reports_wizard" model="ir.ui.view">
        <field name="name">sample.reports.wizard.form</field>
        <field name="model">sample.reports.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Reports">
                <group>
                    <field name="customer"/>
                    <field name="from_date"/>
                    <field name="to_date"/>
                    <field name="state"/>
                </group>
                <footer>
                    <button name="print_srf_reports" string="Print" type="object" class="btn-primary"/>
                    <button name="action_view_samples" string="View Samples" type="object"/>
                    <button name="discard_print" string="Discard" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ulr_reports_wizard" model="ir.ui.view">
        <field name="name">ulr.reports.wizard.form</field>
        <field name="model">ulr.reports.wizard</field>
        <field name="arch" type="xml">
            <form string="ULR Reports">
                <group>
                    <field name="ulr"/>
                </group>
                <footer>
                    <button name="print_ulr_reports" string="Print" type="object" class="btn-primary"/>
                    <button name="discard_print" string="Discard" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="print_reports_wizard" model="ir.ui.view">
        <field name="name">print.reports.wizard.form</field>
        <field name="model">print.reports.wizard</field>
        <field name="arch" type="xml">
            <form string="Sample Print Reports">
                <group>
                    <field name="kes_no"/>
                </group>
                <footer>
                    <button name="print_nabl_report" string="Print NABL Report" type="object" class="btn-primary"/>
                    <button name="print_non_nabl_report" string="Print Non-NABL Report" type="object" class="btn-primary"/>
                    <button name="print_datasheet" string="Print Datasheet" type="object"/>
                    <button name="discard_print" string="Discard" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
