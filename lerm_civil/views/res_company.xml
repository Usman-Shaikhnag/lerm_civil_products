<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


        <record id="product_pricelist_inherited_items_lerm" model="ir.ui.view">
            <field name="name">product.pricelist.item.inherited.lerm</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='min_quantity']" position="after">
                    <field name="parameter_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <record id="product_pricelist_inherited_comment_lerm" model="ir.ui.view">
            <field name="name">product.pricelist.inherited.lerm</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price']" position="after">
                    <field name="parameter_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="res_company_lab_view_form">
            <field name="name">res.company.lab.inherited</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='currency_id']" position="after">
                    <!-- <field name="lab_location" />
                    <field name="lab_certificate_no" /> -->
                    <!-- <field name="non_nabl" /> -->
                </xpath>
                <!-- <xpath expr="//field[@name='lab_certificate_no']" position="after">
                   
                    <field name="non_nabl" />
                </xpath>
                -->

                <xpath expr="//notebook" position="inside">
                    <page string="Labs" name="labs_tab">
                        <field name="lab_ids">
                            <tree>
                                <field name="lab_name"/>
                                <field name="lab_location"/>
                                <field name="lab_certificate_no"/>
                            </tree>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

        <record id="lerm_account_move_inherited_form" model="ir.ui.view">
            <field name="name">account.move.inherited.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
                    <field name="product_tmpl_id" column_invisible="True"/>
                    <field name="parameters" widget="many2many_tags" options="{'no_create': True}" domain="[('material', '=', product_tmpl_id)]"/>
                    <field name="report_no1"   widget="many2many_tags" options="{'no_create': True}" />
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="after">
                    <field name="product_tmpl_id" column_invisible="True"/>
                    <field name="report_no1"  widget="many2many_tags" options="{'no_create': True}" />
                </xpath>
            </field>
        </record>


</data>
</odoo>