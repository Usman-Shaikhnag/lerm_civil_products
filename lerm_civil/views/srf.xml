<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="srf_form_id" model="ir.actions.act_window">
        <field name="name">SRF</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lerm.civil.srf</field>
        <field name="view_mode">tree,kanban,form,graph</field>
        <!-- <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Test Method</p>
        </field> -->
    </record>
    <!-- <menuitem id="srf_form" groups="kes_hod_access_group,kes_admin_access_group,lerm_civil.kes_access_srf" name="SRF" parent="lerm_transaction_data" action="srf_form_id" sequence="10" /> -->
    <menuitem id="srf_form" 
        name="SRF" 
        parent="lerm_transaction_data" 
        groups="lerm_civil.lerm_access_create_srf,lerm_civil.lerm_access_confirm_srf,lerm_civil.lerm_access_update_srf,lerm_civil.kes_srf_backdate_creation_group,lerm_civil.lerm_access_delete_srf"
        action="srf_form_id" 
        sequence="10"/>

    <record id="lerm_civil_srf_form" model="ir.ui.view">
        <field name="name">lerm.civil.srf.form</field>
        <field name="model">lerm.civil.srf</field>
        <field name="arch" type="xml">
            <form>
                <header>

                 
                  <button name="action_generate_sample_lab_groups"
                        string="Generate Lab Id "
                        type="object"

                        class="btn-primary"
                        invisible="1"/>


                <button name="action_print_or_report"
                    string="OR Report"
                    type="object"
                    class="btn-primary"
                   />


                   





                    <button name="confirm_srf" class="oe_highlight" type="object" string="Confirm"
                        groups="lerm_civil.lerm_access_confirm_srf"
                        invisible="state in ('2-confirm')"/>

                       



                    <button name="open_edit_srf_header_wizard" class="oe_highlight" type="object" string="Edit SRF"
                        groups="lerm_civil.lerm_access_update_srf"/>

                    <button name="action_srf_sent_mail" type="object" string="Send Mail"/>

                    <field name="state" readonly="1" widget="statusbar"/>

                </header>

                <sheet>
                <field name="is_generated" invisible="1"/>
                    
                    <div class="oe_button_box" name="button_box"
                        invisible='state != "2-confirm"' >
                        <button name="sample_count_button" type="object" class="oe_stat_button" icon="fa-align-justify">
                            <field name="sample_count" string="Samples" widget="statinfo"/>
                        </button>
                        <button name="eln_count_button" type="object" class="oe_stat_button" icon="fa-align-justify">
                            <field name="eln_count" string="ELN" widget="statinfo"/>
                        </button>
                    </div>
                    <group style="width:100%">
                        <group style="width:50%">
                            <field name="srf_id" readonly="1"  string="Order Request No"/>
                            <field name="srf_date" readonly="state == '2-confirm' and date_editable == False" string="OR Date"/>
                            <field name="kes_number" invisible='1'/>
                            <field name="customer" readonly="state == '2-confirm'"/>
                            <field name="contact_person" domain="[('id', 'in', contact_site_ids)]" readonly="state == '2-confirm'"/>
                            <field name="site_address"/>
                            <field name="client_refrence" readonly="state == '2-confirm'"  string="Reference (letter/W.O./Mail)"/>
                            <field name="date_editable" invisible='1'/>
                            <field name="active" invisible='1'/>
                        </group>

                        <group style="width:50%">
                            <field name="name_work" domain="[('id', 'in', name_works)]"  readonly="state == '2-confirm'"/>
                            <field name="client" readonly="state == '2-confirm'" string="End Customer, if any: "/>
                            <field name="contractor" domain="[('id', 'in', contractor_ids)]"/>
                            <field name="report_issued" />
                            <field name="contractor_ids" invisible='1'/>
                            <field name="contact_other_ids" invisible='1'/>
                            <field name="billing_customer" readonly="state == '2-confirm'" string="Name of Billing Customer"/>
                            <field name="name_works" invisible='1'/>
                            <field name="consultant_name1"/>
                            <field name="request_date"/>
                            <field name="lab_id1"  invisible="1"/>
                             <field name="quantity" invisible="1"/>
                               <field name="sample_qty" invisible="1"/>
                               <field name="sample_qty_boolean" invisible="1"/>
                        </group>
                        
                    </group>

                    
                    <group style="width:50%">
                        <field name="contact_site_ids" invisible='1'/>
                        <field name="contact_contact_ids" invisible='1'/>
                    </group>

                    <div class="oe_button_box d-flex gap-2">
                        <button name="open_new_sample_add_wizard" groups="lerm_civil.lerm_access_create_srf" string="New Sample" type="object" class="btn btn-primary mr-2" invisible="state in ('2-confirm')"/>
                        <button name="open_sample_add_wizard" groups="lerm_civil.lerm_access_create_srf" string="Repeat Sample" type="object" class="btn btn-primary" invisible="state in ('2-confirm')"/>
                    </div>
                    

                    <field name="samples"
                                        readonly="1"
                                        context="{'default_customer_id': customer, 'is_local': True}">
                                        <!-- groups="lerm_civil.kes_verified_by,lerm_civil.kes_access_srf" -->
                        
                        <tree>
                           <field name="show_lab_id" column_invisible="1"/>
                            <field name="kes_no" string="Sample No."/>
                            <field name="material_id"/>
                            <field name="discipline_id"/>
                            <field name="lab_no_value" invisible='1'/>
                            <field name="group_id"/>
                            <field name="department_id"/>
                            <field name="parameters" widget="many2many_tags"/>
                            <field name="casting"/>
                            <field name="sample_received_date"/>
                            <field name="sample_description"/>
                            <field name="sample_qty" column_invisible="1"/>
                            <field name="quantity"/>
                            <field name="lab_id" column_invisible="1"/>
                            <!-- <field name="lab_ids_raw"  /> -->
                            <!-- column_invisible="1" -->


                            
                             <!-- <field name="lab_ids_raw"  />
                             <field name="last_generated"  />

                            <button name="action_generate_lab_groups"
                                string="Lab Id"
                                type="object"
                                class="btn-primary"/> -->
                            

                           
                            <button name="open_request_review" string="Request Review" type="object" class="btn btn-primary mr-2"/>
                            <button name="edit_sample" groups="lerm_civil.lerm_access_update_srf" string="Edit" type="object" class="btn-primary"/>
                            <button name="reallocate_sample" string="Reallocate" type="object" groups="lerm_civil.lerm_job_allocation" class="btn-primary"/>
                        </tree>
                    </field>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
                
            </form>
        </field>
    </record>

    <record id="srf_graph_view" model="ir.ui.view">
        <field name="name">lerm.srf.graph</field>
        <field name="model">lerm.civil.srf</field>
        <field name="arch" type="xml">
            <graph>
                <field name="state" type="row"/>
                <!-- <field name="create_date" interval="month" type="col"/> -->
            </graph>
        </field>

    </record>



    <record id="lerm_civil_srf_tree" model="ir.ui.view">
        <field name="name">lerm.civil.srf.tree</field>
        <field name="model">lerm.civil.srf</field>
        <field name="arch" type="xml">
            <tree default_order='create_date desc' >
                <field name="srf_id" string="Order Request No"/>
                <field name="srf_date" optional="show" string="OR Date"/>
                <field name="customer" optional="show"/>
                <field name="contact_person" optional="show"/>
                <field name="billing_customer" optional="show" string="Name of Billing Customer"/>
                <!-- <field name="name_work" optional="show"/> -->
                <field name="client_refrence" optional="show" string="Reference (letter/W.O./Mail)"/>
            </tree>
        </field>
    </record>

    <record id="lerm_civil_srf_search_view" model="ir.ui.view">
    <field name="name">lerm.civil.srf.search.view</field>
    <field name="model">lerm.civil.srf</field>
    <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="srf_id" string="SRF ID" />
                <field name="kes_number" string="SSL NO" />
                <field name="srf_date" string="SRF Date" />
                <field name="job_date" string="JOB Date" />
                <field name="customer" string="Customer" />
                <field name="billing_customer" string="Billing Customer" />
                <field name="contact_person" string="Contact Person" />
                <field name="client" string="Client" />
                <field name="site_address" string="Site Address" />
                <!-- <field name="name_work" string="Name of Work" /> -->
                <field name="client_refrence" string="Client Reference Letter" />
                <field name="state" string="State" />
                <filter string="Draft" name="state_draft" domain="[('state', '=', '1-draft')]" />
                <filter string="Confirm" name="state_confirm" domain="[('state', '=', '2-confirm')]" />
                <field name="sample_count" string="Sample Count" />
                <field name="eln_count" string="ELN Count" />
                <field name="casting" string="Casting" />
                <filter string="Casting" name="casting_true" domain="[('casting', '=', True)]" />
                <filter string="Not Casting" name="casting_false" domain="[('casting', '=', False)]" />
            </search>
        </field>
    </record>
    

    <record id="srf_sample_wizard_form" model="ir.ui.view">
        <field name="name">create.srf.sample.wizard</field>
        <field name="model">create.srf.sample.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="is_update" invisible='1'/>
                        <field name="show_witness" invisible='1'/>
                        <field name="show_days_casting" invisible='1'/>

                        <!-- <field name="show_reject_reason " invisible='1'/> -->
                        <group style="width:50%">
                            <field name="edit_mode" invisible='1'/>
                            <field name="discipline_id" options="{'no_create': True}"/>
                            <field name="lab_no_value" options="{'no_create': True}" invisible='1'/>
                            <field name="material_id" context="{'lab_name': True}" domain="[('id', 'in', material_ids)]" options="{'no_create': True}"/>
                            <field name="brand"/>
                            <field name="grade_id" domain="[('id', 'in', grade_ids)]" options="{'no_create': True}"/>
                            <field name="client_sample_id" invisible="1"/>
                            <field name="source_sample" invisible="1"/>
                            <field name="received_by_id"/>
                            <field name="sample_condition" invisible="1"/>
                            <field name="material_ids" invisible='1'/>
                            <field name="grade_ids" invisible='1'/>
                            <field name="conformity"/>
                            <field name="lab_location"/>
                            <field name="location_name"/>
                            <field name="sample" invisible="is_update != True" readonly="1"/>
                        </group>
                        <group style="width:50%">
                            <field name="group_id" domain="[('id', 'in', group_ids)]" options="{'no_create': True}"/>
                            <field name="department_id" options="{'no_create': True}"/>
                            <field name="product_name" invisible='1'/>
                            <field name="main_name" invisible='1'/>
                            <field name="price" invisible='1'/>
                            <field name="size_id" domain="[('id', 'in', size_ids)]" options="{'no_create': True}"/>
                            <field name="sample_qty" readonly="is_update == True" string="No. of ULR Required"/>
                            <field name="sample_received_date" readonly="1"/>
                            <field name="location"/>
                            <field name="casting"/>
                            <field name="grade_required"/>
                            <field name="group_ids" invisible='1'/>
                            <field name="size_ids" invisible='1'/>
                        </group>
                    </group>
                    <group style="width:100%">
                        <!-- <field name="sample_reject_reason" invisible="show_reject_reason == False" required="show_reject_reason == True"/> -->
                    </group>
                    <group style="width:50%">
                        <field name="has_witness"/>
                        <field name="witness" invisible="show_witness == False"/>
                    </group>
                    <group style="width:50%">
                        <field name="scope" readonly="is_update == True"/>
                    </group>
                    <group style="width:100%">
                        <field name="sample_description" invisible="1"/>
                    </group>
                    
                    <group>
                        <!-- <field name="volume"/> -->
                        <field name="quantity"/>
                    </group>

                     <group>
                        <!-- <field name="volume"/> -->
                        <!-- <field name="lab_id"/> -->
                    </group>

                   
                     

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Sample Quantity</th>
                                <th>Received</th>
                                <th>Consumed</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><field name="uom_id"/></td>
                                <td><field name="quantity_received" readonly="1"/></td>
                                <td><field name="quantity_consumed"/></td>
                                <td><field name="quantity_balance"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <group style="width:50%">
                        <field name="days_casting" string="Days of Testing" invisible="show_days_casting == False"/>
                    </group>
                    <group style="width:50%">
                        <field name="date_casting" invisible="show_days_casting == False"/>
                    </group>
                    <group style="width:50%">
                        <field name="customer_id" invisible='1'/>
                        <field name="available_parameter_ids" invisible='1'/>
                    </group>

                    <group style="width:100%">
                        <field name="parameters" domain="[('id', 'in', available_parameter_ids)]" options="{'no_create': True}">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="add_sample" string="Add Sample" type="object" class="btn-primary" invisible="is_update == True"/>
                    <button name="edit_current_sample" string="Save" type="object" class="btn-primary" invisible="is_update != True"/>
                    <button name="close_sample_wizard" string="Close" type="object"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="open_srf_sample_wizard_action" model="ir.actions.act_window">
        <field name="name">Add Sample</field>
        <field name="res_model">create.srf.sample.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="lerm_civil.srf_sample_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="sample_request_review_form" model="ir.ui.view">
        <field name="name">sample.request.review</field>
        <field name="model">sample.request.review</field>
        <field name="arch" type="xml">
            <form create="false">
                <!-- <field name='sample_id'/> -->
                 <field name="split_done" invisible="1" />
                <group>
                    <group>
                        <field name="receipt_date"/>
                        <field name="disturbes_samples" invisible="1"/>
                        <field name="equipment_availability"/>
                        <field name="resource_availability"/>
                        <field name="test_performed" string="Whether all requested tests can be performed: "/>
                        
                        <field name="material_id" invisible="1"/>
                        <field name="doc_name" invisible="1"/>
                        <field name="completion_date"/>
                        <field name="issue_no" invisible="1"/>
                        <field name="issue_date1" invisible="1"/>
                        <field name="doc_no" invisible="1"/>

                    </group>
                    <group>
                        <field name="lot_detail"/>
                        <field name="undisturbes_samples" invisible="1"/>
                        <field name="equipment_availability_remark"/>
                        <field name="resource_availability_remark"/>
                        <field name="test_performed_remark"/>
                         <field name="lab_id"  invisible="1"/>
                         <field name="quantity" invisible="1"/>
                        

                        <field name="sample_id" invisible="1"/>
                        <field name="parameters" widget="many2many_tags"  invisible="1"/>
                        <field name="group_id"  invisible="1"/>
                        <field name="rev_no"  invisible="1"/>
                        <field name="rev_date1" invisible="1"/>
                        <field name="w_o" />
                        <field name="no_samples" />

                    </group>
                </group>

                <div>
                 <button name="action_split_lab_ids"
                    string="Assign Lab ID"
                    type="object"
                    class="btn-primary"
                    invisible="1"  />

                   

                </div>
                
                <field name="review_line_ids" create="false" delete="false">
                    <tree create="false" editable="bottom" delete="false">
                       <field name="split_done" column_invisible="1" />
                        <field name="lab_id" readonly="1"/>
                        <field name="weight"/>
                        <field name="uom"/>
                        <field name="source"/>
                        <field name="depth"/>
                        <field name="sample_details"/>
                        <field name="packing"/>
                        <field name="quantity"/>
                        <field name="approved"/>
                        <field name="remarks"/>

                         <button name="action_generate_lab_id"
                                string="Show Lab ID"
                                type="object"
                                class="btn-primary"
                                invisible="not approved or split_done"/>

                             
                                
                        


                    </tree>
                </field>
                <footer>


             

            <button name="%(lerm_civil.action_rr_report1)d"
                string="RR Report"
                type="action"
                class="btn-primary"
                icon="fa-print"/>

            <button string="Save"
                class="btn-primary"
                special="save"
                />

            <button string="Close"
                    class="btn-secondary"
                    special="cancel"/>


            </footer>
                
                
            </form>
        </field>
    </record>

    <record id="sample_request_review_tree" model="ir.ui.view">
        <field name="name">sample.request.review.tree</field>
        <field name="model">sample.request.review</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
               <field name="lab_id"/>
                <field name="sample_id"/>
                <field name="receipt_date"/>
                <field name="lot_detail"/>
                <field name="disturbes_samples"/>
                <field name="undisturbes_samples"/>
                <field name="equipment_availability"/>
                <field name="resource_availability"/>
                <field name="test_performed"/>

               

            </tree>
        </field>
    </record>


  
</odoo>