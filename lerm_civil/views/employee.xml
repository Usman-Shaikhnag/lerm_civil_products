<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="lerm_sample_department_rule" model="ir.rule">
            <field name="name">Sample: Department Filter</field>
            <field name="model_id" ref="model_lerm_srf_sample"/>
            <field name="domain_force">['|', ('department_id', '=', False), ('department_id', 'in', user.department_ids.mapped('name'))]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="view_employee_form_inherit" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='personal_information']" position="after">
                    <page name="others" string="Others">
                            <group style="width:50%;margin:20px;">
                                <field name='signature' widget="image" class="oe_avatar" style="height: 50px; width: 200px;"/>
                            </group>
                    </page>
                    
                </xpath>
                <xpath expr="//field[@name='work_email']" position="after">
                    <field name="lab_ids" widget="many2many_tags"/>
                    <field name="company_ids" widget="many2many_tags"/>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="department_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>


   
    </data>
</odoo>
