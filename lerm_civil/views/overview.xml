<odoo>


    <!-- Tree View -->
    <record id="view_lerm_overview_tree" model="ir.ui.view">
        <field name="name">lerm.overview.tree</field>
        <field name="model">lerm.overview</field>
        <field name="arch" type="xml">
            <tree string="Technician Overview">
                <field name="technician_id"/>
                <field name="total_samples" sum="total_samples"/>
                <field name="assignment_pending"/>
                <field name="alloted"/>
                <field name="pending_verification"/>
                <field name="in_report"/>
                <field name="pending_approval"/>
                <field name="cancelled"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_lerm_overview_form" model="ir.ui.view">
        <field name="name">lerm.overview.form</field>
        <field name="model">lerm.overview</field>
        <field name="arch" type="xml">
            <form string="Overview">
                <sheet>
                    <!-- <field name="discipline"/> -->
                    <field name="technician_id"/>
                    <field name="total_samples"/>
                    <field name="assignment_pending"/>
                    <field name="alloted"/>
                    <field name="pending_verification"/>
                    <field name="in_report"/>
                    <field name="pending_approval"/>
                    <field name="cancelled"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="lerm_overview_search_view" model="ir.ui.view">
        <field name="name">lerm.overview.search.view</field>
        <field name="model">lerm.overview</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                        <field name="discipline" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
        
    <!-- Server Action: Generate Overview Data -->
    <record id="server_action_lerm_overview_generate" model="ir.actions.server">
        <field name="name">Generate Overview</field>
        <field name="model_id" ref="model_lerm_overview"/>
        <field name="state">code</field>
        <field name="code">
env['lerm.overview']._generate_overview_records()
action = {
    'name': 'Overview',
    'type': 'ir.actions.act_window',
    'res_model': 'lerm.overview',
    'view_mode': 'tree',
    'target': 'current',
}
        </field>
    </record>

    <!-- Menu Action -->
    <menuitem id="overview_menu"
        name="Overview"
        parent="lerm_root"
        action="server_action_lerm_overview_generate"
        sequence="60"/>


</odoo>
