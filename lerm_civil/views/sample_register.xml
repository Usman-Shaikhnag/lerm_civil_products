<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="lerm_sample_quantity_form" model="ir.ui.view">
            <field name="name">lerm.sample.register.form</field>
            <field name="model">lerm.sample.register</field>
            <field name="arch" type="xml">
                <form>
                    <header>

                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sample" readonly="1"/>
                                <field name="quantity" readonly="1"/>
                                <field name="uom_id" readonly="1"/>
                                <field name="resample_id" readonly="1"/>

                            </group>
                            <group>
                                <field name="quantity_received" readonly="1"/>
                                <field name="quantity_consumed" readonly="1"/>
                                <field name="quantity_balance" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lerm_sample_quantity_tree" model="ir.ui.view">
            <field name="name">lerm.sample.register.tree</field>
            <field name="model">lerm.sample.register</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="sample" />
                    <field name="resample_id" />
                    <field name="quantity" />
                    <field name="uom_id" />
                    <field name="quantity_received" />
                    <field name="quantity_consumed" />
                    <field name="quantity_balance" />
                </tree>
            </field>
        </record>
    </data>
</odoo>