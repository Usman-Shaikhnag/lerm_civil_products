<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="lerm_sample_quantity_form" model="ir.ui.view">
            <field name="name">lerm.sample.register.form</field>
            <field name="model">lerm.sample.register</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button type="object" class="oe_highlight" name="discard_sample" string="Discard Sample"/>
                        <button type="object" class="oe_highlight" name="resample_rec" string="Resample"/>

                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sample" readonly="1"/>
                                <field name="quantity" readonly="1"/>
                                <field name="uom_id" readonly="1"/>
                                <field name="resample_id" readonly="1"/>
                                <field name="quantity" readonly="1"/>
                                <field name="quantity_discarded" readonly="1"/>
                                

                            </group>
                            <group>
                                <field name="quantity_received" readonly="1"/>
                                <field name="quantity_consumed" readonly="1"/>
                                <field name="quantity_balance" readonly="1"/>
                                <field name="discard_reason"/>
                                <field name="attachment" filename="attachment_name"/>
                                <field name="attachment_name" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="lerm_sample_quantity_tree" model="ir.ui.view">
            <field name="name">lerm.sample.register.tree</field>
            <field name="model">lerm.sample.register</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="sample" />
                    <field name="resample_id" />
                    <field name="quantity" />
                    <field name="uom_id" />
                    <field name="quantity_received" />
                    <field name="quantity_consumed" />
                    <field name="quantity_balance" />
                </tree>
            </field>
        </record>


        <record id="discard_sample_quantity" model="ir.ui.view">
            <field name="name">sample.register.discard.form</field>
            <field name="model">sample.register.discard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="discard_reason"/>
                    </group>
                    <group>
                        <group>
                            <field name="discard_date"/>
                            <field name="discard_quantity_unit" readonly="1"/>
                            
                        </group>
                        <group>
                            <field name="discard_quantity"/>
                            <field name="attachment" filename="attachment_name"/>
                            <field name="attachment_name" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button
                                type="object"
                                class="oe_highlight" 
                                name="discard_sample_quantity"
                                string="Discard Quantity"/>
                        <button
                                type="object"
                                name="cancel_sample_discard"
                                string="Cancel"/>
                    </footer>

                </form>
            </field>
        </record>


        <record id="resample_wizard" model="ir.ui.view">
            <field name="name">sample.register.resample.form</field>
            <field name="model">sample.register.resample</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="resample_date"/>
                    </group>
                    <group>
                        <group>
                            <field name="resample_quantity"/>
                            
                        </group>
                        <group>
                            <field name="resample_quantity_unit" readonly="1"/>
                            
                        </group>
                    </group>
                    <footer>
                        <button
                                type="object"
                                class="oe_highlight" 
                                name="action_resample"
                                string="Discard Quantity"/>
                        <button
                                type="object"
                                name="cancel_resample"
                                string="Cancel"/>
                    </footer>

                </form>
            </field>
        </record>
    </data>
</odoo>