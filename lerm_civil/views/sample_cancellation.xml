<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="sample_rejection_wizard" model="ir.ui.view">
            <field name="name">sample.cancellation.wizard.form</field>
            <field name="model">sample.cancellation.wizard</field>
            <field name="arch" type="xml">
                <form string="Cancel Sample">
                    <group>
                        <field name="sample" invisible="1"/>
                        <field name="cancellation_reason" required="1"/>
                        <field name="other_cancellation_reason" invisible="cancellation_reason != 'other'" required="cancellation_reason == 'other'"/>
                    </group>
                    <footer>
                        <button type="object" class="oe_highlight btn-danger" name="cancel_current_sample" string="Confirm Cancellation"/>
                        <button special="cancel" string="Discard" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>