<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="send_mail_wizard" model="ir.ui.view">
        <field name="name">send.mail.wizard.form</field>
        <field name="model">send.mail.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="email_from" required="1"/>
                    <field name="email_to" required="1"/>
                    <field name="email_subject" required="1"/>
                    <field name="email_body" required="1"/>
                    <field name="attachment" filename="attachment_name" required="1"/>
                    <field name="attachment_name" invisible="1"/>



                </group>
                <footer>
                    <button
                            type="object"
                            class="oe_highlight" 
                            name="send_mail"
                            string="Send Mail"/>
                    <button
                            type="object"
                            name="discard_send"
                            string="Cancel"/>
                </footer>

            </form>
        </field>
        </record>
    </data>
</odoo>