    <div style="width:100%;">
    <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:12px;">
        <tr>

            <!-- LOGO -->
            <td style="width:23%; text-align:center; vertical-align:middle;">
                <img t-if="logo_base64"
                     t-att-src="'data:image/png;base64,%s' % logo_base64"
                     style="height:50px;"/>
            </td>

            <!-- COMPANY HEADER -->
            <td style="width:77%; border:1px solid #000; padding:0;">
                <table style="width:100%; border-collapse:collapse; font-size:12px;">

                    <tr>
                        <td colspan="6" style="border:1px solid #000; padding:4px;">
                            <b>GENSTRU CONSULTANTS PVT. LTD</b>
                        </td>
                    </tr>

                    <!-- FIRST REVIEW ONLY FOR HEADER -->
                    <t t-set="first_review"
                       t-value="sample_review_map.get(samples and samples[0].id)"/>

                    <tr>
                        <td style="border:1px solid #000; padding:3px;"><b>Doc. Name</b></td>
                        <td colspan="5" style="border:1px solid #000; padding:3px;">
                            <span t-esc="first_review.doc_name if first_review else ''"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="border:1px solid #000; padding:3px;"><b>Doc. No.</b></td>
                        <td colspan="3" style="border:1px solid #000; padding:3px;">
                            <span t-esc="first_review.doc_no if first_review else ''"/>
                        </td>

                        <td style="border:1px solid #000; padding:3px;"><b>Issue No</b></td>
                        <td style="border:1px solid #000; padding:3px;">
                            <span t-esc="first_review.issue_no if first_review else ''"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="border:1px solid #000; padding:3px;"><b>Rev. No</b></td>
                        <td style="border:1px solid #000; padding:3px;">
                            <span t-esc="first_review.rev_no if first_review else ''"/>
                        </td>

                        <td style="border:1px solid #000; padding:3px;"><b>Rev. Dt</b></td>
                        <td style="border:1px solid #000; padding:3px;">
                            <span t-esc="first_review.rev_date1 if first_review else ''"/>
                        </td>

                        <td style="border:1px solid #000; padding:3px;"><b>Issue Dt</b></td>
                        <td style="border:1px solid #000; padding:3px;">
                            <span t-esc="first_review.issue_date1 if first_review else ''"/>
                        </td>
                    </tr>

                </table>
            </td>

        </tr>
    </table>
</div>
         <table style="width:100%; border-collapse:collapse; font-size:13px;" border="1">

                        <tr>
                            <td style="width:25%;"><b>Order Request No.</b></td>
                            <td style="width:45%;">
                            </td>

                            <td style="width:10%;"><b>Date:</b></td>
                            <td style="width:20%;">
                                <!-- <span t-esc="review.receipt_date"/> -->
                                <span t-esc="first_review.receipt_date if first_review else ''"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>Customer Name &amp; Address:</b></td>
                            <td colspan="3">
                                <span t-field="o.customer.name"/>
                                
										<span t-field="o.customer.street"/>
										<span t-field="o.customer.street2"/>
										<span t-field="o.customer.city"/>
                                        <span t-if="o.customer.zip"> - <span t-field="o.customer.zip"/></span>,
										<span t-field="o.customer.state_id"/> ,
										<span t-field="o.customer.country_id"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>For (End Customer, if any):</b></td>
                            <td colspan="3">
                            </td>
                        </tr>

                        <tr>
                            <td><b>Report to be issued in the name of:</b></td>
                            <td colspan="3">
                            </td>
                        </tr>

                        <tr>
                            <td><b>Contact details of receiver (Phone, Email and address):</b></td>
                            <td colspan="3">
                                <span t-field="o.customer.phone"/>,<span t-field="o.customer.email"/> And <span t-field="o.customer.street"/>
										<span t-field="o.customer.street2"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>Project Name:</b></td>
                            <td colspan="3">
                                <span t-field="o.name_work"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>Sample Received on:</b></td>
                            <td colspan="3">
                                <span t-field="o.srf_date"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>Lot Details:</b></td>
                            <td colspan="3">
                                <!-- <span t-field="review.lot_detail"/> -->
                                <span t-esc="first_review.lot_detail if first_review else ''"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>Number of disturbed Samples:</b></td>
                            <td colspan="3">
                                <!-- <span t-field="review.disturbes_samples"/> -->
                                <span t-esc="first_review.disturbes_samples if first_review else ''"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>Number of undisturbed soil samples:</b></td>
                            <td colspan="3">
                                <!-- <span t-field="review.undisturbes_samples"/> -->
                                <span t-esc="first_review.undisturbes_samples if first_review else ''"/>
                            </td>
                        </tr>

                        <!-- <tr>
                            <td><b>Number of <span t-field="sample.material_id"/> samples:</b></td>
                            <td colspan="3">
                                <span t-esc="first_review.no_samples if first_review else ''"/>
                            </td>
                        </tr> -->

                        <t t-set="materials" t-value="samples.mapped('material_id')"/>

                            <t t-foreach="materials" t-as="mat">
                            <tr>
                                <td>
                                    <b>Number of <span t-esc="mat.name"/> samples:</b>
                                </td>
                                    <td colspan="3">
                                    <span t-esc="first_review.no_samples if first_review else ''"/>
                                </td>
                            </tr>
                            </t>

                       

                        <tr>
                            <td><b>Expected completion date:</b></td>
                            <td colspan="3">
                                <!-- <span t-field="review.completion_date"/> -->
                                <span t-esc="first_review.completion_date if first_review else ''"/>
                            </td>
                        </tr>

                        <tr>
                            <td><b>Reference (W.O / Mail):</b></td>
                            <td colspan="3">
                                <!-- <span t-field="review.w_o"/> -->
                                <span t-esc="first_review.w_o if first_review else ''"/>
                            </td>
                        </tr>

                    </table>

                    <br/>
        
                <t t-foreach="samples" t-as="sample">

                    <t t-set="review" t-value="sample_review_map.get(sample.id)"/>

                    <t t-if="review">

                        <!-- MATERIAL NAME हर sample साठी print होईल -->
                        <br/>
                        <b>
                            Material : <span t-field="sample.material_id"/>
                        </b>

                        <table border="1" style="width:100%; border-collapse:collapse; margin-bottom:20px;">

                            <thead>
                                <tr>
                                    <th style="text-align:center;">Sr. No</th>
                                    <th style="text-align:center;">Chainage /Location/ID</th>
                                    <th style="text-align:center;">Depth (m)</th>
                                    <th style="text-align:center;">Sample Details</th>
                                    <th style="text-align:center;">Tests to be performed</th>
                                    <th style="text-align:center;">Test method to be adopted</th>
                                </tr>
                            </thead>

                            <tbody>

                                <t t-set="total" t-value="len(review.review_line_ids)"/>
                                <t t-set="i" t-value="0"/>

                                <t t-foreach="review.review_line_ids" t-as="line">

                                    <tr>

                                        <td style="text-align:center;">
                                            <span t-esc="i+1"/>
                                        </td>

                                        <td style="text-align:center;">
                                            <span t-field="line.source"/>
                                        </td>

                                        <td style="text-align:center;">
                                            <span t-field="line.depth"/>
                                        </td>

                                        <td style="text-align:center;">
                                            <span t-field="line.sample_details"/>
                                        </td>

                                        <!-- TESTS -->
                                        <t t-if="i == 0">
                                            <td t-att-rowspan="total" style="vertical-align:middle; text-align:center;">
                                                <span t-esc="', '.join(review.parameters.mapped('display_name'))"/>
                                            </td>
                                        </t>

                                        <!-- METHOD -->
                                        <t t-if="i == 0">
                                            <td t-att-rowspan="total" style="vertical-align:middle; text-align:center;">
                                                <span t-esc="', '.join([m for m in review.parameters.mapped('test_method.display_name') if m])"/>
                                            </td>
                                        </t>

                                    </tr>

                                    <t t-set="i" t-value="i+1"/>

                                </t>

                            </tbody>
                        </table>

                    </t>
                </t>



                                                        






                    <div class="footer" style="width:100%; font-size:12px;">

                            <div style="border-top: 2px solid black; margin-bottom: 5px; width:100%;"></div>

                            <div style="text-align:center;">
                                Page <span class="page"/> of <span class="topage"/>
                            </div>

                        </div>

                         <div class="signatureContainer girdgird" style="margin-top:50px;">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								<div style="height: 40px;">
						
						</div>
                            <div>
                                <b>
                                </b>
                            </div>
                            <div>
                                <b>
                                </b>
                            </div>
                        </div>
                        
								
							
							</div>
                            </div>
                    



            </t>
            </t>

</template>



	

<record id="srf_report_action" model="ir.actions.report">
        <field name="name">OR Report</field>
        <field name="model">lerm.civil.srf</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lerm_civil.custom_geotech_report</field>
        <field name="report_file">lerm_civil.custom_geotech_report</field>
        <field name="binding_model_id" ref="model_lerm_civil_srf"/>
        <field name="binding_type">report</field>
    </record>


</odoo>


