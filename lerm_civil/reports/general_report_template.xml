							<td colspan="3" t-if="nabl">
								<span t-field="o.sample_id.ulr_no"/>
							</td>
						</tr>
					</table>
			</div>
        </div>
	
        <div t-attf-class="article" t-att-style="report_header_style" style="position: relative;">
			<div t-if="report_type == 'pdf'" class="row backgroundimage" style="opacity:0.1; font-size:100px; width:100%; text-align:center;top:0; left:0; right:0; bottom:0; display:flex;align-items:center;justify-content:center; position: fixed; z-index:99;">
				<img t-if="eln.sample_id.lab_location and eln.sample_id.lab_location.watermark_image" t-att-src="'data:image/png;base64,' + eln.sample_id.lab_location.watermark_image.decode('utf-8')" style="width:85%;"/>
