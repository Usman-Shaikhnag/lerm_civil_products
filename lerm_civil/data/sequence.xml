<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="seq_sample_no" model="ir.sequence">
            <field name="name">Sample Sequence</field>
            <field name="code">lerm.srf.sample</field>
            <field name="prefix">SAM</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_kes_no" model="ir.sequence">
            <field name="name">Kes Sequence</field>
            <field name="code">lerm.srf.sample.kes</field>
            <field name="prefix">SSL%(y)s%(month)s%(day)s</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="eln_no" model="ir.sequence">
            <field name="name">ELN Sequence</field>
            <field name="code">lerm.eln.seq</field>
            <field name="prefix">ELN</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sample_no_daywise" model="ir.sequence">
            <field name="name">Sample Daywise Sequence</field>
            <field name="code">lerm.sample.daywise.seq</field>
            <field name="prefix">-</field>
            <field name="padding">0</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- cement opc  -->

        <record id="ulr_no_seqs" model="ir.sequence">
            <field name="name">ULR Sequence</field>
            <field name="code">sample.ulr.seq</field>
            <field name="prefix">(lab_certificate_no)%(y)s(lab_no_value)</field>
            <field name="suffix">F</field>
            <field name="padding">8</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="inv_no_seqs" model="ir.sequence">
            <field name="name">INV Sequence</field>
            <field name="code">invoice.seq</field>
            <field name="prefix">INV/%(y)s</field>
            <field name="suffix"></field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eln_soil" model="ir.sequence">
            <field name="name">ELN Soil</field>
            <field name="code">lerm.eln.soil</field>
            <field name="prefix">S-%(y)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

         <record id="seq_eln_fly_brick" model="ir.sequence">
