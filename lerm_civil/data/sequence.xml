        </record>

       

        <record id="seq_lerm_civil_srf" model="ir.sequence">
            <field name="name">SRF ID Sequence</field>
            <field name="code">lerm.civil.srf.seq</field>
            <field name="prefix">OR/%(y)s%(month)s%(day)s</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
