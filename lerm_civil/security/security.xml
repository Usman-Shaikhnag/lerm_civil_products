        <record id="rule_param_result_technician_read" model="ir.rule">
            <field name="name">Parameter result: technician sees own rows</field>
            <field name="model_id" ref="model_eln_parameters_result"/> <!-- adjust model ref -->
            <!-- allow if technician is the user OR user is in eln header's technician_ids -->
            <field name="domain_force">['|', ('technician','=',user.id), ('eln_id.technician_ids','in', user.id)]</field>
            <!-- limit to technician group if desired, else use base.group_user -->
            <field name="groups" eval="[(4, ref('kes_technician_access_group'))]"/>
        </record>

        <record id="lerm_sample_department_rule" model="ir.rule">
            <field name="name">Sample: Department Filter</field>
            <field name="model_id" ref="model_lerm_srf_sample"/>
            <field name="domain_force">['|', ('department_id', '=', False), ('department_id', 'in', user.department_ids.mapped('name'))]</field>
            <!-- Assigning base.group_user allows Admins with their own "see all" rules to bypass this filter -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>

            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
