<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="ss_round_view" model="ir.ui.view">
        <field name="name">structural.steel.round.form</field>
        <field name="model">structural.steel.round</field>
        <field name="arch" type="xml">
            <form>

                <sheet>
                   <group>
                       
                       
                         <field name='eln_ref' readonly="1"/>
                          <field name='name' readonly="1"/>
                    </group>
                         
                            <group>
                                
                               
                                
                            </group>

                             <div class="d-flex gap-2" >
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><label for="grade"></label></td>
                                        <td><field name="grade" /></td>
                                        <field name="eln_state" />
                                    </tr>
                                
                                </tbody>
                            </table>
                            
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><label for="size"></label></td>
                                        <td><field name="size" /></td>
                                    </tr>
                                
                                </tbody>
                            </table>
                            </div>
                             <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>
                           <div class="custom_table_borders">
                                <field name="sample_parameters">
                                    <tree>
                                        <field name="parameter_name"/>
                                        <field name="test_method"/>
                                    </tree>
                                </field>
                            </div>
                            
                            
                            <field name="bend_visible" invisible="1"/>
                            <field name="fracture_visible" invisible="1"/>
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                                <tbody>
                                    <tr>
                                        <td><span>Parameters</span></td>
                                        <td><span>Observation 1</span></td>
                                        <td><span>Parameters</span></td>
                                        <td><span>Observation 2</span></td>
                                        
                                    </tr>
                                    <tr>
                                        <td><label for="width"></label></td>
                                        <td><field name="width"/></td>
                                        <td><label for="width2"></label></td>
                                        <td><field name="width2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="thickness"></label></td>
                                        <td><field name="thickness"/></td>
                                        <td><label for="thickness2"></label></td>
                                        <td><field name="thickness2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="area"></label></td>
                                        <td><field name="area"/></td>
                                        <td><label for="area2"></label></td>
                                        <td><field name="area2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="gauge_length1"></label></td>
                                        <td><field name="gauge_length1"/></td>
                                        <td><label for="gauge_length2"></label></td>
                                        <td><field name="gauge_length2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="final_length"></label></td>
                                        <td><field name="final_length"/></td>
                                        <td><label for="final_length2"></label></td>
                                        <td><field name="final_length2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="yeild_load"></label></td>
                                        <td><field name="yeild_load"/></td>
                                        <td><label for="yeild_load2"></label></td>
                                        <td><field name="yeild_load2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="ultimate_load"></label></td>
                                        <td><field name="ultimate_load"/></td>
                                        <td><label for="ultimate_load2"></label></td>
                                        <td><field name="ultimate_load2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="proof_yeid_stress"></label></td>
                                        <td><field name="proof_yeid_stress"/></td>
                                        <td><label for="proof_yeid_stress2"></label></td>
                                        <td><field name="proof_yeid_stress2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="ult_tens_strgth"></label></td>
                                        <td><field name="ult_tens_strgth"/></td>
                                        <td><label for="ult_tens_strgth2"></label></td>
                                        <td><field name="ult_tens_strgth2"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="elongation"></label></td>
                                        <td><field name="elongation"/></td>
                                        <td><label for="elongation2"></label></td>
                                        <td><field name="elongation2"/></td>
                                    </tr>
                                    <tr invisible="bend_visible == False">
                                        <td><label for="bend_test"/></td>
                                        <td><field name="bend_test"/></td>
                                        <td><label for="bend_test2"/></td>
                                        <td><field name="bend_test2"/></td>
                                    </tr>

                                    <tr invisible="fracture_visible == False">
                                        <td><label for="fracture"/></td>
                                        <td><field name="fracture"/></td>
                                        <td><label for="fracture2"/></td>
                                        <td><field name="fracture2"/></td>
                                    </tr>
                                    

                                </tbody>
                            </table>
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                                <tbody>
                                    <tr>
                                        <td><label for="requirement_yield"></label></td>
                                        <td><field name="requirement_yield" string="Proof Yield Stress Requirement"/></td>
                                        <td><label for="yield_nabl"></label></td>
                                        <td><field name="yield_nabl" string="Proof Yield Stress NABL"
                                            decoration-success="yield_nabl == 'pass'"
                                            decoration-danger="yield_nabl == 'fail'"
                                            readonly="1"/></td>
                                        <td><label for="yield_conformity"></label></td>
                                        <td><field name="yield_conformity" string="Proof Yield Stress Confirmity"
                                                decoration-success="yield_conformity == 'pass'"
                                                decoration-danger="yield_conformity == 'fail'"
                                                readonly="1"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="requirement_utl"></label></td>
                                        <td><field name="requirement_utl" string="UTS Requirement"/></td>
                                        <td><label for="uts_nabl"></label></td>
                                        <td>
                                            <field name="uts_nabl" string="UTS NABL"
                                                decoration-success="uts_nabl == 'pass'"
                                                decoration-danger="uts_nabl == 'fail'"
                                                readonly="1"/>
                                        </td>
                                        <td><label for="uts_conformity"></label></td>
                                        <td>
                                            <field name="uts_conformity" string="UTS Confirmity"
                                                decoration-success="uts_conformity == 'pass'"
                                                decoration-danger="uts_conformity == 'fail'"
                                                readonly="1"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td><label for="requirement_elongation"></label></td>
                                        <td><field name="requirement_elongation" string="Elongation Requirement"/></td>
                                        <td><label for="elongation_nabl"></label></td>
                                        <td>
                                            <field name="elongation_nabl" string="Elongation NABL"
                                                decoration-success="elongation_nabl == 'pass'"
                                                decoration-danger="elongation_nabl == 'fail'"
                                                readonly="1"/>
                                        </td>
                                        <td><label for="elongation_conformity"></label></td>
                                        <td>
                                            <field name="elongation_conformity" string="Elongation Confirmity"
                                                decoration-success="elongation_conformity == 'pass'"
                                                decoration-danger="elongation_conformity == 'fail'"
                                                readonly="1"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                          

                        

                    

                            <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
              

                </sheet>
            </form>
        </field>
    </record>
   


    </data>
</odoo>