<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="fusion_welded_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->

			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>TEST REPORT</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:20px;">
					
					<div t-foreach="eln" t-as="o">
						
						<table style="width:100%; border-collapse: collapse;" border="1">

						    <tr style="height:10px;">
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">--</t>
		                            <br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 60px;"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >Project Name:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
									</td>
							</tr>

							<tr t-if="o.srf_id.client">
								<td colspan="1" >Name of Agency:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
									</td>
							</tr>

							<tr>
								<td style="width:20%;">Discipline :
									
								</td>
								<td style="width:20%;">
								<span t-field="o.discipline.discipline"/>
								</td>

								<td>SRF No. :-</td>
										<td >

											<t t-if="o.srf_id">
											<span t-field="o.srf_id"/>
										</t>
									<t t-else="">--</t>
										</td>

							
							</tr>


							<tr>
								

								<td style="width:20%;">Group :	
								</td>
								<td style="width:20%;">
									<span t-field="o.group.group"/>
								
								</td>
							
							<td>SRF Date:-</td>
								<td>

									<t t-if="o.srf_date">
											<span t-field="o.srf_date"/>
										</t>
								</td>
							</tr>

							<tr>
								

								<td >Samples Description :-</td>
								<td >
								      <t t-if="data.product_name">
											<span t-field="data.product_name"/>
										</t>
								</td>

								<td>Date of Samples Received :-</td>
								<td>

									<t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								</td>
								
							</tr>

							<tr>
								<td>Temperature (°C) :-</td>
								<td>
								<t t-if="data.temprature">
											<span t-field="data.temprature"/>
										</t>
									<t t-else="">--</t>
									</td>

								<td>Humidity (%)  :-</td>

								<td>

										<t t-if="data.humidity">
											<span t-field="data.humidity"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								
								<td>Test Start Date  :-</td>
								<td>

									<t t-if="o.start_date">
											<span t-field="o.start_date"/>
										</t>
									<t t-else="">--</t>
								</td>

								<td>Test Completion Date  :-</td>
								<td>

									<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>


							<tr>

								<td>Sample Status :-</td>
								<td>
									   <t t-if="data.sample_status">
											<span t-field="data.sample_status"/>
										</t>
									<t t-else="">--</t>
								</td>
								
								<td>Sample Submitted By:-</td>
								<td>
									   <t t-if="data.sample_submitted">
											<span t-field="data.sample_submitted"/>
										</t>
									<t t-else="">--</t>
								</td>

							
							</tr>

							<tr>

								<td>Sub Group :-</td>
								<td>
								  <t t-if="o.material and o.material.lab_name">
											<span t-field="o.material.lab_name"/>
										</t>
								</td>
								
								<td>No. Of  Samples :-</td>
								<td>
									   <t t-if="data.No_of_sample">
											<span t-field="data.No_of_sample"/>
										</t>
									<t t-else="">--</t>
								</td>

							
							</tr>
							
							<tr>
								

								<td style="width:20%;">Letter No :-</td>
								<td style="width:20%;">

								  <t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">--</t>
								
								</td>
								<td>Letter Date :-</td>
								<td>
									

									<t t-if="o.srf_id.letter_date">
											<span t-field="o.srf_id.letter_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr >
								<td colspan="1" >Sample Description:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="data.description_work">
											<span t-field="data.description_work"/>
										</t>
									<t t-else="">--</t>
									</td>
							</tr>

							
							
								
                           

						
							<tr >
								

							<td >TEST METHOD:</td>
							<td ><span t-field="o.material.test_method_adopted"/></td>

							<td >Specification </td>
							<td ><span t-field="o.material.specification_code"/></td>
							</tr>


							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

						</table>
					</div>
					<div style="text-align: center; font-weight: bold; margin-top: 2px; font-size: 16px;">
						TEST RESULT
					</div>

					<div style="margin-top:5px;"  invisible="mechanical_test_visible == False">
                       
					<table>
							
						<tr >
									<td colspan="5">
								<b>MECHANICAL TEST</b>
										</td>

										<td colspan="4">
								<b>Sample Description &#160;<span t-field="data.description_work"/></b>
										</td>
										
									
						</tr>
									<tr cols="12">
							<td  style="text-align: center;"><b>Sr No.</b></td>
							<td   style="text-align: center;"><b>Sample  Identity</b></td>
							<td   style="text-align: center;"><b>Width (mm)</b></td>
							<td   style="text-align: center;"><b>Thickness (mm)</b></td>
							<td   style="text-align: center;"><b>Area (mm2)</b></td>
							<td   style="text-align: center;"><b>Maximum Load (kN)</b></td>
							<td   style="text-align: center;"><b>UTS (N/mm2)</b></td>
							<td   style="text-align: center;"><b>Yield Stress (N/mm2)</b></td>
							<td   style="text-align: center;"><b>Type of fracture /Location </b></td>
							
							
						</tr>

						<tr>

						
							<td   style="text-align: center;" colspan="2"><b>SPECIFICATION AS PER </b></td>
							<td   style="text-align: center;"><span t-field="data.width_specification"/></td>
							<td   style="text-align: center;"><span t-field="data.thickness_specification"/></td>
							<td   style="text-align: center;"><span t-field="data.area_specification"/></td>
							<td   style="text-align: center;"><span t-field="data.load_specification"/></td>
							<td   style="text-align: center;"><span t-field="data.uts_specification"/></td>
							<td   style="text-align: center;"><span t-field="data.yield_specification"/></td>
							<td   style="text-align: center;"><span t-field="data.fracture_specification"/></td>
						</tr>

									

									
								
							<t t-set="f" t-value="0"/>
							<tr t-foreach="data.mechanical_test_lines" t-as="r">
								<td  style="text-align: center;">
									<div>
										<span t-esc="f + 1" />
										<t t-set="f" t-value="f + 1"/>
									</div>
								</td>
								<td  style="text-align: center;">
									<span t-esc="r['sample_identity']"/>
								</td>
							<td  style="text-align: center;">
									<span t-esc="r['width']"/>
								</td>
								<td  style="text-align: center;">
									<span t-esc="r['thickness']"/>
								</td>
								<td  style="text-align: center;">
									<span t-esc="r['area']"/>
								</td>
								<td  style="text-align: center;">
									<span t-esc="r['maximum_load']"/>
								</td>
								<td  style="text-align: center;">
									<span t-esc="r['uts']"/>
								</td>
								<td  style="text-align: center;">
									<span t-esc="r['yield_stress']"/>
								</td>
								<td  style="text-align: center;">
									<span t-esc="r['fracture']"/>
								</td>
							
								
								
							</tr>


									
							</table>
					</div>


					<div style="margin-top:5px"  invisible="bend_test_visible == False">
                       
            <table>
                       
                 <tr >
							  <td colspan="6">
                           <b> BEND TEST </b>
								</td>

                          
                               
                </tr>
							  <tr cols="12">
                    <td  style="text-align: center;"><b>Sr No.</b></td>
                    <td   style="text-align: center;"><b>Sample  Identity</b></td>
                    <td   style="text-align: center;"><b>Width (mm)</b></td>
                    <td   style="text-align: center;"><b>Thickness (mm)</b></td>
                    <td   style="text-align: center;"><b>Former Dia</b></td>
                    <td   style="text-align: center;"><b>Bend Test 1800 RESULT </b></td>
                    
                    
                    
                </tr>

              
                            
						
                    <t t-set="f" t-value="0"/>
                    <tr t-foreach="data.bend_test_lines" t-as="r">
                        <td  style="text-align: center;">
                            <div>
                                <span t-esc="f + 1" />
                                <t t-set="f" t-value="f + 1"/>
                            </div>
                        </td>
                        <td  style="text-align: center;">
                            <span t-esc="r['sample_identity']"/>
                        </td>
                      <td  style="text-align: center;">
                            <span t-esc="r['width']"/>
                        </td>
                        <td  style="text-align: center;">
                            <span t-esc="r['thickness']"/>
                        </td>
                         <td  style="text-align: center;">
                            <span t-esc="r['dia']"/>
                        </td>
                         <td  style="text-align: center;">
                            <span t-esc="r['bend_test']"/>
                        </td>
                        
                        
                        
                    </tr>


							
                     </table>
					</div>


					<div style="margin-top:5px"  invisible="nick_break_visible == False">
                       
            <table>
                       
                 <tr >
							  <td colspan="5">
                           <b> Nick Break Test </b>
								</td>

                          
                               
                </tr>
							  <tr cols="12">
                    <td  style="text-align: center;"><b>Sr No.</b></td>
                    <td   style="text-align: center;"><b>Sample  Identity</b></td>
                    <td   style="text-align: center;"><b>Width (mm)</b></td>
                    <td   style="text-align: center;"><b>Thickness (mm)</b></td>
                    <td   style="text-align: center;"><b>Result</b></td>
                    
                    
                    
                </tr>

              
                            
						
                    <t t-set="f" t-value="0"/>
                    <tr t-foreach="data.nick_break_lines" t-as="r">
                        <td  style="text-align: center;">
                            <div>
                                <span t-esc="f + 1" />
                                <t t-set="f" t-value="f + 1"/>
                            </div>
                        </td>
                        <td  style="text-align: center;">
                            <span t-esc="r['sample_identity']"/>
                        </td>
                      <td  style="text-align: center;">
                            <span t-esc="r['width']"/>
                        </td>
                        <td  style="text-align: center;">
                            <span t-esc="r['thickness']"/>
                        </td>
                         <td  style="text-align: center;">
                            <span t-esc="r['result']"/>
                        </td>
                        
                        
                        
                        
                    </tr>


							
                     </table>
					</div>



					<div style="margin-top:20px;page-break-before: always;"   invisible="impact_test_visible == False">
                       
            <table>
                       
                 <tr >
							  <td colspan="9">
                           <b>IMPACT TEST </b>
								</td>

                          
                               
                </tr>
					<tr cols="12">
                    <td  style="text-align: center;" rowspan="2"><b>Sr No.</b></td>
                    <td   style="text-align: center;" rowspan="2"><b>Sample  Identity</b></td>
                    <td   style="text-align: center;" rowspan="2"><b>Sample Size (mm)</b></td>
                    <td   style="text-align: center;" colspan="3"><b>Impact Value  In Joules Test Temp. 00C </b></td>
                 
                    <td   style="text-align: center;" colspan="1"><b>Absorbed Energy- KV2</b></td>
                    
                    
                    
                </tr>

                <tr>
                 <td   style="text-align: center;" colspan="1"><b>1st Reading </b></td>
                  <td   style="text-align: center;" colspan="1"><b>2st Reading </b></td>
                   <td   style="text-align: center;" colspan="1"><b>3st Reading </b></td>

                    <td   style="text-align: center;" colspan="1"><b>Average Value in Joules (J)</b></td>
                </tr>

              
                            
						
                    <t t-set="f" t-value="0"/>
                    <tr t-foreach="data.impact_test_lines" t-as="r">
                        <td  style="text-align: center;">
                            <div>
                                <span t-esc="f + 1" />
                                <t t-set="f" t-value="f + 1"/>
                            </div>
                        </td>
                        <td  style="text-align: center;">
                            <span t-esc="r['sample_identity']"/>
                        </td>
                      <td  style="text-align: center;">
                            <span t-esc="r['sample_size']"/>
                        </td>
                        <td  style="text-align: center;">
                            <span t-esc="r['reading1']"/>
                        </td>
                         <td  style="text-align: center;">
                            <span t-esc="r['reading2']"/>
                        </td>
                          <td  style="text-align: center;">
                            <span t-esc="r['reading3']"/>
                        </td>
                          <td  style="text-align: center;">
                            <span t-esc="r['absorbed']"/>
                        </td>
                        
                        
                        
                        
                    </tr>


							
                     </table>

					</div>

						<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>

							



					<div class="signatureContainer girdgird">
						<div>
							<div>
								<b>
									Checked By
								</b>
							</div>
							<div style="height: 50px;">
									<t t-if="eln.sample_id.checkby_signature_required and eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')"
											style="max-width: 200px; max-height: 45px; margin-top: 1px; z-index: -10;"/>
									</t>
								</div>
							<div>
								<b>
									<!-- <span t-esc="eln.technician.name"/> -->
									<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>

						<!-- QR Code -->
							<!-- <div style="text-align:center; margin-bottom:10px;">
								<img t-att-src="'data:image/png;base64,%s' % (qrcode_static or '')"
									style="width:75px; height:70px;"/>
							</div> -->

						<t t-if="o.sample_id.stamp_attached">
							<div >
								<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div>
							</div>
						</t>
						<div>
							<div>
								<b>
									Approved By 
								</b>
								
							</div>
							<div style="height: 50px;">
									<t t-if="eln.sample_id.approveby_signature_required">
										<div t-if="eln.sample_id.approved_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>
						
							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							
							<!-- <div>
								<b>
									(Authorized Signatory)
								</b>
							</div> -->
						</div>
					</div>
					
				</div>
				
					

	</t>
</t>

</template>

</odoo>