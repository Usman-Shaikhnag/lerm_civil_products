<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mech_fusion_welded_form" model="ir.ui.view">
        <field name="name">mechanical.fusion.welded.form</field>
        <field name="model">mechanical.fusion.welded</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">

             
                <sheet>
                                  
                <div class="text-center">
                    <h1>
                        <field name="name2" readonly="1" nolabel="1"/>
                    </h1>
                </div>
                <group>
                        <field name="srf_id"  invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                    

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="sample_submitted"></label></td>
                                    <td><field name="sample_submitted" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="sample_status"></label></td>
                                    <td><field  name="sample_status" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="No_of_sample"></label></td>
                                    <td><field name="No_of_sample" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>


                    

                    <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="product_name"></label></td>
                                    <td><field  name="product_name" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>


                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <div invisible="not mechanical_test_visible">

                        <h1 class="text-center">
                            <field name="mechanical_test_name" readonly="1" />
                            <field name="mechanical_test_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div class="d-flex gap-2" invisible="mechanical_test_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="width_specification"></label></td>
                                    <td><field  name="width_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="thickness_specification"></label></td>
                                    <td><field  name="thickness_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         </div>



                         <div class="d-flex gap-2" invisible="mechanical_test_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="area_specification"></label></td>
                                    <td><field  name="area_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="load_specification"></label></td>
                                    <td><field  name="load_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         </div>
                         <div class="d-flex gap-2" invisible="mechanical_test_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="uts_specification"></label></td>
                                    <td><field  name="uts_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                         <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="yield_specification"></label></td>
                                    <td><field  name="yield_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         </div>
                         <div class="d-flex gap-2" invisible="mechanical_test_visible == False">
                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="fracture_specification"></label></td>
                                    <td><field  name="fracture_specification" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                        
                         </div>

                         <div invisible="mechanical_test_visible == False" class="mb-3">
                    <field name="mechanical_test_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" class="blue-input" decoration-info="sample_identity != 0"/>
                                <field name="width"  class="blue-input" decoration-info="width != 0"/>
                                <field name="thickness"  class="blue-input" decoration-info="thickness != 0"/>
                                <field name="area"  class="blue-input" decoration-info="area != 0"/>
                                <field name="maximum_load"  class="blue-input" decoration-info="maximum_load != 0"/>
                                <field name="uts"  class="blue-input" decoration-info="uts != 0"/>
                                <field name="yield_stress"  class="blue-input" decoration-info="yield_stress != 0"/>
                                <field name="fracture"  class="blue-input" decoration-info="fracture != 0"/>
                                
                              
                            </tree>
                    </field>
                  

                    </div>


                      <div invisible="not bend_test_visible">

                        <h1 class="text-center">
                            <field name="bend_test_name" readonly="1" />
                            <field name="bend_test_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div invisible="bend_test_visible == False" class="mb-3">
                    <field name="bend_test_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" class="blue-input" decoration-info="sample_identity != 0"/>
                                <field name="width"  class="blue-input" decoration-info="width != 0"/>
                                <field name="thickness"  class="blue-input" decoration-info="thickness != 0"/>
                                <field name="dia"  class="blue-input" decoration-info="dia != 0"/>
                                <field name="bend_test"  class="blue-input" decoration-info="bend_test != 0"/>
                                
                              
                            </tree>
                    </field>
                  

                    </div>



                     <div invisible="not nick_break_visible">

                        <h1 class="text-center">
                            <field name="nick_break_name" readonly="1" />
                            <field name="nick_break_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div invisible="nick_break_visible == False" class="mb-3">
                    <field name="nick_break_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" class="blue-input" decoration-info="sample_identity != 0"/>
                                <field name="width"  class="blue-input" decoration-info="width != 0"/>
                                <field name="thickness"  class="blue-input" decoration-info="thickness != 0"/>
                                <field name="result"  class="blue-input" decoration-info="result != 0"/>
                                
                              
                            </tree>
                    </field>
                  

                    </div>



                    <div invisible="not impact_test_visible">

                        <h1 class="text-center">
                            <field name="impact_test_name" readonly="1" />
                            <field name="impact_test_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div invisible="impact_test_visible == False" class="mb-3">
                    <field name="impact_test_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" class="blue-input" decoration-info="sample_identity != 0"/>
                                <field name="sample_size"  class="blue-input" decoration-info="sample_size != 0"/>
                                <field name="reading1"  class="blue-input" decoration-info="reading1 != 0"/>
                                <field name="reading2"  class="blue-input" decoration-info="reading2 != 0"/>
                                <field name="reading3"  class="blue-input" decoration-info="reading3 != 0"/>
                                <field name="absorbed"  class="blue-input" decoration-info="absorbed != 0"/>
                                
                              
                            </tree>
                    </field>
                  

                    </div>



  

                    
                     <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>


                        </page>

                    </notebook>



                         <button
                                type="object"
                                class="oe_highlight"
                                name="open_eln_page"
                                string="Submit"
                            />
                   
                   
                    

                </sheet>
            </form>
        </field>
        </record>



       
    </data>
</odoo>