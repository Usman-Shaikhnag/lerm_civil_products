<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="compresive_concrete_cube_datasheet">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.genstru_data_sheet_header">
                <div style="text-align:center;font-size:18px;font-weight: bold">
                  CONCRETE CUBE
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>		
                                <span t-field="eln.name"/>
                            </td>
                            <td colspan="6">Grade: 
                                <![CDATA[&nbsp;]]>
                                M25
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Size: 150 mm
                            </td>
                            <td colspan="6">Type of Sample: Cube
                            </td>
                        </tr>
                    </table>

                    <table>
                        <tr style="height:50px" cols="12">
                            <td colspan="4">Performed By :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.technician.name"/>
                            </td>
                            <td colspan="4">Witness Name :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.witness_name"/>
                            </td>
                            <td colspan="4">Witness Signature :
                                <![CDATA[&nbsp;]]>
                                <span style="padding:20px"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Test Configuration -->
                    <div style="margin-top: 30px;">
                        <div style="text-align: center; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
                            TEST CONFIGURATION
                        </div>
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Type of Sample</td>
                                <td style="border: 1px solid black; padding: 6px; width: 25%;">
                                    Cube
                                </td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Details of Machine</td>
                                <td style="border: 1px solid black; padding: 6px; width: 25%;">
                                    Compression Testing Machine
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;">Loading Capacity</td>
                                <td style="border: 1px solid black; padding: 6px;">
                                    2000 kN
                                </td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;">Calibration Date</td>
                                <td style="border: 1px solid black; padding: 6px;">
                                    10/28/2025
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;">Curing Condition</td>
                                <td style="border: 1px solid black; padding: 6px;">
                                    Water Curing
                                </td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;">Details of Structure</td>
                                <td style="border: 1px solid black; padding: 6px;">
                                    NA
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Environmental Conditions -->
                    <div style="margin-top: 20px;">
                        <div style="text-align: center; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
                            ENVIRONMENTAL CONDITIONS &amp; TEST DATES
                        </div>
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Room Temperature</td>
                                <td style="border: 1px solid black; padding: 6px; width: 25%;">
                                    27 &amp;deg;C
                                </td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold; width: 25%;">Relative Humidity</td>
                                <td style="border: 1px solid black; padding: 6px; width: 25%;">
                                    65 %
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;">Date of Casting</td>
                                <td style="border: 1px solid black; padding: 6px;">
                                    10/28/2025
                                </td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;">Date of Testing</td>
                                <td style="border: 1px solid black; padding: 6px;">
                                    10/31/2025
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;">Age of Test</td>
                                <td style="border: 1px solid black; padding: 6px;">
                                    3 days
                                </td>
                                <td style="border: 1px solid black; padding: 6px; font-weight: bold;"></td>
                                <td style="border: 1px solid black; padding: 6px;"></td>
                            </tr>
                        </table>
                    </div>

                    <!-- Test Results Table -->
                    <div style="margin-top: 30px;">
                        <div style="text-align: center; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
                            COMPRESSIVE STRENGTH TEST RESULTS
                        </div>
                         <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <thead>
                                <tr style="background-color:#f0f0f0; text-align: center;">
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Sr No.</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Identification Mark</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Date of Casting</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Date of Testing</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Age Age of Specimen (days)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Room temperature (&amp;deg;C)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Relative Humidity (%)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Weight of cube (gms)</th>
                                    <th style="border: 1px solid black; padding: 8px;" colspan="2"> Plan Dimensions of Testing Faces (mm)</th>
                                            
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Cross sectional area (mm&amp;sup2;)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Maximum Load (kN)</th>
                                    <!-- <th style="border: 1px solid black; padding: 8px;" rowspan="2">Type of Failure</th> -->
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Compressive strength (N/mm&amp;sup2;)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2"> Average Compressive strength (N/mm&amp;sup2;)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Type of Failure</th>
                                </tr>
                                <tr>

                                  <th style="border: 1px solid black; padding: 8px;" colspan="1">Length (mm)</th>
                                    <th style="border: 1px solid black; padding: 8px;" colspan="1">Diameter (mm)</th>
                                </tr>
                            </thead>
                            <tbody>
                        
                                <t t-set="line_count" t-value="0"/>

<tr t-foreach="data.child_lines" t-as="r" style="text-align: center;">
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['sr_no']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['id_mark']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['wt_sample']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['length']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['diameter']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['dt_of_casting']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['days']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['dt_of_testing1']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['room_temp']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['relative_humidity']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['load']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="'%.2f' % r['cross_sectional_area']"/></td>
    <!-- <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['type_of_failure']"/></td> -->
    <td style="border: 1px solid black; padding: 6px;"> <span t-esc="'%.2f' % r['compressive_strength']"/></td>

    

    
    <t t-if="(line_count + 3) % 3 == 0">
        <td style="border: 1px solid black; padding: 6px; text-align: center; vertical-align: middle;" t-att-rowspan="4">
            <span t-esc="r['avg_compressive_strength']" t-options='{"widget": "float", "precision": 2}'/>
        </td>
    </t>

    <t t-set="line_count" t-value="line_count + 1"/>


     <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['type_of_failure']"/></td>
   </tr>

   </tbody>
      </table>

                    
          </div>

                    <!-- Summary Section -->
                    <!-- <div style="margin-top: 30px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr t-foreach="data.child_lines" t-as="r" style="font-weight: bold;">
                                <td style="border: 1px solid black; padding: 10px; text-align: left; width: 70%;">
                                    Average Compressive Strength
                                </td>
                                <td style="border: 1px solid black; padding: 10px; text-align: center; width: 30%;">

                                <span t-esc="'%.2f' % r['avg_compressive_strength']" />
                                    <span field="data.avg_compressive_strength" />
                                </td>
                            </tr>
                        </table>
                    </div> -->

                    <!-- Signatures -->
                    <div class="signatureContainer girdgird">
                        <div>
                            <div>
                                <b>Prepared By</b>
                            </div>
                            <div style="height:20px"></div>
                            <div>
                                <b>
                                    <span t-esc="eln.technician.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (Technician)
                                </b>
                            </div>
                        </div>

                        <div>
                            <div>
                                <!-- <img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/> -->
                            </div>
                        </div>
                        
                        <div>
                            <div>
                                <b>Reviewed &amp; Issued By</b>
                            </div>
                            <div style="height:20px"></div>
                            <div>
                                <b>
                                    (Authorized Signatory)
                                </b>
                            </div>
                            <div>
                                <b>
                                    (Supervisor)
                                </b>
                            </div>
                        </div>
                    </div>
                </div> 
            </t>
        </t>
    </template>
</odoo>