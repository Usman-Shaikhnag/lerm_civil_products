                                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="'%.2f' % r['cross_sectional_area']"/></td> -->
                                    <!-- <td style="border: 1px solid black; padding: 6px;"> <span t-esc="'%.2f' % r['compressive_strength']"/></td> -->
                                    
                                    <!-- <t t-if="line_count % 3 == 0">
										<td style="text-align: center; vertical-align: middle;" t-att-rowspan="3">
											<span t-esc=" r['compressive_strength']" t-options='{"widget": "float", "precision": 2}'/>
										</td>
									</t>
								


								<t t-set="line_count" t-value="line_count + 1"/>
								


                                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['type_of_failure']" /></td>
                                </tr> -->
                                                   
    
                       

                    <!-- Machine Details -->
                    <group>
                        <group>
                            <label for="machine_details" string="Details of Machine:"/>
                            <field name="machine_details"/>
                            <label for="loading_capacity" string="Loading capacity:"/>
                            <field name="loading_capacity"/>
                            <label for="calibration_date" string="Calibration date:"/>
                            <field name="calibration_date"/>
                        </group>
                        <group>
                            <label for="structure_details" string="Details of the structure:"/>
                            <field name="structure_details"/>
                        </group>
                    </group>

                    <separator/>

                    <!-- Age and Testing Information -->
                    <group>
                        <field name="age_of_days" string="Age of Testing"/>
                        <field name="date_of_casting" string="Date of Casting" readonly="1"/>
                        <field name="date_of_testing" string="Date of Testing" readonly="1"/>
                        <field name="age_of_test" string="Age of Test (days)" readonly="1"/>
                        <field name="difference" string="Difference from Required Age" readonly="1"/>
                    </group>

                    <!-- Results and Compliance -->
                    <group>
                        <field name="confirmity" string="Conformity" readonly="1"/>
                        <field name="nabl" string="NABL Compliance" readonly="1"/>
                    </group>

                    <separator/>


                     <!-- <div style="margin-top: 30px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr t-foreach="data.child_lines" t-as="r" style="font-weight: bold;">
                                <td style="border: 1px solid black; padding: 10px; text-align: left; width: 70%;">
                                    Average Compressive Strength
