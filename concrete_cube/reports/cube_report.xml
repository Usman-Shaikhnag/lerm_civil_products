<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	
	 <template id="compresive_concrete_cube_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			
			<!-- <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln_general"> -->
			<t t-call="lerm_civil.genstru_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report on GGBS Mechanical</b></p>
				</div> -->
				<div class="container_eln">
					<div t-foreach="eln" t-as="o">
					
						 <table class="table table-sm" style="width: 100%; border-collapse: collapse;" border="1">
							<tr>
								<td ><strong>Mechanical Testing</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>
								<td ><strong>URL NO</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.sample_id.ulr_no"/></td>
							</tr>

							<tr>
								<td><strong>Project Name</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.srf_id.name_work"/></td>

								<td><strong>Date of Report</strong>: </td>
									
								<td >
								<span t-field="o.start_date" style="margin-right:10px;"/> 		
								</td>
							</tr>
						
							
						
							<tr>
							<td style="width:20%;"><strong>Name &amp; Address of Customer</strong>: </td>
							<td style="padding-left: 10px;width:25%;">
										<span t-field="o.srf_id.customer.name"/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
								</td>
								<!-- <td><strong>Date Sample Received</strong>: </td> -->
								<!-- <td >
								<span t-field="o.sample_id.sample_received_date"/>
								</td > -->
								

								<td><strong>Date Sample Received</strong>:</td>
								<td>
									<!-- <t t-if="ggbs.rock_child_lines">
										<span t-field="data.rock_child_lines[0].date_received"/>
									</t> -->
								</td>
							</tr>
							<tr>
								<td><strong>Report No.</strong>: </td>
								<td></td>

								<td><strong>Starting Date</strong>: </td>
								<td>
									<!-- <t t-if="data.rock_child_lines">
										<span t-field="data.rock_child_lines[0].date_received"/>
									</t> -->
								</td>
							
							</tr>
							
							<tr>

								<td><strong>Type of Sample &amp; Condition</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>

							<td><strong>Completion Date</strong>: </td>
								<td>
									<!-- <t t-if="data.rock_child_lines">
										<span t-field="data.rock_child_lines[0].date_testing"/>
									</t> -->
								</td>
						</tr>	
						</table>
					</div>


                   <div>
                
                        <div style="margin-top: 30px;">
                            <!-- Type of Sample Details -->
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 12px;">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Type of Sample:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.type_of_sample"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Grade of concrete:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="o.grade_id.grade"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Curing Condition:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.curing_condition"/></td>
                                </tr>
                            </table>

                              <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 12px;">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Details of Machine:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.machine_details"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Loading capacity:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.loading_capacity"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Calibration date:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.calibration_date"/></td>
                                </tr>
                            </table>
                    </div>

                    <!-- ADDED TABLE FROM IMAGE -->
                    <div style="margin-top: 30px;">
                        <!-- Main Test Results Table -->
                       <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <thead>
                                <tr style="background-color:#f0f0f0; text-align: center;">
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Sr No.</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Identification Mark</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Date of Casting</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Date of Testing</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Age Age of Specimen (days)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Room temperature (&amp;deg;C)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Relative Humidity (%)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Weight of cube (gms)</th>
                                    <th style="border: 1px solid black; padding: 8px;" colspan="2"> Plan Dimensions of Testing Faces (mm)</th>
                                             
                                    
                                 
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Cross sectional area (mm&amp;sup2;)</th>
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Maximum Load (kN)</th>
                                    <!-- <th style="border: 1px solid black; padding: 8px;" rowspan="2">Type of Failure</th> -->
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Compressive strength (N/mm&amp;sup2;)</th>
                                   <th style="border: 1px solid black; padding: 8px;" rowspan="2"> Average Compressive strength (N/mm&amp;sup2;)</th>

                                      <th style="border: 1px solid black; padding: 8px;" rowspan="2">Type of Failure</th>
                                </tr>
                                <tr>

                                  <th style="border: 1px solid black; padding: 8px;" colspan="1">Length (mm)</th>
                                    <th style="border: 1px solid black; padding: 8px;" colspan="1">Diameter (mm)</th>
                                </tr>
                            </thead>
                            <tbody>
                        


                                <t t-set="line_count" t-value="0"/>

<tr t-foreach="data.child_lines" t-as="r" style="text-align: center;">
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['sr_no']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['id_mark']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['wt_sample']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['length']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['diameter']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['dt_of_casting']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['days']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['dt_of_testing1']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['room_temp']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['relative_humidity']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['load']"/></td>
    <td style="border: 1px solid black; padding: 6px;"><span t-esc="'%.2f' % r['cross_sectional_area']"/></td>
    <!-- <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['type_of_failure']"/></td> -->
    <td style="border: 1px solid black; padding: 6px;"> <span t-esc="'%.2f' % r['compressive_strength']"/></td>

    
    <t t-if="(line_count + 3) % 3 == 0">
        <td style="border: 1px solid black; padding: 6px; text-align: center; vertical-align: middle;" t-att-rowspan="4">
            <span t-esc="r['avg_compressive_strength']" t-options='{"widget": "float", "precision": 2}'/>
        </td>
    </t>

    <t t-set="line_count" t-value="line_count + 1"/>


     <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['type_of_failure']"/></td>
   </tr>

   </tbody>
      </table>

                    
          </div>
                     <!-- Static sample data -->
