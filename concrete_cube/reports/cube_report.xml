									<span>
									Date of Testing
									</span>
								</th>
								
								<th style="text-align: center;font-weight: bold;">
									<span>
										Load (kN)
									</span>
								</th>

								<th style="text-align: center;font-weight: bold;">
									<span>
										Compressive Strength (N/mm2)
									</span>
								</th>
							
							</tr>
						</thead>
						<tbody>
							<tr t-foreach="data.child_lines" t-as="r">
								<td style="text-align: center;">
									<span t-esc="r.sr_no"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.id_mark"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.wt_sample"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.dt_of_casting"/>
								</td>
								<!-- <td style="text-align: center;">
									<span t-esc="r.days" />
								</td> -->
								<td style="text-align: center;">
									<span t-esc="r.dt_of_testing1"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.load"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								
							</tr>
						</tbody>
					</table>

						<table style="margin-top:5px" class="custom_table_borders">
							<!-- <tr>
								<td colspan="12">Avg. Compressive Strength N/mm2 :<![CDATA[&nbsp;]]>
									<span t-field="data.average_strength"/>
								</td>
							</tr> -->
							<!-- <div style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 100%;"> -->
                           
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
