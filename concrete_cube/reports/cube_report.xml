<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mechanical_concrete_cube_form" model="ir.ui.view">
            <field name="name">mechanical.concrete.cube.form</field>
            <field name="model">mechanical.concrete.cube</field>
            <field name="arch" type="xml">
                <form string="Compressive Strength of Concrete Cube">
                    <sheet>
                        <!-- Header Information -->
                        <group>
                            <group>
                                <div class="o_form_label">Issue No.: -</div>
                                <div class="o_form_label">Revision No</div>
                            </group>
                            <group>
                                <div class="o_form_label">"Bhumanthan", Survey No. 50/1, Parkhe Vasti, Near Hirai Sitai Mandir, Hinjewadi, Pune- 411057.</div>
                            </group>
                        </group>

                        <group>
                            <group>
                                <div class="o_form_label">Issue Date: -</div>
                                <div class="o_form_label">Revision Date:</div>
                            </group>
                            <group>
                                <div class="o_form_label">TEST REPORT-CONCRETE CUBE/CORE SAMPLES-GCPL/QF/7-8-E</div>
                            </group>
                        </group>

                        <group>
                            <div class="o_form_label">W: www.genstru.com E: email@genstru.in</div>
                        </group>

                        <separator/>

                        <!-- Mechanical Testing Section -->
                        <div class="o_form_label">Mechanical Testing</div>
                        <div class="o_form_label">Building material</div>
                        <div class="o_form_label">ULR-</div>

                        <separator/>

                        <!-- Project Information -->
                        <group>
                            <group>
                                <label for="project_name" string="Project Name:"/>
                                <field name="project_name"/>
                            </group>
                            <group>
                                <div class="o_form_label">Date of Report: DD/MM/YYYY</div>
                            </group>
                        </group>

                        <group>
                            <group>
                                <label for="customer_address" string="Name and Address of Customer:"/>
                                <field name="customer_address"/>
                            </group>
                            <group>
                                <div class="o_form_label">Date Sample Received: DD/MM/YYYY</div>
                            </group>
                        </group>

                        <group>
                            <group>
                                <label for="report_no" string="Report No.:"/>
                                <field name="report_no"/>
                            </group>
                            <group>
                                <div class="o_form_label">Starting Date: DD/MM/YYYY</div>
                            </group>
                        </group>

                        <group>
                            <group>
                                <label for="type_of_sample" string="Type of Sample:"/>
                                <field name="type_of_sample"/>
                                <label for="grade" string="Grade of concrete:"/>
                                <field name="grade"/>
                                <label for="curing_condition" string="Curing Condition:"/>
                                <field name="curing_condition"/>
                            </group>
                            <group>
                                <div class="o_form_label">Completion Date: DD/MM/YYYY</div>
                            </group>
                        </group>

                        <!-- Machine Details -->
                        <group>
                            <group>
                                <label for="machine_details" string="Details of Machine:"/>
                                <field name="machine_details"/>
                                <label for="loading_capacity" string="Loading capacity:"/>
                                <field name="loading_capacity"/>
                                <label for="calibration_date" string="Calibration date:"/>
                                <field name="calibration_date"/>
                            </group>
                            <group>
                                <label for="structure_details" string="Details of the structure:"/>
                                <field name="structure_details"/>
                            </group>
                        </group>

                        <separator/>

                        <!-- Test Results Table -->
                        <div class="o_form_label">Test Results</div>
                        <field name="child_lines">
                            <tree editable="bottom">
                                <field name="sr_no" string="Sr.No."/>
                                <field name="id_mark" string="Identification Mark"/>
                                <field name="dt_of_casting" string="Date of Casting"/>
                                <field name="dt_of_testing1" string="Date of Testing"/>
                                <field name="days" string="Age of Specimen (days)"/>
                                <field name="room_temp" string="Room temperature"/>
                                <field name="relative_humidity" string="Relative Humidity"/>
                                <field name="wt_sample" string="Weight of cube"/>
                                <field name="length" string="Length"/>
                                <field name="diameter" string="Diameter"/>
                                <field name="cross_sectional_area" string="Cross sectional area"/>
                                <field name="load" string="Maximum Load"/>
                                <field name="compressive_strength" string="Compressive strength"/>
                                <field name="avg_compressive_strength" string="Average Compressive strength"/>
                                <field name="type_of_failure" string="Type of Failure"/>
                            </tree>
                        </field>

                        <!-- Grade Reference Table -->
                        <div class="o_form_label">Grade Reference Values</div>
                        <field name="grade_child_lines">
                            <tree editable="bottom">
                                <field name="sr_no" string="Sr.No."/>
                                <field name="grade1" string="Grade"/>
                                <field name="sd" string="Standard Deviation"/>
                            </tree>
                        </field>

                        <!-- Calculations Section -->
                        <group>
                            <div class="o_form_label">Calculations</div>
                            <field name="area_of_cube" string="Area of Cube (mm²)" readonly="1"/>
                            <field name="average_strength" string="Average Compressive Strength (N/mm²)" readonly="1"/>
                            
                            <group string="7 Days Calculation">
                                <field name="days_7_kmm" string="Strength (N/mm²)" readonly="1"/>
                                <field name="days_7_n" string="Load (kN)" readonly="1"/>
                            </group>
                            
                            <group string="28 Days Calculation">
                                <field name="days_28_kmm" string="Strength (N/mm²)" readonly="1"/>
                                <field name="days_28_n" string="Load (kN)" readonly="1"/>
                            </group>
                        </group>

                        <!-- Age and Testing Information -->
                        <group>
                            <field name="age_of_days" string="Age of Testing"/>
                            <field name="date_of_casting" string="Date of Casting" readonly="1"/>
                            <field name="date_of_testing" string="Date of Testing" readonly="1"/>
                            <field name="age_of_test" string="Age of Test (days)" readonly="1"/>
                            <field name="difference" string="Difference from Required Age" readonly="1"/>
                        </group>

                        <!-- Results and Compliance -->
                        <group>
                            <field name="confirmity" string="Conformity" readonly="1"/>
                            <field name="nabl" string="NABL Compliance" readonly="1"/>
                        </group>

                        <separator/>

                        <!-- Remarks Section -->
                        <div class="o_form_label">Remarks:</div>
                        <div class="o_form_label">1) *Refer to Annexure- I (A) to know NABL accredited scope, range and uncertainty of measurement for test parameter</div>
                        <div class="o_form_label">2) Mode of failure for Compressive strength of Cube Test : A] Non-Explosive B] Semi-Explosive C] Explosive D]Un-Satisfactory</div>
                        <div class="o_form_label">3) Mode of failure for Compressive strength of Cylinder Test : A] Cone B] Cone and Split C] Cone and Shear D] Shear E] Columnar</div>
                        <div class="o_form_label">4) Correction factor for cube is 1 while for Cylinder is 5/4</div>
                        
                        <div class="o_form_label">Notes:-</div>
                        <div class="o_form_label">a. The information marked with an # received from customer</div>
                        <div class="o_form_label">b. The results listed refer only to tested parameters and sample as received from customer</div>
                        <div class="o_form_label">c. The balance samples if any will be discarded after 15 days from the date of issue of test certificate unless otherwise specified.</div>
                        <div class="o_form_label">d. This document shall not be reproduced in part or full without the approval of Genstru.</div>

                        <separator/>

                        <!-- Signatures Section -->
                        <group>
                            <group>
                                <div class="o_form_label">Assistant Technical Manager</div>
                                <div class="o_form_label">Stamp</div>
                            </group>
                            <group>
                                <div class="o_form_label">Authorized Signatory</div>
                            </group>
                        </group>

                        <group>
                            <group>
                                <div class="o_form_label">Prepared By</div>
                            </group>
                            <group>
                                <div class="o_form_label">Reviewed &amp; Issued By</div>
                            </group>
                        </group>

                        <group>
                            <group>
                                <div class="o_form_label">Prepared and Issued By:</div>
                            </group>
                            <group>
                                <div class="o_form_label">Reviewed By:</div>
                            </group>
                            <group>
                                <div class="o_form_label">Approved By:</div>
                            </group>
                        </group>

                        <group>
                            <group>
                                <div class="o_form_label">Quality manager</div>
                            </group>
                            <group>
                                <div class="o_form_label">Technical Manager</div>
                            </group>
                            <group>
                                <div class="o_form_label">Managing Director</div>
                            </group>
                        </group>

                        <div class="o_form_label">Controlled Copy</div>

                    </sheet>
                    
                    <footer>
                        <button name="action_calculate_avg_strength" string="Calculate Average Strength" type="object" class="btn-primary"/>
                        <button name="open_eln_page" string="Update ELN" type="object" class="btn-secondary"/>
                        <button string="Close" special="cancel" class="btn-default"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_mechanical_concrete_cube_tree" model="ir.ui.view">
            <field name="name">mechanical.concrete.cube.tree</field>
            <field name="model">mechanical.concrete.cube</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="project_name"/>
                    <field name="report_no"/>
                    <field name="average_strength"/>
                    <field name="confirmity"/>
                    <field name="nabl"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="action_mechanical_concrete_cube" model="ir.actions.act_window">
            <field name="name">Concrete Cube Tests</field>
            <field name="res_model">mechanical.concrete.cube</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_mechanical_concrete_cube_tree"/>
        </record>

        <!-- Menu Item - Commented out since the parent doesn't exist -->
        <!-- You can uncomment and change the parent to an existing menu when you know the correct one -->
        <!-- 
        <menuitem id="menu_mechanical_concrete_cube" 
                  name="Concrete Cube Tests" 
                  parent="put_correct_parent_here"
                  action="action_mechanical_concrete_cube"
                  sequence="10"/>
        -->
    </data>
</odoo>