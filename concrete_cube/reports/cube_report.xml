<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="compresive_concrete_cube_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->
				<div class="container_eln">
					<div class="" t-foreach="eln" t-as="o">
						<table style="margin-top:10px; width: 100%; border-collapse: collapse;">
							<tbody>
								<tr>
									<td style="width: 30%; padding: 5px;"><strong>Client Details</strong></td>
									<td style="padding-left: 10px;">
										<span t-field="o.srf_id.customer.name"/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
									</td>
								
								</tr>
								
								<tr>
									<td><strong>Client's Reference</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.srf_id.client_refrence"/></td>
								</tr>

								<tr>
									<td><strong>Name of Work</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.srf_id.name_work"/></td>
								</tr>

								<tr>
									<td><strong>Date of Testing</strong></td>
									<td style="padding-left: 10px;">
										<span t-field="o.start_date" style="margin-right:10px;"/> to 
										<span t-field="o.end_date" style="margin-left:10px;"/>
									</td>
								</tr>

								<tr>
									<td><strong>Type of Sample</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>
								</tr>

								<tr>
									<td><strong>Grade of Sample</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.grade_id.grade"/></td>
								</tr>

								<!-- Source of Sample (only if value exists) -->
								<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td><span t-field="o.material.source_sample"/></td>
								</tr>

								<!-- Test method adopted (only if value exists) -->
								<tr t-if="o.material.test_method_adopted">
									<td style="font-weight: bold;">Test method adopted:</td>
									<td><span t-field="o.material.test_method_adopted"/></td>
								</tr>
							</tbody>
						</table>
					</div>
					
					<!-- <div style="margin-top:20px;">
						<u>Protocol : <span t-esc="o.material.test_parameter"/></u>

					</div> -->
					<!-- <div style="padding-top:5px">
						<span t-esc="eln.material.test_parameter"/>
					</div> -->
					<!-- <div style="text-align:center;font-size:18px">
						<span t-field="env['lerm.parameter.master'].search([('internal_id','=','23545tur-17c1-48ac-8462-9671e4d3d09f')]).parameter_name"/>
					</div> -->
					<div>
						<span></span>
					</div>
					<div style="padding-top:5px">
						<span style="font-weight: bold;" t-esc="eln.material.test_parameter"/>: 
						
						
							<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','23545tur-17c1-48ac-8462-9671e4d3d09f')]).parameter_table" t-as="parameter">
								<t t-if="parameter.grade.id == eln.grade_id.id">
									<span t-field="parameter.specification"/>
								</t>
							</t>
						
					</div>
					<!-- <td style="text-align: center;vertical-align: middle;">
						
					</td> -->

					<table>
						<thead>
							<tr  style="text-align: center;">
								<th style="text-align: center;font-weight: bold;">
									<span>
										Sr. No
									</span>
								</th>
								<th style="text-align: center;font-weight: bold;">
									<span>
										ID MARK/Location
									</span>
								</th>
								<th style="text-align: center;font-weight: bold;width:100px;">
									<span>
										Grade
									</span>
								</th>
								<th style="text-align: center;font-weight: bold;">
									<span>
										Length in mm
									</span>
								</th>
								<th style="text-align: center;font-weight: bold;">
									<span>
										Width in mm
									</span>
								</th>
								<th style="text-align: center;font-weight: bold;">
									<span>
										Area in mm²
									</span>
								</th>
								
								<th style="text-align: center;font-weight: bold;">
									<span>
										Weight of sample in kg
									</span>
								</th>

								<th style="text-align: center;font-weight: bold;">
									<span>
										Crushing load in KN
									</span>
								</th>
								<th style="text-align: center;font-weight: bold;padding-left:1px; padding-right:1px;">
									<span>
										Compressive Strength in N/mm2
									</span>
								</th>
								
							</tr>
						</thead>
						<tbody>
							<!-- <t t-set="i" t-value="0"/> -->
							<!-- non nabl -->
							<!-- <tr  t-foreach="data.child_lines" t-as="r" t-if="data.nabl == 'fail' and not nabl">  -->
							<!-- <tr t-foreach="data.child_lines" t-as="r"  t-if="data.nabl == 'fail' and not nabl">
								<td style="text-align: center;">
									<span t-esc="r.sr_no"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.id_mark"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="o.sample_id.grade_id.grade"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.length" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.width" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.area" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r.wt_sample" t-options='{"widget": "float", "precision": 3}'/>
