<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="compresive_concrete_cube_report">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln" style="padding-top:0;">
					<div class="" t-foreach="eln" t-as="o">
						<table style="margin-top:5px;" class="header_table">
							<tbody>
								<tr>
									<td style="width: 25%;"><strong>Name of Work</strong></td>
									<td colspan="5"><span t-field="o.srf_id.name_work"/></td>
								</tr>
								<tr>
									<td><strong>Customer Name</strong></td>
									<td colspan="5"><span t-field="o.srf_id.customer.name"/></td>
								</tr>
								<tr>
									<td><strong>Address</strong></td>
									<td colspan="5"><span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
									</td>
								</tr>
								<tr>
									<td><strong>Location of Performance</strong></td>
									<td colspan="2"><span t-field="o.sample_id.location_name"/></td>
									<td t-if="o.sample_id.lab_id" colspan="2"><strong>Sample ID</strong></td>
									<td t-if="o.sample_id.lab_id"><span t-field="o.sample_id.lab_id"/></td>
								</tr>
								<tr>
									<td><strong># Nature of work</strong></td>
									<td colspan="2"><span t-field="data.nature_work"/></td>
									<td colspan="2"><strong># Date of Casting</strong></td>
									<td><span t-field="data.date_of_casting"/></td>
								</tr>
								<tr>
									<td><strong># Description &amp; Grade of Concrete</strong></td>
									<td colspan="2"><span t-field="o.grade_id.grade"/> <span t-field="o.material.name"/></td>
									<td colspan="2"><strong>Received Date</strong></td>
									<td><span t-field="o.sample_id.sample_received_date"/></td>
								</tr>
								<tr>
									<td><strong># Age of Specimen</strong></td>
									<td colspan="2"><span t-field="data.age_of_days"/></td>
									<td colspan="2"><strong>Date of Test</strong></td>
									<td><span t-field="o.end_date"/></td>
								</tr>
								<tr>
									<td><strong>Curing Condition</strong></td>
									<td colspan="2"><span t-field="data.curing_condition"/></td>
									<td colspan="2"><strong>Date of Issue</strong></td>
									<td><span t-field="o.end_date"/></td>
								</tr>
								<tr>
									<td><strong>Machine Used For Testing / Loading Range</strong></td>
									<td colspan="2"><span t-field="data.machine_testing"/></td>
									<td colspan="2"><strong>Date of Calibration</strong></td>
									<td><span t-field="data.date_of_calibration"/></td>
								</tr>
								<tr>
									<td><strong>Type of Failure</strong></td>
									<td style="width: 25%;"><span t-field="data.type_of_failure"/></td>
									<td style="width: 12.5%;"><strong>Temp</strong></td>
									<td style="width: 12.5%; text-align: center;"><span t-field="data.temp"/>° C</td>
									<td style="width: 12.5%;"><strong>Humidity</strong></td>
									<td style="width: 12.5%; text-align: center;"><span t-field="data.humidity"/>%</td>
								</tr>
								<tr>
									<td><strong>Condition of Sample</strong></td>
									<td colspan="5"><span t-field="o.sample_id.sample_condition"/></td>
								</tr>
								<tr>
									<td><strong>Discipline</strong></td>
									<td colspan="5"><span t-field="o.sample_id.discipline_id.discipline"/></td>
								</tr>
								<!-- <tr t-if="o.material.source_sample">
									<td><strong>Source of Sample</strong></td>
									<td colspan="5">: <span t-field="o.material.source_sample"/></td>
								</tr> -->
							</tbody>
						</table>
					</div>
					<div style="">
						<table class="custom_table_borders">
							<thead>
								<tr>
									<th style="text-align: center; font-weight: bold; width: 4%;">Sr. No</th>
									<th style="text-align: center; font-weight: bold; white-space: nowrap;">Identification Mark</th>
									<th style="text-align: center; font-weight: bold;">Dimension of Specimen (mm)</th>
									<th style="text-align: center; font-weight: bold; width: 10%;">Weight of  Specimen (gms)</th>
									<th style="text-align: center; font-weight: bold; width: 9%;">Density (gms/cc)</th>
									<th style="text-align: center; font-weight: bold; width: 9%;">Maximum Load(KN)</th>
									<!-- <th style="text-align: center; font-weight: bold; width: 9%;">Date of casting</th>
									<th style="text-align: center; font-weight: bold; width: 9%;">Date of Testing</th> -->
									<!-- <th style="text-align: center; font-weight: bold; width: 6%;">Load (kN)</th> -->
									<th style="text-align: center; font-weight: bold; width: 13%;">Comp. Strength (N/mm2)</th>
									<th style="text-align: center; font-weight: bold; width: 15%;">Avg. Comp. Strength (N/mm2)</th>
								</tr>
							</thead>

							<tbody>
								<t t-set="lines" t-value="data.child_lines"/>
								<t t-set="line_count" t-value="0"/>
								<t t-foreach="lines" t-as="r">
								<tr>
									<td style="text-align: center;"><span t-esc="r.sr_no"/></td>
									<td style="text-align: center; white-space: nowrap;"><span t-esc="r.id_mark"/></td>
									<td style="text-align: center;"><span t-esc="r.dimension"/></td>
									<td style="text-align: center;"><span t-esc="r.wt_sample"/></td>
									<td style="text-align: center;"><span t-esc="r.density"/></td>
									<!-- <td style="text-align: center;"><span t-esc="r.wt_sample"/></td> -->
									<!-- <t t-if="r.dt_of_casting">
										<td style="text-align: center;">
											<span t-esc="r.dt_of_casting.strftime('%d-%m-%y')"/>
										</td>
									</t>
									<t t-else="">
										<td style="text-align: center;"><span t-esc="r.dt_of_casting"/></td>
									</t>
									<t t-if="r.dt_of_testing1">
										<td style="text-align: center;">
											<span t-esc="r.dt_of_testing1.strftime('%d-%m-%y')"/>
										</td>
									</t>
									<t t-else="">
										<td style="text-align: center;"><span t-esc="r.dt_of_testing1"/></td>
									</t> -->
									<td style="text-align: center;"><span t-esc="r.load"/></td>
									<td style="text-align: center;">
										<span t-esc="r.compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
									</td>

									<t t-if="line_count % 3 == 0">
										<td style="text-align: center; vertical-align: middle;" t-att-rowspan="3">
											<span t-esc="r.avg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
										</td>
									</t>
								</tr>
								<t t-set="line_count" t-value="line_count + 1"/>
								</t>
							</tbody>
						</table>
					</div> 



					 <!-- 3. Water Absorption -->

					<div t-if="data.water_absorption_visible" style="margin-top:5px;">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','30214iu-eba3-4f15-b33d-679b39f73301')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','30214iu-eba3-4f15-b33d-679b39f73301')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
						<table style="margin-top:5px">
							<thead >
								<tr cols="12">
									<td >Sr no 
									</td>

									<td  style="text-align:center;">Sample Identification

									</td>

									<td  style="text-align:center;">Dry wt (W1)

									</td>
								
									<td  style="text-align:center;">Wet wt (W2)
									</td>

									<td  style="text-align:center;"> Water Absorption %
									</td>

								
								
								
								</tr>
							</thead>
							<tbody>
								<t t-set="i" t-value="0"/>
								<tr t-foreach="data.water_absorption_child_lines" t-as="r">
									<td  style="text-align:center;">
										<div>
											<span t-esc="i + 1" />
											<t t-set="i" t-value="i+1"/>
										</div>
									</td >
									<td  style="text-align:center;">
										<span t-esc="r['sample_identification']" />
									</td>
									<td   style="text-align:center;">
										<span t-esc="r['dry_wt_w1']" />
									</td>
									<td  style="text-align:center;">
										<span t-esc="r['wet_w2']" />
									</td>
									<td  style="text-align:center;">
										<span t-esc="r['water_absorption']" />
									</td>
								

									
								</tr>
							</tbody>
						</table>

						<!-- <table style="margin-top:5px">
                            <tr cols="12">
                                <td colspan="6"><b>Water Absorption (%):</b></td>
                                <td colspan="6" style="text-align: center;">
                                    <span t-field="data.avg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                            
                          
                        </table> -->

						<table style="margin-top:5px">
							<tr>
								<td colspan="12">Water Absorption:</td>
								<![CDATA[&nbsp;]]>
								<td>
									<span t-field="data.avg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td>
							(%)
								</td>
							</tr>
						</table>
					</div>

					<div t-if="data.wpt_visible" style="margin-top:5px;">
                        <div style="text-align:center;font-size:18px">
							<span t-field="env['lerm.parameter.master'].search([('internal_id','=','1023457-0268-46ef-ba88-9c0453210lkit1')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','1023457-0268-46ef-ba88-9c0453210lkit1')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
							<table style="margin-top:5px" >
								<tr cols="12">
									<td colspan="1">Sr no 
									</td>
									<td colspan="1">Sample 
									</td>
									<td colspan="1">Depth of Penetration 1
									</td>
									<td colspan="2">Depth of Penetration 2
									</td>
									<td colspan="2">Depth of Penetration 3
									</td>
									<td colspan="2">Average
									</td>
									
								</tr>

								<t t-set="i" t-value="0"/>
								<tr t-foreach="data.wpt_child_lines" t-as="r">
									<td colspan="1">
										<div>
											<span t-esc="i + 1" />
											<t t-set="i" t-value="i+1"/>
										</div>
									</td>
									<td colspan="1">
										<span t-esc="r['sample']"/>
									</td>
									<td colspan="1">
										<span t-esc="r['depth1']"/>
									</td>
									<td colspan="2">
										<span t-esc="r['depth2']"/>
									</td>
									<td colspan="2">
										<span t-esc="r['depth3']"/>
									</td>
									<td colspan="2">
										<span t-esc="r['average']"/>
									</td>
									
								</tr>
							</table>
							<table style="margin-top:5px">
								<tr cols="12">
									<td colspan="6">Average Of WPT :
										<![CDATA[&nbsp;]]>
									</td>
									<td colspan="6">
										<span t-field="data.average_of_wpt"/>
									</td>
									
								</tr>
								
							</table>
						</div>
					</div>

					<div style="margin-top:5px; page-break-inside: avoid;" class="noteContainer">
						<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<t t-if="data.notes_id">
										<b>Notes:-</b>

										<t t-foreach="data.notes_id" t-as="n">
											<span>
												(<t t-esc="n.sr_no"/>) 
												<t t-esc="n.notes"/>
												&#160;&#160;
											</span><br/>
										</t>
									</t>
								</td>
							</tr>
						</table>
						</div>
						<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 50px;">
									<t t-if="eln.sample_id.checkby_signature_required and eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')"
											style="max-width: 200px; max-height: 45px; margin-top: 1px; z-index: -10;"/>
									</t>
								</div>

								

								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
					<div>
						<div>
							<b>
								Approved By 
							</b>
							
						</div>
						<div style="height: 50px;">
							<t t-if="eln.sample_id.approveby_signature_required">
								<div t-if="eln.sample_id.approved_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>
						
						<div>
							<b>
							<span t-esc="eln.sample_id.approved_by.name"/>
							</b>
						</div>
						
						<div>
							<b>
								(<span t-esc="eln.sample_id.approved_by.job_title"/>)
							</b>
						</div>
					</div>
						</div>
						<div t-if="stamp_image" style="text-align:center;margin-bottom:10px">
							<img t-attf-src="data:image/png;base64,{{stamp_image}}" style="width:200px;"/>
						</div>
						<!-- <div style="text-align:center;margin-top:25px">
							......End of Report......
						</div> -->
						<div style="margin-top: 5px; text-align: center;">
							<p style="font-weight:800;">...... End Of Report......</p>
						</div>
					</div>
				<!-- </div> -->
			</t>
		</t>
	</template>
    </odoo>