<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	
	 <template id="compresive_concrete_cube_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			

			<!-- <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln_general"> -->
			<t t-call="lerm_civil.genstru_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report on GGBS Mechanical</b></p>
				</div> -->
				<div class="container_eln" style="padding-top:0px;">
					<div class="" t-foreach="eln" t-as="o">
						
					
						 <table class="table table-sm" style="width: 100%; border-collapse: collapse;" border="1">
							<tr>
								<!-- <td ><strong>Mechanical Testing</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.material.name"/></td> -->
								<td colspan="3"><strong>Report No</strong>: </td>
								<td colspan="3" style="padding-left: 10px;"><span t-field="o.sample_id.kes_no"/></td>
								<td colspan="3" ><strong>URL NO</strong>: </td>
								<td colspan="3" style="padding-left: 10px;"><span t-field="o.sample_id.ulr_no"/></td>
							</tr>

							<tr>
								<td colspan="3"><strong>Project Name</strong>: </td>
								<td colspan="9" style="padding-left: 10px;"><span t-field="o.srf_id.name_work"/></td>

								<!-- <td><strong>Date of Report</strong>: </td>
									
								<td >
								<span t-field="o.start_date" style="margin-right:10px;"/> 		
								</td> -->
							</tr>
						
							
						
							<tr>
							<td colspan="3" style="width:20%;"><strong>Name &amp; Address of Customer</strong>: </td>
							<td colspan="3" style="padding-left: 10px;width:25%;">
										<span t-field="o.srf_id.customer.name"/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
								</td>
								<!-- <td><strong>Date Sample Received</strong>: </td> -->
								<!-- <td >
								<span t-field="o.sample_id.sample_received_date"/>
								</td > -->
								

								<td colspan="3"><strong>Date Sample Received</strong>:</td>
								<td colspan="3">
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								
								<td colspan="3" ><strong>Mechanical Testing</strong>: </td>
								<td colspan="3" style="padding-left: 10px;"><span t-field="o.material.name"/></td>

								<td colspan="3"><strong>Location</strong>: </td>
								<td colspan="3">
								Permanent facility
							        <!-- <span t-field="o.start_date" style="margin-right:10px;"/> -->
								</td>
							
							</tr>

							<tr>
								
								
								<td colspan="3"><strong>Date of Report</strong>: </td>
									
								<td colspan="3">
								<span t-field="o.start_date" style="margin-right:10px;"/> 		
								</td>

								<td colspan="3"><strong>Starting Date</strong>: </td>
								<td colspan="3">
							        <span t-field="o.start_date" style="margin-right:10px;"/>
								</td>
							
							</tr>
							
							<tr>

								<td colspan="3"><strong>Type of Sample &amp; Condition</strong>: </td>
								<td colspan="3"><span t-field="o.material.name"/></td>

							<td colspan="3"><strong>Completion Date</strong>: </td>
								<td colspan="3">
								<span t-field="o.end_date" />
								</td>
						</tr>

						

							
						</table>

						</div>

                   <div>
                
                        <div style="margin-top: 30px;">
                            <!-- Type of Sample Details -->
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 12px;">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Type of Sample:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.type_of_sample"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Grade of concrete:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="o.grade_id.grade"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Curing Condition:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.curing_condition"/></td>
                                </tr>
                            </table>

                              <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 12px;">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Details of Machine:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.machine_details"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Loading capacity:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.loading_capacity"/></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><strong>Calibration date:</strong></td>
                                    <td style="border: 1px solid #000; padding: 8px; width: 16%;"><span t-field="data.calibration_date"/></td>
                                </tr>
                            </table>
                    </div>

                    <!-- ADDED TABLE FROM IMAGE -->
                <div style="margin-top: 30px;">
                        <!-- Main Test Results Table -->
                       <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <thead>
                                <tr  t-if="data.cube_visible and (data.average_strength_nabl == 'pass' and nabl or (data.average_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)" style="background-color:#f0f0f0; text-align: center;">
                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Sr No.</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Identification Mark</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Date of Casting</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Date of Testing</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Age of Specimen (days)</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Room temperature (&amp;deg;C)</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Relative Humidity (%)</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Weight of cube (gms)</th>

                                    <th  style="border: 1px solid black; padding: 8px;" t-att-colspan="data.type_of_sample == 'cube' and 2 or 2"> Plan Dimensions of Testing Faces (mm)</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Cross sectional area (mm&amp;sup2;)</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Maximum Load (kN)</th>
                                   
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2">Compressive strength (N/mm&amp;sup2;)</th>
                                    <th  style="border: 1px solid black; padding: 8px;" rowspan="2"> Average Compressive strength (N/mm&amp;sup2;)</th>

                                    <th style="border: 1px solid black; padding: 8px;" rowspan="2">Type of Failure</th>
                                </tr>
                                <tr>

                                  <th style="border: 1px solid black; padding: 8px;" colspan="1">Length (mm)</th>
                                 <th t-if="data.type_of_sample == 'cylinder'"  style="border: 1px solid black; padding: 8px;" colspan="1">Diameter (mm)</th>
                                 <th t-if="data.type_of_sample == 'cube'" style="border: 1px solid black; padding: 8px;" colspan="1">Width (mm)</th>
                                </tr>
                            </thead>
                            <tbody>
                        


                     <t t-set="line_count" t-value="0"/>


                    <tr  t-if="data.cube_visible and (data.average_strength_nabl == 'pass' and nabl or (data.average_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)" t-foreach="data.child_lines" t-as="r" style="text-align: center;">
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['sr_no']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['id_mark']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['dt_of_casting']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['dt_of_testing1']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['days']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['room_temp']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['relative_humidity']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['wt_sample']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['length']"/></td>
                    <td t-if="data.type_of_sample == 'cylinder'" style="border: 1px solid black; padding: 6px;"><span t-esc="r['diameter']"/></td>
                    <td t-if="data.type_of_sample == 'cube'"  style="border: 1px solid black; padding: 6px;"><span t-esc="r['width']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="'%.2f' % r['cross_sectional_area']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['load']"/></td>
                    <td style="border: 1px solid black; padding: 6px;"> <span t-esc="'%.2f' % r['compressive_strength']"/></td>

    
                 <t t-if="(line_count + 3) % 3 == 0">
                        <td style="border: 1px solid black; padding: 6px; text-align: center; vertical-align: middle;" t-att-rowspan="4">
                            <span t-esc="r['avg_compressive_strength']" t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                     </t>

                    <t t-set="line_count" t-value="line_count + 1"/>


                     <td style="border: 1px solid black; padding: 6px;"><span t-esc="r['type_of_failure']"/></td>
                     </tr>
                     

                </tbody>
            </table>            
            </div>


                   


                    <!-- Machine Details -->
                    <group>
                        <group>
                            <label for="machine_details" string="Details of Machine:"/>
                            <field name="machine_details"/>
                            <label for="loading_capacity" string="Loading capacity:"/>
                            <field name="loading_capacity"/>
                            <label for="calibration_date" string="Calibration date:"/>
                            <field name="calibration_date"/>
                        </group>

                        
                        <group>
                            <label for="structure_details" string="Details of the structure:"/>
                            <field name="structure_details"/>
                        </group>
                    </group>

                    <separator/>

                    <!-- Age and Testing Information -->
                    <group>
                        <field name="age_of_days" string="Age of Testing"/>
                        <field name="date_of_casting" string="Date of Casting" readonly="1"/>
                        <field name="date_of_testing" string="Date of Testing" readonly="1"/>
                        <field name="age_of_test" string="Age of Test (days)" readonly="1"/>
                        <field name="difference" string="Difference from Required Age" readonly="1"/>
                    </group>

                    <!-- Results and Compliance -->
                    <group>
                        <field name="confirmity" string="Conformity" readonly="1"/>
                        <field name="nabl" string="NABL Compliance" readonly="1"/>
                    </group>

                    <separator/>


                  

                    <!-- Remarks Section -->

                    <div style="margin-top:50px" class="noteContainer">
						<table >
							<tr>
							
								<td style="padding: 5px; font-style: italic; font-size: 15px; line-height: 18px;">
									<b>Remarks:</b><br/><br/>
									    * Refer to Annexure-I for environmental and test conditions<br/><br/>
									    * Refer to Annexure-I (A) to know NABL accredited scope, range and uncertainty of measurement for test parameter<br/><br/>

									<b>Notes:-</b><br/><br/>
								    	<!-- a. The information marked with an # received from customer<br/><br/>
							        	b. The results listed refer only to tested parameters and sample as received from customer<br/><br/>
							        	c. The balance samples if any will be discarded after 15 days from the date of issue of test certificate unless otherwise specified.<br/><br/>
							        	d. This document shall not be reproduced in part or full without the approval of Genstru. -->

										<t t-if="data.notes_id">
										<t t-foreach="data.notes_id" t-as="n">
											<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span><br/><br/>
										</t>
									</t>
								</td>
							</tr>
							</table  >
						</div>
						<div class="signatureContainer girdgird">
							

				<table style="width:100%; border:1px solid black; border-collapse:collapse; font-family:Arial; font-size:12px; text-align:center;">
						    <tr style="height:100px;">
							
							<td style="width:33.33%; border-right:1px solid black; vertical-align:bottom; padding-bottom:5px;text-align:center;">
							<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										

									</t>
								</div>
								 <b>
										<span t-esc="eln.technician.name"/>
									</b><br/>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b><br/>
								<span style="font-size:12px;">Prepared By</span>
							</td>

							<td style="width:33.33%; border-right:1px solid black; vertical-align:bottom; padding-bottom:5px;text-align:center;">
								<b style="font-size:13px;">Stamp</b>
							</td>

							<td style="width:33.33%; vertical-align:bottom; padding-bottom:5px;text-align:center;">
							<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b><br/>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b><br/>
								<span style="font-size:12px;">Reviewed &amp; Issued By</span>
							</td>
						</tr>

					</table>

                   </div>
					
					</div>
               </div>
               
               
            </t>
        </t>
    </template>
</odoo>