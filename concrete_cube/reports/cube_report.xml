						 <!-- Remarks Section -->

                    <div style="margin-top:50px" class="noteContainer">
						<table >
							<tr>
							
								<td style="padding: 5px; font-style: italic; font-size: 15px; line-height: 18px;">
									<b>Remarks:</b><br/><br/>
									    * Refer to Annexure-I for environmental and test conditions<br/><br/>
									    * Refer to Annexure-I (A) to know NABL accredited scope, range and uncertainty of measurement for test parameter<br/><br/>

									<b>Notes:-</b><br/><br/>
								    	<!-- a. The information marked with an # received from customer<br/><br/>
							        	b. The results listed refer only to tested parameters and sample as received from customer<br/><br/>
							        	c. The balance samples if any will be discarded after 15 days from the date of issue of test certificate unless otherwise specified.<br/><br/>
							        	d. This document shall not be reproduced in part or full without the approval of Genstru. -->

										<t t-if="data.notes_id">
										<t t-foreach="data.notes_id" t-as="n">
											<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span><br/><br/>
										</t>
									</t>
								</td>
							</tr>
							</table  >
						</div>






						
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 50px;">
									<t t-if="eln.sample_id.checkby_signature_required and eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')"
											style="max-width: 200px; max-height: 45px; margin-top: 1px; z-index: -10;"/>
									</t>
								</div>

								

								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div>
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height: 50px;">
									<t t-if="eln.sample_id.approveby_signature_required">
										<div t-if="eln.sample_id.approved_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
							</div>
						</div>
						<!-- <div style="text-align:center;margin-top:25px">
							......End of Report......
						</div> -->
						<div style="margin-top: 10px; text-align: center;">
							<p style="font-weight:800;">...... End Of Report......</p>
						</div>
					</div>
				<!-- </div> -->
			</t>
		</t>
	</template>
    </odoo>