                                    <span field="data.avg_compressive_strength" />
                                </td>
                            </tr>
                        </table>
                    </div> -->

                    <!-- Remarks Section -->

                    <div style="margin-top:50px" class="noteContainer">
						<table >
							<tr>
							
								<td style="padding: 5px; font-style: italic; font-size: 15px; line-height: 18px;">
									<b>Remarks:</b><br/><br/>
									    * Refer to Annexure-I for environmental and test conditions<br/><br/>
									    * Refer to Annexure-I (A) to know NABL accredited scope, range and uncertainty of measurement for test parameter<br/><br/>

									<b>Notes:-</b><br/><br/>
								    	a. The information marked with an # received from customer<br/><br/>
							        	b. The results listed refer only to tested parameters and sample as received from customer<br/><br/>
							        	c. The balance samples if any will be discarded after 15 days from the date of issue of test certificate unless otherwise specified.<br/><br/>
							        	d. This document shall not be reproduced in part or full without the approval of Genstru.
								</td>
							</tr>
							</table  >
						</div>
						<div class="signatureContainer girdgird">
							

				<table style="width:100%; border:1px solid black; border-collapse:collapse; font-family:Arial; font-size:12px; text-align:center;">
						<tr style="height:100px;">
							
							<td style="width:33.33%; border-right:1px solid black; vertical-align:bottom; padding-bottom:5px;text-align:center;">
								<b style="font-size:13px;">Assistant Technical Manager</b><br/>
								<span style="font-size:12px;">Prepared By</span>
							</td>

							<td style="width:33.33%; border-right:1px solid black; vertical-align:bottom; padding-bottom:5px;text-align:center;">
