					<div style="margin-top:5px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Note:-</b>
									&#160;&#160;(i) The results relate only to the items tested 
									&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
									&#160;&#160;(iii) Any corrections invalidate the test reports 
									&#160;&#160;(iv) Any Query regarding the report must be reported immediately. 
									&#160;&#160;(v) * mark indicate tests which are not in the scope of NABL. 
									&#160;&#160;(vi) # mark indicates Details given by Client.
									<t t-if="eln.has_witness">
										&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
									</t>
									<t t-if="eln.remarks">
										&#160;&#160;<span t-esc="eln.remarks"/>
									</t>
								</td>
							</tr>
						</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 50px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>

								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>
							<!-- <div>
								<div t-if="stamp and stamp == '4-in_report'">
									<img t-attf-src="/lerm_civil/static/src/img/stamp.png" alt="Image"/>
