<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_concrete_cube_view" model="ir.ui.view">
            <field name="name">mechanical.concrete.cube.form</field>
            <field name="model">mechanical.concrete.cube</field>
            <field name="arch" type="xml">
                <form readonly="eln_state != '1-draft'">
                    <sheet>
                        <field name="eln_state"/>
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                        <group>
                            <field name="srf_id" invisible="1"/>
                            <field name="sample_id" readonly="1" />
                            <field name="parameter_id" invisible="1"/>
                            <field name="eln_ref" readonly="1"/>
                            <field name="grade" exception="grade"  string="Grade" identity="extra"/>   
                             <field name="size_id" readonly="1"/>
                             <field name="eln_state" />
                        </group>


                         <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>



                        <div class="custom_table_borders" style="margin-top: 15px;">
                            <field name="sample_parameters" nolabel="1">
                                <tree>
                                    <field name="parameter_name"/>
                                    <field name="test_method"/>
                                </tree>
                            </field>
                        </div>

                        <group  invisible="cube_visible == False">
                        <h1>
                            <field name="cube_name" readonly="1" nolabel="1"/>
                            <field name="cube_visible" invisible="1"/>
                        </h1>
                    </group>

                        <group style="white-space: nowrap; width:80%;" invisible="cube_visible == False" >
                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;" invisible="1">
                            <div style="width: 100%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                              grade

                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="grade2" nolabel="1" identity="extra" />
                                                </div>
                                            </td>
                                            <!-- <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                mm
                                            </td> -->
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </group>

                    <field name="grade_child_lines" nolabel="1" class="custom_table_borders" invisible="1" readonly="eln_state != '1-draft'">
                        <tree editable="bottom">
                            <field name='sr_no' string="Sr. NO"/>
                            <field name='grade1' />
                            <field name='sd' />                        
                        </tree>
                    </field> 

                    <div class="d-flex gap-2" invisible="cube_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_casting">Date of Casting</label></td>
                                    <td><field name="date_of_casting" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><label for="date_of_testing">Date of Testing</label></td>
                                    <td><field name="date_of_testing" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><label for="age_of_test">Age of Test, days</label></td>
                                    <td><field name="age_of_test" class="blue-input"/></td>
                                </tr>
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="age_of_days">Age of Cubes</label></td>
                                    <td><field name="age_of_days" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><label for="area_of_cube">Area of Cube</label></td>
                                    <td><field name="area_of_cube" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><label for="difference">Difference</label></td>
                                    <td><field name="difference" class="blue-input"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <field name="child_lines" nolabel="1" class="custom_table_borders" invisible="cube_visible == False" readonly="eln_state != '1-draft'">
                        <tree editable="bottom">
                            <field name='sr_no' string="Sr. NO"/>
                            <field name='id_mark' />
                            <field name='wt_sample'  widget="char" class="blue-input" decoration-info="wt_sample != 0"/>
                            <field name='dt_of_casting' widget="date" options="{'format': 'dd-MM-yy'}" readonly="1" class="blue-input" decoration-info="dt_of_casting != 0"/>
                            <field name='days' class="blue-input" decoration-info="days != 0"/>
                            <field name='dt_of_testing1'  widget="date" options="{'format': 'dd-MM-yy'}" readonly="1" class="blue-input" decoration-info="dt_of_testing1 != 0"/>
                            <field name="load"  widget="char" class="blue-input" decoration-info="load != 0"/>
                            <field name='compressive_strength'/>
                            <field name='avg_compressive_strength'/>
                        </tree>
                    </field> 

                   <div  invisible="cube_visible == False" > 
                    <button type="object" name="action_calculate_avg_strength" class="btn btn-primary mb-2">
                        <i class="fa fa-calculator mr-1"/> Calculate Average
                    </button>
                    </div>
                        
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="cube_visible == False" >
                        <tbody>
                           
                            <tr>
                                <td><label for="confirmity">confirmity</label></td>
                                <td>
                                    <field name="confirmity"  style="color: green;" invisible="confirmity != 'pass'"/>
                                    <field name="confirmity"  style="color: red;" invisible="confirmity != 'fail'"/>
                                    <field name="confirmity"  style="color: black;" invisible="confirmity != 'not_applicable'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="nabl">nabl</label></td>
                                <td>
                                    <field name="nabl"  style="color: green;" invisible="nabl != 'pass'"/>
                                    <field name="nabl"  style="color: red;" invisible="nabl != 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                        <div class="custom_table_borders" style="width:100%;" invisible="cube_visible == False" >
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                         Permissible Range
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                           N/mm2
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                           kN
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="days_7_kmm"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="days_7_kmm" nolabel="1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="days_7_n" nolabel="1"/>
                                        </td>
                                    </tr>

                                     <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="days_28_kmm"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="days_28_kmm" nolabel="1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="days_28_n" nolabel="1"/>
                                        </td>
                                    </tr>
                                    
                                </tbody>
                            </table>
                        </div>
                      
                       <group  invisible="wpt_visible == False" style="white-space: nowrap; width:80%;margin-top: 15px;">
                        <h1>
                            <field name="wpt_name" readonly="1" nolabel="1"/>
                            <field name="wpt_visible" invisible="1"/>
                        </h1>
                    </group>
                    <div invisible="wpt_visible == False">
                        <div style="display:flex;">
                    <div style="width:50%;">
                      <table style="border: 2px solid black; border-collapse: collapse; width: 99%;">
                         <tbody>
                            <tr>
                              <td style="border: 1px solid black; padding: 8px; font-weight: bold;"><span>Temperature °c</span></td>
                              <td style="border: 1px solid black; padding: 8px;"><field name="temp_wpt"/></td>
                            </tr>
                            <tr>
                            <td style="border: 1px solid black; padding: 8px; font-weight: bold;"><span>Humidity %</span></td>
                            <td style="border: 1px solid black; padding: 8px;"><field name="humidity_percent_wpt"/></td>
                            </tr>
                                 
                         </tbody>
                      </table>
                    </div>


                    <div style="width:50%;">
                      <table style="border: 2px solid black; border-collapse: collapse; width: 100%;">
                         <tbody>
                            <tr>
                              <td style="border: 1px solid black; padding: 12px; font-weight: bold;"><span>Quantity</span></td>
                              <td style="border: 1px solid black; padding: 8px;width:200px;"><field name="quantity"  exception="quantity" identity="extra"/></td>
                            </tr>
                            <!-- <tr>
                            <td style="border: 1px solid black; padding: 8px; font-weight: bold;"><span>Specimen Size (mm)</span></td>
                            <td style="border: 1px solid black; padding: 8px;width:200px;"><field name="size" exception="size" identity="extra"/></td>
                            </tr> -->
                            
                         </tbody>
                      </table>
                    </div>

                    </div>
                    <group/>


                    <group/>
                    <!-- <div style="display:flex;">
                    <div style="width:50%;">
                      <table style="border: 2px solid black; border-collapse: collapse; width: 99%;">
                         <tbody>
                            <tr>
                              <td style="border: 1px solid black; padding: 12px; font-weight: bold;"><span>Date of Casting</span></td>
                              <td style="border: 1px solid black; padding: 12px;width:200px;"><field name="date_of_casting" identity="extra"/></td>
                            </tr>                                 
                         </tbody>
                      </table>
                    </div>
                  
                    <div style="width:50%;">
                      <table style="border: 2px solid black; border-collapse: collapse; width: 100%;">
                         <tbody>
                            <tr>
                              <td style="border: 1px solid black; padding: 8px; font-weight: bold;"><span> Date of Testing</span></td>
                              <td style="border: 1px solid black; padding: 8px;"><field name="date_of_testing"  identity="extra"/></td>
                            </tr>                            
                         </tbody>
                      </table>
                    </div>

                    </div>
                    <group/>

                    <div>
                      <table class="table table-bordered sm-table" style="width: 100%;font-size: 15px; margin:0px;">
                         <tbody>
                         <tr>
                             <td><span>Age</span></td>
                             <td><field name="age_of_days" identity="extra"/></td>
                           </tr>
                           <tr>
                             <td><span>Age of Test, days</span></td>
                             <td><field name="age_of_test" identity="extra"/></td>
                           </tr>
                           <tr>
                             <td><span>Difference</span></td>
                             <td><field name="difference" identity="extra"/></td>
                           </tr>
                         </tbody>
                      </table>
                    </div>
                    <group/> -->






                   
                    <!-- <group/> -->
                    <group>
                      
                        <field name="wpt_child_lines" colspan="2" nolabel="1" readonly="eln_state != '1-draft'">
                        <tree editable="bottom" class="custom_table_borders">
                            <field name="sample" string="Sample"/>
                            <field name="depth1" string="1"/>
                            <field name="depth2" string="2"/>
                            <field name="depth3" string="3"/>
                            <field name="average" string="Average"/>
                        </tree>
                        </field>
                    </group>

                     <div>
                          <table style="border: 2px solid black; width: 50%; margin-top:10px;">
                           <tr>
                             <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Average of WPT</span></td>
                              <td style="padding: 8px; width:248px;"><field name="average_of_wpt" identity="extra"/></td>
                           </tr>                     
                          </table>
                        </div>
                    <group/>


                    <div>
                          <table style="width: 50%; margin-top:10px;">
                           <tr>
                             <td style="border: 2px solid black;padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="border: 2px solid black;padding: 8px;"><field name="wpt_conformity"
                               decoration-success="wpt_conformity == 'pass'" 
                               decoration-danger="wpt_conformity == 'fail'" 
                               readonly="1"
                               identity="extra"/></td>
                           </tr>
                           <tr>
                            <td style="border: 2px solid black;padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="border: 2px solid black;padding: 5px;"><field name="wpt_nabl"
                               decoration-success="wpt_nabl == 'pass'" 
                                decoration-danger="wpt_nabl == 'fail'" 
                               readonly="1"
                               identity="extra"/></td>
                           </tr>
                          </table>
                        </div>
                        </div>

                        <group invisible = "water_absorption_visible == False"  style="white-space: nowrap; width:80%;margin-top: 15px;">
                        <h1>
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                        </h1>
                    </group>


                  


                            <div class="custom_table_borders" style="width: 100%;"  invisible="water_absorption_visible == False">
                                <field name="water_absorption_child_lines" mode="tree" nolabel="1" readonly="eln_state != '1-draft'">
                                    <tree editable="bottom" class="custom_table_borders" style="width: 100%; border-collapse: collapse;">
                                        <field name="serial_no" />
                                        <field name="sample_identification" class="blue-input" decoration-info="sample_identification != 0"/>
                                        <field name="dry_wt_w1"  class="blue-input" decoration-info="dry_wt_w1 != 0"/>
                                        <field name="wet_w2"  class="blue-input" decoration-info="wet_w2 != 0"/>
                                        <field name="water_absorption"/>
                                    </tree>
                                </field>
                            </div>

                     <!-- <group invisible = "water_absorption_visible == False" string="Result" colspan="4"  style="white-space: nowrap; width:70%; margin-top: 10px">
                     
                        <field name="avg_water_absorption" readonly="1"/>
                        
                  
                    </group> -->

                    
                      <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "water_absorption_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_water_absorption">Avg. Water Absorption</label></td>
                                <td><field name="avg_water_absorption"/> <span> %</span></td>
                            </tr>
                           
                        </tbody>
                    </table>

                   
                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "water_absorption_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_conformity">NABL</label></td>
                                <td><field name="avg_water_absorption_conformity"
                                            decoration-success="avg_water_absorption_conformity == 'pass'"
                                            decoration-danger="avg_water_absorption_conformity == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_nabl">NABL</label></td>
                                <td><field name="avg_water_absorption_nabl"
                                            decoration-success="avg_water_absorption_nabl == 'pass'"
                                            decoration-danger="avg_water_absorption_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>






                           <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1" readonly="eln_state != '1-draft'">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>




                    

                        <group style="margin-top: 20px;">

                        <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cube_prefill_data_form" model="ir.ui.view">
            <field name="name">concrete.cube.prefill.data.form</field>
            <field name="model">concrete.cube.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cube_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">concrete.cube.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_cube_prefill_data_form"/>
            <field name="target">new</field>
        </record>

  
   
    </data>
</odoo>