                                <tree>
                                    <field name="parameter_name"/>
                                    <field name="test_method"/>
                                </tree>
                            </field>
                        </div>

                         <button name="action_generate_options_cube" 
                            type="object" 
                            string="Generate Lab ID" 
                            class="oe_highlight"/>

                    <field name="lab_cube_ids" invisible="1">
                        <tree editable="bottom">
                            <field name="lab"/>
                        </tree>
                    </field>


                        
                        <div style="text-align: center;" invisible="not cube_visible">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                            <field name="cube_visible" invisible="1"/>
                            <field name="cube_visible_14" invisible="1"/>
                            <field name="cube_visible_28" invisible="1"/>
                        </h1>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not cube_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_lab_cube1"></label></td>
                                    <td ><field name="selected_lab_cube1"/></td>
                                </tr>
                                
                            </tbody>
                        </table>


                        <!-- Test Configuration -->
                        <div class="d-flex gap-2">
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><label for="type_of_sample">Type of Sample</label></td>
                                        <td><field name="type_of_sample"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="machine_details">Details of Machine</label></td>
                                        <td><field name="machine_details"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="loading_capacity">Loading Capacity</label></td>
                                        <td><field name="loading_capacity"/> kN</td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
