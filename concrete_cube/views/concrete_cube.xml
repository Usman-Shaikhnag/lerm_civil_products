<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mechanical_concrete_cube_view" model="ir.ui.view">
            <field name="name">mechanical.concrete.cube.form</field>
            <field name="model">mechanical.concrete.cube</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <!-- Project Information -->
                        
                        
                            <group>
                           
                                <field name="eln_ref" readonly="1"/>
                                <field name="grade" string="Grade" identity="extra"/>   
                                <field name="size_id" readonly="1"/>
                            </group>
                       

                        <!-- Sample Parameters -->
                        <div class="custom_table_borders" style="margin-top: 15px;">
                            <label for="sample_parameters" string="Sample Parameters"/>
                            <field name="sample_parameters" nolabel="1">
                                <tree>
                                    <field name="parameter_name"/>
                                    <field name="test_method"/>
                                </tree>
                            </field>
                        </div>


                        
                        <div style="text-align: center;" invisible="not cube_visible">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                            <field name="cube_visible" invisible="1"/>
                        </h1>
                    </div>


                        <!-- Test Configuration -->
                        <div class="d-flex gap-2">
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><label for="type_of_sample">Type of Sample</label></td>
                                        <td><field name="type_of_sample"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="machine_details">Details of Machine</label></td>
                                        <td><field name="machine_details"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="loading_capacity">Loading Capacity</label></td>
                                        <td><field name="loading_capacity"/> kN</td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><label for="calibration_date">Calibration Date</label></td>
                                        <td><field name="calibration_date"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="curing_condition">Curing Condition</label></td>
                                        <td><field name="curing_condition"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="structure_details">Details of Structure</label></td>
                                        <td><field name="structure_details"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>



                        <!-- Environmental Conditions -->
                        <div class="d-flex gap-2">
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><label for="room_temperature">Room Temperature</label></td>
                                        <td><field name="room_temperature"/> °C</td>
                                    </tr>
                                    <tr>
                                        <td><label for="relative_humidity">Relative Humidity</label></td>
                                        <td><field name="relative_humidity"/> %</td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><label for="date_of_casting">Date of Casting</label></td>
                                        <td><field name="date_of_casting"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="date_of_testing">Date of Testing</label></td>
                                        <td><field name="date_of_testing"/></td>
                                    </tr>
                                    <tr>
                                        <td><label for="age_of_test">Age of Test, days</label></td>
                                        <td><field name="age_of_test"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Sample Test Results -->
                        <field name="child_lines" nolabel="1" class="custom_table_borders">
                            <tree editable="bottom">
                                <field name='sr_no' string="Sr. NO"/>
                                <field name='id_mark' string="Identification Mark"/>
                                <field name='dt_of_casting' string="Date of Casting" widget="date" options="{'format': 'dd-MM-yy'}" readonly="1"/>
                                <field name='dt_of_testing1' string="Date of Testing" widget="date" options="{'format': 'dd-MM-yy'}" readonly="1"/>
                                <field name='days' string="Age (days)"/>
                                <field name='room_temp' string="Room Temp (°C)"/>
                                <field name='relative_humidity' string="Relative Humidity (RH) (%)"/>
                                <field name='wt_sample' string="Weight (gms)"/>
                                <field name='length' string="Length (mm)"/>
                                <field name='diameter'   string="Diameter (mm)"/>
                                <field name='width'  string="width (mm)"/>
                                
                                <field name='cross_sectional_area' string="Area (mm²)" readonly="1"  digits ="[16,2]"/>
                                <field name="load" string="Load (kN)"/>
                                <field name='compressive_strength' string="Strength (N/mm²)" readonly="1" digits ="[16,2]"/>
                                <field name='avg_compressive_strength' string="Avg Strength (N/mm²)" readonly="1"/>  
                                <field name='type_of_failure' string="Type of Failure"/>
                            </tree>
                                </field> 


                                
                        <!-- Calculate Average Button -->
                        <button type="object" name="action_calculate_avg_strength" class="btn btn-primary mb-2">
                            <i class="fa fa-calculator mr-1"/> Calculate Average
                        </button>
                            
                    
                        <!-- Hidden Grade Lines -->
                        <field name="grade_child_lines" nolabel="1" class="custom_table_borders" invisible="1">
                            <tree editable="bottom">
                                <field name='sr_no' string="Sr. NO"/>
                                <field name='grade1' />
                                <field name='sd' />                        
                            </tree>
                        </field> 




                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                           <tbody>
                                  <tr>
                                <td><label for="average_strength"></label></td>
                                <td><field  name="average_strength"
                                
                                         /></td>
                            </tr>

                           
                                  <tr>
                                <td><label for="average_strength_conformity"></label></td>
                                <td><field  name="average_strength_conformity"
                                            decoration-success="average_strength_conformity == 'pass'" 
                                            decoration-danger="average_strength_conformity == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                            <tr>
                                <td><label for="average_strength_nabl"></label></td>
                                <td><field name="average_strength_nabl"
                                            decoration-success="average_strength_nabl == 'pass'" 
                                            decoration-danger="average_strength_nabl == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                                
                            </tbody>
                        </table>



                        <!-- Submit Button -->
                        <group style="margin-top: 20px;">
                            <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Tree View -->
        <record id="mechanical_concrete_cube_tree" model="ir.ui.view">
            <field name="name">mechanical.concrete.cube.tree</field>
            <field name="model">mechanical.concrete.cube</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="project_name"/>
                    <field name="grade2"/>
                    <field name="average_strength"/>
                    <field name="confirmity"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="mechanical_concrete_cube_action" model="ir.actions.act_window">
            <field name="name">Concrete Cube Tests</field>
            <field name="res_model">mechanical.concrete.cube</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first concrete cube test
                </p>
            </field>
        </record>
   
    </data>
</odoo>