                                <field name='id_mark' string="Identification Mark" width="100" class="blue-input" decoration-info="id_mark != 0"/>
                                <field name="dt_of_casting_formatted" string="Date of Casting" width="100" class="blue-input" decoration-info="dt_of_casting_formatted != 0"/>
                                <field name='days' string="Age (days)" class="blue-input" decoration-info="days != 0"/>
                                <field name="dt_of_testing1_formatted" string="Date of Testing" width="100" class="blue-input" decoration-info="dt_of_testing1_formatted != 0"/>
                                <field name='room_temp' string="Room Temp (°C)" />
                                <field name='relative_humidity' string="Relative Humidity (RH) (%)" />
                                <field name='wt_sample' string="Weight (gms)" class="blue-input" decoration-info="wt_sample != 0"/>
                                <field name='length' string="Length (mm)" class="blue-input" decoration-info="length != 0"/>
                                <field name='diameter'   string="Diameter (mm)" class="blue-input" decoration-info="diameter != 0"/>
                                <field name='width'  string="width (mm)" class="blue-input" decoration-info="width != 0"/>


                                <field name='cross_sectional_area' string="Area (mm²)" readonly="1"  digits ="[16,2]" />
                                <field name="load" string="Load (kN)" class="blue-input" decoration-info="load != 0"/>
                                <field name='compressive_strength' string="Strength (N/mm²)" readonly="1" digits ="[16,2]"/>

                                <field name='type_of_failure' string="Type of Failure" width="100" class="blue-input" decoration-info="type_of_failure != 0"/>
