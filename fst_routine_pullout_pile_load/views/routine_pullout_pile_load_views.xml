<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="action_routine_pullout_pile_load_test_parent" model="ir.actions.act_window">
            <field name="name">Routine Pull-Out Pile Load Tests</field>
            <field name="res_model">routine.pullout.pile.load.test.parent</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_routine_pullout_pile_load_test_parent_tree" model="ir.ui.view">
            <field name="name">routine.pullout.pile.load.test.parent.tree</field>
            <field name="model">routine.pullout.pile.load.test.parent</field>
            <field name="arch" type="xml">
                <tree string="Routine Pullout Pile Load Test Reports">
                    <field name="name"/>
                    <button
                        name="action_duplicate_parent"
                        type="object"
                        string="Duplicate"
                        icon="fa-copy"
                        class="btn-secondary"
                    />
                    <button
                        name="action_delete_line"
                        string="Delete"
                        type="object"
                        icon="fa-trash"
                        class="btn-danger"
                        confirm="Are you sure you want to delete this line?"
                    />
                </tree>
            </field>
        </record>

        <record id="view_routine_pullout_pile_load_test_parent_form" model="ir.ui.view">
            <field name="name">routine.pullout.pile.load.test.parent.form</field>
            <field name="model">routine.pullout.pile.load.test.parent</field>
            <field name="arch" type="xml">
                <form string="Routine Pull-Out Pile Load Test Report">
                    <header>
                        <button name="action_generate_ulr_no" string="Generate ULR No" type="object" class="btn-primary"/>
                        <button name="action_generate_report_no" string="Generate Report No" type="object" class="btn-primary"/>
                        <button name="print_report" string="Print Report" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div style="text-align:center; margin-top:30px; margin-bottom:40px;">
                            <h1 style="font-size:26px;">
                                <field name="name" style="width:100%; display:block; text-align:center; font-size:26px; letter-spacing:1px;"/>
                            </h1>
                            <h2>ROUTINE PULL OUT PILE LOAD TEST</h2>
                            <h2 style="margin-top:10px;">
                                OF PILE NO -
                                <field name="pile_no" nolabel="1"/>
                            </h2>
                        </div>

                        <group col="2" style="margin-bottom:30px;">
                            <field name="work_name"/>
                            <field name="client"/>
                            <field name="contractor"/>
                            <field name="report_no"/>
                            <field name="ulr"/>
                            <field name="rec_date"/>
                            <field name="test_standard"/>
                            <field name="site_location" colspan="2"/>
                        </group>

                        <div style="margin-top:30px;">
                            <h3 style="border-bottom:2px solid #000;">CONTENTS</h3>
                        </div>

                        <field name="content_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence"/>
                                <field name="description"/>
                                <field name="page_no"/>
                            </tree>
                        </field>

                        <h3 style="border-bottom:2px solid #000;">INTRODUCTION</h3>
                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="introduction" widget="text" nolabel="1"/>
                        </div>

                        <h3 style="border-bottom:2px solid #000; margin-top:30px;">OBJECTIVE</h3>
                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="objective" widget="text" nolabel="1"/>
                        </div>

                        <h3 style="border-bottom:2px solid #000; margin-top:30px;">TESTING EQUIPMENTS</h3>
                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="test_equipment" widget="text" nolabel="1"/>
                        </div>

                        <h3 style="border-bottom:2px solid #000; margin-top:30px;">TEST PROCEDURE</h3>
                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="test_procedure" widget="text" nolabel="1"/>
                        </div>

                        <h3 style="border-bottom:2px solid #000; margin-top:35px;">TABLE 1 : BASIC DATA</h3>

                        <field name="basic_data_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sr_no"/>
                                <field name="parameter"/>
                                <field name="value"/>
                            </tree>
                        </field>

                        <div style="margin-top:35px;">
                            <h3 style="border-bottom:2px solid #000;">INTERPRETATION</h3>
                        </div>

                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="interpretation" widget="text" nolabel="1"/>
                        </div>

                        <h3 style="border-bottom:2px solid #000; margin-top:35px;">TABLE 2A : DIAL GAUGE READING CORRESPONDING TO LOADING</h3>

                        <field name="last_reading_datetime" invisible="1"/>
                        <field name="loading_reading_ids"
                                nolabel="1"
                                context="{'default_parent_id': id}">
                            <tree editable="bottom" limit="50" default_order="id">
                                <field name="reading_datetime"
                                        widget="datetime"
                                        options="{'format': 'dd/MM/yy HH:mm'}"/>
                                <field name="load_tonne"/>
                                <field name="dial_a"/>
                                <field name="dial_b"/>
                                <field name="mean_mm" readonly="1"/>
                            </tree>
                        </field>

                        <h3 style="border-bottom:2px solid #000; margin-top:35px;">TABLE 2B : DIAL GAUGE READING CORRESPONDING TO UNLOADING</h3>

                        <field name="unloading_reading_ids"
                                nolabel="1"
                                context="{'default_parent_id': id}">
                            <tree editable="bottom" limit="50" default_order="id">
                                <field name="reading_datetime"
                                        widget="datetime"
                                        options="{'format': 'dd/MM/yy HH:mm'}"/>
                                <field name="load_tonne"/>
                                <field name="dial_a"/>
                                <field name="dial_b"/>
                                <field name="mean_mm" readonly="1"/>
                            </tree>
                        </field>

                        <div style="margin-top:30px; margin-bottom:10px;">
                            <button name="action_generate_graph"
                                    type="object"
                                    string="Generate Graph"
                                    class="btn-primary"/>
                        </div>

                        <h3 style="border-bottom:2px solid #000;">LOAD – DISPLACEMENT GRAPH</h3>

                        <field name="graph_image" widget="image"/>

                        <div style="margin-top:35px;">
                            <h3 style="font-weight:bold;">2.06 : ANALYSIS OF TEST RESULTS</h3>
                        </div>

                        <div style="border:1px solid #000; padding:12px; margin-bottom:15px;">
                            <field name="analysis_text"
                                widget="text"
                                nolabel="1"/>
                        </div>

                        <div style="margin-top:20px; font-weight:bold;">
                            Gross Displacement =
                            <field name="gross_settlement" readonly="1"/> mm<br/>
                            Net Displacement =
                            <field name="net_settlement" readonly="1"/> mm<br/>
                            Rebound =
                            <field name="rebound" readonly="1"/> mm
                        </div>

                        <h3 style="border-bottom:2px solid #000; margin-top:35px;">CONCLUSION</h3>
                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="conclusion" widget="text" nolabel="1"/>
                        </div>

                        <h3 style="border-bottom:2px solid #000; margin-top:40px;">SITE PHOTOGRAPHS</h3>

                        <field name="site_image_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence" width="60"/>
                                <field name="image" widget="image" class="oe_avatar"/>
                                <field name="caption"/>
                            </tree>
                        </field>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Inject Routine Pull-Out card into FST dashboard -->
        <record id="routine_pullout_dashboard_card" model="ir.ui.view">
            <field name="name">fst.dashboard.routine_pullout.card</field>
            <field name="model">lerm.ert.dashboard</field>
            <field name="inherit_id" ref="fst.view_ert_dashboard"/>
            <field name="arch" type="xml">
                <xpath expr="//div[contains(@class, 'card-box')][last()]" position="after">
                    <div class="card-box" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;">
                        <h3 class="title">Routine Pull-Out Pile Load Test</h3>
                        <a type="action"
                        name="%(action_routine_pullout_pile_load_test_parent)d"
                        class="btn btn-lg"
                        style="background:#00897b; color:#fff;">
                            Records
                        </a>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
