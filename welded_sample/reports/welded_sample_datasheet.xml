<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="welded_sample_datasheet">
    <t t-call="web.html_container">
	<t t-call="lerm_civil.mechanical_data_sheet_header">
		<div style="text-align:center;font-size:18px;font-weight: bold">
		Welded Sample
		</div>
		<div class="container_eln" style="margin-top:5px">
            <table style="margin-top:20px">
				<tr cols="12">
					
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>

				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                    <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>





                <!-- Water Absorption 					 -->

             <div t-if="data.tensile_strength_visible" >
                     
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.tensile_strength_name" />:
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.tensile_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','d96a5e06-7d28-425e-ad2e-cd425cbfb8d5')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>

                    <div t-if="data.elongation_visible" >
                   
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.elongation_name"/> :
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.elongation"  t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','03d3e787-c3f3-4d98-b2af-8a25cf5fa837')]).unit.name"/>
