<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <record id="mechanical_ssl_bituminous_form" model="ir.ui.view">
        <field name="name">ssl.bituminous.form</field>
        <field name="model">ssl.bituminous</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <field name="grade"/>
                    <field name="srf_id" invisible="1"/>
                    <field name="sample_id" readonly="1" />
                    <field name="eln_ref" readonly="1"/>
                    <field name="size_id"/>
                    <field name="parameter_id" invisible="1"/>
                    <field name="sample_parameters">
                        <tree>
                        <field name="parameter_name"/>
                        <field name="test_method"/>
                        </tree>
                    </field>
                    
                    <!-- <button type="object" class="oe_highlight" name="open_eln_page" string="Submit" /> -->
                    
                    <!-- Bitumen  -->
                    <div invisible="not bitumen_content_visible">
                        <h1 style="text-align: center;">
                            <field name="bitumen_content_name" readonly="1" nolabel="1"/>
                            <field name="bitumen_content_visible" invisible="1"/>
                        </h1>
                    </div> 
                    <!-- Bitumen Content Table -->
                    <table class="table table-sm table-bordered w-50" invisible="not bitumen_content_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Weight of the sample (W1) grams.</span></td>
                                <td><field name="wt_of_sample"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Initial weight of the filter paper (F1) grams</span></td>
                                <td><field name="init_wt_filter_paper"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of aggregate after extraction (W2) grams</span></td>
                                <td><field name="wt_agg_extraction"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of filter paper after extraction with fine materials (F2) grams</span></td>
                                <td><field name="wt_filter_paper_after_extraction"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Increased weight of filter W3 = (F2-F1) grams</span></td>
                                <td><field name="increase_in_wt_filter_paper" readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Binder Content %</span></td>
                                <td><field name="binder_content" readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Combined Gradation  -->
                    <div invisible="not combined_gradation_visible">
                        <h1 style="text-align: center;">
                            <field name="combined_gradation_name" readonly="1"/>
                            <field name="combined_gradation_visible" invisible="1"/>
                        </h1>
                    </div>

                    <table class="table table-sm table-bordered w-50" invisible="not combined_gradation_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Weight of Sample in kg.</span></td>
                                <td><field name="weight_of_sample"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div invisible="not combined_gradation_visible">
                        <field name="combined_gradation_child_lines">
                            <tree editable="bottom">
                                <field name='sieve_size'/>
                                <field name='wt_retained' string="Wt. Retained in gms"/>
                                <field name='percent_retained' readonly="1" string="% Retained"/>
                                <field name='cumulative_retained' context="{'default_cumulative_retained': cumulative_retained}" readonly="1" string="Cum. Retained %"/>
                                <field name='passing_percent' string="Passing %" readonly="1"/>
                            </tree>
                        </field>
                    </div>

                    <!-- <group invisible="not combined_gradation_visible"> -->
                        <button invisible="not combined_gradation_visible" type="object" name="calculate_combined_gradation" class="btn btn-primary">
                            <i class="fa fa-calculator mr-1"/> Calculate
                        </button>
                    <!-- </group>  -->

                    <group invisible="not combined_gradation_visible">
                        <field name="total_combined_gradation" widget="monetary" string="Total"/>
                    </group> 

                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>