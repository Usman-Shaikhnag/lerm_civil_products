                                <field name='average_water_cement_absorption_nabl'
                                       decoration-success="average_water_cement_absorption_nabl == 'pass'" 
                                       decoration-danger="average_water_cement_absorption_nabl == 'fail'" 
                                       readonly="1"/>
                        </group>
                </group> -->



                <!-- WET TRANSVERSE STRENGTH TEST -->
                       <div invisible="not chequeredwet_cement_transver_visible">
                        <h1>
                            <field name="chequeredwet_cement_transver_name1" readonly="1" nolabel="1"/>
                            <field name="chequeredwet_cement_transver_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div class="custom_table_borders" invisible="not chequeredwet_cement_transver_visible">
                        <field name="chequeredwet_cement_transver_lines" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='width_b'/>
                                <field name='span_between'/>
                                <field name='fracture_thicness'/>
                                <field name='breaking_load'/>
                                <field name='wet_transver'/>    
                            </tree>   
                         </field>  
                    </div>



                     <div>
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><label for="average_cement_wet_transver" class="text-bold">Average Wet Transveres %</label></td>
                        <td><field name='average_cement_wet_transver' col="1"/></td>
                      </tr>
                      <tr>
                             <td><label for="average_cement_wet_transver_conformity" class="text-bold">Conformity</label></td>
                              <td><field name='average_cement_wet_transver_conformity'
                                       decoration-success="average_cement_wet_transver_conformity == 'pass'" 
                                       decoration-danger="average_cement_wet_transver_conformity == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_cement_wet_transver_nabl" class="text-bold">NABL</label></td>
                            <td><field name="average_cement_wet_transver_nabl"
                                       decoration-success="average_cement_wet_transver_nabl == 'pass'" 
                                       decoration-danger="average_cement_wet_transver_nabl == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                      </tbody>
                    </table>
                    </div>
                    <group/>
