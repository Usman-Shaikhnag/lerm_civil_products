<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_cement_cheequered_tile_views" model="ir.ui.view">
        <field name="name">mechanical.cement.chequered.tile.form</field>
        <field name="model">mechanical.cement.chequered.tile</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                   <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <group  invisible="dimension_visible == False">
                        <h1>
                            <field name="dimension_name" readonly="1" nolabel="1"/>
                            <field name="dimension_visible" invisible="1"/>
                        </h1>
                    </group>

                    <div class="d-flex gap-2" invisible="dimension_visible == False">
                        <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="length"></label></td>
                                    <td style="width:50%;"><field name="length" class="blue-input" decoration-info="length != 0"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="thickness"></label></td>
                                    <td style="width:50%;"><field name="thickness" class="blue-input" decoration-info="thickness != 0"/></td>
                                </tr>
                              
                            </tbody>
                        </table>
                        <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="width"></label></td>
                                    <td style="width:50%;"><field name="width" class="blue-input" decoration-info="width != 0"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>



                     <!--Chequered Tiles  -->
                    <div invisible="not chequered_tiles_cement_visible">
                        <h1>
                            <field name="chequered_tiles_cement_cement_name1" readonly="1" nolabel="1"/>
                            <field name="chequered_tiles_cement_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div>
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><span>Sample Size MM</span></td>
                        <td><field name='cement_sample_size' col="1" class="blue-input" /></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>
                    <group/>
                    <group/>


                      <!-- <group invisible="not chequered_tiles_cement_visible" style="white-space: nowrap; width:70%;">
                        <field name='cement_sample_size' col="4"/>
                    </group> -->

                    <div class="custom_table_borders" invisible="not chequered_tiles_cement_visible">
                        <field name="chequered_tiles_cement_lines" nolabel="1" colspan="2" >
                            <tree editable="bottom">
                                
                                <field name='sr_no'/>
                                <field name='flatness1' class="blue-input" decoration-info="flatness1 != 0"/>
                                <field name='flatness2' class="blue-input" decoration-info="flatness2 != 0"/>
                                <field name='flatness3'  class="blue-input" decoration-info="flatness3 != 0"/>
                                <field name='flatness4' class="blue-input" decoration-info="flatness4 != 0"/>

                                <field name='perpendicularity1' class="blue-input" decoration-info="perpendicularity1 != 0"/>
                                <field name='perpendicularity2' class="blue-input" decoration-info="perpendicularity2 != 0"/>
                                <field name='perpendicularity3' class="blue-input" decoration-info="perpendicularity3 != 0"/>
                                <field name='perpendicularity4' class="blue-input" decoration-info="perpendicularity4 != 0"/>

                                <field name='straightness1' class="blue-input" decoration-info="straightness1 != 0"/>
                                <field name='straightness2' class="blue-input" decoration-info="straightness2 != 0"/>
                                <field name='straightness3' class="blue-input" decoration-info="straightness3 != 0"/>
                                <field name='straightness4' class="blue-input" decoration-info="straightness4 != 0"/>
                                
                            </tree> 
                         </field>    
                    </div>

                    <div style="display:flex;">
                    <div style="width:50%;">
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                    <tbody>
                      <tr>
                        <td><label for="average_cememt_flatness" class="text-bold">Average Flatness (mm)</label></td>
                        <td> <field name='average_cememt_flatness' col="1"/></td>
                      </tr>
                      <tr>
                        <td><label for="average_cement_perpendicularity" class="text-bold">Average Perpendicularity (%)</label></td>
                        <td><field name='average_cement_perpendicularity'  col="1"/> </td>
                      </tr>
                      <tr>
                        <td><label for="average_cement_straightness" class="text-bold">Average Straightness (%)</label></td>
                        <td> <field name='average_cement_straightness' col="1"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>

                    <div style="width:50%;">
                    <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><label for="deviation_cement_flatness" class="text-bold">Flatness,mm</label></td>
                        <td> <field name='deviation_cement_flatness' col="1"/></td>
                      </tr>
                      <tr>
                        <td><label for="deviation_cement_perpendicularity" class="text-bold">Perpendicularity,(%)</label></td>
                        <td><field name='deviation_cement_perpendicularity'  col="1"/> </td>
                      </tr>
                      <tr>
                        <td><label for="deviation_cement_straightness" class="text-bold">Straightness,(%)</label></td>
                        <td> <field name='deviation_cement_straightness' col="1"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>
                    </div>
                    <group/>
                    <group/>





                    <div style="display:flex;">
                    <div style="width:50%;">
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                    <tbody>
                      <tr>
                        <td><label for="average_cememt_flatness_conformity" class="text-bold">Flatness Conformity</label></td>
                        <td><field name='average_cememt_flatness_conformity'
                                       decoration-success="average_cememt_flatness_conformity == 'pass'" 
                                       decoration-danger="average_cememt_flatness_conformity == 'fail'" 
                                       readonly="1"/></td>
                      </tr>
                      <tr>
                        <td><label for="average_cement_perpendicularity_conformity" class="text-bold">Perpendicularity Conformity</label></td>
                        <td><field name='average_cement_perpendicularity_conformity'
                                       decoration-success="average_cement_perpendicularity_conformity == 'pass'" 
                                       decoration-danger="average_cement_perpendicularity_conformity == 'fail'" 
                                       readonly="1"/></td>
                      </tr>
                      <tr>
                        <td><label for="average_cement_straightness_conformity" class="text-bold">Straightness Conformity</label></td>
                        <td><field name='average_cement_straightness_conformity'
                                       decoration-success="average_cement_straightness_conformity == 'pass'" 
                                       decoration-danger="average_cement_straightness_conformity == 'fail'" 
                                       readonly="1"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>

                    <div style="width:50%;">
                    <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><label for="average_cememt_flatness_nabl" class="text-bold">Flatness NABL</label></td>
                        <td><field name="average_cememt_flatness_nabl"
                                       decoration-success="average_cememt_flatness_nabl == 'pass'" 
                                       decoration-danger="average_cememt_flatness_nabl == 'fail'" 
                                       readonly="1"/></td>
                      </tr>
                      <tr>
                        <td><label for="average_cement_perpendicularity_nabl" class="text-bold">Perpendicularity NABL</label></td>
                        <td><field name="average_cement_perpendicularity_nabl"
                                       decoration-success="average_cement_perpendicularity_nabl == 'pass'" 
                                       decoration-danger="average_cement_perpendicularity_nabl == 'fail'" 
                                       readonly="1"/></td>
                      </tr>
                      <tr>
                        <td><label for="average_cement_straightness_nabl" class="text-bold">Straightness NABL</label></td>
                        <td><field name="average_cement_straightness_nabl"
                                       decoration-success="average_cement_straightness_nabl == 'pass'" 
                                       decoration-danger="average_cement_straightness_nabl == 'fail'" 
                                       readonly="1"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>
                    </div>
                    <group/>
                    <group/>


                    




                        <!-- Water Absorption -->
                       <div invisible="not chequered_cement_water_absorption_visible">
                        <h1>
                            <field name="chequered_cement_water_absorption_visible_name1" readonly="1" nolabel="1"/>
                            <field name="chequered_cement_water_absorption_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div class="custom_table_borders" invisible="not chequered_cement_water_absorption_visible">
                        <field name="chequered_cement_water_absorption_lines" nolabel="1" colspan="2" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='mass_of_saturated' class="blue-input" decoration-info="mass_of_saturated != 0"/>
                                <field name='mass_of_oven' class="blue-input" decoration-info="mass_of_oven != 0"/>
                                <field name='water_absorption'/>   
                            </tree>
                         </field>  
                    </div>
                    

                     <div>
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><label for="average_water_cement_absorption" class="text-bold">Average Water Absorption %</label></td>
                        <td> <field name='average_water_cement_absorption' col="1"/></td>
                      </tr>
                      <tr>
                             <td><label for="average_water_cement_absorption_conformity" class="text-bold">Conformity</label></td>
                              <td><field name='average_water_cement_absorption_conformity'
                                       decoration-success="average_water_cement_absorption_conformity == 'pass'" 
                                       decoration-danger="average_water_cement_absorption_conformity == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_water_cement_absorption_nabl" class="text-bold">NABL</label></td>
                            <td><field name='average_water_cement_absorption_nabl'
                                       decoration-success="average_water_cement_absorption_nabl == 'pass'" 
                                       decoration-danger="average_water_cement_absorption_nabl == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                        </tbody>
                    </table>
                    </div>
                    <group/>

                    

                  


                <!-- WET TRANSVERSE STRENGTH TEST -->
                       <div invisible="not chequeredwet_cement_transver_visible">
                        <h1>
                            <field name="chequeredwet_cement_transver_name1" readonly="1" nolabel="1"/>
                            <field name="chequeredwet_cement_transver_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div class="custom_table_borders" invisible="not chequeredwet_cement_transver_visible">
                        <field name="chequeredwet_cement_transver_lines" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='width_b' class="blue-input" decoration-info="width_b != 0"/>
                                <field name='span_between' class="blue-input" decoration-info="span_between != 0"/>
                                <field name='fracture_thicness' class="blue-input" decoration-info="fracture_thicness != 0"/>
                                <field name='breaking_load' class="blue-input" decoration-info="breaking_load != 0"/>
                                <field name='wet_transver'/>    
                            </tree>   
                         </field>  
                    </div>



                     <div>
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><label for="average_cement_wet_transver" class="text-bold">Average Wet Transveres %</label></td>
                        <td><field name='average_cement_wet_transver' col="1"/></td>
                      </tr>
                      <tr>
                             <td><label for="average_cement_wet_transver_conformity" class="text-bold">Conformity</label></td>
                              <td><field name='average_cement_wet_transver_conformity'
                                       decoration-success="average_cement_wet_transver_conformity == 'pass'" 
                                       decoration-danger="average_cement_wet_transver_conformity == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_cement_wet_transver_nabl" class="text-bold">NABL</label></td>
                            <td><field name="average_cement_wet_transver_nabl"
                                       decoration-success="average_cement_wet_transver_nabl == 'pass'" 
                                       decoration-danger="average_cement_wet_transver_nabl == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                      </tbody>
                    </table>
                    </div>
                    <group/>
                      <group/>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     


                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>