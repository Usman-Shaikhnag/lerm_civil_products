				      <table style="width:100%; border:1px solid black; border-collapse:collapse;">
					 
                    <tr>
                        <td colspan="1"><b>Customer Party Name :</b></td>
                        <td colspan="3"><t t-esc="nbml.customer_name"/></td>
                        
                    </tr>

                    <tr>
                        <td><b>Samples Description :</b></td>
                        <td><t t-esc="nbml.sample_description"/></td>

						  <td><b>Project Name :</b></td>
                        <td><t t-esc="nbml.project_name"/></td>
                    </tr>

                    <!-- <tr>
                        <td><b>No. of Samples :</b></td>
                        <td><t t-esc="nbml.no_of_samples"/></td>
                    </tr> -->

                    <tr>
                        <td><b>Date of Samples Received :</b></td>
                        <td><t t-esc="nbml.date_received"/></td>

                        <td><b>SRF No. :-</b></td>
                        <td >

                            <t t-if="o.srf_id">
                            <span t-field="o.srf_id"/>
                        </t>
                    <t t-else="">--</t>
                    </td>
                    </tr>

                    <tr>
                        <td><b>Brand &amp; Grade :</b></td>
                        <td><t t-esc="nbml.brand_grade"/></td>
                        <td><b>Date of Test Initiation :</b></td>
						<td><t t-esc="nbml.test_init_date"/></td>
                    </tr>

                    <tr>
                        <td><b>Size :</b></td>
                        <td><t t-esc="nbml.size"/></td>
                        <td><b>Date of Test Completion :</b></td>
						<td><t t-esc="nbml.test_comp_date"/></td>
                    </tr>

                    <tr>
                        <td><b>Week No :</b></td>
                        <td><t t-esc="nbml.week_no"/></td>
                        <td><b>Sample ID :</b> </td>

						 <td><t t-esc="nbml.sample"/></td>
                    </tr>

                    <tr>
                        <td><b>Test method adopted :</b></td>
                        <td ><t t-esc="nbml.test_method"/></td>
						 <td><b>No. of Samples :</b></td>
                        <td><t t-esc="nbml.no_of_samples"/></td>
                    </tr>

                    <tr>
                        <td colspan="1"><b>Source of Sample :</b></td>
                        <td colspan="3"><t t-esc="nbml.source_sample"/></td>
                    </tr>

                    <tr>
                        <td colspan="1"><b>Specifications :</b></td>
                        <td colspan="3"><t t-esc="nbml.specification"/></td>
                    </tr>

                </table>

                <br/>

                <!-- Test Table -->
                <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                    <thead>
                        <tr>
                            <th>Sr.No</th>
                            <th>Test</th>
                            <th>Unit</th>
                            <th>Test Method</th>
							<th>Result</th>
                            <th>Specification</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr t-foreach="nbml.line_ids" t-as="line">
                            <td><t t-esc="line.sr_no"/></td>
                            <td><t t-esc="line.test_name"/></td>
                            <td><t t-esc="line.unit"/></td>
							 <td><t t-esc="line.test_method"/></td>
                            <td><t t-esc="line.result"/></td>
                            <td><t t-esc="line.specification"/></td>
                        </tr>
                    </tbody>
                </table>
					</div>

					

					<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>
							


