<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="tile_datasheet">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
        
                <div style="text-align:center;font-size:18px;font-weight: bold">
                    TILE DATASHEET
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>

                          <tr style="height:50px" cols="12">
								<td colspan="4">Performed By :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.technician.name"/>
								</td>
								<td colspan="4">Witness Name :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.witness_name"/>
								</td>
								<td colspan="4">Witness Signature :
									<![CDATA[&nbsp;]]>
									<span style='padding:20px'></span>
								</td>
							</tr>
                    </table>


                    <!-- Dimension  -->
                    
                    <div t-if="data.dimension_visible" style="margin-top:20px">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                              <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','1db41e6d-550e-4c5d-a923-7510a616beb5')]).parameter_name"/>
                        </div>

                       <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Length, mm</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Width, mm</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Thickness, mm</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.dimension_child_lines" t-as="r" style="text-align: center;">
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['length']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['width']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['thickness']" />
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Length (mm) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_length" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
                            <tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Width (mm) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_width" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
                            <tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Thickness (mm) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_thickness" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
                    

					<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == '1db41e6d-550e-4c5d-a923-7510a616beb5')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<t t-if="eln.tested_by_signature_datasheet">
											<div t-if="prep_result[0].technician.employee_id.signature">
												<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
											</div>
										</t>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>

				</div>


				<!-- Straightness  -->
                    
                    <div t-if="data.straightness_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                              <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','19999f82-79c0-44a8-9379-f40dd33235aa')]).parameter_name"/>
                        </div>

                       <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Edge Length (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Permissible Gap (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Edge-1 Gap (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Edge-2 Gap (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Edge-3 Gap (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Edge-4 Gap (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Maximum Gap Observed (mm)</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.straightness_line_ids" t-as="r" style="text-align: center;">
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['edge_length']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['permissible_gap']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['edge_1_gap']" />
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['edge_2_gap']" />
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['edge_3_gap']" />
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['edge_4_gap']" />
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['maximum_gap_observed']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Maximum Gap Observed (mm) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.straightness_max_gap" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
                    

					<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == '19999f82-79c0-44a8-9379-f40dd33235aa')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<t t-if="eln.tested_by_signature_datasheet">
											<div t-if="prep_result[0].technician.employee_id.signature">
												<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
											</div>
										</t>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>

				</div>


				<!-- Water Absorption  -->
                    
                    <div t-if="data.water_absorption_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                              <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','5d81b405-ed58-4374-bda7-2825e12f307c')]).parameter_name"/>
                        </div>

                       <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Dry Mass, W1 (g)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Saturated Mass, W2 (g)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Gain in Mass (g)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Water Absorption (%)</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.water_absorption_line_ids" t-as="r" style="text-align: center;">
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['dry_mass_w1']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['saturated_mass_w2']" />
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['gain_in_mass']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Water Absorption (%) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.average_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
                    

					<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == '5d81b405-ed58-4374-bda7-2825e12f307c')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<t t-if="eln.tested_by_signature_datasheet">
											<div t-if="prep_result[0].technician.employee_id.signature">
												<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
											</div>
										</t>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>

				</div>


				<!-- Bulk Density  -->
                    
                    <div t-if="data.bulk_density_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                              <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','25489lku-2bb3-4821-958d-ec2c81db5698')]).parameter_name"/>
                        </div>

                       <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Mass of the dry tile(g) (m1)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Mass of the wet tile(g) (m2)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Mass of suspended tile (g) (m3)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">V = exterior volume, in cm³ (m2-m3)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Bulk Density ,g/cc</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.bulk_density_line_ids" t-as="r" style="text-align: center;">
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['m1']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['m2']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['m3']" />
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['volume']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['bulk_density']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Bulk Density ,g/cc :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_bulk_density" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
                    

					<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == '25489lku-2bb3-4821-958d-ec2c81db5698')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<t t-if="eln.tested_by_signature_datasheet">
											<div t-if="prep_result[0].technician.employee_id.signature">
												<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
											</div>
										</t>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>

				</div>


				<!-- Rectangularity  -->
                    
                    <div t-if="data.rectangularity_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                              <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','4e209b70-f6b9-49b9-bab6-f38292f64b1c')]).parameter_name"/>
                        </div>

                       <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Corner-1 δ (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Corner-2 δ (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Corner-3 δ (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Corner-4 δ (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Maximum δ (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Length/Width L (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Rectangularity (%)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Result</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.rectangularity_line_ids" t-as="r" style="text-align: center;">
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['corner_1']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['corner_2']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['corner_3']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['corner_4']"/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['max_delta']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['length_width']" />
									</td>
