<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_tile" model="ir.ui.view">
        <field name="name">mechanical.tile.form</field>
        <field name="model">mechanical.tile</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                   <group >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>

                    </group>


                      <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>




                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                         <!-- <field name="size" /> -->
                         <field name="product_id" invisible="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>



                    <!-- Water Absorption  -->

                       <div invisible="not water_absorption_visible">
                        <h1 class="text-center">
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                       <div class="custom_table_borders" invisible="not water_absorption_visible">
                        <field name="water_absorption_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='dry_mass_w1' class="blue-input" decoration-info="dry_mass_w1 != 0"/>
                                <field name='saturated_mass_w2' class="blue-input" decoration-info="saturated_mass_w2 != 0"/>
                                <field name='water_absorption'/>
                                  
                            </tree>  
                         </field>    
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="water_absorption_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_water_absorption">Average Water Absorption (%)</label></td>
                                  <td><field name="average_water_absorption"/><span>  (%)</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_water_absorption_confirmity">Conformity</label></td>
                                <td>
                                    <field name="average_water_absorption_confirmity"
                                        decoration-success="average_water_absorption_confirmity == 'pass'" 
                                        decoration-danger="average_water_absorption_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="average_water_absorption_nabl">NABL</label></td>
                                <td>
                                    <field name="average_water_absorption_nabl"
                                        decoration-success="average_water_absorption_nabl == 'pass'" 
                                        decoration-danger="average_water_absorption_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>



                    <!-- Straightness -->
                    <div invisible="not straightness_visible">
                        <h1 class="text-center">
                            <field name="straightness_name" readonly="1" nolabel="1"/>
                            <field name="straightness_visible" invisible="1"/>
                        </h1>
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="straightness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="straightness_report_type"></label></td>
                                  <td><field name="straightness_report_type" class="blue-input" decoration-info="straightness_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                     <div class="d-flex gap-2">
                     <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="straightness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="straightness_length"></label></td>
                                  <td><field name="straightness_length" class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="straightness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="straightness_width"></label></td>
                                  <td><field name="straightness_width" class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>
                    </div>

                    
                    <div class="custom_table_borders" invisible="not straightness_visible">
                        <field name="straightness_line_ids" nolabel="1" colspan="2" >
                            <tree editable="bottom" >
                                <field name='sr_no' width="120"/>
                                <field name='side1' class="blue-input" decoration-info="side1 != 0" width="120"/>
                                <field name='side2' class="blue-input" decoration-info="side2 != 0" width="120"/>
                                <field name='side3' class="blue-input" decoration-info="side3 != 0" width="120"/>
                                <field name='side4' class="blue-input" decoration-info="side4 != 0" width="120"/>
                                <field name='deviation_length' width="120"/>
                                <field name='deviation_width' width="120"/>
                                <field name='average' width="120"/>
                            </tree> 
                         </field>   
                    </div>
                    <group/>


                    <!-- Rectangularity -->
                    <div invisible="not rectangularity_visible">
                        <h1 class="text-center">
                            <field name="rectangularity_name" readonly="1" nolabel="1"/>
                            <field name="rectangularity_visible" invisible="1"/>
                        </h1>
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="rectangularity_visible == False" style="white-space:nowrap;">
                        <tbody>
