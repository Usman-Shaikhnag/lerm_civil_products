                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="rectangularity_width"></label></td>
                                  <td><field name="rectangularity_width" class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                    
                    <div class="custom_table_borders" invisible="not rectangularity_visible">
                        <field name="rectangularity_line_ids" nolabel="1" colspan="2" >
                            <tree editable="bottom" >
                                <field name='sr_no' width="120"/>
                                <field name='side1' class="blue-input" decoration-info="side1 != 0" width="120"/>
                                <field name='side2' class="blue-input" decoration-info="side2 != 0" width="120"/>
                                <field name='side3' class="blue-input" decoration-info="side3 != 0" width="120"/>
                                <field name='side4' class="blue-input" decoration-info="side4 != 0" width="120"/>
                                <field name='deviation_length' width="120"/>
                                <field name='deviation_width' width="120"/>
                                <field name='average' width="120"/>
                            </tree> 
                         </field>   
                    </div>
                    <group/>


                    <!-- Deviation in Length and Width  -->

                       <div invisible="not deviation_visible">
                        <h1 class="text-center">
                            <field name="deviation_name" readonly="1" nolabel="1"/>
                            <field name="deviation_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="deviation_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="deviation_report_type"></label></td>
                                  <td><field name="deviation_report_type" class="blue-input" decoration-info="deviation_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex gap-2" invisible="deviation_visible == False"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="deviation_visible == False" style="white-space:nowrap;">
                            <tbody>
                            <tr>
                                <td><label class="fw-bold" for="work_length">Work Length (mm)</label></td>
                                  <td><field name="work_length"  class="blue-input"/></td>
                            </tr>
                           
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="deviation_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="work_width">Work Width (mm)</label></td>
                                  <td><field name="work_width"  class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>
                   </div>

                       <div class="custom_table_borders" invisible="not deviation_visible">
                        <field name="deviation_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no' width="120"/>
                                <field name='side1' class="blue-input" decoration-info="side1 != 0" width="120"/>
                                <field name='side2' class="blue-input" decoration-info="side2 != 0" width="120"/>
                                <field name='side3' class="blue-input" decoration-info="side3 != 0" width="120"/>
                                <field name='side4' class="blue-input" decoration-info="side4 != 0" width="120"/>
                                <field name='deviation_length' width="120"/>
                                <field name='deviation_width' width="120"/>
                                <field name='average' width="120"/>
                                  
                            </tree>  
                         </field>    
                    </div>



                    <!-- Thickness -->


                    <div invisible="not thickness_visible">
                        <h1 class="text-center">
                            <field name="thickness_name" readonly="1" nolabel="1"/>
