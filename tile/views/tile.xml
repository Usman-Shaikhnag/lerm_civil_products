                                <field name='edge4' class="blue-input" decoration-info="edge4 != 0" width="120"/>
                                <field name='deviation1' width="120"/>
                                <field name='deviation2' width="120"/>
                                <field name='average_percent' width="120"/>
                                  
                            </tree>  
                         </field>    
                    </div>


                    <!-- Warpage -->


                    <div invisible="not warpage_visible">
                        <h1 class="text-center">
                            <field name="warpage_name" readonly="1" nolabel="1"/>
