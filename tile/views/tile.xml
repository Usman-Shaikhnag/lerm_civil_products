                        </h1>
                    </div>
                    <group/>


                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="thickness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="thickness_report_type"></label></td>
                                  <td><field name="thickness_report_type" class="blue-input" decoration-info="thickness_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                        <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="thickness_visible == False" style="white-space:nowrap;">
                            <tbody>
                            <tr>
                                <td><label class="fw-bold" for="nominal_thickness">Nominal Thickness</label></td>
                                  <td><field name="nominal_thickness"  class="blue-input"/></td>
                            </tr>
                           
                        </tbody>
                    </table>


                       <div class="custom_table_borders" invisible="not thickness_visible">
                        <field name="thickness_child_lines" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no' width="120"/>
                                <field name='t1' class="blue-input" decoration-info="t1 != 0" width="120"/>
                                <field name='t2' class="blue-input" decoration-info="t2 != 0" width="120"/>
                                <field name='t3' class="blue-input" decoration-info="t3 != 0" width="120"/>
                                <field name='t4' class="blue-input" decoration-info="t4 != 0" width="120"/>
                                <field name='average' width="120"/>
                                <field name='deviation' width="120"/>
                                  
                            </tree>  
                         </field>    
                    </div>
                    

                    <!-- Center Curvature -->


                    <div invisible="not center_curvature_visible">
                        <h1 class="text-center">
                            <field name="center_curvature_name" readonly="1" nolabel="1"/>
