                            </tr>
                        </tbody>
                    </table>

                        <div class="d-flex gap-2" invisible="warpage_visible == False"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="warpage_visible == False" style="white-space:nowrap;">
                            <tbody>
                            <tr>
                                <td><label class="fw-bold" for="warpage_length">Length</label></td>
                                  <td><field name="warpage_length"  class="blue-input" /></td>
