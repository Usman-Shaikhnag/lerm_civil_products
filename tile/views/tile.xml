                            </tr>
                        </tbody>
                    </table>

                        <div class="d-flex gap-2" invisible="center_curvature_visible == False"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="center_curvature_visible == False" style="white-space:nowrap;">
                            <tbody>
                            <tr>
                                <td><label class="fw-bold" for="center_curvature_length">Length</label></td>
                                  <td><field name="center_curvature_length"  class="blue-input"/></td>
                            </tr>
                           
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="center_curvature_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="center_curvature_width">Width</label></td>
                                  <td><field name="center_curvature_width"  class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>
                   </div>


                       <div class="custom_table_borders" invisible="not center_curvature_visible">
                        <field name="center_curvature_child_lines" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no' width="120"/>
                                <field name='center1' class="blue-input" decoration-info="center1 != 0" width="120"/>
                                <field name='center2' class="blue-input" decoration-info="center2 != 0" width="120"/>
                                <field name='center3' class="blue-input" decoration-info="center3 != 0" width="120"/>
                                <field name='center4' class="blue-input" decoration-info="center4 != 0" width="120"/>
                                <field name='diagonal' width="120"/>
                                <field name='deviation1' width="120"/>
                                <field name='deviation2' width="120"/>
                                <field name='average_percent' width="120"/>
                                  
                            </tree>  
                         </field>    
                    </div>



                    <!-- Edge Curvature -->


                    <div invisible="not edge_curvature_visible">
                        <h1 class="text-center">
                            <field name="edge_curvature_name" readonly="1" nolabel="1"/>
                            <field name="edge_curvature_visible" invisible="1"/>
                        </h1>
                    </div>
                    
                    
                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="edge_curvature_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="edge_curvature_report_type"></label></td>
                                  <td><field name="edge_curvature_report_type" class="blue-input" decoration-info="edge_curvature_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                        <div class="d-flex gap-2" invisible="edge_curvature_visible == False"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="edge_curvature_visible == False" style="white-space:nowrap;">
                            <tbody>
                            <tr>
                                <td><label class="fw-bold" for="edge_curvature_length">Length</label></td>
                                  <td><field name="edge_curvature_length"  class="blue-input"/></td>
                            </tr>
                           
