<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	   <template id="tmt_bar1_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:2px;">
					<div class="" t-foreach="eln" t-as="o">
						 	<table style="width:100%; border-collapse: collapse;" border="1">

						<tr style="height:10px;">
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">--</t>
		                            <br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 60px;"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >Project Name:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
									</td>
							</tr>

							<tr t-if="o.srf_id.client">
								<td colspan="1" >Name of Agency:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
									</td>
							</tr>

							<tr>
								<td style="width:20%;">Discipline :
									
								</td>
								<td style="width:20%;">
								<span t-field="o.discipline.discipline"/>
								</td>

								<td>SRF No. :-</td>
										<td >

											<t t-if="o.srf_id">
											<span t-field="o.srf_id"/>
										</t>
									<t t-else="">--</t>
										</td>

							
							</tr>


							<tr>
								

								<td style="width:20%;">Group :	
								</td>
								<td style="width:20%;">
									<span t-field="o.group.group"/>
								
								</td>
							
							<td>SRF Date:-</td>
								<td>

									<t t-if="o.srf_date">
											<span t-field="o.srf_date"/>
										</t>
								</td>
							</tr>

							<tr>
								

								<td >Samples Description :-</td>
								<td >
								      <t t-if="tmt.product_name">
											<span t-field="tmt.product_name"/>
										</t>
								</td>

								<td>Date of Samples Received :-</td>
								<td>

									<t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								</td>
								
							</tr>

							<tr>
								<td>Grade :-</td>
								<td>
								<t t-if="tmt.garde">
											<span t-field="tmt.garde"/>
										</t>
									<t t-else="">--</t>
									</td>

								<td>Size  :-</td>

								<td>

										<t t-if="o.sample_id.size_id.size">
											<span t-field="o.sample_id.size_id.size"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								
								<td>Test Start Date  :-</td>
								<td>

									<t t-if="o.start_date">
											<span t-field="o.start_date"/>
										</t>
									<t t-else="">--</t>
								</td>

								<td>Test Completion Date  :-</td>
								<td>

									<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>


							<tr>

								<td>Sample Status :-</td>
								<td>
									   <t t-if="tmt.sample_status">
											<span t-field="tmt.sample_status"/>
										</t>
									<t t-else="">--</t>
								</td>
								
								<td>Sample Submitted By:-</td>
								<td>
									   <t t-if="tmt.sample_submitted">
											<span t-field="tmt.sample_submitted"/>
										</t>
									<t t-else="">--</t>
								</td>

							
							</tr>

							<tr>

								<td>Sub Group :-</td>
								<td>
								  <t t-if="o.material and o.material.lab_name">
											<span t-field="o.material.lab_name"/>
										</t>
								</td>
								
								<td>No. Of  Samples :-</td>
								<td>
									   <t t-if="tmt.No_of_sample">
											<span t-field="tmt.No_of_sample"/>
										</t>
									<t t-else="">--</t>
								</td>

							
							</tr>
							
							<tr>
								

								<td style="width:20%;">Letter No :-</td>
								<td style="width:20%;">

								  <t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">--</t>
								
								</td>
								<td>Letter Date :-</td>
								<td>
									

									<t t-if="o.srf_id.letter_date">
											<span t-field="o.srf_id.letter_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr >
								<td colspan="1" >Work Description:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="tmt.description_work">
											<span t-field="tmt.description_work"/>
										</t>
									<t t-else="">--</t>
									</td>
							</tr>

							
							<tr t-if="o.material.test_method_adopted" >
								

									<td >Test method adopted:</td>
									<td colspan="3"><span t-field="o.material.test_method_adopted"/></td>

							
							</tr>
							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

								<tr t-if="o.material.specification_code">
									<td style="font-weight: bold;">Specifications</td>
									<td colspan="3"><span t-field="o.material.specification_code"/></td>
								</tr>

						</table>
					</div>

                   

                   <div style="text-align: center; font-weight: bold; margin-top: 2px; font-size: 16px;">
						TEST RESULT
					</div>


					<div style="margin-top:2px"  invisible="mechanical_test_visible == False">
                       
                        <table>
                       
                              <tr >
							   <td colspan="4">
                               <strong> MECHANICAL TEST : 	</strong>
								</td>

								<td colspan="2" style="white-space: nowrap;">
									<strong>TEST METHOD :</strong>&#160;<span t-field="tmt.test_method_mech"/>
								</td>

								<td colspan="2" style="white-space: nowrap;">
                                  <strong>TEMPRATURE : </strong>&#160;<span t-field="tmt.temprature"/>
								</td>

								<td colspan="2" style="white-space: nowrap;">
                                 <strong> HUMIDITY : </strong>&#160;<span t-field="tmt.humidity"/>
								</td>
                                
                               
                            </tr>
							  <tr cols="12">
                                <td  style="text-align: center;"><b>Sr No.</b></td>
                                <td   style="text-align: center;"><b>Sample  Identity</b></td>
                                <td   style="text-align: center;"><b>UTS N/mm2</b></td>
								<td   style="text-align: center;"><b>Yield Stress N/mm2</b></td>
                                <td   style="text-align: center;"><b>0.2 % Proof Stress N/mm2</b></td>
                                <td   style="text-align: center;"><b>% Elongation On 5.65 √Area</b></td>
                                <td   style="text-align: center;"><b>% Total Elongation</b></td>
                                <td  style="text-align: center;"><b>Ratio of TS/YS</b></td>
                                <td   style="text-align: center;"><b>Bend Test 180°</b></td>
                                <td   style="text-align: center;"><b>Re bend Test</b></td>
								
                               
                            </tr>

							

                             <tr>
								<td colspan="2" style="text-align: center;">
									<b>Specification as per <span t-field="tmt.test_method_mech"/></b>
								</td>

							
								<td style="text-align: center;">
								&#160;<span t-field="tmt.uts_specification"/>
								</td> <!-- UTS -->

								<td style="text-align: center;">
									&#160;<span t-field="tmt.yield_specification"/>
								</td>
								<td style="text-align: center;">
									&#160;<span t-field="tmt.proof02_specification"/>
								</td>
								<td style="text-align: center;">
									&#160;<span t-field="tmt.p_elongation_specification"/>
								</td>

								<td style="text-align: center;">	
								&#160;<span t-field="tmt.t_elongation_specification"/>
									</td> <!-- elongation -->
								<td style="text-align: center;">
								&#160;<span t-field="tmt.tsys_specification"/>
									</td> <!-- bend -->

                                    <td style="text-align: center;">
									&#160;<span t-field="tmt.bend_specification"/>
									</td> <!-- bend -->

									<td style="text-align: center;">
									&#160;<span t-field="tmt.rebend_specification"/>
									</td>
							</tr>
                            <t t-set="f" t-value="0"/>
                            <tr t-foreach="tmt.child_lines" t-as="r">
                                <td  style="text-align: center;">
                                    <div>
                                        <span t-esc="f + 1" />
                                        <t t-set="f" t-value="f + 1"/>
                                    </div>
                                </td>
                                <td  style="text-align: center;">
                                    <span t-esc="r['sample_identity']"/>
                                </td>
								<!-- <td  style="text-align: center;">
                                    <span t-esc="r['uts']"/>
                                </td>
								<td  style="text-align: center;">
                                    <span t-esc="r['proof_stress']"/>
                                </td>
                                <td  style="text-align: center;">
                                    <span t-esc="r['elongation']"/>
                                </td>
                                <td  style="text-align: center;">
                                    <span t-esc="r['total_elongation']"/>
                                </td>
                                  <td  style="text-align: center;">
                                    <span t-esc="r['ratio_uts_ys']"/>
                                </td>
                                 <td style="text-align: center;">
									<t t-esc="dict(r._fields['bend'].selection).get(r.bend)"/>
								</td>
                                 <td style="text-align: center;">
									<t t-esc="dict(r._fields['re_bend'].selection).get(r.bend)"/>
								</td> -->

								<td style="text-align: center;">
									<span t-esc="r['uts'] if r['uts'] not in (None, 0, 0.0) else '--'"/>
								</td>
								<td style="text-align: center;">
									<span t-esc="r['yield_stress'] if r['yield_stress'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['proof_stress'] if r['proof_stress'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['elongation'] if r['elongation'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['total_elongation'] if r['total_elongation'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<span t-esc="r['ratio_uts_ys'] if r['ratio_uts_ys'] not in (None, 0, 0.0) else '--'"/>
								</td>

								<td style="text-align: center;">
									<t t-esc="dict(r._fields['bend'].selection).get(r.bend) if r.bend else '--'"/>
								</td>

								<td style="text-align: center;">
									<t t-esc="dict(r._fields['re_bend'].selection).get(r.re_bend) if r.re_bend else '--'"/>
								</td>

								
                               
                            </tr>




							
                        </table>
                       
                    </div>


					<div style="margin-top:5px"  invisible="section_weight_visible == False">
                       
                        <table>
                       
                              <tr >
							  <td colspan="2">
                             <strong>SECTION WEIGHT  </strong>
								</td>

									<td colspan="2" style="white-space: nowrap;">
                                 <strong> TEST METHOD : &#160;</strong><span t-field="tmt.test_method_section"/>
							
								</td>

								<td colspan="2" style="white-space: nowrap;">
                                  <strong>TEMPRATURE : &#160;</strong><span t-field="tmt.temprature_section"/>
								</td>

								<td colspan="1" style="white-space: nowrap;">
                                  <strong>HUMIDITY : &#160;</strong><span t-field="tmt.humidity_section"/>
								</td>

									

									
                               
                            </tr>
							  <tr cols="12">
                                <td  style="text-align: center;"><b>Sr No.</b></td>
                                <td   style="text-align: center;"><b>Sample  Identity</b></td>
                                <td   style="text-align: center;"><b>Weight (Kg/m)</b></td>
                                <td   style="text-align: center;"><b>Length(mm)</b></td>
                                <td   style="text-align: center;"><b>Unit Weight Kg/meter</b></td>
                                <td   style="text-align: center;"><b>Standard Weight  as per IS 1786-2008 (Kg/m)</b></td>
                                <td  style="text-align: center;"><b>Tolerance on the Nominal Mass, Percent Batch</b></td>
                               
                               
                            </tr>

							

                            
						
                            <t t-set="f" t-value="0"/>
                            <tr t-foreach="tmt.section_weight_lines" t-as="r">
                                <td  style="text-align: center;">
                                    <div>
                                        <span t-esc="f + 1" />
                                        <t t-set="f" t-value="f + 1"/>
                                    </div>
                                </td>
                                <td  style="text-align: center;">
                                    <span t-esc="r['sample_identity']"/>
                                </td>
								<td  style="text-align: center;">
                                    <!-- <span t-esc="r['weight']"/> -->
									 <span t-esc="r.weight or '--'"/>
                                </td>
								<td  style="text-align: center;">
                                    <!-- <span t-esc="r['lenght']"/> -->
									 <span t-esc="r.lenght or '--'"/>
                                </td>
                                <td  style="text-align: center;">
                                    <!-- <span t-esc="r['unit_weight']"/> -->
									 <span t-esc="r.unit_weight or '--'"/>
                                </td>
                                <td  style="text-align: center;">
                                    <!-- <span t-esc="r['standard_weight']"/> -->
									 <span t-esc="r.standard_weight or '--'"/>
                                </td>
                                  <td  style="text-align: center;">
                                    <!-- <span t-esc="r['tolerance']"/> -->
									 <span t-esc="r.tolerance or '--'"/>
                                </td>
                                
                               
                            </tr>




							
                        </table>
                       
                    </div>

					

					

				
					<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>
							


					


						<div style="margin-top:0;padding:0;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 30px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 30px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<!-- <span t-esc="eln.technician.name"/> -->
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

								<!-- QR Code -->
							<!-- <div style="text-align:center; margin-bottom:10px;">
								<img t-att-src="'data:image/png;base64,%s' % (qrcode_static or '')"
									style="width:75px; height:70px;"/>
							</div> -->

							<t t-if="o.sample_id.stamp_attached">
							<div >
								<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div>
							</div>
						</t>


							<div>
								<div>
									<b>
										Approved By 
									</b>
								</div>
								<div style="height: 30px;">
									<t t-if="eln.sample_id.approveby_signature_required">
										<div t-if="eln.sample_id.approved_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 30px;margin-top:1px;margin-bottom:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
							</div>
						</div>
						
					</div>
				<!-- </div> -->
			</t>
		</t>
	</template>
</odoo>