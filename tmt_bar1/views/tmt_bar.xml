<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mech_tmt_bar11_view" model="ir.ui.view">
        <field name="name">mech.tmt.bar.form</field>
        <field name="model">mech.tmt.bar</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>

                
                   <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                     <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <!-- <field name="grade" readonly="1"/> -->
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                        
                    </group>
                    
                    <!-- <group style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </group> -->

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div  style="text-align:center">
                                    <h1>
                                    <field name="name1" readonly="1" nolabel="1"/>
                                    <!-- <field name="stainless_steel_visible" invisible='1'/> -->
                                    </h1>
                                </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="garde"></label></td>
                                    <td><field name="garde" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="size"></label></td>
                                    <td><field  name="size" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="sample_status"></label></td>
                                    <td><field name="sample_status" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="sample_submitted"></label></td>
                                    <td><field  name="sample_submitted" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="product_name"></label></td>
                                    <td><field name="product_name" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="No_of_sample"></label></td>
                                    <td><field  name="No_of_sample" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                     <div invisible="mechanical_test_visible == False" style="text-align:center">
                        <h1>
                          
                          <field name="mechanical_test_visible" invisible='1'/>
                          <field name="mechanical_test_name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-2" invisible="mechanical_test_visible == False">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>


                

                

                    <div invisible="mechanical_test_visible == False" class="mb-3">
                    <field name="child_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" />
                                <field name="uts" />
                                <field name="proof_stress" />
                                <field name="elongation" />
                                <field name="total_elongation" />
                                <field name="ratio_uts_ys" />
                                <field name="bend" />
                                <field name="re_bend" />
                                
                              
                            </tree>
                    </field>
                  

                    </div>



                    <div invisible="section_weight_visible == False" style="text-align:center">
                        <h1>
                          
                          <field name="section_weight_visible" invisible='1'/>
                          <field name="section_weight_name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                      <div class="d-flex gap-2" invisible="section_weight_visible == False">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature_section"></label></td>
                                    <td><field name="temprature_section" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity_section"></label></td>
                                    <td><field  name="humidity_section" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                

                

                    <div invisible="section_weight_visible == False" class="mb-3">
                    <field name="section_weight_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" />
                                <field name="weight" />
                                <field name="lenght" />
                                <field name="unit_weight" />
                                <field name="standard_weight" />
                                <field name="tolerance" />
                           
                                
                              
                            </tree>
                    </field>
                  

                    </div>



                    <div invisible="chemical_test_visible == False" style="text-align:center">
                        <h1>
                          
                          <field name="chemical_test_visible" invisible='1'/>
                          <field name="chemical_test_name1" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                     <div class="d-flex gap-2" invisible="chemical_test_visible == False">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature_chemical"></label></td>
                                    <td><field name="temprature_chemical" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity_chemical"></label></td>
                                    <td><field  name="humidity_chemical" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                

                

                    <div invisible="chemical_test_visible == False" class="mb-3">
                    <field name="chemical_test_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" />
                                <field name="c" />
                                <field name="p" />
                                <field name="s" />
                                <field name="p_s"/>
                                <field name="si"/>
                                <field name="cr"/>
                                <field name="cu"/>
                                <field name="mo"/>
                                <field name="ni"/>
                                <field name="mn" />
                           
                                
                              
                            </tree>
                    </field>
                  

                    </div>

                  

                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

        <record id="view_tmt_bar_prefill_data_form" model="ir.ui.view">
            <field name="name">mech.tmt.bar.prefill.data.form</field>
            <field name="model">mech.tmt.bar.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_tmt_bar_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mech.tmt.bar.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_tmt_bar_prefill_data_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>