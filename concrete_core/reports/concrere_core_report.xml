						<table style="width:100%; border-collapse:collapse; font-size:14px;">

    <!-- ===================== HEADER ===================== -->
    <thead>
        <tr style="text-align:center;">

            <th style="text-align:center;
                       border:1px solid black;
                       padding:8px;
                       vertical-align:middle;"
