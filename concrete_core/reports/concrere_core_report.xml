<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="concrete_core_report_ssl">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				
				<div class="container_eln" style="">
					<div class="" t-foreach="eln" t-as="o">
						<table style="margin-top:10px; width: 100%; border-collapse: collapse;">
							<tr>
								<td colspan="12">#Customer Party Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Project / Site Address : <![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Sample Description : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td colspan="6">Test Start Date :<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
								<td colspan="6">Test End Date :<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Sample Id Mark: <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.client_sample_id"/>
								</td>
								<td colspan="6">Sample Receipt Date :<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Size :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								<td colspan="6">#Grade :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Brand :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.brand"/>
								</td>
								<td colspan="6">#Consultant Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.consultant_name1"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Client Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
								</td>
								<td colspan="6">#Client Reference :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client_refrence"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Discipline :
									<![CDATA[&nbsp;]]>
									<span t-field="o.discipline.discipline"/>
								</td>
								<td colspan="6">Group :
									<![CDATA[&nbsp;]]>
									<span t-field="o.group.group"/>
								</td>
							</tr>

							<tr>
								<td colspan="12">Material/Test Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
							</tr>
						</table>
					</div>
					
					
						
					<div style="text-align:center;font-size:18px;margin-top:2px">
					<!-- Concrete Cube -->
						<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','254187-47c9-4662-9298-3095ac900ffc')]).parameter_name"/>
						<!-- <span> -->
							<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','254187-47c9-4662-9298-3095ac900ffc')]).parameter_table" t-as="parameter">
								<t t-if="parameter.grade.id == eln.grade_id.id">
									<span t-field="parameter.specification"/>
								</t>
							</t>
						<!-- </span> -->
						- <span t-field="data.type_of_sample"></span>
					</div>
					<div style="text-align:center;font-size:18px;margin-top:2px">
						<table style="margin-top:2px">				
							<tr>
								<td colspan="6">Dia of core:  </td>
								<td><span t-field="data.thickness2"></span></td>
								<td>
								 mm
								</td>
							</tr>
							<tr>
							
								<td colspan="6">Area Of Core : </td>
								<td> <span t-field="data.area_core"></span></td>
								<td>
								mm2
								</td>
							</tr>
						
						</table>
						<table style="margin-top:2px; width: 100%;">
							<thead>
								<tr>
									<th style="text-align: center; font-weight: bold; width: 5%;">Sr. No</th>
									<th style="text-align: center; font-weight: bold; width: 20%;">Location</th>

									<t t-if="any(r.actual_depth for r in data.child_lines)">
										<th style="text-align: center; font-weight: bold; width: 10%;">
											Actual Depth of Core in mm
										</th>
									</t>

									<th style="text-align: center; font-weight: bold; width: 10%;">Depth after Trimming in mm</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Load kN</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">L /D RATIO</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Core Comp. strength (N/mm²)</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Correction Factor<br/>L/D</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Corrected Cyl. Comp. Strength (N/mm²)</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Equivalent Cube Comp. Strength (N/mm²)</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="data.child_lines" t-as="r">
									<td style="text-align: center;"><span t-esc="r.serial_no"/></td>
									<td style="text-align: center;"><span t-esc="r.location"/></td>

									<t t-if="r.actual_depth">
										<td style="text-align: center;"><span t-esc="r.actual_depth"/></td>
									</t>

									<td style="text-align: center;"><span t-esc="r.depth"/></td>
									<td style="text-align: center;"><span t-esc="r.load" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.ld_ratio" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.core_comp" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.correction_factor_ld" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.correct_comp" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.equivalent_cube" t-options='{"widget": "float", "precision": 2}'/></td>
								</tr>
							</tbody>
						</table>

					</div>
					<div style="margin-top:3px">
						<div style="margin-top:2px;">
							<b>Acceptable Criteria: -</b><span t-esc="o.material.test_parameter"/>
						</div>
						<table style="margin-top:2px">
							<tr>
								<td colspan="12">The Average Equivalent Cube strength of core is equal to atleast 85 % of  Cube strength of the grade of concrete specified :</td>
								<td><span t-field="data.area_equvalent_cube"/></td>
								<td>N/mm²</td>
							</tr>
                            <tr>
								<td colspan="12">Any individual Cube strength computed not less than 75% of the grade of Concrete specified  N/mm² :</td>
								<td><span t-field="data.any_individual_cube"/></td>
								<td>N/mm²</td>
							</tr>
						</table>
					</div>
					
					<!-- <div style="margin-top:5px; page-break-inside: avoid;" class="noteContainer">
							<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Note:-</b>
									&#160;&#160;(i) The results relate only to the items tested 
									&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
									&#160;&#160;(iii) Any corrections invalidate the test reports 
