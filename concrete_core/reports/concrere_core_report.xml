<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="concrete_core_report_ssl">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				
				<div class="container_eln" style="">
					<div class="" t-foreach="eln" t-as="o">
						<table style="margin-top:10px; width: 100%; border-collapse: collapse;">
							<tr>
								<td colspan="12">#Customer Party Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Project / Site Address : <![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Sample Description : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td colspan="6">Test Start Date :<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
								<td colspan="6">Test End Date :<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Sample Id Mark: <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.client_sample_id"/>
								</td>
								<td colspan="6">Sample Receipt Date :<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Size :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								<td colspan="6">#Grade :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Brand :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.brand"/>
								</td>
								<td colspan="6">#Consultant Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.consultant_name1"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Client Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
								</td>
								<td colspan="6">#Client Reference :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client_refrence"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Discipline :
									<![CDATA[&nbsp;]]>
									<span t-field="o.discipline.discipline"/>
								</td>
								<td colspan="6">Group :
									<![CDATA[&nbsp;]]>
									<span t-field="o.group.group"/>
								</td>
							</tr>

							<tr>
								<td colspan="12">Material/Test Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
							</tr>
							<tr>
								<td colspan="4">Instrument :
									<![CDATA[&nbsp;]]>
									<span t-field="o.instrument.name"/>
								</td>
								<td colspan="4">Temperature :
									<![CDATA[&nbsp;]]>
									<span t-field="data.temperature"/>	
								</td>
								<td colspan="4">#Structure Age:
									<![CDATA[&nbsp;]]>
									<span t-field="data.structure"/>
								</td>
								
								
							</tr>
						</table>
					</div>
					
					
						
					<div style="padding-top:2px">
						<span style="font-weight: bold;" t-esc="eln.material.test_parameter"/>: 
					</div>
					<div style="text-align:center;font-size:18px;margin-top:2px">
						
						<table style="margin-top:2px; width: 100%;">
							<thead>
								<tr>
									<th style="text-align: center; font-weight: bold;">Member / Element Type</th>
									<th style="text-align: center; font-weight: bold;">Date of Testing</th>
									<th style="text-align: center; font-weight: bold;">Dia d mm</th>
									<th style="text-align: center; font-weight: bold;">Length h mm</th>
									<th style="text-align: center; font-weight: bold;">L /D RATIO</th>
									<th style="text-align: center; font-weight: bold;">Area mm2</th>
									<th style="text-align: center; font-weight: bold;">Dry wt kg</th>
									<th style="text-align: center; font-weight: bold;">Failure Load kN</th>
									<th style="text-align: center; font-weight: bold;">Measured compressive strength, Mpa</th>
									<th style="text-align: center; font-weight: bold;">Corr Factor as per IS-516(If L/D ratio &lt;= Two) (0.11xL/D+0.78)</th>
									<th style="text-align: center; font-weight: bold;">Corr Factor as per IS-516(If Dia is &lt; 70mm or 75±5 mm)</th>
									<th style="text-align: center; font-weight: bold;">Corr Factor for Eqv.150 mm Cube Strength, as per IS 516</th>
									<th style="text-align: center; font-weight: bold;">Final Eqv.150 mm Cube Strength, Mpa</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="data.child_lines" t-as="r">
									<td style="text-align: center;"><span t-field="r.member"/></td>
									<td style="text-align: center;"><span t-field="r.date_testing"/></td>
									<td style="text-align: center;"><span t-field="r.dia"/></td>
									<td style="text-align: center;"><span t-field="r.length"/></td>
									<td style="text-align: center;"><span t-field="r.ld"/></td>
									<td style="text-align: center;"><span t-field="r.area"/></td>
									<td style="text-align: center;"><span t-field="r.dry"/></td>
									<td style="text-align: center;"><span t-field="r.failure_load"/></td>
									<td style="text-align: center;"><span t-field="r.measured_comp_str"/></td>
									<td style="text-align: center;"><span t-field="r.core_factor_ld"/></td>
									<td style="text-align: center;"><span t-field="r.core_factor_dia"/></td>
									<td style="text-align: center;"><span t-field="r.core_factor_cube"/></td>
									<td style="text-align: center;"><span t-field="r.final_cube_strength"/></td>
								</tr>
							</tbody>
						</table>

					</div>
					<div style="padding-top:2px">
						<table style="margin-top:2px; width: 100%;">
							<tr>
								<td style="text-align: center; font-weight: bold;">Average Compressive Strength in Mpa</td>
								<td style="text-align: center;"><span t-field="data.average"/></td>
							</tr>
						</table>
					</div>

					<div style="page-break-inside: avoid;">
						 <div style="margin-top:20px" class="noteContainer">
							<div>
								<b>Note :-</b>
							</div>
							<div>
								<ul>
									<li>
										The Test Report(s) is/are valid only to the sample submitted to the laboratory.
									</li>
									<li>
										Sample(s) was/were not drawn by laboratory.
									</li>
									<li>
										This Report may not be reproduced in except full/ part without the permission of the Lab Head of the Laboratory.
									</li>
									<li t-if="eln.has_witness">
										Test witnessed by : <span t-esc="eln.witness_name"/>
										
									</li>
									<li t-if="eln.remarks">
										<span t-esc="eln.remarks"/>
									</li>
								</ul>
							</div>
						</div> 
					

                    

						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:30px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div>
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>

							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height:30px">

								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<div style="text-align:center;margin-top:2px">
							......End of Report......
						</div>

				</div>
				</div>
			</t>
		</t>
	</template>
    </odoo>