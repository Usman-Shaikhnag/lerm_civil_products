<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="concrete_core_report_ssl">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				
				<div class="container_eln" style="padding-top:20px;">
					<div class="" t-foreach="eln" t-as="o">
						 <table style="width:100%; border-collapse: collapse;" border="1">

						   <tr style="height:10px;">
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">--</t>
		                            <br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 60px;"/>
									</td>
								
							</tr>
							<tr t-if="o.srf_id.name_work">
								<td colspan="1" >Project Name:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
									</td>
							</tr>

							<tr t-if="o.srf_id.client">
								<td colspan="1" >Name of Agency:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
									</td>
							</tr>
							
							<tr>
								

								<td style="width:20%;">Letter No :-</td>
								<td style="width:20%;">

								  <t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">--</t>
								
								</td>
								<td>Letter Date :-</td>
								<td>
									

									<t t-if="o.srf_id.letter_date">
											<span t-field="o.srf_id.letter_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>

							<tr>

								<td>SRF No. :-</td>
										<td >

											<t t-if="o.srf_id">
											<span t-field="o.srf_id"/>
										</t>
									<t t-else="">--</t>
										</td>
								<td>SRF Date:-</td>
								<td>

									<t t-if="o.srf_date">
											<span t-field="o.srf_date"/>
										</t>
								</td>

								
								
							</tr>
								

								<td style="width:20%;">Temperature :-</td>
								<td style="width:20%;">

								  <t t-if="data.temprature">
											<span t-field="data.temprature"/> (°C)
										</t>
									<t t-else="">--</t>
								
								</td>
								<td>Humidity :-</td>
								<td>
									

									<t t-if="data.humidity">
											<span t-field="data.humidity"/>  (%)
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								<td style="width:20%;">Discipline :
									
								</td>
								<td style="width:20%;">
								<span t-field="o.discipline.discipline"/>
								</td>

								<td style="width:20%;">Group :	
								</td>
								<td style="width:20%;">
									<span t-field="o.group.group"/>
								
								</td>
							</tr>

							<tr>
								<td>Brand &amp; Grade :-</td>
								<td>
								<t t-if="o.sample_id.grade_id.grade">
											<span t-field="o.sample_id.grade_id.grade"/>
										</t>
									<t t-else="">--</t>
									</td>

								<td>Size  :-</td>
								<td>

										<t t-if="o.sample_id.size_id.size">
											<span t-field="o.sample_id.size_id.size"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Description Of Work :
									
								</td>

								<td colspan="3">
								<t t-if="data.description_work">
											<span t-field="data.description_work"/>
										</t>
									<t t-else="">--</t>
								</td>
								
							</tr>

							<tr>
								<td>Date of Samples Received :-</td>
								<td>

									<t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								</td>

									<td>Condition :-</td>
										<td >

											<t t-if="data.condition">
											<span t-field="data.condition"/>
										</t>
									<t t-else="">--</t>
										</td>
								
							</tr>

							<tr>
								

								<td colspan="1">Samples Description :-</td>
								<td colspan="3">
								      <t t-if="o.material and o.material.lab_name">
											<span t-field="o.material.lab_name"/>
										</t>
								</td>
								
							</tr>

							<tr>

								<td>Sample Status :-</td>
								<td></td>
								
								<td>Quantity:-</td>
								<td>

								<t t-if="o.sample_id.sample_qty">
											<span t-field="o.sample_id.sample_qty"/>
										</t>
									<t t-else="">--</t>

								<t t-if="o.sample_id.uom_id">
											<span t-field="o.sample_id.uom_id"/>
										</t>
									<t t-else="">--</t>
								
								</td>

							

								
							</tr>

							

							<tr>
								
								<td>Test Start Date  :-</td>
								<td>

									<t t-if="o.start_date">
											<span t-field="o.start_date"/>
										</t>
									<t t-else="">--</t>
								</td>

								<td>Test Completion Date  :-</td>
								<td>

									<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								

								<td>Week No.  :-</td>
								<td >

									<t t-if="data.week_no">
									<span t-field="data.week_no"/>
								</t>
							<t t-else="">--</t>
								</td>

								<td>Other Details  :-</td>
								<td >

									<t t-if="data.other_details">
									<span t-field="data.other_details"/>
								</t>
							<t t-else="">--</t>
								</td>
							</tr>

						
							<tr t-if="o.material.test_method_adopted" >
								

									<td >Test method adopted:</td>
									<td colspan="3"><span t-field="o.material.test_method_adopted"/></td>

							
							</tr>
							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

								<tr t-if="o.material.specification_code">
									<td style="font-weight: bold;">Specifications</td>
									<td colspan="3"><span t-field="o.material.specification_code"/></td>
								</tr>

						</table>					</div>
					
					
						
					<div style="text-align:center;font-size:18px;margin-top:2px">
					<!-- Concrete Cube -->
						<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','254187-47c9-4662-9298-3095ac900ffc')]).parameter_name"/>
						<!-- <span> -->
							<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','254187-47c9-4662-9298-3095ac900ffc')]).parameter_table" t-as="parameter">
								<t t-if="parameter.grade.id == eln.grade_id.id">
									<span t-field="parameter.specification"/>
								</t>
							</t>
						<!-- </span> -->
						- <span t-field="data.type_of_sample"></span>
					</div>
					<div style="text-align:center;font-size:18px;margin-top:2px">
						<table style="margin-top:2px">				
							<tr>
								<td colspan="6">Dia of core:  </td>
								<td><span t-field="data.thickness2"></span></td>
								<td>
								 mm
								</td>
							</tr>
							<tr>
							
								<td colspan="6">Area Of Core : </td>
								<td> <span t-field="data.area_core"></span></td>
								<td>
								mm2
								</td>
							</tr>
						
						</table>
						<table style="margin-top:2px; width: 100%;">
							<thead>
								<tr>
									<th style="text-align: center; font-weight: bold; width: 5%;">Sr. No</th>
									<th style="text-align: center; font-weight: bold; width: 20%;">Location</th>

									<t t-if="any(r.actual_depth for r in data.child_lines)">
										<th style="text-align: center; font-weight: bold; width: 10%;">
											Actual Depth of Core in mm
										</th>
									</t>

									<th style="text-align: center; font-weight: bold; width: 10%;">Depth after Trimming in mm</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Load kN</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">L /D RATIO</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Core Comp. strength (N/mm²)</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Correction Factor<br/>L/D</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Corrected Cyl. Comp. Strength (N/mm²)</th>
									<th style="text-align: center; font-weight: bold; width: 8%;">Equivalent Cube Comp. Strength (N/mm²)</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="data.child_lines" t-as="r">
									<td style="text-align: center;"><span t-esc="r.serial_no"/></td>
									<td style="text-align: center;"><span t-esc="r.location"/></td>

									<t t-if="r.actual_depth">
										<td style="text-align: center;"><span t-esc="r.actual_depth"/></td>
									</t>

									<td style="text-align: center;"><span t-esc="r.depth"/></td>
									<td style="text-align: center;"><span t-esc="r.load" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.ld_ratio" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.core_comp" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.correction_factor_ld" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.correct_comp" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="text-align: center;"><span t-esc="r.equivalent_cube" t-options='{"widget": "float", "precision": 2}'/></td>
								</tr>
							</tbody>
						</table>

					</div>
					<div style="margin-top:3px">
						<div style="margin-top:2px;">
							<b>Acceptable Criteria: -</b><span t-esc="o.material.test_parameter"/>
						</div>
						<table style="margin-top:2px">
							<tr>
								<td colspan="12">The Average Equivalent Cube strength of core is equal to atleast 85 % of  Cube strength of the grade of concrete specified :</td>
								<td><span t-field="data.area_equvalent_cube"/></td>
								<td>N/mm²</td>
							</tr>
                            <tr>
								<td colspan="12">Any individual Cube strength computed not less than 75% of the grade of Concrete specified  N/mm² :</td>
								<td><span t-field="data.any_individual_cube"/></td>
								<td>N/mm²</td>
							</tr>
						</table>
					</div>
					
						<div style="text-align:center;margin-top:5px">
						......End of Report......
					</div>



						
						


						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 50px;">
									<t t-if="eln.sample_id.checkby_signature_required and eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')"
											style="max-width: 200px; max-height: 45px; margin-top: 1px; z-index: -10;"/>
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<t t-if="o.sample_id.stamp_attached">
							<div >
								<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div>
							</div>
						</t>

							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height: 50px;">
									<t t-if="eln.sample_id.approveby_signature_required">
										<div t-if="eln.sample_id.approved_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						

				</div>
			</t>
		</t>
	</template>
    </odoo>