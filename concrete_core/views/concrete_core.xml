<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="concrete_core_view" model="ir.ui.view">
        <field name="name">mechanical.concrete.core.form</field>
        <field name="model">mechanical.concrete.core</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="grade"/>
                        <field name="eln_state" />

                    </group>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

              


                  
                <div class="d-flex gap-2">
                    <table class="table table-sm o_form_table table-bordered custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label for="temperature">Temperature °C</label></td>
                                <td><field name="temperature"/></td>
                            </tr>
                            <tr>
                                <td><label for="structure">Structure Age</label></td>
                                <td><field name="structure"/></td>
                            </tr>
                            
                        </tbody>
                    </table>
                    
                    
                </div>



                <div>
                    <field name="child_lines"  mode="tree" nolabel="1">
                            <tree editable="bottom" class="custom_table_borders" >
                                <field name="member" string="Member / Element Type"/>
                                <field name="date_testing" string="Date of Testing"/>
                                <field name="dia" string="dia d mm"/>
                                <field name="length" string="length h mm"/>
                                <field name="ld" string="L/D" readonly='1'/>
                                <field name="area" string="Area mm2" readonly='1'/>
                                <field name="dry" string="Dry wt kg"/>
                                <field name="failure_load" string="Failure Load kN"/>
                                <field name="measured_comp_str" string="Measured compressive strength, Mpa" readonly='1'/>
                                <field name="core_factor_ld" string="Corr Factor as per IS-516(If L/D ratio &lt;= Two) (0.11xL/D+0.78)" readonly='1'/>
                                <field name="core_factor_dia" string="Corr Factor as per IS-516(If Dia is &lt; 70mm or 75±5 mm)" readonly='1'/>
                                <field name="core_factor_cube" string="Corr Factor for Eqv.150 mm Cube Strength, as per IS 516" readonly='1'/>
                                <field name="final_cube_strength" string="Final Eqv.150 mm Cube Strength, Mpa" readonly='1'/>
                            </tree>
                    </field>

                </div>
                <div class="d-flex gap-2">
                    <table class="table table-sm o_form_table table-bordered custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label for="average">Average Compressive Strength in Mpa</label></td>
                                <td><field name="average"/></td>
                            </tr>
                           
                            
                        </tbody>
                    </table>
                    
                    
                </div>



                <notebook>

                    <page string="Notes">
                        <div class="custom_table_borders" style="margin-top: 15px;">
                            <field name="notes" nolabel="1">
                                <tree editable="bottom">
                                    <field name="notes"  />
                                </tree>
                            </field>
                            
                        </div>
                    </page>

                </notebook>


                <div style="margin-top:10px;">

                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit" />
                </div>
                </sheet>
            </form>
        </field>
        </record>


        

    </data>
</odoo>