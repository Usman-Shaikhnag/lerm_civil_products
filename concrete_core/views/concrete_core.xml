<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="concrete_core_view" model="ir.ui.view">
        <field name="name">mechanical.concrete.core.form</field>
        <field name="model">mechanical.concrete.core</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                        <field name="grade"/>
                         

                    </group>
                    <!-- <group class="custom_table_borders"> -->
                      <field name="sample_parameters" nolabel="1" class="custom_table_borders">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    <!-- </group> -->

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <!-- Water Permeability -->

                    <div invisible="water_permeability_visible == False" style="text-align:center">
                      <h1>
                          <field name="water_permeability_name" readonly="1" nolabel="1"/>
                          <field name="water_permeability_visible" invisible='1'/>
                      </h1>
                    </div>

                    <div invisible="water_permeability_visible == False" class="custom_table_borders">
                        <field name="water_permeability_table" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no' width="120"/>
                                <field name='pressure' class="blue-input" decoration-info="pressure != 0" width="120"/>
                                <field name='duration' class="blue-input" decoration-info="duration != 0" width="120"/>
                                <field name='maximum_depth' class="blue-input" decoration-info="maximum_depth" width="120"/>
                                <field name='average_depth' class="blue-input" decoration-info="average_depth"  width="120"/>
                            </tree>
                        </field>
                    </div>
                    
                    

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_permeability_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Depth of Penetration (mm)</strong></td>
                                <td>
                                    <field name="average_depth"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Conformity</strong></td>
                                <td>
                                    <field name="average_depth_confirmity"
                                        decoration-success="average_depth_confirmity == 'pass'"
                                        decoration-danger="average_depth_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong for="average_depth_nabl">NABL</strong></td>
                                <td>
                                    <field name="average_depth_nabl"
                                        decoration-success="average_depth_nabl == 'pass'"
                                        decoration-danger="average_depth_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="water_permeability_report_type">Report Type</label></td>
                                <td><field name="water_permeability_report_type" class="blue-input" decoration-info="water_permeability_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>


                    <!-- compressive Strength -->

                    <div invisible="compressive_strength_visible == False" style="text-align:center">
                      <h1>
                          <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                          <field name="compressive_strength_visible" invisible='1'/>
                      </h1>
                    </div>

                    <div invisible="compressive_strength_visible == False" class="custom_table_borders">
                        <field name="compressive_strength_table" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no' width="120"/>
                                <field name='age' class="blue-input" decoration-info="age != 0" width="120"/>
                                <field name='height' class="blue-input" decoration-info="height != 0" width="120"/>
                                <field name='diameter' class="blue-input" decoration-info="diameter" width="120"/>
                                <field name='hd_ratio' readonly="1" width="120"/>
                                <field name='correction_factor' readonly="1" width="120"/>
                                <field name='area' readonly="1" width="120"/>
                                <field name='volume' readonly="1" width="120"/>
                                <field name='weight'  class="blue-input" decoration-info="weight" width="120"/>
                                <field name='density' readonly="1" width="120"/>
                                <field name='load'  class="blue-input" decoration-info="load" width="120"/>
                                
                                <field name='compressive_strength' readonly="1" width="120"/>
                            </tree>
                        </field>
                    </div>
                    
                    

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not compressive_strength_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Compressive Strength</strong></td>
                                <td>
                                    <field name="avg_compressive_strength"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Conformity</strong></td>
                                <td>
                                    <field name="avg_compressive_strength_confirmity"
                                        decoration-success="avg_compressive_strength_confirmity == 'pass'"
                                        decoration-danger="avg_compressive_strength_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong for="avg_compressive_strength_nabl">NABL</strong></td>
                                <td>
                                    <field name="avg_compressive_strength_nabl"
                                        decoration-success="avg_compressive_strength_nabl == 'pass'"
                                        decoration-danger="avg_compressive_strength_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="compressive_strength_report_type">Report Type</label></td>
                                <td><field name="compressive_strength_report_type" class="blue-input" decoration-info="compressive_strength_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

              


                  
                   
                    

                    <div style="margin-top:10px;">
                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit" />
                    </div>
                </sheet>
            </form>
        </field>
        </record>


        <record id="view_concrete_core_prefill_data_form" model="ir.ui.view">
            <field name="name">concrete.core.prefill.data.form</field>
            <field name="model">concrete.core.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_concrete_core_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">concrete.core.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_concrete_core_prefill_data_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>