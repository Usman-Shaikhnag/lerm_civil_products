                    <td style="width:400px;"><b style="font-size:16px;"> Positioning of the Thermocouples:</b></td><td><span t-field="data.position_thermpcouples"  style="font-size:16px;"/></td>
                    </table>
                    </div>

                    <div style="margin-top:5px">
                     <table>
                    <td style="width:400px;"><b style="font-size:16px;"> Result:</b></td><td><span t-field="data.result"  style="font-size:16px;"/></td>
                    </table>
                    </div>
                    <div style="text-align: center;">
