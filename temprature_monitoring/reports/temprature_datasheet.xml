             <t t-call="lerm_civil.mechanical_data_sheet_header">

            
        
                <div style="text-align:center;font-size:18px;font-weight: bold">
                    TEMPRATURE MONITORING OF CONCRETE DATASHEET
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6" style="font-size:16px;">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no" style="font-size:16px;"></span>
                            </td>
                            <td colspan="6" style="font-size:16px;">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date" style="font-size:16px;"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" style="font-size:16px;">Material: <span t-field="eln.material" style="font-size:16px;"></span>
                            </td>
                            <td colspan="6" style="font-size:16px;">Test End Date: <span t-field="eln.end_date" style="font-size:16px;"></span>
                            </td>
                        </tr>

                          <tr style="height:50px" cols="12">
								<td colspan="4" style="font-size:16px;">Performed By :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.technician.name" style="font-size:16px;"/>
								</td>
								<td colspan="4" style="font-size:16px;">Witness Name :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.witness_name" style="font-size:16px;"/>
								</td>
								<td colspan="4" style="font-size:16px;">Witness Signature :
									<![CDATA[&nbsp;]]>
									<span style='padding:20px'></span>
								</td>
							</tr>
                    </table>
                  

                       <table style="width:100%; border-collapse: collapse;">
                        <tr>
                            <td style="width:400px;"><b style="font-size:16px;">Introduction</b></td>
                            <td><span t-field="data.introduction" style="font-size:16px;"/></td>
                        </tr>
                    </table>

                    <!-- </div> -->

                     <table  style="margin-top:10px;width:100%; border-collapse: collapse;">
                        <tr><td style="width:400px;"><b style="font-size:16px;">Raft Thickness:</b></td><td><span t-field="data.raft_thickness"  style="font-size:16px;"/></td></tr>
                        <tr><td style="width:400px;"><b style="font-size:16px;">Date of Pouring:</b></td><td><span t-field="data.date_pouring" style="font-size:16px;"/></td></tr>
                        <tr><td style="width:400px;"><b style="font-size:16px;">Date of Termination:</b></td><td><span t-field="data.date_termination" style="font-size:16px;"/></td></tr>
                        <tr><td style="width:400px;"><b style="font-size:16px;">Period of Monitoring:</b></td><td><span t-field="data.period_monitoring" style="font-size:16px;"/></td></tr>
                    </table>

                    <div style="text-align: center;">
                    <t t-foreach="data.tempreture_upload1" t-as="attachment">
							<t t-if="attachment.mimetype.startswith('image/')">
								<div class="container_eln">
									<div style="display: flex; justify-content: center; align-items: center; margin-top: 20px;">
										<img t-att-src="'data:image/png;base64,' + attachment.datas.decode('utf-8')" 
											alt="Report Image" class="img img-responsive"
											style="width: 800px; height: auto; border: 1px solid #ddd; padding: 5px;" />
									</div>
								</div>
							</t>
						</t>
                        </div>

                 

                    <div style="margin-top:5px">
                     <table>
                    <td style="width:400px;"><b style="font-size:16px;"> Temperature Monitoring location:</b></td><td><span t-field="data.temprerature_location"  style="font-size:16px;"/></td>
                    </table>
                    </div>
                     <div style="text-align: center;">
                    <t t-foreach="data.tempreture_upload2" t-as="attachment">
							<t t-if="attachment.mimetype.startswith('image/')">
								<div class="container_eln">
									<div style="display: flex; justify-content: center; align-items: center; margin-top: 20px;">
										<img t-att-src="'data:image/png;base64,' + attachment.datas.decode('utf-8')" 
