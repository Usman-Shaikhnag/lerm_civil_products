<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_pever_nbml_block1" model="ir.ui.view">
        <field name="name">mechanical.paver.nbml.block.form</field>
        <field name="model">mechanical.paver.nbml.block</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   <group style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="name_paver" readonly="1" nolabel="1"/>
                        </h1>
                    </group>
                     <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    <group >
                       <field name="grade"/>
                       <field name="size_id" />
                    </group>
                    
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                   <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="week_no"></label></td>
                                    <td><field name="week_no" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="other_details"></label></td>
                                    <td><field  name="other_details" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="condition"></label></td>
                                    <td><field name="condition" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>
                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                     


                    <group invisible = "commpressive_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="commpressive_name" readonly="1" nolabel="1"/>
                            <field name="commpressive_visible" invisible="1"/>
                        </h1>
                    </group>

                   <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="block_type"></label></td>
                                    <td><field name="block_type" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="correction_factor"></label></td>
                                    <td><field  name="correction_factor" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>


                    <div invisible = "commpressive_visible == False"   style="width: 100%;">
                    <field name="commpressive_child_lines"   mode="tree" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders" style="width: 100%;">
                                <field name="serial_no"/>
                                <field name="lenght" class="blue-input" decoration-info="lenght != 0"/>
                                <field name="width" class="blue-input" decoration-info="width != 0"/>
                                <field name="thickness" class="blue-input" decoration-info="thickness != 0"/>
                                <field name="area" />
                                <field name="load"  class="blue-input" decoration-info="load != 0"/>
                                <field name="apparent_com"/>
                                <field name="correction_factor" />
                                <field name="compressive_strenght"/>
                               
                            </tree>
                    </field>
                   
                    </div>


                      <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "commpressive_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_commpressive"></label></td>
                                <td><field name="avg_commpressive"/> <span> N/mm²</span></td>
                            </tr>
                            
                        </tbody>
                    </table>


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "commpressive_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_commpressive_conformity">NABL</label></td>
                                <td><field name="avg_commpressive_conformity"
                                            decoration-success="avg_commpressive_conformity == 'pass'"
                                            decoration-danger="avg_commpressive_conformity == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_commpressive_nabl">NABL</label></td>
                                <td><field name="avg_commpressive_nabl"
                                            decoration-success="avg_commpressive_nabl == 'pass'"
                                            decoration-danger="avg_commpressive_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>




                     <group invisible = "abrasion_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="abrasion_name" readonly="1" nolabel="1"/>
                            <field name="abrasion_visible" invisible="1"/>
                        </h1>
                    </group>

                  

                    <div invisible = "abrasion_visible == False"   style="width: 100%;">
                    <field name="abrasion_child_lines"   mode="tree" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders" style="width: 100%;">
                                <field name="serial_no"/>
                                <field name="sample_id" class="blue-input" decoration-info="sample_id != 0"/>
                                <field name="initial_wt" class="blue-input" decoration-info="initial_wt != 0"/>
                                <field name="wt_in_water" class="blue-input" decoration-info="wt_in_water != 0"/>
                                <field name="volume"/>
                                <field name="density" />
                                <field name="final_wt" class="blue-input" decoration-info="wt_in_water != 0"/>
                                <field name="loss_mass" class="blue-input" decoration-info="loss_mass != 0"/>
                                <field name="loss_volume"/>
                                <field name="abrasion"/>
                               
                            </tree>
                    </field>
                   
                    </div>


                      <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "abrasion_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_abrasion"></label></td>
                                <td><field name="avg_abrasion"/> <span> </span></td>
                            </tr>
                            
                        </tbody>
                    </table>


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "abrasion_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_abrasion_conformity"></label></td>
                                <td><field name="avg_abrasion_conformity"
                                            decoration-success="avg_abrasion_conformity == 'pass'"
                                            decoration-danger="avg_abrasion_conformity == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_abrasion_nabl"></label></td>
                                <td><field name="avg_abrasion_nabl"
                                            decoration-success="avg_abrasion_nabl == 'pass'"
                                            decoration-danger="avg_abrasion_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>




                <group invisible = "flexural_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="flexural_name" readonly="1" nolabel="1"/>
                            <field name="flexural_visible" invisible="1"/>
                        </h1>
                    </group>


                     <table class="table table-sm o_form_table table-bordered custom_table_borders" invisible = "flexural_visible == False" >
                            <tbody>
                                
                                    <tr>
                                    <td><label for="correction_factor_flexural"></label></td>
                                    <td><field  name="correction_factor_flexural" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                  

                    <div invisible = "flexural_visible == False"   style="width: 100%;">
                    <field name="flexural_child_lines"   mode="tree" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders" style="width: 100%;">
                                <field name="serial_no"/>
                                <field name="distance" class="blue-input" decoration-info="distance != 0"/>
                                <field name="width" class="blue-input" decoration-info="width != 0"/>
                                <field name="area" class="blue-input" decoration-info="area != 0"/>
                                <field name="load" class="blue-input" decoration-info="load != 0"/>
                                <field name="flexural_strength" />
                                <field name="correction_factor"/>
                                <field name="corrected_strength"/>
                               
                            </tree>
                    </field>
                   
                    </div>


                      <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "flexural_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_flexural"></label></td>
                                <td><field name="avg_flexural"/> <span> </span></td>
                            </tr>
                            
                        </tbody>
                    </table>


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;" invisible = "flexural_visible == False">
                        <tbody>
                          
                             <tr>
                                <td><label class="fw-bold" for="avg_flexural_conformity"></label></td>
                                <td><field name="avg_flexural_conformity"
                                            decoration-success="avg_flexural_conformity == 'pass'"
                                            decoration-danger="avg_flexural_conformity == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_flexural_nabl"></label></td>
                                <td><field name="avg_flexural_nabl"
                                            decoration-success="avg_flexural_nabl == 'pass'"
                                            decoration-danger="avg_flexural_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>
                  
                       

                  
                       



                    
                    
                <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>







                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     


                </sheet>
            </form>
        </field>
        </record>

        <record id="view_paver_nbml_prefill_data_form" model="ir.ui.view">
            <field name="name">mechanical.paver.nbml.block.prefill.data.form</field>
            <field name="model">mechanical.paver.nbml.block.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_paver_nbml_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mechanical.paver.nbml.block.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_paver_nbml_prefill_data_form"/>
            <field name="target">new</field>
        </record>



        
    </data>
</odoo>