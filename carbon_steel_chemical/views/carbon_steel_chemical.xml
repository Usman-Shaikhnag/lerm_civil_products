<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="carbon_steel_chemical_view" model="ir.ui.view">
        <field name="name">chemical.carbon.steel.form</field>
        <field name="model">chemical.carbon.steel</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>

                
                   <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                     <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <!-- <field name="grade" readonly="1"/> -->
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                        <field name="grade"/>
                         <field name="size_id"/>
                        
                    </group>
                    
                    <!-- <group style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </group> -->

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div  style="text-align:center">
                                    <h1>
                                    <field name="name1" readonly="1" nolabel="1"/>
                                    <!-- <field name="stainless_steel_visible" invisible='1'/> -->
                                    </h1>
                                </div>

                    



                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="sample_status"></label></td>
                                    <td><field name="sample_status" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="sample_submitted"></label></td>
                                    <td><field  name="sample_submitted" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="product_name"></label></td>
                                    <td><field name="product_name" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="No_of_sample"></label></td>
                                    <td><field  name="No_of_sample" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                     <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                  


                     <div invisible="mechanical_test_visible == False" style="text-align:center">
                        <h1>
                          
                          <field name="mechanical_test_visible" invisible='1'/>
                          <field name="mechanical_test_name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                     <div class="d-flex gap-2" invisible="mechanical_test_visible == False">
                        <table class="table table-sm table-bordered w-40 mt-2 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered w-30 mt-2 custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-30 mt-2 custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="test_method_mech"></label></td>
                                    <td><field  name="test_method_mech" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                

                

                    <div invisible="mechanical_test_visible == False" class="mb-3">
                    <field name="child_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" class="blue-input" decoration-info="sample_identity != 0"/>
                                <field name="uts"  class="blue-input" decoration-info="uts != 0"/>
                                <field name="proof_stress"  class="blue-input" decoration-info="proof_stress != 0"/>
                                <field name="elongation"  class="blue-input" decoration-info="elongation != 0"/>
                                <field name="total_elongation" class="blue-input" decoration-info="total_elongation != 0"/>
                                <field name="ratio_uts_ys" class="blue-input" decoration-info="ratio_uts_ys != 0" />
                                <field name="bend" class="blue-input" decoration-info="bend != 0"/>
                                <field name="re_bend" class="blue-input" decoration-info="re_bend != 0"/>
                                <field name="yield_stress" class="blue-input" decoration-info="yield_stress != 0"/>
                                
                              
                            </tree>
                    </field>
                  

                    </div>



                    <div invisible="section_weight_visible == False" style="text-align:center">
                        <h1>
                          
                          <field name="section_weight_visible" invisible='1'/>
                          <field name="section_weight_name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-2" invisible="section_weight_visible == False">
                        <table class="table table-sm table-bordered w-40 mt-2 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temprature_section"></label></td>
                                    <td><field name="temprature_section" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered w-30 mt-2 custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity_section"></label></td>
                                    <td><field  name="humidity_section" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                         <table class="table table-sm table-bordered w-30 mt-2 custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="test_method_section"></label></td>
                                    <td><field  name="test_method_section" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                

                

                    <div invisible="section_weight_visible == False" class="mb-3">
                    <field name="section_weight_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" class="blue-input" decoration-info="sample_identity != 0"/>
                                <field name="weight" class="blue-input" decoration-info="weight != 0" string="Weight (Kg/m)"/>
                                <field name="lenght" class="blue-input" decoration-info="lenght != 0"/>
                                <field name="unit_weight" class="blue-input" decoration-info="unit_weight != 0"/>
                                <field name="standard_weight" class="blue-input" decoration-info="standard_weight != 0" string="Standard Weight  as per IS 1786-2008 (Kg/m)"/>
                                <field name="tolerance" class="blue-input" decoration-info="tolerance != 0"/>
                           
                                
                              
                            </tree>
                    </field>
                  

                    </div>



                    <div invisible="chemical_test_visible == False" style="text-align:center">
                        <h1>
                          
                          <field name="chemical_test_visible" invisible='1'/>
                          <field name="chemical_test_name1" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                     <div class="d-flex gap-2" invisible="chemical_test_visible == False">
                        <table class="table table-sm table-bordered w-40 mt-2 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature_chemical"></label></td>
                                    <td><field name="temprature_chemical" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered w-30 mt-2 custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity_chemical"></label></td>
                                    <td><field  name="humidity_chemical" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>

                        <table class="table table-sm table-bordered w-30 mt-2 custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="test_method_chemical"></label></td>
                                    <td><field  name="test_method_chemical" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                

                

                    <div invisible="chemical_test_visible == False" class="mb-3">
                    <field name="chemical_test_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" class="blue-input" decoration-info="sample_identity != 0" />
                                <field name="c" class="blue-input" decoration-info="c != 0"/>
                                <field name="p" class="blue-input" decoration-info="p != 0"/>
                                <field name="s" class="blue-input" decoration-info="s != 0"/>
                                <field name="p_s" class="blue-input" decoration-info="p_s != 0"/>
                                <field name="si" class="blue-input" decoration-info="si != 0"/>
                                <field name="cr" class="blue-input" decoration-info="cr != 0"/>
                                <field name="cu" class="blue-input" decoration-info="cu != 0"/>
                                <field name="mo" class="blue-input" decoration-info="mo != 0"/>
                                <field name="ni" class="blue-input" decoration-info="ni != 0"/>
                                <field name="mn" class="blue-input" decoration-info="mn != 0" />
                           
                                
                              
                            </tree>
                    </field>
                  

                    </div>

                  

                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

        <!-- <record id="view_tmt_bar_prefill_data_form" model="ir.ui.view">
