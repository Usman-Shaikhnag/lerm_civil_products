					<div class="page">
                        <div class="text-center">
                            <h6>Chloride Ion Penetrability (ASTM C 1202:2022)</h6>
                        </div>

                        <table >
						    
                            <thead>
                                <tr>
                                    <th style="text-align: center;font-weight: bold;">Charge Passed</th>
