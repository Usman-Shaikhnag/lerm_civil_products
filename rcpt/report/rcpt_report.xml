										<span t-field="o.end_date" style="margin-left:10px;"/>
									</td>
								</tr>
								<tr>
									<td><strong>Type of Sample</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>
								</tr>
								<!-- Source of Sample (only if value exists) -->
								<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td><span t-field="o.material.source_sample"/></td>
								</tr>

								<!-- Test method adopted (only if value exists) -->
								<tr t-if="o.material.test_method_adopted">
									<td style="font-weight: bold;">Test method adopted:</td>
									<td><span t-field="o.material.test_method_adopted"/></td>
								</tr>
							</tbody>
						</table>
