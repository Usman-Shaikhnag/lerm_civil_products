                      <tr>
                        <td><label for="wt_ssd_sample">Weight of saturated surface dry (SSD) sample in air in gms, A</label></td>
                        <td ><field name="wt_ssd_sample"/></td>
                      </tr>
                      <tr>
                        <td><label for="oven_dried_wt">Oven dried weight of sample in gms, C</label></td>
                        <td><field name="oven_dried_wt"/></td>
                      </tr>
                      <tr>
                        <td><label for="water_absorbtion">Water absorption %</label></td>
                        <td><field name="water_absorbtion"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>
                    <group/>
                    <group/>

                    <div>
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
