                            <td style="padding: 5px;"> <field name="total_elongated_retained" class="oe_center" /></td>
                           </tr>
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Total Flakiness</span></td>
                            <td style="padding: 5px;"><field name="total_flakiness_retained" class="oe_center" /></td>
                           </tr>
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>	Flakiness Conformity</span></td>
                              <td style="padding: 8px;"><field  name="aggregate_flakiness_conformity"
                                        decoration-success="aggregate_flakiness_conformity == 'pass'" 
                                        decoration-danger="aggregate_flakiness_conformity == 'fail'" 
                                        readonly="1" string="Flakiness Conformity"/>
                            </td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"><field  name="aggregate_flakiness_nabl" /></td>
                           </tr>
                     
                          </table>
                      </div>

                      <div style="width: 50%;">
                             <table style="width: 100%; margin-top:10px;">
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Aggregate Elongation Value in %</span></td>
                            <td style="padding: 5px;"><field name="aggregate_elongation" class="oe_center" /></td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Aggregate Flakiness Value in %</span></td>
                            <td style="padding: 5px;"> <field name="aggregate_flakiness" class="oe_center" /></td>
                           </tr>
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Aggregate Elongation And Flakiness Value in %</span></td>
                            <td style="padding: 5px;"><field name="aggregate_combine" class="oe_center" /></td>
                           </tr>
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>Elongation Conformity</span></td>
                              <td style="padding: 8px;"> <field  name="aggregate_elongation_conformity"
                                        decoration-success="aggregate_elongation_conformity == 'pass'" 
                                        decoration-danger="aggregate_elongation_conformity == 'fail'" 
                                        readonly="1" string="Elongation Conformity" />
                            
                            </td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"><field  name="aggregate_elongation_nabl" /></td>
                           </tr>
                     
                          </table>
                      </div>
                      </div>
