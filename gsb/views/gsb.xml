                    </table>

                      


             
                <!-- Density Relation Heavy Compaction  -->
                <div invisible="not density_relation_visible">
                        <h1>
                            <field name="density_relation_name" readonly="1" nolabel="1"/>
                            <field name="density_relation_visible" invisible="1"/>

                        </h1>
                </div>



                       <div class="d-flex gap-2" invisible="not density_relation_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="wt_of_modul">Weight of Mould in gm</label></td>
                                    <td><field name="wt_of_modul"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="vl_of_modul">Volume of Mould in cc</label></td>
                                    <td><field name="vl_of_modul"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>


                <!-- <group invisible="not density_relation_visible" style="width:50%">
                    <field name="wt_of_modul" />
                    <field name="vl_of_modul" />
                </group> -->


                <group invisible="not density_relation_visible">
                    <field name="density_relation_table" nolabel="1" colspan="2" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='determination_no'/>
                                <field name='wt_of_modul_compact'/>
                                <field name='wt_of_compact'/>
                                <field name='bulk_density'/>
                                <field name='container_no'/>
                                <field name='wt_of_container'/>
                                <field name='wt_of_container_wet'/>
                                <field name='wt_of_container_dry'/>
                                <field name='wt_of_dry_sample'/>
                                <field name='wt_of_moisture'/>
                                <field name='moisture'/>
                                <field name='dry_density'/>
