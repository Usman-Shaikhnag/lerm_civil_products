                           <tr>
                             <td><label for="aggregate_flakiness_conformity">Flakiness Conformity</label></td>
                              <td><field  name="aggregate_flakiness_conformity"
                                        decoration-success="aggregate_flakiness_conformity == 'pass'" 
                                        decoration-danger="aggregate_flakiness_conformity == 'fail'" 
                                        readonly="1" string="Flakiness Conformity"/>
                            </td>
                           </tr>
                           <tr>
                            <td><label for="aggregate_flakiness_nabl">NABL</label></td>
                            <td><field  name="aggregate_flakiness_nabl" /></td>
                           </tr>
                           </tbody>
                          </table>
                      </div>

                      <div style="width: 50%;">
                             <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                             <tbody>
                          <tr>
                            <td><label for="aggregate_elongation">ggregate Elongation Value in %</label></td>
                            <td><field name="aggregate_elongation" class="oe_center" /></td>
                           </tr>
                           <tr>
                            <td><label for="aggregate_flakiness">Aggregate Flakiness Value in %</label></td>
                            <td><field name="aggregate_flakiness" class="oe_center" /></td>
                           </tr>
                          <tr>
                            <td><label for="aggregate_combine">Aggregate Elongation And Flakiness Value in %</label></td>
                            <td><field name="aggregate_combine" class="oe_center" /></td>
                           </tr>
                           <tr>
                             <td><label for="aggregate_elongation_conformity">Elongation Conformity</label></td>
                              <td><field  name="aggregate_elongation_conformity"
