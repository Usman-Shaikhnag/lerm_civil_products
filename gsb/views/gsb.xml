                                        decoration-danger="water_absorbtion_conformity == 'fail'" 
                                        readonly="1" /></td>
                           </tr>
                           <tr>
                            <td><label for="water_absorbtion_nabl">NABL</label></td>
                            <td><field  name="water_absorbtion_nabl" /></td>
                           </tr>
                           </tbody>
                          </table>
                      </div>
                      <group/>




                    <!-- <group invisible="not water_absorbtion_visible" style="white-space:nowrap; width:60%">
