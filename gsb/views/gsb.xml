<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_gsb_form" model="ir.ui.view">
        <field name="name">mechanical.gsb.form</field>
        <field name="model">mechanical.gsb</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                <group >
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                      <field name="sample_parameters" nolabel="1">
                        <tree class="custom_table_borders">
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    
                    <!-- Dry Gradation -->

                    <div invisible="not dry_gradation_visible">
                        <h1>
                            <field name="dry_gradation_name" readonly="1" nolabel="1"/>
                            <field name="dry_gradation_visible" invisible="1"/>
                        </h1>
                    </div>

                    <group invisible="not dry_gradation_visible">
                        <field name="dry_gradation_table" nolabel="1" colspan="2">
                        <tree editable="bottom" class="custom_table_borders">
                          <field name="sieve_size"  />
                          <field name="wt_retained"/>
                          <field name="percent_retained"/>
                          <field name="cumulative_retained" readonly="1"/>
                          <field name="passing_percent" readonly="1"/>
                        </tree>
                        </field>
                    </group>
                    

                     <div   invisible="not dry_gradation_visible">
                            <button string="Calculate"
                                    type="object"
                                    name="calculate_sieve"
                                    class="oe_highlight">
                                <i class="fa fa-calculator"/>  Calculate 
                            </button>
                        </div>

                          <!-- <table style="width: 20%; ">
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Total</span></td>
                            <td style="padding: 5px;"><field name="total_sieve_analysis" class="oe_center" /></td>
                           </tr>
                           </table> -->

                            <!-- <table style="width: 20%; margin-top:10px;" invisible="not dry_gradation_visible">
                             <tr>
                                <td style="padding: 5px;font-weight: bold;"><span>Total</span></td>
                                <td style="padding: 5px;"><field name="total_sieve_analysis" class="oe_center" /></td>
                              </tr>
                     
                          </table> -->



                     <table  style="margin-top:10px;" class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "dry_gradation_visible == False">
                        <tbody>

                         <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>  Total</span></td>
                            <td style="padding: 5px;"><field name='total_sieve_analysis' class="oe_center" /></td>
                           </tr>
                         
                           
                        </tbody>
                    </table>
                   
                    <!-- <group invisible="not dry_gradation_visible">
                        <group style="width:33%">
                            <field name="total_sieve_analysis"/>
                        </group>

                    </group> -->
                    

                    <!-- Water Absorbtion  -->
                    <div invisible="not water_absorbtion_visible">
                        <h1>
                            <field name="water_absorbtion_name" readonly="1" nolabel="1"/>
                            <field name="water_absorbtion_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div invisible="not water_absorbtion_visible">
                    <table style="border: 1px solid black; border-collapse: collapse; width: 36%;">
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Weight of saturated surface dry (SSD) sample in air in gms, A</span></td>
                        <td style="border: 1px solid black; padding: 8px;"><field name="wt_ssd_sample"/></td>
                      </tr>
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span> Oven dried weight of sample in gms, C</span></td>
                        <td style="border: 1px solid black; padding: 8px;"><field name="oven_dried_wt"/></td>
                      </tr>
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Water absorption %</span></td>
                        <td style="border: 1px solid black; padding: 8px;"> <field name="water_absorbtion"/></td>
                      </tr>
                    </table>
                    </div>
                  

                    <div invisible="not water_absorbtion_visible">
                          <table style="width: 20%; margin-top:10px;">
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="padding: 8px;"><field  name="water_absorbtion_conformity"
                                        decoration-success="water_absorbtion_conformity == 'pass'" 
                                        decoration-danger="water_absorbtion_conformity == 'fail'" 
                                        readonly="1" /></td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"> <field  name="water_absorbtion_nabl" /></td>
                           </tr>
                     
                          </table>
                      </div>




                    <!-- <group invisible="not water_absorbtion_visible" style="white-space:nowrap; width:60%">
                        <field name="wt_ssd_sample"/>
                        <field name="oven_dried_wt"/>
                        <field name="water_absorbtion"/>
                    </group>
                     <group invisible="not water_absorbtion_visible">
                       
                        <field  name="water_absorbtion_conformity"
                                        decoration-success="water_absorbtion_conformity == 'pass'" 
                                        decoration-danger="water_absorbtion_conformity == 'fail'" 
                                        readonly="1" />
                        <field  name="water_absorbtion_nabl" />
                         
                    </group> -->


                    <!-- Elongation and Flakiness  -->
                    <div  invisible="not elongation_visible">
                        <h1>
                            <field name="elongation_name" readonly="1" nolabel="1"/>
                            <field name="elongation_visible" invisible="1"/>
                            <field name="flakiness_visible" invisible="1"/>


                        </h1>
                    </div>
                    <group/>

                    <group invisible="not elongation_visible">
                        <field name="elongation_table" nolabel="1" colspan="2">
                        <tree editable="bottom" class="custom_table_borders">
                          <field name="sieve_size"/>
                          <field name="wt_retained"/>
                          <field name="elongated_retained"/>
                          <field name="flakiness_retained"/>
                        </tree>
                        </field>
                    </group>
                   

                    <div style="display:flex;" invisible="not elongation_visible">
                      <div style="width: 50%;">
                          <table style="width: 100%; margin-top:10px;">
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Total</span></td>
                            <td style="padding: 5px;"><field name="total_wt_retained_fl_el" class="oe_center" /></td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Total Elongation</span></td>
                            <td style="padding: 5px;"> <field name="total_elongated_retained" class="oe_center" /></td>
                           </tr>
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Total Flakiness</span></td>
                            <td style="padding: 5px;"><field name="total_flakiness_retained" class="oe_center" /></td>
                           </tr>
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>	Flakiness Conformity</span></td>
                              <td style="padding: 8px;"><field  name="aggregate_flakiness_conformity"
                                        decoration-success="aggregate_flakiness_conformity == 'pass'" 
                                        decoration-danger="aggregate_flakiness_conformity == 'fail'" 
                                        readonly="1" string="Flakiness Conformity"/>
                            </td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"><field  name="aggregate_flakiness_nabl" /></td>
                           </tr>
                     
                          </table>
                      </div>

                      <div style="width: 50%;" invisible="not elongation_visible">
                             <table style="width: 100%; margin-top:10px;">
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Aggregate Elongation Value in %</span></td>
                            <td style="padding: 5px;"><field name="aggregate_elongation" class="oe_center" /></td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Aggregate Flakiness Value in %</span></td>
                            <td style="padding: 5px;"> <field name="aggregate_flakiness" class="oe_center" /></td>
                           </tr>
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Aggregate Elongation And Flakiness Value in %</span></td>
                            <td style="padding: 5px;"><field name="aggregate_combine" class="oe_center" /></td>
                           </tr>
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>Elongation Conformity</span></td>
                              <td style="padding: 8px;"> <field  name="aggregate_elongation_conformity"
                                        decoration-success="aggregate_elongation_conformity == 'pass'" 
                                        decoration-danger="aggregate_elongation_conformity == 'fail'" 
                                        readonly="1" string="Elongation Conformity" />
                            
                            </td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"><field  name="aggregate_elongation_nabl" /></td>
                           </tr>
                     
                          </table>
                      </div>
                      </div>
                      <group/>




                    

                    <!-- Impact Value  -->
                    <div invisible="not impact_visible">
                        <h1>
                            <field name="impact_value_name" readonly="1" nolabel="1"/>
                            <field name="impact_visible" invisible="1"/>

                        </h1>
                    </div>

                    <field name="impact_value_child_lines" nolabel="1"  invisible="not impact_visible">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='sample_no'/>
                                <field name='wt_of_cylinder'/>
                                <field name='total_wt_of_dried'/>
                                <field name='total_wt_aggregate'/>
                                <field name='wt_of_aggregate_passing'/>
                                <field name='wt_of_aggregate_retained'/>
                                <field name='impact_value'/>
                            </tree>
                           
                    </field> 

                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "impact_visible == False">
                        <tbody>

                         <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Average Impact Value</span></td>
                            <td style="padding: 5px;"><field name='average_impact_value' class="oe_center" /></td>
                           </tr>
                         
                            <tr>
                                <td><label for="average_impact_value_conformity">Confirmity</label></td>
                                <td>
                                    <field  name="average_impact_value_conformity"
                                           decoration-success="average_impact_value_conformity == 'pass'" 
                                           decoration-danger="average_impact_value_conformity == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="average_impact_value_nabl">Nabl</label></td>
                                <td>
                                  <field  name="average_impact_value_nabl"
                                         decoration-success="average_impact_value_nabl == 'pass'" 
                                           decoration-danger="average_impact_value_nabl == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                      




                <!-- Abrasion Value  -->
                <div invisible="not abrasion_visible">
                        <h1>
                            <field name="abrasion_value_name" readonly="1" nolabel="1"/>
                            <field name="abrasion_visible" invisible="1"/>

                        </h1>
                </div>

                <div invisible="not abrasion_visible">
                    <table style="border: 1px solid black; border-collapse: collapse; width: 36%;">
                    <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Total weight of Sample in gms</span></td>
                        <td style="border: 1px solid black; padding: 8px;"><field name="total_weight_sample_abrasion"/></td>
                      </tr>
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Weight of Passing sample in 1.70 mm IS sieve in gms</span></td>
                        <td style="border: 1px solid black; padding: 8px;"><field name="weight_passing_sample_abrasion"/></td>
                      </tr>
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span> Weight of Retain sample in 1.70 mm IS sieve in gms</span></td>
                        <td style="border: 1px solid black; padding: 8px;"><field name="weight_retain_sample_abrasion"/></td>
                      </tr>
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Abrasion Value (%)</span></td>
                        <td style="border: 1px solid black; padding: 8px;"> <field name="abrasion_value_percentage"/></td>
                      </tr>
                    </table>
                    </div>
                   

                <div invisible="not abrasion_visible">
                        <table style="width: 20%; margin-top:10px;">
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="padding: 8px;"><field  name="abrasion_value_percentage_conformity"
                                        decoration-success="abrasion_value_percentage_conformity == 'pass'" 
                                        decoration-danger="abrasion_value_percentage_conformity == 'fail'" 
                                        readonly="1" />
                            </td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"><field  name="abrasion_value_percentage_nabl" /></td>
                           </tr>
                     
                          </table>
                      </div>


              
                <!-- Liquid Limit -->
                <div invisible="not liquid_limit_visible">
                        <h1>
                            <field name="liquid_limit_name" readonly="1" nolabel="1"/>
                            <field name="liquid_limit_visible" invisible="1"/>

                        </h1>
                </div>

                <group invisible="not liquid_limit_visible">
                    <field name="liquid_limit_table" nolabel="1" colspan="2">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='container_no'/>
                                <field name='blows'/>
                                <field name='mass_wet_sample_container'/>
                                <field name='mass_dry_sample_container'/>
                                <field name='mass_container'/>
                                <field name='mass_moisture'/>
                                <field name='mass_dry_sample'/>
                                <field name='moisture_percent'/>

                            </tree>
                           
                    </field> 
                </group>

              

            

                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "liquid_limit_visible == False">
                        <tbody>

                         <tr>
                            <td style="padding: 5px;font-weight: bold;"><span> Liquid Limit</span></td>
                            <td style="padding: 5px;"><field name='liquid_limit' class="oe_center" /></td>
                           </tr>
                         
                           
                        </tbody>
                    </table>


                        
                        

                          <div   invisible="not liquid_limit_visible">
                          <field name="are_child_lines_filled" invisible="1"/>
                            <button string="Calculate Liquid Limit"
                                    type="object"
                                    name="liquid_calculation"
                                    class="oe_highlight">
                                <i class="fa fa-calculator"/>  Calculate Liquid Limit
                            </button>
                        </div>

              
              

                        <table  style="margin-top:10px;" class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "liquid_limit_visible == False">
                        <tbody>

                         <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Remarks</span></td>
                            <td style="padding: 5px;"><field name='remarks_liquid_limit' class="oe_center" /></td>
                           </tr>
                         
                            <tr>
                                <td><label for="liquid_limit_conformity">Confirmity</label></td>
                                <td>
                                    <field  name="liquid_limit_conformity"
                                           decoration-success="liquid_limit_conformity == 'pass'" 
                                           decoration-danger="liquid_limit_conformity == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="liquid_limit_nabl">Nabl</label></td>
                                <td>
                                  <field  name="liquid_limit_nabl"
                                         decoration-success="liquid_limit_nabl == 'pass'" 
                                           decoration-danger="liquid_limit_nabl == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <!-- <group invisible="not liquid_limit_visible">
                       
                        <field  name="liquid_limit_conformity"
                                        decoration-success="liquid_limit_conformity == 'pass'" 
                                        decoration-danger="liquid_limit_conformity == 'fail'" 
                                        readonly="1" />
                        <field  name="liquid_limit_nabl" />
                         
                    </group> -->


                <!-- Plastic Limit -->
                <div invisible="not plastic_visible">
                        <h1>
                            <field name="plastic_name" readonly="1" nolabel="1"/>
                            <field name="plastic_visible" invisible="1"/>
                            <field name="plasticity_index_visible" invisible="1"/>

                        </h1>
                </div>

                <group invisible="not plastic_visible">
                    <field name="plastic_table" nolabel="1" colspan="2">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='container_no'/>
                                <field name='mass_wet_sample_container'/>
                                <field name='mass_dry_sample_container'/>
                                <field name='mass_container'/>
                                <field name='mass_moisture'/>
                                <field name='mass_dry_sample'/>
                                <field name='moisture_percent'/>
                            </tree>
                    </field> 
                </group>

                <table  style="margin-top:10px;" class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "plastic_visible == False">
                        <tbody>

                         <tr>
                            <td style="padding: 5px;font-weight: bold;"><span> Average</span></td>
                            <td style="padding: 5px;"><field name='average_plastic_moisture' class="oe_center" /></td>
                           </tr>

                             <tr>
                            <td style="padding: 5px;font-weight: bold;"><span> Remarks</span></td>
                            <td style="padding: 5px;"><field name='remarks_plastic' class="oe_center" /></td>
                           </tr>
                         
                           
                        </tbody>
                    </table>

                  <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "plastic_visible == False">
                        <tbody>

                   
                            <tr>
                                <td><label for="average_plastic_moisture_conformity">Confirmity</label></td>
                                <td>
                                    <field  name="average_plastic_moisture_conformity"
                                           decoration-success="average_plastic_moisture_conformity == 'pass'" 
                                           decoration-danger="average_plastic_moisture_conformity == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="average_plastic_moisture_nabl">Nabl</label></td>
                                <td>
                                  <field  name="average_plastic_moisture_nabl"
                                         decoration-success="average_plastic_moisture_nabl == 'pass'" 
                                           decoration-danger="average_plastic_moisture_nabl == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                  


                 
                <!-- Plasticity index  -->

                       

                          <table  style="margin-top:10px;" class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "plasticity_index_visible == False">
                        <tbody>

                         <tr>
                            <td style="padding: 5px;font-weight: bold;"><span> Plasticity Index</span></td>
                            <td style="padding: 5px;"><field name='plasticity_index' class="oe_center" /></td>
                           </tr>

                             <tr>
                            <td style="padding: 5px;font-weight: bold;"><span> Remarks</span></td>
                            <td style="padding: 5px;"><field name='remarks_plasticity_index' class="oe_center" /></td>
                           </tr>
                         
                           
                        </tbody>
                    </table>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "plasticity_index_visible == False">
                        <tbody>

                   
                            <tr>
                                <td><label for="plasticity_index_conformity">Confirmity</label></td>
                                <td>
                                    <field  name="plasticity_index_conformity"
                                           decoration-success="plasticity_index_conformity == 'pass'" 
                                           decoration-danger="plasticity_index_conformity == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="plasticity_index_nabl">Nabl</label></td>
                                <td>
