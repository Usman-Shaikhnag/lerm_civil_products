                        <field name="oven_dried_wt"/>
                        <field name="water_absorbtion"/>
                    </group>
                     <group invisible="not water_absorbtion_visible">
                       
                        <field  name="water_absorbtion_conformity"
                                        decoration-success="water_absorbtion_conformity == 'pass'" 
