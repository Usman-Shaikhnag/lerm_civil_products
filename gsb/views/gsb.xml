<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_gsb_form" model="ir.ui.view">
        <field name="name">mechanical.gsb.form</field>
        <field name="model">mechanical.gsb</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
               <!-- attrs="{'edit': [('eln_ref.status', '!=', 1-draft)]}" -->
                <group >
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <group>
                      <field name="sample_parameters">
                        <tree class="table-bordered o_list_view">
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </group>
                    
                    <!-- Dry Gradation -->

                    <div invisible="not dry_gradation_visible">
                        <h1>
                            <field name="dry_gradation_name" readonly="1" nolabel="1"/>
                            <field name="dry_gradation_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <group invisible="not dry_gradation_visible">
                        <field name="dry_gradation_table" nolabel="1" colspan="2">
                        <tree editable="bottom" class="table-bordered o_list_view">
                          <field name="sieve_size"  />
                          <field name="wt_retained"/>
                          <field name="percent_retained"/>
                          <field name="cumulative_retained" readonly="1"/>
                          <field name="passing_percent" readonly="1"/>
                        </tree>
                        </field>
                    </group>
                    <group/>
                    <div invisible="not dry_gradation_visible">
                        <button string="Calculate" type="object" name="calculate_sieve" class="oe_highlight"/>
                    </div>
                    <group/>

                    <div>
                          <table style="width: 20%; ">
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Total</span></td>
                            <td style="padding: 5px;"><field name="total_sieve_analysis" class="oe_center" /></td>
                           </tr>
                           </table>
                    </div>
                    <group/>
                    <group/>
                    
                    <!-- <group invisible="not dry_gradation_visible">
                        <group style="width:33%">
                            <field name="total_sieve_analysis"/>
                        </group>

                    </group> -->
                    

                    <!-- Water Absorbtion  -->
                    <div invisible="not water_absorbtion_visible">
                        <h1>
                            <field name="water_absorbtion_name" readonly="1" nolabel="1"/>
                            <field name="water_absorbtion_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div>
                    <table style="border: 1px solid black; border-collapse: collapse; width: 36%;">
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Weight of saturated surface dry (SSD) sample in air in gms, A</span></td>
                        <td style="border: 1px solid black; padding: 8px;"><field name="wt_ssd_sample"/></td>
                      </tr>
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span> Oven dried weight of sample in gms, C</span></td>
                        <td style="border: 1px solid black; padding: 8px;"><field name="oven_dried_wt"/></td>
                      </tr>
                      <tr>
                        <td style="border: 1px solid black; padding: 8px;font-weight: bold;"><span>Water absorption %</span></td>
                        <td style="border: 1px solid black; padding: 8px;"> <field name="water_absorbtion"/></td>
                      </tr>
                    </table>
                    </div>
                    <group/>
                    <group/>

                    <div>
                          <table style="width: 20%; margin-top:10px;">
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="padding: 8px;"><field  name="water_absorbtion_conformity"
                                        decoration-success="water_absorbtion_conformity == 'pass'" 
                                        decoration-danger="water_absorbtion_conformity == 'fail'" 
                                        readonly="1" /></td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"> <field  name="water_absorbtion_nabl" /></td>
                           </tr>
                     
                          </table>
                      </div>
                      <group/>




                    <!-- <group invisible="not water_absorbtion_visible" style="white-space:nowrap; width:60%">
