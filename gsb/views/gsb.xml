                    </field> 
                    </group>
                    <!-- <group invisible="not density_relation_visible">
                    <field name="chart_image_density" widget="image" readonly="1" />
                    </group> -->
               

                   <group invisible = "density_relation_visible == False" class="custom_table_borders">
                      <field name="graph_image_density" widget="image" readonly="1"/>
                    </group>


                

                      <div class="d-flex gap-2" invisible="not density_relation_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="max_dry_density">MMD gm/cc</label></td>
                                    <td><field name="max_dry_density"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="omc">OMC %</label></td>
                                    <td><field name="omc"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>




                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible = "density_relation_visible == False">
                        <tbody>

                   
                            <tr>
                                <td><label for="density_relation_table_conformity">Confirmity</label></td>
                                <td>
                                    <field  name="density_relation_table_conformity"
                                           decoration-success="density_relation_table_conformity == 'pass'" 
                                           decoration-danger="density_relation_table_conformity == 'fail'" 
                                           readonly="1"/>
                                </td>
                            </tr>
                            <tr>
