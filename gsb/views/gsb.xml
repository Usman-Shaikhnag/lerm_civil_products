<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_gsb_form" model="ir.ui.view">
            <field name="name">mechanical.gsb.form</field>
            <field name="model">mechanical.gsb</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <h1>
                                <field name="name" readonly="1" nolabel="1"/>
                            </h1>
                        </group>

                        <group>
                            <field name="srf_id" invisible="1"/>
                            <field name="sample_id" readonly="1"/>
                            <field name="eln_ref" readonly="1"/>
                            <field name="grade" readonly="1"/>
                            <field name="parameter_id" invisible="1"/>
                        </group>

                        <group>
                            <field name="sample_parameters">
                                <tree>
                                    <field name="parameter_name"/>
                                    <field name="test_method"/>
                                </tree>
                            </field>
                        </group>
                    <!-- Dry Gradation -->
                    <!-- ====================================================== -->
                    <!-- DRY GRADATION -->
                    <!-- ====================================================== -->

                    <field name="dry_gradation_visible" invisible="1"/>

                    <separator string="Dry Gradation"
                            colspan="4"
                            invisible="not dry_gradation_visible"/>

                    <group invisible="not dry_gradation_visible">

                        <!-- Action -->
                        <group col="4">
                            <button string="Calculate"
                                    type="object"
                                    name="calculate_sieve"
                                    class="oe_highlight"/>
                        </group>

                        <!-- Observation Table -->
                        <field name="dry_gradation_table" nolabel="1">

                            <tree editable="bottom">

                                <field name="sieve_size"/>

                                <field name="wt_retained"/>

                                <field name="percent_retained"/>

                                <field name="cumulative_retained"
                                    readonly="1"/>

                                <field name="passing_percent"
                                    readonly="1"/>

                            </tree>

                        </field>

                    </group>

                    <separator colspan="4"/>
                        
                    <!-- Water Absorbtion  -->
                    <!-- ====================================================== -->
                    <!-- WATER ABSORPTION -->
                    <!-- ====================================================== -->

                    <field name="water_absorbtion_visible" invisible="1"/>

                    <separator string="Water Absorption"
                            colspan="4"
                            invisible="not water_absorbtion_visible"/>

                    <group invisible="not water_absorbtion_visible">

                        <!-- Test Details -->
                        <group string="Test Details" col="2">

                            <field name="wt_ssd_sample"/>

                            <field name="oven_dried_wt"/>

                            <field name="water_absorbtion"/>

                        </group>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="water_absorbtion_conformity"
                                readonly="1"
                                decoration-success="water_absorbtion_conformity == 'pass'"
                                decoration-danger="water_absorbtion_conformity == 'fail'"/>

                            <field name="water_absorbtion_nabl"/>

                        </group>

                    </group>

                    <separator colspan="4"/>


                                        <!-- specific_gravity_gsb_visible -->
                    <!-- ====================================================== -->
                    <!-- SPECIFIC GRAVITY -->
                    <!-- ====================================================== -->

                    <field name="specific_gravity_gsb_visible" invisible="1"/>

                    <separator string="Specific Gravity"
                            colspan="4"
                            invisible="not specific_gravity_gsb_visible"/>

                    <group invisible="not specific_gravity_gsb_visible">

                        <!-- Test Details -->
                        <group string="Test Details" col="2">

                            <field name="wt_ssd_gsb"/>

                            <field name="wt_saturated_gsb"/>

                            <field name="oven_dried_gsb"/>

                            <field name="specific_gravity_gsb"/>

                        </group>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="specific_gravity_gsb_conformity"
                                readonly="1"
                                decoration-success="specific_gravity_gsb_conformity == 'pass'"
                                decoration-danger="specific_gravity_gsb_conformity == 'fail'"/>

                            <field name="specific_gravity_gsb_nabl"/>

                        </group>

                    </group>

                    <separator colspan="4"/>


                                        <!-- Elongation and Flakiness  -->
                                        <!-- ====================================================== -->
                    <!-- ELONGATION & FLAKINESS INDEX -->
                    <!-- ====================================================== -->

                    <field name="elongation_visible" invisible="1"/>
                    <field name="flakiness_visible" invisible="1"/>

                    <separator string="Elongation &amp; Flakiness Index"
                            colspan="4"
                            invisible="not elongation_visible or not flakiness_visible"/>

                    <group invisible="not elongation_visible or not flakiness_visible">

                        <!-- Observation Table -->
                        <field name="elongation_table" nolabel="1">
                            <tree editable="bottom">
                                <field name="sieve_size"/>
                                <field name="wt_retained"/>
                                <field name="elongated_retained"/>
                                <field name="flakiness_retained"/>
                            </tree>
                        </field>

                        <!-- Calculation Summary -->
                        <group string="Calculation Summary" col="2">

                            <group>

                                <field name="total_wt_retained_fl_el"/>

                                <field name="total_elongated_retained"/>

                                <field name="total_flakiness_retained"/>

                            </group>

                            <group>

                                <field name="aggregate_elongation"/>

                                <field name="aggregate_flakiness"/>

                                <field name="aggregate_combine"/>

                            </group>

                        </group>

                        <!-- Test Result -->
                        <group string="Test Result" col="2">

                            <group string="Elongation">

                                <field name="aggregate_elongation_conformity"
                                    readonly="1"
                                    decoration-success="aggregate_elongation_conformity == 'pass'"
                                    decoration-danger="aggregate_elongation_conformity == 'fail'"/>

                                <field name="aggregate_elongation_nabl"/>

                            </group>

                            <group string="Flakiness">

                                <field name="aggregate_flakiness_conformity"
                                    readonly="1"
                                    decoration-success="aggregate_flakiness_conformity == 'pass'"
                                    decoration-danger="aggregate_flakiness_conformity == 'fail'"/>

                                <field name="aggregate_flakiness_nabl"/>

                            </group>

                        </group>

                    </group>

                    <separator colspan="4"/>

                                        <!-- Impact Value  -->
                                        <!-- ====================================================== -->
                    <!-- AGGREGATE IMPACT VALUE -->
                    <!-- ====================================================== -->

                    <field name="impact_visible" invisible="1"/>

                    <separator string="Aggregate Impact Value"
                            colspan="4"
                            invisible="not impact_visible"/>

                    <group invisible="not impact_visible">

                        <!-- Observation Table -->
                        <field name="impact_value_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name="sample_no"/>
                                <field name="wt_of_cylinder"/>
                                <field name="total_wt_of_dried"/>
                                <field name="total_wt_aggregate"/>
                                <field name="wt_of_aggregate_passing"/>
                                <field name="wt_of_aggregate_retained"/>
                                <field name="impact_value"/>
                            </tree>
                        </field>

                        <!-- Summary & Result -->
                        <group col="2">

                            <group string="Summary">

                                <field name="average_impact_value"/>

                            </group>

                            <group string="Result">

                                <field name="average_impact_value_conformity"
                                    readonly="1"
                                    decoration-success="average_impact_value_conformity == 'pass'"
                                    decoration-danger="average_impact_value_conformity == 'fail'"/>

                                <field name="average_impact_value_nabl"/>

                            </group>

                        </group>

                    </group>

                    <separator colspan="4"/>
                                        

                                    <!-- Abrasion Value  -->
                                    <!-- ====================================================== -->
                    <!-- ABRASION VALUE -->
                    <!-- ====================================================== -->

                    <field name="abrasion_visible" invisible="1"/>

                    <separator string="Abrasion Value"
                            colspan="4"
                            invisible="not abrasion_visible"/>

                    <group invisible="not abrasion_visible">

                        <!-- Test Details -->
                        <group string="Test Details" col="2">

                            <field name="total_weight_sample_abrasion"/>

                            <field name="weight_passing_sample_abrasion"/>

                            <field name="weight_retain_sample_abrasion"/>

                            <field name="abrasion_value_percentage"/>

                        </group>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="abrasion_value_percentage_conformity"
                                readonly="1"
                                decoration-success="abrasion_value_percentage_conformity == 'pass'"
                                decoration-danger="abrasion_value_percentage_conformity == 'fail'"/>

                            <field name="abrasion_value_percentage_nabl"/>

                        </group>

                    </group>

                    <separator colspan="4"/>


                                    <!-- Liquid Limit -->
                                    <!-- ====================================================== -->
                    <!-- LIQUID LIMIT -->
                    <!-- ====================================================== -->

                    <field name="liquid_limit_visible" invisible="1"/>
                    <field name="are_child_lines_filled" invisible="1"/>

                    <separator string="Liquid Limit"
                            colspan="4"
                            invisible="not liquid_limit_visible"/>

                    <group invisible="not liquid_limit_visible">

                        <!-- Observation Table -->
                        <field name="liquid_limit_table" nolabel="1">
                            <tree editable="bottom">
                                <field name="container_no"/>
                                <field name="blows"/>
                                <field name="mass_wet_sample_container"/>
                                <field name="mass_dry_sample_container"/>
                                <field name="mass_container"/>
                                <field name="mass_moisture"/>
                                <field name="mass_dry_sample"/>
                                <field name="moisture_percent"/>
                            </tree>
                        </field>

                        <!-- Action -->
                        <group>
                            <button string="Calculate Liquid Limit"
                                    name="liquid_calculation"
                                    type="object"
                                    class="oe_highlight"
                                    invisible="not are_child_lines_filled"/>
                        </group>

                        <!-- Summary -->
                        <group string="Summary" col="2">

                            <field name="liquid_limit"/>

                            <field name="remarks_liquid_limit"/>

                        </group>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="liquid_limit_conformity"
                                readonly="1"
                                decoration-success="liquid_limit_conformity == 'pass'"
                                decoration-danger="liquid_limit_conformity == 'fail'"/>

                            <field name="liquid_limit_nabl"/>

                        </group>

                    </group>

                    <separator colspan="4"/>

                                    <!-- Plastic Limit -->
                                    <!-- ====================================================== -->
                    <!-- PLASTIC LIMIT -->
                    <!-- ====================================================== -->

                    <field name="plastic_visible" invisible="1"/>

                    <separator string="Plastic Limit"
                            colspan="4"
                            invisible="not plastic_visible"/>

                    <group invisible="not plastic_visible">

                        <!-- Observation Table -->
                        <field name="plastic_table" nolabel="1">
                            <tree editable="bottom">
                                <field name="container_no"/>
                                <field name="mass_wet_sample_container"/>
                                <field name="mass_dry_sample_container"/>
                                <field name="mass_container"/>
                                <field name="mass_moisture"/>
                                <field name="mass_dry_sample"/>
                                <field name="moisture_percent"/>
                            </tree>
                        </field>

                        <!-- Summary -->
                        <group string="Summary" col="2">

                            <field name="average_plastic_moisture"/>

                            <field name="remarks_plastic"/>

                        </group>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="average_plastic_moisture_conformity"
                                readonly="1"
                                decoration-success="average_plastic_moisture_conformity == 'pass'"
                                decoration-danger="average_plastic_moisture_conformity == 'fail'"/>

                            <field name="average_plastic_moisture_nabl"/>

                        </group>

                    </group>

                    <separator colspan="4"/>

                    <!-- ====================================================== -->
                    <!-- PLASTICITY INDEX -->
                    <!-- ====================================================== -->

                    <field name="plasticity_index_visible" invisible="1"/>

                    <separator string="Plasticity Index"
                            colspan="4"
                            invisible="not plasticity_index_visible"/>

                    <group invisible="not plasticity_index_visible">

                        <!-- Summary -->
                        <group string="Test Details" col="2">

                            <field name="plasticity_index"/>

                            <field name="remarks_plasticity_index"/>

                        </group>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="plasticity_index_conformity"
                                readonly="1"
                                decoration-success="plasticity_index_conformity == 'pass'"
                                decoration-danger="plasticity_index_conformity == 'fail'"/>

                            <field name="plasticity_index_nabl"/>

                        </group>

                    </group>

                    <separator colspan="4"/>

                                    <!-- Density Relation Heavy Compaction  -->
                                    <!-- ====================================================== -->
                    <!-- DENSITY RELATION (HEAVY COMPACTION) -->
                    <!-- ====================================================== -->

                    <field name="density_relation_visible" invisible="1"/>

                    <separator string="Density Relation (Heavy Compaction)"
                            colspan="4"
                            invisible="not density_relation_visible"/>

                    <group invisible="not density_relation_visible">

                        <!-- Test Details -->
                        <group string="Test Details" col="2">

                            <field name="wt_of_modul"/>

                            <field name="vl_of_modul"/>

                        </group>

                        <!-- Observation Table -->
                        <field name="density_relation_table" nolabel="1">
                            <tree editable="bottom">
                                <field name="determination_no"/>
                                <field name="wt_of_modul_compact"/>
                                <field name="wt_of_compact"/>
                                <field name="bulk_density"/>
                                <field name="container_no"/>
                                <field name="wt_of_container"/>
                                <field name="wt_of_container_wet"/>
                                <field name="wt_of_container_dry"/>
                                <field name="wt_of_dry_sample"/>
                                <field name="wt_of_moisture"/>
                                <field name="moisture"/>
                                <field name="dry_density"/>
                            </tree>
                        </field>

                        <!-- Density Curve -->

                        <field name="chart_image_density"
                            widget="image"
                            readonly="1"
                            nolabel="1"/>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="mmd"/>

                            <field name="omc"/>

                        </group>

                    </group>

                    <separator colspan="4"/>
                                    


                                    <!-- CBR -->
                                    <!-- ====================================================== -->
                    <!-- CALIFORNIA BEARING RATIO (CBR) -->
                    <!-- ====================================================== -->

                    <field name="cbr_visible" invisible="1"/>

                    <separator string="California Bearing Ratio (CBR)"
                            colspan="4"
                            invisible="not cbr_visible"/>

                    <group invisible="not cbr_visible">

                        <!-- Test Details -->
                        <group string="Test Details" col="2">

                            <field name="division_factor"/>

                        </group>

                        <!-- Observation Table -->
                        <field name="cbr_table" nolabel="1">
                            <tree editable="bottom">
                                <field name="penetration"/>
                                <field name="proving_reading"/>
                                <field name="load"/>
                            </tree>
                        </field>

                        <!-- Load Penetration Curve -->

                        <field name="chart_image_cbr"
                            widget="image"
                            readonly="1"
                            nolabel="1"/>


                        <!-- CBR Results -->
                        <group string="CBR Calculation" col="2">

                            <group string="2.5 mm Penetration">

                                <field name="ps_2mm"/>

                                <field name="pt_2mm"/>

                                <field name="cbr_2mm"/>

                            </group>

                            <group string="5.0 mm Penetration">

                                <field name="ps_5mm"/>

                                <field name="pt_5mm"/>

                                <field name="cbr_5mm"/>

                            </group>

                        </group>

                        <!-- Final Result -->
                        <group string="Final Result">

                            <field name="cbr_result"/>

                        </group>

                    </group>

                    <separator colspan="4"/>


                                    <!-- CBR Infra -->
                    <!-- ====================================================== -->
                    <!-- GSB INFRA CBR -->
                    <!-- ====================================================== -->

                    <field name="gsb_infra_visible" invisible="1"/>

                    <separator string="GSB Infra CBR"
                            colspan="4"
                            invisible="not gsb_infra_visible"/>

                    <group invisible="not gsb_infra_visible">

                        <!-- Observation Table -->
                        <field name="gsb_infra_table" nolabel="1">
                            <tree editable="bottom">
                                <field name="penetration1"/>
                                <field name="proving_reading1"/>
                                <field name="proving_reading2"/>
                                <field name="proving_reading3"/>
                                <field name="proving_reading_avg"/>
                                <field name="load1"/>
                            </tree>
                        </field>

                        <!-- Load Penetration Curve -->

                        <field name="chart_image_cbr_infra"
                            widget="image"
                            readonly="1"
                            nolabel="1"/>

                        <!-- CBR Calculation -->
                        <group string="CBR Calculation" col="2">

                            <group string="2.5 mm Penetration">

                                <field name="gsb_infra_ps_2mm"/>

                                <field name="gsb_infra_pt_2mm"/>

                                <field name="gsb_infra_cbr_2mm"/>

                            </group>

                            <group string="5.0 mm Penetration">

                                <field name="gsb_infra_ps_5mm"/>

                                <field name="gsb_infra_pt_5mm"/>

                                <field name="gsb_infra_cbr_5mm"/>

                            </group>

                        </group>

                        <!-- Final Result -->
                        <group string="Final Result">

                            <field name="gsb_infra_cbr_result"/>

                        </group>

                    </group>

                    <separator colspan="4"/>

                                    <!-- added -->
                                        <!-- Field Density by Sand Replacement method -->
                                        <!-- ====================================================== -->
                    <!-- FIELD DENSITY BY SAND REPLACEMENT METHOD -->
                    <!-- ====================================================== -->

                    <field name="gsb_field_density_visible" invisible="1"/>

                    <separator string="Field Density by Sand Replacement Method"
                            colspan="4"
                            invisible="not gsb_field_density_visible"/>

                    <group invisible="not gsb_field_density_visible">

                        <!-- Test Details -->
                        <group string="Test Details" col="2">

                            <field name="mmd_fielddencity"/>

                            <field name="omc_fielddencity"/>

                        </group>

                        <!-- Observation Table -->
                        <field name="gsb_field_density_table" nolabel="1">
                            <tree editable="bottom">
                                <field name="determination_no"/>
                                <field name="wt_of_sample"/>
                                <field name="water_of_sample"/>
                                <field name="wt_of_before_cylinder"/>
                                <field name="wt_of_after_cylinder"/>
                                <field name="wt_of_sand_cone"/>
                                <field name="wt_of_sand_hole"/>
                                <field name="density_of_sand"/>
                                <field name="volume_of_hole"/>
                                <field name="bulk_density_of_sample"/>
                                <field name="dry_density_of_sample"/>
                                <field name="degree_of_compaction"/>
                            </tree>
                        </field>

                        <!-- Result -->
                        <group string="Result" col="2">

                            <field name="avg_degree_of_compaction"/>

                            <field name="degree_of_compaction_conformity"
                                readonly="1"
                                decoration-success="degree_of_compaction_conformity == 'pass'"
                                decoration-danger="degree_of_compaction_conformity == 'fail'"/>

                            <field name="degree_of_compaction_nabl"/>

                        </group>

                    </group>

                    <separator colspan="4"/>                       
                        <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
