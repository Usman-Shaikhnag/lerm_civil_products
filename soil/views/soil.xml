<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_flyasch_soil_normalconsistency" model="ir.ui.view">
        <field name="name">mechanical.soil.form</field>
        <field name="model">mechanical.soil</field>
        <field name="arch" type="xml">
            <form>
            
                <style>
                    .blue-input input {
                        background-color: #d8ecff !important;
                        border-color: #3b82f6 !important;
                    }

                    .o_list_view .o_data_cell.blue-input {
                        background-color: #d8ecff !important;
                        border-color: #3b82f6 !important;
                    }

                    .o_list_view .o_data_cell.blue-input input {
                        background-color: #d8ecff !important;
                        border-color: #3b82f6 !important;
                    }
                </style>
                <sheet>
                   <group >
                        <h1>
                            <field name="name_soil" readonly="1" nolabel="1"/>
                        </h1>
                    </group>
                     <group>
                        <field name='grade'/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <group>
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </group>

                     <group >
                            
                            <!-- <field name="tests" widget="many2many_tags"/> -->
                    </group>

                    <!-- Sieve Analysis -->
                    <div invisible="sieve_visible == False">
                        <h1 class="text-center">
                            <field name="sieve_name" readonly="1" nolabel="1"/>
                            <field name="sieve_visible" invisible="1"/>
                        </h1>
                    </div>

                    <table class="table table-sm o_form_table table-bordered custom_table_borders"
                        invisible="not sieve_visible">
                        <tbody>
                            <tr>
                                <td class="w-25">
                                    <label for="total1"/>
                                </td>
                                <td class="w-25">
                                    <field name="total1" readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <field name="child_lines" invisible="sieve_visible == False">
                        <tree editable="bottom" class="custom_table_borders">
                            <field name="serial_no"/>
                            <field name="sieve_size"/>
                            <field name="wt_retained" class="blue-input"/>
                            <field name="percent_retained"/>
                            <field name="cumulative_retained"/>
                            <field name="passing_percent"/>
                        </tree>
                    </field>

                    <div invisible="sieve_visible == False" class="mt-2">
                        <button string="Calculate Sieve Analysis"
                                type="object"
                                name="calculate"
                                class="oe_highlight"/>
                    </div>


                    <!-- Liquid Limit -->
                    <div invisible="liquid_limit_visible == False">
                        <h1 class="text-center">
                            <field name="liquid_limit_name" readonly="1" nolabel="1"/>
                            <field name="liquid_limit_visible" invisible="1"/>
                        </h1>
                    </div>

                    <field name="child_liness" invisible="liquid_limit_visible == False">
                        <tree editable="bottom" nolabel="1" class="custom_table_borders">
                            <field name="container_no" string="Container No"/>
                            <field name="blwo_no" string="No.of Blows" class="blue-input"/>
                            <field name="mass_of_wet" string="Mass of wet sample+container (M1) in gms" class="blue-input"/>
                            <field name="mass_of_dry" string="Mass of dry sample+container (M2) in gms" class="blue-input"/>
                            <field name="mass_of_container" string="Mass of container (M3) in gms" class="blue-input"/>
                            <field name="mass_of_moisture" string="Mass of Moisture (M1-M2) in gms"/>
                            <field name="mass_of_dry_sample" string="Mass of dry sample (M2-M3) in gms"/>
                            <field name="moisture" string="% Moisture"/>
                        </tree>
                    </field>

                    <table class="table table-sm o_form_table table-bordered custom_table_borders"
                        invisible="not liquid_limit_visible">
                        <tbody>
                            <tr>
                                <td class="w-25">
                                    <label for="liquid_limit"/>
                                </td>
                                <td class="w-25">
                                    <field name="liquid_limit"/>
                                </td>

                                <td class="w-25">
                                    <label for="remarks_liquid_limit"/>
                                </td>
                                <td class="w-25">
                                    <field name="remarks_liquid_limit"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <label for="liquid_limit_conformity"/>
                                </td>
                                <td>
                                    <field name="liquid_limit_conformity"
                                        decoration-success="liquid_limit_conformity == 'pass'"
                                        decoration-danger="liquid_limit_conformity == 'fail'"
                                        readonly="1"/>
                                </td>

                                <td>
                                    <label for="liquid_limit_nabl"/>
                                </td>
                                <td>
                                    <field name="liquid_limit_nabl"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div invisible="not liquid_limit_visible">
                        <field name="are_child_lines_filled" invisible="1"/>

                        <button string="Calculate Liquid Limit"
                                name="liquid_calculation"
                                type="object"
                                class="oe_highlight"
                                invisible="not are_child_lines_filled"/>
                    </div>

                    <!-- Plastic Limit -->
