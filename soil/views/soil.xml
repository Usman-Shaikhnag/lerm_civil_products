<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_soil_ssl" model="ir.ui.view">
        <field name="name">mechanical.soil.form</field>
        <field name="model">mechanical.soil</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                <div>
                    <h1>
                        
                        
                        
                        <field name="name_soil" readonly="1" nolabel="1"/>
                    </h1>
                </div>
                    
                    <group>
                       <field name="grade"/>
                    </group>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="size_id"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                    

                   <div invisible = "soil_visible == False">
                        <h1 class="text-center">
                            <!-- <field name="uu_triaxial_cohesion_name" readonly="1" nolabel="1"/> -->
                            <field name="soil_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible = "soil_visible == False">
                        <field name="soil_child_lines">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='sr_no'/>
                                <field name='sample_type'  width="120"/>
                                <field name='depth' width="120"/>
                                <field name='gsa_g'/>
                                <field name='gsa_s'/>
                                <field name='gsa_m'/>
                                <field name='gsa_c'  />
                                <field name='atterbergs_ll'/>
                                <field name='atterbergs_pl'/>
                                <field name='atterbergs_sl'/>
                                <field name='is_classification'/>
                                <field name='spesific_gravity'/>
                                <field name='fsi'  />
                                <field name='nmc'/>
                                <field name='bulk_density'/>
                                <field name='proctor_mdd'/>
                                <field name='proctor_omc'/>
                                <field name='ucs'  />
                                <field name='direct_shear_c'/>
                                <field name='direct_shear_ɸ'/>
                                <field name='Triaxial_test_c'/>
                                <field name='Triaxial_test_ɸ'/>
                                <field name='consolidation_pc'/>
                                <field name='consolidation_cc'  />
                                <field name='cbr'/>
                                <field name='sp'/>
                                <field name='permeability'/>
                                
                              
                                
                              
                            </tree>
                        </field>
                    </div>


                    
                  
                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>