<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="welded_steel_datasheet">
    <t t-call="web.html_container">
	<t t-call="lerm_civil.mechanical_data_sheet_header">
		<div style="text-align:center;font-size:18px;font-weight: bold">
		Welded Steel
		</div>
		<div class="container_eln" style="margin-top:5px">
            <table style="margin-top:20px">
				<tr cols="12">
					
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>

				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                    <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>





                <!-- Water Absorption 					 -->

             <div t-if="data.elongation_visible" >
                     
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.elongation_name" />:
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.elongation" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','pmjnhbgr-7d28-425e-ad2e-cd3645987645t')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>

                    

                    <!-- RRR -->
                    <div t-if="data.bend_test_visible" >
                   
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.bend_test_name"/> :
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.bend_test" />  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','mnbgt543e-7d28-425e-ad2e-cd3oiuytrfg65')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>
                    <div t-if="data.fracture_test_visible" >
                   
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.fracture_test_name"/> :
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.fracture_test" />  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','plmnbghte-7d28-425e-ad2e-cd3oinhytgfrt')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>
                    <div t-if="data.longitudinal_test_visible" >
                   
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.longitudinal_test_name"/> :
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.longitudinal_test" />  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','pmnbhgtyr-7d28-425e-ad2e-cd3pomnyhbgt')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>


                    <div t-if="data.tensile_strength_visible" >
                     
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.tensile_strength_name" />:
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.tensile_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','mnhyt564-7d28-425e-ad2e-cd39ijuyhgt65')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>

                    <div t-if="data.tensile_strength_uts_visible" >
                     
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.tensile_strength_uts_name" />:
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.tensile_strength_uts" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','ikmnjhuy6-7d28-425e-ad2e-cd39iu765trgb')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>

                    <div t-if="data.transverse_bend_test_visible" >
                     
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.transverse_bend_test_name" />:
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.transverse_bend_test"  />  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','mnbgtr453e-7d28-425e-ad2e-cd3mnby65trfg')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>

                    <div t-if="data.yield_strength_visible" >
                     
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.yield_strength_name" />:
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.yield_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','yut65rfvg-7d28-425e-ad2e-cd3opmnbghtyr')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>

                     <div t-if="data.transverse_tensile_visible" >
                     
                        <table style="margin-top:10px; width:100%;">
                            <tr cols="12">
                                <td colspan="6" style="font-weight:bold; width:50%;"><span t-field="data.transverse_tensile_name" />:
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align:center; width:50%;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.transverse_tensile" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','oiu786tygb-7d28-425e-ad2e-cd0omnhjyu56')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    </div>
                   
                    

				<!-- authorizeRowDataSheet -->
				
			
            <div class="authorizeRowDataSheet">
                <div>
                    <div>
                        <b>
                            Tested By 
                        </b>
                        
                    </div>
                   <div style="height: 40px;">
								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
						</div>
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.filled_by.name"/>
                        </b>
                    </div>
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                        </b>
                    </div>
                </div>
                <div style="margin-left:500px">
                    
                    <div>
                        <b>
                            Checked By
                        </b>
                    </div>
                   <div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.check_by.name"/>
                        </b>
                    </div>
                    
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.check_by.job_title"/>)
                        </b>
                    </div>
                </div>
            </div>

		</div>

	</t>
</t>
</template>
</odoo>
