                        <tbody>
                          <tr>
                                <td><label class="fw-bold" for="elongation_conformity">Conformity</label></td>
                                <td>
                                    <field name="elongation_conformity"
                                        decoration-success="elongation_conformity == 'pass'"
                                        decoration-danger="elongation_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="elongation_nabl">NABL</label></td>
                                <td><field name="elongation_nabl"
                                            decoration-success="elongation_nabl == 'pass'"
                                            decoration-danger="elongation_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>


                    
                   
                    

