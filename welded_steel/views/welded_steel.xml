                    <div invisible="not elongation_visible">

                        <h1 class="text-center">
                            <field name="elongation_name" readonly="1" />
                            <field name="elongation_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-2" invisible="not elongation_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="elongation"></label></td>
                                    <td style="width:50%;"><field name="elongation"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                      </div>


