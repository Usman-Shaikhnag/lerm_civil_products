<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="asphalt_mix_datasheet">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			<t t-call="lerm_civil.data_sheet_header_generaltemplate">
                <div style="text-align:center;font-size:18px">
                    Asphalt Mix
                </div>
                <div class="container_eln" style="margin-top:5px">
				 <table style="margin-top:20px">
				<tr cols="12">
					
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>
				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                 <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>


            <!--  -->
			

					<div  t-if="data.dry_gradation_visible" style="margin-top: 30px;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							 Dry Gradation
						</div>
					

					<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					<thead>
						<tr cols="12" style="background-color: #f0f0f0; text-align: center;">
							<th colspan="1" style="border: 1px solid #ccc; padding: 8px;">Sr No 
							</th>
							<th colspan="3" style="border: 1px solid #ccc; padding: 8px;">IS Sieve Size
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;">Wt. Retained in gms
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;">Cum. Weight Retained (gm)
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;">Cum. Retained %
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;">Passing %
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;">Specified Limits
							</th>
							
						</tr>
						</thead>
						<tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.sieve_analysis_child_lines" t-as="r" style="text-align: center;">
							<td colspan="1" style="border: 1px solid #ccc; padding: 6px;">
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td colspan="3" style="border: 1px solid #ccc; padding: 6px;">
								<span t-esc="r['sieve_size']"/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;">
								<span t-esc="r['wt_retained']"/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;">
								<span t-esc="r['cumulative_percent']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;">
								<span t-esc="r['cumulative_retained']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;">
								<span t-esc="r['passing_percent']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;">
								<span t-esc="r['specific_limits']" />
							</td>

							
						</tr>
						</tbody>
					</table>

					<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
						<tr cols="12" style="font-weight: bold; background-color: #f9f9f9;">
							<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Total :
								<![CDATA[&nbsp;]]>
							</td>
							<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
								<span t-field="data.total_sieve_analysis"/>
							</td>
							
						</tr>
						
					</table>

					<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<!-- <t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '1c05c0b0-c623-474c-918c-259f427eb9a0')"/>
    
								<t t-set="active_technician" t-value="false"/>
								<t t-if="param_line" t-set="active_technician" t-value="param_line[0].technician"/>
								<t t-if="not param_line" t-set="active_technician" t-value="eln.technician"/>

								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="active_technician and active_technician.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + active_technician.employee_id.signature.decode('utf-8')" 
											style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
								</t>
							</div>
                            <div>
                                <b>
                                <!-- <span t-esc="eln.sample_id.filled_by.name"/> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '1c05c0b0-c623-474c-918c-259f427eb9a0')"/>
        
                              <span t-if="param_line" t-esc="param_line[0].technician.name"/>
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.name"/>
								
                                </b>
                            </div>
                            <div>
                                <b>
                                    <!-- (<span t-esc="eln.sample_id.filled_by.job_title"/>) -->
									<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '1c05c0b0-c623-474c-918c-259f427eb9a0')"/>
        
                              (<span t-if="param_line" t-esc="param_line[0].technician.job_title"/>)
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.job_title"/>
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
								
							
						</div>
					</div>
					</div>

					<!-- Binder Content -->

					<div  t-if="data.binder_content_visible" style="page-break-before: always;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Binder Content
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Mix (W1)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Initial Weight of Filter Paper</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Aggregate After Extraction (W2)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Filter Paper After Extraction With Fine Materials (W3)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Increased Weight of Filter Paper</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Binder (W5) =W1-(W2+W4)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Binder Content (BC) =W5/W1*100 (%)</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.binder_content_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['w1']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['initial_filter_weight']" />
									</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['w2']" />
									</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['filter_after_extraction']" />
									</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['w4']" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['w5']" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>

									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['binder_content']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Binder Content (BC) =W5/W1*100 (%) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_binder_content" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
					</div>

					<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<!-- <t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == 'ae96765d-e7ab-4c7d-b67e-5815f4788b03')"/>
    
								<t t-set="active_technician" t-value="false"/>
								<t t-if="param_line" t-set="active_technician" t-value="param_line[0].technician"/>
								<t t-if="not param_line" t-set="active_technician" t-value="eln.technician"/>

								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="active_technician and active_technician.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + active_technician.employee_id.signature.decode('utf-8')" 
											style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
								</t>
							</div>
                            <div>
                                <b>
                                <!-- <span t-esc="eln.sample_id.filled_by.name"/> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == 'ae96765d-e7ab-4c7d-b67e-5815f4788b03')"/>
        
                              <span t-if="param_line" t-esc="param_line[0].technician.name"/>
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.name"/>
								
                                </b>
                            </div>
                            <div>
                                <b>
                                    <!-- (<span t-esc="eln.sample_id.filled_by.job_title"/>) -->
									<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == 'ae96765d-e7ab-4c7d-b67e-5815f4788b03')"/>
        
                              (<span t-if="param_line" t-esc="param_line[0].technician.job_title"/>)
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.job_title"/>
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
								
							
						</div>
					</div>
					

				</div>	
			</t>
		</t>
	</template>
</odoo>