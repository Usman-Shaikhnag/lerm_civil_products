<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_asphalt_mix_form" model="ir.ui.view">
        <field name="name">mechanical.asphalt.mix.form</field>
        <field name="model">mechanical.asphalt.mix</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>

                <div>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="grade"/>
                        <field name="eln_state" />

                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="asphalt_temp"></label>
                                    </td>
                                    <td>
                                        <field name="asphalt_temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="asphalt_humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="asphalt_humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>


                   <!-- Dry Gradation -->

                    <div invisible="not dry_gradation_visible">
                        <h1 style="text-align: center;">
                            <field name="dry_gradation_name" readonly="1" nolabel="1"/>
                            <field name="dry_gradation_visible" invisible="1"/>
                        </h1>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not dry_gradation_visible">
                        <tbody>
                            <tr>
                                <td><label for="weight_of_sample">Weight of Sample (gms)</label></td>
                                <td>
                                    <field name="weight_of_sample" class="blue-input" />
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div invisible="dry_gradation_visible == False" class="custom_table_borders">
                        <field name="sieve_analysis_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <!-- <field name="serial_no" string="Sr.No"/> -->
                                <field name='sieve_size'/>
                                <field name='wt_retained' class="blue-input" decoration-info="wt_retained != 0"/>
                                <field name='cumulative_percent' readonly="1"/>
                                <!-- <field name='percent_retained' readonly="1"/> -->
                                <field name='cumulative_retained' context="{'default_cumulative_retained': cumulative_retained}" readonly="1"/>
                                <field name='passing_percent' readonly="1"/>
                                <field name='specific_limits' readonly="1"/>
                            </tree>
                        </field>
                    </div>
                    
                    
                    <div invisible="dry_gradation_visible == False">
                        <button type="object" name="calculate_sieve" class="btn btn-primary">
                            <i class="fa fa-calculator mr-1"/> Calculate
                        </button>
                    </div>

                    <!-- Table for Total Sieve Analysis -->
                    <table class="table table-sm o_form_table table-bordered w-50 mt-2 custom_table_borders" invisible="not dry_gradation_visible">
                        <tbody>
                            <tr>
                                <td><label for="total_sieve_analysis" class="text-bold">Total</label></td>
                                <td><field name="total_sieve_analysis" class="text-bold"/></td>
                            </tr>
                        </tbody>

                    </table>

                    
                    
                    

                   
                        


                

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
        </field>
        </record>

        <record id="view_aac_block_prefill_data_form" model="ir.ui.view">
            <field name="name">aac.block.prefill.data.form</field>
            <field name="model">aac.block.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_aac_block_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">aac.block.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_aac_block_prefill_data_form"/>
            <field name="target">new</field>
        </record>


       
    </data>
</odoo>