<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <record id="mechanical_bitumen_mix_sm" model="ir.ui.view">
        <field name="name">mechanical.bitumen.mix.form</field>
        <field name="model">mechanical.bitumen.mix</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   <group style="white-space: nowrap; width:70%;"  >
                        <h1>
                            <field name="name_bitumen" readonly="1" nolabel="1"/>
                        </h1>
                    </group>

                    <group >
                       <field name="grade"/>
                       <field name="size_id"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temp"></label>
                                    </td>
                                    <td>
                                        <field name="temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                  
               
                    <!-- Sieve Analysis -->
                    <div invisible="sieve_visible == False" >
                        <h1 style="text-align: center;">
                            <field name="sieve_analysis_name" readonly="1" nolabel="1"/>
                            <field name="sieve_visible" invisible="1"/>

                        </h1>
                    </div>

                    <table class="table table-sm o_form_table table-bordered custom_table_borders" invisible="not sieve_visible">
                        <tbody>
                            <tr>
                                <td class="w-25"><label for="report_type"/></td>
                                <td  class="w-25">
                                    <field name="report_type" class="blue-input"/>
                                </td>
                              
                            </tr>
                        </tbody>
                    </table>
                   
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" invisible="not sieve_visible">
                        <tbody>
                            <tr>
                                <td class="w-25"><label for="wt_of_sample"/>
                                </td>
                                <td  class="w-25">
                                    <field name="wt_of_sample" class="blue-input"/>
                                </td>
                                <td class="w-25"><label for="material_type"/>
                                </td>
                                <td  class="w-25">
                                    <field name="material_type" class="blue-input"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <div invisible="sieve_visible == False">
                        <field name="sieve_analysis_child_lines" nolabel="1" class="no_column_sorting" >
                            <tree editable="bottom"  class="custom_table_borders ">
                                <field  name="serial_no" string="Sr.No"/>
                                <field  name='sieve_size' string="IS Sieve Size"/>
                                <field  class="blue-input" name='wt_retained' string="Wt. Retained in gms"/>
                                <field name='percent_retained' string="% Retained"/>
                                <field  name='cumulative_retained' context="{'default_cumulative_retained': cumulative_retained}" string="Cum. Retained %"/>
                                <field  name='passing_percent' string="Passing %" readonly="1"/>
                                <field class=" oe_center" name='specific_limt' string="Specified Limits"/>
                                
                            </tree>
                        </field>
                    </div>
                    <div invisible="sieve_visible == False">
                        <button string="Calculate" type="object" name="calculate_sieve" class="oe_highlight">
                            <i class="fa fa-calculator"/> Calculate
                        </button>
                    </div>

                <table class="table table-sm o_form_table w-50 table-bordered custom_table_borders mt-2" invisible="not sieve_visible">
                    <tbody>
                        <tr>
                            <td ><label for="total_sieve_analysis"/></td>
                            <td  ><field name="total_sieve_analysis"/></td>
                        </tr>
                    </tbody>
                </table>



                <!-- Flow Value Test -->


                    <div invisible="flow_value_visible == False">
                        <h1 class="text-center">
                            <field name="flow_value_name" readonly="1" nolabel="1"/>
                            <field name="flow_value_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div class="custom_table_borders" invisible="flow_value_visible == False">
                        <field name="flow_value_child_lines" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name="diameter" class="blue-input" decoration-info="diameter != 0"/>
                                <field name="height" class="blue-input" decoration-info="height != 0"/>
                                <field name="maximum_load" class="blue-input" decoration-info="maximum_load != 0"/>
                                <field name="flow_reading" class="blue-input" decoration-info="flow_reading != 0"/>
                                <field name="flow_value"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="flow_value_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_flow">Average Flow Value</label></td>
                                  <td><field name="average_flow"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="average_flow_conformity">Conformity</label></td>
                                <td>
                                    <field name="average_flow_conformity"
                                        decoration-success="average_flow_conformity == 'pass'" 
                                        decoration-danger="average_flow_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="average_flow_nabl">NABL</label></td>
                                <td>
                                    <field name="average_flow_nabl"
                                        decoration-success="average_flow_nabl == 'pass'" 
                                        decoration-danger="average_flow_nabl == 'fail'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="flow_value_report_type">Report Type</label></td>
                                <td><field name="flow_value_report_type" class="blue-input" decoration-info="flow_value_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>



                    
               
                    
                   
                



                  

                 

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />



              
              

                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>