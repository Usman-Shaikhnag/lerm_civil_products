<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="bitumen_mix_datasheet_sm">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
        
                <div style="text-align:center;font-size:18px;font-weight: bold">
                Bituminous Mix Datasheet
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>
                    </table>


                    <!-- Sieve Analysis of Combined Coarse Aggregates, Fine Aggregates and Filler Material -->
                    
                    <div  t-if="data.sieve_visible" style="margin-top: 30px;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							 Sieve Analysis
						</div>
					

					<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					<thead>
						<tr cols="12" style="background-color: #f0f0f0; text-align: center;">
							<th colspan="1" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Sr No 
							</th>
							<th colspan="3" style="border: 1px solid #ccc; padding: 8px;text-align: center;">IS Sieve Size
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Wt. Retained in gms
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Cum. Weight Retained (gm)
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Cum. Retained %
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Passing %
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Specified Limits
							</th>
							
						</tr>
						</thead>
						<tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.sieve_analysis_child_lines" t-as="r" style="text-align: center;">
							<td colspan="1" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td colspan="3" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['sieve_size']"/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['wt_retained']"/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['percent_retained']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['cumulative_retained']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['passing_percent']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['specific_limt']" />
							</td>

							
						</tr>
						</tbody>
					</table>

					<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
						<tr cols="12" style="font-weight: bold; background-color: #f9f9f9;">
							<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Total :
								<![CDATA[&nbsp;]]>
							</td>
							<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
								<span t-field="data.total_sieve_analysis"/>
							</td>
							
						</tr>


						
						
					</table>

					<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<!-- <t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '62578gtre-7188-4086-b132-62b50e63f1247ui')"/>
    
								<t t-set="active_technician" t-value="false"/>
								<t t-if="param_line" t-set="active_technician" t-value="param_line[0].technician"/>
								<t t-if="not param_line" t-set="active_technician" t-value="eln.technician"/>

								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="active_technician and active_technician.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + active_technician.employee_id.signature.decode('utf-8')" 
											style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
								</t>
							</div>
                            <div>
                                <b>
                                <!-- <span t-esc="eln.sample_id.filled_by.name"/> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '62578gtre-7188-4086-b132-62b50e63f1247ui')"/>
        
                              <span t-if="param_line" t-esc="param_line[0].technician.name"/>
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.name"/>
								
                                </b>
                            </div>
                            <div>
                                <b>
                                    <!-- (<span t-esc="eln.sample_id.filled_by.job_title"/>) -->
									<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '62578gtre-7188-4086-b132-62b50e63f1247ui')"/>
        
                              (<span t-if="param_line" t-esc="param_line[0].technician.job_title"/>)
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.job_title"/>
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
								
							
						</div>
					</div>
					</div>


                    <!-- Flow Value Test -->
                    
                    <div  t-if="data.sieve_visible" style="margin-top: 30px;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							 Flow Value Test
						</div>
					

					<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					<thead>
						<tr cols="12" style="background-color: #f0f0f0; text-align: center;">
							<th colspan="1" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Specimen. No
							</th>
							<th colspan="3" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Diameter (mm)
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Height (mm)
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Maximum Load (kN)
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Flow Reading (0.25 mm units)
							</th>
							<th colspan="2" style="border: 1px solid #ccc; padding: 8px;text-align: center;">Flow Value (mm)
							</th>
							
						</tr>
						</thead>
						<tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.flow_value_child_lines" t-as="r" style="text-align: center;">
							<td colspan="1" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td colspan="3" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['diameter']"/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['height']"/>
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['maximum_load']" />
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['flow_reading']" />
							</td>
							<td colspan="2" style="border: 1px solid #ccc; padding: 6px;text-align: center;">
								<span t-esc="r['flow_value']" t-options='{"widget": "float", "precision": 2}'/>
							</td>

							
						</tr>
						</tbody>
					</table>

					<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
						<tr cols="12" style="font-weight: bold; background-color: #f9f9f9;">
							<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Total :
								<![CDATA[&nbsp;]]>
							</td>
							<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
								<span t-field="data.average_flow" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							
						</tr>


						
						
					</table>

					<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<!-- <t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '35789ght-7188-4086-b132-62b50e63f1247ui')"/>
    
								<t t-set="active_technician" t-value="false"/>
								<t t-if="param_line" t-set="active_technician" t-value="param_line[0].technician"/>
								<t t-if="not param_line" t-set="active_technician" t-value="eln.technician"/>

								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="active_technician and active_technician.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + active_technician.employee_id.signature.decode('utf-8')" 
											style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
								</t>
							</div>
                            <div>
                                <b>
                                <!-- <span t-esc="eln.sample_id.filled_by.name"/> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '35789ght-7188-4086-b132-62b50e63f1247ui')"/>
        
                              <span t-if="param_line" t-esc="param_line[0].technician.name"/>
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.name"/>
								
                                </b>
                            </div>
                            <div>
                                <b>
                                    <!-- (<span t-esc="eln.sample_id.filled_by.job_title"/>) -->
									<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '35789ght-7188-4086-b132-62b50e63f1247ui')"/>
        
                              (<span t-if="param_line" t-esc="param_line[0].technician.job_title"/>)
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.job_title"/>
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
								
							
						</div>
					</div>
					</div>




                    </div>
                    

            </t>
        </t>
    </template>



</odoo>