<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <template id="bitumen_mix_report_sm">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
               
			


				<div class="container_eln" style="padding-top:10px;">
					<div class="" t-foreach="eln" t-as="o">
									<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr style="height:10px;">
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">--</t>
		                            <br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 60px;"/>
									</td>
								
							</tr>
							<tr t-if="o.srf_id.name_work">
								<td colspan="1" >Project Name:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
									</td>
							</tr>

							<tr t-if="o.srf_id.client">
								<td colspan="1" >Name of Agency:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
									</td>
							</tr>
							
							<tr>
								<td style="width:25%;">Samples Description :-</td>
								<td style="width:25%;">
								      <t t-if="o.material and o.material.lab_name">
											<span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

								<td style="width:20%;">Customer's Ref. No :-</td>
								<td style="width:20%;">

								  <t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<!-- <td>Quantity of Samples :-</td>
								<td>Litre</td> -->
								<td>No. of Samples :-</td>
								<td>

								<t t-if="o.sample_id.sample_qty">
											<span t-field="o.sample_id.sample_qty"/>
										</t>
									<t t-else="">--</t>

								<t t-if="o.sample_id.uom_id">
											<span t-field="o.sample_id.uom_id"/>
										</t>
									<t t-else="">--</t>
								
								</td>

								<td>Letter Date :-</td>
								<td>
									

									<t t-if="o.srf_id.letter_date">
											<span t-field="o.srf_id.letter_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								<td>Date of Samples Received :-</td>
								<td>

									<t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								</td>

									<td>SRF No. :-</td>
										<td >

											<t t-if="o.srf_id">
											<span t-field="o.srf_id"/>
										</t>
									<t t-else="">--</t>
										</td>
								
							</tr>

							<tr>
								<td>Brand &amp; Grade :-</td>
								<td>
								<t t-if="o.sample_id.grade_id.grade">
											<span t-field="o.sample_id.grade_id.grade"/>
										</t>
									<t t-else="">--</t>
									</td>

								<td>Date of Test Initiation  :-</td>
								<td>

									<t t-if="o.start_date">
											<span t-field="o.start_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								

								<td>Size  :-</td>
								<td>

										<t t-if="o.sample_id.size_id.size">
											<span t-field="o.sample_id.size_id.size"/>
										</t>
									<t t-else="">--</t>
								</td>
								<td>Date of Test Completion  :-</td>
								<td>

									<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								

								<td>Week No.  :-</td>
								<td>

								--
								</td>
								<td>Sample ID  :-</td>
								<td>

									<t t-if="o.sample_id.kes_no">
											<span t-field="o.sample_id.kes_no"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Other Details:</td>
								<td colspan="3">--</td>

								
							</tr>


							<tr t-if="o.material.test_method_adopted" >
								

									<td >Test method adopted:</td>
									<td colspan="3"><span t-field="o.material.test_method_adopted"/></td>

							
							</tr>
							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

								<tr t-if="o.material.specifications">
									<td style="font-weight: bold;">Specifications</td>
									<td colspan="3"><span t-field="o.material.specifications"/></td>
								</tr>

						</table>
					</div>

					<div>
						<table class="table table-sm table-bordered custom_table_borders" t-if="data.bitumen_content_visible" style="margin-top:15px">
							<thead>
								<tr>
									<th colspan="12">
										<span>1. </span><span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).parameter_name"/>
									</th>
								</tr>
								<tr>
									<th class="text-center">Sr.No</th>
									<th class="text-center">Location of Sample</th>
									<th class="text-center">
									<span t-esc="eln.material.result_remark"/>
									 <!-- Test Result -->
									 </th>
									<!-- <th >Unit</th> -->
									<th class="text-center"> 
										<span t-field="eln.material.specifications"></span>
									</th>
									<!-- <th >Test Method</th> -->
									<th class="text-center" t-if="eln.conformity">Conformity</th>
								</tr>
							</thead>

							<t t-set="i" t-value="0"/>
							<tbody>
								<tr t-if="data.bitumen_content_visible and (data.binder_content_nabl == 'pass' and nabl or (data.binder_content_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<td  class="text-center">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td  class="text-center">
										<span t-field="data.location" />
									</td>
									<td  class="text-center">
										<span t-field="data.binder_content" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									
									<!-- <td>
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).unit.name"/>
										</span>
									</td> -->
									<td  class="text-center">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
									<!-- <td  >
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td> -->
									<td class="text-center" t-if="eln.conformity">
										<span t-field="data.binder_content_conformity"/>
									</td>
								</tr>
							</tbody>
						</table>

						<table class="table table-sm table-bordered custom_table_borders" style="margin-top:10px" t-if="data.sieve_visible">
							<thead>
								<tr style="margin-top:10px">
									<th colspan="12">
										<span>2. </span><span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','62578gtre-7188-4086-b132-62b50e63f1247ui')]).parameter_name"/>
									</th>
								</tr>
								<tr>
									<!-- <th colspan="2">Sr No.
									</th> -->
									<th class="text-center" colspan="2">IS Sieve Size
									</th>
									<th class="text-center" colspan="2">Weight Retained (gms)
									</th>
									<th class="text-center" colspan="2">% of Weight Retained 
									</th>
									<th class="text-center" colspan="2">% of Cumulative Wt.  Retained 
									</th>
									<th class="text-center" colspan="2">% of wt passing
									</th>
									<th class="text-center" colspan="2">Specified Limits
									</th>
								</tr>
								<t t-set="k" t-value="0"/>
							</thead>

							<tbody>
								<tr t-foreach="data.sieve_analysis_child_lines" t-as="r">
									<!-- <td class="text-center" colspan="2">
										<div>
											<span t-esc="k + 1" />
										</div>
									</td> -->
									<td class="text-center" colspan="2">
										<t t-set="k" t-value="k+1"/>
										<span t-esc="r['sieve_size']"/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['wt_retained']"/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['percent_retained']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['cumulative_retained']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['passing_percent']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['specific_limt']" />
									</td>
								</tr>
							</tbody>
						</table>
					</div>
                        
                       
                        
                     

				

             

						
				

