<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <template id="bitumen_mix_report_sm">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
               
			

				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">--</t>
								</td>

                                <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td>
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else=""></t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td>
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">-</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
											<span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">-</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<!-- <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">-</t> -->
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>

									<td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_temperature is not None">
											<span t-field="brick.brick_temperature"/>   °C
										</t>
									<t t-else="">-</t> -->
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_humidity is not None">
											<span t-field="brick.brick_humidity"/>   °C
										</t>
									<t t-else="">-</t> -->
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">-</t>
								</td>
								
							</tr>

							</table>
					</div>

					<div>
						<table class="table table-sm table-bordered custom_table_borders" t-if="data.bitumen_content_visible" style="margin-top:15px">
							<thead>
								<tr>
									<th colspan="12">
										<span>1. </span><span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).parameter_name"/>
									</th>
								</tr>
								<tr>
									<th class="text-center">Sr.No</th>
									<th class="text-center">Location of Sample</th>
									<th class="text-center">
									<span t-esc="eln.material.result_remark"/>
									 <!-- Test Result -->
									 </th>
									<!-- <th >Unit</th> -->
									<th class="text-center"> 
										<span t-field="eln.material.specifications"></span>
									</th>
									<!-- <th >Test Method</th> -->
									<th class="text-center" t-if="eln.conformity">Conformity</th>
								</tr>
							</thead>

							<t t-set="i" t-value="0"/>
							<tbody>
								<tr t-if="data.bitumen_content_visible and (data.binder_content_nabl == 'pass' and nabl or (data.binder_content_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<td  class="text-center">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td  class="text-center">
										<span t-field="data.location" />
									</td>
									<td  class="text-center">
										<span t-field="data.binder_content" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									
									<!-- <td>
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).unit.name"/>
										</span>
									</td> -->
									<td  class="text-center">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
									<!-- <td  >
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','35789ght-7188-4086-b132-62b50e63f1247ui')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td> -->
									<td class="text-center" t-if="eln.conformity">
										<span t-field="data.binder_content_conformity"/>
									</td>
								</tr>
							</tbody>
						</table>

						<table class="table table-sm table-bordered custom_table_borders" style="margin-top:10px" t-if="data.sieve_visible">
							<thead>
								<tr style="margin-top:10px">
									<th colspan="12">
										<span>2. </span><span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','62578gtre-7188-4086-b132-62b50e63f1247ui')]).parameter_name"/>
									</th>
								</tr>
								<tr>
									<!-- <th colspan="2">Sr No.
									</th> -->
									<th class="text-center" colspan="2">IS Sieve Size
									</th>
									<th class="text-center" colspan="2">Weight Retained (gms)
									</th>
									<th class="text-center" colspan="2">% of Weight Retained 
									</th>
									<th class="text-center" colspan="2">% of Cumulative Wt.  Retained 
									</th>
									<th class="text-center" colspan="2">% of wt passing
									</th>
									<th class="text-center" colspan="2">Specified Limits
									</th>
								</tr>
								<t t-set="k" t-value="0"/>
							</thead>

							<tbody>
								<tr t-foreach="data.sieve_analysis_child_lines" t-as="r">
									<!-- <td class="text-center" colspan="2">
										<div>
											<span t-esc="k + 1" />
										</div>
									</td> -->
									<td class="text-center" colspan="2">
										<t t-set="k" t-value="k+1"/>
										<span t-esc="r['sieve_size']"/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['wt_retained']"/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['percent_retained']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['cumulative_retained']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['passing_percent']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td class="text-center" colspan="2">
										<span t-esc="r['specific_limt']" />
									</td>
								</tr>
							</tbody>
						</table>
					</div>
                        
                       
                        
                     

				

             

						
				

					<div style="margin-top:5px; page-break-inside: avoid;" class="signatureContainer girdgird">
							<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Note:-</b>
									&#160;&#160;(i) The results relate only to the items tested 
									&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
									&#160;&#160;(iii) Any corrections invalidate the test reports 
									&#160;&#160;(iv) Any Query regarding the report must be reported immediately. 
									&#160;&#160;(v) * mark indicate tests which are not in the scope of NABL. 
									&#160;&#160;(vi) # mark indicates Details given by Client.
									<t t-if="eln.has_witness">
										&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
									</t>
									<t t-if="eln.remarks">
										&#160;&#160;<span t-esc="eln.remarks"/>
									</t>
								</td>
							</tr>
						</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:15px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height:15px">

								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<div t-if="stamp_image" style="text-align:center;margin-bottom:10px">
							<img t-att-src="'data:image/png;base64,%s' % stamp_image" style="width:200px;"/>
						</div>
						<div style="text-align:center;margin-top:2px">
							......End of Report......
						</div>
              </div>
             
			</t>
		</t>
	</template>


</odoo>