<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="concrete_cube_density_datasheet">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
        
                <div style="text-align:center;font-size:18px;font-weight: bold">
                  Concrete Cube Density
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
				<tr cols="12">
					
				    <td colspan="6">
					    <span style="text-align:center;">	
						    Job No. <![CDATA[&nbsp;]]> <span t-esc="eln.kes_no"/>
					   </span>
                    </td>
					<td colspan="6">
					    <span style="text-align:center;">	
						    Test Start Date. <![CDATA[&nbsp;]]> <span t-esc="eln.start_date"/>
					   </span>
                    </td>
				</tr>
                <tr cols="12">
				    <td colspan="6">
					    <span style="text-align:center;">	
						    Material. <![CDATA[&nbsp;]]> <span t-esc="eln.material.name"/>
					   </span>
                    </td>
					<td colspan="6">
					    <span style="text-align:center;">	
						    Test End Date. <![CDATA[&nbsp;]]> <span t-esc="eln.end_date"/>
					   </span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">
					   <span style="text-align:center;">	
						    Performed By. <![CDATA[&nbsp;]]> <span t-esc="eln.technician.name"/>
					   </span>
                    </td>
                    <td colspan="4">
					    <span style="text-align:center;">	
						    Witness Name. <![CDATA[&nbsp;]]> <span t-esc="eln.witness_description"/>
					   </span>
                    </td>
                    <td colspan="4">
					     <span style="text-align:center;">	
						    Witness Signature. <![CDATA[&nbsp;]]> <span style='padding:20px'></span>
					   </span>
                    </td>
                </tr>
			</table>
					<table>
							<tr>
							
								<td colspan="6">Date of Casting :
									<![CDATA[&nbsp;]]>
									
									<span t-field="data.date_of_casting"/>
								</td>
							</tr>
						</table>

                       <!-- Dimension  -->
                    
                    <div style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','235487yt5-7a9c-4616-bad5-88eb1b29087y')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','235487yt5-7a9c-4616-bad5-88eb1b29087y')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
                    <table style="margin-top:20px">
					<thead >
						<tr cols="12">
							<td colspan="1" style="text-align: center;font-weight: bold;">Sample
							</td>
							<td colspan="1" style="text-align: center;font-weight: bold;">ID MARK/ Location
							</td>
							<td colspan="1" style="text-align: center;font-weight: bold;">Weight ( Kg )
							</td>
                            <td colspan="1" style="text-align: center;font-weight: bold;">Length ( mm )
							</td>
							 <td colspan="1" style="text-align: center;font-weight: bold;">Width ( mm )
							</td>
							<td colspan="1" style="text-align: center;font-weight: bold;">Height  ( mm )
							</td>
							<td colspan="1" style="text-align: center;font-weight: bold;">Volume (mm3)
							</td>
                            <td colspan="1" style="text-align: center;font-weight: bold;">Density (Kg/m3 )
							</td>
                            
						
						</tr>
						
						</thead>
						  <tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.child_lines_core_density" t-as="r">
							<td colspan="1" style="text-align: center;">
								<span t-esc="r['sr_no']"/>
							</td>
                            <td colspan="1"  style="text-align: center;">
								<span t-esc="r['id_location']"/>
							</td>
							<td colspan="1"  style="text-align: center;">
								<span t-esc="r['weight']" t-options='{"widget": "float", "precision": 3}'/>
							</td>
							<td colspan="1"  style="text-align: center;">
								<span t-esc="r['length']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
                            <td colspan="1"  style="text-align: center;">
								<span t-esc="r['width']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="1"  style="text-align: center;">
								<span t-esc="r['height']" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="1"  style="text-align: center;">
								<span t-esc="r['volume']"  t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td colspan="1"  style="text-align: center;">
								<span t-esc="r['density']"  t-options='{"widget": "float", "precision": 2}'/>
							</td>
							
							
						</tr>
						</tbody>
					</table>

                    <table style="margin-top:5px">
                            <tr cols="12">
                                <td>Avg (kg/m3):<![CDATA[&nbsp;]]>
                                
                                    <span t-field="data.average_core_density" t-options='{"widget": "float", "precision": 2}'/>
                                </td>

							
                            </tr>
                           
                           
                        </table>

                       
                    </div>


     
               
                    
                    <!-- authorizeRowDataSheet -->
                    
                   <div class="authorizeRowDataSheet">
						<div>
                            <div>
                                <b>
                                    Tested By 
                                </b>
                                
                            </div>
                             <div style="height: 40px;">
						<!-- <t t-if="eln.sample_id.testedby_signature_required"> -->
								<t t-if="eln.tested_by_signature_datasheet">

									<div t-if="eln.sample_id.filled_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>
                    
                </div>

            </t>
        </t>
    </template>
    </odoo>