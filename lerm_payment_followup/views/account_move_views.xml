<odoo>
    <data>
        <record id="view_move_form_followup" model="ir.ui.view">
            <field name="name">account.move.form.followup</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="followup_disputed" invisible="1"/>
                    <button name="action_followup_mark_disputed" type="object" string="Mark Disputed"
                            groups="lerm_payment_followup.group_followup_user"
                            invisible="move_type != 'out_invoice' or state != 'posted' or followup_disputed or payment_state not in ('not_paid', 'partial')"/>
                    <button name="action_followup_resolve_dispute" type="object" string="Resolve Dispute"
                            groups="lerm_payment_followup.group_followup_manager"
                            invisible="not followup_disputed"/>
                </xpath>
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="followup_invoice_copy_name" invisible="1"/>
                    <field name="followup_invoice_copy" filename="followup_invoice_copy_name"
                           options="{'accepted_file_extensions': '.pdf'}"
                           invisible="move_type != 'out_invoice'"/>
                </xpath>
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-warning mb-0" role="alert" invisible="not followup_disputed">
                        <strong>Disputed</strong>: this invoice is left out of payment reminders.
                        Reason: <field name="followup_dispute_reason" readonly="1" class="oe_inline"/>
                        <div invisible="not followup_dispute_note">
                            <field name="followup_dispute_note" readonly="1"/>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
