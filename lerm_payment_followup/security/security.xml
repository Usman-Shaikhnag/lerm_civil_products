<odoo>
    <data>
        <record id="group_followup_user" model="res.groups">
            <field name="name">Payment Follow-up: User</field>
            <field name="category_id" ref="lerm_civil.kes_lerm_access_categories"/>
        </record>
        <record id="group_followup_manager" model="res.groups">
            <field name="name">Payment Follow-up: Manager</field>
            <field name="category_id" ref="lerm_civil.kes_lerm_access_categories"/>
            <field name="implied_ids" eval="[(4, ref('group_followup_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_followup_log_user" model="ir.rule">
            <field name="name">Follow-up Log: own customers</field>
            <field name="model_id" ref="model_lerm_followup_log"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('responsible_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_followup_user'))]"/>
        </record>
        <record id="rule_followup_log_manager" model="ir.rule">
            <field name="name">Follow-up Log: all</field>
            <field name="model_id" ref="model_lerm_followup_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_followup_manager'))]"/>
        </record>
    </data>
</odoo>
