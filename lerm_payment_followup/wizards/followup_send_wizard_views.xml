<odoo>
    <data>
        <record id="view_followup_send_wizard_form" model="ir.ui.view">
            <field name="name">lerm.followup.send.wizard.form</field>
            <field name="model">lerm.followup.send.wizard</field>
            <field name="arch" type="xml">
                <form string="Send Payment Reminder">
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="level_id" options="{'no_create': True}"/>
                            <field name="recipient_ids" widget="many2many_tags_email"
                                   context="{'force_email': True, 'show_email': True}"/>
                        </group>
                        <group>
                            <field name="attach_invoices"/>
                            <field name="advance_level" invisible="not level_id"/>
                        </group>
                    </group>
                    <field name="subject" placeholder="Subject..."/>
                    <field name="body" class="oe-bordered-editor" options="{'style-inline': true}"/>
                    <field name="invoice_ids" widget="many2many_tags" options="{'no_create': True}"
                           domain="[('commercial_partner_id', '=', partner_id), ('state', '=', 'posted'), ('move_type', 'in', ('out_invoice', 'out_refund')), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                    <footer>
                        <button name="action_send" type="object" string="Send" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
