<odoo>
    <data>
        <record id="view_followup_log_wizard_form" model="ir.ui.view">
            <field name="name">lerm.followup.log.wizard.form</field>
            <field name="model">lerm.followup.log.wizard</field>
            <field name="arch" type="xml">
                <form string="Log Follow-up">
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="action"/>
                            <field name="outcome"/>
                        </group>
                        <group>
                            <field name="level_id" options="{'no_create': True}"/>
                            <field name="advance_level" invisible="not level_id"/>
                        </group>
                        <group string="Promise to Pay" invisible="outcome != 'promised'">
                            <field name="currency_id" invisible="1"/>
                            <field name="promise_date" required="outcome == 'promised'"/>
                            <field name="promise_amount" required="outcome == 'promised'"/>
                        </group>
                        <group string="Dispute" invisible="outcome != 'disputed'">
                            <field name="dispute_reason" required="outcome == 'disputed'"/>
                        </group>
                    </group>
                    <field name="invoice_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="Invoices discussed or disputed..."
                           required="outcome == 'disputed'"
                           domain="[('commercial_partner_id', '=', partner_id), ('state', '=', 'posted'), ('move_type', '=', 'out_invoice'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                    <field name="note" placeholder="What was discussed..."/>
                    <footer>
                        <button name="action_confirm" type="object" string="Save" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
