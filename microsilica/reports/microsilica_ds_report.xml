<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<template id="microsilica_report">
		<t t-call="web.html_container">
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">

				<div class="container_eln" style="padding-top:20px;">

					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
									</td>
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>
								<td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">--</t>
								</td>
                                <td colspan="1" >ULR NO:</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									  <span t-field="o.sample_id.ulr_no"/>
									</td>
							</tr>
							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>
									</td>
							</tr>
                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">--</t>
								</td>
                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">
								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">-</t>
								</td>
                            </tr>
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
											<span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>
                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">
								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>
							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">-</t>
								</td>
								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>
							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1"></td>
								<td colspan="1">Date of Report Issue :-</td>
								<td colspan="1">
									<t t-if="o.end_date">
										<span t-field="o.end_date"/>
									</t>
									<t t-else="">-</t>
								</td>
							</tr>
                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>
								<td colspan="1">Test Method Followed :-</td>
								<td colspan="1">
									<t t-if="o.material.test_method_adopted">
										<span t-field="o.material.test_method_adopted"/>
									</t>
									<t t-else="">-</t>
								</td>
							</tr>
                            <tr>
								<td colspan="1">Temperature :-</td>
								<td colspan="1"></td>
								<td colspan="1">Humidity :-</td>
								<td colspan="1"></td>
							</tr>
                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>
						</table>
					</div>

					<div style="margin-top:5px;">
						<p><strong>Results</strong>:<![CDATA[&nbsp;]]></p>
					</div>
					<table style="margin-top:10px;">
						<t t-set="i" t-value="0"/>
						<thead>
							<tr>
								<th style="text-align: center;">Sr. No</th>
								<th style="text-align: center;"><span t-esc="eln.material.test_parameter"/></th>
								<th style="text-align: center;"><span t-esc="eln.material.result_remark"/></th>
								<th style="text-align: center;"><span t-esc="eln.material.unit"/></th>
								<th rowspan="1" style="text-align: center;"><span t-field="eln.material.specifications"></span></th>
								<th style="text-align: center;"><span t-esc="eln.material.method_reference"/></th>
							</tr>
						</thead>
					<tbody>

						<!-- 1 — Fineness by Wet Sieving (45 Micron) -->
						<tr t-if="microsilica.wet_sieving_visible and (microsilica.wet_sieving_nabl == 'pass' and nabl or (microsilica.wet_sieving_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl and not fromEln)">
							<td style="text-align: center; vertical-align: middle;">
								<span t-esc="i + 1" />
								<t t-set="i" t-value="i+1"/>
							</td>
							<td style="text-align: center;vertical-align: middle;">
								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).parameter_name"/>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span t-field="microsilica.avg_percent_passing" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).unit"/>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.permissable_limit"/>
									</t>
								</t>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
										</t>
									</t>
								</span>
							</td>
						</tr>
						<tr t-if="microsilica.wet_sieving_visible and fromEln">
							<td style="text-align: center; vertical-align: middle;">
								<span t-esc="i + 1" />
								<t t-set="i" t-value="i+1"/>
							</td>
							<td style="text-align: center;vertical-align: middle;">
								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).parameter_name"/>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span t-field="microsilica.avg_percent_passing" t-options='{"widget": "float", "precision": 2}'/>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).unit"/>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.permissable_limit"/>
									</t>
								</t>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','52147fgtre-5f8c-44a2-984b-6ad2a17d250c')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
										</t>
									</t>
								</span>
							</td>
						</tr>

						<!-- 2 — Compressive Strength of Micro Silica -->
						<tr t-if="microsilica.compressive_strength_visible and (microsilica.compressive_strength_nabl == 'pass' and nabl or (microsilica.compressive_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl and not fromEln)">
							<td style="text-align: center; vertical-align: middle;">
								<span t-esc="i + 1" />
								<t t-set="i" t-value="i+1"/>
							</td>
							<td style="text-align: center;vertical-align: middle;padding:0px;max-width:200px">
								<div style="text-align: center; border-bottom:1px solid black;min-height:50px">
									<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','658798cvfd-889b-477c-a355-0476f6bcd0d7')]).parameter_name"/>
								</div>
								<div style="text-align: center; border-bottom:1px solid black;min-height:25px">
									7 Days
								</div>
								<div style="text-align: center; border-bottom:1px solid black;min-height:25px">
									14 Days
								</div>
								<div style="text-align: center;min-height:25px">
									28 Days
								</div>
							</td>
							<td style="text-align: center;vertical-align: middle; padding: 0px">
								<div style="text-align: center;vertical-align: middle; border-bottom:1px solid black;min-height:50px">
									<span t-field="microsilica.avg_7_strength" t-options='{"widget": "float", "precision": 2}'/>
								</div>
								<div style="text-align: center;vertical-align: middle; border-bottom:1px solid black;min-height:25px">
									<span t-field="microsilica.avg_14_strength" t-options='{"widget": "float", "precision": 2}'/>
								</div>
								<div style="text-align: center;vertical-align: middle;min-height:25px">
									<span t-field="microsilica.avg_28_strength" t-options='{"widget": "float", "precision": 2}'/>
								</div>
							</td>
							<td style="text-align: center;vertical-align: middle;padding:0px;max-width:100px">
								<div style="text-align: center;vertical-align: middle; border-bottom:1px solid black;min-height:50px">
									N/mm²
								</div>
								<div style="text-align: center;vertical-align: middle; border-bottom:1px solid black;min-height:25px">
									N/mm²
								</div>
								<div style="text-align: center;vertical-align: middle;min-height:25px">
									N/mm²
								</div>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','658798cvfd-889b-477c-a355-0476f6bcd0d7')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.permissable_limit"/>
									</t>
								</t>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','658798cvfd-889b-477c-a355-0476f6bcd0d7')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
										</t>
									</t>
								</span>
							</td>
						</tr>
						<tr t-if="microsilica.compressive_strength_visible and fromEln">
							<td style="text-align: center; vertical-align: middle;">
								<span t-esc="i + 1" />
								<t t-set="i" t-value="i+1"/>
							</td>
							<td style="text-align: center;vertical-align: middle;padding:0px;max-width:200px">
								<div style="text-align: center; border-bottom:1px solid black;min-height:50px">
									<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','658798cvfd-889b-477c-a355-0476f6bcd0d7')]).parameter_name"/>
								</div>
								<div style="text-align: center; border-bottom:1px solid black;min-height:25px">
									7 Days
								</div>
								<div style="text-align: center;min-height:25px">
									14 Days / 28 Days
								</div>
							</td>
							<td style="text-align: center;vertical-align: middle; padding: 0px">
								<div style="text-align: center;vertical-align: middle; border-bottom:1px solid black;min-height:50px">
									<span t-field="microsilica.avg_7_strength" t-options='{"widget": "float", "precision": 2}'/>
								</div>
								<div style="text-align: center;vertical-align: middle;min-height:25px">
									<span t-field="microsilica.avg_28_strength" t-options='{"widget": "float", "precision": 2}'/>
								</div>
							</td>
							<td style="text-align: center;vertical-align: middle;padding:0px;max-width:100px">
								<div style="text-align: center;vertical-align: middle; border-bottom:1px solid black;min-height:50px">
									N/mm²
								</div>
								<div style="text-align: center;vertical-align: middle;min-height:25px">
									N/mm²
								</div>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','658798cvfd-889b-477c-a355-0476f6bcd0d7')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.permissable_limit"/>
