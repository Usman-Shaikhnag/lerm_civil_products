						<!-- 4 — Accelerated Pozzolanic Activity Index -->
						<tr t-if="microsilica.pozzolanic_visible and (microsilica.pozzolanic_nabl == 'pass' and nabl or (microsilica.pozzolanic_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl and not fromEln)">
							<td style="text-align: center; vertical-align: middle;">
								<span t-esc="i + 1" />
								<t t-set="i" t-value="i+1"/>
							</td>
							<td style="text-align: center;vertical-align: middle;">
								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','ddd2525aw-19f0-48b6-8e09-e7076a4b04b5')]).parameter_name"/>
