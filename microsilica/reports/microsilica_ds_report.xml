								</t>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span>
									<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','658798cvfd-889b-477c-a355-0476f6bcd0d7')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
										</t>
									</t>
								</span>
							</td>
						</tr>

						<!-- 3 — Specific Gravity -->
						<tr t-if="microsilica.specific_gravity_visible and (microsilica.specific_gravity_nabl == 'pass' and nabl or (microsilica.specific_gravity_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl and not fromEln)">
