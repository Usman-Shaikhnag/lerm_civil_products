								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','658fgtrcd-80ef-4de0-96ba-a279f27b9ede')]).parameter_name"/>
							</td>
							<td style="text-align: center; vertical-align: middle;">
								<span t-field="microsilica.specific_gravity_avrg" t-options='{"widget": "float", "precision": 2}'/>
							</td>
