<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mechanical_microsilica" model="ir.ui.view">
        <field name="name">mechanical.microsilica.form</field>
        <field name="model">mechanical.microsilica</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                <group >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id"  readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;
                            border-color: #3b82f6 !important;
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <!-- 1 — Fineness by Wet Sieving (45 Micron) -->

                    <div invisible="not wet_sieving_visible">
                        <h1>
                            <field name="wet_sieving_name" readonly="1" nolabel="1"/>
                            <field name="wet_sieving_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group invisible="not wet_sieving_visible"/>
                    <div invisible="not wet_sieving_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td style="font-weight: bold;">Sample Weight (Ws) (g)</td>
                                    <td><field name="sample_weight_ws" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Sieve Size Used</td>
                                    <td><field name="sieve_size_ws" class="blue-input"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="custom_table_borders" invisible="not wet_sieving_visible">
                        <field name="wet_sieving_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="sr_no"/>
                                <field name="sample_weight" class="blue-input"/>
                                <field name="weight_retained" class="blue-input"/>
                                <field name="weight_passing"/>
                                <field name="percent_passing"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not wet_sieving_visible">
                        <tbody>
                            <tr>
                                <td><span>Average % Material Passing</span></td>
                                <td><field name="avg_percent_passing"/></td>
                            </tr>
                            <tr>
                                <td><span>Conformity</span></td>
                                <td><field name="wet_sieving_conformity"
                                    decoration-success="wet_sieving_conformity == 'pass'"
                                    decoration-danger="wet_sieving_conformity == 'fail'"
                                    readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><span>NABL</span></td>
                                <td><field name="wet_sieving_nabl"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <group invisible="not wet_sieving_visible"/>
                    <group invisible="not wet_sieving_visible"/>


                    <!-- 2 — Compressive Strength of Micro Silica -->

                    <div invisible="not compressive_strength_visible">
                        <h1>
                            <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                            <field name="compressive_strength_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group invisible="not compressive_strength_visible"/>

                    <div style="display:flex;" invisible="not compressive_strength_visible">
                        <div style="width:50%;">
                            <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Temperature °c</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="temp_cs" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Humidity %</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="humidity_cs" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div style="width:50%;">
                            <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Start Date</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="start_date_cs" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">End Date</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="end_date_cs" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="display:flex;" invisible="not compressive_strength_visible">
                        <div style="width:50%">
                            <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                                <tbody>
                                    <tr>
                                        <td><span>Weight of Sand (g)</span></td>
                                        <td><field name="wt_of_sand_cs" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Cement + Silica (g)</span></td>
                                        <td><field name="wt_of_cement_silica_cs" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Standard Consistency P (%)</span></td>
                                        <td><field name="std_consistency_p" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Water (g) (P/4+3.0)</span></td>
                                        <td><field name="water_weight_cs"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div style="width:50%">
                            <div style="text-align: center; font-weight: bold;">Size of Cube : 70.6 x 70.6 x 70.6</div>
                        </div>
                    </div>

                    <div class="custom_table_borders" invisible="not compressive_strength_visible">
                        <field name="comp_str_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="sr_no"/>
                                <field name="age_days" class="blue-input"/>
                                <field name="weight_g" class="blue-input"/>
                                <field name="density_g_cc"/>
                                <field name="load_kN" class="blue-input"/>
                                <field name="comp_strength"/>
                            </tree>
                        </field>
                    </div>

                    <div style="display:flex;" invisible="not compressive_strength_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><span>Avg Compressive Strength 7 Days (N/mm²)</span></td>
                                    <td><field name="avg_7_strength"/></td>
                                </tr>
                                <tr>
                                    <td><span>Avg Compressive Strength 14 Days (N/mm²)</span></td>
                                    <td><field name="avg_14_strength"/></td>
                                </tr>
                                <tr>
                                    <td><span>Avg Compressive Strength 28 Days (N/mm²)</span></td>
                                    <td><field name="avg_28_strength"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not compressive_strength_visible">
                        <tbody>
                            <tr>
                                <td><span>Conformity</span></td>
                                <td><field name="compressive_strength_conformity"
                                    decoration-success="compressive_strength_conformity == 'pass'"
                                    decoration-danger="compressive_strength_conformity == 'fail'"
                                    readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><span>NABL</span></td>
                                <td><field name="compressive_strength_nabl"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <group invisible="not compressive_strength_visible"/>
                    <group invisible="not compressive_strength_visible"/>


                    <!-- 3 — Specific Gravity -->

                    <div invisible="not specific_gravity_visible">
                        <h1>
                            <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group invisible="not specific_gravity_visible"/>

                    <div class="custom_table_borders" invisible="not specific_gravity_visible">
                        <field name="specific_gravity_tables" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="sr_no"/>
                                <field name="w1_microsilica" class="blue-input"/>
                                <field name="v1_initial" class="blue-input"/>
                                <field name="v2_final" class="blue-input"/>
                                <field name="volume_silica"/>
                                <field name="wt_equal_vol_water"/>
                                <field name="spe_gravt_microsilica"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not specific_gravity_visible">
                        <tbody>
                            <tr>
                                <td><span>Average</span></td>
                                <td><field name="specific_gravity_avrg"/></td>
                            </tr>
                            <tr>
                                <td><span>Conformity</span></td>
                                <td><field name="specific_gravity_conformity"
                                    decoration-success="specific_gravity_conformity == 'pass'"
                                    decoration-danger="specific_gravity_conformity == 'fail'"
                                    readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><span>NABL</span></td>
                                <td><field name="specific_gravity_nabl"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <group invisible="not specific_gravity_visible"/>
                    <group invisible="not specific_gravity_visible"/>


                    <!-- 4 — Accelerated Pozzolanic Activity Index -->

                    <div invisible="not pozzolanic_visible">
                        <h1>
                            <field name="pozzolanic_name" readonly="1" nolabel="1"/>
                            <field name="pozzolanic_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group invisible="not pozzolanic_visible"/>

                    <div style="display:flex;" invisible="not pozzolanic_visible">
                        <div style="width:50%;">
                            <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Temperature °c</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="temp_pozzolanic" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Humidity %</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="humidity_pozzolanic" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div style="width:50%;">
                            <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">Start Date</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="start_date_pozzolanic" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black; padding: 8px; font-weight: bold;">End Date</td>
                                        <td style="border: 1px solid black; padding: 8px;"><field name="end_date_pozzolanic" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div style="display:flex;" invisible="not pozzolanic_visible">
                        <div style="width:50%">
                            <h3 style="white-space: nowrap;">Compressive Strength of Test Mixture</h3>
                            <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                                <tbody>
                                    <tr>
                                        <td><span>High Range water reducer (g)</span></td>
                                        <td><field name="tm_high_range_water" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Microsilica (g)</span></td>
                                        <td><field name="tm_wt_microsilica" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Cement (g)</span></td>
                                        <td><field name="tm_wt_cement" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Standard Sand (g) Grade-I</span></td>
                                        <td><field name="tm_wt_sand_grade1" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Standard Sand (g) Grade-II</span></td>
                                        <td><field name="tm_wt_sand_grade2" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Standard Sand (g) Grade-III</span></td>
                                        <td><field name="tm_wt_sand_grade3" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Quantity of Water (g)</span></td>
                                        <td><field name="tm_quantity_water" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div style="width:50%">
                            <h3 style="white-space: nowrap;">Calculation of Flow (Acceptable : 100 to 115 %) : Measured Values</h3>
                            <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><field name="tm_measured_val1" colspan="3" nolabel="1" class="blue-input"/></td>
                                        <td><field name="tm_measured_val2" colspan="3" nolabel="1" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><field name="tm_measured_val3" colspan="3" nolabel="1" class="blue-input"/></td>
                                        <td><field name="tm_measured_val4" colspan="3" nolabel="1" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><span>Average</span></td>
                                        <td><field name="tm_avg_measured"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>% Flow</span></td>
                                        <td><field name="tm_percent_flow"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <group invisible="not pozzolanic_visible"/>

                    <!-- 7 Days Casting — Test Mixture -->
                    <div invisible="not pozzolanic_visible">
                        <h1><field name="tm_casting_date" readonly="1" nolabel="1"/></h1>
                    </div>
                    <group invisible="not pozzolanic_visible"/>

                    <div invisible="not pozzolanic_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><span>Date of Casting</span></td>
                                    <td><field name="tm_casting_date" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><span>Date of Testing</span></td>
                                    <td><field name="tm_testing_date"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="custom_table_borders" style="margin-top:20px;" invisible="not pozzolanic_visible">
                        <h3 style="white-space: nowrap;">7 Days — Test Mixture</h3>
                        <field name="tm_casting_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="length" class="blue-input"/>
                                <field name="width" class="blue-input"/>
                                <field name="crosssectional_area"/>
                                <field name="wt_cube" class="blue-input"/>
                                <field name="crushing_load" class="blue-input"/>
                                <field name="compressive_strength"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not pozzolanic_visible">
                        <tbody>
                            <tr>
                                <td><span>Average</span></td>
                                <td><field name="tm_avg_7days"/></td>
                            </tr>
                            <tr>
                                <td><span>Compressive Strength</span></td>
                                <td><field name="tm_comp_strength_7"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <group invisible="not pozzolanic_visible"/>
                    <group invisible="not pozzolanic_visible"/>

                    <!-- Compressive Strength of Control Sample -->
                    <div style="display:flex;" invisible="not pozzolanic_visible">
                        <div style="width:50%">
                            <h3 style="white-space: nowrap;">Compressive Strength of Control Sample</h3>
                            <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                                <tbody>
                                    <tr>
                                        <td><span>High Range water reducer (g)</span></td>
                                        <td><field name="cs_high_range_water" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Cement (g)</span></td>
                                        <td><field name="cs_wt_cement" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Standard Sand (g) Grade-I</span></td>
                                        <td><field name="cs_wt_sand_grade1" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Standard Sand (g) Grade-II</span></td>
                                        <td><field name="cs_wt_sand_grade2" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Weight of Standard Sand (g) Grade-III</span></td>
                                        <td><field name="cs_wt_sand_grade3" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>Quantity of Water (g)</span></td>
                                        <td><field name="cs_quantity_water" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div style="width:50%">
                            <h3 style="white-space: nowrap;">Calculation of Flow (Acceptable : 100 to 115 %) : Measured Values</h3>
                            <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><field name="cs_measured_val1" colspan="3" nolabel="1" class="blue-input"/></td>
                                        <td><field name="cs_measured_val2" colspan="3" nolabel="1" class="blue-input"/></td>
                                    </tr>
                                    <tr>
                                        <td><field name="cs_measured_val3" colspan="3" nolabel="1" class="blue-input"/></td>
                                        <td><field name="cs_measured_val4" colspan="3" nolabel="1" class="blue-input"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                                <tbody>
                                    <tr>
                                        <td><span>Average</span></td>
                                        <td><field name="cs_avg_measured"/></td>
                                    </tr>
                                    <tr>
                                        <td><span>% Flow</span></td>
                                        <td><field name="cs_percent_flow"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <group invisible="not pozzolanic_visible"/>

                    <!-- 7 Days — Control Sample -->
                    <div invisible="not pozzolanic_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><span>Date of Casting</span></td>
                                    <td><field name="cs_casting_date" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><span>Date of Testing</span></td>
                                    <td><field name="cs_testing_date"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="custom_table_borders" style="margin-top:20px;" invisible="not pozzolanic_visible">
                        <h3 style="white-space: nowrap;">7 Days — Control Sample</h3>
                        <field name="cs_casting_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="cs_length" class="blue-input"/>
                                <field name="cs_width" class="blue-input"/>
                                <field name="cs_crosssectional_area"/>
                                <field name="cs_wt_cube" class="blue-input"/>
                                <field name="cs_crushing_load" class="blue-input"/>
                                <field name="cs_compressive_strength"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not pozzolanic_visible">
                        <tbody>
                            <tr>
                                <td><span>Average</span></td>
                                <td><field name="cs_avg_7days"/></td>
                            </tr>
                            <tr>
                                <td><span>Accelerated Pozzolanic Activity Index 7 Days (%)</span></td>
                                <td><field name="pozzolanic_index"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not pozzolanic_visible">
                        <tbody>
                            <tr>
                                <td><span>Conformity</span></td>
                                <td><field name="pozzolanic_conformity"
                                    decoration-success="pozzolanic_conformity == 'pass'"
                                    decoration-danger="pozzolanic_conformity == 'fail'"
                                    readonly="1"/></td>
                            </tr>
                            <tr>
                                <td><span>NABL</span></td>
                                <td><field name="pozzolanic_nabl"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <group invisible="not pozzolanic_visible"/>
                    <group invisible="not pozzolanic_visible"/>


                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight"
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
            </field>
        </record>

        <record id="view_microsilica_prefill_data_form" model="ir.ui.view">
            <field name="name">mech.microsilica.prefill.data.form</field>
            <field name="model">mech.microsilica.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>
                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_microsilica_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mech.microsilica.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_microsilica_prefill_data_form"/>
            <field name="target">new</field>
