<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mechanical_microsilica" model="ir.ui.view">
        <field name="name">mechanical.microsilica.form</field>
        <field name="model">mechanical.microsilica</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                <group >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id"  readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                     
                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>



                  <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temp"></label>
                                    </td>
                                    <td>
                                        <field name="temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>


                  <!-- FINENESS BY WET SIEVING ( 45 MICRON )  -->


                    <div invisible="not particles_retained_visible">
                        <h1 class="text-center">
                            <field name="particles_retained_name" readonly="1" nolabel="1"/>
                            <field name="particles_retained_visible" invisible="1"/>
                        </h1>
                    </div>
                    <div class="custom_table_borders" invisible="not particles_retained_visible">
                        <field name="particles_retained_line_ids" nolabel="1" >
                        <tree editable="bottom">
                        <field name="sr_no" width="200"/>
                          <field name="weight_sample" class="blue-input" decoration-info="weight_sample != 0" width="200"/>
                          <field name="weight_residue" class="blue-input" decoration-info="weight_residue != 0" width="200"/>
                          <field name="weight_material_passing" width="200"/>
                          <field name="percentage_passing" width="200"/>
                        </tree>
                        </field>
                    </div>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not particles_retained_visible">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="avg_percentage_passing">Average Percentage Passing</label></td>
                                    <td><field name="avg_percentage_passing"/></td>
                                </tr>
                                <tr>
                            <td><label for="avg_percentage_passing_conformity" class="text-bold">Conformity</label></td>
                             <td><field name="avg_percentage_passing_conformity"
                                        decoration-success="avg_percentage_passing_conformity == 'pass'" 
                                        decoration-danger="avg_percentage_passing_conformity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="avg_percentage_passing_nabl" class="text-bold">NABL</label></td>
                           <td><field name="avg_percentage_passing_nabl"
                                        decoration-success="avg_percentage_passing_nabl == 'pass'" 
                                        decoration-danger="avg_percentage_passing_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                          <tr>
                                <td><label class="fw-bold" for="percentage_passing_report_type">Report Type</label></td>
                                <td><field name="percentage_passing_report_type" class="blue-input" decoration-info="percentage_passing_report_type != 0"/></td>
                            </tr>
                            </tbody>
                        </table>



                    <!-- Compressive Strength -->
                    

                    <div invisible = "compressive_visible == False" >
                        <h1 class="text-center">
                            <field name="compressive_name" readonly="1" nolabel="1"/>
                            <field name="compressive_visible" invisible="1"/>
                        </h1>
                    </div>


                    <div invisible = "compressive_visible == False">
                        <field name="compressive_lines">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="days" class="blue-input" decoration-info="days != 0" />
                                <field name="wt_of_cube" class="blue-input" decoration-info="wt_of_cube != 0"/>
                                <field name="density" />
                                <field name="load" class="blue-input" decoration-info="load != 0"/>
                                <field name="compressive_strength" />
                            </tree>
                        </field>
                    </div>

                     <div class="d-flex gap-2" invisible="not compressive_visible">

                    

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not compressive_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_7_days">Avg Compressive Strength (7 Days)</label></td>
                                <td><field name="avg_7_days"/><span>N/mm²</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_7_days_confirmity">Compressive Strength (7 Days) Conformity</label></td>
                                <td>
                                    <field name="avg_7_days_confirmity"
                                        decoration-success="avg_7_days_confirmity == 'pass'" 
                                        decoration-danger="avg_7_days_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_7_days_nabl">Compressive Strength (7 Days) NABL</label></td>
                                <td>
                                    <field name="avg_7_days_nabl"
                                        decoration-success="avg_7_days_nabl == 'pass'" 
                                        decoration-danger="avg_7_days_nabl == 'fail'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_7_days_report_type">Report Type</label></td>
                                <td><field name="avg_7_days_report_type" class="blue-input" decoration-info="avg_7_days_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not compressive_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_14_days">Avg Compressive Strength (3 Days)</label></td>
                                <td><field name="avg_14_days"/><span>N/mm²</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_14_days_confirmity">Compressive Strength (3 Days) Conformity</label></td>
                                <td>
                                    <field name="avg_14_days_confirmity"
                                        decoration-success="avg_14_days_confirmity == 'pass'" 
                                        decoration-danger="avg_14_days_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_14_days_nabl">Compressive Strength (3 Days) NABL</label></td>
                                <td>
                                    <field name="avg_14_days_nabl"
                                        decoration-success="avg_14_days_nabl == 'pass'" 
                                        decoration-danger="avg_14_days_nabl == 'fail'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_14_days_report_type">Report Type</label></td>
                                <td><field name="avg_14_days_report_type" class="blue-input" decoration-info="avg_14_days_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not compressive_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_28_days">Avg Compressive Strength (28 Days)</label></td>
                                <td><field name="avg_28_days"/><span>N/mm²</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_28_days_confirmity">Compressive Strength (28 Days) Conformity</label></td>
                                <td>
                                    <field name="avg_28_days_confirmity"
                                        decoration-success="avg_28_days_confirmity == 'pass'" 
                                        decoration-danger="avg_28_days_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_28_days_nabl">Compressive Strength (28 Days) NABL</label></td>
                                <td>
                                    <field name="avg_28_days_nabl"
                                        decoration-success="avg_28_days_nabl == 'pass'" 
                                        decoration-danger="avg_28_days_nabl == 'fail'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_28_days_report_type">Report Type</label></td>
                                <td><field name="avg_28_days_report_type" class="blue-input" decoration-info="avg_28_days_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                    </div>




                    <!-- SPECIFIC GRAVITY  -->
                      <div class="text-center" invisible="specific_gravity_visible == False">
                        <h1>
                            <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "specific_gravity_visible == False" class="custom_table_borders">
                        <field name="specific_gravity_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='weight_cement'  class="blue-input" decoration-info="weight_cement != 0" />
                                <field name='initial_reading' class="blue-input" decoration-info="initial_reading != 0"/>
                                <field name='final_reading' class="blue-input" decoration-info="final_reading != 0"/>
                                <field name='volume_cement'  />
                                <field name='weight_equal_volume_water' />
                                <field name='specific_gravity'/>
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not specific_gravity_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_specific_gravity">Average Specific Gravity</label></td>
                                <td><field name="average_specific_gravity"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_specific_gravity_confirmity">Conformity</label></td>
                                <td>
                                    <field name="average_specific_gravity_confirmity"
                                        decoration-success="average_specific_gravity_confirmity == 'pass'" 
                                        decoration-danger="average_specific_gravity_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_specific_gravity_nabl">NABL</label></td>
                                <td>
                                    <field name="average_specific_gravity_nabl"
                                        decoration-success="average_specific_gravity_nabl == 'pass'" 
                                        decoration-danger="average_specific_gravity_nabl == 'fail'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="specific_gravity_report_type">Report Type</label></td>
                                <td><field name="specific_gravity_report_type" class="blue-input" decoration-info="specific_gravity_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>



                    <!-- MOISTURE CONTENT  -->
                      <div class="text-center" invisible="moisture_content_visible == False">
                        <h1>
                            <field name="moisture_content_name" readonly="1" nolabel="1"/>
                            <field name="moisture_content_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "moisture_content_visible == False" class="custom_table_borders">
                        <field name="moisture_content_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='m0'  class="blue-input" decoration-info="m0 != 0" />
                                <field name='m1' class="blue-input" decoration-info="m1 != 0"/>
                                <field name='m2' class="blue-input" decoration-info="m2 != 0"/>
                                <field name='moisture_content'  />
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not moisture_content_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_moisture_content">Average Moisture Content (%)</label></td>
                                <td><field name="average_moisture_content"/></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_moisture_content_confirmity">Conformity</label></td>
                                <td>
                                    <field name="average_moisture_content_confirmity"
                                        decoration-success="average_moisture_content_confirmity == 'pass'" 
                                        decoration-danger="average_moisture_content_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_moisture_content_nabl">NABL</label></td>
                                <td>
                                    <field name="average_moisture_content_nabl"
                                        decoration-success="average_moisture_content_nabl == 'pass'" 
                                        decoration-danger="average_moisture_content_nabl == 'fail'"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="moisture_content_report_type">Report Type</label></td>
                                <td><field name="moisture_content_report_type" class="blue-input" decoration-info="moisture_content_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                   

                    

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
               
                </sheet>
            </form>
            </field>
        </record>

        <record id="view_microsilica_prefill_data_form" model="ir.ui.view">
            <field name="name">mech.microsilica.prefill.data.form</field>
            <field name="model">mech.microsilica.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_microsilica_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mech.microsilica.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_microsilica_prefill_data_form"/>
            <field name="target">new</field>
        </record>


    </data>
</odoo>



