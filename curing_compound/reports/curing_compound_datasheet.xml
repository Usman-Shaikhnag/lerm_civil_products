<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="curing_compound_datasheet">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			<t t-call="lerm_civil.data_sheet_header_generaltemplate">
                <div style="text-align:center;font-size:18px">
                    Concrete Curing Compound Test 
                </div>
                <div class="container_eln" style="margin-top:5px">
				 <table style="margin-top:20px">
				<tr cols="12">
					
				    <td colspan="6">
					    <span style="text-align:center;">	
						    Job No. <![CDATA[&nbsp;]]> <span t-esc="eln.eln_id"/>
					   </span>
                    </td>
					<td colspan="6">
					    <span style="text-align:center;">	
						    Test Start Date. <![CDATA[&nbsp;]]> <span t-esc="eln.start_date"/>
					   </span>
                    </td>
				</tr>
