                    </td>
					<td colspan="6">
					    <span style="text-align:center;">	
						    Test End Date. <![CDATA[&nbsp;]]> <span t-esc="eln.end_date"/>
					   </span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">
