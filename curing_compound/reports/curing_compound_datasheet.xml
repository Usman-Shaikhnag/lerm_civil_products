									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</div>

						<table style="margin-top:20px">
							<tr cols="12">
								<td colspan="1">Specimen No
								</td>
								<td colspan="4">Mass of Empty Cup W0 (g)
								</td>
								<td colspan="4">Mass of Cup with Sample W1 (g)
								</td>
								<td colspan="3">Volume of Cup V (ml)
								</td>
								<td colspan="4">Density = (W1 - W0)/V (g/ml)
								</td>
								
							</tr>

							<t t-set="i" t-value="0"/>
							<tr t-foreach="data.density_test_data_table" t-as="r">
								<td colspan="1">
									<div>
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</div>
                  				</td>
								<td colspan="4">
									<span t-esc="r['Mass']"/>
								</td>
								<td colspan="4">
									<span t-esc="r['Mass_of_Cup_with_Sample']"/>
								</td>
								<td colspan="3">
									<span t-esc="r['volume']"/>
								</td>
								<td colspan="4">
									<span t-esc="r['density']"/>
								</td>
							</tr>
						</table>
						<table style="margin-top:20px">
							<tr cols="12">
								<td colspan="6">Average Density g/ml:
									<![CDATA[&nbsp;]]>
								</td>
                                <td colspan="6">
									<span t-field="data.average_density"/>
								</td>
							</tr>
                            
							
