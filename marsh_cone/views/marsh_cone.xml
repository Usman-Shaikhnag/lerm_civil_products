<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_mechanical_cement_compat_form" model="ir.ui.view">
            <field name="name">mechanical.cement.compatiblity.form</field>
            <field name="model">mechanical.cement.compatiblity</field>
            <field name="arch" type="xml">
                <form>
                  <sheet>

                    <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="custom_table_borders">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <!-- Compatibility Test -->

                    <div invisible=" not compatibility_visible">
                        <h1 class="text-center">
                            <field name="compatibility_name" readonly="1" nolabel="1" style="margin:20px 0px"/>
                            <field name="compatibility_visible" invisible="1" style="margin:20px 0px"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-2" invisible=" not compatibility_visible"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temp_percent_normal" >Temperature °C</label>
                                    </td>
                                    <td>
                                        <field name="temp_percent_normal" class="blue-input"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="humidity_percent_normal" >Humidity %</label>
                                    </td>
                                    <td>
                                        <field name="humidity_percent_normal" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>

                                <tr>
                                    <td>
                                        <label class="fw-bold" for="start_date" >Start Date</label>
                                    </td>
                                    <td>
                                        <field name="start_date" class="blue-input"/>
                                    </td>
                                </tr>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="end_date" >End Date</label>
                                    </td>
                                    <td>
                                        <field name="end_date" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div invisible="not compatibility_visible" class="custom_table_borders">
                        <field name="child_lines" nolabel="1">
                            <tree editable="bottom">
                               
                               
                                <field name='admixture_dosage_percent' class="blue-input" decoration-info="admixture_dosage_percent != 0"/>
                                <field name='wt_of_cement' class="blue-input" decoration-info="wt_of_cement != 0"/>
                                <field name='wt_of_water' class="blue-input" decoration-info="wt_of_water != 0"/>
                                
                                <field name='flow_sec' class="blue-input" decoration-info="flow_sec != 0"/>
                                <field name='flow_30_min' class="blue-input" decoration-info="flow_30_min != 0"/>
                                <field name='flow_60_min' class="blue-input" decoration-info="flow_60_min != 0"/>
                                <field name='water_cement_ratio'/>
                                <field name='wt_of_admixture' />
                                
                            </tree>
                        </field> 
                    </div> 


                    <div invisible = "compatibility_visible == False" class="custom_table_borders text-center">
                        <field name="chart_image" widget="image" readonly="1"/>
                    </div>

                    <table class="table table-sm table-bordered w-100 custom_table_borders" style="white-space:nowrap;" invisible = "compatibility_visible == False">
                            <tbody>

                                <tr>
                                    <td width="20%">
                                        <label class="fw-bold" for="comment" >Comment</label>
                                    </td>
                                    <td width="80%">
                                        <field name="comment" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>


                       
                        
