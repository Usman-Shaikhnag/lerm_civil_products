                        <group style="width:30%">
                            <field name="temp_percent_normal"/>
                            <field name="humidity_percent_normal"/>
                        </group>

                        <group style="width:30%">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group> -->


