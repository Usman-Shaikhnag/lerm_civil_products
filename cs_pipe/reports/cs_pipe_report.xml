<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="cs_pipe_requirement_cell">
		<t t-set="cs_pipe_master" t-value="env['lerm.parameter.master'].search([('internal_id','=',cs_pipe_parameter_id)], limit=1)"/>
		<t t-set="cs_pipe_grade_id" t-value="cs_pipe_eln.grade_id.id"/>
		<t t-set="cs_pipe_rows" t-value="cs_pipe_master.parameter_table"/>
		<t t-set="cs_pipe_row" t-value="(cs_pipe_rows.filtered(lambda r: r.grade.id == cs_pipe_grade_id) or cs_pipe_rows.filtered(lambda r: not r.grade))[:1]"/>
		<t t-set="cs_pipe_limit" t-value="cs_pipe_row.permissable_limit.strip() if cs_pipe_row and cs_pipe_row.permissable_limit else ''"/>
		<t t-set="cs_pipe_req" t-value="cs_pipe_limit if cs_pipe_limit and cs_pipe_limit != '--' else ''"/>
		<t t-set="cs_pipe_min" t-value="'{:.4f}'.format(cs_pipe_row.req_min).rstrip('0').rstrip('.') if cs_pipe_row and cs_pipe_row.req_min else ''"/>
		<t t-set="cs_pipe_max" t-value="'{:.4f}'.format(cs_pipe_row.req_max).rstrip('0').rstrip('.') if cs_pipe_row and cs_pipe_row.req_max else ''"/>
		<t t-set="cs_pipe_range" t-value="' - '.join([v for v in [cs_pipe_min, cs_pipe_max] if v])"/>
		<span t-esc="cs_pipe_req or cs_pipe_range"/>
	</template>

