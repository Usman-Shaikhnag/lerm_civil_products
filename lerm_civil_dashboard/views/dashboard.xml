            <!-- <menuitem name="LERM" id="main_dashboard" sequence="10" action="lerm_dashboard_action"/>     -->
        </menuitem> 
        <menuitem name="Customer" id="customer_dashboard" parent="menu_dashboard" sequence="11" action="customer_dashboard_action"/>    
    </data>
</odoo>