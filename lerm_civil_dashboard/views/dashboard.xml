
<odoo>
    <data>
        <record id="lerm_dashboard_action" model="ir.actions.client">
            <field name="name">Lerm Dashboard</field>
            <field name="tag">main_dashboard</field>
        </record>
        
        <record id="customer_dashboard_action" model="ir.actions.client">
            <field name="name">Customer Dashboard</field>
            <field name="tag">customer_dashboard</field>
