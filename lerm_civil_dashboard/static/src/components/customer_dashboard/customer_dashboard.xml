<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="lerm_civil_dashboard.CustomerDashboard" owl="1">
        <div class="lerm-dashboard scrollable-dashboard container-fluid py-4">
            
            <!-- FILTER PANEL -->
            <div class="lerm-filter-panel mb-4">
                <div class="panel-heading">
                    <i class="fa fa-sliders"/>
                    <h6>Customer Dashboard Filters</h6>
                </div>

                <div class="lerm-date-section">
                    <div class="row g-3 mb-4 align-items-end">
                        <!-- Search Bar -->
                        <div class="col-lg-4 col-md-6">
                            <label class="lerm-field-label">Search Customer</label>
                            <div class="input-group flex-nowrap" style="height: 38px; border-bottom: 1.5px solid #d1d5db;">
                                <input type="text" class="lerm-select flex-grow-1 border-0" placeholder="Search by name..."
                                       t-att-value="filter_state.searchQuery" 
                                       t-on-change="_onSearchCustomer"
                                       t-on-keyup="_onSearchCustomer"
                                       style="box-shadow: none;"/>
                                <span class="input-group-text bg-white border-0 rounded-0">
                                    <i class="fa fa-search text-muted" style="font-size: 0.85rem;"/>
                                </span>
                            </div>
                        </div>

                        <!-- Discipline Filter -->
                        <div class="col-lg-8 col-md-6">
                            <label class="lerm-field-label">Discipline</label>
                            <div class="lerm-btn-group">
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="ALL"
                                        t-att-style="this.filter_state.activeDiscipline === 'ALL' ? 'background:#0066ff;color:#fff;' : ''">ALL</button>
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="MECHANICAL"
                                        t-att-style="this.filter_state.activeDiscipline === 'MECHANICAL' ? 'background:#0066ff;color:#fff;' : ''">Mechanical</button>
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="NDT"
                                        t-att-style="this.filter_state.activeDiscipline === 'NDT' ? 'background:#0066ff;color:#fff;' : ''">NDT</button>
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="CHEMICAL"
                                        t-att-style="this.filter_state.activeDiscipline === 'CHEMICAL' ? 'background:#0066ff;color:#fff;' : ''">Chemical</button>
                            </div>
                        </div>
                    </div>

                    <!-- Date Range Row -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa fa-calendar" style="color:#5d3a9b;font-size:0.85rem;"/>
                        <span class="date-label">Date Range</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="lerm-btn-group" style="width:auto; flex-shrink:0;">
                            <button class="lerm-toggle-btn" style="padding:0.4rem 1rem;" t-on-click="_onDateFilter" data-days="30"
                                    t-att-style="filter_state.activeDays == 30 ? 'background:#0066ff;color:#fff;' : ''">30 days</button>
                            <button class="lerm-toggle-btn" style="padding:0.4rem 1rem;" t-on-click="_onDateFilter" data-days="180"
                                    t-att-style="filter_state.activeDays == 180 ? 'background:#0066ff;color:#fff;' : ''">180 days</button>
                            <button class="lerm-toggle-btn" style="padding:0.4rem 1rem;" t-on-click="_onDateFilter" data-days="365"
                                    t-att-style="filter_state.activeDays == 365 ? 'background:#0066ff;color:#fff;' : ''">365 days</button>
                        </div>
                        <div class="d-flex align-items-center gap-2 px-2 py-1 rounded" style="background:#fff;border:1px solid #e0d9f3;">
                            <span class="lerm-date-separator">From</span>
                            <input type="date" class="lerm-date-input"
                                   t-att-value="filter_state.start_date" t-on-change="_onDateInputChange" data-field="start_date"/>
                            <span class="lerm-date-separator">To</span>
                            <input type="date" class="lerm-date-input"
                                   t-att-value="filter_state.end_date" t-on-change="_onDateInputChange" data-field="end_date"/>
                            <button class="lerm-refresh-btn" t-on-click="_onCustomDate" title="Apply range">
                                <i class="fa fa-search" style="font-size:0.75rem;"/>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION HEADER & PAGINATION -->
            <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                <div class="lerm-section-header m-0" style="flex: 1;">
                    <i class="fa fa-building"/>
                    <h2>Customer Performance Overview (<t t-esc="filter_state.totalCustomers"/>)</h2>
                </div>
                
                <div t-if="!filter_state.isLoading and filter_state.totalCustomers > 0" class="d-flex align-items-center gap-3 bg-white px-3 py-2 rounded shadow-sm border" style="font-size: 0.82rem;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted">Show:</span>
                        <select class="form-select form-select-sm border-0 bg-light py-0" style="width:auto; height: 24px;" t-on-change="_onPageSizeChange">
                            <option value="10" t-att-selected="filter_state.pageSize == 10">10</option>
                            <option value="15" t-att-selected="filter_state.pageSize == 15">15</option>
                            <option value="25" t-att-selected="filter_state.pageSize == 25">25</option>
                            <option value="50" t-att-selected="filter_state.pageSize == 50">50</option>
                        </select>
                    </div>
                    
                    <div class="vr" style="height: 16px; opacity: 0.2;"></div>
                    
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted">Page <t t-esc="filter_state.currentPage"/>/<t t-esc="totalPages"/></span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary border-0 py-0" style="height: 24px;" 
                                    t-att-disabled="filter_state.currentPage === 1" 
                                    t-on-click="() => this._onPageChange(-1)">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <button class="btn btn-outline-secondary border-0 py-0" style="height: 24px;" 
                                    t-att-disabled="filter_state.currentPage === totalPages or totalPages === 0" 
                                    t-on-click="() => this._onPageChange(1)">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <t t-if="filter_state.isLoading">
                <div class="lerm-empty-state">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    Loading customer data...
                </div>
            </t>
            <t t-else="">
                <t t-if="dashboard_state.customer_data.length === 0">
                    <div class="lerm-empty-state">
                        <i class="fa fa-info-circle me-2"/> No customer data found for the selected filters.
                    </div>
                </t>
                <t t-else="">
                    <div class="row g-3 mb-5">
                        <t t-foreach="dashboard_state.customer_data" t-as="customer" t-key="customer.customer_id">
                            <div class="col-lg-3 col-md-6">
                                <div class="lerm-tech-card">
                                    <div class="tech-header" t-on-click="() => this._onCustomerCardClick(customer.customer_id, customer.customer_name)">
                                        <div class="tech-avatar"><i class="fa fa-building"/></div>
                                        <span class="tech-name text-truncate" t-att-title="customer.customer_name">
                                            <t t-esc="customer.customer_name"/>
                                        </span>
                                    </div>

                                    <div class="tech-total-block">
                                        <span class="tech-total-count text-primary"><t t-esc="customer.total_samples"/></span>
                                        <span class="tech-total-label">total samples</span>
                                    </div>

                                    <div class="tech-status-list">
                                        <!-- Shared helper for status rows -->
                                        <t t-foreach="[
                                            {id: 'assignment-pending', label: 'Assignment Pending', icon: 'fa-clipboard', color: '#3b82f6', bg: '#eff6ff', text: '#1e40af', count: customer.assignment_pending},
                                            {id: 'alloted', label: 'Alloted', icon: 'fa-play-circle', color: '#0066ff', bg: '#dbeafe', text: '#1d4ed8', count: customer.alloted},
                                            {id: 'pending-verification', label: 'Verification Pending', icon: 'fa-hourglass-half', color: '#d97706', bg: '#fef3c7', text: '#92400e', count: customer.pending_verification},
                                            {id: 'pending-approval', label: 'Approval Pending', icon: 'fa-clock-o', color: '#dc2626', bg: '#fee2e2', text: '#991b1b', count: customer.pending_approval},
                                            {id: 'in-report', label: 'In Report', icon: 'fa-file-text-o', color: '#16a34a', bg: '#dcfce7', text: '#166534', count: customer.in_report},
                                            {id: 'invoiced', label: 'Invoiced', icon: 'fa-file-powerpoint-o', color: '#059669', bg: '#d1fae5', text: '#065f46', count: customer.invoiced},
                                            {id: 'uninvoiced', label: 'Uninvoiced', icon: 'fa-file-o', color: '#d97706', bg: '#fef3c7', text: '#92400e', count: customer.uninvoiced}
                                        ]" t-as="st" t-key="st.id">
                                            
                                            <t t-set="collapse_id" t-value="st.id + '-' + customer.customer_id"/>
                                            <t t-if="st.count > 0">
                                                <button class="lerm-status-row collapsed" type="button"
                                                        t-att-data-bs-target="'#' + collapse_id"
                                                        data-bs-toggle="collapse" t-att-aria-controls="collapse_id" aria-expanded="false">
                                                    <span class="status-label">
                                                        <i t-attf-class="fa #{st.icon}" t-att-style="'color:' + st.color + ';font-size:0.8rem;'"/>
                                                        <t t-esc="st.label"/>
                                                    </span>
                                                    <span class="status-badge" t-att-style="'background:' + st.bg + ';color:' + st.text + ';'">
                                                        <t t-esc="st.count"/>
                                                        <i class="fa fa-chevron-down" style="font-size:0.65rem;"/>
                                                    </span>
                                                </button>
                                                <div class="collapse" t-att-id="collapse_id">
                                                    <div class="lerm-sub-list">
                                                        <t t-foreach="customer.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                            <!-- Use correct property name from backend product_breakdown_list structure -->
                                                            <t t-set="p_count" t-value="product_data[st.id.replace('-', '_')]"/>
                                                            <t t-if="p_count > 0">
                                                                <div class="lerm-sub-item">
                                                                    <span><t t-esc="product_data.product_name"/></span>
                                                                    <span class="badge" style="background:#e5e7eb;color:#374151;"><t t-esc="p_count"/></span>
                                                                </div>
                                                            </t>
                                                        </t>
                                                    </div>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div class="lerm-status-row" disabled="disabled">
                                                    <span class="status-label">
                                                        <i t-attf-class="fa #{st.icon}" t-att-style="'color:' + st.color + ';font-size:0.8rem;'"/>
                                                        <t t-esc="st.label"/>
                                                    </span>
                                                    <span class="status-badge" style="background:#f3f4f6;color:#9ca3af;">0</span>
                                                </div>
                                            </t>
                                        </t>
                                        <!-- Cancelled (Static) -->
                                        <div class="lerm-status-row" style="cursor:default;opacity:0.6;">
                                            <span class="status-label">
                                                <i class="fa fa-times-circle" style="color:#9ca3af;font-size:0.8rem;"/> Cancelled
                                            </span>
                                            <span class="status-badge" style="background:#f3f4f6;color:#6b7280;">
                                                <t t-esc="customer.cancelled || 0"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>

        </div>
    </t>
</templates>