                                </ul>
                            </div>
                        </div>
                    </div>
                </t>
            </div> -->
                    <!-- 3. Technician Cards -->
        <t t-if="dashboard_state.technician_data.length">
            <div class="row">
                <t t-foreach="dashboard_state.technician_data" t-as="tech" t-key="tech.technician_id">
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="card shadow hover-lift d-flex flex-column" 
                        style="border-radius: 1rem; cursor: pointer; height: 400px;">
                            <div class="card-body d-flex flex-column p-3">
                                <!-- Technician Name and Click Handler -->
                                <h5 class="card-title text-primary border-bottom pb-2 flex-shrink-0" 
                                t-on-click="() => this._onTechnicianCardClick(tech.technician_id)">
                                    <i class="fa fa-user me-2"/> <t t-esc="tech.technician_name"/>
                                </h5>
                                <!-- Total Samples Assigned Block -->
                                <div class="mb-3 flex-shrink-0">
                                    <span class="text-muted small">Total Samples Assigned</span>
                                    <h3 class="fw-bold text-dark mt-1"><t t-esc="tech.total_samples"/></h3>
                                </div>
                                <!-- Scrollable List Container: Removed fixed max-height. flex-grow-1 now consumes remaining vertical space. -->
                                <div class="overflow-y-auto" style="max-height: 250px;">
                                    <ul class="list-group list-group-flush">
                                        
                                        <!-- ALLOTED Status Block -->
                                        <li class="list-group-item p-0">
                                            <t t-set="status_id" t-value="'alloted-' + tech.technician_id"/>
                                            <t t-set="is_collapsible" t-value="tech.alloted > 0"/>
                                            <t t-if="is_collapsible">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 collapsed" type="button" 
                                                    t-att-data-bs-target="'#' + status_id" data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false" style="box-shadow: none;">
                                                    <span><i class="fa fa-play-circle text-primary me-2"/>Alloted</span>
                                                    <span class="badge text-bg-primary d-flex align-items-center">
                                                        <t t-esc="tech.alloted"/>
                                                        <i class="fa fa-chevron-down ms-2" style="font-size: 0.75rem; transition: transform 0.2s;"/>
                                                    </span>
                                                </button>
                                                <div class="collapse" t-att-id="status_id">
                                                    <ul class="list-group list-group-flush ms-3 border-start">
                                                        <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                            <t t-if="product_data.alloted > 0">
                                                                <li class="list-group-item d-flex justify-content-between align-items-center small py-1 px-2">
                                                                    <span class="fw-medium text-dark"><t t-esc="product_data.product_name"/></span>
                                                                    <span class="badge text-bg-secondary"><t t-esc="product_data.alloted"/></span>
                                                                </li>
                                                            </t>
                                                        </t>
                                                    </ul>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 text-muted" type="button" disabled="disabled" style="box-shadow: none; cursor: default;">
                                                    <span><i class="fa fa-play-circle text-primary me-2"/>Alloted</span>
                                                    <span class="badge text-bg-light border text-muted d-flex align-items-center"><t t-esc="tech.alloted || 0"/></span>
                                                </button>
                                            </t>
                                        </li>

                                        <!-- PENDING VERIFICATION Status Block -->
                                        <li class="list-group-item p-0">
                                            <t t-set="status_id" t-value="'pending-verification-' + tech.technician_id"/>
                                            <t t-set="is_collapsible" t-value="tech.pending_verification > 0"/>
                                            <t t-if="is_collapsible">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 collapsed" type="button" 
                                                    t-att-data-bs-target="'#' + status_id" data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false" style="box-shadow: none;">
                                                    <span><i class="fa fa-hourglass-half text-warning me-2"/>Pending Verification</span>
                                                    <span class="badge text-bg-warning d-flex align-items-center">
                                                        <t t-esc="tech.pending_verification"/>
                                                        <i class="fa fa-chevron-down ms-2" style="font-size: 0.75rem; transition: transform 0.2s;"/>
                                                    </span>
                                                </button>
                                                <div class="collapse" t-att-id="status_id">
                                                    <ul class="list-group list-group-flush ms-3 border-start">
                                                        <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                            <t t-if="product_data.pending_verification > 0">
                                                                <li class="list-group-item d-flex justify-content-between align-items-center small py-1 px-2">
                                                                    <span class="fw-medium text-dark"><t t-esc="product_data.product_name"/></span>
                                                                    <span class="badge text-bg-secondary"><t t-esc="product_data.pending_verification"/></span>
                                                                </li>
                                                            </t>
                                                        </t>
                                                    </ul>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 text-muted" type="button" disabled="disabled" style="box-shadow: none; cursor: default;">
                                                    <span><i class="fa fa-hourglass-half text-warning me-2"/>Pending Verification</span>
                                                    <span class="badge text-bg-light border text-muted d-flex align-items-center"><t t-esc="tech.pending_verification || 0"/></span>
                                                </button>
                                            </t>
                                        </li>

                                        <!-- PENDING APPROVAL Status Block -->
                                        <li class="list-group-item p-0">
                                            <t t-set="status_id" t-value="'pending-approval-' + tech.technician_id"/>
                                            <t t-set="is_collapsible" t-value="tech.pending_approval > 0"/>
                                            <t t-if="is_collapsible">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 collapsed" type="button" 
                                                    t-att-data-bs-target="'#' + status_id" data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false" style="box-shadow: none;">
                                                    <span><i class="fa fa-clock-o text-danger me-2"/>Pending Approval</span>
                                                    <span class="badge text-bg-danger d-flex align-items-center">
                                                        <t t-esc="tech.pending_approval"/>
                                                        <i class="fa fa-chevron-down ms-2" style="font-size: 0.75rem; transition: transform 0.2s;"/>
                                                    </span>
                                                </button>
                                                <div class="collapse" t-att-id="status_id">
                                                    <ul class="list-group list-group-flush ms-3 border-start">
                                                        <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                            <t t-if="product_data.pending_approval > 0">
                                                                <li class="list-group-item d-flex justify-content-between align-items-center small py-1 px-2">
                                                                    <span class="fw-medium text-dark"><t t-esc="product_data.product_name"/></span>
                                                                    <span class="badge text-bg-secondary"><t t-esc="product_data.pending_approval"/></span>
                                                                </li>
                                                            </t>
                                                        </t>
                                                    </ul>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 text-muted" type="button" disabled="disabled" style="box-shadow: none; cursor: default;">
                                                    <span><i class="fa fa-clock-o text-danger me-2"/>Pending Approval</span>
                                                    <span class="badge text-bg-light border text-muted d-flex align-items-center"><t t-esc="tech.pending_approval || 0"/></span>
                                                </button>
                                            </t>
                                        </li>

                                        <!-- IN REPORT Status Block -->
                                        <li class="list-group-item p-0">
                                            <t t-set="status_id" t-value="'in-report-' + tech.technician_id"/>
                                            <t t-set="is_collapsible" t-value="tech.in_report > 0"/>
                                            <t t-if="is_collapsible">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 collapsed" type="button" 
                                                    t-att-data-bs-target="'#' + status_id" data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false" style="box-shadow: none;">
                                                    <span><i class="fa fa-file-text-o text-success me-2"/>In Report</span>
                                                    <span class="badge text-bg-success d-flex align-items-center">
                                                        <t t-esc="tech.in_report"/>
                                                        <i class="fa fa-chevron-down ms-2" style="font-size: 0.75rem; transition: transform 0.2s;"/>
                                                    </span>
                                                </button>
                                                <div class="collapse" t-att-id="status_id">
                                                    <ul class="list-group list-group-flush ms-3 border-start">
                                                        <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                            <t t-if="product_data.in_report > 0">
                                                                <li class="list-group-item d-flex justify-content-between align-items-center small py-1 px-2">
                                                                    <span class="fw-medium text-dark"><t t-esc="product_data.product_name"/></span>
                                                                    <span class="badge text-bg-secondary"><t t-esc="product_data.in_report"/></span>
                                                                </li>
                                                            </t>
                                                        </t>
                                                    </ul>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center py-2 text-muted" type="button" disabled="disabled" style="box-shadow: none; cursor: default;">
                                                    <span><i class="fa fa-file-text-o text-success me-2"/>In Report</span>
                                                    <span class="badge text-bg-light border text-muted d-flex align-items-center"><t t-esc="tech.in_report || 0"/></span>
                                                </button>
                                            </t>
                                        </li>

                                        <!-- CANCELLED Status Block (Non-collapsible) -->
                                        <li class="list-group-item d-flex justify-content-between align-items-center small text-muted py-2 px-0">
                                            <span><i class="fa fa-times-circle me-2"/>Cancelled</span>
                                            <span class="badge text-bg-light border"><t t-esc="tech.cancelled || 0"/></span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
        <t t-else="">
            <div class="alert alert-info mt-3 text-center" role="alert"><i class="fa fa-info-circle me-2"/> No technician data found. </div>
        </t>

            <!-- Charts -->
            <div class="row g-4 mt-5">
                <div class="col-md-6">
                    <div class="card shadow-sm rounded-3 h-100 border-0">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Samples Over Time</h6>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" t-on-click="() => this.switchTimeChart('line')">Line</button>
                                <button class="btn btn-outline-secondary" t-on-click="() => this.switchTimeChart('bar')">Bar</button>
                                <button class="btn btn-outline-secondary" t-on-click="() => this.switchTimeChart('pie')">Pie</button>
                            </div>
                        </div>
                        <div class="card-body text-center" style="height:350px;">
                            <canvas t-ref="chartCanvas"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm rounded-3 h-100 border-0">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Samples by State</h6>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" t-on-click="() => this.switchStateChart('line')">Line</button>
                                <button class="btn btn-outline-secondary" t-on-click="() => this.switchStateChart('bar')">Bar</button>
                                <button class="btn btn-outline-secondary" t-on-click="() => this.switchStateChart('pie')">Pie</button>
                            </div>
                        </div>
                        <div class="card-body text-center" style="height:350px;">
                            <canvas t-ref="stateChartCanvas"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
