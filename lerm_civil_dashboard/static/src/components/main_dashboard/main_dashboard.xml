<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="lerm_civil_dashboard.MainDashboard" owl="1">
        <div class="lerm-dashboard scrollable-dashboard container-fluid py-4">

            <!-- KPI CARDS -->
            <div class="row g-3 mb-4 px-1">
                <t t-foreach="this.kpiData" t-as="kpi" t-key="kpi.state">
                    <div class="col-6 col-md-4 col-lg">
                        <div class="lerm-kpi-card"
                             t-on-click="() => kpi.isTotal ? null : this.onKpiClick(kpi.state)">
                            <div class="kpi-accent-bar" t-att-style="'background: ' + kpi.color"/>
                            <i t-attf-class="fa #{kpi.icon} kpi-icon" t-att-style="'color: ' + kpi.color"/>
                            <div class="kpi-count" t-att-style="'color: ' + kpi.color" t-esc="kpi.count"/>
                            <div class="kpi-label"><t t-esc="kpi.state_label"/></div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- FILTER PANEL -->
            <div class="lerm-filter-panel mb-4">
                <div class="panel-heading">
                    <i class="fa fa-sliders"/>
                    <h6>Dashboard Filters</h6>
                </div>

                <div class="lerm-date-section">
                    <!-- Row 1: Company | Lab | Discipline -->
                    <div class="row g-3 mb-4 align-items-end">
                        <div class="col-lg-3 col-md-6">
                            <label class="lerm-field-label">Company</label>
                            <select class="lerm-select" t-on-change="_onCompanyFilter">
                                <option value="ALL">All Companies</option>
                                <t t-foreach="this.dashboard_state.companies" t-as="company" t-key="company.id">
                                    <option t-att-value="company.id" t-att-selected="this.filter_state.activeCompany == company.id">
                                        <t t-esc="company.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="lerm-field-label">Lab</label>
                            <select class="lerm-select" t-on-change="_onLabFilter">
                                <option value="ALL">All Labs</option>
                                <t t-foreach="this.filteredLabs" t-as="lab" t-key="lab.id">
                                    <option t-att-value="lab.id" t-att-selected="this.filter_state.activeLab == lab.id">
                                        <t t-esc="lab.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-lg-5">
                            <label class="lerm-field-label">Discipline</label>
                            <div class="lerm-btn-group">
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="ALL"
                                        t-att-style="this.filter_state.activeDiscipline === 'ALL' ? 'background:#0066ff;color:#fff;' : ''">ALL</button>
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="MECHANICAL"
                                        t-att-style="this.filter_state.activeDiscipline === 'MECHANICAL' ? 'background:#0066ff;color:#fff;' : ''">Mechanical</button>
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="NDT"
                                        t-att-style="this.filter_state.activeDiscipline === 'NDT' ? 'background:#0066ff;color:#fff;' : ''">NDT</button>
                                <button class="lerm-toggle-btn" t-on-click="_onDisciplineFilter" data-discipline="CHEMICAL"
                                        t-att-style="this.filter_state.activeDiscipline === 'CHEMICAL' ? 'background:#0066ff;color:#fff;' : ''">Chemical</button>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Date Range -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa fa-calendar" style="color:#5d3a9b;font-size:0.85rem;"/>
                        <span class="date-label">Date Range</span>
                    </div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="lerm-btn-group" style="width:auto; flex-shrink:0;">
                            <button class="lerm-toggle-btn" style="padding:0.4rem 1rem;" t-on-click="_onDateFilter" data-days="30"
                                    t-att-style="filter_state.activeDays == 30 ? 'background:#0066ff;color:#fff;' : ''">30 days</button>
                            <button class="lerm-toggle-btn" style="padding:0.4rem 1rem;" t-on-click="_onDateFilter" data-days="180"
                                    t-att-style="filter_state.activeDays == 180 ? 'background:#0066ff;color:#fff;' : ''">180 days</button>
                            <button class="lerm-toggle-btn" style="padding:0.4rem 1rem;" t-on-click="_onDateFilter" data-days="365"
                                    t-att-style="filter_state.activeDays == 365 ? 'background:#0066ff;color:#fff;' : ''">365 days</button>
                        </div>
                        <div class="lerm-custom-date-container d-flex align-items-center gap-2 px-2 py-1 rounded" style="background:#fff;border:1px solid #e0d9f3;">
                            <span class="lerm-date-separator">From</span>
                            <input type="date" class="lerm-date-input"
                                   t-att-value="filter_state.start_date" t-on-change="_onDateInputChange" data-field="start_date"/>
                            <span class="lerm-date-separator">To</span>
                            <input type="date" class="lerm-date-input"
                                   t-att-value="filter_state.end_date" t-on-change="_onDateInputChange" data-field="end_date"/>
                            <button class="lerm-refresh-btn" t-on-click="_onCustomDate" title="Apply range">
                                <i class="fa fa-search" style="font-size:0.75rem;"/>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SAMPLE AGING OVERVIEW -->
            <div class="lerm-section-header mt-4">
                <i class="fa fa-clock-o"/>
                <h2>Reports Due Overview</h2>
            </div>
            <div class="row g-3 mb-4 px-1">
                <t t-foreach="this.agingKpiData" t-as="kpi" t-key="kpi.key">
                    <div class="col-6 col-md-4 col-lg">
                        <div class="lerm-kpi-card"
                             t-on-click="() => this.onAgingClick(kpi.key, null, null, kpi.mode)">
                            <div class="kpi-accent-bar" t-att-style="'background: ' + kpi.color"/>
                            <i t-attf-class="fa #{kpi.icon} kpi-icon" t-att-style="'color: ' + kpi.color"/>
                            <div class="kpi-count" t-att-style="'color: ' + kpi.color" t-esc="kpi.count"/>
                            <div class="kpi-label"><t t-esc="kpi.label"/></div>
                            
                            <!-- State Breakdown (with Collapsible Technician Breakdown) -->
                            <div class="mt-3 w-100 px-1" t-if="kpi.states.length">
                                <hr class="my-2" style="opacity: 0.15;"/>
                                <div class="d-flex flex-column gap-1" style="max-height: 200px; overflow-y: auto; scrollbar-width: thin;">
                                    <t t-foreach="kpi.states" t-as="state" t-key="state.key">
                                        <t t-set="collapse_id" t-value="'collapse-' + kpi.key.replace('+', '-plus') + '-' + state.key"/>
                                        
                                        <!-- State Row (Toggle) -->
                                        <div class="lerm-status-row py-1 px-2 rounded d-flex justify-content-between align-items-center" 
                                             t-att-data-bs-target="'#' + collapse_id" data-bs-toggle="collapse"
                                             t-on-click.stop=""
                                             style="cursor: pointer; transition: background 0.15s;">
                                            <span class="status-label d-flex align-items-center gap-2" style="font-size: 0.72rem;">
                                                <i t-attf-class="fa #{state.icon}" t-att-style="'color: ' + state.color + '; font-size: 0.75rem;'"/>
                                                <span class="text-truncate" t-att-title="state.label"><t t-esc="state.label"/></span>
                                            </span>
                                            <span class="status-badge px-2 py-0 d-flex align-items-center gap-1" 
                                                  t-att-style="'background: ' + state.color + '20; color: ' + state.color + '; font-size: 0.7rem; font-weight: 700; border-radius: 10px; min-width: 24px; text-align: center;'">
                                                <t t-esc="state.count"/>
                                                <i class="fa fa-chevron-down" style="font-size: 0.6rem; opacity: 0.7;"/>
                                            </span>
                                        </div>

                                        <!-- Technician Breakdown (Collapse) -->
                                        <div class="collapse" t-att-id="collapse_id">
                                            <div class="lerm-sub-list ms-2 border-start ps-2 my-1" style="border-color: #e5e7eb !important;">
                                                <t t-foreach="state.breakdown" t-as="tech" t-key="tech.id">
                                                    <div class="lerm-sub-item d-flex justify-content-between align-items-center py-1 rounded" 
                                                         t-on-click.stop="() => this.onAgingClick(kpi.key, state.key, tech.id)"
                                                         style="cursor: pointer; font-size: 0.68rem; padding: 0.2rem 0.5rem; transition: background 0.1s;">
                                                        <span class="text-muted text-truncate" t-att-title="tech.name"><t t-esc="tech.name"/></span>
                                                        <span class="badge rounded-pill bg-light text-dark border" style="font-size: 0.65rem;"><t t-esc="tech.count"/></span>
                                                    </div>
                                                </t>
                                                <!-- "View All" option for the state -->
                                                <div class="lerm-sub-item d-flex justify-content-center py-1 mt-1 rounded bg-light-subtle border"
                                                     t-on-click.stop="() => this.onAgingClick(kpi.key, state.key)"
                                                     style="cursor: pointer; font-size: 0.65rem; color: #4b5563; font-weight: 600;">
                                                    View All <t t-esc="state.label"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            
            <!-- REPORTS OVERDUE OVERVIEW -->
            <div class="lerm-section-header mt-4">
                <i class="fa fa-warning text-danger"/>
                <h2 class="text-danger">Reports Overdue Overview</h2>
            </div>
            <div class="row g-3 mb-4 px-1">
                <t t-foreach="this.overdueKpiData" t-as="kpi" t-key="kpi.key">
                    <div class="col-6 col-md-4 col-lg">
                        <div class="lerm-kpi-card border-danger-subtle"
                             t-on-click="() => this.onAgingClick(kpi.key, null, null, kpi.mode)">
                            <div class="kpi-accent-bar bg-danger"/>
                            <i t-attf-class="fa #{kpi.icon} kpi-icon text-danger"/>
                            <div class="kpi-count text-danger" t-esc="kpi.count"/>
                            <div class="kpi-label"><t t-esc="kpi.label"/></div>
                            
                            <!-- State Breakdown -->
                            <div class="mt-3 w-100 px-1" t-if="kpi.states.length">
                                <hr class="my-2" style="opacity: 0.15;"/>
                                <div class="d-flex flex-column gap-1" style="max-height: 200px; overflow-y: auto; scrollbar-width: thin;">
                                    <t t-foreach="kpi.states" t-as="state" t-key="state.key">
                                        <t t-set="collapse_id" t-value="'collapse-overdue-' + kpi.key.replace('+', '-plus') + '-' + state.key"/>
                                        
                                        <!-- State Row -->
                                        <div class="lerm-status-row py-1 px-2 rounded d-flex justify-content-between align-items-center" 
                                             t-att-data-bs-target="'#' + collapse_id" data-bs-toggle="collapse"
                                             t-on-click.stop=""
                                             style="cursor: pointer;">
                                            <span class="status-label d-flex align-items-center gap-2" style="font-size: 0.72rem;">
                                                <i t-attf-class="fa #{state.icon}" t-att-style="'color: ' + state.color + '; font-size: 0.75rem;'"/>
                                                <span class="text-truncate" t-att-title="state.label"><t t-esc="state.label"/></span>
                                            </span>
                                            <span class="status-badge px-2 py-0 d-flex align-items-center gap-1" 
                                                  t-att-style="'background: ' + state.color + '20; color: ' + state.color + '; font-size: 0.7rem; font-weight: 700; border-radius: 10px;'">
                                                <t t-esc="state.count"/>
                                                <i class="fa fa-chevron-down" style="font-size: 0.6rem; opacity: 0.7;"/>
                                            </span>
                                        </div>

                                        <!-- Technician Breakdown -->
                                        <div class="collapse" t-att-id="collapse_id">
                                            <div class="lerm-sub-list ms-2 border-start ps-2 my-1">
                                                <t t-foreach="state.breakdown" t-as="tech" t-key="tech.id">
                                                    <div class="lerm-sub-item d-flex justify-content-between align-items-center py-1 rounded" 
                                                         t-on-click.stop="() => this.onAgingClick(kpi.key, state.key, tech.id, kpi.mode)"
                                                         style="cursor: pointer; font-size: 0.68rem; padding: 0.2rem 0.5rem;">
                                                        <span class="text-muted text-truncate" t-att-title="tech.name"><t t-esc="tech.name"/></span>
                                                        <span class="badge rounded-pill bg-light text-dark border" style="font-size: 0.65rem;"><t t-esc="tech.count"/></span>
                                                    </div>
                                                </t>
                                                <div class="lerm-sub-item d-flex justify-content-center py-1 mt-1 rounded bg-light-subtle border"
                                                     t-on-click.stop="() => this.onAgingClick(kpi.key, state.key, null, kpi.mode)"
                                                     style="cursor: pointer; font-size: 0.65rem; color: #4b5563; font-weight: 600;">
                                                    View All <t t-esc="state.label"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- TECHNICIAN SAMPLE OVERVIEW -->
            <div class="lerm-section-header mt-4">
                <i class="fa fa-users"/>
                <h2>Technician Sample Overview</h2>
            </div>

            <t t-if="dashboard_state.technician_data.length">
                <div class="row g-3">
                    <t t-foreach="dashboard_state.technician_data" t-as="tech" t-key="tech.technician_id">
                        <div class="col-lg-3 col-md-6">
                            <div class="lerm-tech-card">

                                <div class="tech-header" t-on-click="() => this._onTechnicianCardClick(tech.technician_id)">
                                    <div class="tech-avatar"><i class="fa fa-user"/></div>
                                    <span class="tech-name"><t t-esc="tech.technician_name"/></span>
                                </div>

                                <div class="tech-total-block">
                                    <span class="tech-total-count"><t t-esc="tech.total_samples"/></span>
                                    <span class="tech-total-label">total samples assigned</span>
                                </div>

                                <div class="tech-status-list">

                                    <!-- ALLOTED -->
                                    <t t-set="status_id" t-value="'alloted-' + tech.technician_id"/>
                                    <t t-if="tech.alloted > 0">
                                        <button class="lerm-status-row collapsed" type="button"
                                                t-att-data-bs-target="'#' + status_id"
                                                data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false">
                                            <span class="status-label">
                                                <i class="fa fa-play-circle" style="color:#0066ff;font-size:0.8rem;"/>
                                                Alloted
                                            </span>
                                            <span class="status-badge" style="background:#dbeafe;color:#1d4ed8;">
                                                <t t-esc="tech.alloted"/>
                                                <i class="fa fa-chevron-down" style="font-size:0.65rem;"/>
                                            </span>
                                        </button>
                                        <div class="collapse" t-att-id="status_id">
                                            <div class="lerm-sub-list">
                                                <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                    <t t-if="product_data.alloted > 0">
                                                        <div class="lerm-sub-item" style="cursor: pointer; transition: background 0.1s;"
                                                             t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '2-alloted', product_data.product_id)">
                                                            <span><t t-esc="product_data.product_name"/></span>
                                                            <span class="badge" style="background:#e5e7eb;color:#374151;"><t t-esc="product_data.alloted"/></span>
                                                        </div>
                                                    </t>
                                                </t>
                                                <div class="lerm-sub-item d-flex justify-content-center py-1 mt-1 rounded bg-light-subtle border"
                                                     t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '2-alloted')"
                                                     style="cursor: pointer; font-size: 0.65rem; color: #4b5563; font-weight: 600;">
                                                    View All Alloted
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="lerm-status-row" disabled="disabled">
                                            <span class="status-label">
                                                <i class="fa fa-play-circle" style="color:#0066ff;font-size:0.8rem;"/>Alloted
                                            </span>
                                            <span class="status-badge" style="background:#f3f4f6;color:#9ca3af;">0</span>
                                        </div>
                                    </t>

                                    <!-- PENDING VERIFICATION -->
                                    <t t-set="status_id" t-value="'pending-verification-' + tech.technician_id"/>
                                    <t t-if="tech.pending_verification > 0">
                                        <button class="lerm-status-row collapsed" type="button"
                                                t-att-data-bs-target="'#' + status_id"
                                                data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false">
                                            <span class="status-label">
                                                <i class="fa fa-hourglass-half" style="color:#d97706;font-size:0.8rem;"/>
                                                Pending Verification
                                            </span>
                                            <span class="status-badge" style="background:#fef3c7;color:#92400e;">
                                                <t t-esc="tech.pending_verification"/>
                                                <i class="fa fa-chevron-down" style="font-size:0.65rem;"/>
                                            </span>
                                        </button>
                                        <div class="collapse" t-att-id="status_id">
                                            <div class="lerm-sub-list">
                                                <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                    <t t-if="product_data.pending_verification > 0">
                                                        <div class="lerm-sub-item" style="cursor: pointer; transition: background 0.1s;"
                                                             t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '3-pending_verification', product_data.product_id)">
                                                            <span><t t-esc="product_data.product_name"/></span>
                                                            <span class="badge" style="background:#e5e7eb;color:#374151;"><t t-esc="product_data.pending_verification"/></span>
                                                        </div>
                                                    </t>
                                                </t>
                                                <div class="lerm-sub-item d-flex justify-content-center py-1 mt-1 rounded bg-light-subtle border"
                                                     t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '3-pending_verification')"
                                                     style="cursor: pointer; font-size: 0.65rem; color: #4b5563; font-weight: 600;">
                                                    View All Pending Verification
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="lerm-status-row" disabled="disabled">
                                            <span class="status-label">
                                                <i class="fa fa-hourglass-half" style="color:#d97706;font-size:0.8rem;"/>Pending Verification
                                            </span>
                                            <span class="status-badge" style="background:#f3f4f6;color:#9ca3af;">0</span>
                                        </div>
                                    </t>

                                    <!-- PENDING APPROVAL -->
                                    <t t-set="status_id" t-value="'pending-approval-' + tech.technician_id"/>
                                    <t t-if="tech.pending_approval > 0">
                                        <button class="lerm-status-row collapsed" type="button"
                                                t-att-data-bs-target="'#' + status_id"
                                                data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false">
                                            <span class="status-label">
                                                <i class="fa fa-clock-o" style="color:#dc2626;font-size:0.8rem;"/>
                                                Pending Approval
                                            </span>
                                            <span class="status-badge" style="background:#fee2e2;color:#991b1b;">
                                                <t t-esc="tech.pending_approval"/>
                                                <i class="fa fa-chevron-down" style="font-size:0.65rem;"/>
                                            </span>
                                        </button>
                                        <div class="collapse" t-att-id="status_id">
                                            <div class="lerm-sub-list">
                                                <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                    <t t-if="product_data.pending_approval > 0">
                                                        <div class="lerm-sub-item" style="cursor: pointer; transition: background 0.1s;"
                                                             t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '5-pending_approval', product_data.product_id)">
                                                            <span><t t-esc="product_data.product_name"/></span>
                                                            <span class="badge" style="background:#e5e7eb;color:#374151;"><t t-esc="product_data.pending_approval"/></span>
                                                        </div>
                                                    </t>
                                                </t>
                                                <div class="lerm-sub-item d-flex justify-content-center py-1 mt-1 rounded bg-light-subtle border"
                                                     t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '5-pending_approval')"
                                                     style="cursor: pointer; font-size: 0.65rem; color: #4b5563; font-weight: 600;">
                                                    View All Pending Approval
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="lerm-status-row" disabled="disabled">
                                            <span class="status-label">
                                                <i class="fa fa-clock-o" style="color:#dc2626;font-size:0.8rem;"/>Pending Approval
                                            </span>
                                            <span class="status-badge" style="background:#f3f4f6;color:#9ca3af;">0</span>
                                        </div>
                                    </t>

                                    <!-- IN REPORT -->
                                    <t t-set="status_id" t-value="'in-report-' + tech.technician_id"/>
                                    <t t-if="tech.in_report > 0">
                                        <button class="lerm-status-row collapsed" type="button"
                                                t-att-data-bs-target="'#' + status_id"
                                                data-bs-toggle="collapse" t-att-aria-controls="status_id" aria-expanded="false">
                                            <span class="status-label">
                                                <i class="fa fa-file-text-o" style="color:#16a34a;font-size:0.8rem;"/>
                                                In Report
                                            </span>
                                            <span class="status-badge" style="background:#dcfce7;color:#166534;">
                                                <t t-esc="tech.in_report"/>
                                                <i class="fa fa-chevron-down" style="font-size:0.65rem;"/>
                                            </span>
                                        </button>
                                        <div class="collapse" t-att-id="status_id">
                                            <div class="lerm-sub-list">
                                                <t t-foreach="tech.product_breakdown" t-as="product_data" t-key="product_data.product_id">
                                                    <t t-if="product_data.in_report > 0">
                                                        <div class="lerm-sub-item" style="cursor: pointer; transition: background 0.1s;"
                                                             t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '4-in_report', product_data.product_id)">
                                                            <span><t t-esc="product_data.product_name"/></span>
                                                            <span class="badge" style="background:#e5e7eb;color:#374151;"><t t-esc="product_data.in_report"/></span>
                                                        </div>
                                                    </t>
                                                </t>
                                                <div class="lerm-sub-item d-flex justify-content-center py-1 mt-1 rounded bg-light-subtle border"
                                                     t-on-click.stop="() => this._onTechnicianDetailsClick(tech.technician_id, '4-in_report')"
                                                     style="cursor: pointer; font-size: 0.65rem; color: #4b5563; font-weight: 600;">
                                                    View All In Report
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="lerm-status-row" disabled="disabled">
                                            <span class="status-label">
                                                <i class="fa fa-file-text-o" style="color:#16a34a;font-size:0.8rem;"/>In Report
                                            </span>
                                            <span class="status-badge" style="background:#f3f4f6;color:#9ca3af;">0</span>
                                        </div>
                                    </t>

                                    <!-- CANCELLED -->
                                    <t t-if="tech.cancelled > 0">
                                        <button class="lerm-status-row" type="button"
                                                t-on-click="() => this._onTechnicianDetailsClick(tech.technician_id, '6-cancelled')"
                                                style="opacity:0.8; cursor: pointer;">
                                            <span class="status-label">
                                                <i class="fa fa-times-circle" style="color:#9ca3af;font-size:0.8rem;"/>
                                                Cancelled
                                            </span>
                                            <span class="status-badge" style="background:#f3f4f6;color:#6b7280;">
                                                <t t-esc="tech.cancelled"/>
                                            </span>
                                        </button>
                                    </t>
                                    <t t-else="">
                                        <div class="lerm-status-row" style="cursor:default;opacity:0.6;">
                                            <span class="status-label">
                                                <i class="fa fa-times-circle" style="color:#9ca3af;font-size:0.8rem;"/>
                                                Cancelled
                                            </span>
                                            <span class="status-badge" style="background:#f3f4f6;color:#6b7280;">0</span>
                                        </div>
                                    </t>

                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
            <t t-else="">
                <div class="lerm-empty-state">
                    <i class="fa fa-info-circle me-2"/>No technician data found for the selected filters.
                </div>
            </t>

            <!-- CHARTS -->
            <div class="lerm-section-header mt-5">
                <i class="fa fa-bar-chart"/>
                <h2>Analytics</h2>
            </div>

            <div class="row g-3 mb-5">
                <div class="col-md-6">
                    <div class="lerm-chart-card">
                        <div class="chart-header">
                            <h6 class="chart-title">Samples Over Time</h6>
                            <div class="chart-toggle-group">
                                <button class="btn" t-on-click="() => this.switchTimeChart('line')">
                                    <i class="fa fa-line-chart me-1"/>Line
                                </button>
                                <button class="btn" t-on-click="() => this.switchTimeChart('bar')">
                                    <i class="fa fa-bar-chart me-1"/>Bar
                                </button>
                                <button class="btn" t-on-click="() => this.switchTimeChart('pie')">
                                    <i class="fa fa-pie-chart me-1"/>Pie
                                </button>
                            </div>
                        </div>
                        <div class="chart-body">
                            <canvas t-ref="chartCanvas" style="width:100%;height:100%;"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="lerm-chart-card">
                        <div class="chart-header">
                            <h6 class="chart-title">Samples by State</h6>
                            <div class="chart-toggle-group">
                                <button class="btn" t-on-click="() => this.switchStateChart('line')">
                                    <i class="fa fa-line-chart me-1"/>Line
                                </button>
                                <button class="btn" t-on-click="() => this.switchStateChart('bar')">
                                    <i class="fa fa-bar-chart me-1"/>Bar
                                </button>
                                <button class="btn" t-on-click="() => this.switchStateChart('pie')">
                                    <i class="fa fa-pie-chart me-1"/>Pie
                                </button>
                            </div>
                        </div>
                        <div class="chart-body">
                            <canvas t-ref="stateChartCanvas" style="width:100%;height:100%;"/>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>