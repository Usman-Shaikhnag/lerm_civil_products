<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="lerm_civil_dashboard.MainDashboard" owl="1">
        <div class="scrollable-dashboard container-fluid py-4 bg-light">
            
            <!-- KPI Section -->
            <div class="row g-3 mb-5 justify-content-center">
                <div class="col-12 text-center">
                    <div class="d-flex flex-wrap justify-content-center gap-4">
                        <!-- Total Samples -->
                        <div class="kpi-card">
    <div class="kpi-icon bg-primary">
        <i class="fa fa-flask"/>
    </div>
    <div class="kpi-content">
        <div class="kpi-number" t-esc="this.dashboard_state.projects_count"/>
        <div class="kpi-title">Total Samples</div>
    </div>
</div>

                        <!-- Dynamic States -->
                        <t t-foreach="this.dashboard_state.state_data" t-as="item" t-key="item.state">
                            <div class="kpi-card clickable"
     t-on-click="() => this.onKpiClick(item.state)">
                                <div class="kpi-icon bg-success">
    <i class="fa fa-tasks"/>
</div>

<div class="kpi-content">
    <div class="kpi-number" t-esc="item.count"/>
    <div class="kpi-title" t-esc="item.state_label"/>
</div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Match Reference Filter UI -->
            <div class="card shadow-sm border-0 mb-4 rounded-3 bg-white">
                <div class="card-body p-4">
                    <!-- Title -->
                    <div class="d-flex align-items-center mb-4">
                        <i class="fa fa-filter me-2" style="color: #5d3a9b; font-size: 1.1rem;"/>
                        <h6 class="mb-0 fw-bold" style="color: #5d3a9b; letter-spacing: 0.8px; font-size: 0.9rem;">DASHBOARD FILTERS</h6>
                    </div>

                    <!-- Row 1: Company | Lab | Discipline -->
                    <div class="row g-4 mb-4 align-items-end">
                        <div class="col-lg-3 col-md-6">
                            <label class="fw-bold mb-2 d-block" style="color: #333; font-size: 0.85rem;">COMPANY</label>
                            <select class="form-select border-start-0 border-end-0 border-top-0 rounded-0 bg-transparent px-0" style="font-size: 0.9rem; border-bottom: 1px solid #ced4da;" t-on-change="_onCompanyFilter">
                                <option value="ALL">All Companies</option>
                                <t t-foreach="this.dashboard_state.companies" t-as="company" t-key="company.id">
                                    <option t-att-value="company.id" t-att-selected="this.filter_state.activeCompany == company.id">
                                        <t t-esc="company.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="fw-bold mb-2 d-block" style="color: #333; font-size: 0.85rem;">LAB</label>
                            <select class="form-select border-start-0 border-end-0 border-top-0 rounded-0 bg-transparent px-0" style="font-size: 0.9rem; border-bottom: 1px solid #ced4da;" t-on-change="_onLabFilter">
                                <option value="ALL">All Labs</option>
                                <t t-foreach="this.filteredLabs" t-as="lab" t-key="lab.id">
                                    <option t-att-value="lab.id" t-att-selected="this.filter_state.activeLab == lab.id">
                                        <t t-esc="lab.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-lg-5">
                            <label class="fw-bold mb-2 d-block" style="color: #333; font-size: 0.85rem;">DISCIPLINE</label>
                            <div class="btn-group w-100 shadow-sm" style="border: 1px solid #5d3a9b; border-radius: 4px; overflow: hidden;">
                                <button class="btn btn-sm border-0 py-2" t-on-click="_onDisciplineFilter" data-discipline="ALL"
                                        t-att-style="this.filter_state.activeDiscipline === 'ALL' ? 'background: #007bff; color: white;' : 'background: white; color: #5d3a9b;'">ALL</button>
                                <button class="btn btn-sm border-0 py-2" t-on-click="_onDisciplineFilter" data-discipline="MECHANICAL"
                                        t-att-style="this.filter_state.activeDiscipline === 'MECHANICAL' ? 'background: #007bff; color: white;' : 'background: white; color: #5d3a9b;'">MECH</button>
                                <button class="btn btn-sm border-0 py-2 border-start" t-on-click="_onDisciplineFilter" data-discipline="NDT"
                                        t-att-style="this.filter_state.activeDiscipline === 'NDT' ? 'background: #007bff; color: white;' : 'background: white; color: #5d3a9b;'">NDT</button>
                                <button class="btn btn-sm border-0 py-2 border-start" t-on-click="_onDisciplineFilter" data-discipline="CHEMICAL"
                                        t-att-style="this.filter_state.activeDiscipline === 'CHEMICAL' ? 'background: #007bff; color: white;' : 'background: white; color: #5d3a9b;'">CHEM</button>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Date Range Presets -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa fa-calendar me-2" style="color: #5d3a9b;"/>
                            <label class="small fw-bold mb-0 text-uppercase" style="color: #5d3a9b; letter-spacing: 0.5px;">DATE RANGE</label>
                        </div>
                        <div class="btn-group shadow-sm" style="border: 1px solid #5d3a9b; border-radius: 4px; overflow: hidden; width: fit-content; min-width: 60%;">
                            <button t-attf-class="btn btn-sm border-0 py-2 px-5 #{filter_state.activeDays == 30 ? 'active' : ''}"
                                    t-att-style="filter_state.activeDays == 30 ? 'background: #007bff; color: white;' : 'background: white; color: #5d3a9b;'"
                                    t-on-click="_onDateFilter" data-days="30">30 Days</button>
                            <button t-attf-class="btn btn-sm border-0 py-2 px-5 border-start #{filter_state.activeDays == 180 ? 'active' : ''}"
                                    t-att-style="filter_state.activeDays == 180 ? 'background: #007bff; color: white;' : 'background: white; color: #5d3a9b;'"
                                    t-on-click="_onDateFilter" data-days="180">180 Days</button>
                            <button t-attf-class="btn btn-sm border-0 py-2 px-5 border-start #{filter_state.activeDays == 365 ? 'active' : ''}"
                                    t-att-style="filter_state.activeDays == 365 ? 'background: #007bff; color: white;' : 'background: white; color: #5d3a9b;'"
                                    t-on-click="_onDateFilter" data-days="365">365 Days</button>
                        </div>
                    </div>

                    <!-- Row 3: Custom Date Selector -->
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="fa fa-th me-2" style="color: #5d3a9b;"/>
                            <label class="small fw-bold mb-0 text-uppercase" style="color: #5d3a9b; letter-spacing: 0.5px;">DATE RANGE</label>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="flex-grow-0" style="min-width: 250px;">
                                <select class="form-select border shadow-sm py-2" style="font-size: 0.9rem;" t-on-change="_onDateFilter" t-att-value="filter_state.activeDays">
                                    <option value="30" t-att-selected="filter_state.activeDays == 30">30 Days</option>
                                    <option value="180" t-att-selected="filter_state.activeDays == 180">180 Days</option>
                                    <option value="365" t-att-selected="filter_state.activeDays == 365">365 Days</option>
                                </select>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-grow-1 bg-white p-2 rounded shadow-sm border">
                                <span class="small fw-bold text-muted px-2">FROM</span>
                                <input type="date" t-att-value="filter_state.start_date" t-on-change="_onDateInputChange"
                                        data-field="start_date" class="form-control border-0 p-0" style="font-size: 0.9rem;"/>
                                <span class="small fw-bold text-muted px-2">TO</span>
                                <input type="date" t-att-value="filter_state.end_date" t-on-change="_onDateInputChange"
                                        data-field="end_date" class="form-control border-0 p-0" style="font-size: 0.9rem;"/>
                                <button class="btn btn-primary d-flex align-items-center justify-content-center" t-on-click="_onCustomDate" style="width: 32px; height: 32px;">
                                    <i class="fa fa-refresh"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Technician Samples Overview -->
            <h2 class="mb-4 mt-5 border-top pt-4 text-primary text-center">Technician Sample Overview</h2>

            <!-- <div t-if="dashboard_state.technician_data.length" class="row">
                <t t-foreach="dashboard_state.technician_data" t-as="tech" t-key="tech.technician_id">
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="card shadow hover-lift h-100" 
                             style="border-radius: 1rem; cursor: pointer;" 
                             t-on-click="() => this._onTechnicianCardClick(tech.technician_id)">
                            <div class="card-body">
                                <h5 class="card-title text-primary border-bottom pb-2">
                                    <i class="fa fa-user me-2"/> <t t-esc="tech.technician_name"/>
                                </h5>
                                <div class="mb-3">
                                    <span class="text-muted small">Total Samples Assigned</span>
                                    <h3 class="fw-bold text-dark mt-1"><t t-esc="tech.total_samples"/></h3>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                                        <span><i class="fa fa-play-circle text-primary me-2"/>Alloted</span>
                                        <span class="badge text-bg-primary"><t t-esc="tech.alloted"/></span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                                        <span><i class="fa fa-hourglass-half text-warning me-2"/>Pending Verification</span>
                                        <span class="badge text-bg-warning"><t t-esc="tech.pending_verification"/></span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                                        <span><i class="fa fa-clock-o text-danger me-2"/>Pending Approval</span>
                                        <span class="badge text-bg-danger"><t t-esc="tech.pending_approval"/></span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center small">
                                        <span><i class="fa fa-file-text-o text-success me-2"/>In Report</span>
                                        <span class="badge text-bg-success"><t t-esc="tech.in_report"/></span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center small text-muted">
