<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="concrete_cylinder_datasheet">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.mechanical_data_sheet_header">
				
				<div style="text-align:center;font-size:18px">
                    Concrete Cylinder
                </div>
				<div class="container_eln" style="margin-top:5px">

                   
                    <div style="margin-top:20px">
                        <table style="margin-top:20px">
                            <tr cols="12">
					
                                <td colspan="6">Job No :
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="eln.kes_no"></span>
                                </td>
                                <td colspan="6">Test Start Date: 
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="eln.start_date"></span>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">Material: <span t-field="eln.material"></span>
                                </td>
                                <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                                </td>
                            </tr>
                            <tr style="height:50px" cols="12">
                                <td colspan="4">Performed By :
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="eln.technician.name"/>
                                </td>
                                <td colspan="4">Witness Name :
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="eln.witness_name"/>
                                </td>
                                <td colspan="4">Witness Signature :
                                    <![CDATA[&nbsp;]]>
                                    <span style='padding:20px'></span>
                                </td>
                            </tr>
                        </table>



						 <!-- Water Permeability -->

           
             <div t-if="data.water_permeability_visible">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;margin-top: 15px;">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','02145jj-eba3-4f15-b33d-679b39f73301')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','02145jj-eba3-4f15-b33d-679b39f73301')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>

                         <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                          <thead>
                            <tr cols="12" style="background-color: #f0f0f0; text-align: center;">
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Sr.No
                                </th>
                                  <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Water Pressure Applied (bar/kg/cm²)
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;"> Duration of Test (hrs)
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Maximum Depth of Water Penetration (mm)
                                </th>
                                 <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">H/Average Depth of Penetration (mm)
                                </th>
                            </tr>
                            </thead>
							<tbody>

                            <t t-set="k" t-value="0"/>
                            <tr t-foreach="data.water_permeability_table" t-as="r" style="text-align: center;">
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['pressure']"/>
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['duration']"/>
								</td>
								<td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['maximum_depth']"/>
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['average_depth']"/>
                                </td>
                            </tr>
                       </tbody>
						</table>

                        <table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr cols="12">
                                <td colspan="6"  style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Depth of Penetration (mm)  :
                              <![CDATA[&nbsp;]]>
                                </td>
                                <td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.average_depth" t-options='{"widget": "float", "precision": 3}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','1234jht-0268-46ef-ba88-9c0453210lkit1')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    

                    <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<!-- <t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '1234jht-0268-46ef-ba88-9c0453210lkit1')"/>
    
								<t t-set="active_technician" t-value="false"/>
								<t t-if="param_line" t-set="active_technician" t-value="param_line[0].technician"/>
								<t t-if="not param_line" t-set="active_technician" t-value="eln.technician"/>

								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="active_technician and active_technician.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + active_technician.employee_id.signature.decode('utf-8')" 
											style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
								</t>
							</div>
                            <div>
                                <b>
                                <!-- <span t-esc="eln.sample_id.filled_by.name"/> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '1234jht-0268-46ef-ba88-9c0453210lkit1')"/>
        
                              <span t-if="param_line" t-esc="param_line[0].technician.name"/>
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.name"/>
								
                                </b>
                            </div>
                            <div>
                                <b>
                                    <!-- (<span t-esc="eln.sample_id.filled_by.job_title"/>) -->
									<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '1234jht-0268-46ef-ba88-9c0453210lkit1')"/>
        
                              (<span t-if="param_line" t-esc="param_line[0].technician.job_title"/>)
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.job_title"/>
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
								
							
						</div>
					</div>
					</div>


						 <!-- Compressive Strength -->

           
             <div t-if="data.compressive_strength_visible" style="margin-top:20px;page-break-before: always; ">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','301hjtre-17c1-48ac-8462-9671e4d3d09f')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','301hjtre-17c1-48ac-8462-9671e4d3d09f')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>

                         <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                          <thead>
                            <tr cols="12" style="background-color: #f0f0f0; text-align: center;">
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Sr.No
                                </th>
                                  <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Age of Specimen
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;"> Height, mm
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Dia (mm)
                                </th>
                                 <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">H/D Ratio (n)
                                </th>
                                 <th colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 8px;width:200px">Correction factor f =0.11n+0.78 Where,  f= Correction factor,n= height to diameter ratio
                                </th>
                                 <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;"> Area (mm²) π r² 
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Volume (cc) πr²h
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Weight (gm)
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Density (gm/cc)
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Load (kN)
                                </th>
                                <th colspan="2"  style="text-align: center;border: 1px solid #ccc; padding: 8px;">Compressive Strength (N/mm²)
                                </th>
                            
                            </tr>
                            </thead>
							<tbody>

                            <t t-set="k" t-value="0"/>
                            <tr t-foreach="data.compressive_strength_table" t-as="r" style="text-align: center;">
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['age']"/>
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['height']"/>
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['diameter']"/>
                                </td>
                              
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['hd_ratio']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['correction_factor']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['area']" t-options='{"widget": "float", "precision": 3}'/>
                                </td>
                                  <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['volume']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['weight']" />
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['density']" t-options='{"widget": "float", "precision": 3}'/>
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['load']" />
                                </td>
                                <td colspan="2" style="text-align: center;border: 1px solid #ccc; padding: 6px;">
                                    <span t-esc="r['compressive_strength']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                             
                               
                            </tr>
                       </tbody>
						</table>

                        <table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr cols="12">
                                <td colspan="6"  style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Compressive Strength  :
                              <![CDATA[&nbsp;]]>
                                </td>
                                <td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.avg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','301hjtre-17c1-48ac-8462-9671e4d3d09f')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<!-- <t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '301hjtre-17c1-48ac-8462-9671e4d3d09f')"/>
    
								<t t-set="active_technician" t-value="false"/>
								<t t-if="param_line" t-set="active_technician" t-value="param_line[0].technician"/>
								<t t-if="not param_line" t-set="active_technician" t-value="eln.technician"/>

								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="active_technician and active_technician.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + active_technician.employee_id.signature.decode('utf-8')" 
											style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
								</t>
							</div>
                            <div>
                                <b>
                                <!-- <span t-esc="eln.sample_id.filled_by.name"/> -->
								<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '301hjtre-17c1-48ac-8462-9671e4d3d09f')"/>
        
                              <span t-if="param_line" t-esc="param_line[0].technician.name"/>
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.name"/>
								
                                </b>
                            </div>
                            <div>
                                <b>
                                    <!-- (<span t-esc="eln.sample_id.filled_by.job_title"/>) -->
									<t t-set="param_line" t-value="eln.parameters_result.filtered(lambda p: p.parameter.internal_id == '301hjtre-17c1-48ac-8462-9671e4d3d09f')"/>
        
                              (<span t-if="param_line" t-esc="param_line[0].technician.job_title"/>)
        
                               <span t-if="not param_line and eln.technician" t-esc="eln.technician.job_title"/>
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
								
							
						</div>
					</div>
					</div>

					
				</div>
                </div>
			</t>
		</t>
	</template>
    </odoo>