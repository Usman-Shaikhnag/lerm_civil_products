<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_concrete_cylinder_view" model="ir.ui.view">
        <field name="name">mechanical.concrete.cylinder.form</field>
        <field name="model">mechanical.concrete.cylinder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                 <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" exception="grade"  string="Grade" identity="extra"/>   
                         <field name="eln_state" />
                    </group>

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                     <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_casting"></label></td>
                                    <td><field name="date_of_casting" /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_testing"></label></td>
                                    <td><field name="date_of_testing" class="blue-input" decoration-info="date_of_testing != 0" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        </div>


                        <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="age_of_days"></label></td>
                                    <td><field name="age_of_days" /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="age_of_test"></label></td>
                                    <td><field name="age_of_test" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        </div>

                        <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="difference"></label></td>
                                    <td><field name="difference" /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                       
                        </div>
                   
                   

                        <field name="child_lines_concrete_cylinder" nolabel="1" class="custom_table_borders" >
                            <tree editable="bottom">
                                <field name="sr_no" />
                                <field name="id_location" class="blue-input" decoration-info="id_location != 0"/>
                                <field name="dia" class="blue-input" decoration-info="dia != 0"/>
                                <field name="height" class="blue-input" decoration-info="height != 0"/>
                                <field name="area" />
                                <field name="weight_of_sample" class="blue-input" decoration-info="weight_of_sample != 0"/>
                                <field name="crush_load" class="blue-input" decoration-info="crush_load != 0"/>
                                <field name="compressive_strenght" />
                              
                            </tree>
                    </field>

                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_concrete_cylinder"></label></td>
                                    <td><field name="average_concrete_cylinder"  /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                        <div >
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="confirmity"></label></td>
                            <td><field name='confirmity'
                               decoration-success="confirmity == 'pass'" 
                               decoration-danger="confirmity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="nabl"></label></td>
                            <td><field name='nabl'
                               decoration-success="nabl == 'pass'" 
                               decoration-danger="nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div> 



                        <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                  

                          

                        
                        <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
    </record>
  
    <record id="mechanical_concrete_cylinder_line_view" model="ir.ui.view">
        <field name="name">mechanical.concrete.cylinder.line.form</field>
        <field name="model">mechanical.concrete.cylinder.line</field>
        <field name="arch" type="xml">
            <form>
            <group>
            <group>
            <field name='sr_no' string="Sr. NO"/>
                <field name='id_location' string="ID Mark/Location"/>
                <field name='dia' string="Dia in mm"/>
                <field name='height' string="Height  ( mm )"/>
                <field name='area' string="Area in mm2"/>
            </group>
            <group>
                <field name='weight_of_sample' string="Weight of Sample in kgs"/>
                <field name="crush_load" string="Crushing Load in kN"/>
                <field name='compressive_strenght' string="Compressive Strength in N/mm2"/>
                <field name="parent_id" invisible="1"/>
            </group>
            </group>
                
            </form>
        </field>
    </record>

    </data>
</odoo>