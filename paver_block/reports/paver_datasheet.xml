									<![CDATA[&nbsp;]]>
									</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_thickness" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
					</div>




                <!--  Water Absorption -->


				<div t-if="data.water_absorption_visible" style="margin-top:10px">
						<div style="text-align:center;font-size:18px;font-weight: bold; margin-bottom: 15px;">
							Water Absorption
						</div>
						
						
						<table style="width: 100%; border-collapse: collapse; font-size: 14px;margin-top:10px">
						 <thead>

							<tr  style="background-color:#f9f9f9; text-align: center;">
							    <th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="3">Sr No</th>
								
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="3">Sample Identification</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="3">Dry Weight
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="3">Saturated Weight
