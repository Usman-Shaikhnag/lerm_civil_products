									<div>
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</div>
								</td>
								<!-- <td colspan="3">
									<span t-esc="r['trial_no']"/>
								</td> -->
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['sample']"/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['length1']"/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['length2']" />
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['avg_length']" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['width1']"/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['width2']" />
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['width3']" />
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['avg_width']" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['thickness1']" />
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['thickness2']" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="1">
									<span t-esc="r['thickness3']"/>
								</td>
