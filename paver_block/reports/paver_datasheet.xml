										<span t-esc="r['apparent_strength']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align:center;" colspan="2">
										<span t-esc="r['correction_factor']" />
