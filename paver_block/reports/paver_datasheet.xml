								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="3">Length
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="4">Width
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="5">Thickness
								</th>
								
							</tr>

							<tr  style="background-color:#f9f9f9; text-align: center;">
							    <th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">1</th>
								
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">2</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">Average
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">1</th>
								
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">2</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">3
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">Average
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">1</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">2
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">3
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="1">4
