								<!-- <td colspan="3">
									<span t-esc="r['trial_no']"/>
								</td> -->
								<td style="border: 1px solid black; padding: 6px;" colspan="3">
									<span t-esc="r['sample']"/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="3">
									<span t-esc="r['dry_weight']"/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="3">
									<span t-esc="r['sat_weight']" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="3">
									<span t-esc="r['sat_dry_weight']"/>
								</td>
								<td style="border: 1px solid black; padding: 6px;" colspan="3">
									<span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
							</tbody>
						</table>


							<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr cols="12" style="font-weight: bold; background-color: #f9f9f9;">
								
