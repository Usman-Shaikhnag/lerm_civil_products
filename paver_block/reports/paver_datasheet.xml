									<![CDATA[&nbsp;]]>
									</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_length" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								</tr>

								<tr cols="12" style="font-weight: bold; background-color: #f9f9f9;">
								<td style="text-align: left; padding: 8px; border: 1px solid black;" colspan="6">Average Width :
									<![CDATA[&nbsp;]]>
									</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_width" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								</tr>

								<tr cols="12" style="font-weight: bold; background-color: #f9f9f9;">
