								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="3">Saturated Weight-Dry Weight
								</th>
								<th style="border: 1px solid black; font-weight: bold;padding: 8px;" colspan="3">Saturated Weight-Dry Weight/Dry Weight*100
