							</thead>
							<tbody>

							<t t-set="i" t-value="0"/>
							<tr t-foreach="data.water_absorption_child_lines" t-as="r" style="text-align: center;">
								<td style="border: 1px solid black; padding: 6px;" colspan="3">
									<div>
										<span t-esc="i + 1" />
