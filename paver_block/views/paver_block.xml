<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_pever_block1" model="ir.ui.view">
        <field name="name">mechanical.paver.block.ssl.form</field>
        <field name="model">mechanical.paver.block.ssl</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   <group style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="name_paver" readonly="1" nolabel="1"/>
                        </h1>
                    </group>
                    <group >
                       <field name="grade"/>
                       <field name="size_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <group class="custom_table_borders">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </group>
                   
                    
                    <!-- <group >
                            
                            <field name="tests" widget="many2many_tags"/>
                    </group> -->
                    <group invisible = "paver_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="paver_name" readonly="1" nolabel="1"/>
                            <field name="paver_visible" invisible="1"/>
                        </h1>
                    </group>

                     <group invisible = "paver_visible == False" >
                    <field name="thickness_child_lines" mode="tree"  invisible="1">
                            <tree editable="bottom" class="custom_table_borders">
                              
                                <field name="thickness1"/>
                                  <field name="Correction_factore"/>
                               
                               
                            </tree>
                    </field>
                   
                    </group>
                   
                     
                    <!-- <group invisible = "paver_visible == False" style="white-space: nowrap; width:70%;">
                        <field name='thickness' col="4"/>
                        
                    </group> -->

                    <group  invisible = "paver_visible == False" style="white-space: nowrap; width:70%;">
                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 100%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                               Thickness of Paver Block:

                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="thickness2" nolabel="1"/>
                                                </div>
                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                mm
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </group>


                

                   

                    <!-- <table class="custom_table_borders" invisible = "paver_visible == False">
                        <thead>
                            <tr>
                             
                                <th style="text-align: center;">Gms</th>
                                <th style="text-align: center;">N</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                               
                                <td style="text-align: center;"><field name="gms1" nolabel="1"/></td>
                                 <td style="text-align: center;"><field name="n1" nolabel="1"/></td>
                               
                            </tr>
                             <tr>
                               
                               
                                <td style="text-align: center;"><field name="n2" nolabel="1"/></td>
                                 <td style="text-align: center;"><field name="gms2" nolabel="1"/></td>
                            </tr>
                        </tbody>
                    </table> -->
  

                        <group col="2">
                        <!-- Left Table -->
                        <div style="margin-top: 20px; white-space: nowrap; width:100%;">
                            <div class="custom_table_borders" style="width:100%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr>
                                            <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                                Parameter Name
                                            </th>
                                            <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                                Result
                                            </th>
                                            <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                                Unit
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                                <label for="mass_specimen"/>
                                            </td>
                                            <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                                <field name="mass_specimen" nolabel="1"/>
                                            </td>
                                            <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                                N
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                                <label for="mass_size"/>
                                            </td>
                                            <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                                <field name="mass_size" nolabel="1"/>
                                            </td>
                                            <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                                N
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                                <label for="area_paver"/>
                                            </td>
                                            <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                                <field name="area_paver" nolabel="1"/>
                                            </td>
                                            <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                                mm²
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Right Table -->
                        <div style="margin-top: 20px; width:100%;margin-left: 120px;" invisible="paver_visible == False">
                            <table class="custom_table_borders" style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="text-align: center; border: 1px solid black;">Gms</th>
                                        <th style="text-align: center; border: 1px solid black;">N</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="text-align: center; border: 1px solid black;">
                                            <field name="gms1" nolabel="1"/>
                                        </td>
                                        <td style="text-align: center; border: 1px solid black;">
                                            <field name="n1" nolabel="1"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: center; border: 1px solid black;">
                                            <field name="gms2" nolabel="1"/>
                                        </td>
                                        <td style="text-align: center; border: 1px solid black;">
                                            <field name="n2" nolabel="1"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </group>



                      <group  invisible = "paver_visible == False">
                          <group>
                            <field  name="area_paver_conformity"
                                           decoration-success="area_paver_conformity == 'pass'" 
                                           decoration-danger="area_paver_conformity == 'fail'" 
                                           readonly="1"/>
                            <field  name="area_paver_nabl"
                                         decoration-success="area_paver_nabl == 'pass'" 
                                           decoration-danger="area_paver_nabl == 'fail'" 
                                           readonly="1"/>
                          </group>
                    </group>


                    <group invisible = "water_absorption_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                        </h1>
                    </group>


                  


                            <div class="custom_table_borders" style="width: 100%;"  invisible="water_absorption_visible == False">
                                <field name="water_absorption_child_lines" mode="tree" nolabel="1">
                                    <tree editable="bottom" class="custom_table_borders" style="width: 100%; border-collapse: collapse;">
                                        <field name="serial_no" />
                                        <field name="sample_identification"/>
                                        <field name="dry_wt_w1" />
                                        <field name="wet_w2" />
                                        <field name="water_absorption"/>
                                    </tree>
                                </field>
                            </div>

                     <!-- <group invisible = "water_absorption_visible == False" string="Result" colspan="4"  style="white-space: nowrap; width:70%; margin-top: 10px">
                     
                        <field name="avg_water_absorption" readonly="1"/>
                        
                  
                    </group> -->

                    <group  invisible = "water_absorption_visible == False" string="Result" style="white-space: nowrap; width:70%;">
                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 100%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                            Avg. Water Absorption

                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="avg_water_absorption" nolabel="1"/>
                                                </div>
                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                %
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </group>

                      <group  invisible = "water_absorption_visible == False">
                          <group>
                            <field  name="avg_water_absorption_conformity"
                                           decoration-success="avg_water_absorption_conformity == 'pass'" 
                                           decoration-danger="avg_water_absorption_conformity == 'fail'" 
                                           readonly="1"/>
                            <field  name="avg_water_absorption_nabl"
                                          decoration-success="avg_water_absorption_nabl == 'pass'" 
                                         decoration-danger="avg_water_absorption_nabl == 'fail'" 
                                          readonly="1"/>
                          </group>
                    </group>


                    <group invisible = "commpressive_visible == False"  style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="commpressive_name" readonly="1" nolabel="1"/>
                            <field name="commpressive_visible" invisible="1"/>
                        </h1>
                    </group>


                    <div invisible = "commpressive_visible == False"   style="width: 100%;">
                    <field name="commpressive_child_lines"   mode="tree" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders" style="width: 100%;">
                                <field name="serial_no"/>
                                <field name="sample_identification_com"/>
                                <field name="wt_block" />
                                <field name="correction_factor"/>
                                <field name="load"/>
                                <field name="compressive_strenght"/>
                                <field name="thickness"/>
                               
                            </tree>
                    </field>
                   
                    </div>
                  
                        <group invisible="commpressive_visible == False" string="Result" style="white-space: nowrap; width:70%;">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; width: 100%;">

                                <!-- Avg. Compressive Strength -->
                                <div class="custom_table_borders" style="flex: 1; min-width: 300px;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tbody>
                                            <tr>
                                                <td style="border: 1px solid black; padding: 10px; text-align: left; color: black;">
                                                    Avg. Compressive Strength
                                                </td>
                                                <td style="border: 1px solid black; padding: 10px; text-align: center;">
                                                    <div style="display: inline-block; min-width: 80px;">
                                                        <field name="avg_commpressive" nolabel="1"/>
                                                    </div>
                                                </td>
                                                <td style="border: 1px solid black; padding: 10px; text-align: center;">
                                                    N/mm²
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Avg Thickness -->
                                <div class="custom_table_borders" style="flex: 1; min-width: 300px;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tbody>
                                            <tr>
                                                <td style="border: 1px solid black; padding: 10px; text-align: left; color: black;">
                                                    Avg Thickness
                                                </td>
                                                <td style="border: 1px solid black; padding: 10px; text-align: center;">
                                                    <div style="display: inline-block; min-width: 80px;">
                                                        <field name="avg_thickness" nolabel="1"/>
                                                    </div>
                                                </td>
                                                <td style="border: 1px solid black; padding: 10px; text-align: center;">
                                                    mm
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </group>


                     <group  invisible = "commpressive_visible == False" style="white-space: nowrap; width:70%;">
                          <group>
                            <field  name="avg_commpressive_conformity"
                                           decoration-success="avg_commpressive_conformity == 'pass'" 
                                           decoration-danger="avg_commpressive_conformity == 'fail'" 
                                           readonly="1"/>
                            <field  name="avg_commpressive_nabl"
                                            decoration-success="avg_commpressive_nabl == 'pass'" 
                                            decoration-danger="avg_commpressive_nabl == 'fail'" 
                                            readonly="1"/>
                          </group>
                    </group>

                      <group  invisible = "commpressive_visible == False" style="white-space: nowrap; width:70%;">
                          <group>
                            <field  name="avg_thickness_conformity"
                                           decoration-success="avg_thickness_conformity == 'pass'" 
                                           decoration-danger="avg_thickness_conformity == 'fail'" 
                                           readonly="1"/>
                            <field  name="avg_thickness_nabl"
                                         decoration-success="avg_thickness_nabl == 'pass'" 
                                         decoration-danger="avg_thickness_nabl == 'fail'" 
                                          readonly="1"/>
                          </group>
                    </group>




                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     


                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>