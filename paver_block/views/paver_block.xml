<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_pever_block1" model="ir.ui.view">
        <field name="name">mechanical.paver.block.form</field>
        <field name="model">mechanical.paver.block</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   <group style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="name_paver" readonly="1" nolabel="1"/>
                        </h1>
                    </group>

                     <group style="white-space: nowrap; width:70%;">
                     
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                       
                        </group>
                    <group >
                       <field name="grade"/>
                       <field name="size_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="lab_id" invisible="1" />
                        <field name="parameter_id" invisible="1"/>
                    </group>
                   <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>


                    <style>
                    
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }

                    </style>

                     <button name="action_generate_options_paver" 
                            type="object" 
                            string="Show Lab ID" 
                            class="oe_highlight"/>

                    <field name="lab_paver_ids" invisible="1">
                        <tree editable="bottom">
                            <field name="lab"/>
                        </tree>
                    </field>


                   
                       <!--  Compressive Strength  -->

                    <div invisible=" not compressive_strength_visible">
                        <h1 class="text-center">
                            <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                            <field name="compressive_strength_visible" invisible="1"/>
                            
                        </h1>
                    </div>

                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not compressive_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_compressive_strength"></label></td>
                                    <td ><field name="selected_compressive_strength"  /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="is_compressive_strength"></label></td>
                                    <td><field name="is_compressive_strength"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>

                    <div class="d-flex gap-2" invisible="not compressive_strength_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_compressive_strength">Temp.°C</label></td>
                                    <td><field name="temp_compressive_strength" class="blue-input" invisible="not compressive_strength_visible" required = "calc_mode == False or is_compressive_strength == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_compressive_strength">Humidity %</label></td>
                                    <td><field name="humidity_compressive_strength" class="blue-input" invisible="not compressive_strength_visible" required = "calc_mode == False or is_compressive_strength == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>



                         <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><field name="calc_mode" class="blue-input" invisible="not compressive_strength_visible"  /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                    </div>

                    <div class="d-flex gap-2">
                       

                         <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="block_type">Block Type</label></td>
                                    <td><field name="block_type" style="width:200px;background-color:#d8ecff;"/></td>
                                </tr>

                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>

                             <tr>
                                <td>
                                   <label  for="plain_factor"
                                    invisible="block_type != 'plain'" style=" padding-right:20px;">
                                    Plain Correction Factor         
                                   </label>
                                   
                                   <field name="plain_factor"
                                    invisible="block_type != 'plain'" style=" padding-left:10px;background-color:#d8ecff;"/>
                                   <label for="arrised_factor"
                                    invisible="block_type != 'arrised'">
                                     Arrised Correction Factor        
                                   </label>
                                   
                                   <field name="arrised_factor"
                                    invisible="block_type != 'arrised'" style=" padding-left:10px;background-color:#d8ecff;"/>
                                </td>
                             </tr>

                            </tbody>
                        </table>
                        </div>
                        
                        


  


                    <div invisible="compressive_strength_visible == False" class="custom_table_borders">
                        <field name="compressive_strength_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name="serial_no"/>
                                <field name='sample1' width="100px" class="blue-input" decoration-info="sample1 != 0"/>
                                <field name='length' class="blue-input" decoration-info="length != 0"/>
                                <field name='width' class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                <field name='area'/>
                                <field name='load' class="blue-input" decoration-info="load != 0"/>
                                <field name='correction_factor'/>
                                <field name='compressive_strength'/>
                                
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="not compressive_strength_visible" style="white-space:nowrap;">
                        <tbody>
                        <tr>
                                <td><label class="fw-bold" for="avg_compressive_strength">Average Compressive Strength (N/mm²)</label></td>
                                <td>
                                    <field name="avg_compressive_strength" />
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_compressive_strength_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_compressive_strength_conformity"
                                        decoration-success="avg_compressive_strength_conformity == 'pass'" 
                                        decoration-danger="avg_compressive_strength_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_compressive_strength_nabl">NABL Status</label></td>
                                <td>
                                    <field name="avg_compressive_strength_nabl"
                                        decoration-success="avg_compressive_strength_nabl == 'pass'" 
                                        decoration-danger="avg_compressive_strength_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <group/>
                   
                   
                   
                    <!-- Dimension Test -->

                    <div invisible=" not dimension_visible">
                        <h1 class="text-center">
                            <field name="dimension_name" readonly="1" nolabel="1"/>
                            <field name="dimension_visible" invisible="1"/>
                            <field name="length_visible" invisible="1"/>
                            <field name="width_visible" invisible="1"/>
                            <field name="thickness_visible" invisible="1"/>
                            
                        </h1>
                    </div>

                     <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not dimension_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_dimension"></label></td>
                                    <td ><field name="selected_dimension"  /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="is_dimension"></label></td>
                                    <td><field name="is_dimension"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>

                    <div class="d-flex gap-2" invisible="not dimension_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_dimension">Temp.°C</label></td>
                                    <td><field name="temp_dimension" class="blue-input" invisible="not dimension_visible" required = "calc_mode == False or is_dimension == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_dimension">Humidity %</label></td>
                                    <td><field name="humidity_dimension" class="blue-input" invisible="not dimension_visible" required = "calc_mode == False or is_dimension == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>


                    <div invisible="dimension_visible == False" class="custom_table_borders">
                        <field name="dimension_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name="serial_no"/>
                                
                                <field name='sample' style="width:100px;"/>
                                <field name='length1' class="blue-input" decoration-info="length1 != 0"/>
                                <field name='length2' class="blue-input" decoration-info="length2 != 0"/>
                                <field name='avg_length' />

                                <field name='width1' class="blue-input" decoration-info="width1 != 0"/>
                                <field name='width2' class="blue-input" decoration-info="width2 != 0"/>
                                <field name='width3' class="blue-input" decoration-info="width3 != 0"/>
                                <field name='avg_width'/>

                                <field name='thickness1' class="blue-input" decoration-info="thickness1 != 0"/>
                                <field name='thickness2' class="blue-input" decoration-info="thickness2 != 0"/>
                                <field name='thickness3' class="blue-input" decoration-info="thickness3 != 0"/>
                                <field name='thickness4' class="blue-input" decoration-info="thickness4 != 0"/>
                                <field name='avg_thickness'/>
                            </tree>
                        </field>
                    </div>

                    <div class="d-flex gap-2" invisible="not dimension_visible">
                        <table class="table table-sm o_form_table table-bordered flex-fill custom_table_borders" style="width:33%">
                            <tbody>
                                <tr>
                                    <td><label for="average_length">Average Length</label></td>
                                    <td><field name="average_length"/></td>
                                </tr>

                                <tr>
                                <td><label class="fw-bold" for="average_length_conformity">Conformity</label></td>
                                <td>
                                    <field name="average_length_conformity"
                                        decoration-success="average_length_conformity == 'pass'" 
                                        decoration-danger="average_length_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_length_nabl">NABL Status</label></td>
                                <td>
                                    <field name="average_length_nabl"
                                        decoration-success="average_length_nabl == 'pass'" 
                                        decoration-danger="average_length_nabl == 'fail'"/>
                                </td>
                            </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered flex-fill custom_table_borders" style="width:33%">
                            <tbody>
                                <tr>
                                    <td><label for="average_width">Average Width</label></td>
                                    <td><field name="average_width"/></td>
                                </tr>

                                <tr>
                                <td><label class="fw-bold" for="average_width_conformity">Conformity</label></td>
                                <td>
                                    <field name="average_width_conformity"
                                        decoration-success="average_width_conformity == 'pass'" 
                                        decoration-danger="average_width_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_width_nabl1">NABL Status</label></td>
                                <td>
                                    <field name="average_width_nabl1"
                                        decoration-success="average_width_nabl1 == 'pass'" 
                                        decoration-danger="average_width_nabl1 == 'fail'"/>
                                </td>
                            </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered  custom_table_borders" style="width:33%">
                            <tbody>
                                <tr>
                                    <td><label for="average_thickness">Average Thickness</label></td>
                                    <td><field name="average_thickness"/></td>
                                </tr>

                                <tr>
                                <td><label class="fw-bold" for="average_thickness_conformity">Conformity</label></td>
                                <td>
                                    <field name="average_thickness_conformity"
                                        decoration-success="average_thickness_conformity == 'pass'" 
                                        decoration-danger="average_thickness_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_thickness_nabl">NABL Status</label></td>
                                <td>
                                    <field name="average_thickness_nabl"
                                        decoration-success="average_thickness_nabl == 'pass'" 
                                        decoration-danger="average_thickness_nabl == 'fail'"/>
                                </td>
                            </tr>
                                
                            </tbody>
                        </table>
                    </div>

                     

                    <group/>




                     


                    <!-- Water Absorption -->

                    <div invisible=" not water_absorption_visible">
                        <h1 class="text-center">
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                            
                        </h1>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not compressive_strength_visible">
                            <tbody>
                                <tr>
                                    <td><label for="selected_water_absorption"></label></td>
                                    <td ><field name="selected_water_absorption"  /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="is_water_absorption"></label></td>
                                    <td><field name="is_water_absorption"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>


                    <div class="d-flex gap-2" invisible="not water_absorption_visible">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_water_absorption">Temp.°C</label></td>
                                    <td><field name="temp_water_absorption" class="blue-input" invisible="not water_absorption_visible" required = "calc_mode == False or is_water_absorption == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_water_absorption">Humidity %</label></td>
                                    <td><field name="humidity_water_absorption" class="blue-input" invisible="not water_absorption_visible" required = "calc_mode == False or is_water_absorption == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>


                    <div invisible="water_absorption_visible == False" class="custom_table_borders">
                        <field name="water_absorption_child_lines" nolabel="1">
                            <tree editable="bottom">
                                <field name="serial_no" width="40px" />
                                <field name='sample' width="100px" class="blue-input" decoration-info="sample != 0"/>
                                <field name='dry_weight' class="blue-input" decoration-info="dry_weight != 0"/>
                                <field name='sat_weight' class="blue-input" decoration-info="sat_weight != 0"/>

                                <field name='sat_dry_weight'/>
                                <field name='water_absorption'/>
                                
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="not water_absorption_visible" style="white-space:nowrap;">
                        <tbody>
                        <tr>
                                <td><label class="fw-bold" for="avg_water_absorption">Average Water Absorption</label></td>
                                <td>
                                    <field name="avg_water_absorption"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                        decoration-success="avg_water_absorption_conformity == 'pass'" 
                                        decoration-danger="avg_water_absorption_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_nabl">NABL Status</label></td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                        decoration-success="avg_water_absorption_nabl == 'pass'" 
                                        decoration-danger="avg_water_absorption_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <group/>


                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                

                      <div style="display:flex;">
                      <div style="width:50%">
                       <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                      </div>
                      
                      <div style="width:50%">
                        <field name="submit_mode" invisible="1"/>

                      </div>
                    </div>
                     


                </sheet>
            </form>
        </field>
        </record>



         <record id="view_paver_prefill_data_form" model="ir.ui.view">
            <field name="name">paver.block.prefill.data.form</field>
            <field name="model">paver.block.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_paver_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">paver.block.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_paver_prefill_data_form"/>
            <field name="target">new</field>
        </record>


    </data>
</odoo>