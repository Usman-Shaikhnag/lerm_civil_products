<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="pile_integrity_form" model="ir.ui.view">
        <field name="name">pile.integrity.form</field>
        <field name="model">pile.integrity</field>
        <field name="arch" type="xml">
            <form create="false">

                  
                <sheet>

                <group style="white-space: nowrap; width:80%" >
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <!-- <field name="grade"/> -->

                    </group>
                    <div class="custom_table_borders" style="margin-top: 15px;">
                            <field name="sample_parameters" nolabel="1">
                                <tree>
                                    <field name="parameter_name"/>
                                    <field name="test_method"/>
                                </tree>
                            </field>
                        </div>
                    
                    <!-- Dimension -->

                    <group style="white-space: nowrap; width:80%">
                        <h1>

                            <field name="pile_integrity_name" readonly="1" nolabel="1"/>
                            
                        </h1>
                    </group>

                    <div >
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td style="width:20%;"><label for="code_ref">Code of Reference :</label></td>
                                    <td style="width:80%;"><field name="code_ref"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>

                    <div >
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td style="width:20%;"><label for="principle_details">Principle :</label></td>
                                    <td style="width:80%;"><field name="principle_details"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>
                    


                       
                        <div style="text-align: right; margin-top: 20px;">
                            <field name="instrument_image"
                                widget="image"
                                class="img-fluid"
                                style="max-width:400px; max-height:400px; object-fit: contain;"/>
                        </div>

                   

                    <div >
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td style="width:20%;"><label for="procedure">Procedure :</label></td>
                                    <td style="width:80%;"><field name="procedure"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>

                  

                     

                       <div >
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td style="width:20%;"><label for="influences_result">Influences Of Test Result :</label></td>
                                    <td style="width:80%;"><field name="influences_result"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>




                     <div style=" margin-top: 20px;">
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td style="width:20%;"><label for="interpretation_result">interpretation_result :</label></td>
                                    <td style="width:80%;"><field name="interpretation_result" widget="html"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>
                     
                    <div style="text-align: right; margin-top: 20px;">
                    <field name="instrument_description_image"
                        widget="image"
                        class="img-fluid"
                        style="max-width:400px; max-height:400px; object-fit: contain;"/>
                </div>



                        <group style="white-space: nowrap; width:80%">
                        <h1>

                            <field name="pile_integrity_test_name" readonly="1" nolabel="1"/>
                            
                        </h1>
                    </group>

                 

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temperature">Temperature °C</label></td>
                                    <td><field name="temperature"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="instrument">Instrument</label></td>
                                    <td><field name="instrument"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>

                        <field name="pile_integrity_test_table"  >
                        <tree editable="bottom" class="custom_table_borders">
                          <field name="serial_no"/>
                          <field name="pile_id"/>
                          <field name="doc"/>
                          <field name="pile_dia"/>
                          <field name="cut_off"/>
                          <field name="shaft_cross"/>
                     
                        </tree>
                        </field>

                     <group >
                          <field name="pile_report_upload" widget="many2many_binary" />
                          <!-- uptill -->
                      </group>


                 


                      <div style=" margin-top: 20px;">
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td style="width:20%;"><label for="test_result">TEST RESULT  :</label></td>
                                    <td style="width:80%;"><field name="test_result"  widget="html"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>



                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
            
          
                   
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>