					<div style="page-break-before:always;text-align:center;padding-top:25px;">
						<h3>10. SITE PHOTOGRAPHS</h3>

						<t t-foreach="data.image_ids" t-as="img">
							<div class="page" style="padding-top:25px;">
								<div style="width:100%; text-align:center;">
									<img t-if="img.image"
										t-att-src="'data:image/png;base64,%s' % img.image.decode('utf-8')"
										style="max-width:100%; max-height:650px; display:block; margin:auto;"/>
								</div>
							</div>
						</t>
					</div>
					<div class="page" style="page-break-before: always;">
						<div style="text-align:center;font-size:32px;font-weight:bold;margin-top:250px;line-height:1.8;">
