						<b>1. INTRODUCTION</b>
					</div>

					<div style="font-size:14px;
						font-family:'Times New Roman', serif;
						line-height:2;
						text-align:justify;
						text-justify:inter-word;
					">
						<t t-if="data.introduction">
							<t t-raw="data.introduction.replace('\n','&lt;br/&gt;')"/>
						</t>
					</div>

					<div style="font-size:18px;font-weight:bold;text-align:left;margin-top:25px;margin-bottom:15px;">
						<b>2. PILE DETAIL</b>
					</div>

					<table style="width:100%; border-collapse:collapse; margin-top:15px;">

						<tr>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								Type of Pile
							</td>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								<span t-field="data.pile_type"/>
							</td>
						</tr>

						<tr>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								Pile Diameter
							</td>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								<span t-field="data.pile_diameter"/> mm
							</td>
						</tr>

						<tr>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								Pile Depths From test Level 
							</td>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								<span t-field="data.pile_depth"/>
							</td>
						</tr>

						<tr>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								Concrete Grade
							</td>
							<td style="border:1px solid black; padding:8px;text-align:center;">
								<span t-field="data.concrete_grade"/>
							</td>
						</tr>

