						text-align:justify;
						text-justify:inter-word;
					">
						<t t-if="data.conclusion">
							<t t-raw="data.conclusion.replace('\n','&lt;br/&gt;')"/>
						</t>
					</div>
					<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
								<b>
								Checked By
								</b>
							</div>
							<div style="height: 40px;">
							<t t-if="eln.sample_id.checkby_signature_required">
								<div t-if="eln.sample_id.check_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>

							<div>
								<b>
									<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>

							<div>
								<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>

						<div>
							<div>
								<b>
										Approved By
								</b>
							</div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.approveby_signature_required">
									<div t-if="eln.sample_id.approved_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>
				</div>

				<div class="page" style="page-break-before: always;">
					<table style="width: 100%; height: 842px; border-collapse: collapse; border: none;">
						<tr>
							<td style="
								text-align: center;
								vertical-align: middle;
								font-size: 32px;
								font-weight: bold;
								line-height: 1.8;
								border: none;
							">
								<b>APPENDIX - I</b><br/>
								<b>PILE INTEGRITY TEST RESULTS</b>
							</td>
						</tr>
					</table>
				</div>
			
				<div class="container_eln" style="page-break-before: always;padding-top:25px;">

				<div style="margin-top:20px">
					<div style="text-align:center;font-size:18px">
						PILE INTEGRITY TEST RESULTS
					</div>
				
					<table style="width:100%;margin-top:20px;border-collapse:collapse;font-size:12px;text-align:center;">
						<thead style="background-color: #d3d3d3;">
							<tr cols="12">
								<th style="text-align:center;border:1px solid #000;padding:6px;">Sr No</th>
								<th style="text-align:center;border:1px solid #000;padding:6px;">Pile ID</th>
								<th t-if="show_doc_column" 
									style="text-align:center;border:1px solid #000;padding:6px;">
									DOC
								</th>
								<th style="text-align:center;border:1px solid #000;padding:6px;">Dia (MM)</th>
								<th style="text-align:center;border:1px solid #000;padding:6px;">Cut Off Length (M)</th>
								<th style="text-align:center;border:1px solid #000;padding:6px;">Wave Speed (m/s)</th>
								<th style="text-align:center;border:1px solid #000;padding:6px;">Shaft Cross-Section &amp; Soil Changes</th>
							</tr>
						
						</thead>
						<tbody>

							<t t-set="i" t-value="0"/>
							<tr t-foreach="data.pile_integrity_test_table" t-as="r">
								<td style="text-align:center;border:1px solid #000;padding:6px;" colspan="1">
									<div>
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</div>
								</td>
								<td style="text-align:center;border:1px solid #000;padding:6px;"><span t-esc="r['pile_id']" /></td>
								<td t-if="show_doc_column"
									style="text-align:center;border:1px solid #000;padding:6px;">
									<span t-esc="r['doc']"/>
								</td>
								<td style="text-align:center;border:1px solid #000;padding:6px;"><span t-esc="r['pile_dia']" /></td>
								<td style="text-align:center;border:1px solid #000;padding:6px;"><span t-esc="r['cut_off']" /></td>
								<td style="text-align:center;border:1px solid #000;padding:6px;"><span t-esc="r['wave_speed']" /></td>
								<td style="text-align:center;border:1px solid #000;padding:6px;"><span t-esc="r['shaft_cross']" /></td>

							
								
							</tr>
						</tbody>
					</table>
