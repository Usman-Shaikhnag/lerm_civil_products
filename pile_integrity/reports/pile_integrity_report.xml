					<div style="text-align:center;">
						<img t-att-src="fig1a" style="width:100%;"/>
					</div>

					<div style="text-align:center; margin-top:20px;"><b>Figure 1b</b></div>
					<div style="text-align:center;">
						<img t-att-src="fig1b" style="width:100%;"/>
					</div>
				</div>

				<div class="page" style="page-break-before: always;padding-top:25px;">
					<div style="text-align:center;"><b>Figure 1c</b></div>
