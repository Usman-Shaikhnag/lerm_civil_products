<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


        <record id="mechanical_cheequered_tile_view" model="ir.ui.view">
        <field name="name">mechanical.chequered.tiles.form</field>
        <field name="model">mechanical.chequered.tiles</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   <div >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                      
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                          
                        </tree>
                      </field>
                    </div>
                    <group/>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <div class="d-flex gap-2"> 
                         <table class="table table-sm table-bordered w-50 custom_table_borders" >
                          <tbody>
                              <tr>
                                 <td><label class="fw-bold" for="temperature">Temperature </label></td>
                                 <td><field name="temperature"/></td>
                              </tr>
                        </tbody>
                    </table>
                     <table class="table table-sm table-bordered w-50 custom_table_borders" >
                          <tbody>
                               <tr>
                                  <td><label class="fw-bold" for="humidity">Humidity</label></td>
                                  <td><field name="humidity"/></td>
                                </tr>
                            
                        </tbody>
                    </table>
                    </div>

                    <!-- Dimension -->
                    <div invisible="not dimension_visible">
                        <h1 class="text-center">
                            <field name="dimension_name" readonly="1" nolabel="1"/>
                            <field name="dimension_visible" invisible="1"/>
                        </h1>
                    </div>
                    
                    <div class="custom_table_borders" invisible="not dimension_visible">
                        <field name="dimension_child_lines" nolabel="1" colspan="2" >
                            <tree editable="bottom" >
                                <field name='sr_no'/>
                                <field name='length' class="blue-input" decoration-info="length != 0"/>
                                <field name='width' class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                            </tree> 
                         </field>   
                    </div>
                    <group/>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td style="text-align:center;width:20%"><label class="fw-bold" for="dimension_remarks" ></label></td>
                                  <td style="text-align:center;width:80%;"><field name="dimension_remarks" /></td>
                            </tr>
                        </tbody>
                    </table>


                    <div class="d-flex gap-3" invisible="dimension_visible == False"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False" style="white-space:nowrap;">
                            <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_length">Average Length (mm)</label></td>
                                  <td><field name="avg_length"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_length_confirmity">Conformity</label></td>
                                <td>
                                    <field name="avg_length_confirmity"
                                        decoration-success="avg_length_confirmity == 'pass'" 
                                        decoration-danger="avg_length_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="avg_length_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_length_nabl"
                                        decoration-success="avg_length_nabl == 'pass'" 
                                        decoration-danger="avg_length_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_width">Average Width (mm)</label></td>
                                  <td><field name="avg_width"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_width_confirmity">Conformity</label></td>
                                <td>
                                    <field name="avg_width_confirmity"
                                        decoration-success="avg_width_confirmity == 'pass'" 
                                        decoration-danger="avg_width_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="avg_width_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_width_nabl"
                                        decoration-success="avg_width_nabl == 'pass'" 
                                        decoration-danger="avg_width_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_thickness">Average Thickness (mm)</label></td>
                                  <td><field name="avg_thickness"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_thickness_confirmity">Conformity</label></td>
                                <td>
                                    <field name="avg_thickness_confirmity"
                                        decoration-success="avg_thickness_confirmity == 'pass'" 
                                        decoration-danger="avg_thickness_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="avg_thickness_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_thickness_nabl"
                                        decoration-success="avg_thickness_nabl == 'pass'" 
                                        decoration-danger="avg_thickness_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                    <group/>


                    <!-- Flatness -->
                    <div invisible="not flatness_visible">
                        <h1 class="text-center">
                            <field name="flatness_name" readonly="1" nolabel="1"/>
                            <field name="flatness_visible" invisible="1"/>
                        </h1>
                    </div>
                    
                    <div class="custom_table_borders" invisible="not flatness_visible">
                     <h3>A.Concavity Measurement</h3>
                        <field name="flat_concavity_child_lines" nolabel="1" colspan="2" >
                            <tree editable="bottom" >
                                <field name='sr_no' width="120"/>
                                <field name='gap_diagonal_1' class="blue-input" decoration-info="gap_diagonal_1 != 0" width="120"/>
                                <field name='gap_diagonal_2' class="blue-input" decoration-info="gap_diagonal_2 != 0" width="120"/>
                                <field name='maximum_gap' width="120"/>
                                <field name='requirement' class="blue-input" decoration-info="requirement != 0" width="120"/>
                                <field name='result' width="150"/>
                            </tree> 
                         </field>   
                    </div>
                    <group/>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="flatness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="sample_concavity">Concavity of Sample</label></td>
                                  <td><field name="sample_concavity"/><span>  mm</span></td>
                            </tr>
                        </tbody>
                    </table>


                    <div class="custom_table_borders" invisible="not flatness_visible">
                     <h3>B. Convexity Measurement	</h3>
                        <field name="flat_convexity_child_lines" nolabel="1" colspan="2" >
                            <tree editable="bottom" >
                                <field name='sr_no' width="120"/>
                                <field name='gap_diagonal_1' class="blue-input" decoration-info="gap_diagonal_1 != 0" width="120"/>
                                <field name='gap_diagonal_2' class="blue-input" decoration-info="gap_diagonal_2 != 0" width="120"/>
                                <field name='maximum_gap' width="120"/>
                                <field name='requirement' class="blue-input" decoration-info="requirement != 0" width="120"/>
                                <field name='result' width="150"/>
                            </tree> 
                         </field>   
                    </div>
                    <group/>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="flatness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="sample_convexity">Convexity of Sample</label></td>
                                  <td><field name="sample_convexity"/><span>  mm</span></td>
                            </tr>
                        </tbody>
                    </table>


                    <table class="table table-sm table-bordered w-100 custom_table_borders" invisible="flatness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td style="text-align:center;font-weight:bold;"><span class="fw-bold">Parameter</span></td>
                                <td style="text-align:center;font-weight:bold;"><span class="fw-bold">Observed Value</span></td>
                                <td style="text-align:center;font-weight:bold;"><span class="fw-bold">Permissible Limit (mm)</span></td>
                                <td style="text-align:center;font-weight:bold;"><span class="fw-bold">Result</span></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;"><span class="fw-bold">Concavity</span></td>
                                <td style="text-align:center;"><field name="sample_concavity"/></td>
                                <td style="text-align:center;"><span class="fw-bold">&lt;= 1</span></td>
                                <td style="text-align:center;"><field name="concavity_result"/></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;"><span class="fw-bold">Convexity</span></td>
                                <td style="text-align:center;"><field name="sample_convexity"/></td>
                                <td style="text-align:center;"><span class="fw-bold">&lt;= 1</span></td>
                                <td style="text-align:center;"><field name="convexity_result"/></td>
                            </tr>
                        </tbody>
                    </table> 

                    <div class="d-flex gap-2" invisible="flatness_visible == False"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="flatness_visible == False" style="white-space:nowrap;">
                            <tbody>
                             <tr>
                                <td><label class="fw-bold" for="sample_concavity_confirmity">Concavity Conformity</label></td>
                                <td>
                                    <field name="sample_concavity_confirmity"
                                        decoration-success="sample_concavity_confirmity == 'pass'" 
                                        decoration-danger="sample_concavity_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="sample_concavity_nabl">Concavity NABL</label></td>
                                <td>
                                    <field name="sample_concavity_nabl"
                                        decoration-success="sample_concavity_nabl == 'pass'" 
                                        decoration-danger="sample_concavity_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="flatness_visible == False" style="white-space:nowrap;">
                        <tbody>
                             <tr>
                                <td><label class="fw-bold" for="sample_convexity_confirmity">Convexity Conformity</label></td>
                                <td>
                                    <field name="sample_convexity_confirmity"
                                        decoration-success="sample_convexity_confirmity == 'pass'" 
                                        decoration-danger="sample_convexity_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="sample_convexity_nabl">Convexity NABL</label></td>
                                <td>
                                    <field name="sample_convexity_nabl"
                                        decoration-success="sample_convexity_nabl == 'pass'" 
                                        decoration-danger="sample_convexity_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>

                    <!-- Perpendicularity -->
                    <div invisible="not perpendicularity_visible">
                        <h1 class="text-center">
                            <field name="perpendicularity_name" readonly="1" nolabel="1"/>
                            <field name="perpendicularity_visible" invisible="1"/>
                        </h1>
                    </div>
                    
                    <div class="custom_table_borders" invisible="not perpendicularity_visible">
                        <field name="perpendicularity_line_ids" nolabel="1" colspan="2" >
                            <tree editable="bottom" >
                                <field name='sr_no' width="120"/>
                                <field name='edge_length' class="blue-input" decoration-info="edge_length != 0" width="120"/>
                                <field name='gap_side_1' class="blue-input" decoration-info="gap_side_1 != 0" width="120"/>
                                <field name='gap_opposite_side_1' class="blue-input" decoration-info="gap_opposite_side_1 != 0" width="120"/>

                                <field name='largest_gap' width="120"/>
                                
                                <field name='permissible_gap' width="150"/>
                                <!-- <field name='maximum_gap_observed' width="120"/> -->
                            </tree> 
                         </field>   
                    </div>
                    <group/>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="perpendicularity_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="largest_gap_average">Largest Gap (mm)</label></td>
                                  <td><field name="largest_gap_average"/><span>  mm</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="largest_gap_average_confirmity">Conformity</label></td>
                                <td>
                                    <field name="largest_gap_average_confirmity"
                                        decoration-success="largest_gap_average_confirmity == 'pass'" 
                                        decoration-danger="largest_gap_average_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="largest_gap_average_nabl">NABL</label></td>
                                <td>
                                    <field name="largest_gap_average_nabl"
                                        decoration-success="largest_gap_average_nabl == 'pass'" 
                                        decoration-danger="largest_gap_average_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                     <!-- Straightness  -->
                    <div invisible="not straightness_visible">
                        <h1 class="text-center">
                            <field name="straightness_name" readonly="1" nolabel="1"/>
                            <field name="straightness_visible" invisible="1"/>
                        </h1>
                    </div>
                    
                    <div class="custom_table_borders" invisible="not straightness_visible">
                        <field name="straightness_line_ids" nolabel="1" colspan="2" >
                            <tree editable="bottom" >
                                <field name='sr_no' width="120"/>
                                <field name='edge_length' class="blue-input" decoration-info="edge_length != 0" width="120"/>
                                <field name='permissible_gap' width="150"/>
                                <field name='edge_1_gap' class="blue-input" decoration-info="edge_1_gap != 0" width="120"/>
                                <field name='edge_2_gap' class="blue-input" decoration-info="edge_2_gap != 0" width="120"/>
                                <field name='edge_3_gap' class="blue-input" decoration-info="edge_3_gap != 0" width="120"/>
                                <field name='edge_4_gap' class="blue-input" decoration-info="edge_4_gap != 0" width="120"/>
                
                                <field name='maximum_gap_observed' width="120"/>
                            </tree> 
                         </field>   
                    </div>
                    <group/>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="straightness_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="straightness_max_gap">Maximum Gap Observed (mm)</label></td>
                                  <td><field name="straightness_max_gap"/><span>  mm</span></td>
                            </tr>

                            <tr>
                                <td><label class="fw-bold" for="straightness_max_gap_confirmity">Conformity</label></td>
                                <td>
                                    <field name="straightness_max_gap_confirmity"
                                        decoration-success="straightness_max_gap_confirmity == 'pass'" 
                                        decoration-danger="straightness_max_gap_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="straightness_max_gap_nabl">NABL</label></td>
                                <td>
                                    <field name="straightness_max_gap_nabl"
                                        decoration-success="straightness_max_gap_nabl == 'pass'" 
                                        decoration-danger="straightness_max_gap_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <!-- Water Absorption  -->

                       <div invisible="not water_absorption_visible">
                        <h1 class="text-center">
                            <field name="water_absorption_name" readonly="1" nolabel="1"/>
                            <field name="water_absorption_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                       <div class="custom_table_borders" invisible="not water_absorption_visible">
                        <field name="water_absorption_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='dry_mass_w1' class="blue-input" decoration-info="dry_mass_w1 != 0"/>
                                <field name='saturated_mass_w2' class="blue-input" decoration-info="saturated_mass_w2 != 0"/>
                                <field name='gain_in_mass'/>
                                <field name='water_absorption'/>
                                  
                            </tree>  
                         </field>    
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="water_absorption_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_water_absorption">Average Water Absorption (%)</label></td>
                                  <td><field name="average_water_absorption"/><span>  mm</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_water_absorption_confirmity">Conformity</label></td>
                                <td>
                                    <field name="average_water_absorption_confirmity"
                                        decoration-success="average_water_absorption_confirmity == 'pass'" 
                                        decoration-danger="average_water_absorption_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="average_water_absorption_nabl">NABL</label></td>
                                <td>
                                    <field name="average_water_absorption_nabl"
                                        decoration-success="average_water_absorption_nabl == 'pass'" 
                                        decoration-danger="average_water_absorption_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>





                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     


                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>