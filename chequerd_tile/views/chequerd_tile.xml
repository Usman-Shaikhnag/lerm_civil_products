        <record id="mechanical_cheequered_tile_view" model="ir.ui.view">
        <field name="name">mechanical.chequered.tiles.form</field>
        <field name="model">mechanical.chequered.tiles</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   <div >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>
                   
       
                   <!-- Chequered Tiles -->
                    <div>
                        <h1>
                            <field name="chequered_tiles_name1" readonly="1" nolabel="1"/>
                            <field name="chequered_tiles_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="chequered_tiles_lines" nolabel="1" colspan="2" >
                            <tree editable="bottom">
                                <field name='sr_no'/>
                                <field name='flatness1'/>
                                <field name='flatness2'/>
                                <field name='flatness3'/>
                                <field name='flatness4'/>

                                <field name='perpendicularity1'/>
                                <field name='perpendicularity2'/>
                                <field name='perpendicularity3'/>
                                <field name='perpendicularity4'/>

                                <field name='straightness1'/>
                                <field name='straightness2'/>
                                <field name='straightness3'/>
                                <field name='straightness4'/>
                                
                            </tree>
                         </field> 
                    </div>



                    <div style="display:flex;">
                    <div style="width:50%;">
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                    <tbody>
                      <tr>
                        <td><label for="average_flatness" class="text-bold">Average Flatness (mm)</label></td>
                        <td><field name='average_flatness' col="4"/></td>
                      </tr>
                      <tr>
                        <td><label for="average_perpendicularity" class="text-bold">Average Perpendicularity (%)</label></td>
                        <td><field name='average_perpendicularity'  col="4"/></td>
                      </tr>
                      <tr>
                        <td><label for="average_straightness" class="text-bold">Average Straightness (%)</label></td>
                        <td><field name='average_straightness' col="4"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>

                    <div style="width:50%;">
                    <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><label for="deviation_flatness" class="text-bold">Flatness,mm</label></td>
                        <td><field name='deviation_flatness' col="4"/></td>
                      </tr>
                      <tr>
                        <td><label for="deviation_perpendicularity" class="text-bold">Perpendicularity,(%)</label></td>
                        <td><field name='deviation_perpendicularity'  col="4"/></td>
                      </tr>
                      <tr>
                        <td><label for="deviation_length_straightness" class="text-bold">Straightness,(%)</label></td>
                        <td><field name='deviation_length_straightness' col="4"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>
                    </div>
                    <group/>
