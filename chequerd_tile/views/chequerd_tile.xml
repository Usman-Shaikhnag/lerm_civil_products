                        <td><field name='average_straightness_conformity'
                                       decoration-success="average_straightness_conformity == 'pass'" 
                                       decoration-danger="average_straightness_conformity == 'fail'" 
                                       readonly="1"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>

                    <div style="width:50%;">
