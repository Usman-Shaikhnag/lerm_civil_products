                       <!-- WATER ABSORPTION -->

                       <div>
                        <h1>
                            <field name="chequered_water_absorption_name1" readonly="1" nolabel="1"/>
                            <field name="chequered_water_absorption_visible" invisible="1"/>
                        </h1>
