									<!-- <td t-if="eln.conformity" style="text-align: center;">
										<span t-field="cutter.avg_3_days_conformity"/>
									</td> -->
								</tr>




								

								

							</tbody>
						</table>
					</div>         


					<table style="margin-top: 20px;" t-if="cutter.core_cutter_visible and (cutter.avg_compaction_nabl == 'pass' and nabl or (cutter.avg_compaction_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							<tr>
