<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="isat_datasheet">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			<t t-call="lerm_civil.data_sheet_header_generaltemplate">
                <div style="text-align:center;font-size:18px">
                    ISAT
                </div>
                <div class="container_eln" style="margin-top:5px">


                <div style="margin-top:20px">
						<table style="margin-top:20px">
							<tr cols="12">
								<td colspan="1">Sr no 
								</td>
								<td colspan="1">Sample No
								</td>
								<td colspan="1">Age Days
								</td>
								<td colspan="1">Time Hrs
								</td>
								<td colspan="1">Elapse Time min 
								</td>
								<td colspan="1">No of scale Division in 5 sec
								</td>
								<td colspan="1">Period During Movement Measured
								</td>
								<td colspan="1">No of Scale division moved during selected period
								</td>
								<td colspan="1">No of Scale division in  1 min
								</td>
								<td colspan="1">ISAT ml/m2/sec
								</td>
								<td colspan="1">Correction Factor
								</td>
								<td colspan="1">ISAT Corrected to Equ 27°C ml/m2/sec
								</td>
								
							</tr>

							<t t-set="i" t-value="0"/>
							<tr t-foreach="data.isat_child_lines" t-as="r">
									<t t-set="i" t-value="i+1"/>
									<tr t-foreach="r['child_lines']" t-as="j" cols="12">
										<td colspan="1">
											<div>
												<span t-esc="i"/>
											</div>
										</td>
										<td colspan="1">
											<span t-esc="r['sample_id']"/>
										</td>
										<td colspan="1">
											<span t-esc="r['age_days']"/>
										</td>
										<td colspan="1">
											<span t-esc="r['time_hrs']"/>
										</td>
										<td colspan="1">
										<span t-esc="j['elapsed_time']"/>
										</td>
										<td colspan="1">
											<span t-esc="j['no_of_scale_div_5sec']"/>
										</td>
										<td colspan="1">
											<span t-esc="j['period_movement_measured']"/>
										</td>
										<td colspan="1">
											<span t-esc="j['no_of_div_moved_selected_period']"/>
										</td>
										<td colspan="1">
											<span t-esc="j['no_of_scale_div_1min']"/>
										</td>
										<td colspan="1">
											<span t-esc="j['isat_sec']"/>
										</td>
										<td colspan="1">
											<span t-esc="j['correction_factor']"/>
										</td>
										<td colspan="1">
											<span t-esc="j['isat_corrected']"/>
										</td>
									</tr>
								<!-- </td> -->
								
							</tr>
						</table>
						

				</div>
				</div>

				<div class="authorizeRowDataSheet">

                        <div>
                            <div>
                                <b>
                                    Tested By 
                                </b>
                                
                            </div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>

                            <div>
                                <b>
                                <span t-esc="eln.sample_id.check_by.name"/>
                                </b>
                            </div>
                            
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.check_by.job_title"/>)
                                </b>
                            </div>
                        </div>
						
					</div>
			</t>
		</t>
	</template>


     <template id="isat_mech_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">NA</t>
								</td>

                                <!-- <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td> -->
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">NA</t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <!-- <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td> -->
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
									       <span t-field="o.material.lab_name"/> <![CDATA[&nbsp;]]>
											<span t-field="o.sample_id.size_id"/>   
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">NA</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<!-- <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">NA</t> -->
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="3">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<!-- <td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">NA</t>
										</td> -->
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_temperature is not None">
											<span t-field="brick.brick_temperature"/>   °C
										</t>
									<t t-else="">NA</t> -->
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_humidity is not None">
											<span t-field="brick.brick_humidity"/>   °C
										</t>
									<t t-else="">NA</t> -->
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">NA</t>
								</td>
								
							</tr>

							</table>
					</div>
					
                    <table style="margin-top:15px">
                        <tr cols='12'>
                            <td colspan="1" style="border-bottom:none">Sr No</td>
                            <td colspan="2" style="border-bottom:none">ID Mark</td>
                            <td colspan="1" style="border-bottom:none">Age Days</td>
                            <td colspan="3" >Initial Surface Absorption</td>
                            <td colspan="3" >Initial Surface Absorption Corrected to Equivalent 27º C</td>
                            <td colspan="2" style="border-bottom:none">Comments</td>

						</tr>
                        <tr cols='12'>
                            <td colspan="1" style="border-top:none"></td>
                            <td colspan="2" style="border-top:none"></td>
                            <td colspan="1" style="border-top:none"></td>
                            <td colspan="1" >After 10 min</td>
                            <td colspan="1">After 30 min</td>
                            <td colspan="1">After 60 min</td>
                            <td colspan="1" >After 10 min</td>
                            <td colspan="1">After 30 min</td>
                            <td colspan="1">After 60 min</td>
                            <td colspan="2" style="border-top:none"></td>

						</tr>
						<t t-set="i" t-value="0"/>
							<tr t-foreach="data.isat_child_lines" t-as="r">
                                <td colspan="1">
                                    <div>
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1" />
                                    </div>
                                </td>
								<td colspan="2">
                                <span t-field="data.isat_child_lines[i-1].sample_id"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].age_days"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[1].isat_sec"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[2].isat_sec"></span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[3].isat_sec"></span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[1].isat_corrected"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[2].isat_corrected"></span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[3].isat_corrected"></span>
                                </td>
                                <td colspan="2">
                                    <span t-field="data.isat_child_lines[i-1].comments"></span>
                                </td>
							</tr>
							<tr>
                                <td colspan="1">
                                        <span></span>
                                </td>
								<td colspan="2">
                                <span ></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
                                <td colspan="1">
                                <span>Average</span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.average_10min"></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
                                <td colspan="1">
                                <span ></span>
                                </td>
                                <td colspan="2">
                                    <span ></span>
                                </td>
							</tr>
                    </table>

					<div style="page-break-inside: avoid;">
						<div style="margin-top:20px" class="noteContainer">
							<table>
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>

							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
							</div>
						</div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
						</div>
					</div>

				</div>
			</t>
		</t>
	</template>
</odoo>