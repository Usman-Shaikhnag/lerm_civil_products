								<td colspan="12">#Project / Site Address : <![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Sample Description : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td colspan="6">Test Start Date :<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
								<td colspan="6">Test End Date :<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Sample Id Mark: <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.client_sample_id"/>
								</td>
								<td colspan="6">Sample Receipt Date :<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Size :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								<td colspan="6">#Grade :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Brand :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.brand"/>
								</td>
								<td colspan="6">#Consultant Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.consultant_name1"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Client Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
								</td>
								<td colspan="6">#Client Reference :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client_refrence"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Discipline :
									<![CDATA[&nbsp;]]>
									<span t-field="o.discipline.discipline"/>
								</td>
								<td colspan="6">Group :
									<![CDATA[&nbsp;]]>
									<span t-field="o.group.group"/>
								</td>
							</tr>

							<tr>
								<td colspan="12">Material/Test Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
							</tr>
						</table>
					</div>

				   <div style="margin-top:10px">
					  Test Method :  IS 516(Part2/Sec2):2018
					</div>
					
                    <table t-if="data.isat_visible" style="margin-top:15px">
                        <tr cols='12'>
                            <td colspan="1" style="border-bottom:none">Sr No</td>
                            <td colspan="2" style="border-bottom:none">ID Mark</td>
                            <td colspan="1" style="border-bottom:none">Age Days</td>
                            <td colspan="3" >Initial Surface Absorption</td>
                            <td colspan="3" >Initial Surface Absorption Corrected to Equivalent 27º C</td>
                            <td colspan="2" style="border-bottom:none">Comments</td>

						</tr>
                        <tr cols='12'>
                            <td colspan="1" style="border-top:none"></td>
                            <td colspan="2" style="border-top:none"></td>
                            <td colspan="1" style="border-top:none"></td>
                            <td colspan="1" >After 10 min</td>
                            <td colspan="1">After 30 min</td>
                            <td colspan="1">After 60 min</td>
                            <td colspan="1" >After 10 min</td>
                            <td colspan="1">After 30 min</td>
                            <td colspan="1">After 60 min</td>
                            <td colspan="2" style="border-top:none"></td>

						</tr>
						<t t-set="i" t-value="0"/>
							<tr t-foreach="data.isat_child_lines" t-as="r">
                                <td colspan="1">
                                    <div>
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1" />
                                    </div>
                                </td>
								<td colspan="2">
                                <span t-field="data.isat_child_lines[i-1].sample_id"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].age_days"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[1].isat_sec"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[2].isat_sec"></span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[3].isat_sec"></span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[1].isat_corrected"></span>
                                </td>
								<td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[2].isat_corrected"></span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.isat_child_lines[i-1].child_lines[3].isat_corrected"></span>
                                </td>
                                <td colspan="2">
                                    <span t-field="data.isat_child_lines[i-1].comments"></span>
                                </td>
							</tr>
							<tr>
                                <td colspan="1">
                                        <span></span>
                                </td>
								<td colspan="2">
                                <span ></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
                                <td colspan="1">
                                <span>Average</span>
                                </td>
                                <td colspan="1">
                                <span t-field="data.average_10min"></span>
                                </td>
								<td colspan="1">
                                <span ></span>
                                </td>
                                <td colspan="1">
                                <span ></span>
                                </td>
                                <td colspan="2">
                                    <span ></span>
                                </td>
							</tr>
                    </table>


					<div t-if="data.isat_of_concrte_visible" style="margin-top:20px">
								
				            <table  style="margin-top:20px;">
								<thead>
									<tr>
										<th>
											<span>
											Sr No
											</span>
										</th>
										<th>
											<span>
												Description
											</span>
										</th>

										
										<th>
											<span>
												Initial Surface Absorption in ml/m2.sec  at 10 Minute
											</span>
										</th>
										<th>
											<span>
												Initial Surface Absorption Corrected to Equivalent 27°C  ml/m2.sec
											</span>
										</th>
										<t t-if="data.isat_of_concrete_lines and data.isat_of_concrete_lines[0].intial_surface30">
										<th>
											<span>
												Initial Surface Absorption in ml/m2.sec  at 30 Minute
											</span>
										</th>
										</t>

										<t t-if="data.isat_of_concrete_lines and data.isat_of_concrete_lines[0].intial_surface60">

										<th>
											<span>
												Initial Surface Absorption in ml/m2.sec  at 60 Minute
											</span>
										</th>
										</t>
										<th>
											<span>
												Remark
											</span>
										</th>
									
									</tr>
								</thead>
								<tbody>
									<t t-set="i" t-value="0"/>
									<t t-set="total_lines" t-value="len(data.isat_of_concrete_lines)"/>
									<tr t-foreach="data.isat_of_concrete_lines" t-as="r">
										<td>
											<div>
												<span t-esc="i + 1" />
												<t t-set="i" t-value="i+1"/>
											</div>
										</td>
										<td>
											<span t-esc="r.id_mark"/>
										</td>
										
										<td>
											<span t-esc="r.intial_surface10"/>
										</td>
										<td>
											<span t-esc="r.intial_surface_corrected"/>
										</td>
										<t t-if="r.intial_surface30">
										<td>
											<span t-esc="r.intial_surface30"/>
										</td>
										</t>

										<t t-if="r.intial_surface60">
										<td>
											<span t-esc="r.intial_surface60" />
										</td>

									 </t>

									<t t-if="i == 1">
										<td t-att-rowspan="total_lines" style="vertical-align: middle; text-align: center;">
											<span t-esc="r.remark"/>
										</td>
									</t>
									</tr>
								</tbody>
						</table>

					
					</div>

					<div style="page-break-inside: avoid;">
						<div style="page-break-inside: avoid;">
								<div style="page-break-inside: avoid; margin-top: 20px;" class="noteContainer">
									<ul>
										<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<li>
													<span t-esc="n.sr_no"/>. <span t-esc="n.notes"/>
												</li>
											</t>
										</t>
										<li t-if="eln.has_witness">
											Test witnessed by : <span t-esc="eln.witness_name"/>
										</li>
										<li t-if="eln.remarks">
											<span t-esc="eln.remarks"/>
										</li>
									</ul>
								</div>
							</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>
							<div>
								<div >
									<img t-attf-src="/lerm_civil/static/src/img/stamp.png" alt="Image"/>
								</div>
								<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
								</div>
							</div>
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.approveby_signature_required">
									<div t-if="eln.sample_id.approved_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
							</div>
						</div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
						</div>
					</div>

				</div>
				</t>
			</t>
		</t>
	</template>
</odoo>