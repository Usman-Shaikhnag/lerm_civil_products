<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    

        <record id="mech_isat_form" model="ir.ui.view">
        <field name="name">mech.isat.form</field>
        <field name="model">mech.isat</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                <div >
                    <h1>
                    
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                </div>
                <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="eln_state" />
                </group>

                 <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <group>
                        <field name="isat_child_lines" colspan="2" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
        </field>
        </record>

        <record id="mech_isat_line_form" model="ir.ui.view">
        <field name="name">mech.isat.line.form</field>
        <field name="model">mech.isat.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                    <field name='sample_id' style="width:30%" class="blue-input" />
                    <field name='age_days' style="width:30%" class="blue-input" />
                    <field name='time_hrs' style="width:30%" class="blue-input" />
                    <field name='child_lines' colspan="2" nolabel="1" >
                        <tree editable="bottom">
                            <field name="elapsed_time"/>
                            <field name="no_of_scale_div_5sec" class="blue-input" decoration-info="no_of_scale_div_5sec != 0"/>
                            <field name="period_movement_measured" class="blue-input" decoration-info="period_movement_measured != 0"/>
                            <field name="no_of_div_moved_selected_period" class="blue-input" decoration-info="no_of_div_moved_selected_period != 0" />
                            <field name="no_of_scale_div_1min" class="blue-input" decoration-info="no_of_scale_div_1min != 0" />
                            <field name="isat_sec"/>
                            <field name="correction_factor" class="blue-input" decoration-info="correction_factor != 0" />
                            <field name="isat_corrected"/>
                        </tree>
                    </field>

                    </group>
                    <group>
                        <field name="comments" class="blue-input" decoration-info="comments != 0"/>
                    </group>
                     

                </sheet>
            </form>
        </field>
        </record>

        <record id="mech_isat_line_tree" model="ir.ui.view">
        <field name="name">mech.isat.line.tree</field>
        <field name="model">mech.isat.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name='sample_id'/>
                <field name='age_days'/>
                <field name='time_hrs'/>
                <!-- <field name='child_lines'/> -->
                <field name="child_lines" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    </data>
</odoo>