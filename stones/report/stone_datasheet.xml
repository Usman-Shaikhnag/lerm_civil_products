								<td rowspan="2" style="text-align: center;"><b>Duration of test (sec)</b></td>
								<td rowspan="2" style="text-align: center;"><b>Appearance/any unusual features at failure</b></td>
								<td rowspan="2" style="text-align: center;"><b>H/d</b></td>
