<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stones_datasheet">
         <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px;font-weight: bold">
                    STONE DATASHEET
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>
                        <!-- <tr>
                            <td colspan="6">Age at Test: <span t-field="data.age_of_days"></span>
                            </td>
                            <td colspan="6">Sample Conditioning: <span t-field="data.sample_condition"></span>
                            </td>
                        </tr> -->
                    </table>
					
					<table>
						<tr style="height:50px" cols="12">
                            <td colspan="4">Performed By :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.technician.name"/>
                            </td>
                            <td colspan="4">Witness Name :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.witness_name"/>
                            </td>
                            <td colspan="4">Witness Signature :
                                <![CDATA[&nbsp;]]>
                                <span style='padding:20px'></span>
                            </td>
                        </tr>
					</table>


                    <!-- Compressive Strength -->

                    <div t-if="data.compressive_visible" style="margin-top:20px">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Compressive Strength
							</div>

							<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Sr.No</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Specimen ID</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Diameter (mm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Width (mm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Thickness/Height (mm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Cross-sectional Area  (mm²)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Maximum Load at Failure (kN)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">UCS (MPa = Load × 1000 / Area)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Failure Description</th>
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.compressive_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['specimen_id']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['diameter']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['width']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['thickness']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['cross_section_area']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['max_load']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['ucs']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['failure_description']" />
									</td>
									
								</tr>
							</tbody>
						</table>


						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average UCS (MPa) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.average_ucs" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
						</table>
						
								
								
										

							<div t-if="data.compressive_visible" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
									
						</div>
						



                    <!-- Water Absorption -->

                        <div t-if="data.water_absorption_visible" style="margin-top:20px">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Water Absorption
							</div>

							<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Sr.No</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Description of Stone</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Oven Dry Weight, Wd (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Saturated Weight, Ws (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Water Absorption (%)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Remarks</th>
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.water_absorption_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['description']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['oven_dry_weight']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['saturated_weight']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['remarks']" />
									</td>
									
								</tr>
							</tbody>
						</table>


						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Water Absorption (%) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_water_absorption" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
						</table>
						
								
								
										

							<div t-if="data.water_absorption_visible" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
									
						</div>


                        <!-- True Specific Gravity -->

                        <div t-if="data.true_specific_visible" style="margin-top:20px">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								True Specific Gravity
							</div>

							<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Sr.No</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">W1 Empty Bottle (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">W2 Bottle + Powder (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">W3 Bottle + Powder + Water (g)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">W4 Bottle + Water (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">True Specific Gravity</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Remarks</th>
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.true_specific_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w1']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w2']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w3']" />
									</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w4']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['true_specific_gravity']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['remarks']" />
									</td>
									
								</tr>
							</tbody>
						</table>


						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average True Specific Gravity :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_true_specific_gravity" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
						</table>
						
								
								
										

							<div t-if="data.true_specific_visible" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
									
						</div>
						


                <!-- Apparent Specific Gravity -->

                        <div t-if="data.app_specific_visible" style = "page-break-before: always;margin-top:20px;">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Apparent Specific Gravity
							</div>
						
								
								<table>
											<tr>
												<th style="text-align: center; font-weight: bold;">Sample No</th>
												<th style="text-align: center; font-weight: bold;">Sample 1</th>
												<th style="text-align: center; font-weight: bold;">Sample 2</th>
                                                <th style="text-align: center; font-weight: bold;">Sample 3</th>
											</tr>
											<tr>
												<td style="font-weight: bold;text-align: center;">Dry Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.sample1_dry_weight"/></td>
												<td style="text-align: center;"><span t-field="data.sample2_dry_weight"/></td>
                                                <td style="text-align: center;"><span t-field="data.sample3_dry_weight"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;text-align: center;">Suspended Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.sample1_suspended_weight"/></td>
												<td style="text-align: center;"><span t-field="data.sample2_suspended_weight"/></td>
                                                <td style="text-align: center;"><span t-field="data.sample3_suspended_weight"/></td>
											</tr>
                                            <tr>
												<td style="font-weight: bold;text-align: center;">Saturated Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.sample11_saturated_weight"/></td>
												<td style="text-align: center;"><span t-field="data.sample22_saturated_weight"/></td>
                                                <td style="text-align: center;"><span t-field="data.sample33_saturated_weight"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;text-align: center;">Apparent Specific Gravity</td>
												<td style="text-align: center;"><span t-field="data.sample1_apparent_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td>
												<td style="text-align: center;"><span t-field="data.sample2_apparent_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td style="text-align: center;"><span t-field="data.sample3_apparent_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;text-align: center;">Average Apparent Specific Gravity</td>
												<td colspan="3" style="text-align: center;"><span t-field="data.avg_apparent_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
										</table>

							<div t-if="data.water_absorption_visible" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
									
						</div>


                        






					
                    
                   <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								<div style="height: 40px;">
						<!-- <t t-if="eln.sample_id.testedby_signature_required"> -->
							<t t-if="eln.tested_by_signature_datasheet">

								<div t-if="eln.sample_id.filled_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
                    
                </div>

            </t>
        </t>
    </template>
    </odoo>