                                </td>  

								<td   style="text-align: center;">
                                    <span t-esc="r['area_stone']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>     
								<td   style="text-align: center;">
                                    <span t-esc="r['compressive_perpendiculer']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>     

                                <td   style="text-align: center;">
                                    <span t-esc="r['compressive_parallel']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>    
                                <td colspan="1"  style="text-align: center;">
                                    <span t-esc="r['stress_perpendiculer']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>    
                                <td colspan="1"  style="text-align: center;">
                                    <span t-esc="r['stress_parallel']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>    
								
                                
