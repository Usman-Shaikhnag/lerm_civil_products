                                </td>
								<td   style="text-align: center;">
                                    <span t-esc="r['lab_id']"/>
                                </td>
								<td   style="text-align: center;">
                                    <span t-esc="r['room_temp']"/>
                                </td>
								
                                <td   style="text-align: center;">
                                    <span t-esc="r['relative_humidity']"/>
                                </td>
                               
                             
                                 <td   style="text-align: center;">
                                    <span t-esc="r['functional_check']" />
                                </td>
                                <td   style="text-align: center;">
                                    <span t-esc="r['stone_type']" />
                                </td>
								<td   style="text-align: center;">
                                    <span t-esc="r['shape_stone']" />
                                </td>
								<td   style="text-align: center;">
                                    <span t-esc="r['height_shape']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>   
								<td   style="text-align: center;">
                                    <span t-esc="r['width_stone']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>     
									<td   style="text-align: center;">
                                    <span t-esc="r['test_conditin']"/>
                                </td>   
								
								<td   style="text-align: center;">
                                    <span t-esc="r['load_perpendiculer']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>   
								<td   style="text-align: center;">
                                    <span t-esc="r['load_parallel']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>    
								<td   style="text-align: center;">
                                    <span t-esc="r['load_perpendiculer_n']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>   

								<td   style="text-align: center;">
                                    <span t-esc="r['load_parallel_n']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>   
								<td   style="text-align: center;">
