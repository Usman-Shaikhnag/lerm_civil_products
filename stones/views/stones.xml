<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_stones" model="ir.ui.view">
        <field name="name">mechanical.stones.form</field>
        <field name="model">mechanical.stones</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name_stones" readonly="1" nolabel="1"/>
                    </h1>
                    <group style="white-space: nowrap; width:70%;">
                     
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                       
                        </group>
                    <group>
                       <field name="grade"/>
                    </group>

                    <group>

                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="size_id"/>
                        
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>
                    <group/>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */
                            
                        }
                        .o_list_view td.blue-input,
                        .o_list_view .o_data_cell.blue-input,
                         .o_list_view .o_data_cell .blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view td.blue-input input,
                        .o_list_view .o_data_cell.blue-input input,
                        .o_list_view .o_data_cell .blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                     <!-- Compressive Strength in dry condition -->

                    <div invisible = "compressive_dry_visible == False">
                        <h1 class="text-center">
                            <field name="compressive_dry_name" readonly="1" nolabel="1"/>
                            <field name="compressive_dry_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-2" invisible = "compressive_dry_visible == False">
                        

                         <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Constant Factor A</span></td>
                                <td><field name='factor_a' col="1" class="blue-input"/></td>
                            </tr>
                            
                            
                            </tbody>
                        </table>


                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Constant Factor B</span></td>
                                <td><field name='factor_b' col="1" class="blue-input"/></td>
                            </tr>
                           
                            </tbody>
                        </table>
                    </div>
                        
                     <div invisible = "compressive_dry_visible == False">
                        
                        <field name="compressive_dry_ids">
                            <tree editable="bottom" class="custom_table_borders">

                                
                                <field name="serial_no"  />
                                    <field name="date"  class="blue-input" decoration-info="date != 0"/>
                                    <field name="room_temp" width="100"  class="blue-input" decoration-info="room_temp != 0"/>
                                    <field name="relative_humidity" width="100" class="blue-input" decoration-info="relative_humidity != 0"/>
                                    
                                    <!-- ✅ Wrap long text fields -->
                                    <field name="functional_check" width="180" widget="char" style="white-space: normal;" class="blue-input" />
                                    <field name="stone_type" width="150" style="white-space: normal;" class="blue-input" decoration-info="stone_type != 0"/>
                                    <field name="shape_stone" width="160" style="white-space: normal;" class="blue-input" decoration-info="shape_stone != 0"/>
                                   

                                    <field name="height_shape" width="100"  class="blue-input" decoration-info="height_shape != 0"/>
                                    <field name="width_stone" width="100"  class="blue-input" decoration-info="width_stone != 0"/>
                                     <field name="test_conditin" width="150" style="white-space: normal;" />
                                    <field name="load_perpendiculer" width="150" class="blue-input" decoration-info="load_perpendiculer != 0"/>
                                    <field name="load_parallel" width="150" class="blue-input" decoration-info="load_parallel != 0"/>
                                    <field name="load_perpendiculer_n" width="150" class="blue-input" decoration-info="load_perpendiculer_n != 0"/>
                                    <field name="load_parallel_n" width="150" />
                                    <field name="duration_test" width="120" class="blue-input" decoration-info="duration_test != 0"/>
                                    <field name="appearance_stone" width="180" class="blue-input" decoration-info="appearance_stone != 0"/>
                                    <field name="hd_stone" width="100"/>
                                    <field name="area_stone" width="120"/>
                                    <field name="compressive_perpendiculer" width="200"/>
                                    <field name="compressive_parallel" width="200"/>
                                    <field name="stress_perpendiculer" width="180"/>
                                    <field name="stress_parallel" width="180"/>
                                     <field name="compressive_perpendiculer1" width="180"/>
                                      <field name="compressive_parallel1" width="180"/>


                            </tree>
                        </field>
                    </div>

                    <div class="d-flex gap-2" invisible = "compressive_dry_visible == False">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                 <tr>
                                 <td><label class="text-bold" for="compressive_perpendiculer_avg">Average Compressive Strength Parallel Dry (N/mm²)</label></td>
                                <td><field name='compressive_perpendiculer_avg' col="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_perpendiculer_avg_conformity">Conformity</label></td>
                                <td>
                                    <field name="compressive_perpendiculer_avg_conformity"
                                        decoration-success="compressive_perpendiculer_avg_conformity == 'pass'"
                                        decoration-danger="compressive_perpendiculer_avg_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_perpendiculer_avg_nabl">NABL</label></td>
                                <td>
                                    <field name="compressive_perpendiculer_avg_nabl"
                                        decoration-success="compressive_perpendiculer_avg_nabl == 'pass'"
                                        decoration-danger="compressive_perpendiculer_avg_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                <td><label class="text-bold" for="compressive_parallel_avg">Average Compressive Strength Parallel Dry (N/mm²)</label></td>
                                <td> <field name='compressive_parallel_avg' col="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_parallel_avg_conformity">Conformity</label></td>
                                <td>
                                    <field name="compressive_parallel_avg_conformity"
                                        decoration-success="compressive_parallel_avg_conformity == 'pass'"
                                        decoration-danger="compressive_parallel_avg_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_parallel_avg_nabl">NABL</label></td>
                                <td>
                                    <field name="compressive_parallel_avg_nabl"
                                        decoration-success="compressive_parallel_avg_nabl == 'pass'"
                                        decoration-danger="compressive_parallel_avg_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table>
                    </div>




                     <!-- Compressive Strength in wet condition -->

                    <div invisible = "compressive_wet_visible == False">
                        <h1 class="text-center">
                            <field name="compressive_wet_name" readonly="1" nolabel="1"/>
                            <field name="compressive_wet_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-2" invisible="compressive_wet_visible == False">
                        

                         <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Constant Factor A</span></td>
                                <td><field name='wet_factor_a' col="1" class="blue-input"/></td>
                            </tr>
                            
                            
                            </tbody>
                        </table>


                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Constant Factor B</span></td>
                                <td><field name='wet_factor_b' col="1" class="blue-input"/></td>
                            </tr>
                           
                            </tbody>
                        </table>
                    </div>

                 


        
                      
                     <div invisible="compressive_wet_visible == False">
                            <field name="compressive_wet_ids">
                                <tree editable="bottom" class="custom_table_borders" string="Compressive Wet Test Readings">
                                
                                    <field name="serial_no"/>
                                    <field name="date"   class="blue-input" decoration-info="date != 0"/>
                                    <field name="room_temp" width="100" class="blue-input" decoration-info="room_temp != 0"/>
                                    <field name="relative_humidity" width="100" class="blue-input" decoration-info="relative_humidity != 0"/>
                                    
                                    <!-- ✅ Wrap long text fields -->
                                    <field name="functional_check" width="180" widget="char" style="white-space: normal;" class="blue-input" />
                                    <field name="stone_type" width="150" style="white-space: normal;" class="blue-input" decoration-info="stone_type != 0"/>
                                    <field name="shape_stone" width="160" style="white-space: normal;" class="blue-input" decoration-info="shape_stone != 0"/>
                                    

                                    <field name="height_shape" width="100" class="blue-input" decoration-info="height_shape != 0"/>
                                    <field name="width_stone" width="100" class="blue-input" decoration-info="width_stone != 0"/>
                                    <field name="test_conditin" width="150" style="white-space: normal;" />
                                    <field name="load_perpendiculer" width="150" class="blue-input" decoration-info="load_perpendiculer != 0"/>
                                    <field name="load_parallel" width="150" class="blue-input" decoration-info="load_parallel != 0"/>
                                    <field name="load_perpendiculer_n" width="150"/>
                                    <field name="load_parallel_n" width="150"/>
                                    <field name="duration_test" width="120" class="blue-input" decoration-info="duration_test != 0"/>
                                    <field name="appearance_stone" width="180" class="blue-input" decoration-info="appearance_stone != 0"/>
                                    <field name="hd_stone" width="100"/>
                                    <field name="area_stone" width="120"/>
                                    <field name="compressive_perpendiculer" width="200"/>
                                    <field name="compressive_parallel" width="200"/>
                                    <field name="stress_perpendiculer" width="180"/>
                                    <field name="stress_parallel" width="180"/>

                                    <field name="compressive_perpendiculer1" width="180"/>
                                    <field name="compressive_parallel1" width="180"/>
                                </tree>
                            </field>
                        </div>

                        <div class="d-flex gap-2" invisible = "compressive_wet_visible == False">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                 <tr>
                                 <td><label class="text-bold" for="compressive_perpendiculer_wet_avg">Average Compressive Strength Perpendicular Wet (N/mm²)</label></td>
                                <td><field name='compressive_perpendiculer_wet_avg' col="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_perpendiculer_wet_avg_conformity">Conformity</label></td>
                                <td>
                                    <field name="compressive_perpendiculer_wet_avg_conformity"
                                        decoration-success="compressive_perpendiculer_wet_avg_conformity == 'pass'"
                                        decoration-danger="compressive_perpendiculer_wet_avg_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_perpendiculer_wet_avg_nabl">NABL</label></td>
                                <td>
                                    <field name="compressive_perpendiculer_wet_avg_nabl"
                                        decoration-success="compressive_perpendiculer_wet_avg_nabl == 'pass'"
                                        decoration-danger="compressive_perpendiculer_wet_avg_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                <td><label class="text-bold" for="compressive_parallel_wet_avg">Average Compressive Strength Parallel Wet (N/mm²)</label></td>
                                <td> <field name='compressive_parallel_wet_avg' col="1"/></td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_parallel_wet_avg_conformity">Conformity</label></td>
                                <td>
                                    <field name="compressive_parallel_wet_avg_conformity"
                                        decoration-success="compressive_parallel_wet_avg_conformity == 'pass'"
                                        decoration-danger="compressive_parallel_wet_avg_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="compressive_parallel_wet_avg_nabl">NABL</label></td>
                                <td>
                                    <field name="compressive_parallel_wet_avg_nabl"
                                        decoration-success="compressive_parallel_wet_avg_nabl == 'pass'"
                                        decoration-danger="compressive_parallel_wet_avg_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table>
                    </div>



                        


                     <!-- Water Absorption -->

                    <div invisible="water_absorption_visible == False" style="text-align:center">
                        <h1>
                          <field name="water_absorption_name" readonly="1" nolabel="1"/>
                          <field name="water_absorption_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible="water_absorption_visible == False" style="text-align:center">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr>
                           <td style="font-weight:bold"><span>Sample No</span></td>
                           <td  style="font-weight:bold"><span>Sample 1</span></td>
                           <td  style="font-weight:bold"><span>Sample 2</span></td>
                           <td  style="font-weight:bold"><span>Sample 3</span></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_oven_weight">Oven Dried Weight (g)</label></td>
                           <td><field  name="sample1_oven_weight"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_oven_weight"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_oven_weight"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_saturated_weight">Saturated Surface Dry Weight (g)</label></td>
                           <td><field  name="sample1_saturated_weight"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_saturated_weight"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_saturated_weight"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_water_absorption">Water Absorption (%)</label></td>
                           <td><field  name="sample1_water_absorption"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_water_absorption"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_water_absorption"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                       </tbody>
                     </table>
                    </div>

                                    
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_absorption_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption">Average Water Absorption (%)</label></td>
                                <td>
                                    <field name="avg_water_absorption"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                        decoration-success="avg_water_absorption_conformity == 'pass'"
                                        decoration-danger="avg_water_absorption_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                        decoration-success="avg_water_absorption_nabl == 'pass'"
                                        decoration-danger="avg_water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


