                           <td><field  name="sample1_apparent_specific_gravity"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_apparent_specific_gravity"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_apparent_specific_gravity"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                       </tbody>
                     </table>
                    </div>

                                    
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not app_specific_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_apparent_specific_gravity">Average Apparent Specific Gravity</label></td>
                                <td>
                                    <field name="avg_apparent_specific_gravity"/>
