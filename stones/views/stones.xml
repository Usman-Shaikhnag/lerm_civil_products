<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_stones" model="ir.ui.view">
        <field name="name">mechanical.stones.form</field>
        <field name="model">mechanical.stones</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name_stones" readonly="1" nolabel="1"/>
                    </h1>
                    <group style="white-space: nowrap; width:70%;">
                     
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                       
                        </group>
                    <group>
                       <field name="grade"/>
                    </group>

                    <group>

                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="size_id"/>
                        
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>
                    <group/>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */
                            
                        }
                        .o_list_view td.blue-input,
                        .o_list_view .o_data_cell.blue-input,
                         .o_list_view .o_data_cell .blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view td.blue-input input,
                        .o_list_view .o_data_cell.blue-input input,
                        .o_list_view .o_data_cell .blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temp"></label>
                                    </td>
                                    <td>
                                        <field name="temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                       <!-- Compressive Strength-->
                    <div invisible = "compressive_visible == False">
                        <h1 class="text-center">
                            <field name="compressive_name" readonly="1" nolabel="1"/>
                            <field name="compressive_visible" invisible="1"/>
                        </h1>
                    </div>
                    
                 
                    <div invisible = "compressive_visible == False" >
                        <field name="compressive_ids">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='serial_no' />

                                <field name='specimen_id' class="blue-input" decoration-info="specimen_id != 0" width="100"/>
                                <field name='diameter' 
                                 class="blue-input" decoration-info="diameter != 0"/>
                                <field name="width" class="blue-input" decoration-info="width != 0"/>
                                <field name='thickness' class="blue-input" decoration-info="thickness != 0"/>
                                <field name='cross_section_area' />
                                <field name='max_load' class="blue-input" decoration-info="max_load != 0"/>

                                <field name='ucs' />

                                <field name='failure_description' class="blue-input" decoration-info="failure_description != 0" width="100"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not compressive_visible">
                        <tbody>
                            <tr>
                                <td><label for="average_ucs">Average UCS (MPa)</label></td>
                                <td><field name="average_ucs"/></td>
                            </tr>
                            <tr>
                                <td><label for="average_ucs_conformity"></label></td>
                                <td><field  name="average_ucs_conformity"
                                            decoration-success="average_ucs_conformity == 'pass'" 
                                            decoration-danger="average_ucs_conformity == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                            <tr>
                                <td><label for="average_ucs_nabl"></label></td>
                                <td><field name="average_ucs_nabl"
                                            decoration-success="average_ucs_nabl == 'pass'" 
                                            decoration-danger="average_ucs_nabl == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="compressive_report_type">Report Type</label></td>
                                <td><field name="compressive_report_type" class="blue-input" decoration-info="compressive_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>


                        


                     <!-- Water Absorption -->

                    <div invisible="water_absorption_visible == False" style="text-align:center">
                        <h1>
                          <field name="water_absorption_name" readonly="1" nolabel="1"/>
                          <field name="water_absorption_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible = "water_absorption_visible == False" >
                        <field name="water_absorption_ids">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='serial_no' />

                                <field name='description' class="blue-input" decoration-info="description != 0" width="100"/>
                                <field name='oven_dry_weight' 
                                 class="blue-input" decoration-info="oven_dry_weight != 0"/>
                                <field name="saturated_weight" class="blue-input" decoration-info="saturated_weight != 0"/>
                                <field name='water_absorption' />

                                <field name='remarks' class="blue-input" decoration-info="remarks != 0" width="100"/>
                            </tree>
                        </field>
                    </div>
                               
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_absorption_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption">Average Water Absorption (%)</label></td>
                                <td>
                                    <field name="avg_water_absorption"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                        decoration-success="avg_water_absorption_conformity == 'pass'"
                                        decoration-danger="avg_water_absorption_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                        decoration-success="avg_water_absorption_nabl == 'pass'"
                                        decoration-danger="avg_water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="water_absorption_report_type">Report Type</label></td>
                                <td><field name="water_absorption_report_type" class="blue-input" decoration-info="water_absorption_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>



                    
                    <!-- True Specific Gravity -->

                    <div invisible="true_specific_visible == False" style="text-align:center">
                        <h1>
                          <field name="true_specific_name" readonly="1" nolabel="1"/>
                          <field name="true_specific_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible = "water_absorption_visible == False" >
                        <field name="true_specific_ids">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='serial_no' />

                                <field name='w1' class="blue-input" decoration-info="w1 != 0" width="100"/>
                                <field name='w2' 
                                 class="blue-input" decoration-info="w2 != 0"/>
                                <field name="w3" class="blue-input" decoration-info="w3 != 0"/>
                                <field name='w4' class="blue-input" decoration-info="w4 != 0"/>

                                <field name='true_specific_gravity' />
                                <field name='remarks' class="blue-input" decoration-info="remarks != 0" width="100"/>
                            </tree>
                        </field>
                    </div>
     
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not true_specific_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_true_specific_gravity">Average True Specific Gravity</label></td>
                                <td>
                                    <field name="avg_true_specific_gravity"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_true_specific_gravity_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_true_specific_gravity_conformity"
                                        decoration-success="avg_true_specific_gravity_conformity == 'pass'"
                                        decoration-danger="avg_true_specific_gravity_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_true_specific_gravity_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_true_specific_gravity_nabl"
                                        decoration-success="avg_true_specific_gravity_nabl == 'pass'"
                                        decoration-danger="avg_true_specific_gravity_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="true_specific_gravity_report_type">Report Type</label></td>
                                <td><field name="true_specific_gravity_report_type" class="blue-input" decoration-info="true_specific_gravity_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>







                    <!-- Apparent Specific Gravity -->

                    <div invisible="app_specific_visible == False" style="text-align:center">
                        <h1>
                          <field name="app_specific_name" readonly="1" nolabel="1"/>
                          <field name="app_specific_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible = "water_absorption_visible == False" >
                        <field name="app_specific_ids">
                            <tree editable="bottom" class="custom_table_borders">
                                <field name='serial_no' />

                                <field name='stone_description' class="blue-input" decoration-info="stone_description != 0" width="100"/>
                                <field name='oven_dry_weight' 
                                 class="blue-input" decoration-info="oven_dry_weight != 0"/>
                                <field name="saturated_weight" class="blue-input" decoration-info="saturated_weight != 0"/>
                                <field name='suspended_weight' class="blue-input" decoration-info="suspended_weight != 0"/>

                                <field name='apparent_specific_gravity' />
                                <field name='remarks' class="blue-input" decoration-info="remarks != 0" width="100"/>
                            </tree>
                        </field>
                    </div>

                                    
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not app_specific_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_apparent_specific_gravity">Average Apparent Specific Gravity</label></td>
                                <td>
                                    <field name="avg_apparent_specific_gravity"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_apparent_specific_gravity_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_apparent_specific_gravity_conformity"
                                        decoration-success="avg_apparent_specific_gravity_conformity == 'pass'"
                                        decoration-danger="avg_apparent_specific_gravity_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_apparent_specific_gravity_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_apparent_specific_gravity_nabl"
                                        decoration-success="avg_apparent_specific_gravity_nabl == 'pass'"
                                        decoration-danger="avg_apparent_specific_gravity_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="apparent_specific_gravity_report_type">Report Type</label></td>
                                <td><field name="apparent_specific_gravity_report_type" class="blue-input" decoration-info="apparent_specific_gravity_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>


                  
                 

                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>
                

                    

                  
                    <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>




        <record id="view_stone_prefill_data_form" model="ir.ui.view">
            <field name="name">stone.prefill.data.form</field>
            <field name="model">stone.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_stone_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stone.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_stone_prefill_data_form"/>
            <field name="target">new</field>
        </record>


    </data>
</odoo>