                    <!-- True Specific Gravity -->

                    <div invisible="true_specific_visible == False" style="text-align:center">
                        <h1>
                          <field name="true_specific_name" readonly="1" nolabel="1"/>
                          <field name="true_specific_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible="true_specific_visible == False" style="text-align:center">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr>
                           <td style="font-weight:bold"><span>Sample No</span></td>
                           <td  style="font-weight:bold"><span>Sample 1</span></td>
