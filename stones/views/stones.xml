                           <td><field  name="sample3_w2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_w3">Bottle + Powder + Water Weight (W3) (g)</label></td>
                           <td><field  name="sample1_w3"  colspan="1"  nolabel="1" class="blue-input"/></td>
