<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="crusher_run_mac_report">
		<t t-call="web.html_container">
			
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">--</t>
								</td>

                                <td colspan="1" >URL NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td>
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else=""></t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td>
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">-</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
											<span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">-</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<!-- <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">-</t> -->
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>

									<td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<t t-if="data.crush_temp is not None">
											<span t-field="data.crush_temp"/>   °C
										</t>
									<t t-else="">-</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="data.crush_humidity is not None">
											<span t-field="data.crush_humidity"/>   °C
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">-</t>
								</td>
								
							</tr>

							</table>
					</div>



					
					<div style="text-align:center;">
						<h4 class="mb-0" style="text-decoration: underline;">Results</h4>
					</div>
					 
					<div t-if="data.sieve_visible" style="margin-top:5px">
						<table>
							<tr cols="12">
                                <th colspan="6">1. Sieve Analysis (Gradation) :-</th>
                                <th colspan="6"><span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','c2168fff-e47c-4155-99ff-9d7dc223e768')]).test_method.test_method"/></th>
                            </tr>
							<tr cols="12">
                                <th colspan="2" style="text-align: center;">IS Sieve Size</th>
                                <th colspan="2" style="text-align: center;">Weight Retained (gms)</th>
                                <th colspan="2" style="text-align: center;">% of Weight Retained</th>
                                <th colspan="2" style="text-align: center;">% of Cumulative Wt.  Retained</th>
                                <th colspan="2" style="text-align: center;">% of wt passing</th>
								<th colspan="2" style="text-align: center;">
									<span>
										<span t-esc="eln.material.specifications"/>
									</span>
								</th>
                            </tr>
							<t t-set="k" t-value="0"/>
							<tr t-foreach="data.sieve_analysis_child_lines" t-as="r" t-if="'pan' != r['sieve_size']">
								
								<td colspan="2" style="text-align: center;">
									<t t-set="k" t-value="k+1"/>
									<t t-if="r['sieve_size']">
										<span t-esc="r['sieve_size']"/>
									</t>
								</td>
								<td colspan="2" style="text-align: center;">
									<t t-if="r['sieve_size']">
										<span t-esc="r['wt_retained']" />
									</t>
								</td>
								<td colspan="2" style="text-align: center;">
									<t t-if="r['sieve_size']">
										<span t-esc="r['percent_retained']" />
									</t>
								</td>
								<td colspan="2" style="text-align: center;">
									<t t-if="r['sieve_size']">
										<span t-esc="r['cumulative_retained']" t-options='{"widget": "float", "precision": 2}'/>
									</t>
								</td>
								<td colspan="2" style="text-align: center;">
									<t t-if="r['sieve_size']">
										<span t-esc="r['passing_percent']" t-options='{"widget": "float", "precision": 2}'/>
									</t>
								</td>
								<td colspan="2" style="text-align: center;">
									<t t-if="r['sieve_size']">
										<span t-esc="r['specific_limits']"/>
									</t>
								</td>
							</tr>
						</table>
                        
					</div>
					<div style="">
						<table style="margin-top:10px;">
						<t t-set="i" t-value="1"/>
							<thead>
								<tr>
									<th style="text-align: center;">
										<span>
											Sr. No
										</span>
									</th>
									<th style="text-align: center;">
									   <span t-esc="eln.material.test_parameter"/>
									</th>

									<th style="text-align: center;">
									<span t-esc="eln.material.result_remark"/>
									</th>

									<th style="text-align: center;">
									  <span t-esc="eln.material.unit"/>
									</th>
									
									<th rowspan="1" style="text-align: center;"> 
										<span t-field="eln.material.specifications"></span>
									</th>

									<th style="text-align: center;">
										<span t-esc="eln.material.method_reference"/>
									</th>
								</tr>
							</thead>
							<tbody>
							
							<!--  -->
							<tr t-if="data.specific_gravity_visible and (data.avg_water_absorption_nabl == 'pass' and nabl or (data.avg_water_absorption_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="water_absorption" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','2113f38a-d129-4efe-bac4-ff5826dface8')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="water_absorption.parameter_name"/>
									</td>
									
									<td style="text-align: center;">
										<span>
											<span t-field="data.avg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
										</span>									
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="water_absorption.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="water_absorption.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
									<td style="text-align: center;">
										<span>
											<t t-foreach="water_absorption.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								
								<!--  -->
								<tr t-if="data.impact_visible and (data.impact_value_nabl == 'pass' and nabl or (data.impact_value_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="impact_value" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','fbf04a49-ea53-4b14-acd4-1797e06669ae')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="impact_value.parameter_name"/>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="data.average_impact_value" t-options='{"widget": "float", "precision": 2}'/>
										</span>									
									</td>
									
									<td style="text-align: center;">
										<span>
											<span t-field="impact_value.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="impact_value.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<t t-foreach="impact_value.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								
								<!--  -->
								<tr t-if="data.elongation_fl_visible and (data.elongation_index_nabl == 'pass' and nabl or (data.elongation_index_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="elongation" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','70ef993d-d2f8-424c-9729-4e081d647bb1')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
									
										<span t-field="elongation.parameter_name"/>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="data.elongation_index"  t-options='{"widget": "float", "precision": 2}'/>
										</span>									
									</td>
									
									<td style="text-align: center;">
										<span>
											<span t-field="elongation.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="elongation.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
									<td style="text-align: center;">
										<span>
											<t t-foreach="elongation.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								
								<!--  -->
								<tr t-if="data.elongation_fl_visible and (data.flakiness_index_nabl == 'pass' and nabl or (data.flakiness_index_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="flakiness" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','c8a5f37e-1449-4794-a854-cdb169493a1a')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
									
										<span t-field="flakiness.parameter_name"/>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="data.flakiness_index"  t-options='{"widget": "float", "precision": 2}'/>
										</span>									
									</td>
									
									<td style="text-align: center;">
										<span>
											<span t-field="flakiness.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;border-top:none;">
										<span>
											<t t-foreach="flakiness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<t t-foreach="flakiness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>



					<!--  -->
					<tr t-if="data.abrasion_visible and (data.avg_abrasion_value_nabl == 'pass' and nabl or (data.avg_abrasion_value_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
						<td style="text-align: center;">
							<span t-esc="i + 1" />
							<t t-set="i" t-value="i+1"/>
						</td>
						<td>
							
							<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','b22b1917-4510-4422-9869-d75f6e8893db')]).parameter_name"/>
						</td>

						<td style="text-align: center;">
							<span>
								<span t-field="data.avg_abrasion_value" t-options='{"widget": "float", "precision": 2}'/>
							</span>									
						</td>
						<td style="text-align: center;">
							<span>
								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','b22b1917-4510-4422-9869-d75f6e8893db')]).unit.name"/>
							</span>
						</td>
						
						
						<td style="text-align: center;">
							<span>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','b22b1917-4510-4422-9869-d75f6e8893db')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.permissable_limit"/>
									</t>
								</t>
							</span>
						</td>
						<td style="text-align: center;">
							<span>
								<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','b22b1917-4510-4422-9869-d75f6e8893db')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
						</td>
						
					</tr>
							</tbody>
						</table>
					</div>



				 

					

					
					
					<div style="page-break-inside: avoid;">
                        <div style="margin-top:10px; padding:0" class="noteContainer">
                            <table >
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
                        </div>
                        <div style="margin-top:10px; page-break-inside: avoid;" class="signatureContainer girdgird">

                            <div>
