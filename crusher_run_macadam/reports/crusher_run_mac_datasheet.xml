					<!-- Sieve Analysis  -->
					<div t-if="data.sieve_visible" style="margin-top: 30px; font-family: Arial, sans-serif;">
						<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Sieve Analysis
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">IS Sieve Size</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Wt. Retained (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">% Retained</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Cum. Retained %</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Passing %</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.sieve_analysis_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['sieve_size']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['wt_retained']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['percent_retained']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['cumulative_retained']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['passing_percent']"/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;margin-bottom:5px">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
