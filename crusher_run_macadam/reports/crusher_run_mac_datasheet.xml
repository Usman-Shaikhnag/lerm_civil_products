					<!-- Aggregate Impact Value -->

					<div t-if="data.impact_visible " style="margin-top:20px; page-break-before: always;">
					<div  style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Aggregate Impact Value
