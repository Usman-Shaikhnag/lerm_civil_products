									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of surface dry sample passing 12.5mm and retained on 10mm IS sieves, W1. (gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of fraction passing 2.36mm sieve after the test, W2. (gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of fraction retained on 2.36mm sieve after the test, W3. (gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">W4 = W1 - (W2 + W3)	(gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Aggregate Impact Value (A.I.V) = (W2/W1) x 100	 (%)</th>
									
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.impact_value_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
