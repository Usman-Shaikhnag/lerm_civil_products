									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Saturated Aggregates + Basket in Water (W1) (gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Basket in Water (W2) (gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Saturated Surface Dry Aggregates in Air (W3) (gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Oven Dry Aggregates in Air (W4) (gm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Specific Gravity</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Apparent Specific Gravity</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Water Absorption (%)</th>
									
