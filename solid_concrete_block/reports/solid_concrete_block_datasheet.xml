<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="solid_block_datasheet">
    <t t-call="web.html_container">
	<t t-call="lerm_civil.mechanical_data_sheet_header">
		<div style="text-align:center;font-size:18px;font-weight: bold">
			Solid Concrete Block
		</div>
		<div class="container_eln" style="margin-top:5px">
				

           <table style="margin-top:20px">
				<tr cols="12">
					
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>
				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                 <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_name"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>

           
                    <!-- Dimension -->


                    <div  t-if="data.dimension_visible" >
					    <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 5px; margin-top: 20px;">
							Dimension
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Length in mm</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Width in mm</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Height in mm</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.dimension_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['length']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['hight']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['width']" />
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average Length :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_length" t-options='{"widget": "float", "precision": 1}'/>
								</td>
							</tr>
                            <tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average Thickness :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.avreage_height2" t-options='{"widget": "float", "precision": 1}'/>
								</td>
							</tr>
                            <tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average Width :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_width" t-options='{"widget": "float", "precision": 1}'/>
								</td>
							</tr>
						</table>
					</div>




                   



                    <!-- Compressive Strength -->

                        <div  t-if="data.compressive_visible" >
					    <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 5px; margin-top: 20px;">
							Compressive strength
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Length in mm</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Width in mm</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Thickness in mm</th><th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Area (mm²)</th>
                                    <th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Load (N)</th>
                                    <th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Compressive Strength N/mm²</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.compressive_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['length']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['width']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['thickness']" />
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['load']" />
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['compressiv_strength']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.avg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
					</div>


                    


              <!-- Block Density  -->


              <div  t-if="data.block_density_visible" >
					    <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 5px; margin-top: 20px;">
							Block Density
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Length cm</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Height cm</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Thickness cm</th><th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Volume Cm3</th>
                                    <th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Initial Weight of the Specimenkg</th>
                                    <th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Final Weight of the Specimen after Oven Dry kg</th>
                                    <th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Block Density kg/M³</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.block_density_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['length']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['heigth']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['thickness']" />
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['volume']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['intial_wt']" />
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['final_wt']" />
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['block_density']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average Block Density</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_block" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
					</div>



                    
                    
                    <!-- Moisture Movement -->

                    <div  t-if="data.moisture_movment_visible" >
					    <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 5px; margin-top: 20px;">
							 Moisture Movement
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Dry Length of the Block</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Wet Length of the Block</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Moisture Movement %</th>
                                   
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.moisture_movment_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['dry_length']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['wet_length']"/>
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['moisture_movment']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average (%):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_moisture_movment" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
					</div>
                    
                    
                    
                    <!-- Drying Shrinkage -->


                    <div  t-if="data.drying_shrinkage_visible" >
					    <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 5px; margin-top: 20px;">
							Drying Shrinkage
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Wet measuremet of the Block</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Dry Measurement of the Block</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Dry Lenth</th>
                                    <th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Drying Shrinkage %</th>
                                   
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.drying_shrinkage_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['wet_measurment']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['dry_measurment']"/>
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['dry_lengths']"/>
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['drying_shrinkage']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average (%):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_drying_shrinkage" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
					</div>


                    
                    
                    <!-- Water Absorption -->


                    <div  t-if="data.water_absorption_visible" >
					    <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 5px; margin-top: 20px;">
							Water Absorption
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="text-align: center;">
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Wet Mass of the Block (kg)</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Dry Mass of the Block (kg)</th>
									<th style="border: 1px solid black; padding: 8px;text-align: center;" colspan="2">Water Absorption %</th>
                                   
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.water_absorption_child_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['wet_mass']"/>
									</td>
									<td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['dry_mass']"/>
									</td>
                                    <td style="border: 1px solid black; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid black;">Average (%):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid black;">
									<span t-field="data.average_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>
					</div>






                    
                    
                    
                    <!-- authorizeRowDataSheet -->
                    
                     <div class="authorizeRowDataSheet">
						<div>
                            <div>
                                <b>
                                    Tested By 
                                </b>
                                
                            </div>
                             <div style="height: 40px;">
						<!-- <t t-if="eln.sample_id.testedby_signature_required"> -->
								<t t-if="eln.tested_by_signature_datasheet">

									<div t-if="eln.sample_id.filled_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>
                    
                    
                    
                </div>
                
            </t>
        </t>
    </template>

    
</odoo>