<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	
	<template id="wpt_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->
				<div class="container_eln">
					<div t-foreach="eln" t-as="o">
						
					<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">--</t>
		                            <br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 70px;"/>
									</td>
								
							</tr>
							<tr t-if="o.srf_id.name_work">
								<td colspan="1" >Project Name:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
									</td>
							</tr>

							<tr t-if="o.srf_id.client">
								<td colspan="1" >Name of Agency:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
									</td>
							</tr>
							
							<tr>
								<td style="width:25%;">Samples Description :-</td>
								<td style="width:25%;">
								      <t t-if="o.material and o.material.lab_name">
											<span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

								<td style="width:20%;">Customer's Ref. No :-</td>
								<td style="width:20%;">

								  <t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<!-- <td>Quantity of Samples :-</td>
								<td>Litre</td> -->
								<td>No. of Samples :-</td>
								<td>

								<t t-if="o.sample_id.sample_qty">
											<span t-field="o.sample_id.sample_qty"/>
										</t>
									<t t-else="">--</t>

								<t t-if="o.sample_id.uom_id">
											<span t-field="o.sample_id.uom_id"/>
										</t>
									<t t-else="">--</t>
								
								</td>

								<td>Letter Date :-</td>
								<td>
									

									<t t-if="o.srf_id.letter_date">
											<span t-field="o.srf_id.letter_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								<td>Date of Samples Received :-</td>
								<td>

									<t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								</td>

									<td>SRF No. :-</td>
										<td >

											<t t-if="o.srf_id">
											<span t-field="o.srf_id"/>
										</t>
									<t t-else="">--</t>
										</td>
								
							</tr>

							<tr>
								<td>Brand &amp; Grade :-</td>
								<td>
								<t t-if="o.sample_id.grade_id.grade">
											<span t-field="o.sample_id.grade_id.grade"/>
										</t>
									<t t-else="">--</t>
									</td>

								<td>Date of Test Initiation  :-</td>
								<td>

									<t t-if="o.start_date">
											<span t-field="o.start_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								

								<td>Size  :-</td>
								<td>

										<t t-if="o.sample_id.size_id.size">
											<span t-field="o.sample_id.size_id.size"/>
										</t>
									<t t-else="">--</t>
								</td>
								<td>Date of Test Completion  :-</td>
								<td>

									<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								

								<td>Week No.  :-</td>
								<td>

								--
								</td>
								<td>Sample ID  :-</td>
								<td>

									<t t-if="o.sample_id.kes_no">
											<span t-field="o.sample_id.kes_no"/>
										</t>
									<t t-else="">--</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Other Details:</td>
								<td colspan="3">--</td>

								
							</tr>


							<tr t-if="o.material.test_method_adopted" >
								

									<td >Test method adopted:</td>
									<td colspan="3"><span t-field="o.material.test_method_adopted"/></td>

							
							</tr>
							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

								<tr t-if="o.material.specifications">
									<td style="font-weight: bold;">Specifications</td>
									<td colspan="3"><span t-field="o.material.specifications"/></td>
								</tr>

						</table>
					</div>
					<!-- <div style="margin-top:20px;">
						<u>Protocol</u><![CDATA[&nbsp;]]>:<![CDATA[&nbsp;]]>
						IS 516(Part2 / Sec1)<![CDATA[&nbsp;]]>:<![CDATA[&nbsp;]]>2018
					</div> -->
					<div style="margin-top:10px;">
						<span t-esc="eln.material.test_parameter"/>
					</div>

					<div>
						<h6> <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','32145ght-0268-46ef-ba88-9c0453210lkit1')]).parameter_name"/></h6>
					</div>
					<t t-if="len(data.child_lines) &lt;= o.sample_id.page_break">
						<div style="margin-top:10px">
							<table style="margin-top:10px" t-if="(data.wpt_nabl == 'pass' and nabl or (data.wpt_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl and not fromEln)">

								

								<tr cols="12">
									<td style="text-align: center;">Sr no 
									</td>
									<td style="text-align: center;">Sample Id Mark
									</td>
									<td style="text-align: center;">Observation
									</td>
									<!-- <td colspan="5">Requirement
									</td> -->
									<th style="max-width: 250px; text-align: center;">
										<span>
											<span t-esc="eln.material.unit"/>
										</span>
									</th>
									<th style="max-width: 250px; text-align: center;">
										<span>
											<span t-esc="eln.material.specifications"/>
										</span>
									</th>
									<th  style="max-width: 200px; text-align: center;">
										<span>
											<span t-esc="eln.material.method_reference"/>
											
										</span>
									</th>
									
								</tr>

								<t t-set="i" t-value="0"/>
								<tr t-foreach="data.child_lines" t-as="r">
									<td style="text-align: center;">
										<div>
											<span t-esc="i + 1" />
											<t t-set="i" t-value="i+1"/>
										</div>
									</td>
									<td style="text-align: center;">
										<span t-esc="r['sample']"/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r['average']"/>
									</td>
										<td style="text-align: center; vertical-align: middle;">
											<span>
												<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','32145ght-0268-46ef-ba88-9c0453210lkit1')]).unit.name"/>
											</span>
										</td>
								
										<td  style="text-align: center; vertical-align: middle;">
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','32145ght-0268-46ef-ba88-9c0453210lkit1')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</td>
											<td  style="text-align: center; vertical-align: middle;">
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','32145ght-0268-46ef-ba88-9c0453210lkit1')]).parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.specification"/>
											</t>
										</t>
										</td>
									<!-- <td t-if="eln.conformity">
											<span t-esc="data.wpt_conformity"/>
									</td>
										-->
									
								</tr>
								
							</table>
						</div>
					</t>

					<div style="margin-top: 10px; text-align: center;">
							
								...... End Of Report......
							
						</div>

					
					
				
						<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>
							<t t-if="o.sample_id.stamp_attached">
							<div >
								<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
							</div>
							</div>
						</t>
						<div>
							<b>
								Approved By 
							</b>
							
						</div>
						<div style="height: 40px;">
							<t t-if="eln.sample_id.approveby_signature_required">
								<div t-if="eln.sample_id.approved_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>
						<div>
							<b>
							<span t-esc="eln.sample_id.approved_by.name"/>
							</b>
						</div>
						<div>
							<b>
								(<span t-esc="eln.sample_id.approved_by.job_title"/>)
							</b>
						</div>
								
							</div>
						</div>
						<!-- <div style="text-align:center;margin-top:25px">
							......End of Report......
						</div> -->
						
					<!-- </div>
				</div> -->
				<!-- </div> -->
			</t>
		</t>
	</template>
</odoo>