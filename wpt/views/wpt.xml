<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_wpt_form" model="ir.ui.view">
        <field name="name">mechanical.wpt.form</field>
        <field name="model">mechanical.wpt</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div>
                        <h1>
                        <field name="name" readonly="1" string="Water Permeability Test"/>
                        </h1>
                    </div>
                   
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id"  readonly="1"/>
                        <field name="eln_ref"  readonly="1"/>
                        <field name="eln_state" />
                        <field name="parameter_id" invisible="1"/>
                         <field name="grade"/>
                    </group>

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>
                   <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <div class="d-flex gap-2"  >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_wpt"></label></td>
                                    <td><field name="temp_wpt" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="humidity_percent_wpt"></label></td>
                                    <td><field name="humidity_percent_wpt" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2"  >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="quantity"></label></td>
                                    <td><field name="quantity" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="size"></label></td>
                                    <td><field name="size" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>


                    <div class="d-flex gap-2"  >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_casting"></label></td>
                                    <td><field name="date_of_casting" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_testing"></label></td>
                                    <td><field name="date_of_testing" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2"  >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="age_of_days"></label></td>
                                    <td><field name="age_of_days" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="age_of_test"></label></td>
                                    <td><field name="age_of_test" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2"  >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="difference"></label></td>
                                    <td><field name="difference" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        
                    </div>

                   

              
                   
                       
                   
                        <field name="child_lines" nolabel="1" class="custom_table_borders">
                        <tree editable="bottom">
                            <field name="sample" string="Sample"/>
                            <field name="depth1" string="1"/>
                            <field name="depth2" string="2"/>
                            <field name="depth3" string="3"/>
                            <field name="average" string="Average"/>
                        </tree>
                        </field>


                         <div class="d-flex gap-2"  >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_of_wpt"></label></td>
                                    <td><field name="average_of_wpt" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        
                    </div>

                     <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                          
                        
                            <tr>
                                <td><label class="fw-bold" for="wpt_conformity"></label></td>
                                <td>
                                    <field name="wpt_conformity"
                                        decoration-success="wpt_conformity == 'pass'"
                                        decoration-danger="wpt_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="wpt_nabl"></label></td>
                                <td><field name="wpt_nabl"
                                            decoration-success="wpt_nabl == 'pass'"
                                            decoration-danger="wpt_nabl == 'fail'"
                                             readonly="1"/></td>
                            </tr>
                           
                        </tbody>
                    </table>


                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                      
                   
                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>