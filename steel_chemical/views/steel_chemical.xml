<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="chemical_steel_form" model="ir.ui.view">
        <field name="name">steel.chemical.form</field>
        <field name="model">steel.chemical</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                <div>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                </div>
                <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="week_no"></label></td>
                                    <td><field name="week_no" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="other_details"></label></td>
                                    <td><field  name="other_details" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="condition"></label></td>
                                    <td><field name="condition" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                    <!-- ph at 1% -->
                    <div invisible="not carbon_visible">

                        <h1 class="text-center">
                            <field name="carbon_name" readonly="1" nolabel="1"/>
                            <field name="carbon_visible" invisible="1"/>
                        </h1>
                    </div>

                    <!-- pH -->

                    <div invisible="not carbon_visible">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                         <tbody>
                           <tr>
                           
                             <td>Nomenclature</td>
                             <td>Dia (mm)</td>
                             <td>Bar. Pressure</td>
                             <td>Ambient Temp.</td>
                             <td>Pressure-Temp. Correction Factor (F)</td>
                           </tr>
                           <tr>
                             
                             <td><field  name="nomenclature"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="dia"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="pressure"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ambient"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="correction_factor"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           </tr>
                         </tbody>
                      </table>
                    </div>

                     <div invisible="not carbon_visible">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                         <tbody>
                           <tr>
                           <td>S.No.</td>
                             <td>Type of sample</td>
                             <td>Wt. of sample (W)</td>
                             <td>Burette Reading for sample (A)</td>
                             <td>Burette Reading for Blank (B)</td>
                             <td>Calculation= (A - B) X F " </td>
                           </tr>
                           <tr>
                             <td>1</td>
                             <td><field  name="type_of_sample1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="wt_of_sample1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_a1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_b1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="carbon_calculation1"  colspan="1"  nolabel="1" /></td>
                           </tr>

                           <tr>
                             <td>2</td>
                             <td><field  name="type_of_sample2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="wt_of_sample2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_a2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_b2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="carbon_calculation2"  colspan="1"  nolabel="1" /></td>
                           </tr>

                            <tr>
                             <td>3</td>
                             <td><field  name="type_of_sample3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="wt_of_sample3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_a3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_b3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="carbon_calculation3"  colspan="1"  nolabel="1" /></td>
                           </tr>

                           <tr>
                             <td>4</td>
                             <td><field  name="type_of_sample4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="wt_of_sample4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_a4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_b4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="carbon_calculation4"  colspan="1"  nolabel="1" /></td>
                           </tr>

                           <tr>
                             <td>4</td>
                             <td><field  name="type_of_sample5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="wt_of_sample5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_a5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="br_reading_b5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="carbon_calculation5"  colspan="1"  nolabel="1" /></td>
                           </tr>
                         </tbody>
                      </table>
                    </div>

                    <div invisible="not carbon_visible">
                      <table  class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                      <tbody>
                      <tr>
                          <td ><span>Percentage of Carbon -</span></td>
                          <td style="padding: 8px;"><field name="carbon_percentage"/></td>
                         </tr>
                        <tr>
                          <td><span>Conformity</span></td>
                          <td><field name='carbon_percentage_conformity'
                               decoration-success="carbon_percentage_conformity == 'pass'" 
                               decoration-danger="carbon_percentage_conformity == 'fail'" 
                               readonly="1"/></td>
                         </tr>
                         <tr>
                         <td><span>NABL</span></td>
                         <td><field name='carbon_percentage_nabl'
                               decoration-success="carbon_percentage_nabl == 'pass'" 
                               decoration-danger="carbon_percentage_nabl == 'fail'" 
                               readonly="1"/></td>
                         </tr>
                     </tbody>
                      </table>
                    </div>

                      <!-- Total Suspended Solids (mg/l) -->
                   <div invisible="phosphorus_visible == False">
                    <h1 class="text-center">
                        <field name="phosphorus_name" readonly="1" nolabel="1"/>
                        <field name="phosphorus_visible" invisible="1"/>

