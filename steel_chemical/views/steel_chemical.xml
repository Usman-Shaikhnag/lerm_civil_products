                             <td><field  name="hno3_a1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_b1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_c1"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="percentage_of_phosphorus1"  colspan="1"  nolabel="1" /></td>
                           </tr>

                           <tr>
                             <td>2</td>
                             <td><field  name="wt_sample_taken2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_a2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_b2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_c2"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="percentage_of_phosphorus2"  colspan="1"  nolabel="1" /></td>
                           </tr>

                            <tr>
                             <td>3</td>
                             <td><field  name="wt_sample_taken3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_a3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_b3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_c3"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="percentage_of_phosphorus3"  colspan="1"  nolabel="1" /></td>
                           </tr>

                           <tr>
                             <td>4</td>
                             <td><field  name="wt_sample_taken4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_a4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_b4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_c4"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="percentage_of_phosphorus4"  colspan="1"  nolabel="1" /></td>
                           </tr>

                           <tr>
                             <td>5</td>
                             <td><field  name="wt_sample_taken5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_a5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_b5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="hno3_c5"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="percentage_of_phosphorus5"  colspan="1"  nolabel="1" /></td>
                           </tr>
                         </tbody>
                      </table>
                    </div>
               


                <div invisible="not phosphorus_visible">
                      <table  class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                      <tbody>
                      <tr>
                          <td ><span>Percentage of phosphorus =</span></td>
                          <td style="padding: 8px;"><field name="avg_phosphorus"/></td>
                         </tr>
                        <tr>
                          <td><span>Conformity</span></td>
