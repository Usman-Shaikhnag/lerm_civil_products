                               decoration-danger="avg_phosphorus_conformity == 'fail'" 
                               readonly="1"/></td>
                         </tr>
                         <tr>
                         <td><span>NABL</span></td>
                         <td><field name='avg_phosphorus_nabl'
                               decoration-success="avg_phosphorus_nabl == 'pass'" 
                               decoration-danger="avg_phosphorus_nabl == 'fail'" 
                               readonly="1"/></td>
                         </tr>
                     </tbody>
                      </table>
                    </div>



                     <!-- Oxygen Demand -->
