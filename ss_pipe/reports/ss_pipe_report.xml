<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="ss_pipe_requirement_cell">
		<t t-set="ss_pipe_master" t-value="env['lerm.parameter.master'].search([('internal_id','=',ss_pipe_parameter_id)], limit=1)"/>
		<t t-set="ss_pipe_grade_id" t-value="ss_pipe_eln.grade_id.id"/>
		<t t-set="ss_pipe_material_id" t-value="ss_pipe_eln.material.id"/>
		<t t-set="ss_pipe_all_rows" t-value="ss_pipe_master.parameter_table"/>
		<!-- Filter by material first, then try grade match, fall back to no-grade rows -->
		<t t-set="ss_pipe_mat_rows" t-value="ss_pipe_all_rows.filtered(lambda r: not r.material or r.material.id == ss_pipe_material_id)"/>
		<t t-set="ss_pipe_row" t-value="(ss_pipe_mat_rows.filtered(lambda r: r.grade.id == ss_pipe_grade_id) or ss_pipe_mat_rows.filtered(lambda r: not r.grade) or ss_pipe_all_rows.filtered(lambda r: r.grade.id == ss_pipe_grade_id) or ss_pipe_all_rows.filtered(lambda r: not r.grade))[:1]"/>
		<t t-set="ss_pipe_limit" t-value="ss_pipe_row.permissable_limit.strip() if ss_pipe_row and ss_pipe_row.permissable_limit else ''"/>
		<t t-set="ss_pipe_req" t-value="ss_pipe_limit if ss_pipe_limit and ss_pipe_limit != '--' else ''"/>
		<t t-set="ss_pipe_min" t-value="'{:.4f}'.format(ss_pipe_row.req_min).rstrip('0').rstrip('.') if ss_pipe_row and ss_pipe_row.req_min else ''"/>
		<t t-set="ss_pipe_max" t-value="'{:.4f}'.format(ss_pipe_row.req_max).rstrip('0').rstrip('.') if ss_pipe_row and ss_pipe_row.req_max else ''"/>
		<t t-set="ss_pipe_range" t-value="' - '.join([v for v in [ss_pipe_min, ss_pipe_max] if v])"/>
		<span t-esc="ss_pipe_req or ss_pipe_range"/>
	</template>

