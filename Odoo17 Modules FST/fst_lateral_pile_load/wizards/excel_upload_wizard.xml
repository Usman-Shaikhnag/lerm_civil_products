<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_lateral_pile_load_excel_upload_wizard" model="ir.ui.view">
        <field name="name">lateral.pile.load.excel.upload.wizard</field>
        <field name="model">lateral.pile.load.excel.upload</field>
        <field name="arch" type="xml">
            <form string="Upload Excel Readings">
                <sheet>
                    <group>
                        <field name="parent_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="file_data" filename="file_name" widget="binary"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <div>
                        <p style="margin-top:8px; font-size:10pt;">
                            The Excel file must have two sheets:
                        </p>
                        <ul style="font-size:10pt;">
                            <li><b>Loading</b> — Columns: Date/Time, Load (Tonne), Dial A (mm), Dial B (mm)</li>
                            <li><b>Unloading</b> — Columns: Date/Time, Load (Tonne), Dial A (mm), Dial B (mm)</li>
                        </ul>
                    </div>
                </sheet>
                <footer>
                    <button string="Download Template" type="object" class="btn-secondary"
                        name="action_download_template"/>
                    <button name="action_upload" string="Upload" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lateral_pile_load_excel_upload" model="ir.actions.act_window">
        <field name="name">Upload Readings from Excel</field>
        <field name="res_model">lateral.pile.load.excel.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
