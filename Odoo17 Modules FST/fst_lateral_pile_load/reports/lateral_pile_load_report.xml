<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lateral_pile_load_report_py3o" model="ir.actions.report">
        <field name="name">Lateral Pile Load Report</field>
        <field name="model">fst.lateral.pile.load.test</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fst_lateral_pile_load.lateral_pile_load_template</field>
        <field name="report_file">fst_lateral_pile_load.lateral_pile_load_template</field>
        <field name="print_report_name">'Lateral_Pile_Load_Report'</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="model_fst_lateral_pile_load_test"/>
    </record>

    <template id="lateral_pile_load_template">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs and docs[0]"/>

            <div class="header" style="padding:0; width:100%; margin:0;">
                <div class="lab-header" style="text-align:center; background-color:#244061; color:#ffffff; padding:10px 0; font-size:13pt; font-weight:bold; letter-spacing:1px;">
                    FST ENGINEERING SERVICES PVT. LTD.
                </div>
                <table style="width:100%;" class="text-center">
                    <tr>
                        <td>Test Report No :</td>
                        <td><t t-esc="o.report_no"/></td>
                        <td>Report Issue Date :</td>
                        <td><t t-esc="o.rec_date_str"/></td>
                        <td>ULR No.</td>
                        <td><t t-esc="o.ulr"/></td>
                    </tr>
                </table>
            </div>

            <div class="footer text-center">
                Testing Location: Taloja Laboratory [Shop No 11, Skyline Sapphire, Sector 7, Taloja Phase 1, Navi Mumbai- 410208]<br/>
                Regd. Office: Shop no. 3 &amp; 105 Bldg. B1, Wadala Truck Terminal, MMRDA Compound, Antop Hill, Mumbai- 400037<br/>
                Tel.: +91 22 2401 0040 | Email: sales@knackengineeringservices.com | Website: www.knackengineeringservices.com<br/>
                Page <span class="page"/> of <span class="topage"/>
            </div>

            <style>
                body { font-family: Arial, sans-serif; font-size: 10pt; color: #000000; margin: 0; padding: 0; }
                h2.report-title { text-align: center; font-size: 14pt; font-weight: bold; margin: 12px 0 8px 0; text-transform: uppercase; letter-spacing: 1px; }
                h3.section-heading { font-size: 11pt; font-weight: bold; margin: 14px 0 6px 0; text-transform: uppercase; }
                h4.sub-heading { font-size: 10pt; font-weight: bold; margin: 10px 0 4px 0; text-align: center; text-transform: uppercase; }
                table.data-table { width: 100%; border-collapse: collapse; font-size: 10pt; margin-bottom: 10px; }
                table.data-table td, table.data-table th { border: 1px solid #000000; padding: 4px 6px; vertical-align: middle; }
                table.data-table thead tr th, tr.tbl-header td, tr.tbl-header th { background-color: #244061; color: #ffffff; font-weight: bold; text-align: center; }
                table.meta-table { width: 100%; border-collapse: collapse; font-size: 10pt; margin-bottom: 8px; }
                table.meta-table td { border: 1px solid #000000; padding: 4px 6px; vertical-align: middle; }
                table.meta-table td.label { font-weight: bold; white-space: nowrap; width: 28%; }
                table.toc-table { width: 100%; border-collapse: collapse; font-size: 10pt; margin-bottom: 10px; }
                table.toc-table th { background-color: #244061; color: #ffffff; font-weight: bold; border: 1px solid #000000; padding: 5px 6px; text-align: center; }
                table.toc-table td { border: 1px solid #000000; padding: 4px 6px; vertical-align: middle; }
                table.toc-table td.toc-srno { text-align: center; width: 8%; }
                table.toc-table td.toc-page { text-align: center; width: 10%; }
                table.dial-table { width: 100%; border-collapse: collapse; font-size: 9pt; margin-bottom: 10px; }
                table.dial-table th { background-color: #244061; color: #ffffff; border: 1px solid #000000; padding: 4px 6px; text-align: center; font-weight: bold; }
                table.dial-table td { border: 1px solid #000000; padding: 3px 6px; text-align: center; }
                table.summary-table { width: 55%; border-collapse: collapse; font-size: 10pt; margin-bottom: 10px; }
                table.summary-table th { background-color: #244061; color: #ffffff; border: 1px solid #000000; padding: 5px 8px; text-align: center; }
                table.summary-table td { border: 1px solid #000000; padding: 4px 8px; }
                table.signature-table { width: 100%; border-collapse: collapse; margin-top: 30px; font-size: 10pt; }
                table.signature-table td { border: 1px solid #000000; padding: 12px 10px; text-align: center; vertical-align: top; width: 45%; }
                table.signature-table td.spacer { border: none; width: 10%; }
                .page-break { page-break-after: always; }
                .text-center { text-align: center; }
                .bold { font-weight: bold; }
                p.section-text { font-size: 10pt; margin: 6px 0 10px 0; line-height: 1.5; }
                .end-of-report { text-align: center; font-weight: bold; margin-top: 20px; font-size: 11pt; }
            </style>

            <main>
                <div class="page">

                    <!-- ═════ COVER ═════ -->
                    <h2 class="report-title"><t t-esc="o.name"/></h2>
                    <h3 class="section-heading" style="text-align:center;">INITIAL LATERAL PILE LOAD TEST</h3>
                    <h3 class="section-heading" style="text-align:center;">OF PILE NO - <t t-esc="o.pile_no"/></h3>

                    <table class="meta-table">
                        <tr>
                            <td class="label">Name of Work</td>
                            <td><t t-esc="o.work_name"/></td>
                            <td class="label">Client</td>
                            <td><t t-esc="o.client"/></td>
                        </tr>
                        <tr>
                            <td class="label">Contractor</td>
                            <td><t t-esc="o.contractor"/></td>
                            <td class="label">Report No</td>
                            <td><t t-esc="o.report_no"/></td>
                        </tr>
                        <tr>
                            <td class="label">ULR No</td>
                            <td><t t-esc="o.ulr"/></td>
                            <td class="label">Report Date</td>
                            <td><t t-esc="o.rec_date_str"/></td>
                        </tr>
                        <tr>
                            <td class="label">Test Standard</td>
                            <td><t t-esc="o.test_standard"/></td>
                            <td class="label">Site Location</td>
                            <td><t t-esc="o.site_location"/></td>
                        </tr>
                    </table>

                    <!-- ═════ CONTENTS ═════ -->
                    <h3 class="section-heading">CONTENTS</h3>
                    <table class="toc-table">
                        <thead>
                            <tr>
                                <th class="toc-srno">Sr. No.</th>
                                <th>Description</th>
                                <th class="toc-page">Page No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.content_ids" t-as="line">
                                <tr>
                                    <td class="toc-srno"><t t-esc="line.sequence"/></td>
                                    <td><t t-esc="line.description"/></td>
                                    <td class="toc-page"><t t-esc="line.page_no"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- ═════ 01. GENERAL PHILOSOPHY ═════ -->
                    <h3 class="section-heading">01. General Philosophy</h3>
                    <p class="section-text"><t t-esc="o.general_philosophy"/></p>

                    <!-- ═════ 2.1 SCOPE OF WORKS ═════ -->
                    <h3 class="section-heading">2.1 Scope of Works</h3>
                    <p class="section-text"><t t-esc="o.scope_of_works"/></p>

                    <div class="page-break"></div>

                    <!-- ═════ 2.2 REFERENCE ═════ -->
                    <h3 class="section-heading">2.2 Reference</h3>
                    <p class="section-text"><t t-esc="o.reference"/></p>

                    <!-- ═════ 2.3 EQUIPMENT USED ═════ -->
                    <h3 class="section-heading">2.3 Equipment Used</h3>
                    <p class="section-text"><t t-esc="o.test_equipment"/></p>

                    <!-- ═════ 2.4 SETTING UP OF APPARATUS ═════ -->
                    <h3 class="section-heading">2.4 Setting up of Testing Apparatus</h3>
                    <p class="section-text"><t t-esc="o.setup_apparatus"/></p>

                    <!-- ═════ 2.5 LOAD TEST PROCEDURE ═════ -->
                    <h3 class="section-heading">2.5 Load Test Procedure</h3>
                    <p class="section-text"><t t-esc="o.test_procedure"/></p>

                    <!-- ═════ 2.6 PREPARATION OF TEST REPORT ═════ -->
                    <h3 class="section-heading">2.6 Preparation of Test Report</h3>
                    <p class="section-text"><t t-esc="o.preparation_report"/></p>

                    <!-- ═════ TABLE 1 : BASIC DATA ═════ -->
                    <h3 class="section-heading">TABLE 1 : BASIC DATA</h3>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Sr. No.</th>
                                <th>Parameter</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.basic_data_ids" t-as="line">
                                <tr>
                                    <td style="text-align:center;"><t t-esc="line.sr_no"/></td>
                                    <td><t t-esc="line.parameter"/></td>
                                    <td><t t-esc="line.value"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- ═════ TABLE 2A : LOADING ═════ -->
                    <h3 class="section-heading">TABLE 2A : DIAL GAUGE READING CORRESPONDING TO LOADING</h3>
                    <table class="dial-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Load (Tonne)</th>
                                <th>Applied Pressure (kg/cm²)</th>
                                <th>Pressure under plate (t/m²)</th>
                                <th>Dial A (mm)</th>
                                <th>Dial B (mm)</th>
                                <th>Dial C (mm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.loading_reading_ids" t-as="r">
                                <tr>
                                    <td><t t-esc="r.reading_date_str"/></td>
                                    <td><t t-esc="r.reading_time_str"/></td>
                                    <td><t t-esc="r.load_tonne"/></td>
                                    <td><t t-esc="r.applied_pressure"/></td>
                                    <td><t t-esc="r.pressure_under_plate"/></td>
                                    <td><t t-esc="r.dial_a"/></td>
                                    <td><t t-esc="r.dial_b"/></td>
                                    <td><t t-esc="r.dial_c"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="page-break"></div>

                    <!-- ═════ TABLE 2A(i) : LOAD VS SETTLEMENT SUMMARY ═════ -->
                    <h3 class="section-heading">TABLE 2A(i) : LOAD ON PLATE vs AVERAGE SETTLEMENT vs CUMULATIVE SETTLEMENT</h3>
                    <table class="dial-table">
                        <thead>
                            <tr>
                                <th>Sr No</th>
                                <th>Load on Plate (t)</th>
                                <th>Average Settlement (mm)</th>
                                <th>Cumulative Settlement (mm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.loading_summary_ids" t-as="s">
                                <tr>
                                    <td><t t-esc="s.sequence"/></td>
                                    <td><t t-esc="s.load_tonne"/></td>
                                    <td><t t-esc="s.avg_settlement"/></td>
                                    <td><t t-esc="s.cumulative_settlement"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- ═════ TABLE 2B : UNLOADING ═════ -->
                    <h3 class="section-heading">TABLE 2B : DIAL GAUGE READING CORRESPONDING TO UNLOADING</h3>
                    <table class="dial-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Load (Tonne)</th>
                                <th>Applied Pressure (kg/cm²)</th>
                                <th>Pressure under plate (t/m²)</th>
                                <th>Dial A (mm)</th>
                                <th>Dial B (mm)</th>
                                <th>Dial C (mm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.unloading_reading_ids" t-as="r">
                                <tr>
                                    <td><t t-esc="r.reading_date_str"/></td>
                                    <td><t t-esc="r.reading_time_str"/></td>
                                    <td><t t-esc="r.load_tonne"/></td>
                                    <td><t t-esc="r.applied_pressure"/></td>
                                    <td><t t-esc="r.pressure_under_plate"/></td>
                                    <td><t t-esc="r.dial_a"/></td>
                                    <td><t t-esc="r.dial_b"/></td>
                                    <td><t t-esc="r.dial_c"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="page-break"></div>

                    <!-- ═════ DISPLACEMENT GRAPH ═════ -->
                    <h3 class="section-heading">LOAD - DISPLACEMENT GRAPH</h3>
                    <div style="text-align:center; margin:20px 0;">
                        <img t-if="o.graph_image"
                            t-att-src="'data:image/png;base64,%s' % o.graph_image.decode('utf-8')"
                            style="width:80%; border:1px solid #cccccc;"/>
                    </div>

                    <!-- ═════ DISPLACEMENT SUMMARY ═════ -->
                    <table class="summary-table" style="margin:0 auto;">
                        <thead>
                            <tr>
                                <th colspan="2">Displacement Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Gross Displacement</td>
                                <td><t t-esc="o.gross_settlement"/> mm</td>
                            </tr>
                            <tr>
                                <td>Net Displacement</td>
                                <td><t t-esc="o.net_settlement"/> mm</td>
                            </tr>
                            <tr>
                                <td>Rebound</td>
                                <td><t t-esc="o.rebound"/> mm</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ═════ 2.7 CONCLUSION ═════ -->
                    <h3 class="section-heading">2.7 Conclusion</h3>
                    <p class="section-text"><t t-esc="o.conclusion"/></p>

                    <!-- ═════ SIGNATURE ═════ -->
                    <table class="signature-table">
                        <tr>
                            <td style="width:45%;">
                                <span class="bold">Authorized Signatory</span><br/><br/><br/>
                                <t t-esc="o.signatory_name"/><br/>
                                (<t t-esc="o.signatory_designation"/>)
                            </td>
                            <td class="spacer"></td>
                            <td style="width:45%;">
                            </td>
                        </tr>
                    </table>

                    <!-- ═════ SITE PHOTOGRAPHS ═════ -->
                    <h3 class="section-heading">SITE PHOTOGRAPHS</h3>
                    <t t-foreach="o.site_image_ids" t-as="img">
                        <div style="margin:16px 0; text-align:center;">
                            <img t-att-src="'data:image/png;base64,%s' % img.image.decode('utf-8')"
                                t-att-alt="img.caption"
                                style="width:60%; border:1px solid #ccc;"/>
                            <p class="text-center"><t t-esc="img.caption"/></p>
                        </div>
                    </t>

                    <p class="end-of-report">*END OF REPORT*</p>

                </div>
            </main>
        </t>
    </template>

</odoo>
