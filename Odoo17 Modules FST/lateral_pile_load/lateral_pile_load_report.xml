<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lateral_pile_load_report_py3o" model="ir.actions.report">
        <field name="name">Lateral Pile Load Report</field>
        <field name="model">fst.lateral.pile.load.test</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lerm_civil.lateral_pile_load_report</field>
        <field name="report_file">lerm_civil.lateral_pile_load_report</field>
        <field name="print_report_name">'Lateral_Pile_Load_Report'</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="model_fst_lateral_pile_load_test"/>
    </record>

    <template id="lateral_pile_load_report">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.custom_layout_header_footer_lateral_pile_load">
                <t t-set="o" t-value="docs[0]"/>
                <t t-set="eln" t-value="docs[0]"/>
                <t t-call="lerm_civil.lateral_pile_load_first_page"/>
                <div style="page-break-before: always;"></div>
                <div class="page" style="margin-top:20px; font-family:'Times New Roman',Times,serif;">

                        <div style="text-align:center; font-size:16pt; font-weight:bold; letter-spacing:2px; margin-bottom:30px; text-transform:uppercase;">
                            TABLE OF CONTENTS
                        </div>

                        <div style="border-top:2px solid #000; margin-bottom:16px;"></div>

                        <table style="width:100%; border-collapse:collapse; font-size:11pt;">
                            <thead>
                                <tr style="border-bottom:1px solid #000;">
                                    <th style="padding:6px 4px; text-align:left; font-weight:bold; width:10%;">Sr. No.</th>
                                    <th style="padding:6px 4px; text-align:left; font-weight:bold;">Description</th>
                                    <th style="padding:6px 4px; text-align:right; font-weight:bold; width:12%;">Page No.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.content_ids" t-as="line">
                                    <td style="padding:5px 4px; text-align:left; vertical-align:top; width:10%;">
                                        <span t-if="line.sequence != 0" t-esc="line.sequence"/>
                                    </td>
                                    <td style="padding:5px 4px; text-align:left; vertical-align:top;">
                                        <span t-esc="line.description"/>
                                    </td>
                                    <td style="padding:5px 4px; text-align:right; vertical-align:top; width:12%;">
                                        <span t-esc="line.page_no"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="border-bottom:2px solid #000; margin-top:16px;"></div>
                        <div style="page-break-before: always;"></div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h3 style="font-size:20pt; font-weight:bold; text-transform:uppercase; margin-top:25px; margin-bottom:15px; font-family:'Times New Roman',serif;">1. GENERAL PHILOSOPHY</h3>
                            <p style="font-size:15pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                                <span t-esc="o.general_philosophy"/>
                            </p>
                        </div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h3 style="font-size:20pt; font-weight:bold; text-transform:uppercase; margin-top:25px; margin-bottom:15px; font-family:'Times New Roman',serif;">2. METHODOLOGY FOR LATERAL PILE LOAD TESTING:</h3>

                            <h4 style="font-size:17pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.1 Scope of Work:</h4>
                            <p style="font-size:15pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                                This procedure was applicable for the testing of 1200mm diameter bored Initial Test pile for the Lateral Load.
                            </p>
                            <ol style="margin-left:40px; padding-left:20px; line-height:2; font-size:15pt; font-family:'Times New Roman',serif;">
                                <li>Mobilization of required manpower &amp; machineries.</li>
                                <li>Setting up of testing apparatus.</li>
                                <li>Incremental loading and unloading &amp; recording of Load Vs Displacement.</li>
                                <li>Preparation of test report.</li>
                            </ol>
                        </div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h4 style="font-size:17pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.2 Reference:</h4>
                            <ul style="margin-left:40px; padding-left:25px; line-height:2; font-size:15pt; font-family:'Times New Roman',serif; list-style-type:disc;">
                                <li>IS 2911 (Part 4) - 2013 - Code of practice for design and construction of pile foundations - Part 4 Load Test on Piles.</li>
                            </ul>
                        </div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h4 style="font-size:17pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.3 Equipments Used:</h4>
                            <ul style="margin-left:40px; padding-left:25px; line-height:2; font-size:15pt; font-family:'Times New Roman',serif; list-style-type:disc;">
                                <li>Hydraulic Jack - 100 MT Capacity</li>
                                <li>Pressure Gauge - 0-280 kg/cm2 with LC of 5.0 kg/cm2</li>
                                <li>Dial Gauges - 2 Nos of Dial Gauges of 25 mm travel with LC of 0.01 mm</li>
                            </ul>
                        </div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h4 style="font-size:17pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.4 Setting up of Testing Apparatus</h4>
                            <p style="font-size:15pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                                <span t-esc="o.setup_apparatus"/>
                            </p>
                        </div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h4 style="font-size:17pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.5 Load Test Procedure</h4>
                            <p style="font-size:15pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                                <span t-esc="o.test_procedure"/>
                            </p>
                        </div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h4 style="font-size:17pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.6 Preparation of Test Report</h4>
                            <p style="font-size:15pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                                <span t-esc="o.preparation_report"/>
                            </p>
                        </div>

                        <div style="page-break-inside:avoid; break-inside:avoid;">
                            <h4 style="font-size:17pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.7 Conclusion</h4>
                            <p style="font-size:15pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                                <span t-esc="o.conclusion"/>
                            </p>
                        </div>

                        <div style="margin-top:30px; text-align:center; font-size:12pt; page-break-inside:avoid;">
                            <table style="width:80%; margin:0 auto; border-collapse:collapse;">
                                <tr>
                                    <td style="width:50%; vertical-align:top; padding:10px; border:1px solid #000;">
                                        <b>Checked By</b><br/><br/>
                                        <t t-if="o.sample_id.checkby_signature_required and o.sample_id.check_by.employee_id.signature">
                                            <img t-att-src="'data:image/png;base64,' + o.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width:200px; max-height:35px;"/>
                                            <br/>
                                        </t>
                                        <br/>
                                        <span t-esc="o.sample_id.check_by.name"/>
                                        <br/>
                                        (<span t-esc="o.sample_id.check_by.job_title"/>)
                                    </td>
                                    <td style="width:50%; vertical-align:top; padding:10px; border:1px solid #000;">
                                        <b>Approved By</b><br/><br/>
                                        <t t-if="o.sample_id.approveby_signature_required and o.sample_id.approved_by.employee_id.signature">
                                            <img t-att-src="'data:image/png;base64,' + o.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width:200px; max-height:35px;"/>
                                            <br/>
                                        </t>
                                        <br/>
                                        <span t-esc="o.sample_id.approved_by.name"/>
                                        <br/>
                                        (<span t-esc="o.sample_id.approved_by.job_title"/>)
                                    </td>
                                </tr>
                            </table>
                        </div>

                    <div class="page" style="width:100%; padding-top:110mm; text-align:center; page-break-after:always; page-break-inside:avoid;">
                        <div style="font-family:'Times New Roman',serif; font-size:30pt; font-weight:bold; margin-bottom:22px;">
                            Annexure I
                        </div>
                        <div style="font-family:'Times New Roman',serif; font-size:26pt; font-weight:bold; text-transform:uppercase;">
                            (TEST READINGS)
                        </div>
                    </div>

                        <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0;">TABLE 2 : DIAL GAUGE READING (LOADING &amp; UNLOADING)</h3>
                        <table style="width:100%; border-collapse:collapse; font-size:8pt;">
                            <thead>
                                <tr style="background-color:#244061; color:#ffffff;">
                                    <th style="border:1px solid #000; padding:2px;">Date</th>
                                    <th style="border:1px solid #000; padding:2px;">Time</th>
                                    <th style="border:1px solid #000; padding:2px;">Load (Tonne)</th>
                                    <th style="border:1px solid #000; padding:2px;">Applied Pressure (kg/cm<sup>2</sup>)</th>
                                    <th style="border:1px solid #000; padding:2px;">Pressure under plate (t/m<sup>2</sup>)</th>
                                    <th style="border:1px solid #000; padding:2px;">Dial A (mm)</th>
                                    <th style="border:1px solid #000; padding:2px;">Dial B (mm)</th>
                                    <th style="border:1px solid #000; padding:2px;">Dial C (mm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color:#d9e1f2; font-weight:bold;">
                                    <td style="border:1px solid #000; padding:2px; text-align:center;" colspan="8">LOADING</td>
                                </tr>
                                <tr t-foreach="o.loading_reading_ids" t-as="r">
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.reading_date_str"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.reading_time_str"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.load_tonne"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.applied_pressure"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.pressure_under_plate"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.dial_a"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.dial_b"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.dial_c"/>
                                    </td>
                                </tr>
                                <tr style="background-color:#d9e1f2; font-weight:bold;">
                                    <td style="border:1px solid #000; padding:2px; text-align:center;" colspan="8">UNLOADING</td>
                                </tr>
                                <tr t-foreach="o.unloading_reading_ids" t-as="r">
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.reading_date_str"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.reading_time_str"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.load_tonne"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.applied_pressure"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.pressure_under_plate"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.dial_a"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.dial_b"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:2px; text-align:center;">
                                        <span t-esc="r.dial_c"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="page" style="width:100%; padding-top:110mm; text-align:center; page-break-after:always; page-break-inside:avoid;">
                            <div style="font-family:'Times New Roman',serif; font-size:30pt; font-weight:bold; margin-bottom:22px;">
                                Annexure II
                            </div>
                            <div style="font-family:'Times New Roman',serif; font-size:26pt; font-weight:bold; text-transform:uppercase;">
                                (LOAD VS. DEFLECTION PLOT)
                            </div>
                        </div>

                        <div style="page-break-before: always;"></div>

                        <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0;">LOAD ON PLATE vs AVERAGE SETTLEMENT vs CUMULATIVE SETTLEMENT</h3>
                        <table style="width:100%; border-collapse:collapse; font-size:10pt;">
                            <thead>
                                <tr style="background-color:#244061; color:#ffffff;">
                                    <th style="border:1px solid #000; padding:4px;">Sr No</th>
                                    <th style="border:1px solid #000; padding:4px;">Load on Plate (t)</th>
                                    <th style="border:1px solid #000; padding:4px;">Average Settlement (mm)</th>
                                    <th style="border:1px solid #000; padding:4px;">Cumulative Settlement (mm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.loading_summary_ids" t-as="s">
                                    <td style="border:1px solid #000; padding:4px; text-align:center;">
                                        <span t-esc="s.sequence"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:4px; text-align:center;">
                                        <span t-esc="s.load_tonne"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:4px; text-align:center;">
                                        <span t-esc="s.avg_settlement"/>
                                    </td>
                                    <td style="border:1px solid #000; padding:4px; text-align:center;">
                                        <span t-esc="s.cumulative_settlement"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0;">LOAD - DISPLACEMENT GRAPH</h3>
                        <div style="text-align:center; margin:20px 0;">
                            <img t-if="o.graph_image"
                                t-att-src="'data:image/png;base64,%s' % o.graph_image.decode('utf-8')"
                                style="width:80%; border:1px solid #cccccc;"/>
                        </div>

                        <div class="page" style="width:100%; padding-top:110mm; text-align:center; page-break-after:always; page-break-inside:avoid;">
                            <div style="font-family:'Times New Roman',serif; font-size:30pt; font-weight:bold; margin-bottom:22px;">
                                Annexure III
                            </div>
                            <div style="font-family:'Times New Roman',serif; font-size:26pt; font-weight:bold; text-transform:uppercase;">
                                (SITE PHOTOGRAPHS)
                            </div>
                        </div>

                        <div style="page-break-before: always;"></div>

                        <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0;">SITE PHOTOGRAPHS</h3>
                        <t t-foreach="o.site_image_ids" t-as="img">
                            <div style="margin:16px 0; text-align:center;">
                                <img t-att-src="'data:image/png;base64,%s' % img.image.decode('utf-8')"
                                    t-att-alt="img.caption"
                                    style="width:60%; border:1px solid #ccc;"/>
                                <p style="text-align:center;"><span t-esc="img.caption"/></p>
                            </div>
                        </t>

                            <p style="text-align:center; font-weight:bold; margin-top:20px; font-size:11pt;">
                                *END OF REPORT*
                            </p>

                    </div>
                </t>
            </t>
        </template>

</odoo>
