<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="soil_datasheet">
		<t t-call="web.html_container">
			<t t-call="lerm_civil.genstru_data_sheet_header">
				<div style="text-align:center;font-size:18px;font-weight: bold">
                    Soil Datasheet
                </div>
				<div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>		
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>
                        <!-- <tr>
                            <td colspan="6">Age at Test: <span t-field="data.age_of_days"></span>
                            </td>
                            <td colspan="6">Sample Conditioning: <span t-field="data.sample_condition"></span>
                            </td>
                        </tr> -->
                    </table>

					<table>
						<tr style="height:50px" cols="12">
                            <td colspan="4">Performed By :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.technician.name"/>
                            </td>
                            <td colspan="4">Witness Name :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.witness_name"/>
                            </td>
                            <td colspan="4">Witness Signature :
                                <![CDATA[&nbsp;]]>
                                <span style='padding:20px'></span>
                            </td>
                        </tr>
					</table>

					<!-- California Bearing Ratio -->

					<div t-if="data.specific_gravity_visible or data.water_absorption_visible" style="margin-top: 30px; font-family: Arial, sans-serif;">
					 <div style="text-align: center; font-size: 18px; font-weight: bold; margin-bottom: 15px;">
						CALIFORNIA BEARING RATIO
					 </div>
					 <h6 style="padding: 2px; font-weight: bold;">Water Content</h6>
					 <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					   <thead>
					    <tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								Water Content
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Can No
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 wt of Can + wet soil
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 wt of Can + dry soil
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 wt of water
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 wt of can
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Wt of dry soil
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Moisture content %
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Avg MC %
							</td>
						 </tr>
						</thead>
						<tbody>
						 <tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								Before soaking
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_can_no"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_can_wet_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_can_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_wt_water"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_wt_can"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_wt_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_mc"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_avg_mc"/>
							</td>
						</tr>
						<tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								Top
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.top_can_no"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.top_can_wet_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.top_can_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.top_wt_water"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.top_wt_can"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.top_wt_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.top_mc"/>
							</td>
							<td colspan="6" rowspan="3" style="border: 1px solid black; padding: 38px 6px;text-align: center;">
								<span t-field="data.avg_mc"/>
							</td>
						</tr>
						<tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								Centre
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.centre_can_no"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.centre_can_wet_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.centre_can_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.centre_wt_water"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.centre_wt_can"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.centre_wt_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.centre_mc"/>
							</td>
						</tr>
						<tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								Bottom
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.bottom_can_no"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.bottom_can_wet_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.bottom_can_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.bottom_wt_water"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.bottom_wt_can"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.bottom_wt_dry_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.bottom_mc"/>
							</td>
						</tr>
							</tbody>
					  </table>

					  <h6 style="padding: 2px; font-weight: bold;">Condition of specimen</h6>
					 <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					   <thead>
					    <tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Wt of mould + soil (g)
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Wt of mould (g)
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Wt of soil (g)
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								Volume of specimen (cc)
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Bulk density
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								 Dry density
							</td>
						</tr>
						</thead>
						<tbody>
						 <tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								Before soaking
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_mould_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_mould"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.volume_specimen1"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_bulk_density"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.before_dry_density"/>
							</td>
						</tr>
						<tr>
							<td colspan="6" style="border: 1px solid black; padding: 6px; font-weight: bold;background-color: #E6E6E6;text-align: center;">
								After soaking
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.after_mould_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.after_mould"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.after_soil"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.volume_specimen2"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.after_bulk_density"/>
							</td>
							<td colspan="6" style="border: 1px solid black; padding: 6px;text-align: center;">
								<span t-field="data.after_dry_density"/>
							</td>
						 </tr>
						</tbody>
					  </table>

					</div>
					
						

					

					
						
						
					
						

					
				<!-- footer -->
                     <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								<div style="height: 40px;">
						<!-- <t t-if="eln.sample_id.testedby_signature_required"> -->
							<t t-if="eln.tested_by_signature_datasheet">

								<div t-if="eln.sample_id.filled_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							<!-- </div> -->
						</div>
                    
                </div>
				</div>

            </t>
        </t>
    </template>

</odoo>
