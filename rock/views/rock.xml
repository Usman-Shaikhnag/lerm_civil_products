<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_rock" model="ir.ui.view">
        <field name="name">mechanical.rock.form</field>
        <field name="model">mechanical.rock</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                        <h1>
                            <field name="name_rock"  readonly="1" nolabel="1"/>
                        </h1>
                        <group>
                       <field name="grade"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>
                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <!-- Specific Gravity -->

                    <div invisible="specific_gravity_visible == False" style="text-align:center">
                        <h1>
                          <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                          <field name="specific_gravity_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible="specific_gravity_visible == False" style="text-align:center">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr>
                           <td style="font-weight:bold"><span>Sample No</span></td>
                           <td  style="font-weight:bold"><span>Sample 1</span></td>
                           <td  style="font-weight:bold"><span>Sample 2</span></td>
                           <td  style="font-weight:bold"><span>Sample 3</span></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_dry">Dry Weight (g)</label></td>
                           <td><field  name="sample1_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_wet">Wet/Saturated Weight (g)</label></td>
                           <td><field  name="sample1_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_suspended">Suspended Weight (g)</label></td>
                           <td><field  name="sample1_suspended"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_suspended"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_suspended"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="sample1_result">Specific Gravity</label></td>
                           <td><field  name="sample1_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample2_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="sample3_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                       </tbody>
                     </table>
                    </div>

                                    
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not specific_gravity_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_specific_gravity">Average Specific Gravity</label></td>
                                <td>
                                    <field name="avg_specific_gravity"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_specific_gravity_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_specific_gravity_conformity"
                                        decoration-success="avg_specific_gravity_conformity == 'pass'"
                                        decoration-danger="avg_specific_gravity_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_specific_gravity_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_specific_gravity_nabl"
                                        decoration-success="avg_specific_gravity_nabl == 'pass'"
                                        decoration-danger="avg_specific_gravity_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <!-- Water Absorption -->

                    <div invisible="water_absorption_visible == False" style="text-align:center">
                        <h1>
                          <field name="water_absorption_name" readonly="1" nolabel="1"/>
                          <field name="water_absorption_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible="water_absorption_visible == False" style="text-align:center">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr>
                           <td style="font-weight:bold"><span>Sample No</span></td>
                           <td  style="font-weight:bold"><span>Sample 1</span></td>
                           <td  style="font-weight:bold"><span>Sample 2</span></td>
                           <td  style="font-weight:bold"><span>Sample 3</span></td>
                         </tr>
                         <tr>
                           <td><label for="water_sample1_dry">Dry Weight (g)</label></td>
                           <td><field  name="water_sample1_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_sample2_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_sample3_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="water_sample1_wet">Wet/Saturated Weight (g)</label></td>
                           <td><field  name="water_sample1_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_sample2_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_sample3_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="water_sample1_result">Water Absorption</label></td>
                           <td><field  name="water_sample1_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_sample2_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_sample3_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                       </tbody>
                     </table>
                    </div>

                                    
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_absorption_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption">Average Water Absorption</label></td>
                                <td>
                                    <field name="avg_water_absorption"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                        decoration-success="avg_water_absorption_conformity == 'pass'"
                                        decoration-danger="avg_water_absorption_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                        decoration-success="avg_water_absorption_nabl == 'pass'"
                                        decoration-danger="avg_water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                     <!-- Water Content -->

                    <div invisible="water_content_visible == False" style="text-align:center">
                        <h1>
                          <field name="water_content_name" readonly="1" nolabel="1"/>
                          <field name="water_content_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible="water_content_visible == False" style="text-align:center">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr>
                           <td style="font-weight:bold"><span>Sample No</span></td>
                           <td  style="font-weight:bold"><span>Sample 1</span></td>
                           <td  style="font-weight:bold"><span>Sample 2</span></td>
                           <td  style="font-weight:bold"><span>Sample 3</span></td>
                         </tr>
                         
                         <tr>
                           <td><label for="water_content_sample1_dry">Dry Weight (g)</label></td>
                           <td><field  name="water_content_sample1_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_content_sample2_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_content_sample3_dry"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="water_content_sample1_wet">Wet Weight (g)</label></td>
                           <td><field  name="water_content_sample1_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_content_sample2_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_content_sample3_wet"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                         <tr>
                           <td><label for="water_content_sample1_result">Water Content</label></td>
                           <td><field  name="water_content_sample1_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_content_sample2_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           <td><field  name="water_content_sample3_result"  colspan="1"  nolabel="1" class="blue-input"/></td>
                         </tr>
                       </tbody>
                     </table>
                    </div>

                                    
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_content_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_water_content">Average Water Content</label></td>
                                <td>
                                    <field name="avg_water_content"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_content_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_content_conformity"
                                        decoration-success="avg_water_content_conformity == 'pass'"
                                        decoration-danger="avg_water_content_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_content_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_water_content_nabl"
                                        decoration-success="avg_water_content_nabl == 'pass'"
                                        decoration-danger="avg_water_content_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>














                   

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                      <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     
                </sheet>
            </form>
        </field>
    </record>
   


    </data>
</odoo>