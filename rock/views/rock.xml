<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="rock_information_view" model="ir.ui.view">
        <field name="name">mechanical.rock.form</field>
        <field name="model">mechanical.rock</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                     <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>


                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="eln_state" />
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                     <!-- <group > -->
                   
                    <field name="child_lines" nolabel="1" class="custom_table_borders"  invisible="porosity_visible == False and specific_gravity_visible == False and dry_density_visible == False and water_absorption_visible == False">
                            <tree editable="bottom" >
                                <!-- <field name='sr_no'/> -->
                                <field name='location' class="blue-input" decoration-info="location != 0"/>
                                <field name='sample_no'/>
                                <field name='depth' class="blue-input" decoration-info="depth != 0"/>
                                <field name='ssd_weight' class="blue-input" decoration-info="ssd_weight != 0"/>
                                <field name='wt_sample_water' class="blue-input" decoration-info="wt_sample_water != 0"/>
                                <field name='oven_dry_wt' class="blue-input" decoration-info="oven_dry_wt != 0"/>
                                <field name='porosity' class="blue-input" decoration-info="porosity != 0"/>
                                <field name='water_absorption' class="blue-input" decoration-info="water_absorption != 0"/>
                                <field name='dry_density' class="blue-input" decoration-info="dry_density != 0"/>
                                <field name='saturated_spc_gravity' class="blue-input" decoration-info="saturated_spc_gravity != 0"/>
                            </tree>
                          
                    </field> 

                    <div class="d-flex gap-2" invisible="porosity_visible == False and specific_gravity_visible == False and dry_density_visible == False and water_absorption_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_porosity"></label></td>
                                    <td><field name="avg_porosity" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_water_absorption"></label></td>
                                    <td><field name="avg_water_absorption"  /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>

                    <div class="d-flex gap-2" invisible="porosity_visible == False and specific_gravity_visible == False and dry_density_visible == False and water_absorption_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_dry_density"></label></td>
                                    <td><field name="avg_dry_density" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_saturated_spc_gravity"></label></td>
                                    <td><field name="avg_saturated_spc_gravity"  /></td>
                                </tr>
                              
                            </tbody>
                        </table>

                          
                    </div>
                         

                          



                    <!-- USC -->
                    <div invisible="usc_visible == False" >
                        <h1>
                            <field name="usc_name" readonly="1" nolabel="1"/>
                            <field name="usc_visible" invisible="1"/>
                            <field name="porosity_visible" invisible="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>
                            <field name="dry_density_visible" invisible="1"/>
                            <field name="water_absorption_visible" invisible="1"/>

                        </h1>
                    </div>

                        <field name="child_lines1" nolabel="1" class="custom_table_borders" invisible="usc_visible == False" >
                            <tree editable="bottom">
                                <field name='location' class="blue-input" decoration-info="location != 0"/>
                                <field name='sr_no'/>
                                <field name='depth' class="blue-input" decoration-info="depth != 0"/>
                                <field name='diameter' class="blue-input" decoration-info="diameter != 0"/>
                                <field name='length' class="blue-input" decoration-info="length != 0"/>
                                <field name='ld_ratio'/>
                                <field name='area'/>
                                <field name='load' class="blue-input" decoration-info="load != 0"/>
                                <field name='usc'/>
                                
                            </tree>
                           
                         </field> 


                           <div class="d-flex gap-2" invisible="usc_visible == False" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="avg_usc"></label></td>
                                    <td><field name="avg_usc" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>
                           
                          <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                  
                      <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     
                </sheet>
            </form>
        </field>
    </record>
   


    </data>
</odoo>