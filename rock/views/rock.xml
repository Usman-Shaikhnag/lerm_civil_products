<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_rock" model="ir.ui.view">
        <field name="name">mechanical.rock.form</field>
        <field name="model">mechanical.rock</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                        <h1>
                            <field name="name_rock"  readonly="1" nolabel="1"/>
                        </h1>
                        <group style="white-space: nowrap; width:70%;">
                     
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                       
                        </group>
                        <group>
                       <field name="grade"/>
                    </group>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>
                       <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */
                            
                        }
                    </style>

                     <!-- <group > -->
                     <div>

                     <h1 class="text-center">
                            <field name="name"  readonly="1" nolabel="1"/>
                    </h1>
                    </div>
                    <group/>


   


                         <div invisible = "usc_visible == False">
                        <h1 class="text-center">
                            <!-- <field name="uu_triaxial_cohesion_name" readonly="1" nolabel="1"/> -->
                            <field name="usc_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-3" invisible = "usc_visible == False">
                        

                         <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Point Load  Constant</span></td>
                                <td><field name='point_load_constant' col="1" class="blue-input"/></td>
                            </tr>
                            
                            
                            </tbody>
                        </table>


                        <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Compressive Strength  Constant</span></td>
                                <td><field name='compressive_strength_constant' col="1" class="blue-input"/></td>
                            </tr>
                           
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Compressive Strength HD  Constant</span></td>
                                <td><field name='compressive_strength_constant_hd' col="1" class="blue-input"/></td>
                            </tr>
                           
                            </tbody>
                        </table>
                    </div>


        

                    <div invisible = "usc_visible == False">
                        <field name="rock_child_lines">
                            <tree editable="bottom" class="custom_table_borders">
                             <field name="blue_input" invisible="1"/>
                                <field name='sr_no'/>
                                <field name='date_received'  decoration-info="blue_input"/>
                                <field name='date_testing' decoration-info="blue_input"/>
                                <field name='lab_id' width="120" decoration-info="blue_input"/>
                                <field name='bh_no' width="120" decoration-info="blue_input"/>
                                <field name='depth' width="120" decoration-info="blue_input"/>
                                <field name='piece_no'  width="120" decoration-info="blue_input"/>
                                <field name='lithological' width="120" decoration-info="blue_input"/>
                                <field name='room_temp' decoration-info="blue_input"/>
                                <field name='relative_humidity' decoration-info="blue_input"/>
                                <field name='water_temperature' decoration-info="blue_input"/>
                                <field name='dia_rock1' decoration-info="blue_input"/>
                                <field name='dia_rock2'  decoration-info="blue_input"/>
                                <field name='dia_rock3' decoration-info="blue_input"/>
                                <field name='avg_dia' />
                                <field name='height_rock1' decoration-info="blue_input"/>
                                <field name='height_rock2' decoration-info="blue_input"/>
                                <field name='height_rock3'  decoration-info="blue_input"/>
                                <field name='avg_height' />
                                <field name='hd'/>
                                <field name='volume_of_sample'/>
                                <field name='volume_of_sample1' decoration-info="blue_input"/>
                                <field name='initial_wt' decoration-info="blue_input"/>
                                <field name='dry_wet'   decoration-info="blue_input"/>
                                  <field name='saturated_wet'   decoration-info="blue_input"/>
                                
                                <field name='volume_of_void'/>
                                <field name='wt_of_sample' decoration-info="blue_input"/>
                                <field name='sp_gravity'/>
                                <field name='bulk_density'  />
                                <field name='sat_density'/>
                                <field name='dry_density'/>
                                <field name='water_absorption'/>
                                <field name='porosity'/>
                                <field name='load_ucs'   decoration-info="blue_input"/>
                                <field name='load'/>
                                <field name='comp_strength1'/>
                                <field name='comp_strength2'/>
                                <field name='point_load' decoration-info="blue_input"/>
                                <field name='point_load_strength'/>
                                 <field name='point_load_index'/>
                                <field name='comp_strength4'/>
                                <field name='comp_strength5'/>
                                <field name='duration_of_test' decoration-info="blue_input"/>
                                <field name='mode_of_failure' width="120" decoration-info="blue_input"/>
                                <field name='comp_rock'/>
                                <field name='comp_rock1'/>
                                <field name='stress_rate'/>
                                <field name='moisture_content'/>
                               

                              
                                
                              
                            </tree>
                        </field>
                    </div>

                       <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>




                   
                      <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     
                </sheet>
            </form>
        </field>
    </record>



     <record id="view_rock_prefill_data_form" model="ir.ui.view">
            <field name="name">rock.prefill.data.form</field>
            <field name="model">rock.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_rock_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">rock.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_rock_prefill_data_form"/>
            <field name="target">new</field>
        </record>
   


    </data>
</odoo>