<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_rock" model="ir.ui.view">
        <field name="name">mechanical.rock.form</field>
        <field name="model">mechanical.rock</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                        <h1>
                            <field name="name_rock"  readonly="1" nolabel="1"/>
                        </h1>
                        <group>
                       <field name="grade"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>
                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temp"></label>
                                    </td>
                                    <td>
                                        <field name="temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Specific Gravity -->

                    <div invisible="specific_gravity_visible == False" style="text-align:center">
                        <h1>
                          <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                          <field name="specific_gravity_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div class="custom_table_borders" invisible="not specific_gravity_visible">
                        <field name="specific_gravity_line_ids" nolabel="1" >
                        <tree editable="bottom">
                        <field name="sample_no" width="200"/>
                          <field name="dry_weight" class="blue-input" decoration-info="dry_weight != 0" width="200"/>
                          <field name="ssd_weight" class="blue-input" decoration-info="ssd_weight != 0" width="200"/>
                          <field name="water_weight" class="blue-input" decoration-info="water_weight != 0" width="200"/>

                          <field name="volume_sample" width="200"/>

                          <field name="specific_gravity" width="200"/>
                          <field name="water_absorption" width="200"/>
                          <field name="remarks" class="blue-input" decoration-info="remarks != 0" width="200"/>
                        </tree>
                        </field>
                    </div>

                                    
                    <div class="d-flex gap-2"> 
                      <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not specific_gravity_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_specific_gravity">Average Specific Gravity</label></td>
                                <td>
                                    <field name="avg_specific_gravity"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_specific_gravity_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_specific_gravity_conformity"
                                        decoration-success="avg_specific_gravity_conformity == 'pass'"
                                        decoration-danger="avg_specific_gravity_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_specific_gravity_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_specific_gravity_nabl"
                                        decoration-success="avg_specific_gravity_nabl == 'pass'"
                                        decoration-danger="avg_specific_gravity_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="specific_gravity_report_type">Report Type</label></td>
                                <td><field name="specific_gravity_report_type" class="blue-input" decoration-info="specific_gravity_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not specific_gravity_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption">Average Water Absorption</label></td>
                                <td>
                                    <field name="avg_water_absorption"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                        decoration-success="avg_water_absorption_conformity == 'pass'"
                                        decoration-danger="avg_water_absorption_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_absorption_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                        decoration-success="avg_water_absorption_nabl == 'pass'"
                                        decoration-danger="avg_water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="water_absorption_report_type">Report Type</label></td>
                                <td><field name="water_absorption_report_type" class="blue-input" decoration-info="water_absorption_report_type != 0"/></td>
                            </tr>
                        </tbody>
                      </table>

                    </div>


                    
                    
                    


                     <!-- Water Content -->

                    <div invisible="water_content_visible == False" style="text-align:center">
                        <h1>
                          <field name="water_content_name" readonly="1" nolabel="1"/>
                          <field name="water_content_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div class="custom_table_borders" invisible="not specific_gravity_visible">
                        <field name="water_content_line_ids" nolabel="1" >
                        <tree editable="bottom">
                        <field name="sample_no" width="200"/>
                          <field name="container_no" class="blue-input" decoration-info="container_no != 0" width="200"/>
                          <field name="w1" class="blue-input" decoration-info="w1 != 0" width="200"/>
                          <field name="w2" class="blue-input" decoration-info="w2 != 0" width="200"/>
                          <field name="w3" class="blue-input" decoration-info="w3 != 0" width="200"/>

                          <field name="weight_water" width="200"/>

                          <field name="weight_dry_rock" width="200"/>
                          <field name="water_content" width="200"/>
                        </tree>
                        </field>
                    </div>

                                    
                    
                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="not water_content_visible">
                        <tbody>
                            <tr>
                                <td><label class="text-bold" for="avg_water_content">Average Water Content</label></td>
                                <td>
                                    <field name="avg_water_content"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_content_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_content_conformity"
                                        decoration-success="avg_water_content_conformity == 'pass'"
                                        decoration-danger="avg_water_content_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="text-bold" for="avg_water_content_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_water_content_nabl"
                                        decoration-success="avg_water_content_nabl == 'pass'"
                                        decoration-danger="avg_water_content_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="water_content_report_type">Report Type</label></td>
                                <td><field name="water_content_report_type" class="blue-input" decoration-info="water_content_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>














                   

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                      <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     
                </sheet>
            </form>
        </field>
    </record>
   


    </data>
</odoo>