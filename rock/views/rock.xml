<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_rock" model="ir.ui.view">
        <field name="name">mechanical.rock.form</field>
        <field name="model">mechanical.rock</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                        <h1>
                            <field name="name_rock"  readonly="1" nolabel="1"/>
                        </h1>
                        
                        <group style="white-space: nowrap; width:70%;">
                     
                        <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                       
                        </group>
                        <group>
                       <field name="grade"/>
                    </group>


                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>



                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                      
                     <!-- <group > -->
                     <div>

                     <h1 class="text-center">
                            <field name="name"  readonly="1" nolabel="1"/>
                    </h1>
                    </div>
                    <group/>

                      <div invisible = "usc_visible == False" style="margin-bottom: 10px;">
                            <field name= 'rock_lines_generated' invisible="1" />
                            <button name="action_generate_rock_lines"
                            
                                type="object"
                                string="Rock Lab Lines"
                                class="oe_highlight"
                                invisible="rock_lines_generated == True"/>

                            </div>


                            <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders"  invisible="1">
                            <tbody>
                                <tr>
                                    <td><label for="rock_lines_generated"></label></td>
                                    <td><field name="rock_lines_generated"   /></td>
                                </tr>

                                <tr>
                                    <td><label for="calc_mode"></label></td>
                                    <td><field name="calc_mode"   /></td>
                                </tr>
                                


                            </tbody>
                        </table>



             

                      
   
   
                 <div class="d-flex gap-2" invisible="not usc_visible ">
                  <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="temp_rock">Temp.°C</label></td>
                                    <td><field name="temp_rock" class="blue-input" invisible="not usc_visible"  required = "calc_mode == False or rock_lines_generated == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="humidity_rock">Humidity %</label></td>
                                    <td><field name="humidity_rock" class="blue-input" invisible="not usc_visible" required = "calc_mode == False or rock_lines_generated == True "/></td>
                                </tr>
                                
                            </tbody>
                        </table>
                    </div>  





                         <div invisible = "usc_visible == False">
                        <h1 class="text-center">
                            <!-- <field name="uu_triaxial_cohesion_name" readonly="1" nolabel="1"/> -->
                            <field name="usc_visible" invisible="1"/>
                        </h1>
                    </div>



                    <div class="d-flex gap-3" invisible = "usc_visible == False">
                        

                         <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Point Load  Constant</span></td>
                                <td><field name='point_load_constant' col="1" class="blue-input"/></td>
                            </tr>
                            
                            
                            </tbody>
                        </table>


                        <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Compressive Strength  Constant</span></td>
                                <td><field name='compressive_strength_constant' col="1" class="blue-input"/></td>
                            </tr>
                           
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered w-30 custom_table_borders">
                            <tbody>
                            <tr>
                                <td><span>Compressive Strength HD  Constant</span></td>
                                <td><field name='compressive_strength_constant_hd' col="1" class="blue-input"/></td>
                            </tr>
                           
                            </tbody>
                        </table>
                    </div>


        

                    <div invisible = "usc_visible == False">
                        <field name="rock_child_lines">
                            <tree editable="bottom" class="custom_table_borders">
                             <!-- <field name="blue_input" invisible="1"/> -->
                                <field name='sr_no'/>
                                <field name='date_received'  class="blue-input" decoration-info="date_received != 0"/>
                                <field name='date_testing' class="blue-input" decoration-info="date_testing != 0"/>
                                <field name='lab_id' width="120" class="blue-input" decoration-info="lab_id != 0"/>
                                <field name='bh_no' width="120" class="blue-input" decoration-info="bh_no != 0"/>
                                <field name='depth' width="120" class="blue-input" decoration-info="depth != 0"/>
                                <field name='piece_no'  width="120" class="blue-input" decoration-info="piece_no != 0"/>
                                <field name='lithological' width="120" class="blue-input" decoration-info="lithological != 0"/>
                                <field name='room_temp' class="blue-input" decoration-info="room_temp != 0"/>
                                <field name='relative_humidity' class="blue-input" decoration-info="relative_humidity != 0"/>
                                <field name='water_temperature' class="blue-input" decoration-info="water_temperature != 0"/>
                                <field name='dia_rock1' class="blue-input" decoration-info="dia_rock1 != 0"/>
                                <field name='dia_rock2'  class="blue-input" decoration-info="dia_rock2 != 0"/>
                                <field name='dia_rock3' class="blue-input" decoration-info="dia_rock3 != 0"/>
                                <field name='avg_dia' />
                                <field name='height_rock1' class="blue-input" decoration-info="height_rock1 != 0"/>
                                <field name='height_rock2' class="blue-input" decoration-info="height_rock2 != 0"/>
                                <field name='height_rock3'  class="blue-input" decoration-info="height_rock3 != 0"/>
                                <field name='avg_height' />
                                <field name='hd'/>
                                <field name='volume_of_sample'/>
                                <field name='volume_of_sample1' class="blue-input" decoration-info="volume_of_sample1 != 0"/>
                                <field name='initial_wt' class="blue-input" decoration-info="initial_wt != 0"/>
                                <field name='dry_wet'   class="blue-input" decoration-info="dry_wet != 0"/>
                                  <field name='saturated_wet'  class="blue-input" decoration-info="saturated_wet != 0"/>
                                
                                <field name='volume_of_void'/>
                                <field name='wt_of_sample' class="blue-input" decoration-info="wt_of_sample != 0"/>
                                <field name='sp_gravity'/>
                                <field name='bulk_density'  />
                                <field name='sat_density'/>
                                <field name='dry_density'/>
                                <field name='water_absorption'/>
                                <field name='porosity'/>
                                <field name='load_ucs'   class="blue-input" decoration-info="load_ucs != 0"/>
                                <field name='load'/>
                                <field name='comp_strength1'/>
                                <field name='comp_strength2'/>
                                <field name='point_load' class="blue-input" decoration-info="point_load != 0"/>
                                <field name='point_load_strength'/>
                                 <field name='point_load_index'/>
                                <field name='comp_strength4'/>
                                <field name='comp_strength5'/>
                                <field name='duration_of_test' class="blue-input" decoration-info="duration_of_test != 0"/>
                                <field name='mode_of_failure' width="120" class="blue-input" decoration-info="mode_of_failure != 0"/>
                                <field name='comp_rock'/>
                                <field name='comp_rock1'/>
                                <field name='stress_rate'/>
                                <field name='moisture_content'/>
                               

                              
                                
                              
                            </tree>
                        </field>
                    </div>

                       <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>




                   
                      <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                     
                </sheet>
            </form>
        </field>
    </record>



     <record id="view_rock_prefill_data_form" model="ir.ui.view">
            <field name="name">rock.prefill.data.form</field>
            <field name="model">rock.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_rock_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">rock.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_rock_prefill_data_form"/>
            <field name="target">new</field>
        </record>
   


    </data>
</odoo>