<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rock_datasheet">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px;font-weight: bold">
                    Rock
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>
                        <!-- <tr>
                            <td colspan="6">Age at Test: <span t-field="data.age_of_days"></span>
                            </td>
                            <td colspan="6">Sample Conditioning: <span t-field="data.sample_condition"></span>
                            </td>
                        </tr> -->
                    </table>
					
					<table>
						<tr style="height:50px" cols="12">
                            <td colspan="4">Performed By :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.technician.name"/>
                            </td>
                            <td colspan="4">Witness Name :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.witness_name"/>
                            </td>
                            <td colspan="4">Witness Signature :
                                <![CDATA[&nbsp;]]>
                                <span style='padding:20px'></span>
                            </td>
                        </tr>
					</table>


                     <!-- Specific Gravity  -->

                    <div t-if="data.specific_gravity_visible" style="margin-top:20px">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Specific Gravity
							</div>
						
								
								<table>
											<tr>
												<th style="text-align: center; font-weight: bold;">Sample No</th>
												<th style="text-align: center; font-weight: bold;">Sample 1</th>
												<th style="text-align: center; font-weight: bold;">Sample 2</th>
                                                <th style="text-align: center; font-weight: bold;">Sample 3</th>
											</tr>
											<tr>
												<td style="font-weight: bold;">Dry Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.sample1_dry"/></td>
												<td style="text-align: center;"><span t-field="data.sample2_dry"/></td>
                                                <td style="text-align: center;"><span t-field="data.sample3_dry"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Wet/Saturated Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.sample1_wet"/></td>
												<td style="text-align: center;"><span t-field="data.sample2_wet"/></td>
                                                <td style="text-align: center;"><span t-field="data.sample3_wet"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Suspended Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.sample1_suspended"/></td>
												<td style="text-align: center;"><span t-field="data.sample2_suspended"/></td>
                                                <td style="text-align: center;"><span t-field="data.sample3_suspended"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Specific Gravity</td>
												<td style="text-align: center;"><span t-field="data.sample1_result" t-options='{"widget": "float", "precision": 2}'/></td>
												<td style="text-align: center;"><span t-field="data.sample2_result" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td style="text-align: center;"><span t-field="data.sample3_result" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Average Specific gravity</td>
												<td colspan="3" style="text-align: center;"><span t-field="data.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
										</table>

							<div t-if="data.specific_gravity_visible" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
									
						</div>
						



                        <!-- Water Absorption -->

                        <div t-if="data.water_absorption_visible" style = "page-break-before: always;margin-top:20px;">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Water Absorption
							</div>
						
								
								<table>
											<tr>
												<th style="text-align: center; font-weight: bold;">Sample No</th>
												<th style="text-align: center; font-weight: bold;">Sample 1</th>
												<th style="text-align: center; font-weight: bold;">Sample 2</th>
                                                <th style="text-align: center; font-weight: bold;">Sample 3</th>
											</tr>
											<tr>
												<td style="font-weight: bold;">Dry Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.water_sample1_dry"/></td>
												<td style="text-align: center;"><span t-field="data.water_sample2_dry"/></td>
                                                <td style="text-align: center;"><span t-field="data.water_sample3_dry"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Wet/Saturated Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.water_sample1_wet"/></td>
												<td style="text-align: center;"><span t-field="data.water_sample2_wet"/></td>
                                                <td style="text-align: center;"><span t-field="data.water_sample3_wet"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Water Absorption</td>
												<td style="text-align: center;"><span t-field="data.water_sample1_result" t-options='{"widget": "float", "precision": 2}'/></td>
												<td style="text-align: center;"><span t-field="data.water_sample2_result" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td style="text-align: center;"><span t-field="data.water_sample3_result" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Average Water Absorption</td>
												<td colspan="3" style="text-align: center;"><span t-field="data.avg_water_absorption" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
										</table>

							<div t-if="data.water_absorption_visible" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
									
						</div>


                        <!-- Water Content -->
					<div t-if="data.water_content_visible" style = "page-break-before: always;margin-top:20px;">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Water Content
							</div>
						
								<table>
											<tr>
												<th style="text-align: center; font-weight: bold;">Sample No</th>
												<th style="text-align: center; font-weight: bold;">Sample 1</th>
												<th style="text-align: center; font-weight: bold;">Sample 2</th>
                                                <th style="text-align: center; font-weight: bold;">Sample 3</th>
											</tr>
											<tr>
												<td style="font-weight: bold;">Dry Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.water_content_sample1_dry"/></td>
												<td style="text-align: center;"><span t-field="data.water_content_sample2_dry"/></td>
                                                <td style="text-align: center;"><span t-field="data.water_content_sample3_dry"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Wet Weight (g)</td>
												<td style="text-align: center;"><span t-field="data.water_content_sample1_wet"/></td>
												<td style="text-align: center;"><span t-field="data.water_content_sample2_wet"/></td>
                                                <td style="text-align: center;"><span t-field="data.water_content_sample3_wet"/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Water Content</td>
												<td style="text-align: center;"><span t-field="data.water_content_sample1_result" t-options='{"widget": "float", "precision": 2}'/></td>
												<td style="text-align: center;"><span t-field="data.water_content_sample2_result" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td style="text-align: center;"><span t-field="data.water_content_sample3_result" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
											<tr>
												<td style="font-weight: bold;">Average Water Content</td>
												<td colspan="3" style="text-align: center;"><span t-field="data.avg_water_content" t-options='{"widget": "float", "precision": 2}'/></td>
											</tr>
										</table>
						</div>

						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								<div style="height: 40px;">
							<t t-if="eln.tested_by_signature_datasheet">

								<div t-if="eln.sample_id.filled_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
                    
					</div>
						
						
					</div>
						

                    
            

            </t>
        </t>
    </template>
</odoo>