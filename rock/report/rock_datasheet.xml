<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rock_datasheet">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px;font-weight: bold">
                    Rock
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>
                        <!-- <tr>
                            <td colspan="6">Age at Test: <span t-field="data.age_of_days"></span>
                            </td>
                            <td colspan="6">Sample Conditioning: <span t-field="data.sample_condition"></span>
                            </td>
                        </tr> -->
                    </table>
					
					<table>
						<tr style="height:50px" cols="12">
                            <td colspan="4">Performed By :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.technician.name"/>
                            </td>
                            <td colspan="4">Witness Name :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.witness_name"/>
                            </td>
                            <td colspan="4">Witness Signature :
                                <![CDATA[&nbsp;]]>
                                <span style='padding:20px'></span>
                            </td>
                        </tr>
					</table>


                     <!-- Specific Gravity And Water Absorption -->

                    <div t-if="data.specific_gravity_visible" style="margin-top:20px">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Specific Gravity And Water Absorption
							</div>

							<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Specimen No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Dry Weight of Sample, A (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Saturated Surface Dry Weight, B (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight in Water,  C (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Volume of Sample (B−C) (cm³)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Specific Gravity (A/(B−C))</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Water Absorption (%) ((B−A)/A ×100)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Remarks</th>
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.specific_gravity_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['dry_weight']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['ssd_weight']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['water_weight']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['volume_sample']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['specific_gravity']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['remarks']" />
									</td>
									
								</tr>
							</tbody>
						</table>


						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Specific Gravity :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_specific_gravity" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Water Absorption (%) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_water_absorption" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
						</table>
						
								
								
										

							<div t-if="data.specific_gravity_visible" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
						
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
									
						</div>
						



                      

                        <!-- Water Content -->
					<div t-if="data.water_content_visible" style = "page-break-before: always;margin-top:20px;">
							<div style="text-align:center;font-size:18px;margin-bottom:10px;">
								Water Content
							</div>
						
								<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Specimen No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Container No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of Empty Container, W₁ (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of Container + Wet Rock, W₂ (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of Container + Dry Rock, W₃ (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of Water (W₂ − W₃) (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Weight of Dry Rock (W₃ − W₁) (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Water Content (%) [(W₂ − W₃)/(W₃ − W₁) ×100]</th>
								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.water_content_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['container_no']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w1']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w2']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w3']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['weight_water']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['weight_dry_rock']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['water_content']" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									
								</tr>
							</tbody>
						</table>


						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Water Content (%) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_water_content" t-options='{"widget": "float", "precision": 3}'/>
								</td>
							</tr>
						</table>


						</div>







						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								<div style="height: 40px;">
							<t t-if="eln.tested_by_signature_datasheet">

								<div t-if="eln.sample_id.filled_by.employee_id.signature">
									<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
								</div>
								
							</t>
						</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.filled_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
                    
					</div>
						
						
					</div>
						

                    
            

            </t>
        </t>
    </template>
</odoo>