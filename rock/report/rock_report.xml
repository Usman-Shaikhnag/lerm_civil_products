<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="rock_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">--</t>
								</td>

                                <td colspan="1" >URL NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td>
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else=""></t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td>
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">-</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
											<span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">-</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<!-- <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">-</t> -->
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>

									<td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_temperature is not None">
											<span t-field="brick.brick_temperature"/>   °C
										</t>
									<t t-else="">-</t> -->
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_humidity is not None">
											<span t-field="brick.brick_humidity"/>   °C
										</t>
									<t t-else="">-</t> -->
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">-</t>
								</td>
								
							</tr>

							</table>
					</div>
				      
					 <div style="padding-top:5px">
						<span t-esc="o.material.test_parameter "/> 

					</div>
				
					<div class="container_eln" >
						<table style="margin-top:3px">
							<thead>
								<tr style="height:5px;" >
									<td style="text-align:center;" rowspan="1" >Sr.No</td>
									<td rowspan="1" style="text-align:center;">
									<span t-esc="eln.material.test_parameter"/>
									<!-- Test Parameters -->
									</td>
									<td rowspan="1" style="text-align:center;"> 
									<span t-esc="eln.material.result_remark"/>
									<!-- Test Result -->
									</td>
									<td rowspan="1" style="text-align:center;">
									<span t-esc="eln.material.unit"/>
									<!-- Unit -->
									</td>
									<td rowspan="1" style="text-align:center;"><span t-field="eln.material.specifications"></span></td>
									<td rowspan="1" style="text-align:center;">
									<span t-esc="eln.material.method_reference"/>
									<!-- Test Method -->
									</td>
									<td style="text-align:center;" rowspan="1" t-if="eln.conformity">Conformity</td>
								</tr>
							</thead>
							<t t-set="i" t-value="0"/>
							<tbody>
								<tr t-if="data.specific_gravity_visible and (data.avg_specific_gravity_nabl == 'pass' and nabl or (data.avg_specific_gravity_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<td colspan="1" style="text-align:center;">
										<div>
											<span t-esc="i + 1" />
											<t t-set="i" t-value="i+1"/>
										</div>
									</td>
									<td style="text-align:center;">
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','bf5d3d97-9a52-4242-9a36-2e40e5fc8247')]).parameter_name"/>
										</span>
									</td>
									<td style="text-align:center;">
										<span t-field="data.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									
									<td style="text-align:center;">
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','bf5d3d97-9a52-4242-9a36-2e40e5fc8247')]).unit.name"/>
										</span>
									</td>
									<td style="text-align:center;">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','bf5d3d97-9a52-4242-9a36-2e40e5fc8247')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td> 
									<td style="text-align: center; vertical-align: middle;">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','bf5d3d97-9a52-4242-9a36-2e40e5fc8247')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									<td t-if="eln.conformity" style="text-align:center;">
										<span t-field="data.avg_specific_gravity_conformity"/>
									</td>

								</tr>

								<tr t-if="data.water_absorption_visible and (data.avg_water_absorption_nabl == 'pass' and nabl or (data.avg_water_absorption_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<td colspan="1" style="text-align:center;">
										<div>
											<span t-esc="i + 1" />
											<t t-set="i" t-value="i+1"/>
										</div>
									</td>
									<td style="text-align:center;">
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','71e24ae1-b9a9-41cb-86a5-89d87312f3d6')]).parameter_name"/>
										</span>
									</td>
									<td style="text-align:center;">
										<span t-field="data.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									
									<td style="text-align:center;">  
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','71e24ae1-b9a9-41cb-86a5-89d87312f3d6')]).unit.name"/>
										</span>
									</td>
									<td style="text-align:center;">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','71e24ae1-b9a9-41cb-86a5-89d87312f3d6')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td> 
									<td style="text-align: center; vertical-align: middle;">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','71e24ae1-b9a9-41cb-86a5-89d87312f3d6')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									<td style="text-align:center;" t-if="eln.conformity">
										<span t-field="data.avg_water_absorption_conformity"/>
									</td>

								</tr>

								<tr t-if="data.water_content_visible and (data.avg_water_content_nabl == 'pass' and nabl or (data.avg_water_content_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<td style="text-align:center;" colspan="1">
										<div>
											<span t-esc="i + 1" />
											<t t-set="i" t-value="i+1"/>
										</div>
									</td>
									<td style="text-align:center;">
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','a1f9c5d0-0bc7-41a6-a2bb-0fe9d898008d')]).parameter_name"/>
										</span>
									</td>
									<td style="text-align:center;">
										<span t-field="data.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									
									<td style="text-align:center;">
										<span>
											<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','a1f9c5d0-0bc7-41a6-a2bb-0fe9d898008d')]).unit.name"/>
										</span>
									</td>
									<td style="text-align:center;">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','a1f9c5d0-0bc7-41a6-a2bb-0fe9d898008d')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td> 
									<td style="text-align: center; vertical-align: middle;">
										<span>
											<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','a1f9c5d0-0bc7-41a6-a2bb-0fe9d898008d')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									<td style="text-align:center;" t-if="eln.conformity">
										<span t-field="data.avg_water_content_conformity"/>
									</td>

								</tr>
						
					</tbody>
				</table>
				</div>
	

					<div style="page-break-inside: avoid;">
						<div style="margin-top:20px" class="noteContainer">
							<table>
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
						</div>

						<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
							<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>
							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							<!-- <div>
								<div t-if="stamp and stamp == '4-in_report'">
									<img t-attf-src="/lerm_civil/static/src/img/stamp.png" alt="Image"/>
								</div>
								<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
								</div>
							</div> -->
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							</div>
						</div>
						<!-- <div style="text-align:center;margin-top:25px">
							......End of Report......
						</div> -->
					</div>

				</div>
			</t>
		</t>
	</template>
</odoo>