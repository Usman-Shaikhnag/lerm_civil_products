<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_pricelist_item_last_sale_order_form" model="ir.ui.view">
            <field name="name">product.pricelist.item.last.sale.order.form</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='min_quantity']" position="after">
                    <field name="last_sale_order_id" readonly="1"
                        options="{'no_create': True, 'no_open': False}"/>
                </xpath>
            </field>
        </record>

        <record id="product_pricelist_item_last_sale_order_tree" model="ir.ui.view">
            <field name="name">product.pricelist.last.sale.order.tree</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price']" position="after">
                    <field name="last_sale_order_id" readonly="1" optional="show"/>
                    <button name="action_open_sale_order" type="object"
                        icon="fa-external-link" string="Open Source"
                        invisible="not last_sale_order_id"
                        help="Open the Sales Order"/>
                </xpath>
                <xpath expr="//field[@name='fixed_price']" position="after">
                    <field name="last_sale_order_id" readonly="1" optional="show"/>
                    <button name="action_open_sale_order" type="object"
                        icon="fa-external-link" string="Open Source"
                        invisible="not last_sale_order_id"
                        help="Open the Sales Order"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
