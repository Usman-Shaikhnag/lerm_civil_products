<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="lerm_civil_sale_srf_form" model="ir.ui.view">
            <field name="name">lerm.civil.srf.inherited.lerm.civil.sale</field>
            <field name="model">lerm.civil.srf</field>
            <field name="inherit_id" ref="lerm_civil.lerm_civil_srf_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='download_attachment']" position="after">
                    <field name="source"/>
                    <field name="sale_order_id"
                        invisible="source != 'sale_order'"/>
                    <field name="sales_person_id"
                        invisible="source != 'sale_order'"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
