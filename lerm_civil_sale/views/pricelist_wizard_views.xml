<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_sale_order_pricelist_wizard" model="ir.actions.act_window">
            <field name="name">Pricelist</field>
            <field name="res_model">sale.order.pricelist.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="sale_order_pricelist_wizard_form" model="ir.ui.view">
            <field name="name">sale.order.pricelist.wizard.form</field>
            <field name="model">sale.order.pricelist.wizard</field>
            <field name="arch" type="xml">
                <form string="Pricelist">
                    <group>
                        <field name="sale_order_id"/>
                        <field name="pricelist_id"/>
                        <field name="company_id"/>
                        <field name="currency_id"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="product_tmpl_id"/>
                            <field name="parameter_id"/>
                            <field name="current_price" readonly="1"/>
                            <field name="new_price"/>
                        </tree>
                    </field>
                    <footer>
                        <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
