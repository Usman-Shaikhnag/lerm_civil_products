<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_ggbs_form" model="ir.ui.view">
        <field name="name">mechanical.ggbs.form</field>
        <field name="model">mechanical.ggbs</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                <group >
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" readonly="1"/>
                        <field name="date_of_casting" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>
  
                    <!-- Specific Gravity -->
                    <div style="text-align: center;" invisible="not specific_gravity_visible">
                        <h1>
                            <field name="specific_gravity_name1" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div>
                     <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                       <tbody>
                         <tr>
                           <td>Observations</td>
                           <td><span>Trial 1</span></td>
                           <td><span>Trial 2</span></td>
                         </tr>
                         <tr>
                           <td><label for="temp_water1">Temperature of Water Bath  when Flask kept in bath – 0C</label></td>
                           <td><field  name="temp_water1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water2"  colspan="1"  nolabel="1"/></td>
                          </tr>
                         <tr>
                           <td><label for="temp_water_after1">Temperature of Water Bath  after One Hour when Flask kept in bath – 0C </label></td>
                           <td><field  name="temp_water_after1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water_after2"  colspan="1"  nolabel="1"/></td>
                         </tr>
                         <tr> 
                           <td><label for="initial_kerosene1">Initial Level of Kerosene after one hour kept in Water Bath(A) – ml</label></td>
                           <td><field  name="initial_kerosene1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="initial_kerosene2"  colspan="1"  nolabel="1"/></td>
                         </tr>
                      
                         <tr>
                           <td><label for="mass1">Mass of GGBS Sample Added in Flask (M) – gms</label></td>
                           <td><field  name="mass1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="mass2"  colspan="1"  nolabel="1"/></td>
                         </tr>      

                         <tr>
                           <td><label for="temp_water_flask1">Temperature of water bath  when Flask kept in bath after Adding GGBS – 0C</label></td>
                           <td><field  name="temp_water_flask1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water_flask2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="temp_water_one1">Temperature of water bath  after one hour when Flask kept in bath after Adding GGBS – 0C</label></td>
                           <td><field  name="temp_water_one1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="temp_water_one2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="final_kerosene1">Final Level of Kerosene after one hour kept in water bath(B) – ml</label></td>
                           <td><field  name="final_kerosene1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="final_kerosene2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="displaced1">Displaced Volume after Adding GGBS (V) = (B – A) – cm3</label></td>
                           <td><field  name="displaced1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="displaced2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                         <tr>
                           <td><label for="density1">Density of GGBS Sample  – gms/ cm3</label></td>
                           <td><field  name="density1"  colspan="1"  nolabel="1"/></td>
                           <td><field  name="density2"  colspan="1"  nolabel="1"/></td>
                         </tr>      
                        

                       </tbody>
                     </table>
                    </div>

                    <div>
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                          <tr>
                            <td><label for="average_density">Average Density of GGBS Sample – gms/ cm3</label></td>
                            <td><field name="average_density" class="oe_center" /></td>
                           </tr>
                           
                           </tbody>

                          </table>
                      </div>
                      <group/>



                    <!-- Slag index  -->

                    <div style="text-align: center;"  invisible = "slag_activity_7_visible == False">
                        <h1>
                            <field name="slag_activity_name1" readonly="1" nolabel="1"/>
                            <field name="slag_activity_7_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div style="text-align: center;" invisible = "slag_activity_7_visible == False">
                        <h1>
                            <field name="slag_activity_name" readonly="1" nolabel="1"/>
                            <field name="slag_activity_7_visible" invisible="1"/>
                        </h1>
                    </div>

             

                    <div class="custom_table_borders" invisible = "slag_activity_7_visible == False">
                      <field name="slag_index_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                          <field name="serial_no"/>
                          <field name="lab_id" width="120"/>
                          <field name="testing_period" width="120"/>
                          <field name="casting_details"/>
                           <field name="days"/>
                          <field name="testing_details" />
                          <field name="cube_im" />
                           <field name="length1"/>
                          <field name="length2"/>
                          <field name="avg_length"/>
                          <field name="width1"/>
                          <field name="width2"/>
                          <field name="avg_width"/>
                          <field name="height" />
                          <field name="load_failure" />
                          <field name="compressive_strength" />
                          <field name="avg_compressive_strength" />
                        </tree>
                      </field>
                    </div>



                 <div invisible = "slag_activity_7_visible == False">
                     <button type="object" name="action_calculate_avg_strength" class="btn btn-primary mb-2">
                        <i class="fa fa-calculator mr-1"/> Calculate Average
                    </button>
                  </div>

                  <div style="text-align: center;"  invisible = "slag_activity_7_visible == False">
                        <h1>
                            <field name="slag_activity_cement_name" readonly="1" nolabel="1"/>
                            <field name="slag_activity_7_visible" invisible="1"/>
                        </h1>
                    </div>

             

                    <div class="custom_table_borders" invisible = "slag_activity_7_visible == False">
                      <field name="slag_index_cement_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                          <field name="serial_no"/>
                          <field name="lab_id" width="120"/>
                          <field name="testing_period" width="120"/>
                          <field name="casting_details"/>
                          <field name="days"/>
                          <field name="testing_details" />
                          <field name="cube_im" />
                           <field name="length1"/>
                          <field name="length2"/>
                          <field name="avg_length"/>
                          <field name="width1"/>
                          <field name="width2"/>
                          <field name="avg_width"/>
                          <field name="height" />
                          <field name="load_failure" />
                          <field name="compressive_strength" />
                          <field name="avg_compressive_strength" />
                        </tree>
                      </field>
                    </div>


                  <div invisible = "slag_activity_7_visible == False">
                     <button type="object" name="action_calculate_avg_cemet_strength" class="btn btn-primary mb-2">
                        <i class="fa fa-calculator mr-1"/> Calculate Average
                    </button>
                  </div>


                   <div class="custom_table_borders" style="width:100%;" invisible = "slag_activity_7_visible == False">
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                     <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                        Lab ID
                                        </th>
                                         <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                        Testing Period
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                        Avg Compressive Strength of GGBS
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                         Avg Compressive Strength of Cement
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                          Slag Activity Index
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                      <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <!-- <field name="average_strength1" nolabel="1"/> -->
                                        </td>
                                          <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                              7
                                        </td>
                                       
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="average_strength1" nolabel="1"/>
                                        </td>
                                          <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="average_cement_strength1" nolabel="1"/>
                                        </td>
                                        
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="sai1" nolabel="1"/>
                                        
                                        </td>
                                    </tr>

                                     <tr>
                                      <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <!-- <field name="average_strength1" nolabel="1"/> -->
                                        </td>
                                          <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            28
                                        </td>

                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="average_strength2" nolabel="1"/>
                                        </td>
                                        
                                      
                                         <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="average_cement_strength2" nolabel="1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="sai2" nolabel="1"/>
                                        </td>
                                    </tr>
                                    
                                </tbody>
                            </table>
                        </div>

                         <div style="text-align: center;"  invisible = "fineness_visible == False">
                          <h1>
                              <field name="fineness_name" readonly="1" nolabel="1"/>
                              <field name="fineness_visible" invisible="1"/>
                          </h1>
                      </div>


                      <div class="custom_table_borders" style="width:100%;" invisible = "fineness_visible == False">


                      <div >
                        
                        
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="apparatus_constant_first">Apparatus Constant (K) (From Calibration Certificate of Blains Apparatus)</label></td>
                                    <td><field name="apparatus_constant_first"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>


                           <table style="border-collapse: collapse; width: 100%;">
                                <thead>
                                   <tr>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">Determination of Specific Surface (S)</th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;" colspan="2">First Cement Bed</th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;" colspan="2">Second Cement Bed</th>
                                    </tr>
                                    <tr>
                                        <th></th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;">Reading 1</th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;">Reading 2</th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;">Reading 1</th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;">Reading 2</th>
                                    </tr>
                                </thead>
                                <tbody>

                                   <tr>
                                  <th style="border: 1px solid black; text-align: center; padding: 8px 10px;" >
                                   Density of Cement (ƍ) – gm/cc
                                  </th>
                                  <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;" colspan="4"> <field name="density_cement" nolabel="1"/></th>
                              </tr>

                                <tr>
                                        <th style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                           Time Required For Manometer Drop (t) – sec
                                        </th>
                                         <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;"> <field name="first_bed_reading1" nolabel="1"/></th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;"> <field name="first_bed_reading2" nolabel="1"/></th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;"> <field name="second_bed_reading1" nolabel="1"/></th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;"> <field name="second_bed_reading2" nolabel="1"/></th>
                                </tr>

                                <tr>
                                  <th style="border: 1px solid black; text-align: center; padding: 8px 10px;" >
                                      Average Time Required For Manometer Drop (t) – sec
                                  </th>
                                  <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;" colspan="4"> <field name="avg_time_first" nolabel="1"/></th>
                              </tr>

                               <tr>
                                  <th style="border: 1px solid black; text-align: center; padding: 8px 10px;" >
                                     Apparatus Constant (K) (From Calibration Certificate of Blains Apparatus)
                                  </th>
                                  <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;" colspan="4"> <field name="apparatus_constant_first" nolabel="1"/></th>
                              </tr>

                              <tr>
                                  <th style="border: 1px solid black; text-align: center; padding: 8px 10px;" >
                                   Specific Surface at 27±2 0C (S) =  – m2/kg
                                  </th>
                                  <th style="border: 1px solid black; text-align: center; color: black; padding: 5px 10px;" colspan="4"> <field name="specific_surface_first" nolabel="1"/></th>
                              </tr>
                              

                                    
                                    
                                </tbody>
                            </table>

                          </div>
                                

                
                    

                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />


                    
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>