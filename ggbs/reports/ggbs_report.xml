<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	
	<template id="lerm_ggbs_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			
			<!-- <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln_general"> -->
			<t t-call="lerm_civil.genstru_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report on GGBS Mechanical</b></p>
				</div> -->
				<div class="container_eln">
					<div t-foreach="eln" t-as="o">
					
						 <table class="table table-sm" style="width: 100%; border-collapse: collapse;" border="1">
							<tr>
								<td ><strong>Mechanical Testing</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>
								<td ><strong>URL NO</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.sample_id.ulr_no"/></td>
							</tr>

							<tr>
								<td><strong>Project Name</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.srf_id.name_work"/></td>

								<td><strong>Date of Report</strong>: </td>
									
								<td >
								<span t-field="o.start_date" style="margin-right:10px;"/> 		
								</td>
							</tr>
						
							
						
							<tr>
							<td style="width:20%;"><strong>Name &amp; Address of Customer</strong>: </td>
							<td style="padding-left: 10px;width:25%;">
										<span t-field="o.srf_id.customer.name"/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
								</td>
								<!-- <td><strong>Date Sample Received</strong>: </td> -->
								<!-- <td >
								<span t-field="o.sample_id.sample_received_date"/>
								</td > -->
								

								<td><strong>Date Sample Received</strong>:</td>
								<td>
									<!-- <t t-if="ggbs.rock_child_lines">
										<span t-field="data.rock_child_lines[0].date_received"/>
									</t> -->
								</td>
							</tr>
							<tr>
								<td><strong>Report No.</strong>: </td>
								<td></td>

								<td><strong>Starting Date</strong>: </td>
								<td>
									<!-- <t t-if="data.rock_child_lines">
										<span t-field="data.rock_child_lines[0].date_received"/>
									</t> -->
								</td>
							
							</tr>
							
							<tr>

								<td><strong>Type of Sample &amp; Condition</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>

							<td><strong>Completion Date</strong>: </td>
								<td>
									<!-- <t t-if="data.rock_child_lines">
										<span t-field="data.rock_child_lines[0].date_testing"/>
									</t> -->
								</td>
						</tr>

						

							
						</table>
					</div>
					
					<table style="margin-top:10px;margin-bottom:0px;">
					<t t-set="i" t-value="0"/>
						<thead>
							<tr>
								<th rowspan="2" style="text-align: center;font-weight: bold;">
									<span>
										Sr. No
									</span>
								</th>
								<th rowspan="2" style="text-align: center;font-weight: bold;">  
								    <span t-esc="eln.material.test_parameter"/>
							
								</th>
								<th rowspan="2"  style="text-align: center;font-weight: bold;">
									<span>
										<span t-esc="eln.material.method_reference"/>
									</span>
								</th>

								<th colspan="2"  style="text-align: center;font-weight: bold;">
									<span>
										Environmental Condition:
									</span>
								</th>
								<th rowspan="2" style="text-align: center;font-weight: bold;">
									<span t-esc="eln.material.unit"/>
								
								</th>
								<th rowspan="2" style="text-align: center;font-weight: bold;">
									<span t-esc="eln.material.result_remark"/>
								
								</th>

								<th rowspan="2"  style="text-align: center;font-weight: bold;">
									<span>
										<span t-esc="eln.material.specifications"/>
									</span>
								</th>

							
								<th rowspan="2" style="text-align: center;font-weight: bold;" t-if="eln.conformity">
									<span>
										Conformity
									</span>
								</th>

								
							</tr>
							<tr>
							 <th colspan="1"  style="text-align: center;font-weight: bold;">
									<span>
										Temp.°C
									</span>
								</th>
								<th colspan="1"  style="text-align: center;font-weight: bold;">
									<span>
										Humidity %
									</span>
								</th>
							</tr>
						</thead>
						<tbody >
			

							<tr  t-if="ggbs.specific_gravity_visible and (ggbs.specific_gravity_nabl == 'pass' and nabl or (ggbs.specific_gravity_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>

								<td >
									<span t-field="env['lerm.parameter.master'].search([('internal_id','=','210bgf54-baa4-466f-a6a7-044da708f265')]).parameter_name"/>
								</td>
								<td style="text-align: center;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','210bgf54-baa4-466f-a6a7-044da708f265')]).parameter_table" t-as="parameter">
										<!-- <t t-if="parameter.grade.id == eln.grade_id.id"> -->
											<span t-field="parameter.specification"/>
										<!-- </t> -->
									</t>
								</td>	

								<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.temp_specific"/>
									</span>									
								</td>	
									<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.humidity_specific"/>
									</span>									
								</td>	

								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','210bgf54-baa4-466f-a6a7-044da708f265')]).unit.name"/>
									</span>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="ggbs.average_density"/>
									</span>									
								</td>

								<td style="text-align: center;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','210bgf54-baa4-466f-a6a7-044da708f265')]).parameter_table" t-as="parameter">
										<!-- <t t-if="parameter.grade.id == eln.grade_id.id"> -->
											<span t-field="parameter.permissable_limit"/>
										<!-- </t> -->
									</t>
								</td>
								
									

								<td style="text-align: center;" t-if="eln.conformity">
									<span t-field="ggbs.specific_gravity_confirmity"/>
								</td>
								
							</tr>

						
							<!-- Fineness  -->

				

							<tr   t-if="ggbs.fineness_visible and (ggbs.fineness_nabl == 'pass' and nabl or (ggbs.fineness_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>

								<td  >
									<span t-field="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-6b0ff7e69c0a')]).parameter_name"/>
								</td>
								<td style="text-align: center;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-6b0ff7e69c0a')]).parameter_table" t-as="parameter">
										<!-- <t t-if="parameter.grade.id == eln.grade_id.id"> -->
											<span t-field="parameter.specification"/>
										<!-- </t> -->
									</t>
								</td>

								<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.temp_fineness"/>
									</span>									
								</td>	
									<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.humidity_fineness"/>
									</span>									
								</td>	
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-6b0ff7e69c0a')]).unit.name"/>
									</span>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="ggbs.specific_surface_first"/>
									</span>									
								</td>

								<td style="text-align: center;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-6b0ff7e69c0a')]).parameter_table" t-as="parameter">
										<!-- <t t-if="parameter.grade.id == eln.grade_id.id"> -->
											<span t-field="parameter.permissable_limit"/>
										<!-- </t> -->
									</t>
								</td>
								
								
								
								
								<td style="text-align: center;" t-if="eln.conformity">
									<span t-field="ggbs.fineness_confirmity"/>
								</td>
							</tr>


							<tr t-if="ggbs.slag_activity_7_visible ">

								<td rowspan="3" style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>
							  
							  <td   colspan="7">
									<span t-field="env['lerm.parameter.master'].search([('internal_id','=','1452fgr0-8e67-4e94-86ea-98d9472f5c71')]).parameter_name"/>
								</td>
							</tr>

							<tr    t-if="ggbs.slag_activity_7_visible and (ggbs.day_7_nabl == 'pass' and nabl or (ggbs.day_7_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							

								<td  >
									<span t-field="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-321478658')]).parameter_name"/>
									<!-- 7 Days  -->
								</td>
								<td rowspan="2" style="text-align: center;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-321478658')]).parameter_table" t-as="parameter">
										<!-- <t t-if="parameter.grade.id == eln.grade_id.id"> -->
											<span t-field="parameter.specification"/>
										<!-- </t> -->
									</t>
								</td>

								<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.temp_7day"/>
									</span>									
								</td>	
									<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.humidity_7day"/>
									</span>									
								</td>	
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-321478658')]).unit.name"/>
									</span>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="ggbs.sai1"/>
									</span>									
								</td>

								<td style="text-align: center;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-321478658')]).parameter_table" t-as="parameter">
										<!-- <t t-if="parameter.grade.id == eln.grade_id.id"> -->
											<span t-field="parameter.permissable_limit"/>
										<!-- </t> -->
									</t>
								</td>
								
								
								
								
								<td style="text-align: center;" t-if="eln.conformity">
									<span t-field="ggbs.day_7_confirmity"/>
								</td>
							</tr>



							<tr   t-if="ggbs.slag_activity_7_visible and (ggbs.day_28_nabl == 'pass' and nabl or (ggbs.day_28_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							

								<td  >
									<span t-field="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-3214855pp')]).parameter_name"/>
									<!-- 28 Days  -->
								</td>
								

								<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.temp_28day"/>
									</span>									
								</td>	
									<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.humidity_28day"/>
									</span>									
								</td>	
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-3214855pp')]).unit.name"/>
									</span>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="ggbs.sai2"/>
									</span>									
								</td>

								<td style="text-align: center;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','5214hgtb-c526-4092-a3a7-3214855pp')]).parameter_table" t-as="parameter">
										<!-- <t t-if="parameter.grade.id == eln.grade_id.id"> -->
											<span t-field="parameter.permissable_limit"/>
										<!-- </t> -->
									</t>
								</td>
								
								
								
								
								<td style="text-align: center;" t-if="eln.conformity">
									<span t-field="ggbs.day_28_confirmity"/>
								</td>
							</tr>

							
						
						</tbody>
					</table>
					<div style="margin-top:5px" class="noteContainer">
							<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Remarks:-</b>
									&#160;&#160;* Refer to Annexure- I to know NABL accredited scope, range and uncertainty of measurement for test parameter
									
								</td>
							</tr>

							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Notes:-</b>
									&#160;&#160;a. The information marked with an #  received from customer
									&#160;&#160;b. The results listed refer only to tested parameters and sample as received from customer
									&#160;&#160;c. The balance samples if any will be discarded  after 15 days from the date of issue of test certificate unless otherwise specified.
									&#160;&#160;d.This document shall not be reproduced in part or full without the approval of Genstru.
									&#160;&#160;e. ^represents unsoaked test
									&#160;&#160;f. $ represents crumbled in water
								
								</td>
							</tr>
						</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<div>
							<!-- <img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/> -->
						</div>

						<div>
									<b>
										Stamp
									</b>
									
								</div>
				
					</div>
							
							<div>
								<div>
									<b>
										Reviewed &amp; Issued By
									</b>
									
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<!-- <div style="text-align:center;margin-top:10px">
							......End of Report......
						</div> -->
					</div>
				
			</t>
		</t>
	</template>
