													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="final_setting.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr> 


									<!-- FINENESS OF GGBS BY BLAINE AIR PERMEABILITY METHOD -->
							<tr t-if="ggbs.fineness_blaine_visible and (ggbs.specific_surface_final_report == 'nabl' and nabl or ggbs.specific_surface_final_report == 'non_nabl' and not nabl)">
									<t t-set="specific_surface" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','6a94f8a3-dd41-4516-bd7b-d74c89bd924a')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
										<span t-esc="specific_surface.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="ggbs.specific_surface" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="specific_surface.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="specific_surface.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="specific_surface.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>



									<!-- SOUNDNESS OF GGBS BY LE-CHATELIER METHOD -->
							<tr t-if="ggbs.soundness_cement_visible and (ggbs.soundness_expansion_final_report == 'nabl' and nabl or ggbs.soundness_expansion_final_report == 'non_nabl' and not nabl)">
									<t t-set="soundness" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','a76ec90d-a344-49de-9b98-ca0cda833fe5')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
										<span t-esc="soundness.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="ggbs.avg_soundness_expansion" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="soundness.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="soundness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="soundness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- SPECIFIC GRAVITY OF GGBS -->
							<tr t-if="ggbs.specific_gravity_visible and (ggbs.specific_gravity_final_report == 'nabl' and nabl or ggbs.specific_gravity_final_report == 'non_nabl' and not nabl)">
									<t t-set="specific_gravity" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','8d7d0d6c-9960-4ea6-b4eb-bca8b8cf78a1')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
										<span t-esc="specific_gravity.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="ggbs.average_specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="specific_gravity.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="specific_gravity.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="specific_gravity.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


									<!-- MOISTURE CONTENT OF GGBS -->
							<tr t-if="ggbs.moisture_content_visible and (ggbs.average_moisture_final_report == 'nabl' and nabl or ggbs.average_moisture_final_report == 'non_nabl' and not nabl)">
									<t t-set="moisture" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','c69ca85f-ab48-4370-9cd1-96f3374ac4dd')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td>
										<span t-esc="moisture.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="ggbs.average_moisture" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="moisture.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="moisture.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="moisture.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


						</tbody>
					</table>
				</div>












					<div style="page-break-inside: avoid;">
						<div style="margin-top:10px" class="noteContainer">
							<table>
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="ggbs.notes_id">
											<t t-foreach="ggbs.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
						</div>
						
						
						<div style="page-break-inside: avoid;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>
							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.approveby_signature_required">
										<div t-if="eln.sample_id.approved_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							</div>
						</div>
						<!-- <div style="text-align:center;margin-top:25px">
							......End of Report......
						</div> -->
						<!-- <div style="margin-top: 20px; text-align: center;">
							<p style="border-top: 1px dashed #000; padding-top: 10px;">
								...... End Of Report......
							</p>
						</div> -->
					</div>
				</div>
				
			</t>
		</t>
	</template>
</odoo>