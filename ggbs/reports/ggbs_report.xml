<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	
	<template id="lerm_ggbs_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			
			<!-- <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln_general"> -->
			<t t-call="lerm_civil.genstru_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report on GGBS Mechanical</b></p>
				</div> -->
				<div class="container_eln" style="padding-top:0px;">
					<div class="" t-foreach="eln" t-as="o">
						
					

						 <table class="table table-sm" style="width: 100%; border-collapse: collapse;" border="1">
							<tr>
								<!-- <td ><strong>Mechanical Testing</strong>: </td>
								<td style="padding-left: 10px;"><span t-field="o.material.name"/></td> -->
								<!-- <td colspan="3"><strong>Report No</strong>: </td>
								<td colspan="3" style="padding-left: 10px;"><span t-field="o.sample_id.kes_no"/></td>
								<td colspan="3" ><strong>URL NO</strong>: </td>
								<td colspan="3" style="padding-left: 10px;"><span t-field="o.sample_id.ulr_no"/></td> -->
							</tr>

							<tr>
								<td colspan="3"><strong>Project Name</strong>: </td>
								<td colspan="9" style="padding-left: 10px;"><span t-field="o.srf_id.name_work"/></td>

								<!-- <td><strong>Date of Report</strong>: </td>
									
								<td >
								<span t-field="o.start_date" style="margin-right:10px;"/> 		
								</td> -->
							</tr>
						
							
						
							<tr>
							<td colspan="3" style="width:20%;"><strong>Name &amp; Address of Customer</strong>: </td>
							<td colspan="3" style="padding-left: 10px;width:25%;">
										<span t-field="o.srf_id.customer.name"/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
								</td>
								<!-- <td><strong>Date Sample Received</strong>: </td> -->
								<!-- <td >
								<span t-field="o.sample_id.sample_received_date"/>
								</td > -->
								

								<td colspan="3"><strong>Date Sample Received</strong>:</td>
								<td colspan="3">
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								
								<td colspan="3" ><strong>Mechanical Testing</strong>: </td>
								<td colspan="3" style="padding-left: 10px;"><span t-field="o.sample_id.group_id"/></td>

								<td colspan="3"><strong>Date of Report</strong>: </td>
									
								<td colspan="3">
								<span t-field="o.start_date" style="margin-right:10px;"/> 		
								</td>



								
							
							</tr>

							<tr>
								
								
								<td colspan="3"><strong>Location</strong>: </td>
								<td colspan="3">
								Permanent facility
							        <!-- <span t-field="o.start_date" style="margin-right:10px;"/> -->
								</td>
								
								

								<td colspan="3"><strong>Starting Date</strong>: </td>
								<td colspan="3">
							        <span t-field="o.start_date" style="margin-right:10px;"/>
								</td>
							
							</tr>
							
							<tr>

								<td colspan="3"><strong>Sample Description</strong>: </td>
								<td colspan="3"><span t-field="o.material.name"/></td>

							<td colspan="3"><strong>Completion Date</strong>: </td>
								<td colspan="3">
								<span t-field="o.end_date" />
								</td>
						</tr>

						<tr>

								<td colspan="3"><strong>Source of Sample </strong>: </td>
								<td colspan="3" style="padding-left: 10px;">
								  <span t-field="o.source_sample"/>
								
								</td>

							<td colspan="3"><strong>No. of Sample</strong>: </td>
								<td colspan="3">
									<span t-field="o.quantity" />
								</td>
						</tr>

						

							
						</table>
					</div>
					
					<table style="margin-top:10px;margin-bottom:0px;">
					<t t-set="i" t-value="0"/>
						<thead>
							<tr>
								<th rowspan="2" style="text-align: center;font-weight: bold;">
									<span>
										Sr. No
									</span>
								</th>
								<th rowspan="2" style="text-align: center;font-weight: bold;">  
								    <span t-esc="eln.material.test_parameter"/>
							
								</th>
								<th rowspan="2"  style="text-align: center;font-weight: bold;">
									<span>
										<span t-esc="eln.material.method_reference"/>
									</span>
								</th>

								<th colspan="2"  style="text-align: center;font-weight: bold;">
									<span>
										Environmental Condition:
									</span>
								</th>
								<th rowspan="2" style="text-align: center;font-weight: bold;">
									<span t-esc="eln.material.unit"/>
								
								</th>
								<th rowspan="2" style="text-align: center;font-weight: bold;">
									<span t-esc="eln.material.result_remark"/>
								
								</th>

								<th rowspan="2"  style="text-align: center;font-weight: bold;">
									<span>
										<span t-esc="eln.material.specifications"/>
									</span>
								</th>

							
								<th rowspan="2" style="text-align: center;font-weight: bold;" t-if="eln.conformity">
									<span>
										Conformity
									</span>
								</th>

								
							</tr>
							<tr>
							 <th colspan="1"  style="text-align: center;font-weight: bold;">
									<span>
										Temp.°C
									</span>
								</th>
								<th colspan="1"  style="text-align: center;font-weight: bold;">
									<span>
										Humidity %
									</span>
								</th>
							</tr>
						</thead>
						<tbody >
			

							<tr  t-if="ggbs.specific_gravity_visible and (ggbs.specific_gravity_nabl == 'pass' and nabl or (ggbs.specific_gravity_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>

								<td >
									<span t-field="parameters.get('210bgf54-baa4-466f-a6a7-044da708f265').parameter_name"/>

								</td>
								<!-- <td style="text-align: center;">
									<t t-foreach="parameters.get('210bgf54-baa4-466f-a6a7-044da708f265').parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
										</t>
									</t>
								</td>	 -->
								<td style="text-align: center;">

								
								<t t-if="not eln.grade_id">
									<span t-esc="parameters.get('210bgf54-baa4-466f-a6a7-044da708f265').test_method.test_method"/>
								</t>

							
								<t t-if="eln.grade_id">
									<t t-set="printed" t-value="False"/>

									<t t-foreach="parameters.get('210bgf54-baa4-466f-a6a7-044da708f265').parameter_table" t-as="parameter">
										<t t-if="parameter.grade and parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
											<t t-set="printed" t-value="True"/>
										</t>
									</t>

								
									<t t-if="printed == False">
										<span t-esc="parameters.get('210bgf54-baa4-466f-a6a7-044da708f265').test_method.test_method"/>
									</t>
								</t>

							</td>

								<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.temp_specific"/>
									</span>									
								</td>	
									<td style="text-align: center;" >
									<span>
										<span t-field="ggbs.humidity_specific"/>
									</span>									
								</td>	

								<td style="text-align: center;">
									<span>
										<span t-field="parameters.get('210bgf54-baa4-466f-a6a7-044da708f265').unit.name"/>
									</span>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="ggbs.average_density"/>
									</span>									
								</td>

								<td style="text-align: center;">
									<t t-foreach="parameters.get('210bgf54-baa4-466f-a6a7-044da708f265').parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.permissable_limit"/>
										</t>
									</t>
								</td>

								
									

								<td style="text-align: center;" t-if="eln.conformity">
									<span t-field="ggbs.specific_gravity_confirmity"/>
								</td>
								
							</tr>

						

				

							<!-- GGBS Parameters Table -->
						<tr t-if="ggbs.fineness_visible and (ggbs.fineness_nabl == 'pass' and nabl or (ggbs.fineness_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							<td style="text-align: center;">
								<span t-esc="i + 1"/>
								<t t-set="i" t-value="i+1"/>
							</td>

							<td>
								<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-6b0ff7e69c0a').parameter_name"/>
							</td>

							
							

							<td style="text-align: center;">

								
								<t t-if="not eln.grade_id">
									<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-6b0ff7e69c0a').test_method.test_method"/>
								</t>

							
								<t t-if="eln.grade_id">
									<t t-set="printed" t-value="False"/>

									<t t-foreach="parameters.get('5214hgtb-c526-4092-a3a7-6b0ff7e69c0a').parameter_table" t-as="parameter">
										<t t-if="parameter.grade and parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
											<t t-set="printed" t-value="True"/>
										</t>
									</t>

								
									<t t-if="printed == False">
										<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-6b0ff7e69c0a').test_method.test_method"/>
									</t>
								</t>

							</td>


								

							<td style="text-align: center;">
								<span t-field="ggbs.temp_fineness"/>
							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.humidity_fineness"/>
							</td>

							<td style="text-align: center;">
								<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-6b0ff7e69c0a').unit.name"/>
							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.specific_surface_first"/>
							</td>

							<td style="text-align: center;">
								<t t-foreach="parameters.get('5214hgtb-c526-4092-a3a7-6b0ff7e69c0a').parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-esc="parameter.permissable_limit"/>
									</t>
								</t>
							</td>

							<td style="text-align: center;" t-if="eln.conformity">
								<span t-field="ggbs.fineness_confirmity"/>
							</td>
						</tr>

						<!-- Slag Activity Header -->
						<tr t-if="ggbs.slag_activity_7_visible">
							<td rowspan="3" style="text-align: center;">
								<span t-esc="i + 1"/>
								<t t-set="i" t-value="i+1"/>
							</td>
							<td colspan="7">
								<span t-esc="parameters.get('1452fgr0-8e67-4e94-86ea-98d9472f5c71').parameter_name"/>
							</td>
						</tr>

						<!-- 7 Day Activity -->
						<tr t-if="ggbs.slag_activity_7_visible and (ggbs.day_7_nabl == 'pass' and nabl or (ggbs.day_7_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							<td>
								<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-321478658').parameter_name"/>
							</td>

							<!-- <td rowspan="2" style="text-align: center;">
								<t t-foreach="parameters.get('5214hgtb-c526-4092-a3a7-321478658').parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-esc="parameter.specification"/>
									</t>
								</t>
							</td> -->

							<td style="text-align: center;" rowspan="2">

								
								<t t-if="not eln.grade_id">
									<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-321478658').test_method.test_method"/>
								</t>

								
								<t t-if="eln.grade_id">
									<t t-set="printed" t-value="False"/>

									<t t-foreach="parameters.get('5214hgtb-c526-4092-a3a7-321478658').parameter_table" t-as="parameter">
										<t t-if="parameter.grade and parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.specification"/>
											<t t-set="printed" t-value="True"/>
										</t>
									</t>

								
									<t t-if="printed == False">
										<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-321478658').test_method.test_method"/>
									</t>
								</t>

							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.temp_7day"/>
							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.humidity_7day"/>
							</td>

							<td style="text-align: center;">
								<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-321478658').unit.name"/>
							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.sai1"/>
							</td>

							<td style="text-align: center;">
								<t t-foreach="parameters.get('5214hgtb-c526-4092-a3a7-321478658').parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-esc="parameter.permissable_limit"/>
									</t>
								</t>
							</td>

							<td style="text-align: center;" t-if="eln.conformity">
								<span t-field="ggbs.day_7_confirmity"/>
							</td>
						</tr>

						<!-- 28 Day Activity -->
						<tr t-if="ggbs.slag_activity_7_visible and (ggbs.day_28_nabl == 'pass' and nabl or (ggbs.day_28_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
							<td>
								<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-3214855pp').parameter_name"/>
							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.temp_28day"/>
							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.humidity_28day"/>
							</td>

							<td style="text-align: center;">
								<span t-esc="parameters.get('5214hgtb-c526-4092-a3a7-3214855pp').unit.name"/>
							</td>

							<td style="text-align: center;">
								<span t-field="ggbs.sai2"/>
							</td>

							<td style="text-align: center;">
								<t t-foreach="parameters.get('5214hgtb-c526-4092-a3a7-3214855pp').parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-esc="parameter.permissable_limit"/>
									</t>
								</t>
							</td>

							<td style="text-align: center;" t-if="eln.conformity">
								<span t-field="ggbs.day_28_confirmity"/>
							</td>
						</tr>


						</tbody>
					</table>



					<div style="margin-top:50px" class="noteContainer">
						<table>
							<tr>
							
								<td style="padding: 5px; font-style: italic; font-size: 15px; line-height: 18px;">
									<b>Remarks:</b><br/><br/>
									    * Refer to Annexure-I for environmental and test conditions<br/><br/>
									    * Refer to Annexure-I (A) to know NABL accredited scope, range and uncertainty of measurement for test parameter<br/><br/>

									<b>Notes:-</b><br/><br/>
								    	<!-- a. The information marked with an # received from customer<br/><br/>
							        	b. The results listed refer only to tested parameters and sample as received from customer<br/><br/>
							        	c. The balance samples if any will be discarded after 15 days from the date of issue of test certificate unless otherwise specified.<br/><br/>
							        	d. This document shall not be reproduced in part or full without the approval of Genstru. -->

										<t t-if="ggbs.notes_id">
										<t t-foreach="ggbs.notes_id" t-as="n">
											<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span><br/><br/>
										</t>
									</t>
								</td>
							</tr>
							</table>
						</div>


						

						<div class="signatureContainer girdgird">
							<table style="width:100%; border:1px solid black; border-collapse:collapse; font-family:Arial; font-size:12px; text-align:center;">
						    <tr style="height:100px;">
							
							<td style="width:33.33%; border-right:1px solid black; vertical-align:bottom; padding-bottom:5px;text-align:center;">
							<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								 <b>
										<span t-esc="eln.technician.name"/>
									</b><br/>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b><br/>
								<span style="font-size:12px;">Prepared By</span>
							</td>

							<td style="width:33.33%; border-right:1px solid black; vertical-align:bottom; padding-bottom:5px;text-align:center;">
								<b style="font-size:13px;">Stamp</b>
							</td>

							<td style="width:33.33%; vertical-align:bottom; padding-bottom:5px;text-align:center;">
							<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b><br/>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b><br/>
								<span style="font-size:12px;">Reviewed &amp; Issued By</span>
							</td>
						</tr>

					</table>
						
				
					</div>
				</div>
				
			</t>
		</t>
	</template>
</odoo>