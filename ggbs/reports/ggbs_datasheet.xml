									<span t-field="data.set_normal_consistency" />
								</td>
								<td colspan="6" style="text-align: center; padding: 8px; border: 1px solid #ccc;">Weight of Water Added = 0.85 * Normal Consistency x Weight of Cement Sample in Initial And Final Setting Time :</td>
								<td colspan="6" style="text-align: center;padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.weight_of_water" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>


