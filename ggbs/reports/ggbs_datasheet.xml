					<!-- SPECIFIC GRAVITY OF GGBS -->

					<div  t-if="data.specific_gravity_visible" style="page-break-before: always;" >
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							SPECIFIC GRAVITY OF GGBS
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Trail No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Weight of GGBS Sample W1 in (g)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Initial Reading of Flask V1 in (ml)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Final Reading of Flask V2 in (ml)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Volume of GGBS (V2 - V1)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Weight of Equal Volume of water=(V2-V1)xSpecific gravity of Water</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Sp. Gravity of GGBS=W1/Weight of equal volume of Water</th>
								</tr>
							</thead>
							<tbody>
