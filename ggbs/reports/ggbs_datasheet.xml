									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Elapsed Time (Min)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Needle Result</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.final_time_lines" t-as="r" style="text-align: center;">
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
