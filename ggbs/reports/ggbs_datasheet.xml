									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Measurement taken after 24 hours of immersion in water at a temp. of 27 + 20C = L1 (mm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Measurement taken after 3 hours of immersion in water at a Boiling Temperature = L2 (mm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Expansion L1-L2 (mm)</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.soundness_cement_lines" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
