								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.intial_time_lines" t-as="r" style="text-align: center;">
									<td style="text-align: center;border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['time']"/>
