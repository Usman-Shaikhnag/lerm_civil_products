<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_dms" model="ir.module.category">
            <field name="name">Document Management</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_dms_user" model="res.groups">
            <field name="name">DMS / User</field>
            <field name="category_id" ref="module_category_dms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_dms_uploader" model="res.groups">
            <field name="name">DMS / Uploader</field>
            <field name="category_id" ref="module_category_dms"/>
            <field name="implied_ids" eval="[(4, ref('document_management.group_dms_user'))]"/>
        </record>

        <record id="group_dms_manager" model="res.groups">
            <field name="name">DMS / Manager</field>
            <field name="category_id" ref="module_category_dms"/>
            <field name="implied_ids" eval="[(4, ref('document_management.group_dms_uploader'))]"/>
        </record>

        <record id="group_dms_auditor" model="res.groups">
            <field name="name">DMS / Auditor</field>
            <field name="category_id" ref="module_category_dms"/>
            <field name="implied_ids" eval="[(4, ref('document_management.group_dms_user'))]"/>
        </record>

    </data>
</odoo>
