<templates>
    <t t-name="document_management.DMSHeader" owl="1">
        <header class="o_dms_header">
            <button class="o_dms_icon_btn d-lg-none" t-on-click="props.onToggleSidebar">
                <i class="fa" t-att-class="props.sidebarOpen ? 'fa-times' : 'fa-bars'"/>
            </button>

            <h1 class="o_dms_title" t-esc="props.viewLabel"/>

            <div class="o_dms_search">
                <i class="fa fa-search"/>
                <input
                    type="text"
                    placeholder="Search all documents..."
                    t-att-value="state.value"
                    t-on-input="onSearchInput"
                />
                <button t-if="state.value" class="o_dms_search_clear"
                        t-on-click="props.onClearSearch"
                        title="Clear search">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <div class="o_dms_header_actions">
                <div class="o_dms_view_toggle">
                    <button class="o_dms_icon_btn" t-att-class="props.viewMode === 'grid' ? 'active' : ''"
                            t-on-click="() => props.onSetViewMode('grid')"
                            title="Grid view">
                        <i class="fa fa-th-large"/>
                    </button>
                    <button class="o_dms_icon_btn" t-att-class="props.viewMode === 'list' ? 'active' : ''"
                            t-on-click="() => props.onSetViewMode('list')"
                            title="List view">
                        <i class="fa fa-list"/>
                    </button>
                </div>
                <button class="o_dms_btn o_dms_btn_outline" t-on-click="props.onNewFolder">
                    <i class="fa fa-folder-plus"/>
                    <span>New Folder</span>
                </button>
                <button class="o_dms_btn o_dms_btn_primary" t-on-click="props.onUpload">
                    <i class="fa fa-upload"/>
                    <span>Upload</span>
                </button>
            </div>
        </header>
    </t>
</templates>
