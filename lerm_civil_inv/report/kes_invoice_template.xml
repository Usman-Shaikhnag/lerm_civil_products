                                <td style="border:1px solid black; padding:5px; text-align:right;">
                                    ₹ <span t-field="o.amount_untaxed"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid black; padding:5px; color:#0070c0;"><b>CGST @9%</b></td>
                                <td style="border:1px solid black; padding:5px; text-align:right;">
                                    ₹ <span t-esc="o.amount_tax/2"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid black; padding:5px; color:#0070c0;"><b>SGST @9%</b></td>
                                <td style="border:1px solid black; padding:5px; text-align:right;">
                                    ₹ <span t-esc="o.amount_tax/2"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid black; padding:5px;"><b>Round off.</b></td>
                                <td style="border:1px solid black; padding:5px; text-align:right;">
                                    ₹ <span t-esc="round(o.amount_total - (o.amount_untaxed + o.amount_tax), 2)"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid black; padding:5px; font-weight:bold; background:#d9d9d9;">
                                    TOTAL
                                </td>
                                <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold; background:#d9d9d9;">
                                    ₹ <span t-field="o.amount_total"/>
                                </td>
                            </tr>

                        </table>

                       

                    </td>

                    

                </tr>

                

            </table>

          <!-- ================= AMOUNT IN WORDS ================= -->
          <table style="width:100%; border-collapse:collapse; margin-top:2px;">

