                    <table style="width:100%; border-collapse:collapse; margin-top:5px;">
                        <tr>
                            <td style="text-align:center; font-size:16px; font-weight:bold; border:1px solid black;">
                                TAX INVOICE
                            </td>
                        </tr>
                    </table>

                    <!-- ================= CUSTOMER + INVOICE ================= -->
                    <table style="width:100%; border-collapse:collapse; font-size:13px;">

    <tr>

        <!-- LEFT SIDE -->
        <td style="width:60%; border:1px solid black; padding:0px; vertical-align:top;">

            <!-- BILL TO HEADER (ONLY LEFT SIDE) -->
            <div style="background:#0a8f3c; color:white; text-align:center; font-weight:bold; border-bottom:1px solid black; padding:5px;">
                BILL TO
            </div>

            <!-- CONTENT -->
