                  <td style="border:1px solid black; padding:6px; font-size:13px; text-align:right; font-weight:bold;">

                      <span t-esc="o.currency_id.name"/> : - Rupees
                      <![CDATA[ ]]>

                      <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                      Only

                  </td>
              </tr>

          </table>


        <!-- ================= SIGNATURE SECTION (TABLE ONLY) ================= -->
<table style="width:100%; border-collapse:collapse; margin-top:2px; font-size:13px;">

    <!-- TOP CENTER -->
    <tr>
        <td colspan="3" style="text-align:center; font-weight:bold; padding-bottom:10px;">
            for, <span t-field="o.company_id.name"/>
        </td>
    </tr>

