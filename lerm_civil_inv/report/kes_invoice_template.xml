                <b><i>Bill To,</i></b><br/>

                <b><span t-field="o.partner_id.name"/></b><br/>

                <span t-field="o.partner_id.street"/><br/>
                <span t-field="o.partner_id.city"/> ,
                <span t-field="o.partner_id.state_id.name"/> ,
                <span t-field="o.partner_id.zip"/><br/>

                GSTIN/UIN : <span t-field="o.partner_id.vat"/><br/>

                Email id : <span t-field="o.partner_id.email"/><br/>

                Contact Person :
                <span t-field="o.contact_person.name"/><br/>

                Contact No. :
                <span t-field="o.contact_person.mobile"/><br/>

                State :
                <span t-field="o.partner_id.state_id.name"/> ,
                Code :
                <span t-field="o.partner_id.state_id.l10n_in_tin"/>

