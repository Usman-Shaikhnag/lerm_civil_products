                    <td style="border:1px solid black; padding:5px;"><b>Customer P.O./Letter No.</b></td>
                    <td style="border:1px solid black; padding:5px; text-align:right;">
                        <span t-field="o.customer_reference"/>
                    </td>
                </tr>

                <tr>
                    <td style="border:1px solid black; padding:5px;"><b>PO/Letter Dated</b></td>
                    <td style="border:1px solid black; padding:5px; text-align:right;">
                        <span t-field="o.invoice_date"/>
                    </td>
                </tr>

                <tr>
                    <td style="border:1px solid black; padding:5px;"><b>Lab Ref No.</b></td>
                    <td style="border:1px solid black; padding:5px; text-align:right;">
                        <span t-field="o.name"/>
                    </td>
                </tr>

                <tr>
                    <td style="border:1px solid black; padding:5px;"><b>Lab Ref Date</b></td>
                    <td style="border:1px solid black; padding:5px; text-align:right;">
