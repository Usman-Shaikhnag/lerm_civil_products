<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="custom_layout_header_footer">
    <div class="header article" t-att-style="report_header_style">
        <div class="row">
            <div class="col-12 text-center">
                <t t-if="o.company_id.inv_header">
                    <img t-att-src="'data:image/png;base64,' + o.company_id.inv_header.decode('utf-8')"
                         style="width:100%; max-height:150px;"/>
                </t>
            </div>
        </div>
    </div>

    <div class="article">
        <t t-out="0"/>
    </div>

    <div class="footer o_standard_footer">
        <div class="text-center">
            <t t-if="o.company_id.inv_footer">
                <img t-att-src="'data:image/png;base64,' + o.company_id.inv_footer.decode('utf-8')"
                     style="width:100%; max-height:120px;"/>
            </t>
        </div>

        <div t-if="report_type == 'pdf'" class="text-center">
            Page: <span class="page"/> / <span class="topage"/>
        </div>
    </div>
</template>

<template id="kes_custom_invoice">
