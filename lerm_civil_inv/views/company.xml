<odoo>
    <record id="view_company_form_inherit_invoice_header_footer"
            model="ir.ui.view">
        <field name="name">res.company.form.invoice.header.footer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Add inside Settings tab -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Invoice Branding">
                    <group>
                        <group>
                            <field name="inv_header" widget="image"
                                   class="oe_avatar"
                                   options="{'preview_image': 'inv_header'}"/>
                        </group>
                        <group>
                            <field name="inv_footer" widget="image"
                                   class="oe_avatar"
                                   options="{'preview_image': 'inv_footer'}"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>