<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_nbml_tiles_view" model="ir.ui.view">
        <field name="name">mechanical.tiles.nbml.form</field>
        <field name="model">mechanical.tiles.nbml</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   

                     <!-- <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/> -->

                      <group>
                       
                    </group>




                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade"/>
                         <field name="size_id"/>
                        <field name="eln_state" />

                        <field name="parameter_id" invisible="1"/>
                    </group>

                     <div  style="text-align:center">
                                    <h1>
                                    <field name="name2" readonly="1" nolabel="1"/>
                                    <!-- <field name="stainless_steel_visible" invisible='1'/> -->
                                    </h1>
                                </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="week_no"></label></td>
                                    <td><field name="week_no" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="other_details"></label></td>
                                    <td><field  name="other_details" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="condition"></label></td>
                                    <td><field name="condition" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>


                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>



                       <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>

                    <div invisible="dimension_visible == False" style="text-align:center">
                        <h1>
                          <field name="dimension_name" readonly="1" nolabel="1"/>
                          <field name="dimension_visible" invisible='1'/>
                        </h1>
                    </div>

                 
                    <table class="table o_form_table custom_table_borders" invisible="dimension_visible == False">
                        <thead>
                            <tr>
                                <th></th>
                                <th style="text-align: center;">L</th>
                                <th style="text-align: center;">B</th>
                                <th style="text-align: center;">H</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Dimension Of Tiles :- (mm)</td>
                                <td style="text-align: center;"><field name="length_in_mm" nolabel="1" class="blue-input"/></td>
                                <td style="text-align: center;"><field name="width_in_mm" nolabel="1" class="blue-input"/></td>
                                <td style="tex t-align: center;"><field name="height_in_mm" nolabel="1" class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>

                     <div class="d-flex gap-2" invisible="dimension_visible == False" >
                         <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="length_in_mm_conformity"> Conformity</label></td>
                                <td>
                                    <field name="length_in_mm_conformity"
                                        decoration-success="length_in_mm_conformity == 'pass'"
                                        decoration-danger="length_in_mm_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="length_in_mm_nabl"> NABL</label></td>
                                <td>
                                    <field name="length_in_mm_nabl"
                                        decoration-success="length_in_mm_nabl == 'pass'"
                                        decoration-danger="length_in_mm_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                         <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="dimension_visible == False">
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="width_in_mm_conformity"> Conformity</label></td>
                                <td>
                                    <field name="width_in_mm_conformity"
                                        decoration-success="width_in_mm_conformity == 'pass'"
                                        decoration-danger="width_in_mm_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="width_in_mm_nabl"> NABL</label></td>
                                <td>
                                    <field name="width_in_mm_nabl"
                                        decoration-success="width_in_mm_nabl == 'pass'"
                                        decoration-danger="width_in_mm_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="dimension_visible == False">
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="height_in_mm_conformity"> Conformity</label></td>
                                <td>
                                    <field name="height_in_mm_conformity"
                                        decoration-success="height_in_mm_conformity == 'pass'"
                                        decoration-danger="height_in_mm_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="height_in_mm_nabl"> NABL</label></td>
                                <td>
                                    <field name="height_in_mm_nabl"
                                        decoration-success="height_in_mm_nabl == 'pass'"
                                        decoration-danger="height_in_mm_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                       
                    </div>

                     <div invisible="water_absorbtion_visible == False" style="text-align:center">
                        <h1>
                          <field name="wt_absorption_name" readonly="1" nolabel="1"/>
                          <field name="water_absorbtion_visible" invisible='1'/>
                        </h1>
                    </div>
                                    
                      <div invisible = "water_absorbtion_visible == False"  >
                            <field name="water_absorption_lines" nolabel="1" >
                                    <tree editable="bottom"  class="custom_table_borders">
                                        <field name="serial_no" />
                                        <field name="mass_of_saturated" class="blue-input" decoration-info="mass_of_saturated != 0"/>
                                        <field name='mass_of_oven' class="blue-input" decoration-info="mass_of_oven != 0"/>
                                        <field name='water_absorption' />
                                    
                                    </tree>
                            </field>
                            </div>
                    

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_absorbtion_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Water Absorption</strong></td>
                                <td>
                                    <field name="avrg_water_absorption"/>  
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Water Absorption Conformity</strong></td>
                                <td>
                                    <field name="avrg_water_absorption_conformity"
                                        decoration-success="avrg_water_absorption_conformity == 'pass'"
                                        decoration-danger="avrg_water_absorption_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Water Absorption NABL</strong></td>
                                <td>
                                    <field name="avrg_water_absorption_nabl"
                                        decoration-success="avrg_water_absorption_nabl == 'pass'"
                                        decoration-danger="avrg_water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    
                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>




                  <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>


