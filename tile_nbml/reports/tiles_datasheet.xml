<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tile_nbml_datasheet">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.mechanical_data_sheet_header">
        
                <div style="text-align:center;font-size:18px;font-weight: bold">
                    Tiles Datasheet
                </div>

                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>

                          <tr style="height:50px" cols="12">
								<td colspan="4">Performed By :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.technician.name"/>
								</td>
								<td colspan="4">Witness Name :
									<![CDATA[&nbsp;]]>
									<span t-field="eln.witness_name"/>
								</td>
								<td colspan="4">Witness Signature :
									<![CDATA[&nbsp;]]>
									<span style='padding:20px'></span>
								</td>
							</tr>
                    </table>
                    <!-- Dimension  -->
                    
                 <div t-if="data.dimension_visible" >
				<div style="text-align:center;font-size:18px;font-weight: bold">
						Dimension (mm) 
                        <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','p45329be-107d-4e30-9d3d-2a9054325678')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>

				</div>
              
                <table style="margin-top:10px;">
                
                    <thead>
                        <tr>
                            <th style="text-align: center;max-width:200px">
                                <span style="font-weight: bold;">
                                    Sr.No
                                </span>
                            </th>
                            <th style="text-align: center;max-width:100px">
                                <span style="font-weight: bold;">
                                     Length in mm
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     Width in mm
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     Height in mm
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            
                            <td style="text-align: center;max-width:200px">
                                <span style="text-align: center;">
                                    1
                                </span>    
                            </td>
                            
                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.length_in_mm" t-options='{"widget": "float", "precision": 2}'/>
                                </span>									
                            </td>

                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.width_in_mm" t-options='{"widget": "float", "precision": 2}'/>
                                </span>									
                            </td>

                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.height_in_mm" t-options='{"widget": "float", "precision": 2}'/>
                                </span>									
                            </td>
                        </tr>
                    </tbody>
				
				</table>	
			

            <div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.check_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.check_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
					</div>



                     <!--water absorption   -->
                    
                <div t-if="data.water_absorbtion_visible" style="margin-top:20px;page-break-before: always;">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','09543405-ed58-4374-bda7-28756432985')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','09543405-ed58-4374-bda7-28756432985')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>
                   
                    <table style="margin-top:20px">
					<thead style="background-color: #d3d3d3;">
						<tr cols="12">
							<td rowspan="2">Sr no 
							</td>

							<td colspan="1" style="text-align:center;">Mass of saturated Specimen in gm-M1
							</td>

                            <td colspan="1" style="text-align:center;">Mass of oven dried Specimen in gm-M2
							</td>
                            <td colspan="1" style="text-align:center;">Water Absorption (%)=(M1-M2)/M2
							</td>
                         

                         
						</tr>
						
						</thead>
						  <tbody>

						<t t-set="i" t-value="0"/>
						<tr t-foreach="data.water_absorption_lines" t-as="r">
							<td colspan="1">
								<div>
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</div>
							</td>
							<td colspan="1">
								<span t-esc="r['mass_of_saturated']" />
							</td>
                            <td colspan="1">
								<span t-esc="r['mass_of_oven']" />
							</td>
                           
                            <td colspan="1">
								<span t-esc="r['water_absorption']"  t-options='{"widget": "float", "precision": 2}'/>
							</td>
                         
						</tr>
						</tbody>
					</table>

                    <table style="margin-top:5px">
                            <tr cols="12">
                                <td colspan="6"><b>Average Water Absorption %:</b></td>
                                <td colspan="6" style="text-align: center;">
                                    <span t-field="data.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                          

                           
                        </table>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Tested By
									</b>
								</div>
								<div style="height: 40px;">
								<t t-if="eln.sample_id.tested_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
                            <div>
                                <b>
                                <span t-esc="eln.sample_id.check_by.name"/>
                                </b>
                            </div>
                            <div>
                                <b>
                                    (<span t-esc="eln.sample_id.check_by.job_title"/>)
                                </b>
                            </div>
                        </div>
                        
                        <div style="margin-left:600px">
                                    
                            <div>
                                <b>
                                    Checked By
                                </b>
                            </div>
							<div style="height: 40px;">
								<t t-if="eln.sample_id.checked_by_signature_datasheet">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
							
						</div>
					</div>
					</div>
                    </div>


            </t>
        </t>
    </template>
    </odoo>