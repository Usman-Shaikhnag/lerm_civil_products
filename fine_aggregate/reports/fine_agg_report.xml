									<td  style="text-align: center; vertical-align: middle;">
										<t t-foreach="bulking_sand.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.specification"/>
											</t>
										</t>
									</td >
									
									<td style="text-align: center;">
										<span t-field="data.avg_bulking_of_sand" t-options='{"widget": "float", "precision": 2}'/>
									</td>							
									<td style="text-align: center;">
										<t t-foreach="bulking_sand.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</td>

									<td style="text-align: center;" t-if="eln.conformity">
										<span t-field="data.avg_bulking_of_sand_conformity"/>
									</td>
								</tr>

								<tr t-if="data.loose_bulk_visible and (data.loose_bulk_density_nabl == 'pass' and nabl or (data.loose_bulk_density_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="loose_bulk" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','4587tyhloos-3fa3-4b83-ae31-9d281767188c')])"/>
									<td style="text-align: center;" >
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
