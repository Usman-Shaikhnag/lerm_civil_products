<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fine Aggregate Report Template -->
    <template id="fineaggregate_report_ssl">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.genstru_layout_header_footer_lerm_eln">
                <div class="container_eln" style="padding-top:50px;">
                    <t t-set="fine_aggregate" t-value="env['mechanical.fine.aggregate'].search([('eln_ref', '=', eln.id)], limit=1)"/>
                    
                    <div class="" t-foreach="eln" t-as="o">
                        <table style="margin-top:10px; border:none">
                            <tr>
                                <td colspan="2" style=" font-weight: bold;">Client Details:</td>
                                <td colspan="10">
                                    <span t-field="o.srf_id.customer.name"/><br />
                                    <span t-field="o.srf_id.customer.street"/>
                                    <span t-field="o.srf_id.customer.street2"/>
                                    <span t-field="o.srf_id.customer.city"/>
                                    <span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
                                    <span t-field="o.srf_id.customer.state_id"/>
                                    <span t-field="o.srf_id.customer.country_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style=" font-weight: bold;">Client Reference:</td>
                                <td colspan="10"><span t-field="o.srf_id.client_refrence"/></td>
                            </tr>
                            <tr>
                                <td colspan="2" style=" font-weight: bold;">Name of Work:</td>
                                <td colspan="10"><span t-field="o.srf_id.name_work"/></td>
                            </tr>
                            <tr>
                                <td colspan="2" style=" font-weight: bold;">Date of Testing:</td>
                                <td colspan="10">
                                    <span t-field="o.start_date"/> to <span t-field="o.end_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="font-weight: bold;">Size:</td>
                                <td colspan="10">
                                    <span t-field="o.sample_id.size_id.size"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="font-weight: bold;">Grade:</td>
                                <td colspan="10">
                                    <span t-field="o.grade_id.grade"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="font-weight: bold;">Material/Test Name:</td>
                                <td colspan="10">
                                    <span t-field="o.material.name"/>
                                </td>
                            </tr>
                            <tr t-if="o.material.source_sample">
                                <td colspan="2" style="font-weight: bold;">Source of Sample</td>
                                <td colspan="10">
                                    <span t-field="o.material.source_sample"/>
                                </td>
                            </tr>
                            <tr t-if="o.material.test_method_adopted">
                                <td colspan="2" style="font-weight: bold;">Test method adopted:</td>
                                <td colspan="10">
                                    <span t-field="o.material.test_method_adopted"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    


                    <!-- Test Results Table -->
                    <div style="margin-top:20px">
                        <table class="table table-bordered" style="width:100%; border-collapse: collapse;" border="1">
                            <thead>
                                <tr style="background-color:#f9f9f9;">
                                    <th style="text-align: center; padding: 8px;">Sr No</th>
                                    <th style="text-align: center; padding: 8px;">Name of Test</th>
                                    <th style="text-align: center; padding: 8px;">Test Method</th>
								    <th style="text-align: center; padding: 8px;" colspan="2">Environmental Condition</th>
                                    <th style="text-align: center; padding: 8px;">Test Results</th>
                                    <th style="text-align: center; padding: 8px;">Test Specifications</th>
                                    <!-- <th style="text-align: center; padding: 8px;">Conformity</th> -->
                                </tr>
                                <tr style="background-color:#f9f9f9;">
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th style="text-align: center; padding: 8px;">Temp.°C</th>
                                    <th style="text-align: center; padding: 8px;">Humidity %</th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>


                             <!-- Sieve Analysis Table -->
                                <tr>
                                    <td rowspan="9" style ="text-align: center; padding: 8px;">1</td>
                                    <td style="font-weight: bold; padding: 8px;">Sieve Analysis Table</td>

                             <td  rowspan="9" style="text-align: center; padding-top: 120px;">IS : 2386 (P1) 1963(RA 2021)</td>

                                    <td  rowspan="9" style="text-align: center; padding-top: 120px;">
                                     <span t-field="data.temp_sieve_analysis"/>
                                    </td>
                                    <td  rowspan="9" style="text-align: center; padding-top: 120px;">
                                        <span t-field="data.humidity_sieve_analysis"/>
                                     <span t-field="data.temp_sieve_analysis"/>
                                    </td>


                                    <td  rowspan="9" style="text-align: center; padding-top: 120px;">
                                        <span t-field="data.humidity_sieve_analysis"/>
                                    </td>


                                    
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <table style="width:100%; border:none;">
                                                <tr>
                                                    <!-- <td><b>Trial 1:</b> <span t-field="fine_aggregate.specific_gravity_1" t-options='{"widget": "float", "precision": 2}'/></td>
                                                    <td><b>Trial 2:</b> <span t-field="fine_aggregate.specific_gravity_2" t-options='{"widget": "float", "precision": 2}'/></td>
                                                    <td><b>Average:</b> <span t-field="fine_aggregate.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td> -->
                                                </tr>
                                            </table>
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">As per IS 383</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.avg_specific_gravity_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>



                              <t t-set="k" t-value="0"/>
								<tr t-foreach="data.sieve_analysis_child_lines" t-as="r" style="text-align: center;">
									
									<td style="border: 1px solid black; padding: 6px;" colspan="1">
										<span t-esc="r['sieve_size']"/>
									</td>
                                  </tr>



                                <!-- Specific Gravity -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">1</td>
                                    <td style="font-weight: bold; padding: 8px;">Specific Gravity</td>
                             <td style="text-align: center; padding: 8px;">IS : 2386 (P3) 1963 (RA 2021)</td>
                                    <td style="text-align: center; padding: 8px;">
                                     <span t-field="data.temp_specific_gravity_water_absorption"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span t-field="data.humidity_temp_specific_gravity_water_absorption"/>
                                     <span t-field="data.temp_specific_gravity_water_absorption"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span t-field="data.humidity_temp_specific_gravity_water_absorption"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <table style="width:100%; border:none;">
                                                <tr>
                                                    <!-- <td><b>Trial 1:</b> <span t-field="fine_aggregate.specific_gravity_1" t-options='{"widget": "float", "precision": 2}'/></td>
                                                    <td><b>Trial 2:</b> <span t-field="fine_aggregate.specific_gravity_2" t-options='{"widget": "float", "precision": 2}'/></td>
                                                    <td><b>Average:</b> <span t-field="fine_aggregate.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td> -->
                                                </tr>
                                            </table>
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">As per IS 383</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.avg_specific_gravity_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>

                                <!-- Water Absorption -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">2</td>
                                    <td style="font-weight: bold; padding: 8px;">Water Absorption %</td>
                    <td style="text-align: center; padding: 8px;">IS : 2386 (P3) 1963 (RA 2021)</td>
                                    <td style="text-align: center; padding: 8px;">
                                       <span t-field="data.temp_specific_gravity_water_absorption"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                      <span t-field="data.humidity_temp_specific_gravity_water_absorption"/>
                                       <span t-field="data.temp_specific_gravity_water_absorption"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                      <span t-field="data.humidity_temp_specific_gravity_water_absorption"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <table style="width:100%; border:none;">
                                                <tr>
                                                    <!-- <td><b>Trial 1:</b> <span t-field="fine_aggregate.water_absorption_1" t-options='{"widget": "float", "precision": 2}'/> %</td>
                                                    <td><b>Trial 2:</b> <span t-field="fine_aggregate.water_absorption_2" t-options='{"widget": "float", "precision": 2}'/> %</td>
                                                    <td><b>Average:</b> <span t-field="fine_aggregate.avg_water_absorption" t-options='{"widget": "float", "precision": 2}'/> %</td> -->
                                                </tr>
                                            </table>
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">Max 2% as per IS 383</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.avg_water_absorption_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>

                                <!-- Silt Content -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">3</td>
                                    <td style="font-weight: bold; padding: 8px;">Particle Finer Than 75 micron %</td>
                                    <td style="text-align: center; padding: 8px;">IS : 2386 (P1) 1963 (RA 2021)</td>
                                    <td style="text-align: center; padding: 8px;">
                                      <span t-field="data.temp_finer75_visible"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                       <span t-field="data.humidity_finer75_visible"/>
                                      <span t-field="data.temp_finer75_visible"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                       <span t-field="data.humidity_finer75_visible"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.material_finer75" t-options='{"widget": "float", "precision": 2}'/> %
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">IS : 2386 (P1) 1963 (RA 2021)</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.material_finer75_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>

                                <!-- Bulk Density Compacted -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">4</td>
                                    <td style="font-weight: bold; padding: 8px;">Bulk Density Compacted</td>
                    <td style="text-align: center; padding: 8px;">IS : 2386 (P3)(RA 2021)</td>


                                    <td style="text-align: center; padding: 8px;">
                                          <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                     <span t-field="data.humidity_density"/>
                                          <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                     <span t-field="data.humidity_density"/>
                                    </td>



                                    
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.compacted_density" t-options='{"widget": "float", "precision": 2}'/> <span t-field="fine_aggregate.avg_compacted_unit"/>
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">-</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.compacted_density_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>

                                <!-- Bulk Density Loose -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">5</td>
                                    <td style="font-weight: bold; padding: 8px;">Bulk Density Loose</td>
                     <td style="text-align: center; padding: 8px;">IS : 2386 (P3)(RA 2021)</td>
                                    <td style="text-align: center; padding: 8px;">
                                     <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span t-field="data.humidity_density"/>
                                     <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span t-field="data.humidity_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.loose_density" t-options='{"widget": "float", "precision": 2}'/> <span t-field="fine_aggregate.avg_compacted_unit"/>
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">-</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.loose_density_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>

                                <!-- Voids in Compacted Density -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">6</td>
                                    <td style="font-weight: bold; padding: 8px;">Voids in Compacted Density %</td>
                                    <td style="text-align: center; padding: 8px;">IS : 2386 (P3)(RA 2021)</td>
                                    <td style="text-align: center; padding: 8px;">
                                      <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                       <span t-field="data.humidity_density"/>
                                      <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                       <span t-field="data.humidity_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.voids_compacted_density" t-options='{"widget": "float", "precision": 2}'/> %
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">-</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.voids_compacted_density_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>

                                <!-- Voids in Loose Density -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">7</td>
                                    <td style="font-weight: bold; padding: 8px;">Voids in Loose Density %</td>
                                    <td style="text-align: center; padding: 8px;">IS : 2386 (P3)(RA 2021)</td>
                                    <td style="text-align: center; padding: 8px;">
                                      <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                       <span t-field="data.humidity_density"/>
                                      <span t-field="data.temp_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                       <span t-field="data.humidity_density"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.voids_loose_density" t-options='{"widget": "float", "precision": 2}'/> %
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">-</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.voids_loose_density_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>




                                  <!-- Soundness -->
                                <tr>
                                    <td style="text-align: center; padding: 8px;">1</td>
                                    <td style="font-weight: bold; padding: 8px;">Soundness</td>
                             <td style="text-align: center; padding: 8px;">IS : 2386 (P5) 1963(RA 2021)</td>
                                    <td style="text-align: center; padding: 8px;">

                                     <span t-field="data.temp_soudness"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span t-field="data.humidity_soudness"/>
                                     <span t-field="data.temp_soudness"/>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span t-field="data.humidity_soudness"/>
                                    </td>


                                    <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <table style="width:100%; border:none;">
                                                <tr>
                                                    <!-- <td><b>Trial 1:</b> <span t-field="fine_aggregate.specific_gravity_1" t-options='{"widget": "float", "precision": 2}'/></td>
                                                    <td><b>Trial 2:</b> <span t-field="fine_aggregate.specific_gravity_2" t-options='{"widget": "float", "precision": 2}'/></td>
                                                    <td><b>Average:</b> <span t-field="fine_aggregate.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/></td> -->
                                                </tr>
                                            </table>
                                        </t>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">As per IS 383</td>
                                    <!-- <td style="text-align: center; padding: 8px;">
                                        <t t-if="fine_aggregate">
                                            <span t-field="fine_aggregate.avg_specific_gravity_conformity"/>
                                        </t>
                                    </td> -->
                                </tr>

            
                            </tbody>
                        </table>
                    </div>

                    <!-- Remarks and Notes Section -->
                    <div style="margin-top:5px" class="noteContainer">
                        <table class="table table-bordered">
                            <tr>
                                <td style="padding: 5px; font-style: italic; font-size: 12px;">
                                    <b>Remarks:-</b>
                                    &#160;&#160;(1) Refer to Annexure- I to know environmental and test conditions
                                    &#160;&#160;(2) *Refer to Annexure- I (A) to know NABL accredited scope, range and uncertainty of measurement for test parameter
                                    &#160;&#160;(3) All tests conducted as per relevant IS codes
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 5px; font-style: italic; font-size: 12px;">
                                    <b>Notes:-</b>
                                    &#160;&#160;a. The information marked with an # received from customer
                                    &#160;&#160;b. The results listed refer only to tested parameters and sample as received from customer
                                    &#160;&#160;c. The balance samples if any will be discarded after 15 days from the date of issue of test certificate unless otherwise specified.
                                    &#160;&#160;d.This document shall not be reproduced in part or full without the approval of Genstru.
                                </td>
                            </tr>
                        </table>
                    </div>
                    
                    <!-- Signature Section -->
                    <div class="signatureContainer girdgird">
                        <div>
                            <div><b>Prepared By</b></div>
                            <div style="height:20px"></div>
                            <div><b><span t-esc="eln.technician.name"/></b></div>
                            <div><b>(<span t-esc="eln.sample_id.check_by.job_title"/>)</b></div>
                        </div>

                        <div>
                            <div></div>
                        </div>
                        
                        <div>
                            <div><b>Reviewed &amp; Issued By</b></div>
                            <div style="height:20px"></div>
                            <div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
                            <div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>