									<th style="text-align: center;">Sr.No</th>

									<th style="text-align: center;">
									<span t-esc="eln.material.test_parameter"/>
									<!-- Test Parameters -->
									</th>

									<th style="text-align: center;">
									<span t-esc="eln.material.unit"/>
									<!-- Unit -->
									</th>

									<th style="text-align: center;"><span t-field="eln.material.method_reference"></span></th>
									
									<th style="text-align: center;">
									<span t-esc="eln.material.result_remark"/>
									<!-- Test Result -->
									</th>
									<th style="text-align: center;"><span t-field="eln.material.specifications"></span></th>
									<th style="text-align: center;" t-if="eln.conformity">Conformity</th>
								</tr>
							</thead>
							
							<t t-set="i" t-value="1"/>
							<tbody>
								<tr t-if="data.specific_gravity_visible and (data.specific_gravity_nabl == 'pass' and nabl or (data.specific_gravity_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="specific_gravity" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','45875ght-7188-4086-b132-62b50e63f1245gt')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
										<span t-field="specific_gravity.parameter_name"/>
									</td>
										<td style="text-align: center;">
										<span t-field="specific_gravity.unit.name"/>
									</td>
									<td style="text-align: center;" >
										<t t-foreach="specific_gravity.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.specification"/>
											</t>
										</t>
									</td>
								
									<td style="text-align: center;">
										<span t-field="data.water_absorption" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;">
										<t t-foreach="specific_gravity.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</td>
									<td style="text-align: center;" t-if="eln.conformity">
										<span t-field="data.specific_gravity_conformity"/>
									</td>
								</tr>

								<tr t-if="data.bulking_sand_visible and (data.avg_bulking_of_sand_nabl == 'pass' and nabl or (data.avg_bulking_of_sand_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="bulking_sand" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','45789bhgt25-3fa3-4b83-ae31-9d28176718457')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
