												<span t-field="parameter.specification"/>
											</t>
										</t>
									</td>
									
									<td style="text-align: center;">
										<span t-field="data.loose_bulk_density" t-options='{"widget": "float", "precision": 2}'/>
									</td>								
									<td style="text-align: center;" >
										<t t-foreach="loose_bulk.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</td>
									<td  style="text-align: center;" t-if="eln.conformity">
										<span t-field="data.loose_bulk_density_conformity"/>
									</td>
								</tr>

								<tr t-if="data.site_content_visible and (data.avg_bulking_of_sand1_nabl == 'pass' and nabl or (data.avg_bulking_of_sand1_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="site_content" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','2547ghty124m-3fa3-4b83-ae31-9d281457nhy14')])"/>
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
										<span t-field="site_content.parameter_name"/>
									</td>
									<td style="text-align: center;">
										<span t-field="site_content.unit.name"/>
									</td>
									<td style="text-align: center;">
										<t t-foreach="site_content.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
											</t>
										</t>
									</td>
									
									<td style="text-align: center;">
										<span t-field="data.avg_bulking_of_sand1" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;">
										<t t-foreach="site_content.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</td>
									<td style="text-align: center;" t-if="eln.conformity">
										<span t-field="data.avg_bulking_of_sand1_conformity"/>
									</td>
								</tr>

								<tr t-if="data.moisture_content_visible and (data.avg_moisture_nabl == 'pass' and nabl or (data.avg_moisture_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="moisture_content" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','1457htyu1245-3fa3-4b83-ae31-9d281457457hy')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
										<span t-field="moisture_content.parameter_name"/>
									</td>
									<td style="text-align: center;">
										<span t-field="moisture_content.unit.name"/>
									</td>
									<td style="text-align: center;">
										<t t-foreach="moisture_content.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
											</t>
										</t>
									</td>
									
									<td style="text-align: center;">
										<span t-field="data.avg_moisture" t-options='{"widget": "float", "precision": 2}'/>
									</td>								
									<td style="text-align: center;">
										<t t-foreach="moisture_content.parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</td>
									<td style="text-align: center;" t-if="eln.conformity">
										<span t-field="data.avg_moisture_conformity"/>
									</td>

								</tr>

							</tbody>
						</table>
					</div>         

				
					<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>
							


					


						<div style="margin-top:0;padding:0;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
