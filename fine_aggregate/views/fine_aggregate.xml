<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_fine_aggregateee" model="ir.ui.view">
        <field name="name">mechanical.fine.aggregate.form</field>
        <field name="model">mechanical.fine.aggregate</field>
        <field name="arch" type="xml">
            <form create="false">
            <sheet>
                    <h1>
                        <field name="name_aggregate" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    <group >
                       <field name="grade"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>



                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }

                        .no_column_sorting .o_list_table thead th {
                            pointer-events: none !important;
                            cursor: default !important;
                           }
                    </style>




                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>
                  
               
                    <!-- Sieve Analysis -->
                    <div invisible="sieve_visible == False" >
                        <h1 style="text-align: center;">
                            <field name="sieve_analysis_name" readonly="1" nolabel="1"/>
                            <field name="sieve_visible" invisible="1"/>

                        </h1>
                    </div>
                   
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" invisible="not sieve_visible">
                        <tbody>
                            <tr>
                                <td class="w-25"><label for="wt_of_sample"/></td>
                                <td  class="w-25">
                                    <field name="wt_of_sample" class="blue-input"/>
                                </td>
                                <td class="w-25"><label for="zone_type"/></td>
                                <td  class="w-25">
                                    <field name="zone_type" class="blue-input"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <div invisible="sieve_visible == False">
                        <field name="sieve_analysis_child_lines" nolabel="1" class="no_column_sorting" >
                            <tree editable="bottom"  class="custom_table_borders ">
                                <field  name="serial_no" string="Sr.No"/>
                                <field  name='sieve_size' string="IS Sieve Size"/>
                                <field  class="blue-input" name='wt_retained' string="Wt. Retained in gms"/>

                                <field name='cumulative_percent' readonly="1"/>


                                <!-- <field name='percent_retained' string="% Retained"/> -->
                                <field  name='cumulative_retained' context="{'default_cumulative_retained': cumulative_retained}" string="Cum. Retained %"/>
                                <field  name='passing_percent' string="Passing %" readonly="1"/>
                                <field class=" oe_center" name='specific_limt' string="Specified Limits"/>
                                
                            </tree>
                        </field>
                    </div>
                    <div invisible="sieve_visible == False">
                        <button string="Calculate" type="object" name="calculate_sieve" class="oe_highlight">
                            <i class="fa fa-calculator"/> Calculate
                        </button>
                    </div>

                <table class="table table-sm o_form_table w-50 table-bordered custom_table_borders mt-2" invisible="not sieve_visible">
                    <tbody>
                        <tr>
                            <td ><label for="grading"/></td>
                            <td  ><field name="grading"/></td>
                        </tr>
                        <tr>
                            <td ><label for="fineness_modulus"/></td>
                            <td  ><field name="fineness_modulus"/></td>
                        </tr>
                    </tbody>
                </table>


                <!-- DELETERIOUS MATERIAL (COAL & LIGNITE) -->


                    <div invisible="deleterious_coal_lignite_visible == False">
                        <h1 class="text-center">
                            <field name="deleterious_coal_lignite_name" readonly="1" nolabel="1"/>
                            <field name="deleterious_coal_lignite_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div class=" custom_table_borders" invisible="deleterious_coal_lignite_visible == False">
                        <field name="deleterious_coal_lignite_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='sample_no'/>
                                <field name="w1" class="blue-input" decoration-info="w1 != 0"/>
                                <field name="w2" class="blue-input" decoration-info="w2 != 0"/>
                                <field name="deleterious_percent"/>
                            </tree>
                        </field>
                    </div>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="deleterious_coal_lignite_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_deleterious_coal_lignite">Average Percentage of Deleterious Material (%)</label></td>
                                  <td><field name="avg_deleterious_coal_lignite"/></td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avg_deleterious_coal_lignite_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_deleterious_coal_lignite_conformity"
                                        decoration-success="avg_deleterious_coal_lignite_conformity == 'pass'" 
                                        decoration-danger="avg_deleterious_coal_lignite_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="avg_deleterious_coal_lignite_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_deleterious_coal_lignite_nabl"
                                        decoration-success="avg_deleterious_coal_lignite_nabl == 'pass'" 
                                        decoration-danger="avg_deleterious_coal_lignite_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <group/>


                    <!-- Determination of Clay Lumps -->


                    <div invisible="clay_lump_visible == False">
                        <h1 class="text-center">
                            <field name="name_clay_lumps" readonly="1" nolabel="1"/>
                            <field name="clay_lump_visible" invisible="1"/>

                        </h1>
                    </div>
                    <div invisible= "clay_lump_visible == False" class="custom_table_borders">
                        <field name="clay_lumps_percent_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name='sample_no'/>
                                    <field name='w1' class="blue-input" decoration-info="w1 != 0"/>
                                    <field name='w2' class="blue-input" decoration-info="w2 != 0"/>
                                    <field name='percent'/>
                                </tree>
                        </field> 
                    </div>

                   <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not clay_lump_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="clay_lumps_percent">Average Deleterious Material (%)</label></td>
                                <td><field name="clay_lumps_percent"/></td>
                            </tr>

                            <tr>
                                <td><label class="fw-bold" for="clay_lumps_percent_conformity">Conformity</label></td>
                                <td>
                                    <field name="clay_lumps_percent_conformity"
                                        decoration-success="clay_lumps_percent_conformity == 'pass'" 
                                        decoration-danger="clay_lumps_percent_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="clay_lumps_percent_nabl">NABL</label></td>
                                <td>
                                    <field name="clay_lumps_percent_nabl"
                                        decoration-success="clay_lumps_percent_nabl == 'pass'" 
                                        decoration-danger="clay_lumps_percent_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <group/>



                    <!-- Material Finer than 75 Micron -->
                    <div invisible="finer75_visible == False">
                        <h1 class="text-center">
                            <field name="finer75_name" readonly="1" nolabel="1"/>
                            <field name="finer75_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible= "finer75_visible == False" class="custom_table_borders">
                        <field name="finer75_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name='sample_no'/>
                                    <field name='w1' class="blue-input" decoration-info="w1 != 0"/>
                                    <field name='w2' class="blue-input" decoration-info="w2 != 0"/>
                                    <field name='w3' />
                                    <field name='finer_percent'/>
                                </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not finer75_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="avg_finer_percent">Average Value of % Material Finer than 75 micron</label></td>
                                <td><field name="avg_finer_percent"/></td>
                            </tr>

                            <tr>
                                <td><label class="fw-bold" for="avg_finer_percent_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_finer_percent_conformity"
                                        decoration-success="avg_finer_percent_conformity == 'pass'" 
                                        decoration-danger="avg_finer_percent_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="avg_finer_percent_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_finer_percent_nabl"
                                        decoration-success="avg_finer_percent_nabl == 'pass'" 
                                        decoration-danger="avg_finer_percent_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <group/>
                    



                    <!-- Deleterious Material (Soft Fragments) -->


                    <div invisible="soft_fragments_visible == False">
                        <h1 class="text-center">
                            <field name="name_soft_fragments" readonly="1" nolabel="1"/>
                            <field name="soft_fragments_visible" invisible="1"/>

                        </h1>
                    </div>
                    <div invisible= "soft_fragments_visible == False" class="custom_table_borders">
                        <field name="soft_fragments_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name='sample_no'/>
                                    <field name='w1' class="blue-input" decoration-info="w1 != 0"/>
                                    <field name='w2' class="blue-input" decoration-info="w2 != 0"/>
                                    <field name='percent'/>
                                </tree>
                        </field> 
                    </div>

                   <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not soft_fragments_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="soft_fragments_percent">Average Deleterious Material Soft Fragments (%)</label></td>
                                <td><field name="soft_fragments_percent"/></td>
                            </tr>

                            <tr>
                                <td><label class="fw-bold" for="soft_fragments_percent_conformity">Conformity</label></td>
                                <td>
                                    <field name="soft_fragments_percent_conformity"
                                        decoration-success="soft_fragments_percent_conformity == 'pass'" 
                                        decoration-danger="soft_fragments_percent_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                               <td><label class="fw-bold" for="soft_fragments_percent_nabl">NABL</label></td>
                                <td>
                                    <field name="soft_fragments_percent_nabl"
                                        decoration-success="soft_fragments_percent_nabl == 'pass'" 
                                        decoration-danger="soft_fragments_percent_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <group/>


                    <!-- Moisture Content -->
                    <div invisible = "moisture_content_visible == False">
                        <h1 class="text-center">
                            <field name="moisture_content_name1" readonly="1" nolabel="1"/>
                            <field name="moisture_content_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible = "moisture_content_visible == False">
                        <field name="moisture_content_child_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="w1" class="blue-input" decoration-info="w1 != 0"/>
                                <field name="w2" class="blue-input" decoration-info="w2 != 0"/>
                                <field name="w3" class="blue-input" decoration-info="w3 != 0"/>
                                <field name="moisture_content"/>
                            </tree>
                        </field>
                    </div>

                    <table invisible="moisture_content_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="average_moisture_content">Average Moisture Content</label></td>
                                <td>
                                    <div class="d-flex">
                                        <field name="average_moisture_content" nolabel="1"/>
                                        <span class="ms-2">%</span>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_moisture_content_conformity">Moisture Content Conformity</label></td>
                                <td>
                                    <field name="average_moisture_content_conformity"
                                        decoration-success="average_moisture_content_conformity == 'pass'"
                                        decoration-danger="average_moisture_content_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_moisture_content_nabl">Moisture Content NABL</label></td>
                                <td><field name="average_moisture_content_nabl" 
                                            decoration-success="average_moisture_content_nabl == 'pass'"
                                            decoration-danger="average_moisture_content_nabl == 'fail'" readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>




                        <!-- Bulking of Sand -->
                    <div invisible = "bulking_sand_visible == False">
                        <h1 class="text-center">
                            <field name="bulking_sand_name" readonly="1"/>
                            <field name="bulking_sand_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible="bulking_sand_visible == False">
                        <field name="bulking_sand_child_lines"  style="width:100%" nolabel="1">
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="h1" class="blue-input" decoration-info="h1 != 0"/>
                                <field name="h2" class="blue-input" decoration-info="h2 != 0"/>
                                <field name="bulking_percent"/>
                            </tree>
                        </field>
                   
                    </div>

        


                <table invisible="bulking_sand_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                    <tbody>
                     <tr>
                            <td><label class="fw-bold" for="average_bulking">Average Bulking of Sand (%)</label></td>
                            <td><field name="average_bulking"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="average_bulking_conformity">Bulking Conformity</label></td>
                            <td>
                                <field name="average_bulking_conformity"
                                    decoration-success="average_bulking_conformity == 'pass'"
                                    decoration-danger="average_bulking_conformity == 'fail'"
                                    readonly="1"/>
                            </td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="average_bulking_nabl">Bulking NABL</label></td>
                            <td><field name="average_bulking_nabl"
                                        decoration-success="average_bulking_nabl == 'pass'"
                                    decoration-danger="average_bulking_nabl == 'fail'"
                                    readonly="1"/></td>
                        </tr>
                    </tbody>
                </table>



               



            


                    


 


                      <!-- Specific Gravity And Water Absorption  -->
                <div invisible="specific_gravity_visible == False">
                    <h1 class="text-center">
                        <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                        <field name="specific_gravity_visible" invisible="1"/>
                    </h1>
                </div>

                <div invisible="specific_gravity_visible == False">
                        <field name="specific_gravity_line_ids"  style="width:100%" nolabel="1">
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="temperature" class="blue-input" decoration-info="temperature != 0"/>
                                <field name="pycnometer_bottle_number" class="blue-input" decoration-info="pycnometer_bottle_number != 0"/>
                                <field name="w1" class="blue-input" decoration-info="w1 != 0"/>
                                <field name="w2" class="blue-input" decoration-info="w2 != 0"/>
                                <field name="w3" class="blue-input" decoration-info="w3 != 0"/>
                                <field name="w4" class="blue-input" decoration-info="w4 != 0"/>
                                <field name="specific_gravity"/>
                                <field name="apparent_specific_gravity"/>
                                <field name="water_absorption"/>
                            </tree>
                        </field>
                   
                    </div>


                <div class="d-flex gap-2" invisible="specific_gravity_visible == False" >
                <table invisible="specific_gravity_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                    <tbody>
                     <tr>
                            <td><label class="fw-bold" for="average_specific_gravity">Average Specific Gravity</label></td>
                            <td><field name="average_specific_gravity"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="average_specific_gravity_conformity">Conformity</label></td>
                            <td>
                                <field name="average_specific_gravity_conformity"
                                    decoration-success="average_specific_gravity_conformity == 'pass'"
                                    decoration-danger="average_specific_gravity_conformity == 'fail'"
                                    readonly="1"/>
                            </td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="average_specific_gravity_nabl">NABL</label></td>
                            <td><field name="average_specific_gravity_nabl"
                                        decoration-success="average_specific_gravity_nabl == 'pass'"
                                    decoration-danger="average_specific_gravity_nabl == 'fail'"
                                    readonly="1"/></td>
                        </tr>
                    </tbody>
                </table>

                <table invisible="specific_gravity_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                    <tbody>
                     <tr>
                            <td><label class="fw-bold" for="average_water_absorption">Average Water Absorption (%)</label></td>
                            <td><field name="average_water_absorption"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="average_water_absorption_conformity">Conformity</label></td>
                            <td>
                                <field name="average_water_absorption_conformity"
                                    decoration-success="average_water_absorption_conformity == 'pass'"
                                    decoration-danger="average_water_absorption_conformity == 'fail'"
                                    readonly="1"/>
                            </td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="average_water_absorption_nabl">NABL</label></td>
                            <td><field name="average_water_absorption_nabl"
                                        decoration-success="average_water_absorption_nabl == 'pass'"
                                    decoration-danger="average_water_absorption_nabl == 'fail'"
                                    readonly="1"/></td>
                        </tr>
                    </tbody>
                </table>

                </div>

                

                   <!-- Loose Bulk Density -->

                    <div class="text-center" invisible="loose_bulk_density_visible == False">
                        <h1>
                            <field name="loose_bulk_density_name" readonly="1" nolabel="1"/>
                            <field name="loose_bulk_density_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "loose_bulk_density_visible == False" class="custom_table_borders">
                        <field name="loose_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='container_with_material' class="blue-input" decoration-info="container_with_material != 0"/>
                                <field name='volume_of_cont' class="blue-input" decoration-info="volume_of_cont != 0"/>
                                <field name='loose_bulk_density'/>
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not loose_bulk_density_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="loose_avg">Average Loose Bulk Density</label></td>
                                <td><field name="loose_avg"/><span>Kg/lit</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="loose_avg_confirmity">Conformity</label></td>
                                <td>
                                    <field name="loose_avg_confirmity"
                                        decoration-success="loose_avg_confirmity == 'pass'" 
                                        decoration-danger="loose_avg_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="loose_avg_nabl">NABL</label></td>
                                <td>
                                    <field name="loose_avg_nabl"
                                        decoration-success="loose_avg_nabl == 'pass'" 
                                        decoration-danger="loose_avg_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                     <!-- Rodded Bulk Density -->

                    <div class="text-center" invisible="rodded_bulk_density_visible == False">
                        <h1>
                            <field name="rodded_bulk_density_name" readonly="1" nolabel="1"/>
                            <field name="rodded_bulk_density_visible" invisible="1"/>

                        </h1>
                    </div>

                    <div invisible = "rodded_bulk_density_visible == False" class="custom_table_borders">
                        <field name="rodded_line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no'/>
                                <field name='container_with_material' class="blue-input" decoration-info="container_with_material != 0"/>
                                <field name='volume_of_cont' class="blue-input" decoration-info="volume_of_cont != 0"/>
                                <field name='rodded_bulk_density'/>
                            </tree>
                        </field> 
                    </div>

                    <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="not rodded_bulk_density_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="rodded_avg">Average Rodded Bulk Density</label></td>
                                <td><field name="rodded_avg"/><span>Kg/lit</span></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="rodded_avg_confirmity">Conformity</label></td>
                                <td>
                                    <field name="rodded_avg_confirmity"
                                        decoration-success="rodded_avg_confirmity == 'pass'" 
                                        decoration-danger="rodded_avg_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="rodded_avg_nabl">NABL</label></td>
                                <td>
                                    <field name="rodded_avg_nabl"
                                        decoration-success="rodded_avg_nabl == 'pass'" 
                                        decoration-danger="rodded_avg_nabl == 'fail'"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                 <!-- Soundness Na2So4  -->
                <div invisible="soundness_na2so4_visible == False">
                        <h1 class="text-center">
                            <field name="soundness_na2so4_name" readonly="1" nolabel="1"/>
                            <field name="soundness_na2so4_visible" invisible="1"/>

                        </h1>
                    </div>
                      
                      
                      <div invisible= "soundness_na2so4_visible == False" class="custom_table_borders">
                        <field name="soundness_sod_line_ids" nolabel="1" class="no_column_sorting">
                                <tree editable="bottom">
                                    <field name='passing_sieve' readonly= "1"/>
