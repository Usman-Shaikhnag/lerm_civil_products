<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_fine_aggregateee" model="ir.ui.view">
        <field name="name">mechanical.fine.aggregate.form</field>
        <field name="model">mechanical.fine.aggregate</field>
        <field name="arch" type="xml">
            <form create="false">
            <sheet>
                    <h1>
                        <field name="name_aggregate" readonly="1" nolabel="1"/>
                    </h1>
                    <group >
                       <field name="grade"/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                            <tree>
                                <field name="parameter_name"/>
                                <field name="test_method"/>
                            </tree>
                        </field>
                    </div>
                  
               
                    <div invisible="sieve_visible == False" >
                        <h1 style="text-align: center;">
                            <field name="sieve_analysis_name" readonly="1" nolabel="1"/>
                            <field name="sieve_visible" invisible="1"/>

                        </h1>
                    </div>
                   
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" invisible="not sieve_visible">
                        <tbody>
                            <tr>
                                <td class="w-25"><label for="wt_of_sample"/></td>
                                <td  class="w-25">
                                    <field name="wt_of_sample"/>
                                </td>
                                <td class="w-25"><label for="zone_type"/></td>
                                <td  class="w-25">
                                    <field name="zone_type"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <div invisible="sieve_visible == False">
                        <field name="sieve_analysis_child_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders ">
                                <field class="" name="serial_no" string="Sr.No"/>
                                <field class="" name='sieve_size' string="IS Sieve Size"/>
                                <field class="" name='wt_retained' string="Wt. Retained in gms"/>
                                <field class="" name='percent_retained' string="% Retained"/>
                                <field class="" name='cumulative_retained' context="{'default_cumulative_retained': cumulative_retained}" string="Cum. Retained %"/>
                                <field class="" name='passing_percent' string="Passing %" readonly="1"/>
                                <!-- <field class=" oe_center" name='specific_limt' string="Specified Limits"/> -->
                                
                            </tree>
                        </field>
                    </div>
                    <div invisible="sieve_visible == False">
                        <button string="Calculate" type="object" name="calculate_sieve" class="oe_highlight">
                            <i class="fa fa-calculator"/> Calculate
                        </button>
                    </div>

                <table class="table table-sm o_form_table w-50 table-bordered custom_table_borders mt-2" invisible="not sieve_visible">
                    <tbody>
                        <tr>
                            <td class=""><label for="grading"/></td>
                            <td  class=""><field name="grading"/></td>
                        </tr>
                        <tr>
                            <td class=""><label for="fineness_modulus"/></td>
                            <td  class=""><field name="fineness_modulus"/></td>
                        </tr>
                    </tbody>
                </table>
                    


                 
                   


                <div class="text-center" invisible="specific_gravity_visible == False">
                        <h1>
                            <field name="specific_gravity_name" readonly="1" nolabel="1"/>
                            <field name="specific_gravity_visible" invisible="1"/>
                            <field name="water_absorption_visible" invisible="1"/>

                        </h1>
                    </div>


                    <table class="table table-sm table-bordered custom_table_borders" invisible="not specific_gravity_visible" style="white-space:nowrap;">
                        <thead>
                            <tr>
                                <th>Observations</th>
                                <th> 1</th>
                                <th> 2</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Weight of basket and the sample while suspended in water (A1) gm</span></td>
                                <td><field name="wt_basket_and_sample"/></td>
                                <td><field name="wt_basket_and_sample_2"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of empty basket in water (A2) gm</span></td>
                                <td><field name="wt_empty_basket"/></td>
                                <td><field name="wt_empty_basket_2"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of Saturated Aggregate  in Water (A) = (A1 – A2) – gms</span></td>
                                <td><field name="wt_sample_inwater"/></td>
                                <td><field name="wt_sample_inwater_2"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of surface dried aggregate (B) gm</span></td>
                                <td><field name="wt_surface_dry"/></td>
                                <td><field name="wt_surface_dry_2"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of  oven dried aggregates (C) gm</span></td>
                                <td><field name="oven_dried_wt"/></td>
                                <td><field name="oven_dried_wt_2"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Specific Gravity of Fine aggregates [C/(B-A)]</span></td>
                                <td><field name="specific_gravity_1"/></td>
                                <td><field name="specific_gravity_2"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Water absorption [100(B-C)/C]</span></td>
                                <td><field name="water_absorption_1"/></td>
                                <td><field name="water_absorption_2"/></td>
                            </tr>
                        </tbody>
                    </table>


                    <div style="display:flex;">
                      <div style="width:50%">
                      <table class="table table-sm table-bordered custom_table_borders" style="width:98%" invisible="not specific_gravity_visible"> 
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Average Specific Gravity</span></td>
                                <td><field name="avg_specific_gravity"/></td>
                            </tr>
                        </tbody>
                    </table>
                      </div>

                      <div style="width:50%">
                         <table class="table table-sm table-bordered w-100 custom_table_borders" invisible="not specific_gravity_visible"> 
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Average Water Absorption - % </span></td>
                                <td><field name="avg_water_absorption"/></td>
                            </tr>
                        </tbody>
                    </table>

                      </div>
                    </div>


                    <div style="display:flex;">
                      <div style="width:50%">
                      <table class="table table-sm table-bordered custom_table_borders" style="width:98%" invisible="not specific_gravity_visible"> 
                        <tbody>
                            <tr>
                                <td><label for="avg_specific_gravity_conformity"></label></td>
                                <td><field  name="avg_specific_gravity_conformity"
                                            decoration-success="avg_specific_gravity_conformity == 'pass'" 
                                            decoration-danger="avg_specific_gravity_conformity == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                            <tr>
                                <td><label for="avg_specific_gravity_nabl"></label></td>
                                <td><field name="avg_specific_gravity_nabl"
                                            decoration-success="avg_specific_gravity_nabl == 'pass'" 
                                            decoration-danger="avg_specific_gravity_nabl == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                        </tbody>
                    </table>
                      </div>
                      
                      <div style="width:50%">
                         <table class="table table-sm table-bordered w-100 custom_table_borders" invisible="not water_absorption_visible"> 
                        <tbody>
                            <tr>
                                <td><label for="avg_water_absorption_conformity"></label></td>
                                <td><field  name="avg_water_absorption_conformity"
                                            decoration-success="avg_water_absorption_conformity == 'pass'" 
                                            decoration-danger="avg_water_absorption_conformity == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                            <tr>
                                <td><label for="avg_water_absorption_nabl"></label></td>
                                <td><field name="avg_water_absorption_nabl"
                                            decoration-success="avg_water_absorption_nabl == 'pass'" 
                                            decoration-danger="avg_water_absorption_nabl == 'fail'" 
                                            readonly="1" /></td>
                            </tr>
                        </tbody>
                    </table>

                      </div>
                
                    </div>





                    <!--  -->




                    <!-- compacted density -->


                     <div class="text-center" invisible="compacted_density_visible == False">
                        <h1>
                            <field name="compacted_density_name" readonly="1" nolabel="1"/>
                            <field name="compacted_density_visible" invisible="1"/>

                        </h1>
                    </div>

                    <table class="table table-sm table-bordered w-100 custom_table_borders" invisible="not compacted_density_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Capacity of Cylinder Use for Test in litre (V)</span></td>
                                <td><field name="capacity_of_cylinderr"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of empty cylinder (kg)</span></td>
                                <td><field name="wtt_of_empty_cylinder_compacted"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of cylinder + aggregate (kg)</span></td>
                                <td><field name="wtt_cylinder_aggregate_compacted"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Mass of Compacted Aggregate in Cylinder (A) – Kg</span></td>
                                <td><field name="mass_of_compacted_aggregate"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Compacted Density (Ƴ1) = (A/V) Kg/lit</span></td>
                                <td><field name="compacted_density"/></td>
                            </tr>
                        </tbody>
                    </table>
                        
                       
                   


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="compacted_density_visible == False">
                            <tbody>
                                <tr>
                                <td><label for="compacted_density_conformity">Conformity</label></td>
                                <td>
                                    <field name="compacted_density_conformity"
                                        decoration-success="compacted_density_conformity == 'pass'"
                                        decoration-danger="compacted_density_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="compacted_density_nabl">NABL</label></td>
                                <td>
                                    <field name="compacted_density_nabl" readonly="1"
                                        decoration-success="compacted_density_nabl == 'pass'"
                                        decoration-danger="compacted_density_nabl == 'fail'"/>
                                </td>
                            </tr>
                            </tbody>
                        </table>


            <!-- Loose density -->


                     <div class="text-center" invisible="loose_density_visible == False">
                        <h1>
                            <field name="loose_density_name" readonly="1" nolabel="1"/>
                            <field name="loose_density_visible" invisible="1"/>

                        </h1>
                    </div>

                    <table class="table table-sm table-bordered w-100 custom_table_borders" invisible="not loose_density_visible" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Capacity of Cylinder Use for Test in litre (V)</span></td>
                                <td><field name="capacity_of_cylinder_loose"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of empty cylinder (kg)</span></td>
                                <td><field name="wtt_of_empty_cylinder_loose"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of cylinder + aggregate (kg)</span></td>
                                <td><field name="wtt_cylinder_aggregate_loose"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Mass of Compacted Aggregate in Cylinder (A) – Kg</span></td>
                                <td><field name="mass_of_loose_aggregate"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Compacted Density (Ƴ1) = (A/V) Kg/lit</span></td>
                                <td><field name="loose_density"/></td>
                            </tr>
                        </tbody>
                    </table>
                        
                       
                   


                    <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" invisible="loose_density_visible == False">
                            <tbody>
                                <tr>
                                <td><label for="loose_density_conformity">Conformity</label></td>
                                <td>
                                    <field name="loose_density_conformity"
                                        decoration-success="loose_density_conformity == 'pass'"
                                        decoration-danger="loose_density_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="loose_density_nabl">NABL</label></td>
                                <td>
                                    <field name="loose_density_nabl" readonly="1"
                                        decoration-success="loose_density_nabl == 'pass'"
                                        decoration-danger="loose_density_nabl == 'fail'"/>
                                </td>
                            </tr>
                            </tbody>
                        </table>

                        <!-- Void In Compacted And Loose Density -->



                        <div class="text-center">
                        <h1>
                            <field name="voids_loose_and_compacted_name" readonly="1" nolabel="1"/>
                            <field name="voids_compacted_density_visible" invisible="1"/>
                            <field name="voids_loose_density_visible" invisible="1"/>
                            <!-- <field name="void_loose_compacted_visible" invisible="1"/> -->

                        </h1>
                    </div>

                    <table class="table table-sm table-bordered w-100 custom_table_borders" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Sp. Gravity of Material (Gs)</span></td>
                                <td><field name="specific_gravity_voids"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Percent Voids in Compacted Density = (Gs - Ƴ1 )/Gs x 100</span></td>
                                <td><field name="voids_compacted_density"/></td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Percent Voids in Loose Density = (Gs – Ƴ2 )/Gs x 100"</span></td>
                                <td><field name="voids_loose_density"/></td>
                            </tr>
                        </tbody>
                    </table>


            <div style="display:flex;">
                <div style="width:50%">
                    <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%" > 
                            <tbody>
                                <tr>
                                <td><label for="voids_compacted_density_conformity">Conformity</label></td>
                                <td>
                                    <field name="voids_compacted_density_conformity"
                                        decoration-success="voids_compacted_density_conformity == 'pass'"
                                        decoration-danger="voids_compacted_density_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="voids_compacted_density_nabl">NABL</label></td>
                                <td>
                                    <field name="voids_compacted_density_nabl" readonly="1"
                                        decoration-success="voids_compacted_density_nabl == 'pass'"
                                        decoration-danger="voids_compacted_density_nabl == 'fail'"/>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                </div>
                <div style="width:50%">
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                <td><label for="voids_loose_density_conformity">Conformity</label></td>
                                <td>
                                    <field name="voids_loose_density_conformity"
                                        decoration-success="voids_loose_density_conformity == 'pass'"
                                        decoration-danger="voids_loose_density_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="voids_loose_density_nabl">NABL</label></td>
                                <td>
                                    <field name="voids_loose_density_nabl" readonly="1"
                                        decoration-success="voids_loose_density_nabl == 'pass'"
                                        decoration-danger="voids_loose_density_nabl == 'fail'"/>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                </div>
                </div>



                <!--  -->
                    
                    
                    
                    
                    
                    
    

                                  



                         <!-- Bulking of Sand -->
                    <div invisible = "bulking_sand_visible == False">
                        <h1 class="text-center">
                            <field name="bulking_sand_name" readonly="1"/>
                            <field name="bulking_sand_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div invisible="bulking_sand_visible == False">
                        <field name="bulking_sand_child_lines"  style="width:100%" nolabel="1">
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no"/>
                                <field name="height_of_sand"/>
                                <field name="height_of_settled"/>
                                <field name="loss_off_height"/>
                                <!-- <field name="bulking_of_sand"/> -->
                            </tree>
                        </field>
                   
                    </div>

                    <!-- <group invisible = "bulking_sand_visible == False" string="Result" colspan="4"  style="white-space: nowrap; width:70%; margin-top: 10px">
                     
                        <field name="avg_height_sand_a" readonly="1"/>
                        <field name="avg_height_sattled_b" readonly="1"/>
                        <field name="avg_loss_c" readonly="1"/>
                  
                    </group> -->


                <table invisible="bulking_sand_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                    <tbody>
                        <tr>
                            <td><label class="fw-bold" for="avg_height_sand_a">Height of Sand in Cylinder (A)</label></td>
                            <td><field name="avg_height_sand_a"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_height_sattled_b">Height of Settled Sand (B)</label></td>
                            <td><field name="avg_height_sattled_b"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_loss_c">Loss of Height of Sand (A - B)</label></td>
                            <td><field name="avg_loss_c"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_bulking_of_sand">Average Bulking of Sand (%)</label></td>
                            <td><field name="avg_bulking_of_sand"/></td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_bulking_of_sand_conformity">Bulking Conformity</label></td>
                            <td>
                                <field name="avg_bulking_of_sand_conformity"
                                    decoration-success="avg_bulking_of_sand_conformity == 'pass'"
                                    decoration-danger="avg_bulking_of_sand_conformity == 'fail'"
                                    readonly="1"/>
                            </td>
                        </tr>
                        <tr>
                            <td><label class="fw-bold" for="avg_bulking_of_sand_nabl">Bulking NABL</label></td>
                            <td><field name="avg_bulking_of_sand_nabl"
                                        decoration-success="avg_bulking_of_sand_nabl == 'pass'"
                                    decoration-danger="avg_bulking_of_sand_nabl == 'fail'"
                                    readonly="1"/></td>
                        </tr>
                    </tbody>
                </table>



                <!-- Determination of Clay Lumps -->

                <div invisible="finer75_visible == False">
                        <h1 class="text-center">
                            <field name="name_finer75" readonly="1" nolabel="1"/>
                            <field name="finer75_visible" invisible="1"/>

                        </h1>
                    </div>

                 <table class="table table-sm table-bordered w-100 mt-2 custom_table_borders" invisible="finer75_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Weight of Sample in gms</span></td>
                                <td>
                                    <field name='wt_sample_finer75'/>
                                </td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Weight of dry sample after retained in 75 microns</span></td>
                                <td>
                                    <field name='wt_dry_sample_finer75'/>
                                </td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">Material finer than 75 micron in %</span></td>
                                <td>
                                    <field name='material_finer75'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" invisible="finer75_visible == False" style="white-space:nowrap;">
                        <tbody>
                            <tr>
                                <td><span class="fw-bold">Conformity</span></td>
                                <td>
                                    <field  name="material_finer75_conformity"
                                    decoration-success="material_finer75_conformity == 'pass'" 
                                    decoration-danger="material_finer75_conformity == 'fail'" 
                                    readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><span class="fw-bold">NABL</span></td>
                                <td>
                                    <field  name="material_finer75_nabl"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>






                    <!-- site_content_visible -->
                <div invisible = "site_content_visible == False">
                    <h1 class="text-center">
                        <field name="site_content_name" readonly="1" nolabel="1"/>
                        <field name="site_content_visible" invisible="1"/>

                    </h1>
                </div>

                <div invisible = "site_content_visible == False">
                    <field name="site_content_child_lines"  nolabel="1" >
                        <tree editable="bottom"  class="custom_table_borders">
                            <field name="serial_no"/>
                            <field name="heigh_sand_silt"/>
                            <field name="height_of_sand" />
                            <field name="height_silt"/>
                            <!-- <field name="bulking_of_sand1"/> -->
                        </tree>
                    </field>   
                </div>



                    <table invisible="site_content_visible == False" class="table table-sm table-bordered w-50 mt-2 custom_table_borders">
                        <tbody>
                            <tr>
                                <td><label class="fw-bold" for="content_height_sand_a">Height of Sand + Silt in the Cylinder (A)</label></td>
                                <td><field name="content_height_sand_a" /></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="content_height_sand_b">Height of Sand (B)</label></td>
                                <td><field name="content_height_sand_b" /></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="content_slit_c">Height of Silt (A - B)</label></td>
                                <td><field name="content_slit_c" /></td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_bulking_of_sand1">Silt Content</label></td>
                                <td>
                                    <div class="d-flex">
                                        <field name="avg_bulking_of_sand1" />
                                        <span class="ms-2">%</span>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_bulking_of_sand1_conformity">Silt Content Conformity</label></td>
                                <td>
                                    <field name="avg_bulking_of_sand1_conformity"
                                        decoration-success="avg_bulking_of_sand1_conformity == 'pass'"
                                        decoration-danger="avg_bulking_of_sand1_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_bulking_of_sand1_nabl">Silt Content NABL</label></td>
                                <td><field name="avg_bulking_of_sand1_nabl"
                                        decoration-success="avg_bulking_of_sand1_nabl == 'pass'"
                                        decoration-danger="avg_bulking_of_sand1_nabl == 'fail'" 
                                        readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>


                     <!-- Moisture Content -->
                    <div invisible = "moisture_content_visible == False">
                        <h1 class="text-center">
                            <field name="moisture_content_name1" readonly="1" nolabel="1"/>
                            <field name="moisture_content_visible" invisible="1"/>
                        </h1>
