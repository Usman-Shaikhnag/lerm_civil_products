<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="bentonite_report">
        <t t-call="web.html_container">
            <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
                <div class="container_eln" style="padding-top:0;">
                    <div class="" t-foreach="eln" t-as="o">
                        <table style="margin-top:5px; width:100%; table-layout:fixed;" class="header_table">
                            <tbody>
                                <tr>
                                    <td><strong>Name of Work</strong></td>
                                    <td colspan="5"><span t-field="o.srf_id.name_work"/></td>
                                </tr>
                                <tr>
                                    <t t-if="o.srf_id.client">
                                        <td colspan="1"><strong>Customer Name</strong></td>
                                        <td colspan="2">
                                            <![CDATA[&nbsp;]]>
                                            <t t-if="o.srf_id.customer"><span t-field="o.srf_id.customer"/></t>
                                            <t t-else="">--</t>
                                        </td>
                                        <td colspan="1"><strong>Client Name</strong></td>
                                        <td colspan="2"><span t-field="o.srf_id.client"/></td>
                                    </t>
                                    <t t-else="">
                                        <td>Customer Name :</td>
                                        <td colspan="5">
                                            <![CDATA[&nbsp;]]>
                                            <t t-if="o.srf_id.customer"><span t-field="o.srf_id.customer"/></t>
                                            <t t-else="">--</t>
                                        </td>
                                    </t>
                                </tr>
                                <tr>
                                    <td><strong>Address</strong></td>
                                    <td colspan="5">
                                        <span t-field="o.srf_id.customer.street"/>
                                        <span t-field="o.srf_id.customer.street2"/>
                                        <span t-field="o.srf_id.customer.city"/>
                                        <t t-if="o.srf_id.customer.zip">- <span t-field="o.srf_id.customer.zip"/></t>,
                                        <span t-field="o.srf_id.customer.state_id"/>,
                                        <span t-field="o.srf_id.customer.country_id"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Location of Performance</strong></td>
                                    <td colspan="2"><span t-field="o.sample_id.location_name"/></td>
                                    <td><strong>Sample ID</strong></td>
                                    <td colspan="2"><span t-field="o.srf_id.srf_id"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Date of Issue</strong></td>
                                    <td colspan="2"><span t-field="o.end_date"/></td>
                                    <td><strong>Received Date</strong></td>
                                    <td colspan="2"><span t-field="o.sample_id.sample_received_date"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Description &amp; Grade of Material</strong></td>
                                    <td colspan="2">
                                        <span t-field="o.grade_id.grade"/>
                                        <span t-field="o.material.name"/>
                                    </td>
                                    <td><strong>Customer Reference</strong></td>
                                    <td colspan="2"><span t-field="o.srf_id.client_refrence"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Condition of Sample</strong></td>
                                    <td colspan="2"><span t-field="o.sample_id.sample_condition"/></td>
                                    <td><strong>Structure</strong></td>
                                    <td colspan="2"><span t-field="o.sample_id.lab_id"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Discipline</strong></td>
                                    <td colspan="5"><span t-field="o.sample_id.discipline_id.discipline"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Liquid Limit -->
                    <div t-if="data.ll_visible" style="margin-top:15px;">
                        <div style="text-align:center;font-size:18px">
                            <span t-field="env['lerm.parameter.master'].search([('internal_id','=','bentonite-ll-4a1b-4c2d-8e3f-000000000001')]).parameter_name"/>
                            <span>
                                <t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','bentonite-ll-4a1b-4c2d-8e3f-000000000001')]).parameter_table" t-as="parameter">
                                    <t t-if="parameter.grade.id == eln.grade_id.id">
                                        <span t-field="parameter.specification"/>
                                    </t>
                                </t>
                            </span>
                        </div>
                        <table class="custom_table_borders" style="width: 100%; table-layout: fixed; margin-top:10px;">
                            <thead>
                                <tr>
                                    <th style="text-align:center;">Sr. No</th>
                                    <th style="text-align:center;">Penetration (mm)</th>
                                    <th style="text-align:center;">Container No.</th>
                                    <th style="text-align:center;">Wt Container + Wet Soil (g)</th>
                                    <th style="text-align:center;">Wt Container + Dry Soil (g)</th>
                                    <th style="text-align:center;">Wt of Water (g)</th>
                                    <th style="text-align:center;">Wt Container (g)</th>
                                    <th style="text-align:center;">Wt of Dry Soil (g)</th>
                                    <th style="text-align:center;">Moisture Content (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data.ll_child_lines" t-as="r">
                                    <td style="text-align:center;"><span t-esc="r.sr_no"/></td>
                                    <td style="text-align:center;"><span t-field="r.penetration" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-esc="r.container_no"/></td>
                                    <td style="text-align:center;"><span t-field="r.wt_container_wet_soil" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.wt_container_dry_soil" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.wt_water" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.wt_container" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.wt_dry_soil" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.moisture_content" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="margin-top:5px">
                            <tr>
                                <td colspan="12"><b>Liquid Limit (%):</b></td>
                                <![CDATA[&nbsp;]]>
                                <td><span t-field="data.liquid_limit_result" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                        </table>
                        <div t-if="data.ll_graph" style="margin-top:10px; text-align:center;">
                            <img t-att-src="'data:image/png;base64,%s' % data.ll_graph.decode('utf-8')" style="max-width:500px;"/>
                        </div>
                    </div>

                    <!-- Wet Fineness -->
                    <div t-if="data.wet_fineness_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align:center;font-size:18px">
                            <span t-field="env['lerm.parameter.master'].search([('internal_id','=','bentonite-wf-4a1b-4c2d-8e3f-000000000002')]).parameter_name"/>
                            <span>
                                <t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','bentonite-wf-4a1b-4c2d-8e3f-000000000002')]).parameter_table" t-as="parameter">
                                    <t t-if="parameter.grade.id == eln.grade_id.id">
                                        <span t-field="parameter.specification"/>
                                    </t>
                                </t>
                            </span>
                        </div>
                        <table class="custom_table_borders" style="width: 100%; table-layout: fixed; margin-top:10px;">
                            <thead>
                                <tr>
                                    <th style="text-align:center;">Sr. No</th>
                                    <th style="text-align:center;">Sieve Size (mm)</th>
                                    <th style="text-align:center;">Retained Wt. (g)</th>
                                    <th style="text-align:center;">Cum. Wt. Retained (g)</th>
                                    <th style="text-align:center;">% of Retention</th>
                                    <th style="text-align:center;">% of Passing</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data.wet_fineness_lines" t-as="r">
                                    <td style="text-align:center;"><span t-esc="r.sr_no"/></td>
                                    <td style="text-align:center;"><span t-field="r.sieve_size" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.retained_wt" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.cum_retained" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.pct_retention" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.pct_passing" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Dry Fineness -->
                    <div t-if="data.dry_fineness_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align:center;font-size:18px">
                            <span t-field="env['lerm.parameter.master'].search([('internal_id','=','bentonite-df-4a1b-4c2d-8e3f-000000000003')]).parameter_name"/>
                            <span>
                                <t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','bentonite-df-4a1b-4c2d-8e3f-000000000003')]).parameter_table" t-as="parameter">
                                    <t t-if="parameter.grade.id == eln.grade_id.id">
                                        <span t-field="parameter.specification"/>
                                    </t>
                                </t>
                            </span>
                        </div>
                        <table class="custom_table_borders" style="width: 100%; table-layout: fixed; margin-top:10px;">
                            <thead>
                                <tr>
                                    <th style="text-align:center;">Sr. No</th>
                                    <th style="text-align:center;">Sieve Size (mm)</th>
                                    <th style="text-align:center;">Retained Wt. (g)</th>
                                    <th style="text-align:center;">Cum. Wt. Retained (g)</th>
                                    <th style="text-align:center;">% of Retention</th>
                                    <th style="text-align:center;">% of Passing</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data.dry_fineness_lines" t-as="r">
                                    <td style="text-align:center;"><span t-esc="r.sr_no"/></td>
                                    <td style="text-align:center;"><span t-field="r.sieve_size" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.retained_wt" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.cum_retained" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.pct_retention" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td style="text-align:center;"><span t-field="r.pct_passing" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Moisture Content -->
                    <div t-if="data.moisture_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align:center;font-size:18px">
                            <span t-field="env['lerm.parameter.master'].search([('internal_id','=','bentonite-mc-4a1b-4c2d-8e3f-000000000004')]).parameter_name"/>
                            <span>
                                <t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','bentonite-mc-4a1b-4c2d-8e3f-000000000004')]).parameter_table" t-as="parameter">
                                    <t t-if="parameter.grade.id == eln.grade_id.id">
                                        <span t-field="parameter.specification"/>
                                    </t>
                                </t>
                            </span>
                        </div>
                        <table class="custom_table_borders" style="width: 100%; margin-top:10px;">
                            <tr>
                                <td><b>Initial Weight M1 (g)</b></td>
                                <td><span t-field="data.moisture_m1" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr>
                                <td><b>Dry Weight M2 (g)</b></td>
                                <td><span t-field="data.moisture_m2" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr>
                                <td><b>Moisture Content (%)</b></td>
                                <td><span t-field="data.moisture_content_result" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- Sand Content -->
                    <div t-if="data.sand_visible" style="margin-top:20px; page-break-before: always;">
                        <div style="text-align:center;font-size:18px">
                            <span t-field="env['lerm.parameter.master'].search([('internal_id','=','bentonite-sc-4a1b-4c2d-8e3f-000000000005')]).parameter_name"/>
                            <span>
                                <t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','bentonite-sc-4a1b-4c2d-8e3f-000000000005')]).parameter_table" t-as="parameter">
                                    <t t-if="parameter.grade.id == eln.grade_id.id">
                                        <span t-field="parameter.specification"/>
                                    </t>
                                </t>
                            </span>
                        </div>
                        <table class="custom_table_borders" style="width: 100%; margin-top:10px;">
                            <tr>
                                <td><b>Initial Weight (g)</b></td>
                                <td><span t-field="data.sand_initial_wt" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr>
                                <td><b>Final Weight (g)</b></td>
                                <td><span t-field="data.sand_final_wt" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr>
                                <td><b>Sand Content (%)</b></td>
                                <td><span t-field="data.sand_content_result" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                        </table>
                    </div>

                    <div style="margin-top:5px; page-break-inside: avoid;" class="noteContainer">
                        <table class="table table-bordered">
                            <tr>
                                <td style="padding: 5px; font-style: italic; font-size: 12px;">
                                    <t t-if="data.notes_id">
                                        <b>Notes:-</b>
                                        <t t-foreach="data.notes_id" t-as="n">
                                            <span>
                                                (<t t-esc="n.sr_no"/>)
                                                <t t-esc="n.notes"/>
                                                &#160;&#160;
                                            </span><br/>
                                        </t>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
                        <div>
                            <div><b>Reviewed By</b></div>
                            <div style="height: 50px;">
                                <t t-if="eln.sample_id.checkby_signature_required and eln.sample_id.check_by.employee_id.signature">
                                    <img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')"
                                         style="max-width: 200px; max-height: 45px; margin-top: 1px; z-index: -10;"/>
                                </t>
                            </div>
                            <div><b><span t-esc="eln.sample_id.check_by.name"/></b></div>
                            <div><b>(<span t-esc="eln.sample_id.check_by.job_title"/>)</b></div>
                        </div>
                        <div>
                            <div><b>Per pro GEONYMS INDIA PRIVATE LIMITED.</b></div>
                            <div style="height: 50px;">
                                <t t-if="eln.sample_id.approveby_signature_required">
                                    <div t-if="eln.sample_id.approved_by.employee_id.signature">
                                        <img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
                                    </div>
                                </t>
                            </div>
                            <div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
                            <div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
                        </div>
                    </div>

                    <div style="margin-top: 5px; text-align: center;">
                        <p style="font-weight:800;">...... End Of Report......</p>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
