<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="rebound_hammer_view" model="ir.ui.view">
        <field name="name">ndt.rebound.hammer.form</field>
        <field name="model">ndt.rebound.hammer</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                     <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="grade" />
                        <field name="eln_state" />
                    </group>
                   

                    <div>
                        <h1 style="text-align:center">
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div> 

                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temperature"></label>
                                    </td>
                                    <td>
                                        <field name="temperature" string="Temperature °C" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="structure" ></label>
                                    </td>
                                    <td>
                                        <field name="structure" string="Structure Age" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div> 


                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="surface_condition"></label>
                                    </td>
                                    <td>
                                        <field name="surface_condition" string="Surface Condition" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="make" ></label>
                                    </td>
                                    <td>
                                        <field name="make" string="Make" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div> 


                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="model"></label>
                                    </td>
                                    <td>
                                        <field name="model" string="Model" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="no_points" ></label>
                                    </td>
                                    <td>
                                        <field name="no_points" string="No.Of. Points" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div> 



                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="sample_satus"></label>
                                    </td>
                                    <td>
                                        <field name="sample_satus" string="Sample Status" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                         <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="description_work"></label>
                                    </td>
                                    <td>
                                        <field name="description_work" string="Description Of Work" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                       
                    </div> 


                    <div>
                       <field name="child_lines" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="serial_no" string="Test Point"/>
                                <field name="location" string="Location"/>
                                <!-- <field name="impact_direction" string="Impact Direction"/> -->
                                <field name="f1" string="Measured RN 1"/>
                                <field name="f2" string="Measured RN 2"/>
                                <field name="f3" string="Measured RN 3"/>
                                <field name="f4" string="Measured RN 4"/>
                                <field name="f5" string="Measured RN 5"/>
                                <field name="f6" string="Measured RN 6"/>
                                
                                <field name="avg" string="Measured RN (AVG)"/>
                                <field name="mpa" string="Estimated Strength (MPa)"/>
                                <field name="direction" string='Direction'/>
                            </tree>
                        </field>
                     </div> 

                     <table class="table o_form_table w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                <td><strong>Average Mpa</strong></td>
                                <td>
                                    <field name="average_mpa" string="Average Mpa" identity="result"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Minimum Mpa</strong></td>
                                <td>
                                    <field name="minimum_mpa" string="Minimum Mpa" identity="result"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Maximum Mpa</strong></td>
                                <td>
                                    <field name="maximum_mpa" string="Maximum Mpa" identity="result"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <group/>

                  

                    <div>
                        <field name="notes_id" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="notes" />
                               
                            </tree>
                        </field>
                    </div>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>