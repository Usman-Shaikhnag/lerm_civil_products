<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="crack_width_view" model="ir.ui.view">
        <field name="name">ndt.crack.width.form</field>
        <field name="model">ndt.crack.width</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id"  readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <div>
                        <h1 style="text-align:center">
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>


                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temperature"></label>
                                    </td>
                                    <td>
                                        <field name="temperature" string="Temperature °C" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="structure" ></label>
                                    </td>
                                    <td>
                                        <field name="structure" string="Structure Age" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div> 

                    <div>
                       <field name="child_lines" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="member" string="Element Type"/>
                                <field name="location" string="Location"/>
                                <field name="crack_width_mm" string="Crack Width in mm"/>
                            </tree>
                        </field>
                     </div> 


                     <table class="table o_form_table w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                <td><strong>Average (mm)</strong></td>
                                <td>
                                    <field name="average" string="Average (mm)" identity="result"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Min Value (mm)</strong></td>
                                <td>
                                    <field name="min" string="Min Value (mm)" identity="result"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Max Value (mm)</strong></td>
                                <td>
                                    <field name="max" string="Max Value (mm)" identity="result"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <group/>


                     <div>
                        <field name="notes" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="notes" />
                               
                            </tree>
                        </field>
                    </div>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>