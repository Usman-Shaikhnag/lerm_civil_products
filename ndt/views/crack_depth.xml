<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="crack_depth_view" model="ir.ui.view">
        <field name="name">ndt.crack.depth.form</field>
        <field name="model">ndt.crack.depth</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                     <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                         <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div class="custom_table_borders" style="margin-top: 15px;">
                        <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                  </div>


                    <div>
                        <h1 style="text-align:center">
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>


                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temperature"></label>
                                    </td>
                                    <td>
                                        <field name="temperature" string="Temperature °C" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="structure" ></label>
                                    </td>
                                    <td>
                                        <field name="structure" string="Structure Age" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div> 


                    <div>
                       <field name="child_lines" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="member" string="Element Type"/>
                                <field name="location" string="Location"/>
                                <field name="tc" string="Tc"/>
                                <field name="ts" string="Ts"/>
                                <field name="distance" string="Distance"/>
                                <!-- <field name="tc2" string="Tc2"/>
                                <field name="ts2" string="Ts2"/>
                                <field name="tc2_by_ts2" string="Tc2/Ts2"/>
                                <field name="sqrt_Tc2_by_Ts2minus1" string="√Tc2/Ts2-1"/> -->
                                <field name="cd" string="CD=√Tc2/Ts2-1 x 200"/>
                            </tree>
                        </field>
                    </div> 


                    <table class="table o_form_table w-50 mt-2 custom_table_borders" >
                        <tbody>
                            <tr>
                                <td><strong>Average (mm)</strong></td>
                                <td>
                                    <field name="average" string="Average (mm)" identity="result"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Min mm</strong></td>
                                <td>
                                    <field name="min_cd" string="Min mm" identity="result"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Max mm</strong></td>
                                <td>
                                    <field name="max_cd" string="Max mm" identity="result"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <group/>

                    <div>
                        <field name="notes" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="notes" />
                               
                            </tree>
                      </field>
                    </div>

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>