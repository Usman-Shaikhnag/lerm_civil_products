<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="half_cell_view" model="ir.ui.view">
        <field name="name">ndt.half.cell.form</field>
        <field name="model">ndt.half.cell</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id"  readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>

                    <div>
                        <h1 style="text-align:center">
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <div class="d-flex gap-3"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temperature"></label>
                                    </td>
                                    <td>
                                        <field name="temperature" string="Temperature °C" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="structure" ></label>
                                    </td>
                                    <td>
                                        <field name="structure" string="Structure Age" identity="extra"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="structure" ></label>
                                    </td>
                                    <td>
                                        <field name="instrument"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div> 

                     


                    <div>
                       <field name="child_lines_1" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="member" />
                                <field name="level" />
                                <field name="r1" />
                                <field name="r2" />
                                <field name="r3" />
                                <field name="r4" />
                                <field name="r5" />
                                <field name="r6" />
                                <field name="avg" />
                                <field name="corrosion_condition" />
                                
                            </tree>
                        </field>
                     </div> 

                    <button
                            type="object"
                            class="oe_highlight"
                            name="button_press_action"
                            string="Update"
                            />

                    <div>
                       <field name="child_lines_2" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="member" />
                                <field name="level" />
                                <field name="r1" />
                                <field name="r2" />
                                <field name="r3" />
                                <field name="r4" />
                                <field name="r5" />
                                <field name="r6" />
                                <field name="avg" />
                                <field name="corrosion_condition" />
                            </tree>
                         </field>
                     </div> 


                    <div>
                        <field name="notes" nolabel="1" >
                            <tree editable="bottom" class="custom_table_borders">
                                <field name="notes" />
                               
                            </tree>
                        </field>
                    </div>


                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                    
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>