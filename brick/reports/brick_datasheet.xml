	<t t-call="lerm_civil.data_sheet_header_generaltemplate">
		<div style="text-align:center;font-size:18px;font-weight: bold">
			Brick Fly Ash
		</div>
		<div class="container_eln" style="margin-top:5px">
            <table style="margin-top:20px">
				<tr cols="12">
					
                    
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>
				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                    <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>
                <!-- Water Absorption -->

                <div  t-if="data.compressive_strength_visible">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Compressive Strength
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Length in mm</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Width in  mm</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Area in mm2</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Load in KN</th>
									<th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Compressive Strength (N/mm2)</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.compressive_strength_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['length']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['width']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['load_kn']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
										<span t-esc="r['compressive_strength']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Compressive Strength :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avrg_compressive_strength"/>
								</td>
							</tr>
						</table>

						<t t-set="prepared_by_obj" t-value="eln.parameters_result[0].technician if eln.parameters_result else False"/>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Prepared By
									</b>
								</div>
							<div style="height: 40px;">
							<t t-if="eln.tested_by_signature_datasheet and prepared_by_obj">

								<div t-if="prepared_by_obj.employee_id.signature">
