<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="lerm_brick_datasheet">
    <t t-call="web.html_container">
	<t t-call="lerm_civil.mechanical_data_sheet_header">
		<div style="text-align:center;font-size:18px;font-weight: bold">
			Clay Bricks
		</div>
		<div class="container_eln" style="margin-top:5px">
            <table style="margin-top:20px">
				<tr cols="12">
					
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>
				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                    <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>
                <!-- Compressive Strength -->

           

             <div t-if="data.compressive_strength_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>

                         <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="2" style="text-align: center;font-weight: bold">Sample
                                </td>
                                  <td colspan="2" style="text-align: center;font-weight: bold">Identification Mark
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Length, mm 
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Width, mm
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold">Height, mm
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold"> Area (mm²)
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold"> Load in, KN
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold">Compressive strength, MPa
                                </td>
                            
                            </tr>

                            <t t-set="k" t-value="0"/>
                            <tr t-foreach="data.compressive_strength_lines" t-as="r">
                                <td colspan="2" style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['identification_mark']"/>
                                </td>
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['length']"/>
                                </td>
                                
                              
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['width']"/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['height']"/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['load']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                             
                               
                            </tr>
                        </table>

                        <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="6" style="font-weight: bold">Average Compressive Strength  :
                              <![CDATA[&nbsp;]]>
                                </td>
                                <td colspan="6" style="text-align: center">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.avrg_compressive_strength"/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    

                    </div>

                 <!-- Visual Observation -->

            <div t-if="data.efflorescence_visible" style="margin-top:20px">
				<div style="text-align:center;font-size:18px;font-weight: bold">
						Efflorescence
                         <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','3214598fgrt-d27d-4ef9-9b27-e8eb4e7ae6ac')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
				</div>
                <table style="margin-top:30px;">
                
                    <thead>
                        <tr>
                            
                            <th style="text-align: center;max-width:200px">
                                <span style="font-weight: bold;">
                                    Sr.No
                                </span>
                            </th>
                            <th style="text-align: center;max-width:100px">
                                <span style="font-weight: bold;">
                                     1 Observation
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     2 Observation
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     3 Observation
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     4 Observation
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     5 Observation
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            
                            <td style="text-align: center;max-width:200px">
                                <span style="text-align: center;">
                                    
                                </span>    
                            </td>
                            
                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.visual_observation_1" />
                                </span>									
                            </td>

                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.visual_observation_2" />
                                </span>									
                            </td>

                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.visual_observation_3" />
                                </span>									
                            </td>
                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.visual_observation_4" />
                                </span>									
                            </td>
                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.visual_observation_5" />
                                </span>									
                            </td>
                            
                        </tr>
                    </tbody>
				
				</table>	
			</div>

                <!-- Dimension -->

            <div t-if="data.dimension_visible" style="margin-top:20px">
				<div style="text-align:center;font-size:18px;font-weight: bold">
						Dimension (mm) 
                        <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','125478bvf3-8d5d-4f45-8afb-b911f9cafe41')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>

				</div>
                <div style="text-align:center;font-size:18px;font-weight: bold">
                        20 Bricks 
				</div>
                <table style="margin-top:30px;">
                
                    <thead>
                        <tr>
                            <th style="text-align: center;max-width:200px">
                                <span style="font-weight: bold;">
                                    Sr.No
                                </span>
                            </th>
                            <th style="text-align: center;max-width:100px">
                                <span style="font-weight: bold;">
                                     Length in mm
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     Width in mm
                                </span>
                            </th>
                            <th style="text-align: center;">
                                <span style="font-weight: bold;">
                                     Height in mm
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            
                            <td style="text-align: center;max-width:200px">
                                <span style="text-align: center;">
                                    1
                                </span>    
                            </td>
                            
                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.avrg_length" t-options='{"widget": "float", "precision": 2}'/>
                                </span>									
                            </td>

                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.avrg_width" t-options='{"widget": "float", "precision": 2}'/>
                                </span>									
                            </td>

                            <td style="text-align: center;">
                                <span style="text-align: center;" >
                                    <span t-field="data.avrg_height" t-options='{"widget": "float", "precision": 2}'/>
                                </span>									
                            </td>
                        </tr>
                    </tbody>
				
				</table>	
			</div>

                <!-- Water Absorption 					 -->

             <div t-if="data.water_absorbtion_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                              <span t-field="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).parameter_name"/>
                            <span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
                        </div>

                         <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="2" style="text-align: center;font-weight: bold">Sample
                                </td>
                                  <td colspan="2" style="text-align: center;font-weight: bold">Identification Mark
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Initial wt ater 24 hr emersion water (W1)
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold"> Final wt after 24 hr oven (W2)
                                </td>
                                 <td colspan="2" style="text-align: center;font-weight: bold">Water Absorption, % = [(W1-W2)/W2 * 100]
                                </td>
                               
                            
                            </tr>

                            <t t-set="k" t-value="0"/>
                            <tr t-foreach="data.water_absorption_lines" t-as="r">
                                <td colspan="2" style="text-align: center">
                                    <div>
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </div>
                                </td>
                                 <td colspan="2" style="text-align: center">
                                    <span t-esc="r['identification_mark']"/>
                                </td>
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['initial_wt']"/>
                                </td>
                              
                                <td colspan="2" style="text-align: center">
                                    <span t-esc="r['final_wt']"/>
                                </td>
                             
                                  <td colspan="2" style="text-align: center">
                                    <span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                  
                               
                            </tr>
                        </table>

                        <table style="margin-top:10px">
                            <tr cols="12">
                                <td colspan="6" style="font-weight: bold">Average Water Absorption :
                              <![CDATA[&nbsp;]]>
                                </td>
                                  <td colspan="6" style="text-align: center">
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="data.avrg_water_absorption"/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).unit.name"/>
                                </td>
                            </tr>
                        </table> 
                      
                    

                    </div>
                
				<!-- authorizeRowDataSheet -->
				
			
            <div class="authorizeRowDataSheet">
                <div>
                    <div>
                        <b>
                            Tested By 
                        </b>
                        
                    </div>
                    <div style="height:40px">

                    </div>
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.filled_by.name"/>
                        </b>
                    </div>
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                        </b>
                    </div>
                </div>
                <div style="margin-left:500px">
                    
                    <div>
                        <b>
                            Checked By
                        </b>
                    </div>
                    <div style="height:40px">

                    </div>
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.check_by.name"/>
                        </b>
                    </div>
                    
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.check_by.job_title"/>)
                        </b>
                    </div>
                </div>
            </div>

		</div>

	</t>
</t>
</template>
</odoo>