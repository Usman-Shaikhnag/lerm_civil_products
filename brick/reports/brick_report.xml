<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_brick_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->

			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>TEST REPORT</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:70px;">
					
					<div t-foreach="eln" t-as="o">
						
						<table style="margin-top:10px; border:none">
							<tr>
								<td colspan="2" style=" font-weight: bold;">Client Details:</td>
								<td colspan="10">
									<span t-field="o.srf_id.customer.name"/><br />
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
									,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
							
								<td colspan="2" style=" font-weight: bold;">Client Reference:</td>
								<td colspan="10"><span t-field="o.srf_id.client_refrence"/></td>
							</tr>

							<tr>
								<td colspan="2" style=" font-weight: bold;">Name of Work:</td>
								<td colspan="10"><span t-field="o.srf_id.name_work"/></td>
							</tr>
						<!-- </table>

						<table class="table" style="width:100%; font-size: 13px;"> -->
							<tr>
								<td colspan="2" style=" font-weight: bold;">Date of Testing:</td>
								<td colspan="10">
									<span t-field="o.start_date"/> to <span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Size:</td>
								<td colspan="10">
									<span t-field="o.sample_id.size_id.size"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Grade:</td>
								<td colspan="10">
									<span t-field="o.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="2" style="font-weight: bold;">Material/Test Name:</td>
								<td colspan="10">
									<span t-field="o.material.name"/>
								</td>
							</tr>

							<!-- Source of Sample (only if value exists) -->
							<tr t-if="o.material.source_sample">
								<td colspan="2" style="font-weight: bold;">Source of Sample</td>
								<td colspan="10">
									<span t-field="o.material.source_sample"/>
								</td>
							</tr>

							<!-- Test method adopted (only if value exists) -->
							<tr t-if="o.material.test_method_adopted">
								<td colspan="2" style="font-weight: bold;">Test method adopted:</td>
								<td colspan="10">
									<span t-field="o.material.test_method_adopted"/>
								</td>
							</tr>

						</table>

					</div>
					<div style="text-align:center;">
						<h4 class="mb-0" style="text-decoration: underline;">Results</h4>
					</div>
						
					
					<div>

					    <table class="table o_form_table custom_table_borders">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th style="text-align: center;">Length (mm)</th>
                                <th style="text-align: center;">Breadth (mm)</th>
                                <th style="text-align: center;">Height (mm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Dimensions</td>
                                <td style="text-align: center;" t-esc="brick.length_in_mm"/>
                               <td style="text-align: center;" t-esc="brick.width_in_mm"/>
                                <td style="text-align: center;" t-esc="brick.height_in_mm"/>
                            </tr>
                        </tbody>
                    </table>
						
						<table style="width:100%; border-collapse: collapse; font-size:13px;" border="1">
							<thead>
								<tr>
									<th rowspan="2" style="text-align:center;">Sample No</th>
									<th colspan="3" style="text-align:center;">Dimensions (mm) <br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','125478bvf3-8d5d-4f45-8afb-b911f9cafe41')]).test_method.test_method"/>
									</th>
									<th rowspan="2" style="text-align:center;">Compressive Strength 
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).unit.name"/><br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).test_method.test_method"/>
									</th>
									<th rowspan="2" style="text-align:center;">Water Absorption 
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).unit.name"/><br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).test_method.test_method"/>
									</th>
									<th rowspan="2" style="text-align:center;">Efflorescence Observation <br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','3214598fgrt-d27d-4ef9-9b27-e8eb4e7ae6ac')]).test_method.test_method"/>
									</th>
								</tr>
								<tr>
									<th style="text-align:center;">Length</th>
									<th style="text-align:center;">Width</th>
									<th style="text-align:center;">Height</th>
								</tr>
							</thead>

							<tbody>
								<tr t-foreach="brick.get_combined_lines()" t-as="line">
									<td style="text-align:center;"><t t-esc="line['serial_no']"/></td>
									<td style="text-align:center;"><t t-esc="line['length']"/></td>
									<td style="text-align:center;"><t t-esc="line['width']"/></td>
									<td style="text-align:center;"><t t-esc="line['height']"/></td>
									<td style="text-align:center;">
										<t t-esc="line['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align:center;">
										<t t-esc="line['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align:center;"><t t-esc="line['visual_observation']"/></td>
								</tr>
							</tbody>

					
						<tfoot>
								<tr>
									<td colspan="4"></td> <!-- skip first 4 cols -->

									<!-- Average Compressive Strength -->
									<td style="padding:0;">
										<div style="display:table; width:100%; border-collapse:collapse;">
											<div style="display:table-cell; width:50%; text-align:center; border-right:1px solid black;">
												Average
											</div>
											<div style="display:table-cell; width:50%; text-align:center;">
												<t t-esc="brick.avrg_compressive_strength" 
												t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).unit.name"/>
											</div>
										</div>
									</td>

									<!-- Average Water Absorption -->
									<td style="padding:0;">
										<div style="display:table; width:100%; border-collapse:collapse;">
											<div style="display:table-cell; width:50%; text-align:center; border-right:1px solid black;">
												Average
											</div>
											<div style="display:table-cell; width:50%; text-align:center;">
												<t t-esc="brick.avrg_water_absorption" 
												t-options='{"widget": "float", "precision": 2}'/>  <span t-field="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).unit.name"/>
											</div>
										</div>
									</td>

									<td></td> <!-- observation col blank -->
								</tr>
							</tfoot>





						</table>


						 
					</div>
					<div style="margin-top:20px; page-break-inside: avoid;" class="noteContainer">
						<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Note:-</b>
									&#160;&#160;(i) The results relate only to the items tested 
									&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
									&#160;&#160;(iii) Any corrections invalidate the test reports 
									&#160;&#160;(iv) Any Query regarding the report must be reported immediately. 
									&#160;&#160;(v) * mark indicate tests which are not in the scope of NABL. 
									&#160;&#160;(vi) # mark indicates Details given by Client.
									<t t-if="eln.has_witness">
										&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
									</t>
									<t t-if="eln.remarks">
										&#160;&#160;<span t-esc="eln.remarks"/>
									</t>
								</td>
							</tr>
						</table>
					</div>

					<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							
						</div>
					</div>
					
				<!-- </div> -->
			</div>

			<div style="margin-top: 10px; text-align: center;">
				<p style="padding-top: 10px;">
						...... End Of Report......
				</p>
			</div>
		<!-- </div> -->

	</t>
</t>

</template>

</odoo>