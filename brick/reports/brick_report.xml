<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_brick_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->

			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>TEST REPORT</b></p>
				</div> -->


				<div class="container_eln" style="padding-top:20px;">
					
					<div t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">Customer Party Name :</td>
								  <td colspan="2">
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>

									<td colspan="1" style="text-align: center;">
									<img t-if="qrcode" t-att-src="'data:image/png;base64,'+str(qrcode)" style="width: 75px; height: 70px;"/>
									</td>
								
							</tr>
							<tr>
								<td style="width:25%;">Samples Description :-</td>
								<td style="width:25%;"><span t-field="o.material.lab_name"/></td>

								<td style="width:20%;">Customer's Ref. No :-</td>
								<td style="width:20%;"><span t-field="o.srf_id.client_refrence"/></td>
							</tr>

							<tr>
								<!-- <td>Quantity of Samples :-</td>
								<td>Litre</td> -->
								<td>No. of Samples :-</td>
								<td><span t-field="o.sample_id.quantity"/></td>

								<td>Letter Date :-</td>
								<td>
									
								</td>
							</tr>

							<tr>
								<td>Date of Samples Received :-</td>
								<td>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>

									<td>SRF No. :-</td>
										<td >
											<span t-field="o.srf_id"/>
										</td>
								
							</tr>

							<tr>
								<td>Brand &amp; Grade :-</td>
								<td><span t-field="o.sample_id.grade_id.grade"/></td>

								<td>Date of Test Initiation  :-</td>
								<td>
									<span t-field="o.start_date"/>
								</td>
							</tr>

							<tr>
								<td>Week No. :-</td>
								<td></td>

								<td>Date of Test Completion  :-</td>
								<td>
									<span t-field="o.end_date"/>
								</td>
							</tr>

							<!-- <tr>
								<td t-if="o.material.source_sample">Source of Sample :-</td>
								<td><span t-field="o.material.source_sample"/></td>

								<td t-if="o.material.test_method_adopted" >Test method adopted  :-</td>
								<td>
									<span t-field="o.material.test_method_adopted"/>
								</td>
							</tr> -->

							<tr t-if="o.material.test_method_adopted" >
								

									<td >Test method adopted:</td>
									<td colspan="3"><span t-field="o.material.test_method_adopted"/></td>

							
							</tr>
							<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td colspan="3"><span t-field="o.material.source_sample"/></td>
								</tr>

						</table>
					</div>

					<div style="text-align:center;">
						<h4 class="mb-0" style="text-decoration: underline;">Results</h4>
					</div>
						
					
					<div>
						<table class="table table-bordered" style="width:100%; text-align:center;">
							<thead>
								<tr>
									<th>Description</th>
									<th style="text-align: center;">Dimensions</th>
									<th colspan="3">Requirements <span t-field="eln.material.test_method_adopted"></span></th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Length (mm)</td>
									<td style="text-align: center;" t-esc="brick.length_in_mm"/>
									<td rowspan="3" style="text-align: center; vertical-align: middle;"><span t-field="eln.material.test_method_adopted"></span></td>
									<td rowspan="3" style="text-align: center; vertical-align: middle;">20 No's</td>
									<td>4600±80mm</td>
								</tr>
								<tr>
									<td>Breadth (mm)</td>
									<td style="text-align: center;" t-esc="brick.width_in_mm"/>
									<td>2200±40mm</td>
								</tr>
								<tr>
									<td>Height (mm)</td>
									<td style="text-align: center;" t-esc="brick.height_in_mm"/>
									<td>1400±40mm</td>
								</tr>
							</tbody>
						</table>
						<!-- 1 Compressive strength  -->
						<table class="table table-bordered" style="width: 100%; text-align: center; border: 1px solid black; border-collapse: collapse;">
							<thead>
								<tr>
									<th rowspan="2" style="border: 1px solid black; text-align: center; vertical-align: middle;">S.No</th>
									<th colspan="3" style="border: 1px solid black; text-align: center; vertical-align: middle;">Dimensions<br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','125478bvf3-8d5d-4f45-8afb-b911f9cafe41')]).test_method.test_method"/>
										</th>
									<th rowspan="2" style="border: 1px solid black; text-align: center; vertical-align: middle;">Compressive Strength,
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).unit.name"/><br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')]).test_method.test_method"/>
									</th>
									<th rowspan="2" style="border: 1px solid black; text-align: center; vertical-align: middle;">Water Absorption, 
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).unit.name"/><br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')]).test_method.test_method"/>
									</th>
									<th rowspan="2" style="border: 1px solid black; text-align: center; vertical-align: middle;">Efflorescence<br/>
										<span t-field="env['lerm.parameter.master'].search([('internal_id','=','3214598fgrt-d27d-4ef9-9b27-e8eb4e7ae6ac')]).test_method.test_method"/>
									</th>
								</tr>
								<tr>
									<th style="border: 1px solid black; text-align: center;">Length</th>
									<th style="border: 1px solid black; text-align: center;">Breadth</th>
									<th style="border: 1px solid black; text-align: center;">Height</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td style="border: 1px solid black; text-align: center;">1</td>
									<td t-esc="brick.length" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.width" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.height" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.comp_strength_1" t-options='{"widget": "float", "precision": 2}' style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.water_absorption" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.visual_observation_1" style="border: 1px solid black; text-align: center;"/>
								</tr>
								<tr>
									<td style="border: 1px solid black; text-align: center;">2</td>
									<td t-esc="brick.length_2" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.width_2" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.height_2" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.comp_strength_2" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.water_absorption_2" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.visual_observation_2" style="border: 1px solid black; text-align: center;"/>
								</tr>
								<tr>
									<td style="border: 1px solid black; text-align: center;">3</td>
									<td t-esc="brick.length_3" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.width_3" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.height_3" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.comp_strength_3" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.water_absorption_3" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.visual_observation_3" style="border: 1px solid black; text-align: center;"/>
								</tr>
								<tr>
									<td style="border: 1px solid black; text-align: center;">4</td>
									<td t-esc="brick.length_4" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.width_4" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.height_4" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.comp_strength_4" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.water_absorption_4" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.visual_observation_4" style="border: 1px solid black; text-align: center;"/>
								</tr>
								<tr>
									<td style="border: 1px solid black; text-align: center;">5</td>
									<td t-esc="brick.length_5" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.width_5" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.height_5" style="border: 1px solid black; text-align: center;"/>
									<td t-esc="brick.comp_strength_5" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.water_absorption_5" style="border: 1px solid black; text-align: center;" t-options='{"widget": "float", "precision": 2}'/>
									<td t-esc="brick.visual_observation_5" style="border: 1px solid black; text-align: center;"/>
								</tr>
							</tbody>
						</table>
					</div>







					<div style="text-align:center;margin-top:2px">
						......End of Report......
					</div>
							


					<div style="margin-top:5px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<table class="table table-bordered">
						<tr>
							<td style="padding: 5px; font-style: italic; font-size: 12px;">
								
								<!-- <t t-if="cement.notes_id">
									<t t-foreach="cement.notes_id" t-as="n">
										<div>
											&#160;&#160;(<t t-esc="n.sr_no"/>) 
											<t t-esc="n.notes"/>
										</div>
									</t>
								</t> -->
								<t t-if="cement.notes_id">
									<b>Conditions:-</b>

									<t t-foreach="cement.notes_id" t-as="n">
										<span>
											(<t t-esc="n.sr_no"/>) 
											<t t-esc="n.notes"/>
											&#160;&#160;
										</span>
									</t>
								</t>
							
								<t t-if="eln.has_witness">
									&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
								</t>
								<t t-if="eln.remarks">
									&#160;&#160;<span t-esc="eln.remarks"/>
								</t>
							
							</td>
						</tr>
					</table>
					</div>


					
						 <!-- Remarks Section -->

                    






					<div class="signatureContainer girdgird">
						<div>
							<div>
								<b>
									Checked By
								</b>
							</div>
							<div style="height:30px">

							</div>
							<div>
								<b>
									<span t-esc="eln.technician.name"/>
								</b>
							</div>
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>

						<!-- QR Code -->
							<div style="text-align:center; margin-bottom:10px;">
								<img t-att-src="'data:image/png;base64,%s' % (qrcode_static or '')"
									style="width:75px; height:70px;"/>
							</div>

						<div>

						<div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div>
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
						<div>
							<div>
								<b>
									Approved By 
								</b>
								
							</div>
							<div style="height:30px">

							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>
						
							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							
							<!-- <div>
								<b>
									(Authorized Signatory)
								</b>
							</div> -->
						</div>
					</div>

	</t>
</t>

</template>

</odoo>