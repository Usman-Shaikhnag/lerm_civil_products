									<th rowspan="2" style="border: 1px solid black; text-align: center;">Compressive Strength, N/mm²<br/>IS 3495 (Part-1): 2016 RA 2019</th>
									<th rowspan="2" style="border: 1px solid black; text-align: center;">Water Absorption, %<br/>IS 3495 (Part-2): 2016 RA 2019</th>
									<th rowspan="2" style="border: 1px solid black; text-align: center;">Efflorescence<br/>IS 3495 (Part-3): 2016 RA 2019</th>
								</tr>
								<tr>
									<th style="border: 1px solid black; text-align: center;">Length</th>
									<th style="border: 1px solid black; text-align: center;">Breadth</th>
									<th style="border: 1px solid black; text-align: center;">Height</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td style="border: 1px solid black; text-align: center;">1</td>
