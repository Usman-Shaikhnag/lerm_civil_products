<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_brick_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->

			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>TEST REPORT</b></p>
				</div> -->


				<div class="container_eln">
					
					<div t-foreach="eln" t-as="o">
						<!-- <table>
							<tr>
								<td colspan="3">Report no :
								</td>
								<td colspan="3">
									<span t-field="o.kes_no"/>
								</td>
								<td colspan="3">Report Date :
								<span t-field="o.end_date"/>
								</td>
								<td colspan="3">
									<span t-field="o.srf_date"/>
								</td>
								<td colspan="3" t-if="nabl">ULR NO :
								</td>
								<td colspan="3" t-if="nabl">
									<span t-field="o.sample_id.ulr_no"/>
								</td>
							</tr>
						</table> -->
						<table style="margin-top:10px; width: 100%;">
							<tbody>
								<tr>
									<td colspan="12">
										<strong>Customer Party Name:</strong>
										<span t-field="o.srf_id.customer.name"/>
										<br/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
									</td>
								</tr>

								<tr>
									<td colspan="12">
										<strong>Project / Site Address:</strong>
										<span t-field="o.srf_id.name_work"/>
									</td>
								</tr>

								<tr>
									<td colspan="12">
										<strong>Sample Description:</strong>
										<span t-field="o.sample_id.sample_description"/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="width: 100%; margin-top:10px;">
							<tbody>
								<tr>
									<td colspan="6">
										<strong>Test Start Date:</strong>
										<span t-field="o.start_date"/>
									</td>
									<td colspan="6">
										<strong>Test End Date:</strong>
										<span t-field="o.end_date"/>
									</td>
								</tr>
								<tr>
									<td colspan="6">
										<strong>Sample Id Mark:</strong>
										<span t-field="o.sample_id.client_sample_id"/>
									</td>
									<td colspan="6">
										<strong>Sample Receipt Date:</strong>
										<span t-field="o.sample_id.sample_received_date"/>
									</td>
								</tr>
								<tr>
									<td colspan="6">
										<strong>Size:</strong>
										<span t-field="o.sample_id.size_id.size"/>
									</td>
									<td colspan="6">
										<strong>Grade:</strong>
										<span t-field="o.sample_id.grade_id.grade"/>
									</td>
								</tr>
								<tr>
									<td colspan="6">
										<strong>Brand:</strong>
										<span t-field="o.sample_id.brand"/>
									</td>
									<td colspan="6">
										<strong>Consultant Name:</strong>
										<span t-field="o.srf_id.consultant_name1"/>
									</td>
								</tr>
								<tr>
									<td colspan="6">
										<strong>Client Name:</strong>
										<span t-field="o.srf_id.client"/>
									</td>
									<td colspan="6">
										<strong>Client Reference:</strong>
										<span t-field="o.srf_id.client_refrence"/>
									</td>
								</tr>
								<tr>
									<td colspan="6">
										<strong>Discipline:</strong>
										<span t-field="o.discipline.discipline"/>
									</td>
									<td colspan="6">
										<strong>Group:</strong>
										<span t-field="o.group.group"/>
									</td>
								</tr>
								<tr>
									<td colspan="12">
										<strong>Material/Test Name:</strong>
										<span t-field="o.material.name"/>
									</td>
								</tr>
							</tbody>
						</table>
					</div>

					<table class="table table-sm table-bordered" style="width:100%; text-align:center;">
						<thead>
							<tr>
								<th>Description</th>
								<th>Dimensions</th>
								<th colspan="2">Requirements as per IS 1077 :1992</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Length (mm)</td>
								<td t-esc="brick.length_in_mm"/>
								<td rowspan="3">IS 1077-1992</td>
								<td rowspan="3">20 No's</td>
								<td>4600±80mm</td>
							</tr>
							<tr>
								<td>Breadth (mm)</td>
								<td t-esc="brick.width_in_mm"/>
								<td>2200±40mm</td>
							</tr>
							<tr>
								<td>Height (mm)</td>
								<td t-esc="brick.height_in_mm"/>
								<td>1400±40mm</td>
							</tr>
						</tbody>
					</table>

					<!-- 1 Compressive strength  -->

					<table class="table table-bordered" style="width: 100%; text-align: center; border: 1px solid black; border-collapse: collapse;">
						<thead>
							<tr>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">S.No</th>
								<th colspan="3" style="border: 1px solid black; text-align: center;">Dimensions<br/>IS 1077 - 1992 RA 2016</th>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">Compressive Strength, N/mm²<br/>IS 3495 (Part-1): 2016 RA 2019</th>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">Water Absorption, %<br/>IS 3495 (Part-2): 2016 RA 2019</th>
								<th rowspan="2" style="border: 1px solid black; text-align: center;">Efflorescence<br/>IS 3495 (Part-3): 2016 RA 2019</th>
							</tr>
							<tr>
								<th style="border: 1px solid black;">Length</th>
								<th style="border: 1px solid black;">Breadth</th>
								<th style="border: 1px solid black;">Height</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td style="border: 1px solid black;">1</td>
								<td t-esc="brick.length" style="border: 1px solid black;"/>
								<td t-esc="brick.width" style="border: 1px solid black;"/>
								<td t-esc="brick.height" style="border: 1px solid black;"/>
								<td t-esc="brick.comp_strength_1" style="border: 1px solid black;"/>
								<td t-esc="brick.water_absorption" style="border: 1px solid black;"/>
								<td t-esc="brick.visual_observation_1" style="border: 1px solid black;"/>
							</tr>
							<tr>
								<td style="border: 1px solid black;">2</td>
								<td t-esc="brick.length_2" style="border: 1px solid black;"/>
								<td t-esc="brick.width_2" style="border: 1px solid black;"/>
								<td t-esc="brick.height_2" style="border: 1px solid black;"/>
								<td t-esc="brick.comp_strength_2" style="border: 1px solid black;"/>
								<td t-esc="brick.water_absorption_2" style="border: 1px solid black;"/>
								<td t-esc="brick.visual_observation_2" style="border: 1px solid black;"/>
							</tr>
							<tr>
								<td style="border: 1px solid black;">3</td>
								<td t-esc="brick.length_3" style="border: 1px solid black;"/>
								<td t-esc="brick.width_3" style="border: 1px solid black;"/>
								<td t-esc="brick.height_3" style="border: 1px solid black;"/>
								<td t-esc="brick.comp_strength_3" style="border: 1px solid black;"/>
								<td t-esc="brick.water_absorption_3" style="border: 1px solid black;"/>
								<td t-esc="brick.visual_observation_3" style="border: 1px solid black;"/>
							</tr>
							<tr>
								<td style="border: 1px solid black;">4</td>
								<td t-esc="brick.length_4" style="border: 1px solid black;"/>
								<td t-esc="brick.width_4" style="border: 1px solid black;"/>
								<td t-esc="brick.height_4" style="border: 1px solid black;"/>
								<td t-esc="brick.comp_strength_4" style="border: 1px solid black;"/>
								<td t-esc="brick.water_absorption_4" style="border: 1px solid black;"/>
								<td t-esc="brick.visual_observation_4" style="border: 1px solid black;"/>
							</tr>
							<tr>
								<td style="border: 1px solid black;">5</td>
								<td t-esc="brick.length_5" style="border: 1px solid black;"/>
								<td t-esc="brick.width_5" style="border: 1px solid black;"/>
								<td t-esc="brick.height_5" style="border: 1px solid black;"/>
								<td t-esc="brick.comp_strength_5" style="border: 1px solid black;"/>
								<td t-esc="brick.water_absorption_5" style="border: 1px solid black;"/>
								<td t-esc="brick.visual_observation_5" style="border: 1px solid black;"/>
							</tr>
						</tbody>
					</table>

					<div style="margin-top:20px; page-break-inside: avoid;" class="noteContainer">
						<div>
							<b>Remarks: -</b>
						</div>
						<div>
							<ul>
								<li>
								The Test Report(s) is/are valid only to the sample submitted to the laboratory.
								</li>
								<li>
								Sample(s) was/were not drawn by laboratory.
								</li>
								<li>
								This Report may not be reproduced in except full/ part without the permission of the Lab Head of the Laboratory.
								</li>

								<li t-if="eln.has_witness">
										Test witnessed by : <span t-esc="eln.witness_name"/>
										
									</li>
									<li t-if="eln.remarks">
										<span t-esc="eln.remarks"/>
									</li>
							</ul>
						</div>
					</div>

					<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
								<b>
								Checked By
								</b>
							</div>
							<div style="height:30px">

							</div>

							<div>
								<b>
									<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>

							<div>
								<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
						<div>
							<div>
								<img t-attf-src="/lerm_civil/static/src/img/stamp.png" alt="Image"/>
							</div>
							<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
							</div>
						</div>
						<div>
							<div>
								<b>
										Approved By
								</b>
							</div>
							<div style="height:20px">

							</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							<div>
								<b>
										(Authorized Signatory)
								</b>
							</div>
						</div>
					</div>
					
				<!-- </div> -->
			</div>

			<div style="margin-top: 10px; text-align: center;">
				<p style="border-top: 1px dashed #000; padding-top: 10px;">
						...... End Of Report......
				</p>
			</div>
		<!-- </div> -->

	</t>
</t>

</template>

</odoo>