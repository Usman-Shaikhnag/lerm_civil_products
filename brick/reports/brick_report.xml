<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="lerm_brick_report">
		<t t-call="web.html_container">
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">NA</t>
								</td>

                                <!-- <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td> -->
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">NA</t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <!-- <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td> -->
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.sample_description">
									       <span t-field="o.sample_id.sample_description"/> 
										</t>
									<t t-else="">NA</t>
								</td>


                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.sample_id.source_of_sample">
											<span t-field="o.sample_id.source_of_sample"/>
										</t>
									<t t-else="">NA</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											
											<span t-field="o.start_date" t-options='{"widget": "date"}'/>
											<span style="display:inline-block; padding:0 3px;">to</span>
											<span t-field="o.end_date" t-options='{"widget": "date"}'/>
										</t>
									<t t-else="">NA</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.sample_condition">
											<span t-field="o.sample_id.sample_condition"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="3">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<!-- <td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">NA</t>
										</td> -->
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<t t-if="data.brick_temperature is not None">
											<span t-field="data.brick_temperature"/>   <span style="vertical-align: baseline;"> °C</span>
										</t>
									<t t-else="">NA</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="data.brick_humidity is not None">
											<span t-field="data.brick_humidity"/>   <span style="vertical-align: baseline;"> %</span>
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">NA</t>
								</td>
								
							</tr>

							</table>
					</div>

					<div style="">
						<table style="margin-top:10px;">
						<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">Sr. No</th>
									<th style="text-align: center;">
									<span t-esc="eln.material.test_parameter"/>
									<!-- Test Parameter -->
									</th>

                                    <th style="text-align: center;">
									<span t-esc="eln.material.result_remark"/>
									<!-- Test Result -->
									</th>

									<th style="text-align: center;">
									<span t-esc="eln.material.unit"/>
									<!-- Unit -->
									</th>

                                    <th style="text-align: center;"><span t-esc="eln.material.specifications"/></th>

									<th style="text-align: center;"><span t-esc="eln.material.method_reference"/></th>
									
								</tr>
							</thead>
							<tbody>

							<!-- Dimension -->
                            <t t-set="show_length" t-value="data.avg_length_final_report == 'nabl' and nabl or data.avg_length_final_report == 'non_nabl' and not nabl"/>

                            <t t-set="show_width" t-value="data.avg_width_final_report == 'nabl' and nabl or data.avg_width_final_report == 'non_nabl' and not nabl"/>

							<t t-set="show_thickness" t-value="data.avrg_height_final_report == 'nabl' and nabl or data.avrg_height_final_report == 'non_nabl' and not nabl"/>

                            <!-- 🔹 Step 2: Rowspan calculation -->
					      <t t-set="rowspan_count" t-value="1 + int(show_length) + int(show_width)+ int(show_thickness)"/>

                          <tr t-if="data.dimension_visible  and (show_length or show_width or show_thickness)">

									<t t-set="bulk" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','125478bvf3-8d5d-4f45-8afb-b911f9cafe41')])"/>
									
									<td t-att-rowspan="rowspan_count"  style="text-align: center;vertical-align:middle;">
						                 <span t-esc="i + 1"/>
							             <t t-set="i" t-value="i+1"/>
						            </td>
									<td colspan="5">
										<span t-esc="bulk.parameter_name"/>
									</td>
								</tr>

					
							 <!-- Length -->
                             <tr t-if="data.dimension_visible and show_length">
									<t t-set="length" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','50e5bbcc-df2c-4fa9-8360-d0567d753361')])"/>
									
									<td>
										<span t-esc="length.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avrg_length" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="length.unit.name"/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<t t-foreach="length.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="length.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Width -->
							<tr t-if="data.dimension_visible and show_width">
									<t t-set="width" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','62fd063f-251a-4ab3-9025-d90755deb02e')])"/>
									
									<td>
										<span t-esc="width.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avrg_width" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="width.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="width.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="width.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Thickness -->
							<tr t-if="data.dimension_visible and show_thickness">
									<t t-set="thickness" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','5d967f0e-21de-4c17-9f98-8202f3133ccb')])"/>
									
									<td>
										<span t-esc="thickness.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avrg_height" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="thickness.unit.name"/>
										</span>
									</td>
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="thickness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="thickness.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- Water Absorption -->
								<tr t-if="data.water_absorbtion_visible and (data.water_absorption_final_report == 'nabl' and nabl or data.water_absorption_final_report == 'non_nabl' and not nabl)">
									<t t-set="water_absorption" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','321475gfet1-f3ab-4b19-af25-91a4671baf5f')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="water_absorption.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="water_absorption.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="water_absorption.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="water_absorption.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- Compressive Strength  -->
								<tr t-if="data.compressive_strength_visible and (data.comp_strength_final_report == 'nabl' and nabl or data.comp_strength_final_report == 'non_nabl' and not nabl)">
									<t t-set="compressive" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','31478fghht-9287-48c7-a607-bf1b64a8115d')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="compressive.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="compressive.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="compressive.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="compressive.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>



								<!-- Efflorescence  -->

								<t t-if="data.efflorescence_visible and ((data.report_type == 'nabl' and nabl) or (data.report_type == 'non_nabl' and not nabl))">


								<tr t-if="data.efflorescence_visible">
									<t t-set="efflorescence" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','3214598fgrt-d27d-4ef9-9b27-e8eb4e7ae6ac')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="efflorescence.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<!-- <span t-field="data.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/> -->
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="efflorescence.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="efflorescence.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="efflorescence.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								</t>


					
						

					
                    
					</tbody>
					
					</table>

					</div>



						

					 <div style="margin-top:50px" class="noteContainer">
						<table >
							<tr>
							
								<td style="padding: 5px; font-style: italic; ">

									<b>Notes:-</b>
										<t t-if="data.notes_id">
										<t t-foreach="data.notes_id" t-as="n">
											<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
										</t>
									</t>
								</td>
							</tr>
							</table>
						</div>

					<div style="margin-top:20px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
								<b>
								Checked By
								</b>
							</div>
							<div style="height:40px">

							</div>

							<div>
								<b>
									<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>

						<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>

						<div>
							<div>
								<b>
									Approved By
								</b>
							</div>
							<div style="height:40px">

							</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
							
						</div>
					</div>
					
				

				



				
			</div>

			<div style="margin-top: 10px; text-align: center;">
				<p style="padding-top: 10px;">
						...... End Of Report......
				</p>
			</div>
		<!-- </div> -->

	</t>
</t>

</template>

</odoo>