<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_brick_test_view" model="ir.ui.view">
        <field name="name">mechanical.bricks.form</field>
        <field name="model">mechanical.bricks</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>

                      <field name="srf_id" invisible="1"/>
                      <field name="sample_id"  readonly="1"/>
                      <field name="eln_ref" readonly="1"/>
                      <field name="parameter_id" invisible="1"/>
                      <field name="sample_parameters" class="custom_table_borders">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    <!-- <group>
                      <field name="test_start_date"/>
                      <field name="test_end_date"/>
                    </group> -->

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                    <!-- Dimension -->

                    <table class="table o_form_table custom_table_borders">
                        <thead>
                            <tr>
                                <th></th>
                                <th style="text-align: center;">L</th>
                                <th style="text-align: center;">B</th>
                                <th style="text-align: center;">H</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Size of the Brick :- (mm)</td>
                                <td style="text-align: center;"><field name="length_in_mm" nolabel="1" class="blue-input"/></td>
                                <td style="text-align: center;"><field name="width_in_mm" nolabel="1" class="blue-input"/></td>
                                <td style="text-align: center;"><field name="height_in_mm" nolabel="1" class="blue-input"/></td>
                            </tr>
                        </tbody>
                    </table>
                        <!-- compressive Strength -->

                    <div invisible="compressive_strength_visible == False" style="text-align:center">
                      <h1>
                          <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                          <field name="compressive_strength_visible" invisible='1'/>
                      </h1>
                    </div>
                    
                     <!-- <group invisible="compressive_strength_visible == False"> -->
                    <div invisible="compressive_strength_visible == False" class="mb-3">
                        <table class="table custom_table_borders o_form_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Sample 1</th>
                                    <th>Sample 2</th>
                                    <th>Sample 3</th>
                                    <th>Sample 4</th>
                                    <th>Sample 5</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Length (mm)</strong></td>
                                    <td><field name="length" nolabel="1" class="blue-input"/></td>
                                    <td><field name="length_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="length_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="length_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="length_5" nolabel="1" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Width (mm)</strong></td>
                                    <td><field name="width" nolabel="1" class="blue-input"/></td>
                                    <td><field name="width_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="width_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="width_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="width_5" nolabel="1" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Height (mm)</strong></td>
                                    <td><field name="height" nolabel="1" class="blue-input"/></td>
                                    <td><field name="height_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="height_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="height_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="height_5" nolabel="1" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Area (mm²)</strong></td>
                                    <td><field name="area" nolabel="1"/></td>
                                    <td><field name="area_2" nolabel="1"/></td>
                                    <td><field name="area_3" nolabel="1"/></td>
                                    <td><field name="area_4" nolabel="1"/></td>
                                    <td><field name="area_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Load (Kn)</strong></td>
                                    <td><field name="load" nolabel="1" class="blue-input"/></td>
                                    <td><field name="load_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="load_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="load_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="load_5" nolabel="1" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Compressive Strength (MPa)</strong></td>
                                    <td><field name="comp_strength_1" nolabel="1"/></td>
                                    <td><field name="comp_strength_2" nolabel="1"/></td>
                                    <td><field name="comp_strength_3" nolabel="1"/></td>
                                    <td><field name="comp_strength_4" nolabel="1"/></td>
                                    <td><field name="comp_strength_5" nolabel="1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not compressive_strength_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Compressive Strength</strong></td>
                                <td>
                                    <field name="avrg_compressive_strength"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Compressive Strength Conformity</strong></td>
                                <td>
                                    <field name="comp_strength_confirmity"
                                        decoration-success="comp_strength_confirmity == 'pass'"
                                        decoration-danger="comp_strength_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong for="comp_strength_nabl">Compressive Strength NABL</strong></td>
                                <td>
                                    <field name="comp_strength_nabl"
                                        decoration-success="comp_strength_nabl == 'pass'"
                                        decoration-danger="comp_strength_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                

                    <!-- Water Absorbtion -->                      
                    <div invisible="water_absorbtion_visible == False" style="text-align:center">
                        <h1>
                          <field name="wt_absorption_name" readonly="1" nolabel="1"/>
                          <field name="water_absorbtion_visible" invisible='1'/>
                        </h1>
                    </div>
                                    
                    <div invisible="water_absorbtion_visible == False" class="mb-3">
                      <table class="table custom_table_borders o_form_table">
                          <thead>
                              <tr>
                                  <th></th>
                                  <th>Sample 1</th>
                                  <th>Sample 2</th>
                                  <th>Sample 3</th>
                                  <th>Sample 4</th>
                                  <th>Sample 5</th>
                              </tr>
                          </thead>
                          <tbody>
                                <tr>
                                    <td><strong>Dry wt (W1)</strong></td>
                                    <td><field name="initial_wt" nolabel="1" class="blue-input"/></td>
                                    <td><field name="initial_wt_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="initial_wt_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="initial_wt_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="initial_wt_5" nolabel="1" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Wet wt (W2)</strong></td>
                                    <td><field name="final_wt" nolabel="1" class="blue-input"/></td>
                                    <td><field name="final_wt_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="final_wt_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="final_wt_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="final_wt_5" nolabel="1" class="blue-input"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Water Absorption %</strong></td>
                                    <td><field name="water_absorption" nolabel="1"/></td>
                                    <td><field name="water_absorption_2" nolabel="1"/></td>
                                    <td><field name="water_absorption_3" nolabel="1"/></td>
                                    <td><field name="water_absorption_4" nolabel="1"/></td>
                                    <td><field name="water_absorption_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Observation</strong></td>
                                    <td><field name="visual_observation_1" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_2" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_3" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_4" nolabel="1" class="blue-input"/></td>
                                    <td><field name="visual_observation_5" nolabel="1" class="blue-input"/></td>
                                </tr>
                          </tbody>
                      </table>
                    </div>

                    
                    
                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_absorbtion_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Water Absorption</strong></td>
                                <td>
                                    <field name="avrg_water_absorption"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Water Absorption Conformity</strong></td>
                                <td>
                                    <field name="water_absorption_confirmity"
                                        decoration-success="water_absorption_confirmity == 'pass'"
                                        decoration-danger="water_absorption_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Water Absorption NABL</strong></td>
                                <td>
                                    <field name="water_absorption_nabl"
                                        decoration-success="water_absorption_nabl == 'pass'"
                                        decoration-danger="water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <!--  -->

                     <div invisible="ini_rate_absorption_visible == False" style="text-align:center">
                      <h1>
                          <field name="ini_rate_absorption_name" readonly="1" nolabel="1"/>
                          <field name="ini_rate_absorption_visible" invisible='1'/>
                      </h1>
                    </div>
                    
                   
                     <div invisible = "ini_rate_absorption_visible == False"  >
                    <field name="absorption_line_ids" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no" />
                                <field name="iW1" class="blue-input" decoration-info="iW1 != 0"/>
                                <field name='W2' class="blue-input" decoration-info="W2 != 0"/>
                                <field name='W2_W1'/>
                                <field name='area'/>
                                <field name='initial_rate_absorp' />
                                
                            </tree>
                    </field>
                    </div>

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not ini_rate_absorption_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Initial Rate of Absorption (g/min/100 cm²)</strong></td>
                                <td>
                                    <field name="average_ira" readonly="1" nolabel="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                  <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>

        <record id="view_bricks_prefill_data_form" model="ir.ui.view">
            <field name="name">bricks.prefill.data.form</field>
            <field name="model">bricks.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_bricks_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bricks.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_bricks_prefill_data_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>