<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_brick_test_view" model="ir.ui.view">
        <field name="name">mechanical.bricks.form</field>
        <field name="model">mechanical.bricks</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>

                      <field name="srf_id" invisible="1"/>
                      <field name="sample_id"  readonly="1"/>
                      <field name="eln_ref" readonly="1"/>
                      <field name="parameter_id" invisible="1"/>
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    <!-- <group>
                      <field name="test_start_date"/>
                      <field name="test_end_date"/>
                    </group> -->

                    <table class="table table-sm table-bordered o_form_table">
                        <thead>
                            <tr>
                                <td></td>
                                <th style="text-align: center;">L</th>
                                <th style="text-align: center;">B</th>
                                <th style="text-align: center;">H</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>Size of the Brick :- (mm)</th>
                                <td style="text-align: center;"><field name="length_in_mm" nolabel="1"/></td>
                                <td style="text-align: center;"><field name="width_in_mm" nolabel="1"/></td>
                                <td style="text-align: center;"><field name="height_in_mm" nolabel="1"/></td>
                            </tr>
                        </tbody>
                    </table>
                        <!-- compressive Strength -->

                    <div invisible="compressive_strength_visible == False" style="text-align:center">
                      <h1>
                          <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                          <field name="compressive_strength_visible" invisible='1'/>
                      </h1>
                    </div>
                    
                     <!-- <group invisible="compressive_strength_visible == False"> -->
                      <div invisible="compressive_strength_visible == False" class="mb-3">
                        <table class="table table-sm table-bordered o_form_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Sample 1</th>
                                    <th>Sample 2</th>
                                    <th>Sample 3</th>
                                    <th>Sample 4</th>
                                    <th>Sample 5</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Length (mm)</strong></td>
                                    <td><field name="length" nolabel="1"/></td>
                                    <td><field name="length_2" nolabel="1"/></td>
                                    <td><field name="length_3" nolabel="1"/></td>
                                    <td><field name="length_4" nolabel="1"/></td>
                                    <td><field name="length_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Width (mm)</strong></td>
                                    <td><field name="width" nolabel="1"/></td>
                                    <td><field name="width_2" nolabel="1"/></td>
                                    <td><field name="width_3" nolabel="1"/></td>
                                    <td><field name="width_4" nolabel="1"/></td>
                                    <td><field name="width_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Height (mm)</strong></td>
                                    <td><field name="height" nolabel="1"/></td>
                                    <td><field name="height_2" nolabel="1"/></td>
                                    <td><field name="height_3" nolabel="1"/></td>
                                    <td><field name="height_4" nolabel="1"/></td>
                                    <td><field name="height_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Area (mm²)</strong></td>
                                    <td><field name="area" nolabel="1"/></td>
                                    <td><field name="area_2" nolabel="1"/></td>
                                    <td><field name="area_3" nolabel="1"/></td>
                                    <td><field name="area_4" nolabel="1"/></td>
                                    <td><field name="area_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Load (Kn)</strong></td>
                                    <td><field name="load" nolabel="1"/></td>
                                    <td><field name="load_2" nolabel="1"/></td>
                                    <td><field name="load_3" nolabel="1"/></td>
                                    <td><field name="load_4" nolabel="1"/></td>
                                    <td><field name="load_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Load (n)</strong></td>
                                    <td><field name="load_Kn" nolabel="1"/></td>
                                    <td><field name="load_Kn_2" nolabel="1"/></td>
                                    <td><field name="load_Kn_3" nolabel="1"/></td>
                                    <td><field name="load_Kn_4" nolabel="1"/></td>
                                    <td><field name="load_Kn_5" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Compressive Strength (MPa)</strong></td>
                                    <td><field name="comp_strength_1" nolabel="1"/></td>
                                    <td><field name="comp_strength_2" nolabel="1"/></td>
                                    <td><field name="comp_strength_3" nolabel="1"/></td>
                                    <td><field name="comp_strength_4" nolabel="1"/></td>
                                    <td><field name="comp_strength_5" nolabel="1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <group  invisible="compressive_strength_visible == False">
                      <field name="avrg_compressive_strength"/>
                      <field name="comp_strength_confirmity"
                            decoration-success="comp_strength_confirmity == 'pass'" 
                            decoration-danger="comp_strength_confirmity == 'fail'" 
                            readonly="1"
                      />
                      <field name="comp_strength_nabl"
                            decoration-success="comp_strength_nabl == 'pass'" 
                            decoration-danger="comp_strength_nabl == 'fail'" 
                            readonly="1"
                            />
                    </group>
                    

                    <!-- visual_observation -->
                    <div invisible="efflorescence_visible == False" style="text-align:center">
                        <h1>
                            <field name="visual_observation_name_efflorescence" readonly="1" nolabel="1"/>
                            <field name="efflorescence_visible" invisible='1'/>
                        </h1>
                    </div>

                    <div invisible="efflorescence_visible == False" class="mb-3">
                        <table class="table table-sm table-bordered o_form_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Observation 1</th>
                                    <th>Observation 2</th>
                                    <th>Observation 3</th>
                                    <th>Observation 4</th>
                                    <th>Observation 5</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Observation</strong></td>
                                    <td><field name="visual_observation_1" nolabel="1"/></td>
                                    <td><field name="visual_observation_2" nolabel="1"/></td>
                                    <td><field name="visual_observation_3" nolabel="1"/></td>
                                    <td><field name="visual_observation_4" nolabel="1"/></td>
                                    <td><field name="visual_observation_5" nolabel="1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!--Dimension -->

                    <div invisible="dimension_visible == False" style="text-align:center">
                        <h1>
                          <field name="dimension_name1" readonly="1" nolabel="1"/>
                          20 Bricks
                        </h1>
                        <field name="dimension_visible" invisible='1'/>
                    </div>

                    <div invisible="dimension_visible == False" class="mb-3">
                        <table class="table table-sm table-bordered o_form_table">
                            <thead>
                                <tr>
                                    <th>Dimension Type</th>
                                    <th>Value (mm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Length</strong></td>
                                    <td><field name="avrg_length" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Width</strong></td>
                                    <td><field name="avrg_width" nolabel="1"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Height</strong></td>
                                    <td><field name="avrg_height" nolabel="1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Water Absorbtion -->                      
                    <div invisible="water_absorbtion_visible == False" style="text-align:center">
                        <h1>
                          <field name="wt_absorption_name" readonly="1" nolabel="1"/>
                          <field name="water_absorbtion_visible" invisible='1'/>
                        </h1>
                    </div>
                                    
                    <div invisible="water_absorbtion_visible == False" class="mb-3">
                      <table class="table table-sm table-bordered o_form_table">
                          <thead>
                              <tr>
                                  <th></th>
                                  <th>Sample 1</th>
                                  <th>Sample 2</th>
                                  <th>Sample 3</th>
                                  <th>Sample 4</th>
                                  <th>Sample 5</th>
                              </tr>
                          </thead>
                          <tbody>
                              <tr>
                                  <td><strong>Dry wt (W1)</strong></td>
                                  <td><field name="initial_wt" nolabel="1"/></td>
                                  <td><field name="initial_wt_2" nolabel="1"/></td>
                                  <td><field name="initial_wt_3" nolabel="1"/></td>
                                  <td><field name="initial_wt_4" nolabel="1"/></td>
                                  <td><field name="initial_wt_5" nolabel="1"/></td>
                              </tr>
                              <tr>
                                  <td><strong>Wet wt (W2)</strong></td>
                                  <td><field name="final_wt" nolabel="1"/></td>
                                  <td><field name="final_wt_2" nolabel="1"/></td>
                                  <td><field name="final_wt_3" nolabel="1"/></td>
                                  <td><field name="final_wt_4" nolabel="1"/></td>
                                  <td><field name="final_wt_5" nolabel="1"/></td>
                              </tr>
                              <tr>
                                  <td><strong>Water Absorption %</strong></td>
                                  <td><field name="water_absorption" nolabel="1"/></td>
                                  <td><field name="water_absorption_2" nolabel="1"/></td>
                                  <td><field name="water_absorption_3" nolabel="1"/></td>
                                  <td><field name="water_absorption_4" nolabel="1"/></td>
                                  <td><field name="water_absorption_5" nolabel="1"/></td>
                              </tr>
                          </tbody>
                      </table>
                  </div>

                    
                    
                  <group invisible="water_absorbtion_visible == False">
                      <field name="avrg_water_absorption"/>
                      <field name="water_absorption_confirmity"
                            decoration-success="water_absorption_confirmity == 'pass'" 
                            decoration-danger="water_absorption_confirmity == 'fail'" 
                            readonly="1"
                      />
                      <field name="water_absorption_nabl"
                            decoration-success="water_absorption_nabl == 'pass'" 
                            decoration-danger="water_absorption_nabl == 'fail'" 
                            readonly="1"
                      />
                  </group>
                  <button type="object" class="oe_highlight" name="open_eln_page" string="Submit"/>
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>