                    <div invisible = "compressive_strength_visible == False"  >
                    <field name="compressive_strength_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no" />
                                <field name="identification_mark" />
                                <field name='length'/>
                                <field name='width' />
                                <field name='height' />
                                <field name='area' />
                                <field name='load' />
                                <field name='comp_strength_1' />
                                
                            </tree>
                    </field>
                    </div>

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not compressive_strength_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Compressive Strength</strong></td>
                                <td>
                                    <field name="avrg_compressive_strength"/> <span><field name="compressive_strength_unit" readonly="1" nolabel="1"/></span>
                                  
                                
                                </td>

                            </tr>
                            <tr>
                                <td><strong>Compressive Strength Conformity</strong></td>
                                <td>
                                    <field name="comp_strength_confirmity"
                                        decoration-success="comp_strength_confirmity == 'pass'"
                                        decoration-danger="comp_strength_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong for="comp_strength_nabl">Compressive Strength NABL</strong></td>
                                <td>
                                    <field name="comp_strength_nabl"
                                        decoration-success="comp_strength_nabl == 'pass'"
                                        decoration-danger="comp_strength_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                   

