<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="action_drying_shrinkage" model="ir.actions.act_window">
           <field name="name">Drying Skrinkage</field>
           <field name="res_model">drying.shrinkage</field>
           <field name="view_mode">tree,form</field>
        </record>

        <record id="drying_shrinkage_mechanical_view" model="ir.ui.view">
        <field name="name">drying.shrinkage.form</field>
        <field name="model">drying.shrinkage</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false" >
                <sheet>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade"/>
                    </group>
                    <group>
                      <field name="sample_parameters">
                        <tree class="table-bordered o_list_view">
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        
                        </tree>
                      </field>
                    </group>

                    <!-- Drying Skrinkage Start -->
                    <div invisible = "not drying_shrinkage_visible">
                        <h1>
                            
                            <field name="drying_shrinkage_name" readonly="1" nolabel="1"/>
                            <field name="drying_shrinkage_visible" invisible="1"/>                     
                        </h1>
                    </div>
                    <group/>

                    <div invisible = "not drying_shrinkage_visible">
                       <field name="drying_child_lines" nolabel="1" >
                            <tree class="table-bordered o_list_view" editable="bottom" >
                                <field name='sr_no'/>
                                <field name='original_length'/>
                                <field name='dry_mesurment'/>
                                <field name='dry_length'/>
                                <field name='initial_drying'/>
                               
                            </tree>
                       </field> 
                    </div>

                    <div>
                          <table style="width: 20%; margin-top:10px;">
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Average</span></td>
                            <td style="padding: 5px;"><field name='average1' nolabel="1" class="oe_center" /></td>
                           </tr>
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="padding: 8px;"><field  name="drying_shrinkage_conformity"
                                           decoration-success="drying_shrinkage_conformity == 'pass'" 
                                           decoration-danger="drying_shrinkage_conformity == 'fail'" 
                                           readonly="1"/></td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"><field  name="drying_shrinkage_nabl"/></td>
                           </tr>
                     
                          </table>
                      </div>
                      <group/>

                    <!-- <group invisible = "not drying_shrinkage_visible">
                        <field name='average1'/>
                    </group>
                    <group invisible = "not drying_shrinkage_visible">
                          <group>
                            <field  name="drying_shrinkage_conformity"
                                           decoration-success="drying_shrinkage_conformity == 'pass'" 
                                           decoration-danger="drying_shrinkage_conformity == 'fail'" 
                                           readonly="1"/>
                            <field  name="drying_shrinkage_nabl"/>
                          </group>
                    </group> -->


                    <!-- Moisture Movement -->
                    <div invisible = "not moisture_movement_visible">
                        <h1>
                            <field name="moisture_movement_name" readonly="1" nolabel="1"/>
                            <field name="moisture_movement_visible" invisible="1"/>

                        </h1>
                    </div>
                    <div invisible = "not moisture_movement_visible">
                       <field name="moisture_child_lines" nolabel="1" >
                            <tree class="table-bordered o_list_view" editable="bottom">
                                <field name='sr_no'/>
                                <field name='final_wet'/>
                                <field name='moisture_movement'/>
                               
                            </tree>
                       </field> 
                    </div>

                    <div>
                          <table style="width: 20%; margin-top:10px;">
                          <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>Average</span></td>
                            <td style="padding: 5px;"><field name='average2' nolabel="1" class="oe_center" /></td>
                           </tr>
                           <tr>
                             <td style="padding: 8px;font-weight: bold;"><span>Conformity</span></td>
                              <td style="padding: 8px;"><field  name="moisture_movement_conformity"
                                           decoration-success="moisture_movement_conformity == 'pass'" 
                                           decoration-danger="moisture_movement_conformity == 'fail'" 
                                           readonly="1"/></td>
                           </tr>
                           <tr>
                            <td style="padding: 5px;font-weight: bold;"><span>NABL</span></td>
                            <td style="padding: 5px;"><field  name="moisture_movement_nabl"/></td>
                           </tr>
                     
                          </table>
                      </div>
                      <group/>

                    <!-- <group invisible = "not moisture_movement_visible">
                        <field name='average2'/>
                    </group> -->
                     <!-- <group invisible = "not moisture_movement_visible">
                          <group>
                            <field  name="moisture_movement_conformity"
                                           decoration-success="moisture_movement_conformity == 'pass'" 
                                           decoration-danger="moisture_movement_conformity == 'fail'" 
                                           readonly="1"/>
                            <field  name="moisture_movement_nabl"/>
                          </group>
                    </group> -->

                    
                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                    />

                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>