                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="sand" nolabel="1"/>
                                                </div>
                                            </td>
                                          
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 40%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                         Silt + Clay

                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="silt_clay" nolabel="1"/>
                                                </div>
                                            </td>
                                          
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 40%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                        Total

                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="total" nolabel="1"/>
                                                </div>
                                            </td>
                                          
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </group>

                    
                    
                </group>


                    
                      <group invisible = "sieve_visible == False" class="custom_table_borders">
                      <field name="graph_image_slive" widget="image" readonly="1"/>
                    </group>


                     <!-- Liquid Limit-->
