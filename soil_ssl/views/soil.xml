                            <field name="liquid_limit_name" readonly="1" nolabel="1"/>
                            <field name="liquid_limit_visible" invisible="1"/>
                        </h1>
                    </group>
                    
                 
                    <group invisible = "liquid_limit_visible == False" >
                  
                      <field name="child_liness" style="width:100%">
                       <tree editable="bottom" class="custom_table_borders">
                                <field name='serial_no' />
                                 <field name='sample_of_wet' />
                                 <field name='blwo_no1' />
                                <field name="container_no1" />
                                <field name='wt_of_con' />
                                <field name='wet_sample_con' />
                                <field name='dry_sample_con' />
                                <field name='wt_water' />
                                <field name='oven_dry_wt' />
                                  <field name='water_content' />
                                
                            </tree>
                      </field>
                 
                      
                    </group>

                      <group  invisible = "liquid_limit_visible == False" style="white-space: nowrap; width:70%;">
