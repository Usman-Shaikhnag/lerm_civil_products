<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_soil_ssl" model="ir.ui.view">
        <field name="name">mechanical.soil.ssl.form</field>
        <field name="model">mechanical.soil.ssl</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                   <group >
                        <h1>
                            <field name="name_soil" readonly="1" nolabel="1"/>
                        </h1>
                    </group>
                     <group>
                        <field name='grade'/>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                    </group>
                    <group class="custom_table_borders">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </group>

                    

                    <!-- Sieve Analysis -->
                    <group invisible = "sieve_visible == False" style="white-space: nowrap; width:70%;" >
                        <h1>
                            <field name="sieve_name" readonly="1" nolabel="1"/>
                            <field name="sieve_visible" invisible="1"/>
                        </h1>
                    </group>
                    
                  
                    <group invisible = "sieve_visible == False" style="white-space: nowrap; width:100%;">
                  
                      <field name="child_lines">
                        <tree editable="bottom" class="custom_table_borders">
                          <field name="serial_no"/>
                          <field name="sieve_size"/>
                          <field name="particle_size"/>
                           <field name="wt_retained"/>
                          <field name="percent_retained"/>
                          <field name="cumulative_retained"/>
                          <field name="passing_percent"/>
                        </tree>
                      </field>

                       <group invisible = "sieve_visible == False">
                       <button string="Calculate Sieve Analysis"
                            type="object"
                            name="calculate"
                            class="oe_highlight">
                        <i class="fa fa-calculator"/> Calculate
                    </button>

                      </group>
                
                    </group>

                       

                     <group style="white-space: nowrap; width:80%;" invisible = "sieve_visible == False">
                     <group >
                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style=" padding-left: 200px; text-align: ">
                                <table style="border: 1px solid black; padding: 10px; padding-left: 200px; text-align: left; vertical-align: middle; color: black;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                            Total Weight
                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="total1" nolabel="1"/>
                                                </div>
                                            </td>
                                            <!-- <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                mm
                                            </td> -->
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </group>


                   <group >
                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 40%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                             Gravel
                                            </td>
                                            <td style="border: 1px solid black; padding: 10px; text-align: center; vertical-align: middle;">
                                                <div style="display: inline-block; min-width: 80px;">
                                                    <field name="gravel" nolabel="1"/>
                                                </div>
                                            </td>
                                          
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>


                        <div class="custom_table_borders" style="display: flex; justify-content: center; width: 100%;">
                            <div style="width: 40%;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        <tr>
                                            <td style="border: 1px solid black; padding: 10px; text-align: left; vertical-align: middle; color: black;">
                                          Sand
