                           </tr>
                           </tbody>
                          </table> -->
                        <!-- </div> -->

                          <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>

                            </div>
                        </page>

                    </notebook>


                        <button
                            type="object"
                            class="oe_highlight"
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
    </record>

