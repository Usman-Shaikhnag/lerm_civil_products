<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="concrete_moe_report">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln">
					<!-- NABL / Non-NABL report selection, resolved independently for each
						 parameter of this form.

						 A parameter belongs to the report being rendered when it is NABL
						 selected (the `nabl` flag passed by the print wizard / the download
						 controller) AND its own NABL result is 'pass'. Every other case -
						 the Non-NABL report was asked for, or NABL was asked for but this
						 parameter's own NABL result is 'fail' - puts the parameter on the
						 Non-NABL report only.

						 Modulus of Elasticity reads `data.nabl`, Poisson's Ratio reads
						 `data.poisson_nabl`; neither reads the other's NABL result.
						 Conformity (`data.confirmity` / `data.poisson_confirmity`) is
						 deliberately not referenced here: it never decides which of the two
						 reports a parameter is printed in. -->
					<t t-set="moe_in_this_report" t-value="data.compressive_visible and (data.nabl == 'pass' and nabl or (data.nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>
					<t t-set="poisson_in_this_report" t-value="data.poisson_visible and (data.poisson_nabl == 'pass' and nabl or (data.poisson_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>
					<div t-foreach="eln" t-as="o">
						<table style="margin-top:10px;">
							<tr>
								<td colspan="12" >#Customer Party Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name" /><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
									,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Project / Site Address : <![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Sample Description : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td colspan="6">Test Start Date :<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
								<td colspan="6">Test End Date :<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Sample Id Mark: <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.client_sample_id"/>
								</td>
								<td colspan="6">Sample Receipt Date : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Size :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								<td colspan="6">#Grade :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Brand :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.brand"/>
								</td>
								<td colspan="6">#Consultant Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.consultant_name1"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Client Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
								</td>
								<td colspan="6">#Client Reference :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client_refrence"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Discipline :
									<![CDATA[&nbsp;]]>
									<span t-field="o.discipline.discipline"/>
								</td>
								<td colspan="6">Group :
									<![CDATA[&nbsp;]]>
									<span t-field="o.group.group"/>
								</td>
							</tr>

							<tr>
								<td colspan="12">Material/Test Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
							</tr>
						</table>
					</div>

					<div t-if="moe_in_this_report"
						style="text-align:center;font-size:18px;margin-top:20px;">

						<t t-foreach="eln.parameters_result" t-as="parameter_result">
							<t t-if="parameter_result.parameter.internal_id == '0d84a152-37e6-4423-85a9-df33ef387f44'">

								<span t-esc="parameter_result.parameter.parameter_name"/>

								<t t-foreach="parameter_result.parameter.parameter_table"
									t-as="parameter_table_line">

									<t t-if="parameter_table_line.grade.id == eln.grade_id.id">
										<span t-field="parameter_table_line.specification"/>
									</t>

								</t>

							</t>
						</t>

					</div>
					<!-- MOE tables are shown for the first (Modulus of Elasticity)
						 parameter only; the flag comes from the existing
						 _compute_visible, keyed on MOE_PARAMETER_INTERNAL_ID. -->
					<div t-if="moe_in_this_report" style="margin-top:20px; page-break-inside: avoid;">
						<table style="width:100%">
							<thead>
								<tr>
									<th colspan="4" style="text-align:center;">
										28-DAY CUBE COMPRESSIVE STRENGTH / REFERENCE STRESS
									</th>
								</tr>
								<tr>
									<th style="text-align: center;">Cube Specimen</th>
									<th style="text-align: center;">Compressive Strength (MPa)</th>
									<th style="text-align: center;">Average Fc (MPa)</th>
									<th style="text-align: center;">Basic stress, σb = Fc/9 (MPa)</th>
								</tr>
							</thead>
							<tbody>
								<!-- Exactly one row per cube specimen, straight from the
									 cube_lines one2many - never more, so there is no
									 trailing blank row after the last specimen.

									 Average Fc and Basic stress are NOT repeated on every
									 row and are NOT left as empty <td> cells either: they
									 are emitted exactly once, on the first specimen row,
									 with a dynamic rowspan so the single cell vertically
									 merges across all the specimen rows. rowspan follows
									 len(data.cube_lines), so 3 specimens give rowspan="3",
									 4 give rowspan="4" and so on. Values stay computed on
									 the parent - never hard-coded. Upper stress is not
									 printed here; the second table carries it as Stress σa. -->
								<tr t-foreach="data.cube_lines" t-as="c">
									<td style="text-align: center;">
										<span t-esc="c.specimen" t-options='{"widget": "integer"}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="c.compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td t-if="c.specimen == 1"
										t-att-rowspan="len(data.cube_lines)"
										style="text-align: center; vertical-align: middle;">
										<span t-esc="data.average_strength"
											t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td t-if="c.specimen == 1"
										t-att-rowspan="len(data.cube_lines)"
										style="text-align: center; vertical-align: middle;">
										<span t-esc="data.basic_stress"
											t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
								<tr t-if="not data.cube_lines">
									<td style="text-align: center;">--</td>
									<td style="text-align: center;">--</td>
									<td style="text-align: center;">--</td>
									<td style="text-align: center;">--</td>
								</tr>
							</tbody>
						</table>
					</div>

					<div t-if="moe_in_this_report" style="margin-top:20px; page-break-inside: avoid;">
						<table style="width:100%">
							<thead>
								<tr>
									<th colspan="12" style="text-align:center;">
										SPECIMEN DETAILS AND MODULUS CALCULATION
									</th>
								</tr>
								<tr>
									<th style="text-align: center;">Specimen</th>
									<th style="text-align: center;">Diameter D (mm)</th>
									<th style="text-align: center;">Length L (mm)</th>
									<th style="text-align: center;">Mass (kg)</th>
									<th style="text-align: center;">εb (×10⁻⁶)</th>
									<th style="text-align: center;">εa (×10⁻⁶)</th>
									<th style="text-align: center;">L/D</th>
									<th style="text-align: center;">Density (kg/m³)</th>
									<th style="text-align: center;">Stress σb (MPa)</th>
									<th style="text-align: center;">Stress σa (MPa)</th>
									<th style="text-align: center;">Ec (MPa)</th>
									<th style="text-align: center;">Ec (GPa)</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="data.specimen_lines" t-as="r">
									<td style="text-align: center;">
										<span t-esc="r.specimen"/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.diameter" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.specimen_length" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.mass" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.strain_b" t-options='{"widget": "float", "precision": 0}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.strain_a" t-options='{"widget": "float", "precision": 0}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.l_d_ratio" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.density" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.stress_b" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.stress_a" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.ec_mpa" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.ec_gpa" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
								<tr>
									<td colspan="10" style="text-align: center;">Average</td>
									<td style="text-align: center;">
										<span t-esc="data.average_ec_mpa" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="data.average_ec_gpa" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
					<div t-if="poisson_in_this_report"
						style="text-align:center;font-size:18px;margin-top:20px;">

						<t t-foreach="eln.parameters_result" t-as="parameter_result">
							<t t-if="parameter_result.parameter.internal_id == '6ba2bb5e-dfd0-4e97-98a5-b2f708e0231f'">

								<span t-esc="parameter_result.parameter.parameter_name"/>

								<t t-foreach="parameter_result.parameter.parameter_table"
									t-as="parameter_table_line">

									<t t-if="parameter_table_line.grade.id == eln.grade_id.id">
										<span t-field="parameter_table_line.specification"/>
									</t>

								</t>

							</t>
						</t>

					</div>

					<!-- Poisson table is shown for the second parameter only; the flag
						 comes from the existing _compute_visible, keyed on
						 POISSON_PARAMETER_INTERNAL_ID. -->
					<div t-if="poisson_in_this_report" style="margin-top:20px; page-break-inside: avoid;">
						<table style="width:100%">
							<thead>
								<tr>
									<th colspan="6" style="text-align:center;">
										POISSON&#39;S RATIO (OPTIONAL &#8212; IF TRANSVERSE STRAIN IS MEASURED)
									</th>
								</tr>
								<tr>
									<th style="text-align: center;">Specimen</th>
									<th style="text-align: center;">Long. εb (×10⁻⁶)</th>
									<th style="text-align: center;">Long. εa (×10⁻⁶)</th>
									<th style="text-align: center;">Trans. εb (×10⁻⁶)</th>
									<th style="text-align: center;">Trans. εa (×10⁻⁶)</th>
									<th style="text-align: center;">Poisson&#39;s Ratio μ</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="data.poisson_lines" t-as="r">
									<td style="text-align: center;">
										<span t-esc="r.specimen"/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.long_strain_b" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.long_strain_a" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.trans_strain_b" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.trans_strain_a" t-options='{"widget": "float", "precision": 3}'/>
									</td>
									<td style="text-align: center;">
										<span t-esc="r.poisson_ratio" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
								<tr>
									<td colspan="5" style="text-align: center;">Average</td>
									<td style="text-align: center;">
										<span t-esc="data.average_poisson_ratio" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>
					</div>

					<div style="margin-top:10px">
						<table style="width:100%">
							<thead>
								<tr>
									<th colspan="6" style="text-align:center;">
										FINAL RESULT
									</th>
								</tr>
							</thead>
							<tbody>
							<tr t-if="moe_in_this_report">
								<td colspan="4">Average Static Modulus of Elasticity, Ec (GPa)</td>
								<td colspan="2" style="text-align: center;">
									<span t-esc="data.average_ec_gpa" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
							<tr t-if="poisson_in_this_report">
									<td colspan="4">Average Poisson&#39;s Ratio, μ</td>
									<td colspan="2" style="text-align: center;">
										<span t-esc="data.average_poisson_ratio" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>
					</div>

					<div style="page-break-inside: avoid;">
						<div style="page-break-inside: avoid; margin-top: 20px;" class="noteContainer">
							<ul>
								<t t-if="data.notes_id">
									<t t-foreach="data.notes_id" t-as="n">
										<li>
											<span t-esc="n.sr_no"/>. <span t-esc="n.notes"/>
										</li>
									</t>
								</t>
								<li t-if="eln.has_witness">
									Test witnessed by : <span t-esc="eln.witness_name"/>
								</li>
								<li t-if="eln.remarks">
									<span t-esc="eln.remarks"/>
								</li>
							</ul>
						</div>
					</div>
					<div style="margin-top:10px; page-break-inside: avoid;" class="signatureContainer girdgird">
						<div>
							<div>
								<b>
									Checked By
								</b>
							</div>
							<div style="height: 50px;">
								<t t-if="eln.sample_id.checkby_signature_required">
									<div t-if="eln.sample_id.check_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
									</div>

								</t>
							</div>

							<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>
						</div>
						<div>
							<div style="padding-top:5px">
								Format No. <span t-esc="eln.material.test_format_no"/>
							</div>
						</div>
						<div>
							<div>
								<b>
									Approved By
								</b>
							</div>
							<div style="height: 50px;">
								<t t-if="eln.sample_id.approveby_signature_required">
									<div t-if="eln.sample_id.approved_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 45px;margin-top:1px; z-index: -10;"/>
									</div>

								</t>
							</div>

							<div>
								<b>
								<span t-esc="eln.sample_id.approved_by.name"/>
								</b>
							</div>

							<div>
								<b>
									(<span t-esc="eln.sample_id.approved_by.job_title"/>)
								</b>
							</div>
						</div>
					</div>
					<div style="margin-top: 10px; text-align: center;">
						<p style="border-top: 1px dashed #000; padding-top: 10px;">
							...... End Of Report......
						</p>
					</div>
				</div>
			</t>
		</t>
	</template>



</odoo>