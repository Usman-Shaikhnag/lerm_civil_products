<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_selection_wizard_form" model="ir.ui.view">
        <field name="name">equipment.selection.wizard.form</field>
        <field name="model">equipment.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Equipment">
                <sheet>
                    <group>
                        <group>
                            <field name="parameter_result" readonly="1" invisible="1"/> 
                            <field name="parameter_id" required="1" readonly="1"/>
                            <field name="equipment_ids" invisible="1"/>
                            <field name="selected_equipment_id" required="1"/>

                            <field name="machine_start_time" />
                            <field name="machine_end_time" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_equipment_selection_wizard" model="ir.actions.act_window">
        <field name="name">Select Equipment</field>
        <field name="res_model">equipment.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>