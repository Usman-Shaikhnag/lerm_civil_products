<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Tree View -->
    <record id="view_equipment_tree_inherit" model="ir.ui.view">
        <field name="name">equipment.tree.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">

                <field name="code"/>
                <field name="lerm_equipment"/>

            </xpath>

             
        </field>
    </record>

    <!-- Inherit Form View -->
    <record id="view_equipment_form_inherit" model="ir.ui.view">
        <field name="name">equipment.form.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                
                <label for="code"/>
                <h4><field name="code"/></h4>
                <label for="lerm_equipment"/>
                <field name="lerm_equipment"/>
                

                
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="after">
                
                <separator string="Operational Hours"/>
                <field name="available_from" widget="float_time"/>
                <field name="available_to" widget="float_time"/>
                
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="before">
                <field name="group"/>
            </xpath>
            <xpath expr="//page[@name='maintenance']" position="after">
                <page string="Parameter" name="parameteres" invisible="lerm_equipment == False">
                        <group>
                            <field name="parameter_ids">
                                <tree>
                                    <field name="parameter_name"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="parameter_name"/>
                                    </group>
                                </form>
                            </field>
                        
                        </group>
                </page>

                <page string="Calibration" name="calibration">
                        <field name="calibration_lines">
                            <tree editable="bottom">
                                <field name="range_least_count" />
                                <field name="calibration_method" />
                                <field name="calibration_certificate_no" />
                                <field name="traceability_nabl_certificate" />
                                <field name="calibration_due_date" />
                                <field name="accuracy_status_defined" />
                                <field name="name_address_calibration_lab" />
                                <field name="calibration_ulr_no" />
                                <field name="traceability_certificate_no_valid_date" />
                                <field name="last_calibration_date" />
                                <field name="accuracy_status_reported" />
                                <field name="fit_for_use" />
                            </tree>
                        </field>
                        
                </page>
            </xpath>
            
            
        </field>
    </record>

    <record id="lerm_equipment_register_tree" model="ir.ui.view">
        <field name="name">equipment.register.tree</field>
        <field name="model">equipment.register</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="equipment"/>
                <field name="code"/>
                <field name="group"/>
                <field name="range_least_count"/>
                <field name="name_address_calibration_lab"/>
                <field name="calibration_method"/>
                <field name="calibration_ulr_no"/>
                <field name="calibration_certificate_no"/>
                <field name="traceability_certificate_no_valid_date"/>
                <field name="traceability_nabl_certificate"/>
                <field name="last_calibration_date"/>
                <field name="calibration_due_date"/>
                <field name="accuracy_status_defined"/>
                <field name="accuracy_status_reported"/>
                <field name="fit_for_use"/>
            </tree>
        </field>
    </record>


    <record id="action_equipment_register" model="ir.actions.act_window">
        <field name="name">Sample Register</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">equipment.register</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Equipment Register</p>
        </field>
    </record>

    <menuitem id="equipment_register_menu"
        name="Equipment Register"
        parent="lerm_civil.register_menu"
        action="action_equipment_register"
        sequence="12"  />
