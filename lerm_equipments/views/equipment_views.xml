<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_equipment_tree" model="ir.ui.view">
        <field name="name">equipment.tree</field>
        <field name="model">lerm.equipment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
         
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_equipment_form" model="ir.ui.view">
        <field name="name">equipment.form</field>
        <field name="model">lerm.equipment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_equipment" model="ir.actions.act_window">
        <field name="name">Equipments</field>
        <field name="res_model">lerm.equipment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_equipment_root" name="Laboratory"/>
    <menuitem id="menu_equipment" name="Equipments" parent="menu_equipment_root" action="action_equipment"/>
</odoo>