<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="concrete_core_report_ssl">
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				
				<div class="container_eln" style="padding-top:70px;">
					<div class="" t-foreach="eln" t-as="o">
						<table style="margin-top:10px; width: 100%; border-collapse: collapse;">
							<tbody>
								<tr>
									<td style="width: 30%; padding: 5px;"><strong>Client Details</strong></td>
									<td style="padding-left: 10px;">
										<span t-field="o.srf_id.customer.name"/>
										<span t-field="o.srf_id.customer.street"/>
										<span t-field="o.srf_id.customer.street2"/>
										<span t-field="o.srf_id.customer.city"/>
										<span t-if="o.srf_id.customer.zip"> - <span t-field="o.srf_id.customer.zip"/></span>,
										<span t-field="o.srf_id.customer.state_id"/> ,
										<span t-field="o.srf_id.customer.country_id"/>
									</td>
								
								</tr>
								
								<tr>
									<td><strong>Client's Reference</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.srf_id.client_refrence"/></td>
								</tr>

								<tr>
									<td><strong>Name of Work</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.srf_id.name_work"/></td>
								</tr>

								<tr>
									<td><strong>Date of Testing</strong></td>
									<td style="padding-left: 10px;">
										<span t-field="o.start_date" style="margin-right:10px;"/> to 
										<span t-field="o.end_date" style="margin-left:10px;"/>
									</td>
								</tr>

								<tr>
									<td><strong>Type of Sample</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.material.name"/></td>
								</tr>

								<tr>
									<td><strong>Grade of Sample</strong></td>
									<td style="padding-left: 10px;"><span t-field="o.grade_id.grade"/></td>
								</tr>

								<!-- Source of Sample (only if value exists) -->
								<tr t-if="o.material.source_sample">
									<td style="font-weight: bold;">Source of Sample</td>
									<td><span t-field="o.material.source_sample"/></td>
								</tr>

								<!-- Test method adopted (only if value exists) -->
								<tr t-if="o.material.test_method_adopted">
									<td style="font-weight: bold;">Test method adopted:</td>
									<td><span t-field="o.material.test_method_adopted"/></td>
								</tr>
							</tbody>
						</table>
					</div>
					
					
					<div>
						
                    	<div style="text-align:center;font-size:18px;margin-top:2px">
						<!-- Concrete Cube -->
							<span t-field="env['lerm.parameter.master'].search([('internal_id','=','254187-47c9-4662-9298-3095ac900ffc')]).parameter_name"/>
							<span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','254187-47c9-4662-9298-3095ac900ffc')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.specification"/>
									</t>
								</t>
							</span>
							 - <span t-field="data.type_of_sample"></span>
						</div>
					</div>
                    <div >
				
							<!-- <h5 style="margin-top:5px;text-align: center;">
								  <span t-field="data.type_of_sample"></span>
							</h5> -->
						
					</div>
           

						<table style="margin-top:2px">
				
							
							<tr>
								<td colspan="6">Dia of core:  </td>
								<td><span t-field="data.thickness2"></span></td>
								<td>
								 mm
								</td>
							</tr>
							<tr>
							
								<td colspan="6">Area Of Core : </td>
								<td> <span t-field="data.area_core"></span></td>
								<td>
								mm2
								</td>
							</tr>
						
						</table>
						<table style="margin-top:2px;">
						<thead>
							<tr>
								<th rowspan="2" style="text-align: center; font-weight: bold;"> 
									<span>
										Sr. No
									</span>
								</th>
								<th rowspan="2"	style="text-align: center; font-weight: bold;">
									<span>
									Location
									</span>
								</th>

								<!-- <th rowspan="1" style="text-align: center;font-weight: bold;">
									<span>
									Grade of  Concrite
									</span>
								</th> -->
								
								<th rowspan="2" style="text-align: center; font-weight: bold;">
									<span>
									Depth after Trimming in mm
									</span>
								</th>

								<th rowspan="2" style="text-align: center; font-weight: bold;">
									<span>
									Load kN
									</span>
								</th>
								<th rowspan="2" style="text-align: center; font-weight: bold;">
									<span>
									 L /D RATIO  
									</span>
								</th>
								
								<th rowspan="2" style="text-align: center; font-weight: bold;">
									<span>
									Load in N 
									</span>
								</th>

								<th rowspan="2" style="text-align: center; font-weight: bold;">
									<span>
								Core Comp. strength(N/ mm2)
									</span>
								</th>
								<th colspan="1" style="text-align: center; font-weight: bold;">
									<span>
									Correction Factor
									</span>
								</th>
                                	<th rowspan="2" style="text-align: center; font-weight: bold;">
									<span>
									Corrected Cyl.Comp.Strength  (N/ mm2)
									</span>
								</th>
                                	<th rowspan="2" style="text-align: center; font-weight: bold;">
									<span>
									Equivalent Cube.Comp Strength (N/ mm2)
									</span>
								</th>
							</tr>
                              <tr>
                              	<th colspan="1" style="text-align: center; font-weight: bold;">
									<span>
								    L/D

									</span>
								</th>
                                	<!-- <th colspan="1" style="text-align: center; font-weight: bold;">
									<span>
									Dia
									</span>
								</th> -->
                            </tr>
						</thead>
						<tbody>
							<tr t-foreach="data.child_lines" t-as="r">
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.serial_no"/>
								</td>
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.location"/>
								</td>
								<!-- <td colspan="1" style="text-align: center;">
                                    <span t-esc="r.grade_con"/>
								</td> -->
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.depth"/>
								</td>
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.load" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.ld_ratio" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.load_n"/>
								</td>
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.core_comp" t-options='{"widget": "float", "precision": 2}'/>
								</td>
								<td colspan="1" style="text-align: center;">
									<span t-esc="r.correction_factor_ld" t-options='{"widget": "float", "precision": 2}'/>
								</td>
                                <!-- <td colspan="1" style="text-align: center;">
									<span t-esc="r.correction_factor_dia" t-options='{"widget": "float", "precision": 2}'/>
								</td> -->
                                <td colspan="1" style="text-align: center;">
									<span t-esc="r.correct_comp" t-options='{"widget": "float", "precision": 2}'/>
								</td>
                                <td colspan="1" style="text-align: center;">
									<span t-esc="r.equivalent_cube" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>

                          
						</tbody>
					</table>

					<div style="margin-top:3px">
					<!-- <h6 style="margin-top:3px"> -->
					 <!-- Acceptable Criteria: - As per IS 456:2000 Clause 17.4.3 -->
			       <div style="margin-top:2px;">
						<b>Acceptable Criteria: -</b><span t-esc="o.material.test_parameter"/>

					</div>
					 <!-- </h6> -->
						<table style="margin-top:2px">
							<tr>
								<td colspan="12">The Average Equivalent Cube strength of core is equal to atleast 85 % of  Cube strength of the grade of concrete specified :</td>
								<![CDATA[&nbsp;]]>
								<td>
									<span t-field="data.area_equvalent_cube"/>
								</td>
								<td>
								N/mm² 
								</td>
							</tr>
                            <tr>
								<td colspan="12">Any individual Cube strength computed not less than 75% of the grade of Concrete specified  N/mm² :</td>
								<![CDATA[&nbsp;]]>
								<td>
									<span t-field="data.any_individual_cube"/>
								</td>
								<td>
								N/mm² 
								</td>
							</tr>
						</table>
					</div>
					
					<div style="margin-top:5px; page-break-inside: avoid;" class="signatureContainer girdgird">
							<table class="table table-bordered">
							<tr>
								<td style="padding: 5px; font-style: italic; font-size: 12px;">
									<b>Note:-</b>
									&#160;&#160;(i) The results relate only to the items tested 
									&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
									&#160;&#160;(iii) Any corrections invalidate the test reports 
									&#160;&#160;(iv) Any Query regarding the report must be reported immediately. 
									&#160;&#160;(v) * mark indicate tests which are not in the scope of NABL. 
									&#160;&#160;(vi) # mark indicates Details given by Client.
									<t t-if="eln.has_witness">
										&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
									</t>
									<t t-if="eln.remarks">
										&#160;&#160;<span t-esc="eln.remarks"/>
									</t>
								</td>
							</tr>
						</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:15px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<!-- <div>
								<div>
									<img t-attf-src="/lerm_civil/static/src/img/stamp.png" alt="Image"/>
								</div>
								<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
								</div>
							</div>
							 -->
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height:15px">

								</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<div style="text-align:center;margin-top:2px">
							......End of Report......
						</div>

				</div>
			</t>
		</t>
	</template>
    </odoo>