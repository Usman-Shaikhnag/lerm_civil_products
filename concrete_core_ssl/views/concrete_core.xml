<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="concrete_core_view_ssl" model="ir.ui.view">
        <field name="name">mechanical.concrete.core.ssl.form</field>
        <field name="model">mechanical.concrete.core.ssl</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>


                  <group style="white-space: nowrap; width:70%;">
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="grade"/>

                    </group>
                    <group>
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </group>

                    <group style=" width:50%;">
                      <field name='type_of_sample' />
                    </group>

                     <div>
                        <field name="dia_lines"  >
                                <tree editable="bottom">
                                    <field name="serial_no" />
                                    <field name="dia_core"/>
                                      <field name="correction_dia"/>
                                    
                                </tree>
                        </field>
                    </div>

                     <group>
                        <group>
                            <field name='dia_core' />
                        </group>

                   
                        <group>
                            <field name='area_core' />
                        </group>
                     </group>
                    
                      
                <div>
                    <field name="child_lines" >
                            <tree editable="bottom">
                                <field name="serial_no" />
                                <field name="location"/>
                                <field name="grade_con" />
                                <field name="depth" />
                                <field name="load"/>
                                <field name="ld_ratio" />
                                <field name="load_n" />
                                <field name="core_comp"/>
                                <field name="correction_factor_ld"/>
                                <field name="correction_factor_dia" />
                                <field name="correct_comp" />
                                <field name="equivalent_cube" />
                            </tree>
                    </field>
                </div>

                    <group style="white-space: nowrap; width:80%;">
                        <field name='area_equvalent_cube' />  
                    </group>

                    <group style="white-space: nowrap; width:80%;">       
                        <field name='any_individual_cube' />
                    </group>


                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />



                     
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>