<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="uplift_load_paperformat" model="report.paperformat">
        <field name="name">Uplift Load Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">34</field>
        <field name="header_line" eval="False"/>
    </record>

    <record id="uplift_load_report" model="ir.actions.report">
        <field name="name">Uplift Load Report</field>
        <field name="model">fst.uplift.load.test</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">fst_upload_lift_test.uplift_load_template</field>
        <field name="print_report_name">'Uplift_Load_Report'</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="model_fst_uplift_load_test"/>
        <field name="paperformat_id" ref="uplift_load_paperformat"/>
    </record>

    <!-- Body follows report KES260901159 (Uplift Load Test); header and
         footer come from the lab through the layout template. -->
    <template id="uplift_load_template">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs and docs[0]"/>
            <t t-set="lab" t-value="o.lab_id.sudo()"/>
            <t t-set="master_lab" t-value="env['lerm.lab.master'].sudo().search([], limit=1)"/>

            <div t-if="not o" style="padding:40px; text-align:center; font-size:14pt;">
                No uplift load test has been entered for this sample yet. Use Open Form on the ELN to enter the readings.
            </div>
            <t t-else="" t-call="fst_upload_lift_test.custom_layout_header_footer_uplift_load">
            <!-- div.article makes the PDF use the report layout (UTF-8, assets). -->
            <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
            <style>
                @page { margin-top: 40mm; }
                .article, .article * { font-family: 'Times New Roman', 'Nimbus Roman', 'Nimbus Roman No9 L', Times, serif; }
                .article { font-size: 11pt; color: #000000; }
                .page { margin-top: 20px; }
                .break { page-break-before: always; }
                .keep { page-break-inside: avoid; }

                table.no-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                table.no-table td { border: 1px solid #000; padding: 2px 5px; font-size: 10.5pt; vertical-align: middle; }

                table.cover { width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 14mm; }
                table.cover td { border: 1px solid #000; padding: 3px 5px; font-size: 11pt; vertical-align: top; line-height: 1.5; }

                .toc-title { text-align: center; font-size: 12pt; margin: 14mm 0 12mm 0; }
                table.toc { width: 78%; margin: 0 auto; border-collapse: collapse; font-size: 12pt; }
                table.toc td { padding: 7px 4px; vertical-align: top; }

                .section { margin: 0 6mm; }
                .section h3 { font-size: 13pt; font-weight: bold; margin: 18px 0 10px 0; }
                .section .text { font-size: 11.5pt; line-height: 1.75; text-align: justify; white-space: pre-wrap; margin: 0 0 6px 4mm; }
                .section .html { font-size: 11.5pt; line-height: 1.6; margin: 0 0 6px 4mm; }
                .section .html p { margin: 0 0 8px 0; }

                table.sign { width: 100%; margin-top: 22mm; border-collapse: collapse; font-size: 12pt; font-weight: bold; }
                table.sign td { width: 50%; text-align: center; vertical-align: top; line-height: 1.8; border: none; }

                .annexure-page { width: 100%; padding-top: 95mm; text-align: center; page-break-before: always; page-break-after: always; page-break-inside: avoid; }
                .annexure-title { font-size: 26pt; font-weight: bold; margin-bottom: 8px; }
                .annexure-subtitle { font-size: 20pt; font-weight: bold; }

                .sheet { border: 2px solid #1f3f99; }
                .sheet-title { font-size: 17pt; font-weight: bold; padding: 2px 4px; border-bottom: 1px solid #000; }
                table.sheet-head { width: 100%; border-collapse: collapse; font-size: 9pt; }
                table.sheet-head td { border: 1px solid #000; padding: 1px 4px; }
                table.sheet-head td.lbl { font-weight: bold; }
                table.readings { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 9.5pt; }
                table.readings th { border: 1px solid #000; padding: 2px; font-weight: bold; text-align: center; vertical-align: middle; }
                table.readings td { border: 1px solid #000; padding: 1px 2px; text-align: center; vertical-align: middle; }
                table.readings tr.band td { font-weight: bold; }
                table.readings tr.witness td { font-weight: bold; border-left: none; border-right: none; }
                table.readings tr.witness-space td { height: 22mm; border: none; }

                table.toc, table.toc *, table.sign, table.sign * { border: 0 none !important; box-shadow: none !important; }
                table.plot-values { width: 100%; border-collapse: collapse; font-size: 11pt; }
                table.plot-values td, table.plot-values th { border: 1px solid #000; padding: 8px 4px; text-align: center; font-weight: normal; }
            </style>

                <div class="page">

                    <!-- ============ COVER ============ -->
                    <table class="no-table">
                        <colgroup>
                            <col style="width:16%;"/>
                            <col style="width:17%;"/>
                            <col style="width:19%;"/>
                            <col style="width:14%;"/>
                            <col style="width:10%;"/>
                            <col style="width:24%;"/>
                        </colgroup>
                        <tr>
                            <td>Test Report no:</td>
                            <td><span t-esc="o.report_no"/></td>
                            <td>Report Issue Date:</td>
                            <td><span t-esc="o.report_date(o.rec_date)"/></td>
                            <td>ULR No.</td>
                            <td><span t-esc="o.ulr"/></td>
                        </tr>
                    </table>

                    <table class="cover">
                        <colgroup>
                            <col style="width:50%;"/>
                            <col style="width:50%;"/>
                        </colgroup>
                        <tr>
                            <td colspan="2" style="height:12mm;">Customer Party Name: <span t-esc="o.client"/></td>
                        </tr>
                        <tr>
                            <td colspan="2">Project / Site Address: <span t-esc="o.site_location or o.work_name"/></td>
                        </tr>
                        <tr>
                            <td>Test Start Date: <span t-esc="o.report_date(o.test_start_date)"/></td>
                            <td>Test End Date :<span t-esc="o.report_date(o.test_end_date)"/></td>
                        </tr>
                        <tr>
                            <td>
                                Pile ID: <span t-esc="o.pile_no"/>
                                <div t-if="o.pile_coordinates" style="padding-left:6mm;">(Co-ordinates: <span t-esc="o.pile_coordinates"/>)</div>
                            </td>
                            <td>Grade: <span t-esc="o.grade"/></td>
                        </tr>
                        <tr>
                            <td>Size: <t t-if="o.pile_diameter"><span t-esc="'%g' % o.pile_diameter"/> mm</t></td>
                            <td>Consultant Name: <span t-esc="o.consultant"/></td>
                        </tr>
                        <tr>
                            <td>Main Client: <span t-esc="o.main_client"/></td>
                            <td>Group: <span t-esc="o.group"/></td>
                        </tr>
                        <tr><td colspan="2">EPC Contractor: <span t-esc="o.contractor"/></td></tr>
                        <tr><td colspan="2">Discipline: <span t-esc="o.discipline"/></td></tr>
                        <tr><td colspan="2">Test Name: <span t-esc="o.test_name"/></td></tr>
                        <tr><td colspan="2">References: <span t-esc="o.test_standard"/></td></tr>
                    </table>

                    <!-- ============ TABLE OF CONTENTS ============ -->
                    <div class="break"/>
                    <div class="toc-title">TABLE OF CONTENTS</div>
                    <table class="toc">
                        <colgroup>
                            <col style="width:9%;"/>
                            <col style="width:65%;"/>
                            <col style="width:16%;"/>
                            <col style="width:10%;"/>
                        </colgroup>
                        <tr t-foreach="o.content_ids" t-as="line">
                            <td><span t-esc="line.section_number"/></td>
                            <td><span t-esc="line.description"/></td>
                            <td style="text-align:right;">..........</td>
                            <td><span t-esc="line.page_no"/></td>
                        </tr>
                    </table>

                    <!-- ============ 1 - 4 ============ -->
                    <div class="break"/>
                    <div class="section">
                        <t t-foreach="[
                                ('1. GENERAL PHILOSOPHY', o.general_philosophy),
                                ('2. SCOPE OF WORKS', o.scope_of_works),
                                ('3. REFERENCES', o.reference),
                                ('4. PILE DETAILS:', o.pile_details),
                            ]" t-as="sec">
                            <div class="keep" t-if="sec[1]">
                                <h3 t-esc="sec[0]"/>
                                <div class="text" t-esc="sec[1]"/>
                            </div>
                        </t>
                    </div>

                    <!-- ============ 5 ============ -->
                    <div class="break"/>
                    <div class="section">
                        <h3>5. Setting up of Testing Apparatus:</h3>
                        <div class="text" t-esc="o.setup_apparatus"/>
                        <div t-if="o.arrangement_drawing" style="text-align:center; margin-top:6px;">
                            <img t-att-src="'data:image/png;base64,%s' % o.arrangement_drawing.decode('utf-8')"
                                 style="height:118mm; width:auto; max-width:95%;"/>
                        </div>
                    </div>

                    <!-- ============ 6 - 7 ============ -->
                    <div class="break"/>
                    <div class="section">
                        <div class="keep">
                            <h3>6. Measuring System</h3>
                            <div class="text" t-esc="o.measuring_system"/>
                        </div>
                        <div class="keep">
                            <h3>7. Method of Conducting Test</h3>
                            <div class="text" t-esc="o.test_procedure"/>
                        </div>
                    </div>

                    <!-- ============ 8 - 9 + SIGNATURES ============ -->
                    <div class="break"/>
                    <div class="section">
                        <div class="keep">
                            <h3>8. TEST REPORT &amp; OBSERVATIONS:</h3>
                            <div class="text" t-esc="o.pile_test_observations"/>
                        </div>
                        <div class="keep">
                            <h3>9. CONCLUSIONS:</h3>
                            <div class="html" t-out="o.conclusion"/>
                        </div>
                    </div>

                    <table class="sign keep">
                        <tr>
                            <td>
                                Checked By<br/>
                                <div t-if="o.sample_id.check_by.employee_id.signature">
                                    <img t-att-src="'data:image/png;base64,%s' % o.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width:200px; max-height:45px;"/>
                                </div>
                                <span t-esc="o.sample_id.check_by.name or o.checked_by_name"/><br/>
                                <span t-esc="o.checked_by_designation"/>
                            </td>
                            <td>
                                Approved By<br/>
                                <div t-if="o.sample_id.approved_by.employee_id.signature">
                                    <img t-att-src="'data:image/png;base64,%s' % o.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width:200px; max-height:45px;"/>
                                </div>
                                <span t-esc="o.sample_id.approved_by.name or o.signatory_name"/><br/>
                                <span t-esc="o.signatory_designation"/><br/>
                                (Authorized Signatory)
                            </td>
                        </tr>
                    </table>

                    <!-- ============ ANNEXURE I : TEST READINGS ============ -->
                    <div class="annexure-page">
                        <div class="annexure-title">Annexure I</div>
                        <div class="annexure-subtitle">(TEST READINGS)</div>
                    </div>

                    <t t-foreach="o.report_reading_blocks()" t-as="block">
                        <div t-if="not block_first" class="break"/>
                        <div class="sheet">
                            <t t-if="block_first">
                                <div class="sheet-title">Project Name: <span t-esc="o.name"/></div>
                                <table class="sheet-head">
                                    <colgroup>
                                        <col style="width:20%;"/>
                                        <col style="width:20%;"/>
                                        <col style="width:22%;"/>
                                        <col style="width:38%;"/>
                                    </colgroup>
                                    <tr>
                                        <td class="lbl">Pile Dia (mm):</td>
                                        <td><t t-if="o.pile_diameter"><span t-esc="'%g' % o.pile_diameter"/> mm</t></td>
                                        <td class="lbl">Location :</td>
                                        <td><span t-esc="o.pile_no"/></td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">Maximum Test Load:</td>
                                        <td><span t-esc="'%g' % o.max_test_load"/> MT</td>
                                        <td class="lbl">Effective Area of Jack:</td>
                                        <td><span t-esc="'%g' % o.effective_area_jack"/> cm2</td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">Design Load:</td>
                                        <td><span t-esc="'%g' % o.design_load"/> MT</td>
                                        <td class="lbl">Dial Gauge Least Count:</td>
                                        <td><span t-esc="o.dial_gauge_least_count"/></td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">Test Start Date:</td>
                                        <td><span t-esc="o.report_date(o.test_start_date, False)"/></td>
                                        <td class="lbl">Total Settlement:</td>
                                        <td><span t-esc="o.format_2dp(o.total_uplift)"/> mm</td>
                                    </tr>
                                    <tr>
                                        <td class="lbl">End Date:</td>
                                        <td><span t-esc="o.report_date(o.test_end_date, False)"/></td>
                                        <td class="lbl">Net Settlement:</td>
                                        <td><span t-esc="o.format_2dp(o.net_uplift)"/> mm</td>
                                    </tr>
                                </table>
                            </t>

                            <table class="readings">
                                <colgroup>
                                    <col style="width:13%;"/>
                                    <col style="width:10%;"/>
                                    <col style="width:9%;"/>
                                    <col style="width:9%;"/>
                                    <col style="width:10%;"/>
                                    <col style="width:10%;"/>
                                    <col style="width:12%;"/>
                                    <col style="width:12%;"/>
                                    <col style="width:15%;"/>
                                </colgroup>
                                <t t-if="block_first">
                                    <tr>
                                        <th rowspan="2">Sr.No.</th>
                                        <th rowspan="2">Reading Interval ( Min)</th>
                                        <th rowspan="2">Pressure Gauge Reading (Kg/cm2)</th>
                                        <th rowspan="2">Load(MT)</th>
                                        <th colspan="2">Dial Gauge Reading (mm)</th>
                                        <th rowspan="2">Cumulative Dial Reading</th>
                                        <th rowspan="2">Average Dial Reading (mm)</th>
                                        <th rowspan="2">Cumulative average Reading (mm)</th>
                                    </tr>
                                    <tr>
                                        <th>A</th>
                                        <th>B</th>
                                    </tr>
                                </t>
                                <tr class="band">
                                    <td colspan="9"><span t-esc="block['title']"/></td>
                                </tr>
                                <t t-foreach="block['stages']" t-as="stage">
                                    <t t-set="rows" t-value="len(stage['lines'])"/>
                                    <tr t-foreach="stage['lines']" t-as="r">
                                        <t t-if="r_first">
                                            <td t-att-rowspan="rows"><span t-esc="stage['number']"/></td>
                                        </t>
                                        <td><span t-esc="r.interval_display"/></td>
                                        <t t-if="r_first">
                                            <td t-att-rowspan="rows"><span t-esc="o.format_2dp(stage['pressure'])"/></td>
                                            <td t-att-rowspan="rows"><span t-esc="o.format_2dp(stage['load'])"/></td>
                                        </t>
                                        <td><span t-if="r.is_recorded" t-esc="o.format_2dp(r.dial_a)"/></td>
                                        <td><span t-if="r.is_recorded" t-esc="o.format_2dp(r.dial_b)"/></td>
                                        <td><span t-if="r.is_recorded" t-esc="o.format_2dp(r.cumulative_dial)"/></td>
                                        <t t-if="r_first">
                                            <td t-att-rowspan="rows"><span t-esc="o.format_2dp(stage['avg'])"/></td>
                                            <td t-att-rowspan="rows"><span t-esc="o.format_2dp(stage['cumulative'])"/></td>
                                        </t>
                                    </tr>
                                </t>
                                <tr><td colspan="9" style="height:5mm;"></td></tr>
                                <tr class="witness">
                                    <td colspan="3">Tested By</td>
                                    <td colspan="3">Client Witness</td>
                                    <td colspan="3">PMC Witness</td>
                                </tr>
                                <tr class="witness-space"><td colspan="9"></td></tr>
                            </table>
                        </div>
                    </t>

                    <t t-foreach="o.datasheet_image_ids.filtered('image')" t-as="img">
                        <div class="break"/>
                        <div style="text-align:center; margin-top:8mm;">
                            <img t-att-src="'data:image/png;base64,%s' % img.image.decode('utf-8')"
                                 style="max-width:90%; max-height:220mm;"/>
                            <p t-if="img.caption" style="text-align:center;"><span t-esc="img.caption"/></p>
                        </div>
                    </t>

                    <!-- ============ ANNEXURE II : LOAD VS DEFLECTION ============ -->
                    <div class="annexure-page">
                        <div class="annexure-title">Annexure II</div>
                        <div class="annexure-subtitle">(Load vs. Deflection Plot)</div>
                    </div>

                    <table style="width:100%; border-collapse:collapse; margin-top:8mm;" class="keep">
                        <tr>
                            <td style="width:27%; vertical-align:top; padding-right:5mm;">
                                <table class="plot-values">
                                    <tr>
                                        <th style="width:50%;">Load  MT</th>
                                        <th>Settlement in mm</th>
                                    </tr>
                                    <tr>
                                        <td>0.00</td>
                                        <td>0.00</td>
                                    </tr>
                                    <tr t-foreach="o.summary_ids" t-as="s">
                                        <td><span t-esc="o.format_2dp(s.load_tonne)"/></td>
                                        <td><span t-esc="o.format_2dp(s.cumulative_uplift)"/></td>
                                    </tr>
                                </table>
                            </td>
                            <td style="vertical-align:top; border:1px solid #000; padding:4mm; text-align:center;">
                                <img t-if="o.graph_image"
                                     t-att-src="'data:image/png;base64,%s' % o.graph_image.decode('utf-8')"
                                     style="width:100%;"/>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ ANNEXURE III : SITE PHOTOGRAPHS ============ -->
                    <div class="annexure-page">
                        <div class="annexure-title">Annexure III</div>
                        <div class="annexure-subtitle">(Site Photographs)</div>
                    </div>

                    <t t-foreach="o.site_image_ids.filtered('image')" t-as="img">
                        <div t-if="not img_first" class="break"/>
                        <div style="text-align:center; margin-top:4mm;">
                            <img t-att-src="'data:image/png;base64,%s' % img.image.decode('utf-8')"
                                 style="max-width:65%; max-height:215mm;"/>
                            <p t-if="img.caption" style="text-align:center;"><span t-esc="img.caption"/></p>
                        </div>
                    </t>

                </div>
            </div>
            </t>
        </t>
    </template>

</odoo>
