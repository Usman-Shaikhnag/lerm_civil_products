					<div  t-if="data.flow_test_visible" style="page-break-before: always;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Flow Test of Fresh Cement Concrete
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Trial No.</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Initial Diameter D₁ (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Initial Diameter D₂ (mm)</th>
									<th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Average Initial Diameter (mm)((D₁ + D₂)/2)</th>
                                    <th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Final Spread Diameter D₁ (mm)</th>
                                    <th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Final Spread Diameter D₂ (mm)</th>
                                    <th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Average Final Spread Diameter (mm)((D₁ + D₂)/2)</th>
                                    <th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Number of Drops/Jolts</th>
                                    <th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Test Duration (s)</th>
                                    <th style="text-align: center;border: 1px solid #ccc; padding: 8px;" colspan="2">Flow (%)  (((B − A)/A) × 100)</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
