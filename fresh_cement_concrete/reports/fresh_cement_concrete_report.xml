<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	   <template id="fresh_cement_concrete_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->

				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">NA</t>
								</td>

                                <!-- <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td> -->
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else="">NA</t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <!-- <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td> -->
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
									       <span t-field="o.material.lab_name"/> <![CDATA[&nbsp;]]>
											<span t-field="o.sample_id.size_id"/>   
										</t>
									<t t-else="">NA</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">NA</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">NA</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<!-- <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">NA</t> -->
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="3">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">NA</t>
								</td>

									<!-- <td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">NA</t>
										</td> -->
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<t t-if="data.aac_temp is not None">
											<span t-field="data.aac_temp"/>   °C
										</t>
									<t t-else="">NA</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="data.aac_humidity is not None">
											<span t-field="data.aac_humidity"/>   °C
										</t>
									<t t-else="">NA</t>
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">NA</t>
								</td>
								
							</tr>

							</table>
					</div>

					<div style="">
						<table style="margin-top:10px;">
						<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th style="text-align: center;">Sr. No</th>
									<th style="text-align: center;">
									<span t-esc="eln.material.test_parameter"/>
									<!-- Test Parameter -->
									</th>

                                    <th style="text-align: center;">
									<span t-esc="eln.material.result_remark"/>
									<!-- Test Result -->
									</th>

									<th style="text-align: center;">
									<span t-esc="eln.material.unit"/>
									<!-- Unit -->
									</th>

                                    <th style="text-align: center;"><span t-esc="eln.material.specifications"/></th>

									<th style="text-align: center;"><span t-esc="eln.material.method_reference"/></th>
									
								</tr>
							</thead>
							<tbody>

							<!-- Slump Test -->

								<tr t-if="data.slump_test_visible and (data.avg_slump_value_nabl == 'pass' and nabl or (data.avg_slump_value_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="slump" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','49f934a0-ebd7-478b-a11e-641d7babc9c0')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="slump.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_slump_value" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="slump.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="slump.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="slump.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- Density Test -->

								<tr t-if="data.density_visible and (data.avg_density_nabl == 'pass' and nabl or (data.avg_density_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="density" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','021ea043-8164-487b-8857-6aa4240a38df')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="density.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_density" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="density.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="density.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="density.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- Flow of Concrete of High Workability Test -->

								<tr t-if="data.flow_high_work_visible and (data.avg_flow_high_nabl == 'pass' and nabl or (data.avg_flow_high_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="flow_high_work" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','664503ee-02ac-48cf-88b0-a5e3bc33f290')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="flow_high_work.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_flow_high" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="flow_high_work.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="flow_high_work.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="flow_high_work.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- Wet Density Test -->

								<tr t-if="data.wet_density_visible and (data.avg_wet_density_nabl == 'pass' and nabl or (data.avg_wet_density_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="wet_density" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','d0855037-7ccd-4238-bc7b-674a40d40580')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="wet_density.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_wet_density" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="wet_density.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="wet_density.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="wet_density.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Flow Test of Fresh Cement Concrete -->

								<tr t-if="data.flow_test_visible and (data.avg_flow_test_nabl == 'pass' and nabl or (data.avg_flow_test_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="flow_test" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','c3cad715-b384-4ac6-955d-e4d3248a8bfb')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="flow_test.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.avg_flow_test" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="flow_test.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span>
											<t t-foreach="flow_test.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.permissable_limit"/>
												</t>
											</t>
										</span>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="flow_test.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								

					</tbody>
				</table>

			</div>
							


					


					<div style="page-break-inside: avoid;">
						<div style="margin-top:50px" class="noteContainer">
							<table >
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<!-- <div style="height:20px">

								</div> -->
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
						</div>
					</div>

				</div>
			</t>
		</t>
	</template>
</odoo>