<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="bitumenn_datasheet">
	
		<t t-call="web.html_container">
			 <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px">
                    BITUMEN
                </div>
				<div class="container_eln" style="margin-top:5px">

				 <table style="margin-top:20px">
				<tr cols="12">
					
                    
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>
				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                    <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                    </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>

					<!-- Penetration Value Of Bitumen -->

					<div  t-if="data.penetration_value_visible">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;margin-top: 15px">
							Penetration Value Of Bitumen
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" rowspan="2">Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" rowspan="2">Test Temp.(C)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="2">Dial Reading (0.1mm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" rowspan="2">Penetration (0.1mm)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" rowspan="2">Remarks</th>
								</tr>
								<tr style="background-color: #f0f0f0;">
								   <th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="1">Initial</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align:center;vertical-align:middle;" colspan="1">Final</th>

								</tr>		

							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.penetration_value_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="1">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="1">
										<span t-esc="r['test_temp']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="1">
										<span t-esc="r['dial_initial']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="1">
										<span t-esc="r['dial_final']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="1">
										<span t-esc="r['penetration']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="1">
										<span t-esc="r['remarks']" />
									</td>
									
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Penetration Value Of Bitumen :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.average_penetration" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>

						<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == 'b5ddbb0a-cdde-43b9-a42f-a7071028add5')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<div t-if="prep_result[0].technician.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
										</div>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>
					</div>
					</div>


					<!-- Specific Gravity -->

					<div t-if="data.specific_gravity_visible" style="margin-top:20px; page-break-before: always;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Specific Gravity
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Weight of Pycnometer (W1) g</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Weight of Pycnometer + Sample (W2) g</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Weight of Pycnometer + Sample + Water (W3) g</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Weight of Pycnometer + Water (W4) g</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Weight of Sample (W2-W1) g</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;" colspan="2">Specific Gravity</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.specific_water_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w1']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w2']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w3']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['w4']" />
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['sample_weight']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;" colspan="2">
										<span t-esc="r['specific_gravity']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Specific Gravity :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.avg_specific_gravity" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>

						<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == 'b13d2195-69e0-4a8c-b3d6-309e5ffcacc2')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<div t-if="prep_result[0].technician.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
										</div>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>
					</div>


					<!-- Determination Of Softening Point -->

					<div t-if="data.soft_point_visible" style="margin-top:20px; page-break-before: always;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Determination Of Softening Point
						</div>

						<table style="margin-top: 20px; width: 60%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Rate Of Heating :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.rate_of_heating"/>
								</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Period of Cooling at Room Tepmerature (min) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.soft_cool_temp"/>
								</td>
							</tr>
						</table>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;margin-top:10px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;width:33%;" >Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;width:33%;">Time (min)</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;width:33%;" >Temperature of Water Bath °C</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.soft_point_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;width:33%;" >
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;width:33%;" >
										<span t-esc="r['time_min']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;width:33%;" >
										<span t-esc="r['temperature']"/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: center; padding: 8px; border: 1px solid #ccc;">Description</td>
								<td colspan="6" style="text-align: center; padding: 8px; border: 1px solid #ccc;">Bill No.1 (°C)</td>
								<td colspan="6" style="text-align: center;padding: 8px; border: 1px solid #ccc;">Bill No.2 (°C)</td>
								<td colspan="6" style="text-align: center; padding: 8px; border: 1px solid #ccc;">Mean Value Of Softening Point</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: center; padding: 8px; border: 1px solid #ccc;">Temperature at which sample touches the bottom plate °C</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;text-align: center;">
									<span t-field="data.bill_no_1"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;text-align: center;">
									<span t-field="data.bill_no_2"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;text-align: center;">
									<span t-field="data.soft_mean_value" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
							
							
						</table>

						<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == '5ffca993-9538-40aa-80e4-dbbc43e2de42')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<div t-if="prep_result[0].technician.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
										</div>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>
					</div>

					<!-- Ductility Test -->

					<div t-if="data.ductility_visible" style="margin-top:20px; page-break-before: always;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Ductility Test
						</div>

						<table style="margin-top: 20px; width: 60%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Room Temperature (°C):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.room_temperature"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;"></td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Pouring Temperature (°C) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.pouring_temperature"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;"></td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Cooling In Atmosphere (min):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.cooling_atmosphere"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">(Spc: 30min to 40min):</td>
								
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Period of cooling in water bath before trimming (min):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.cooling_before_trim"/>
								</td><td colspan="6" style="padding: 8px; border: 1px solid #ccc;">(Spc: minimum 30min)</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Period of cooling in water bath after trimming (min):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.cooling_after_trim"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">(Spc: 85min to 95min)</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Actual Test Temperature (°C) :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.actual_test_temperature"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">(Spc: 25± 0.5°C)</td>
							</tr>
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">Rate Of Pull (mm/min):</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.rate_of_pull"/>
								</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">(Spc: 50± 2.5 mm/min)</td>
							</tr>
						</table>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;margin-top:10px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;width:25%;" >Sr No.</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;width:25%;">Initial Reading</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;width:25%;" >Final Reading</th>
									<th style="border: 1px solid #ccc; padding: 8px;text-align: center;width:25%;" >Ductility</th>
								</tr>
							</thead>
							<tbody>
								<t t-set="k" t-value="0"/>
								<tr t-foreach="data.ductility_line_ids" t-as="r" style="text-align: center;">
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;width:25%;" >
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;width:25%;" >
										<span t-esc="r['initial_reading']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;width:25%;" >
										<span t-esc="r['final_reading']"/>
									</td>
									<td style="border: 1px solid #ccc; padding: 6px;text-align: center;width:25%;" >
										<span t-esc="r['ductility']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
								</tr>
							</tbody>
						</table>

						<table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
							<tr style="font-weight: bold; background-color: #f9f9f9;">
								<td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Ductility :</td>
								<td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
									<span t-field="data.average_ductility" t-options='{"widget": "float", "precision": 2}'/>
								</td>
							</tr>
						</table>

						<div class="signatureContainer girdgird">
							<div>
								<div><b>Prepared By</b></div>
								<t t-set="prep_result" t-value="eln.parameters_result.filtered(lambda r: r.parameter.internal_id == '4f04739c-d930-49ee-8962-dbe8796fdf5b')[:1]"/>
								<t t-if="prep_result and prep_result[0].technician">
									<div style="height:40px">
										<div t-if="prep_result[0].technician.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + prep_result[0].technician.employee_id.signature.decode('utf-8')" style="max-width:200px;max-height:35px;margin-top:1px;z-index:-10;"/>
										</div>
									</div>
									<div><b><span t-esc="prep_result[0].technician.name"/></b></div>
									<div><b>(<span t-esc="prep_result[0].technician.employee_id.job_title"/>)</b></div>
								</t>
							</div>
							<div style="margin-left:600px">
								<div><b>Checked By</b></div>
								<div><b><span t-esc="eln.sample_id.approved_by.name"/></b></div>
								<div><b>(<span t-esc="eln.sample_id.approved_by.job_title"/>)</b></div>
							</div>
						</div>
					</div>


					<!-- Absolute Viscosity -->
					<div t-if="data.absolute_vis_visible" style="margin-top:20px; page-break-before: always;">
					<div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
							Absolute Viscosity
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0;">
