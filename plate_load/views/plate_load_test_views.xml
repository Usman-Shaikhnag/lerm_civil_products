<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- FORM VIEW -->
        <record id="view_plate_load_test_form" model="ir.ui.view">
            <field name="name">lerm.plate.load.test.form</field>
            <field name="model">lerm.plate.load.test</field>
            <field name="arch" type="xml">
                <form string="Plate Load Test">
                    <header>
                        <button name="open_form"
                                type="object"
                                string="Open Plate Load Form"
                                class="btn-primary"/>
                    </header>
                    <sheet>

                        <!-- TITLE -->
                        <div class="oe_title">
                            <h1>
                                <field name="project_name" placeholder="Project Name"/>
                            </h1>
                        </div>

                        <!-- PROJECT DETAILS -->
                        <group string="Project Details" col="4">

                            <field name="site_address" readonly="1" colspan="4"/>

                            <field name="test_start_date" readonly="1"/>
                            <field name="test_end_date" readonly="1"/>

                            <field name="location"/>
                            <field name="strata"/>

                            <field name="plate_size" readonly="1"/>
                            <field name="concessionaire"/>

                            <field name="pmc_name" colspan="4"/>

                            <field name="epc_contractor" readonly="1"/>
                            <field name="letter_dated"/>

                            <field name="discipline" readonly="1"/>
                            <field name="group" readonly="1"/>

                            <field name="references" readonly="1"/>
                            <field name="test_name" readonly="1"/>

                            <field name="report_no"/>
                            <field name="report_issue_date"/>

                        </group>


                        <!-- HIDDEN -->
                        <group invisible="1">
                            <field name="eln_ref"/>
                            <field name="srf_id"/>
                            <field name="sample_id"/>
                        </group>

                        <notebook>
                            <page string="Contents">
                                <field name="contents_ids">
                                    <tree editable="bottom">
                                        <field name="sr_no"/>
                                        <field name="item"/>
                                        <field name="page"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>

                        <!-- SUMMARY -->
                        <group string="Summary">
                            <field name="safe_bearing_capacity"/>
                            <field name="factor_of_safety"/>
                            <field name="ultimate_bearing_capacity"/>
                            <field name="max_load_intensity"/>
                            <field name="allowable_bearing_capacity"/>
                            <field name="total_settlement"/>
                        </group>


                        <!-- SIGNATURES -->
                        <group string="Signatures" col="2">
                            <group string="Checked By">
                                <field name="checked_by_name"/>
                                <field name="checked_by_title"/>
                            </group>

                            <group string="Approved By">
                                <field name="approved_by_name"/>
                                <field name="approved_by_title"/>
                            </group>
                        </group>


                        <!-- ANNEXURES -->
                        <group string="Annexures">

                            <field name="graph"/>
                            <field name="image_sections" widget="json"/>

                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="view_plate_load_test_tree" model="ir.ui.view">
            <field name="name">lerm.plate.load.test.tree</field>
            <field name="model">lerm.plate.load.test</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="project_name"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>