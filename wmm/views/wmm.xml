<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_wmm_form" model="ir.ui.view">
        <field name="name">mechanical.wmm.form</field>
        <field name="model">mechanical.wmm</field>
        <field name="arch" type="xml">
            <form string="Your form views" create="false">


                <sheet>
                <div>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    </div>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>





                        <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>




                    <div class="custom_table_borders" >
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>
                    



                 <!-- Dry Gradation -->
                 <div>
                        <h1>
                            <field name="dry_gradation_name" readonly="1" nolabel="1"/>
                            <field name="dry_gradation_visible" invisible="1"/>
                        </h1>
                    </div>
                   <group/>
             
          
             
                    <div class="custom_table_borders">
                        <field name="dry_gradation_table" colspan="2" nolabel="1">
                        <tree editable="bottom">
                          <field name="sieve_size"/>
                          <field name="wt_retained" class="blue-input" decoration-info="wt_retained != 0"/>
                          <field name="percent_retained" class="blue-input" decoration-info="percent_retained != 0"/>
                          <field name="cumulative_retained" readonly="1"/>
                          <field name="passing_percent" readonly="1"/>
                          </tree>
                          </field>
                    </div>

                    <div>
                    <button type="object" name="calculate_sieve" class="btn btn-primary">
                            <i class="fa fa-calculator mr-1"/> Calculate
                        </button>
                        <!-- <button string="Calculate" type="object" name="calculate_sieve" class="oe_highlight"/> -->
                    </div>
                    <group/>

                    <div>
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                          <tr>
                            <td><span>Total</span></td>
                            <td><field name="total_sieve_analysis"/></td>
                          </tr>
                          </tbody>
                           </table>
                    </div>
                    <group/>
                    <group/>


                    <!-- <group>
                        <group>
                            <field name="total_sieve_analysis"/>
                        </group>
                    </group> -->


                    


                    <!-- Water Absorption -->
                    <div>
                        <h1>
                            <field name="water_absorbtion_name" readonly="1" nolabel="1"/>
                            <field name="water_absorbtion_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <div>
                    <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                    <tbody>
                      <tr>
                        <td><span>Weight of saturated surface dry (SSD) sample in air in gms, A</span></td>
                        <td><field name="wt_ssd_sample" class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span> Oven dried weight of sample in gms, C</span></td>
                        <td> <field name="oven_dried_wt" class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span>Water absorption %</span></td>
                        <td> <field name="water_absorbtion"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>
                    <group/>
                    <group/>

                    <div>
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                        <tbody>
                           <tr>
                             <td><span>Conformity</span></td>
                              <td><field name='water_absorbtion_conformity' col="1"
                                           decoration-success="water_absorbtion_conformity == 'pass'" 
                                           decoration-danger="water_absorbtion_conformity == 'fail'" 
                                           readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field name='water_absorbtion_nabl' col="1"/></td>
                           </tr>
                           </tbody>
                     
                          </table>
                      </div>
                      <group/>

                      <!-- Elongation and Flakiness Index -->


                <div modifiers='{"invisible": [["|", ["elongation_visible", "=", false], ["flakiness_visible", "=", false]]]}'>
                        <h1>
                            <field name="elongation_name" readonly="1" nolabel="1"/>
                            <field name="elongation_visible" invisible="1"/>
                            <field name="flakiness_visible" invisible="1"/>
                        </h1>
                    </div>
                    <group/>

                    <group modifiers='{"invisible": [["|", ["elongation_visible", "=", false], ["flakiness_visible", "=", false]]]}'>
                        <field name="elongation_table" colspan="2" nolabel="1">
                        <tree editable="bottom" class="table-bordered o_list_view">
                          <field name="sieve_size"/>
                          <field name="wt_retained" class="blue-input" decoration-info="wt_retained != 0"/>
                          <field name="elongated_retained" class="blue-input" decoration-info="elongated_retained != 0"/>
                          <field name="flakiness_retained" class="blue-input" decoration-info="flakiness_retained != 0"/>
                        </tree>
                        </field>
                    </group>

                    <div style="display:flex;">
                  
                      <div style="width:50%;">
                          <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                          <tbody>
                          <tr>
                            <td><span>Total</span></td>
                            <td><field name="total_wt_retained_fl_el"/></td>
                           </tr>
                           <tr>
                            <td><span>Total Elongation</span></td>
                            <td><field name="total_elongated_retained"/></td>
                           </tr>
                          <tr>
                            <td><span>Total Flakiness</span></td>
                            <td><field name="total_flakiness_retained"/></td>
                           </tr>
                           <tr>
                             <td><span>	Flakiness Conformity</span></td>
                              <td><field  name="aggregate_flakiness_conformity"
                                        decoration-success="aggregate_flakiness_conformity == 'pass'" 
                                        decoration-danger="aggregate_flakiness_conformity == 'fail'" 
                                        readonly="1" string="Flakiness Conformity"/>
                            </td>
                           </tr>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field  name="aggregate_flakiness_nabl" /></td>
                           </tr>
                     </tbody>
                          </table>
                      </div>

                      <div style="width:50%;">
                             <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                             <tbody>
                          <tr>
                            <td><span>Aggregate Elongation Value in %</span></td>
                            <td><field name="aggregate_elongation"/></td>
                           </tr>
                           <tr>
                            <td><span>Aggregate Flakiness Value in %</span></td>
                            <td><field name="aggregate_flakiness"/></td>
                           </tr>
                          <tr>
                            <td><span>Aggregate Elongation And Flakiness Value in %</span></td>
                            <td><field name="aggregate_combine"/></td>
                           </tr>
                           <tr>
                             <td><span>Elongation Conformity</span></td>
                              <td><field  name="aggregate_elongation_conformity"
                                        decoration-success="aggregate_elongation_conformity == 'pass'" 
                                        decoration-danger="aggregate_elongation_conformity == 'fail'" 
                                        readonly="1" string="Elongation Conformity" />
                                        </td>
                           </tr>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field  name="aggregate_elongation_nabl" /></td>
                           </tr>
                        </tbody>
                          </table>
                      </div>
                      </div>

                      <group/>



                    <!-- Impact Value  -->
                    <div>
                        <h1>
                            <field name="impact_value_name" readonly="1" nolabel="1"/>
                            <field name="impact_visible" invisible="1"/>

                        </h1>
                    </div>
                    <group/>

                    <div class="custom_table_borders">
                    <field name="impact_value_child_lines" nolabel="1" colspan="2">
                            <tree editable="bottom" >
                                <field name='sample_no'/>
                                <field name='wt_of_cylinder' class="blue-input" decoration-info="wt_of_cylinder != 0"/>
                                <field name='total_wt_of_dried' class="blue-input" decoration-info="total_wt_of_dried != 0"/>
                                <field name='total_wt_aggregate'/>
                                <field name='wt_of_aggregate_passing' class="blue-input" decoration-info="wt_of_aggregate_passing != 0"/>
                                <field name='wt_of_aggregate_retained'/>
                                <field name='impact_value'/>
                            </tree>
                           
                    </field> 
                    </div>

                    <div>
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                        <tbody>
                          <tr>
                            <td><span>Average Impact Value</span></td>
                            <td> <field name='average_impact_value'/></td>
                           </tr>
                           <tr>
                             <td><span>Conformity</span></td>
                              <td><field name='average_impact_value_conformity' col="1"
                                           decoration-success="average_impact_value_conformity == 'pass'" 
                                           decoration-danger="average_impact_value_conformity == 'fail'" 
                                           readonly="1"/>
                            </td>
                           </tr>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field name='average_impact_value_nabl' col="1"/></td>
                           </tr>
                     </tbody>
                          </table>
                      </div>
                      <group/>


                <!-- Abrasion Value  -->
                <div>
                        <h1>
                            <field name="abrasion_value_name" readonly="1" nolabel="1"/>
                            <field name="abrasion_visible" invisible="1"/>

                        </h1>
                </div>
                <group/>

                <div>
                    <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                    <tbody>
                    <tr>
                        <td><span>Total weight of Sample in gms</span></td>
                        <td><field name="total_weight_sample_abrasion"  class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span>Weight of Passing sample in 1.70 mm IS sieve in gms</span></td>
                        <td><field name="weight_passing_sample_abrasion"  class="blue-input"/></td>
                      </tr>
                      <tr>
                        <td><span> Weight of Retain sample in 1.70 mm IS sieve in gms</span></td>
                        <td><field name="weight_retain_sample_abrasion"/></td>
                      </tr>
                      <tr>
                        <td ><span>Abrasion Value (%)</span></td>
                        <td> <field name="abrasion_value_percentage"/></td>
                      </tr>
                      </tbody>
                    </table>
                    </div>
                    <group/>
                    
                    <group/>

                    <div>
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                        <tbody>
                           <tr>
                             <td><span>Conformity</span></td>
                              <td><field name='abrasion_value_percentage_conformity' col="1"
                                           decoration-success="abrasion_value_percentage_conformity == 'pass'" 
                                           decoration-danger="abrasion_value_percentage_conformity == 'fail'" 
                                           readonly="1"/>
                            </td>
                           </tr>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field name='abrasion_value_percentage_nabl' col="1"/></td>
                           </tr>
                     </tbody>
                          </table>
                      </div>
                      <group/>



                <!-- Liquid Limit -->
               <div >
                        <h1>
                            <field name="liquid_limit_name" readonly="1" nolabel="1"/>
                            <field name="liquid_limit_visible" invisible="1"/>

                        </h1>
                </div>
                <group/>

                <div class=" custom_table_borders">
                    <field name="liquid_limit_table" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='container_no'/>
                                <field name='blows' class="blue-input" decoration-info="blows != 0"/>
                                <field name='mass_wet_sample_container' class="blue-input" decoration-info="mass_wet_sample_container != 0"/>
                                <field name='mass_dry_sample_container' class="blue-input" decoration-info="mass_dry_sample_container != 0"/>
                                <field name='mass_container' class="blue-input" decoration-info="mass_container != 0"/>
                                <field name='mass_moisture' class="blue-input" decoration-info="mass_moisture != 0"/>
                                <field name='mass_dry_sample' class="blue-input" decoration-info="mass_dry_sample != 0"/>
                                <field name='moisture_percent' class="blue-input" decoration-info="moisture_percent != 0"/>
                            </tree>      
                    </field> 
                </div>
                    <!-- <group attrs="{'invisible': [('liquid_limit_visible', '=', False)]}">
                        <field name="liquid_limit"/>
                       
                    </group> -->

                    <group style="width:50%;white-space:nowrap;">
                        <field name="are_child_lines_filled" invisible="1"/>
                        <button type="object" string="Calculate Liquid Limit" name="liquid_calculation" class="btn btn-primary" invisible="not are_child_lines_filled">
                            <i class="fa fa-calculator mr-1"/> Calculate
                        </button>
                        <!-- <button string="Calculate Liquid Limit" name="liquid_calculation" type="object" class="oe_highlight" 
                                invisible="not are_child_lines_filled" /> -->
                     </group>
                     <group/>

                     <div style="display:flex;">

                    <div style="width:50%;">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                        <tbody>
                           <tr>
                           <td><span>Liquid Limit</span></td>
                            <td><field name="liquid_limit" class="blue-input"/></td>
                           </tr>
                     </tbody>
                          </table>
                </div>

                      <div style="width:50%;" >
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                        <tbody>
                           <tr>
                           <td><span>Remarks</span></td>
                            <td><field name="remarks_liquid_limit" class="blue-input"/></td>
                           </tr>
                     </tbody>
                          </table>
                </div>
                </div>
                <group/>



                <div style="display:flex;">
                <div style="width:50%">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%">
                        <tbody>
                           <tr>
                             <td><span>Conformity</span></td>
                              <td><field name='liquid_limit_conformity' col="1"
                                           decoration-success="liquid_limit_conformity == 'pass'" 
                                           decoration-danger="liquid_limit_conformity == 'fail'" 
                                           readonly="1"/>
                            </td>
                           </tr>
                           </tbody>
                          </table>
                      </div>

                      <div style="width:50%">
                          <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                        <tbody>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field name='liquid_limit_nabl' col="1"/></td>
                           </tr>
                     </tbody>
                          </table>
                      </div>
                      </div>
                      <group/>


                <!-- Plastic Limit -->
                <div>
                      <h1>
                        <field name="plastic_name" readonly="1" nolabel="1"/>
                        <field name="plastic_visible" invisible="1"/>
                      </h1>
                </div>
                <group/>

                <div class=" custom_table_borders">
                    <field name="plastic_table" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name='container_no'/>
                                <field name='mass_wet_sample_container' class="blue-input" decoration-info="mass_wet_sample_container != 0"/>
                                <field name='mass_dry_sample_container' class="blue-input" decoration-info="mass_dry_sample_container != 0"/>
                                <field name='mass_container' class="blue-input" decoration-info="mass_container != 0"/>
                                <field name='mass_moisture' class="blue-input" decoration-info="mass_moisture != 0"/>
                                <field name='mass_dry_sample' class="blue-input" decoration-info="mass_dry_sample != 0"/>
                                <field name='moisture_percent' class="blue-input" decoration-info="moisture_percent != 0"/>
                            </tree>     
                    </field> 
                </div>

                <div>
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                        <tbody>
                           <tr>
                             <td><span>Average</span></td>
                              <td> <field name="average_plastic_moisture" class="blue-input"/>
                            </td>
                           </tr>
                           <tr>
                            <td><span>Remarks</span></td>
                            <td><field name="remarks_plastic" class="blue-input"/></td>
                           </tr>
                           </tbody>
                          </table>
                      </div>
                      <group/>

                   
                      <group/>

                      <div>
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                        <tbody>
                        <tr>
                             <td><span>Plasticity Index</span></td>
                              <td><field name="plasticity_index"/>
                            </td>
                           </tr>
                           <tr>
                             <td><span>Conformity</span></td>
                              <td><field name='plasticity_index_conformity' col="1"
                                           decoration-success="plasticity_index_conformity == 'pass'" 
                                           decoration-danger="plasticity_index_conformity == 'fail'" 
                                           readonly="1"/>
                            </td>
                           </tr>
                           <tr>
                            <td><span>NABL</span></td>
                            <td><field name='plasticity_index_nabl' col="1"/></td>
                           </tr>
                           </tbody>
                          </table>
                      </div>
                      <group/>



                      
               




                <!-- Density Relation Heavy Compaction  -->
                <div >
                        <h1>
                            <field name="density_relation_name" readonly="1" nolabel="1"/>
                            <field name="density_relation_visible" invisible="1"/>

                        </h1>
                </div>
                <group/>

                <div>
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                        <tbody>
                           <tr>
                             <td><span>Weight of Mould in gm</span></td>
                              <td><field name="wt_of_modul" class="blue-input"/>
                            </td>
                           </tr>
                           <tr>
                            <td><span>Volume of Mould in cc</span></td>
                            <td><field name="vl_of_modul" class="blue-input"/></td>
                           </tr>
                           </tbody>
                          </table>
                      </div>
                      <group/>

               

                <div class=" custom_table_borders" >
                    <field name="density_relation_table" nolabel="1" colspan="2" >
                            <tree editable="bottom">
                                <field name='determination_no'/>
                                <field name='wt_of_modul_compact' class="blue-input" decoration-info="wt_of_modul_compact != 0"/>
                                <field name='wt_of_compact' class="blue-input" decoration-info="wt_of_compact != 0"/>
                                <field name='bulk_density' class="blue-input" decoration-info="bulk_density != 0"/>
                                <field name='container_no' class="blue-input" decoration-info="container_no != 0"/>
                                <field name='wt_of_container' class="blue-input" decoration-info="wt_of_container != 0"/>
                                <field name='wt_of_container_wet' class="blue-input" decoration-info="wt_of_container_wet != 0"/>
                                <field name='wt_of_container_dry' class="blue-input" decoration-info="wt_of_container_dry != 0"/>
                                <field name='wt_of_dry_sample' class="blue-input" decoration-info="wt_of_dry_sample != 0"/>
                                <field name='wt_of_moisture' class="blue-input" decoration-info="wt_of_moisture != 0"/>
                                <field name='moisture' class="blue-input" decoration-info="moisture != 0"/>
                                <field name='dry_density' class="blue-input" decoration-info="dry_density != 0"/>
                            </tree>
                    </field> 
                    </div>

                    <group/>

                    <group >
                    <field name="chart_image_density" widget="image" readonly="1" />
                    </group>
                
                


                <!-- CBR -->
                <div >
                        <h1>
                            <field name="cbr_name" readonly="1" nolabel="1"/>
                            <field name="cbr_visible" invisible="1"/>

                        </h1>
                </div>
                <group/>

                <div class=" custom_table_borders">
                    <field name="cbr_table" nolabel="1" colspan="2" >
                            <tree editable="bottom">
                                <field name='penetration' class="blue-input" decoration-info="penetration != 0"/>
                                <field name='proving_reading' class="blue-input" decoration-info="proving_reading != 0"/>
                                <field name='load'/>
                            </tree>      
                    </field> 
                </div>

                <group >
                    <field name="chart_image_cbr" widget="image" readonly="1"/>
                </group>

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                  <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"/>

          </sheet>
                </form>
            </field>
        </record>
        

        <record id="view_wmm_prefill_data_form" model="ir.ui.view">
            <field name="name">wmm.prefill.data.form</field>
            <field name="model">wmm.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wmm_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wmm.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_wmm_prefill_data_form"/>
            <field name="target">new</field>
        </record>
    </data>
    
</odoo>
