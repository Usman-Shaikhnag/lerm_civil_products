<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_concrete_core_density_view" model="ir.ui.view">
        <field name="name">mechanical.concrete.core.density.form</field>
        <field name="model">mechanical.concrete.core.density</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                 <div>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1" />
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="grade" exception="grade"  string="Grade" identity="extra"/>   
                        <field name="eln_state" />
                    </group>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                     <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                      <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="date_of_casting"></label></td>
                                    <td><field name="date_of_casting" /></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        
                        </div>
                   
                   
                    

                        <field name="child_lines_core_density" nolabel="1" class="custom_table_borders">
                            <tree editable="bottom">
                                <field name="sr_no" />
                                <field name="id_location" class="blue-input" decoration-info="id_location != 0"/>
                                <field name="weight" class="blue-input" decoration-info="weight != 0"/>
                                <field name="daimeter" class="blue-input" decoration-info="daimeter != 0"/>
                                <field name="height" class="blue-input" decoration-info="height != 0"/>
                                <field name="volume"/>
                                <field name="density" />
                              
                            </tree>
                    </field>

                     <div class="d-flex gap-2" >
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label for="average_core_density"></label></td>
                                    <td><field name="average_core_density" /></td>
                                </tr>
                                
                            </tbody>
                        </table>
                        </div>

                    <div >
                          <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                          <tbody>
                           <tr>
                            <td><label for="average_core_density_conformity"></label></td>
                            <td><field name='average_core_density_conformity'
                               decoration-success="average_core_density_conformity == 'pass'" 
                               decoration-danger="average_core_density_conformity == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="average_core_density_nabl"></label></td>
                            <td><field name='average_core_density_nabl'
                               decoration-success="average_core_density_nabl == 'pass'" 
                               decoration-danger="average_core_density_nabl == 'fail'" 
                               readonly="1"/></td>
                           </tr>
                           </tbody>                     
                          </table>
                      </div> 
                    
                      <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                        
                        <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
    </record>
  
    
    </data>
</odoo>