										<span>
											<t t-foreach="moisture.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Density -->
								<tr t-if="data.density_visible and (data.density_nabl == 'pass' and nabl or (data.density_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="density" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','254879sw-4ef4-4e51-abeb-57dd2abe29a4')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="density.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_density" t-options='{"widget": "float", "precision": 2}'/>
