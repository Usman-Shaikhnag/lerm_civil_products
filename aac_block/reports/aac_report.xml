												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Moisture Content -->
								<tr t-if="data.moisture_visible and (data.moisture_nabl == 'pass' and nabl or (data.moisture_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="moisture" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','6478fde2-8097-4275-b80f-48ebdbcfe244')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="moisture.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_moisture_content" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="moisture.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span t-field="data.moisture_grade1"/>
									</td>

									<td style="text-align: center;">
										<span t-field="data.moisture_grade2"/>
									</td>


