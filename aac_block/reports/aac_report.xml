										<span t-field="data.density_grade1"/>
									</td>

									<td style="text-align: center;">
										<span t-field="data.density_grade2"/>
									</td>

									
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="density.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>


								<!-- Drying Shrinkage -->
								<tr t-if="data.drying_shrinkage_visible and (data.drying_shrinkage_aac_nabl == 'pass' and nabl or (data.drying_shrinkage_aac_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="drying" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','214578ews-b1a2-4dac-b8cb-e077770af52f')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="drying.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_drying_shrinkage" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="drying.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span t-field="data.drying_grade1"/>
									</td>

									<td style="text-align: center;">
										<span t-field="data.drying_grade2"/>
									</td>

									
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="drying.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								<!-- Compressive Strength -->
								<tr t-if="data.compressive_strength_visible and (data.compressive_strength_nabl == 'pass' and nabl or (data.compressive_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
									<t t-set="compressive" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','21457896dfe-cb61-45db-91c5-0167b27a9ab5')])"/>
									
									<td style="text-align: center;">
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</td>
									<td >
									
										<span t-field="compressive.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-field="compressive.unit.name"/>
										</span>
									</td>
									
									
									<td style="text-align: center;">
										<span t-field="data.compressive_grade1"/>
									</td>

									<td style="text-align: center;">
										<span t-field="data.compressive_grade2"/>
									</td>

									
                                    <td style="text-align: center;">
										<span>
											<t t-foreach="compressive.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

								
							</tbody>
						</table>

				</div>  


					<div style="page-break-inside: avoid;">
						<div style="margin-top:50px" class="noteContainer">
							<table >
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<!-- <div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div> -->
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<!-- <div style="height:20px">

								</div> -->
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
						</div>
					</div>

				</div>
			</t>
		</t>
	</template>
</odoo>