						<t t-set="i" t-value="0"/>
							<thead>
								<tr>
									<th rowspan="2" style="text-align: center;">Sr. No</th>
									<th rowspan="2" style="text-align: center;">
									<span  t-esc="eln.material.test_parameter"/>
									<!-- Test Parameter -->
									</th>

                                    <th rowspan="2" style="text-align: center;">
									<span t-esc="eln.material.result_remark"/>
									<!-- Test Result -->
									</th>

									<th rowspan="2" style="text-align: center;">
									<span t-esc="eln.material.unit"/>
									<!-- Unit -->
									</th>

                                    <!-- <th style="text-align: center;"><span t-esc="eln.material.specifications"/></th> -->
									<td colspan="2" style="text-align: center;"> Limit As per
								       <span t-field="eln.material.specifications"></span>
							        </td>

									<th rowspan="2" style="text-align: center;"><span t-esc="eln.material.method_reference"/></th>
									
								</tr>
								<tr>

						        	<td  style=" text-align: center; vertical-align: middle;">Grade - 1
								   </td>
							       <td style=" text-align: center; vertical-align: middle;">Grade - 2
								  </td>
							    </tr>
							</thead>
							<tbody>  

							<t t-set="show_length" t-value="data.average_length_nabl == 'pass' and nabl or (data.average_length_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl"/>

                            <t t-set="show_width" t-value="data.average_width_nabl == 'pass' and nabl or (data.average_width_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl"/>

							<t t-set="show_heigth" t-value="data.average_height_nabl == 'pass' and nabl or (data.average_height_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl"/>

                            <!-- 🔹 Step 2: Rowspan calculation -->
					      <t t-set="rowspan_count" t-value="1 + int(show_length) + int(show_width) + int(show_heigth)"/>

                          <tr t-if="data.dimension_visible and (show_length or show_width or show_heigth)">

									<t t-set="dimension" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','12478fdr3w-ac79-4102-aeda-622dc0f973f6')])"/>
									
									<td t-att-rowspan="rowspan_count"  style="text-align: center;vertical-align:middle;">
						                 <span t-esc="i + 1"/>
							             <t t-set="i" t-value="i+1"/>
						            </td>
									<td colspan="6">
										<span t-esc="dimension.parameter_name"/>
									</td>
								</tr>

					
                             <!-- Length -->
							 <tr t-if="data.dimension_visible and show_length">
									<t t-set="length" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','42ea2fdb-c7be-4d19-8912-63f72c07574f')])"/>
									
									<td>
										<span t-esc="length.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_length" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="length.unit.name"/>
										</span>
									</td>

									<td style="text-align: center;">
										<span t-field="data.length_grade1"/>
									</td>
									<td style="text-align: center;">
										<span t-field="data.length_grade2"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<t t-foreach="length.parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
													<span t-field="parameter.specification"/>
												</t>
											</t>
										</span>
									</td>
									
								</tr>

							<!-- Width -->
							<tr t-if="data.dimension_visible and show_width">
									<t t-set="width" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','b3751088-d3ed-4e07-9546-de0e4bd26b0f')])"/>
									
									<td>
										<span t-esc="width.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_width" t-options='{"widget": "float", "precision": 2}'/>
										</span>
