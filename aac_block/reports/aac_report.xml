									<td>
										<span t-esc="height.parameter_name"/>
									</td>

                                    <td style="text-align: center;">
										<span>
											<span t-field="data.average_height" t-options='{"widget": "float", "precision": 2}'/>
										</span>
									</td>

									<td style="text-align: center;">
										<span>
											<span t-esc="height.unit.name"/>
										</span>
									</td>

									<td style="text-align: center;">
										<span t-field="data.height_grade1"/>
									</td>

									<td style="text-align: center;">
										<span t-field="data.height_grade2"/>
									</td>

                                    <td style="text-align: center;">
