<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_aac_block_form" model="ir.ui.view">
        <field name="name">mechanical.aac.block.form</field>
        <field name="model">mechanical.aac.block</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>

                <div>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                </div>
                <button type="object" class="oe_highlight" name="prefill_data" string="Prefill Data"/>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <!-- <field name="grade"/> -->
                        <field name="eln_state" />

                    </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>
                    <group/>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="temprature"></label></td>
                                    <td><field name="temprature" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="humidity"></label></td>
                                    <td><field  name="humidity" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>



                     <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="grade_type"></label></td>
                                    <td><field name="grade_type" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="size"></label></td>
                                    <td><field  name="size" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" >
                            <tbody>
                                <tr>
                                    <td><label for="condition"></label></td>
                                    <td><field name="condition" class="blue-input"/></td>
                                </tr>
                                
                            </tbody>
                        </table>

                        <table class="table table-sm o_form_table table-bordered custom_table_borders">
                            <tbody>
                                
                                    <tr>
                                    <td><label for="description_work"></label></td>
                                    <td><field  name="description_work" class="blue-input" /></td>
                                </tr>
                              
                                
                            </tbody>
                        </table>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>
                    
                    <!-- Dimension -->

                    <group invisible="not dimension_visible">
                        <h1>
                            <field name="dimension_name" readonly="1" nolabel="1"/>
                            <field name="dimension_visible" invisible="1"/>
                        </h1>
                    </group>
                    <div class="custom_table_borders" invisible="not dimension_visible">
                        <field name="dimension_table" nolabel="1" >
                        <tree editable="bottom">
                          <field name="length" class="blue-input" decoration-info="length != 0"/>
                          <field name="width" class="blue-input" decoration-info="width != 0"/>
                          <field name="height" class="blue-input" decoration-info="height != 0"/>
                        </tree>
                        </field>
                    </div>

                    
                    <div style="display:flex;"  invisible="not dimension_visible">
                    <div style="width:33%;">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="average_length">Average Length</label></td>
                                    <td><field name="average_length"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="width:33%;"  invisible="not dimension_visible">
                      <table class="table table-sm o_form_table table-bordered  custom_table_borders" style="width:98%;">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="average_width">Average Width</label></td>
                                    <td><field name="average_width"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="width:34%;"  invisible="not dimension_visible">
                     <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="average_height">Average Height</label></td>
                                    <td><field name="average_height"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    </div>


                   <div class="d-flex gap-2"  invisible="not dimension_visible">
                         <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="average_width_conformity"> Conformity</label></td>
                                <td>
                                    <field name="average_width_conformity"
                                        decoration-success="average_width_conformity == 'pass'"
                                        decoration-danger="average_width_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_length_nabl"> NABL</label></td>
                                <td>
                                    <field name="average_length_nabl"
                                        decoration-success="average_length_nabl == 'pass'"
                                        decoration-danger="average_length_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                         <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="average_height_conformity"> Conformity</label></td>
                                <td>
                                    <field name="average_height_conformity"
                                        decoration-success="average_height_conformity == 'pass'"
                                        decoration-danger="average_height_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_width_nabl"> NABL</label></td>
                                <td>
                                    <field name="average_width_nabl"
                                        decoration-success="average_width_nabl == 'pass'"
                                        decoration-danger="average_width_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered w-50 mt-2 custom_table_borders" >
                        <tbody>
                           
                            <tr>
                                <td><label class="fw-bold" for="average_height_conformity"> Conformity</label></td>
                                <td>
                                    <field name="average_height_conformity"
                                        decoration-success="average_height_conformity == 'pass'"
                                        decoration-danger="average_height_conformity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="average_height_nabl"> NABL</label></td>
                                <td>
                                    <field name="average_height_nabl"
                                        decoration-success="average_height_nabl == 'pass'"
                                        decoration-danger="average_height_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                       
                    </div>

                    <div style="display:flex;"  invisible="not dimension_visible">
                    <div style="width:33%;">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="length_grade1"></label></td>
                                    <td><field name="length_grade1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="width:33%;"  invisible="not dimension_visible">
                      <table class="table table-sm o_form_table table-bordered  custom_table_borders" style="width:98%;">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="width_grade1"></label></td>
                                    <td><field name="width_grade1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="width:34%;"  invisible="not dimension_visible">
                     <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                            <tbody>
                                <tr>
                                    <td><label class="text-bold" for="height_grade1"></label></td>
                                    <td><field name="height_grade1"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    </div>

                   

                  
                    
                    

                  

                    <!-- Block Density  -->
                    <group invisible="not density_visible">
                        <h1>
                            <field name="density_name" readonly="1" nolabel="1"/>
                            <field name="density_visible" invisible="1"/>
                        </h1>
                    </group>

                   

                   
                    <div class="custom_table_borders" invisible="not density_visible">
                        <field name="density_table"  nolabel="1" colspan="2">
                        <tree editable="bottom">
                          <field name="length"   class="blue-input" decoration-info="length != 0"/>
                          <field name="width" class="blue-input" decoration-info="width != 0"/>
                          <field name="height" class="blue-input" decoration-info="height != 0"/>
                          <field name="volume" width="25%"/>
                          <field name="initial_wt" class="blue-input" decoration-info="initial_wt != 0" width="25%"/>
                          <field name="dry_wt" class="blue-input" decoration-info="dry_wt != 0" width="25%"/>
                          <field name="density" string="Average Density Kg/cm3"  width="25%"/>
                          <field name="moisture"  width="25%"/>
                        </tree>
                        </field>
                    </div>

                    <div style="width:60%" invisible="not density_visible">
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders" >
                         <tbody>
                         <tr>
                           <td><label for="average_density" class="text-bold">Average </label></td>
                           <td><field name="average_density"/></td>
                          </tr>
                           <tr>
                            <td><label for="density_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="density_confirmity"
                                        decoration-success="density_confirmity == 'pass'" 
                                        decoration-danger="density_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="density_nabl" class="text-bold">NABL</label></td>
                           <td><field name="density_nabl"
                                        decoration-success="density_nabl == 'pass'" 
                                        decoration-danger="density_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>

                        <div style="display:flex;" invisible="not density_visible">                        
                       <div style="width:50%">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                         <tbody>
                           <tr>
                           <td><label for="density_grade1" class="text-bold">Specification </label></td>
                           <td><field name="density_grade1" class="blue-input"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>

                     
                      </div>


                   
                    <group/>

                  

                 

                <!-- Compressive Strength -->

                <div invisible="not compressive_strength_visible">
                        <h1>
                            <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                            <field name="compressive_strength_visible" invisible="1"/>
                        </h1>
                    </div>

                    <div class="custom_table_borders" invisible="not compressive_strength_visible">
                        <field name="compressive_strength_table" nolabel="1" >
                        <tree editable="bottom">
                          <field name="length" class="blue-input" decoration-info="length != 0"/>
                          <field name="breadth" class="blue-input" decoration-info="breadth != 0" string="Width (mm)"/>
                          <field name="height" class="blue-input" decoration-info="height != 0"/>
                          <field name="area" class="blue-input" decoration-info="area != 0"  width="20%"/>
                          <field name="aac_load" class="blue-input" decoration-info="aac_load != 0"/>
                          <field name="compressive_strength" width="25%"/>
                           <field name="kg_cm"/>
                        </tree>
                        </field>
                    </div>

                    <div style="width:60%" invisible="not compressive_strength_visible">
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders" >
                         <tbody>
                         <tr>
                           <td><label for="average_compressive_strength" class="text-bold">Average Compressive Strength</label></td>
                           <td><field name="average_compressive_strength"/></td>
                          </tr>
                           <tr>
                            <td><label for="compressive_strength_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="compressive_strength_confirmity"
                                        decoration-success="compressive_strength_confirmity == 'pass'" 
                                        decoration-danger="compressive_strength_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="compressive_strength_nabl" class="text-bold">NABL</label></td>
                           <td><field name="compressive_strength_nabl"
                                        decoration-success="compressive_strength_nabl == 'pass'" 
                                        decoration-danger="compressive_strength_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>

                        <div style="display:flex;" invisible="not compressive_strength_visible">                        
                       <div style="width:50%">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                         <tbody>
                           <tr>
                           <td><label for="compressive_grade1" class="text-bold">Specification</label></td>
                           <td><field name="compressive_grade1" class="blue-input"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>

                      
                      </div>

                        <!-- Drying Shrinkage  -->
                    <div invisible="not drying_shrinkage_visible">
                        <h1>
                            <field name="drying_shrinkage_name" readonly="1" nolabel="1"/>
                            <field name="drying_shrinkage_visible" invisible="1"/>
                        </h1>
                    </div>

                 

                    <div style="width:60%" invisible="not drying_shrinkage_visible">
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders" >
                         <tbody>
                         <tr>
                           <td><label for="average_drying_shrinkage" class="text-bold">Drying Shrinkage</label></td>
                           <td><field name="average_drying_shrinkage"/></td>
                          </tr>
                           <tr>
                            <td><label for="drying_shrinkage_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="drying_shrinkage_confirmity"
                                        decoration-success="drying_shrinkage_confirmity == 'pass'" 
                                        decoration-danger="drying_shrinkage_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="drying_shrinkage_aac_nabl" class="text-bold">NABL</label></td>
                           <td><field name="drying_shrinkage_aac_nabl"
                                        decoration-success="drying_shrinkage_aac_nabl == 'pass'" 
                                        decoration-danger="drying_shrinkage_aac_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>

                        <div style="display:flex;" invisible="not drying_shrinkage_visible">                        
                       <div style="width:50%">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                         <tbody>
                           <tr>
                           <td><label for="drying_grade1" class="text-bold">Specification</label></td>
                           <td><field name="drying_grade1" class="blue-input"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>
                        </div>

                     
                      <group/>

                        <!-- Drying Shrinkage  -->
                    <div invisible="not thermal_conductivity_visible">
                        <h1>
                            <field name="thermal_conductivity_name" readonly="1" nolabel="1"/>
                            <field name="thermal_conductivity_visible" invisible="1"/>
                        </h1>
                    </div>

                 

                    <div style="width:60%" invisible="not thermal_conductivity_visible">
                        <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders" >
                         <tbody>
                         <tr>
                           <td><label for="average_thermal_conductivity" class="text-bold"></label></td>
                           <td><field name="average_thermal_conductivity"/></td>
                          </tr>
                           <tr>
                            <td><label for="thermal_conductivity_confirmity" class="text-bold">Conformity</label></td>
                             <td><field name="thermal_conductivity_confirmity"
                                        decoration-success="thermal_conductivity_confirmity == 'pass'" 
                                        decoration-danger="thermal_conductivity_confirmity == 'fail'" 
                                        readonly="1"/></td>
                           </tr>
                           <tr>
                           <td><label for="thermal_conductivity_aac_nabl" class="text-bold">NABL</label></td>
                           <td><field name="thermal_conductivity_aac_nabl"
                                        decoration-success="thermal_conductivity_aac_nabl == 'pass'" 
                                        decoration-danger="thermal_conductivity_aac_nabl == 'fail'" 
                                        readonly="1"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>

                        <div style="display:flex;" invisible="not thermal_conductivity_visible">                        
                       <div style="width:50%">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                         <tbody>
                           <tr>
                           <td><label for="thermal_conductivity_grade1" class="text-bold">Specification</label></td>
                           <td><field name="thermal_conductivity_grade1" class="blue-input"/></td>
                          </tr>
                          </tbody>
                          </table>
                        </div>
                        </div>

                     
                      <group/>



                          <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>



                   
                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />

                </sheet>
            </form>
        </field>
        </record>


        <record id="view_cement_aac_prefill_data_form" model="ir.ui.view">
            <field name="name">mechanical.aac.block.prefill.data.form</field>
            <field name="model">mechanical.aac.block.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>




                    
				



                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_aac_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mechanical.aac.block.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_cement_aac_prefill_data_form"/>
            <field name="target">new</field>
        </record>


       
    </data>
</odoo>