                                    <td style="padding-left: 10px;"><span t-field="o.grade_id.grade"/></td>
								</tr>

								<tr>
									<td><strong>Location of Sample </strong></td>
									<td style="padding-left: 10px;"><span t-field="data.location"/></td>
