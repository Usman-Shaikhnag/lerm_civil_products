								<span t-field="eln.material.specifications"></span>
							</td>
                             <!-- <td rowspan="1" >Test Method</td> -->
							
                            <td rowspan="1" t-if="eln.conformity">Conformity</td>

						</tr>
					</thead>
					
                        
						<t t-set="i" t-value="0"/>
					<tbody>

					 <tr t-if="data.bitumen_content_visible" style="margin-top:10px">
                    1 . <span t-field="env['lerm.parameter.master'].search([('internal_id','=','124587963-7188-4086-b132-62b50e63f1247ui')]).parameter_name"/>
                     </tr>

						<tr t-if="data.bitumen_content_visible and (data.binder_content_nabl == 'pass' and nabl or (data.binder_content_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)">
