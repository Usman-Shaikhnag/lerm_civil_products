							</td>
                               <td>
								<span t-field="data.binder_content" t-options='{"widget": "float", "precision": 2}'/>
							</td>
                            
                            <!-- <td>
								<span>
									<span t-field="env['lerm.parameter.master'].search([('internal_id','=','32578999-7188-4086-b132-62b50e63f1247ui')]).unit.name"/>
								</span>
