<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="bituminous_macadam_datasheet">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px">
                    Bitumen
                </div>
				<div class="container_eln" style="margin-top:5px">
					<!-- Bitumen Content Section -->
					<div t-if="data.bitumen_content_visible" style="margin-top: 20px">
						<div style="font-size: 16px; font-weight: bold; margin-bottom: 10px;">1. Bitumen Content</div>
						<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
							<thead>
								<tr style="background-color: #f0f0f0; text-align: center;">
									<th style="border: 1px solid #ccc; padding: 6px;">S.No</th>
									<th style="border: 1px solid #ccc; padding: 6px;">Description</th>
									<th style="border: 1px solid #ccc; padding: 6px;">At <t t-esc="data.bitumen_content_name"/></th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">1</td>
									<td style="border: 1px solid #ccc; padding: 6px;">Weight of the sample (W1) grams</td>
									<td style="border: 1px solid #ccc; padding: 6px; text-align:center;"><span t-field="data.wt_of_sample"/></td>
								</tr>
								<tr>
									<td>2</td>
									<td>Initial weight of the filter paper (F1) grams</td>
									<td><span t-field="data.init_wt_filter_paper"/></td>
								</tr>
								<tr>
									<td>3</td>
									<td>Weight of aggregate after extraction (W2) grams</td>
									<td><span t-field="data.wt_agg_extraction"/></td>
								</tr>
								<tr>
									<td>4</td>
									<td>Weight of filter paper after extraction with fine materials (F2) grams</td>
									<td><span t-field="data.wt_filter_paper_after_extraction"/></td>
								</tr>
								<tr>
									<td>5</td>
									<td>Increased weight of filter = (F2 - F1) grams</td>
									<td><span t-field="data.increase_in_wt_filter_paper"/></td>
								</tr>
								<tr>
									<td colspan="2" style="text-align:right; font-weight:bold">% Binder Content = (W1 - (W2 + W3)) / W1 * 100</td>
									<td><span t-field="data.binder_content" t-options='{"widget": "float", "precision": 2}'/></td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Combined Gradation Section -->
					<div t-if="data.combined_gradation_visible" style="margin-top: 40px">
						<div style="font-size: 16px; font-weight: bold; margin-bottom: 10px;">2. Gradation</div>
						<div><b>Location:</b> <t t-esc="data.bitumen_content_name"/></div>
						<div style="margin-top: 5px"><b>Weight of Sample:</b> <span t-field="data.weight_of_sample"/> gms</div>

						<table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 10px;">
							<thead style="background-color: #f0f0f0;">
								<tr>
									<th style="border: 1px solid #ccc; padding: 6px;">IS Sieve</th>
									<th style="border: 1px solid #ccc; padding: 6px;">Weight Retained (gms)</th>
									<th style="border: 1px solid #ccc; padding: 6px;">% of Weight Retained</th>
									<th style="border: 1px solid #ccc; padding: 6px;">% of Cumulative Wt. Retained</th>
									<th style="border: 1px solid #ccc; padding: 6px;">% of Wt. Passing</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="data.combined_gradation_child_lines" t-as="line">
									<td style="border: 1px solid #ccc; padding: 6px;"><span t-esc="line.sieve_size"/></td>
									<td style="border: 1px solid #ccc; padding: 6px;"><span t-field="line.wt_retained"/></td>
									<td style="border: 1px solid #ccc; padding: 6px;"><span t-field="line.percent_retained" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="border: 1px solid #ccc; padding: 6px;"><span t-field="line.cumulative_retained" t-options='{"widget": "float", "precision": 2}'/></td>
									<td style="border: 1px solid #ccc; padding: 6px;"><span t-field="line.passing_percent" t-options='{"widget": "float", "precision": 2}'/></td>
								</tr>
							</tbody>
						</table>

						<div style="margin-top: 10px; font-weight: bold;">
							Total: <span t-field="data.total_combined_gradation" t-options='{"widget": "float", "precision": 2}'/>
						</div>
					</div>

					<div class="signatureContainer girdgird">
						<div>
							<div>
								<b>
									Tested By
								</b>
							</div>
							<div style="height:20px">

							</div>
							<div>
								<b>
									<span t-esc="eln.sample_id.filled_by.name"/>
								</b>
							</div>
							<div>
								<b>
									(<span t-esc="eln.sample_id.filled_by.job_title"/>)
								</b>
							</div>
						</div>
						
						<div>
							<div>
								<b>
									Checked By 
								</b>
								
							</div>
							<div style="height:20px">

							</div>
							<div>
								<b>
								<span t-esc="eln.sample_id.check_by.name"/>
								</b>
							</div>
							
							<div>
								<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
								</b>
							</div>

							
						</div>
					</div>
				</div>
			</t>
		</t>
	</template>






    <template id="bituminous_macadam_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			
			<t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<!-- <div style="text-align:center;margin-top:10px">
					<p style="font-size:15px"><b>Test Report</b></p>
				</div> -->
				<div class="container_eln" style="padding-top:70px">
					<div t-foreach="eln" t-as="o">
						<table style="margin-top:10px;">
							<tr>
								<td colspan="9" style=" font-weight: bold;">Client Details:</td>
								<td >
									<span t-field="o.srf_id.customer.name"/><br />
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
									,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
								<!-- <td>Project / Site Address :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.site_address.name"/>
									<span t-field="o.srf_id.site_address.street"/>
									<span t-field="o.srf_id.site_address.street2"/>
									<span t-field="o.srf_id.site_address.city"/>
									<span t-if="o.srf_id.site_address.zip" t-field="o.srf_id.site_address.zip"/>
									<span t-field="o.srf_id.site_address.state_id"/>
									<span t-field="o.srf_id.site_address.country_id"/>
								</td> -->
								<td colspan="9" style=" font-weight: bold;">Client Reference:</td>
								<td ><span t-field="o.srf_id.client_refrence"/></td>
							</tr>
							<tr>
								<td colspan="9" style=" font-weight: bold;">Name of Work:</td>
								<td ><span t-field="o.srf_id.name_work"/></td>
							</tr>
							<tr>
								<td colspan="9" style=" font-weight: bold;">Date of Testing:</td>
								<td >
									<span t-field="o.start_date"/> to <span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="9" style="font-weight: bold;">Size:</td>
								<td >
									<span t-field="o.sample_id.size_id.size"/>
								</td>
							</tr>
							<tr>
								<td colspan="9" style="font-weight: bold;">Grade:</td>
								<td >
									<span t-field="o.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="9" style="font-weight: bold;">Material/Test Name:</td>
								<td >
									<span t-field="o.material.name"/>
								</td>
							</tr>

							<!-- Source of Sample (only if value exists) -->
							<tr t-if="o.material.source_sample">
								<td colspan="9" style="font-weight: bold;">Source of Sample</td>
								<td >
									<span t-field="o.material.source_sample"/>
								</td>
							</tr>

							<!-- Test method adopted (only if value exists) -->
							<tr t-if="o.material.test_method_adopted">
								<td colspan="9" style="font-weight: bold;">Test method adopted:</td>
								<td >
									<span t-field="o.material.test_method_adopted"/>
								</td>
							</tr>

						</table>
					</div>

					<t t-if="data.bitumen_content_visible">
						<div class="">
							<table class="table table-bordered">
								<thead>
									<tr style="border:none">
										<th colspan="12"><t t-esc="data.bitumen_content_name"/></th>
									</tr>
									<tr >
										<th style="text-align: center;">S.N0.</th>
										<th style="text-align: center;">Location of Sample</th>
										<th style="text-align: center;">Test Result</th>
										<th style="text-align: center;">Requirement as per <span t-esc="eln.material.specifications"/></th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td style="text-align: center;">1</td>
										<td style="text-align: center;"><span t-esc="eln.sample_id.location"/></td>
										<td style="text-align: center;"><t t-esc="data.binder_content"/></td>
										<td style="text-align: center;">Min. 3.4</td>
									</tr>
								</tbody>
							</table>
						</div>
					</t>

					<t t-if="data.combined_gradation_visible">
						<div class="">
							<table class="table table-bordered" style="text-align: center;">
								<thead>
									<tr style="border:none">
										<th colspan="12"><t t-esc="data.combined_gradation_name"/></th>
									</tr>
									<tr>
										<th style="text-align: center;">IS Sieve</th>
										<th style="text-align: center;">Wt. Retained in gms</th>
										<th style="text-align: center;">% Retained</th>
										<th style="text-align: center;">Cum. Retained %</th>
										<th style="text-align: center;">Passing %</th>
										<th style="text-align: center;">Requirement as per<br/> <span t-esc="eln.material.specifications"/></th>
									</tr>
								</thead>
								<tbody>
									<t t-foreach="data.combined_gradation_child_lines" t-as="line">
										<tr>
											<td style="text-align: center;"><t t-esc="line.sieve_size"/></td>
											<td style="text-align: center;"><t t-esc="line.wt_retained"/></td>
											<td style="text-align: center;"><t t-esc="line.percent_retained" t-options='{"widget": "float", "precision": 2}'/></td>
											<td style="text-align: center;"><t t-esc="line.cumulative_retained" t-options='{"widget": "float", "precision": 2}'/></td>
											<td style="text-align: center;"><t t-esc="line.passing_percent"/></td>
											<td style="text-align: center;"><t t-esc="line.requirements"/></td>
										</tr>
									</t>
								</tbody>
							</table>

						</div>
						<!-- <p><strong>Total:</strong> <t t-esc="data.total_combined_gradation"/></p> -->
					</t>
					
					<div style="page-break-inside: avoid;">
                        <div style="margin-top:10px; padding:0" class="noteContainer">
                            <table class="table table-bordered">
								<tr>
									<td style="padding: 5px; font-style: italic; font-size: 12px;">
										<b>Note:-</b>
										&#160;&#160;(i) The results relate only to the items tested 
										&#160;&#160;(ii) This test report should not be reproduced except in full, without written approval of this Laboratory 
										&#160;&#160;(iii) Any corrections invalidate the test reports 
										&#160;&#160;(iv) Any Query regarding the report must be reported immediately. 
										&#160;&#160;(v) * mark indicate tests which are not in the scope of NABL. 
										&#160;&#160;(vi) # mark indicates Details given by Client.
										<t t-if="eln.has_witness">
											&#160;&#160;Test witnessed by: <span t-esc="eln.witness_name"/>
										</t>
										<t t-if="eln.remarks">
											&#160;&#160;<span t-esc="eln.remarks"/>
										</t>
									</td>
								</tr>
							</table>
                        </div>
                        <div style="margin-top:10px; page-break-inside: avoid;" class="signatureContainer girdgird">

                            <div>
                               <div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<!-- <div>
								<div>
									<img t-attf-src="/lerm_civil/static/src/img/stamp.png" alt="Image"/>
								</div>
								<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
								</div>
							</div>
							 -->
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
                                <div>
                                    <b>
                                        <span t-esc="eln.sample_id.approved_by.name"/>
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="eln.sample_id.approved_by.job_title"/>)
                                    </b>
                                </div>
                                
                            </div>
                        </div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
                        </div>
                    </div>
                        
				</div>
				<!-- </div> -->
				
			</t>
		</t>
	</template>
</odoo>