<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="action_routine_lateral_pile_load_test" model="ir.actions.act_window">
            <field name="name">Routine Lateral Load Tests</field>
            <field name="res_model">routine.lateral.pile.load.test.parent</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_routine_lateral_pile_load_tree" model="ir.ui.view">
            <field name="name">routine.lateral.pile.load.tree</field>
            <field name="model">routine.lateral.pile.load.test.parent</field>
            <field name="arch" type="xml">
                <tree string="Routine Lateral Pile Load Tests">
                    <field name="name"/>
                    <button name="action_duplicate_parent"
                            type="object"
                            icon="fa-copy"
                            string="Duplicate"
                            class="btn-secondary"/>
                    <button
                        name="action_delete_line"
                        string="Delete"
                        type="object"
                        icon="fa-trash"
                        class="btn-danger"
                        confirm="Are you sure you want to delete this line?"
                    />
                </tree>
            </field>
        </record>

        <record id="view_routine_lateral_pile_load_form" model="ir.ui.view">
            <field name="name">routine.lateral.pile.load.form</field>
            <field name="model">routine.lateral.pile.load.test.parent</field>
            <field name="arch" type="xml">
                <form string="Routine Lateral Pile Load Test Report">
                    <header>
                        <button name="action_generate_ulr_no" string="Generate ULR No" type="object" class="btn-primary"/>
                        <button name="action_generate_report_no" string="Generate Report No" type="object" class="btn-primary"/>
                        <button name="print_report" string="Print Report" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div style="text-align:center; margin-top:30px; margin-bottom:40px;">
                            <h1 style="font-size:26px; letter-spacing:1px;">
                                <field name="name" style="width:100%; display:block; text-align:center; font-size:26px; letter-spacing:1px;"/>
                            </h1>
                            <h2 style="font-size:26px; letter-spacing:1px;">
                                ROUTINE LATERAL PILE LOAD TEST
                            </h2>
                            <h2 style="margin-top:10px;">
                                OF PILE NO -
                                <field name="pile_no" nolabel="1"/>
                            </h2>
                        </div>

                        <group col="2" style="margin-bottom:30px;">
                            <field name="work_name"/>
                            <field name="client"/>
                            <field name="contractor"/>
                            <field name="report_no"/>
                            <field name="ulr"/>
                            <field name="rec_date"/>
                            <field name="test_standard"/>
                            <field name="site_location" colspan="2"/>
                        </group>

                        <div style="margin-top:30px;">
                            <h3 style="border-bottom:2px solid #000;">CONTENTS</h3>
                        </div>

                        <field name="content_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence"/>
                                <field name="description"/>
                                <field name="page_no"/>
                            </tree>
                        </field>

                        <div style="margin-top:25px;">
                            <h3 style="border-bottom:2px solid #000;">INTRODUCTION</h3>
                        </div>

                        <div style="border:1px solid #ccc; padding:10px;">
                            <field name="introduction" nolabel="1" widget="text"/>
                        </div>

                        <div style="margin-top:25px;">
                            <h3 style="border-bottom:2px solid #000;">OBJECTIVE</h3>
                        </div>

                        <div style="border:1px solid #ccc; padding:10px;">
                            <field name="objective" nolabel="1" widget="text"/>
                        </div>

                        <div style="margin-top:30px;">
                            <h3 style="border-bottom:2px solid #000;">TESTING EQUIPMENTS</h3>
                        </div>

                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="test_equipment" widget="text" nolabel="1"/>
                        </div>

                        <div style="margin-top:25px;">
                            <h3 style="border-bottom:2px solid #000;">TEST PROCEDURE</h3>
                        </div>

                        <div style="border:1px solid #ccc; padding:10px;">
                            <field name="test_procedure" nolabel="1" widget="text"/>
                        </div>

                        <div style="margin-top:35px;">
                            <h3 style="border-bottom:2px solid #000;">TABLE 1 : BASIC DATA</h3>
                        </div>

                        <field name="basic_data_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sr_no"/>
                                <field name="parameter"/>
                                <field name="value"/>
                            </tree>
                        </field>

                        <div style="margin-top:35px;">
                            <h3 style="border-bottom:2px solid #000;">INTERPRETATION</h3>
                        </div>

                        <div style="border:1px solid #ccc; padding:12px;">
                            <field name="interpretation" widget="text" nolabel="1"/>
                        </div>

                        <div style="margin-top:35px;">
                            <h3 style="border-bottom:2px solid #000;">TABLE 2A : DIAL GAUGE READING CORRESPONDING TO LOADING</h3>
                        </div>

                        <field name="last_reading_datetime" invisible="1"/>
                        <field name="loading_reading_ids"
                                nolabel="1"
                                context="{'default_parent_id': id}">
                            <tree editable="bottom" limit="50" default_order="id">
                                <field name="reading_datetime"
                                        widget="datetime"
                                        options="{'format': 'dd/MM/yy HH:mm'}"/>
                                <field name="load_tonne"/>
                                <field name="dial_a"/>
                                <field name="dial_b"/>
                                <field name="mean_mm" readonly="1"/>
                            </tree>
                        </field>

                        <div style="margin-top:35px;">
                            <h3 style="border-bottom:2px solid #000;">TABLE 2B : DIAL GAUGE READING CORRESPONDING TO UNLOADING</h3>
                        </div>

                        <field name="unloading_reading_ids"
                                nolabel="1"
                                context="{'default_parent_id': id}">
                            <tree editable="bottom" limit="50" default_order="id">
                                <field name="reading_datetime"
                                        widget="datetime"
                                        options="{'format': 'dd/MM/yy HH:mm'}"/>
                                <field name="load_tonne"/>
                                <field name="dial_a"/>
                                <field name="dial_b"/>
                                <field name="mean_mm" readonly="1"/>
                            </tree>
                        </field>

                        <button name="action_generate_graph" type="object" string="Generate Graph" class="btn-primary"/>
                        <div style="margin-top:35px;">
                            <h3 style="border-bottom:2px solid #000;">LOAD SETTLEMENT GRAPH</h3>
                        </div>

                        <field name="graph_image" widget="image" class="mt-2"/>

                        <div style="margin-top:20px; font-weight:bold;">
                            Gross Settlement =
                            <field name="gross_settlement" readonly="1"/> mm<br/>
                            Net Settlement =
                            <field name="net_settlement" readonly="1"/> mm<br/>
                            Rebound =
                            <field name="rebound" readonly="1"/> mm
                        </div>

                        <div style="margin-top:30px;">
                            <h3 style="border-bottom:2px solid #000;">ANALYSIS OF TEST RESULTS</h3>
                        </div>

                        <div style="border:1px solid #000; padding:10px;">
                            <field name="analysis_text" nolabel="1" widget="text"/>
                        </div>

                        <div style="margin-top:35px;">
                            <h3 style="border-bottom:2px solid #000;">SITE PHOTOGRAPHS</h3>
                        </div>

                        <field name="site_image_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence"/>
                                <field name="image" widget="image" options="{'size':[80,80]}"/>
                                <field name="caption"/>
                            </tree>
                        </field>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- Inject Routine Lateral card into FST dashboard -->
        <record id="routine_lateral_dashboard_card" model="ir.ui.view">
            <field name="name">fst.dashboard.routine_lateral.card</field>
            <field name="model">lerm.ert.dashboard</field>
            <field name="inherit_id" ref="fst.view_ert_dashboard"/>
            <field name="arch" type="xml">
                <xpath expr="//div[contains(@class, 'card-box')][last()]" position="after">
                    <div class="card-box" style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;">
                        <h3 class="title">Routine Lateral Pile Load Test</h3>
                        <a type="action"
                        name="%(action_routine_lateral_pile_load_test)d"
                        class="btn btn-lg"
                        style="background:#1565c0; color:#fff;">
                            Records
                        </a>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
