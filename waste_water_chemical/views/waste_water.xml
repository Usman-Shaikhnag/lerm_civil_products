<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="chemical_waste_water_form" model="ir.ui.view">
        <field name="name">chemical.waste.water.form</field>
        <field name="model">chemical.waste.water</field>
        <field name="arch" type="xml">
            <form string="Your Form View" create="false">
                <sheet>
                <div>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                </div>
                <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                </group>
                    <div class="custom_table_borders">
                      <field name="sample_parameters" nolabel="1">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>



                    <!-- ph at 1% -->
                    <div invisible="not ph_visible">

                        <h1 class="text-center">
                            <field name="ph_name" readonly="1" nolabel="1"/>
                            <field name="ph_visible" invisible="1"/>
                        </h1>
                    </div>

                    <!-- pH -->

                    <div>
                      <table class="table table-sm o_form_table table-bordered w-100 custom_table_borders">
                         <tbody>
                           <tr>
                           <td><label for="ph_1_percent_a">pH</label></td>
                             <td>Observation 1</td>
                             <td>Observation 2</td>
                             <td>Observation 3</td>
                             <td>Observation 4</td>
                             <td>Observation 5</td>
                           </tr>
                           <tr>
                             <td></td>
                             <td><field  name="ph_1_percent_a"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ph_1_percent_b"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ph_1_percent_c"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ph_1_percent_d"  colspan="1"  nolabel="1" class="blue-input"/></td>
                             <td><field  name="ph_1_percent_e"  colspan="1"  nolabel="1" class="blue-input"/></td>
                           </tr>
                         </tbody>
                      </table>
                    </div>

                    <div>
                      <table  class="table table-sm o_form_table table-bordered w-50 custom_table_borders">
                      <tbody>
                      <tr>
                          <td ><span>Average</span></td>
                          <td style="padding: 8px;"><field name="ph_average"/></td>
                         </tr>
                        <tr>
                          <td><span>Conformity</span></td>
                          <td><field name='ph_average_conformity'
                               decoration-success="ph_average_conformity == 'pass'" 
                               decoration-danger="ph_average_conformity == 'fail'" 
                               readonly="1"/></td>
                         </tr>
                         <tr>
                         <td><span>NABL</span></td>
                         <td><field name='ph_average_nabl'/></td>
                         </tr>
                     </tbody>
                      </table>
                    </div>

