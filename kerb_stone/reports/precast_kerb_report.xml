<?xml version="1.0" encoding="utf-8"?>
<odoo>

	   <template id="precast_mech_report">
		<t t-call="web.html_container">
			
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				

				<div class="container_eln">
					<div t-foreach="eln" t-as="o">
						
						<table style="margin-top:10px;">
							<tr>
								<td colspan="12">#Customer Party Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
								
								<td colspan="12">#Project / Site Address : <![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">#Sample Description : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td colspan="6">Test Start Date :<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
								<td colspan="6">Test End Date :<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Sample Id Mark: <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.client_sample_id"/>
								</td>
								<td colspan="6">Sample Receipt Date :<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Size :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								<td colspan="6">#Grade :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Brand :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.brand"/>
								</td>
								<td colspan="6">#Consultant Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.consultant_name1"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">#Client Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
								</td>
								<td colspan="6">#Client Reference :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client_refrence"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Discipline :
									<![CDATA[&nbsp;]]>
									<span t-field="o.discipline.discipline"/>
								</td>
								<td colspan="6">Group :
									<![CDATA[&nbsp;]]>
									<span t-field="o.group.group"/>
								</td>
							</tr>

							<tr>
								<td colspan="12">Material/Test Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
							</tr>
						</table>
					</div>



					<table style="margin-top:15px;">
						<t t-set="i" t-value="0"/>
						<thead>
							<tr>
								<th style="text-align: center;">
									<span style="font-weight: bold;">
										Sr No.
									</span>
								</th>

								<th style="text-align: center;font-weight: bold;">
								<span t-esc="eln.material.test_parameter"/>
								</th>

								<th style="text-align: center;font-weight: bold;">
								<span t-esc="eln.material.unit"/>
									<!-- <span style="font-weight: bold;">
										Unit
									</span> -->
								</th>


								<t t-foreach="range(1, data.max_specimen_count + 1)" t-as="specimen_no">
								  <th style="text-align: center; font-weight: bold;">
								     Specimen <span t-esc="specimen_no"/>
								  </th>
                                </t>

								<th style="text-align: center;font-weight: bold;">
								<span t-esc="eln.material.result_remark"/>
								</th>

								
								<th style="max-width: 250px;text-align: center;">
									<span style="font-weight: bold;">
										<span t-esc="eln.material.specifications"/>
									</span>
								</th>


								<th style="text-align: center;" t-if="eln.conformity">
									<span style="font-weight: bold;">
										Conformity Status
									</span>
								</th>
							</tr>
						</thead>
						<tbody>


						<!-- Length -->
						<tr t-if="data.dimension_visible and (data.avg_length_nabl == 'pass' and nabl or (data.avg_length_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl) and not fromEln">


								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','1d1f881d-7D75-40E1-BC34-fe8c1aedb001')]).parameter_name"/>
									</span>

								</td>

								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','1d1f881d-7D75-40E1-BC34-fe8c1aedb001')]).unit.name"/>
									</span>
								</td>


								
								<t t-foreach="range(data.max_specimen_count)" t-as="index">
								  <td style="text-align: center;">
								    <t t-if="index &lt; len(data.dimension_table)">
								     <span t-field="data.dimension_table[index].length" t-options='{"widget":"float","precision":2}'/>
									</t>
								  </td>
                                </t>
								
								<td style="text-align: center;">
									<span>
										<span t-field="data.avg_length" t-options='{"widget": "float", "precision": 2}'/>
									</span>
								</td>

								 

								<td style="text-align: center;">
									<span>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','1d1f881d-7D75-40E1-BC34-fe8c1aedb001')]).parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</span>
								</td>

								<td t-if="eln.conformity" style="text-align: center;">
									<span t-field="data.avg_length_conformity"/>
								</td>

							</tr>

							<!-- Width -->
							<tr t-if="data.dimension_visible and (data.avg_width_nabl == 'pass' and nabl or (data.avg_width_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl) and not fromEln">


								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','81015601-E2DE-4D9C-8AFB-55b0c69a4582')]).parameter_name"/>
									</span>

								</td>

								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','81015601-E2DE-4D9C-8AFB-55b0c69a4582')]).unit.name"/>
									</span>
								</td> 

								<t t-foreach="range(data.max_specimen_count)" t-as="index">
								  <td style="text-align: center;">
								    <t t-if="index &lt; len(data.dimension_table)">
								     <span t-field="data.dimension_table[index].width" t-options='{"widget":"float","precision":2}'/>
									</t>
								  </td>
                                </t>
								
								<td style="text-align: center;">
									<span>
										<span t-field="data.avg_width" t-options='{"widget": "float", "precision": 2}'/>
									</span>
								</td>

								

								<td style="text-align: center;">
									<span>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','81015601-E2DE-4D9C-8AFB-55b0c69a4582')]).parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</span>
								</td>

								<td t-if="eln.conformity" style="text-align: center;">
									<span t-field="data.avg_width_conformity"/>
								</td>

							</tr>


							<tr t-if="data.dimension_visible and (data.avg_height_nabl == 'pass' and nabl or (data.avg_height_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl) and not fromEln">


								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','fb111d38-305A-40BF-B5AD-50c66529314c')]).parameter_name"/>
									</span>

								</td>

								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','fb111d38-305A-40BF-B5AD-50c66529314c')]).unit.name"/>
									</span>
								</td>


								
								<t t-foreach="range(data.max_specimen_count)" t-as="index">
								  <td style="text-align: center;">
								    <t t-if="index &lt; len(data.dimension_table)">
								     <span t-field="data.dimension_table[index].height" t-options='{"widget":"float","precision":2}'/>
									</t>
								  </td>
                                </t>
								
								<td style="text-align: center;">
									<span>
										<span t-field="data.avg_height" t-options='{"widget": "float", "precision": 2}'/>
									</span>
								</td>

								 

								<td style="text-align: center;">
									<span>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','fb111d38-305A-40BF-B5AD-50c66529314c')]).parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</span>
								</td>

								<td t-if="eln.conformity" style="text-align: center;">
									<span t-field="data.avg_height_conformity"/>
								</td>

							</tr>


							<!-- Transverse Strength -->
							<tr t-if="data.transverse_visible and (data.avrg_transverse_strength_nabl == 'pass' and nabl or (data.avrg_transverse_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl) and not fromEln">


								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','1e56b2c9-e3fd-47e0-8908-2a813cc965e1')]).parameter_name"/>
									</span>

								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','1e56b2c9-e3fd-47e0-8908-2a813cc965e1')]).unit.name"/>
									</span>
								</td>

								<t t-foreach="range(data.max_specimen_count)" t-as="index">
								  <td style="text-align: center;">
								    <t t-if="index &lt; len(data.transverse_tables)">
								     <span t-field="data.transverse_tables[index].transverse_strength" t-options='{"widget":"float","precision":2}'/>
									</t>
								  </td>
                                </t>


								
								<td style="text-align: center;">
									<span>
										<span t-field="data.avrg_transverse_strength" t-options='{"widget": "float", "precision": 2}'/>
									</span>
								</td>

								 

								<td style="text-align: center;">
									<span>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','1e56b2c9-e3fd-47e0-8908-2a813cc965e1')]).parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</span>
								</td>

								<td t-if="eln.conformity" style="text-align: center;">
									<span t-field="data.avrg_transverse_strength_conformity"/>
								</td>

							</tr>

							<tr t-if="data.water_absorbtion_visible and (data.avg_water_absorption_nabl == 'pass' and nabl or (data.avg_water_absorption_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl) and not fromEln">


								<td style="text-align: center;">
									<span t-esc="i + 1" />
									<t t-set="i" t-value="i+1"/>
								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','29fc5579-2637-420d-91e6-b433d79f3584')]).parameter_name"/>
									</span>

								</td>
								<td style="text-align: center;">
									<span>
										<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','29fc5579-2637-420d-91e6-b433d79f3584')]).unit.name"/>
									</span>
								</td> 


								
								<t t-foreach="range(data.max_specimen_count)" t-as="index">
								  <td style="text-align: center;">
								    <t t-if="index &lt; len(data.water_absorbtion_table)">
								     <span t-field="data.water_absorbtion_table[index].water_absorption" t-options='{"widget":"float","precision":2}'/>
									</t>
								  </td>
                                </t>
								
								
								<td style="text-align: center;">
									<span>
										<span t-field="data.avg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
									</span>
								</td>

								

								<td style="text-align: center;">
									<span>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','29fc5579-2637-420d-91e6-b433d79f3584')]).parameter_table" t-as="parameter">
											<t t-if="parameter.grade.id == eln.grade_id.id">
												<span t-field="parameter.permissable_limit"/>
											</t>
										</t>
									</span>
								</td>

								<td t-if="eln.conformity" style="text-align: center;">
									<span t-field="data.avg_water_absorption_conformity"/>
								</td>

							</tr>




						</tbody>
						</table>













					
                   
						<div style="margin-top:10px; page-break-inside: avoid;" class="signatureContainer girdgird">
							<div>
								<div>
									<b>
									Checked By
									</b>
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
									(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>
							<div>
						<div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div>
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							<div>
								<div>
									<b>
									Approved By 
									</b>

								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.approveby_signature_required">
										<div t-if="eln.sample_id.approved_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>)
	
									</b>
								</div>
								<!-- <div>
									<b>
									(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
					
					</div>
					<t>
						<div style="margin-top: 20px; text-align: center;">
							<p style="border-top: 1px dashed #000; padding-top: 10px;">
								...... End Of Report......
							</p>
						</div>
					</t>
				
				

				
			</t>
		</t>
	</template>
</odoo> 