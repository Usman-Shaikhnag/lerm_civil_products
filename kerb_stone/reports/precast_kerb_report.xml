<?xml version="1.0" encoding="utf-8"?>
<odoo>

	   <template id="precast_mech_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
				<div class="container_eln" style="padding-top:20px;">
					
					<div class="" t-foreach="eln" t-as="o">
						<table style="width:100%; border-collapse: collapse;" border="1">

						   <tr>
								<td colspan="1">#Project Name/Site Name :</td>
								  <td colspan="3" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>

									<span t-field="o.srf_id.name_work"/>
									</td>
								
							</tr>
							<tr >
								<td colspan="1" >#Customer Name	:</td>

								<td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    <t t-if="o.srf_id.customer">
									   <span t-field="o.srf_id.customer"/>
                                    </t>
                                    <t t-else="">--</t>
								</td>

                                <td colspan="1" >ULR NO:</td>

								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
                                    
									  <span t-field="o.sample_id.ulr_no"/>
                                   
									</td>
							</tr>

							<tr>
								<td colspan="1" >Address:</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<!-- <t t-if="o.srf_id.customer.name">
									  <span t-field="o.srf_id.customer.name"/>
									 </t>
        							<t t-else=""></t>
		                            <br/> -->

									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
									</td>
                                    <td colspan="1" >Test Report No :</td>
								  <td colspan="1" style="font-weight:bold;">
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.kes_no"/>

									</td>
							</tr>

                            <tr>
								<td colspan="1">Location of Performance :-</td>
								<td colspan="1">
								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Sample ID  :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">-</t>
								
								</td>
                                </tr>

							
							<tr>
								<td colspan="1">Samples Description :-</td>
								<td colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
											<span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td colspan="1">Date of Receipt :-</td>
								<td colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<td colspan="1">#Source of Sample	 :-</td>
								<td colspan="1">
								<t t-if="o.material.source_sample">
											<span t-field="o.material.source_sample"/>
										</t>
									<t t-else="">-</t>
								</td>

								<td colspan="1">Date of Performance of Test :-</td>
								<td colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>

							<tr>
								<td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<!-- <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">-</t> -->
								</td>

									<td colspan="1">Date of Report Issue :-</td>
										<td colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>

									<td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">-</t>
										</td>
								
							</tr>

                            <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_temperature is not None">
											<span t-field="brick.brick_temperature"/>   °C
										</t>
									<t t-else="">-</t> -->
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<!-- <t t-if="brick.brick_humidity is not None">
											<span t-field="brick.brick_humidity"/>   °C
										</t>
									<t t-else="">-</t> -->
										</td>
								
							</tr>
							

                            <tr>
								<td colspan="1">Reference No.  :-</td>
								<td colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">-</t>
								</td>
								
							</tr>

							</table>
					</div>
					
                    <!-- Transverse Strength -->
                    <div t-if="data.transverse_visible" style="margin-top:20px">
                            <div style="text-align:center;font-size:18px">
                                <!-- Transverse Strength -->
								<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','0b48abe6-07a4-4345-bcc1-30ff6e4830af')]).parameter_name"/>

                            </div>
                            

                            <table style="margin-top:20px">
                                <tr cols="12">
                                    <td colspan="1" style="text-align: center;font-weight: bold;">Trial no 
                                    </td>
                                    <td colspan="2" style="text-align: center;font-weight: bold;">Required Load in (Ton)
                                    </td>
                                    <td colspan="2" style="text-align: center;font-weight: bold;">Observed Test Result
                                    </td>
                                    <!-- <td colspan="4" style="text-align: center;font-weight: bold;">Protocol
                                    </td> -->
									<th colspan="4" style="text-align: center;font-weight: bold;">
										<span>
											<span t-esc="eln.material.test_parameter"/>
											
										</span>
									</th>
                                    <td colspan="3" style="text-align: center;font-weight: bold;">Requirement
                                    </td>
                                    
                                    
                                </tr>

                                <t t-set="i" t-value="0"/>
                                <tr t-foreach="data.transverse_table" t-as="r">
                                    <td colspan="1" style="text-align: center;">
                                        <span t-esc="r['trial_no']"/>
                                    </td>
                                    <td colspan="2" style="text-align: center;">
                                        <span t-esc="r['required_load']"/>
                                    </td>
                                    <td colspan="2" style="text-align: center;">
                                        <span t-esc="r['observed_test_result']"/>
                                    </td>
                                    <td colspan="4" style="text-align: center;">
                                        <span t-esc="r['protocol']"/>
                                    </td>
                                    <td colspan="3" style="text-align: center;">
                                        <span t-esc="r['requirement']"/>
                                    </td>
                                    
                                </tr>
                            </table>
                            
                    </div>

                    <!-- Water Absorbtion  -->
                    <div t-if="data.water_absorbtion_visible" style="margin-top:20px">
                        <div style="text-align:center;font-size:18px">
                            <!-- Water Absorbtion -->
							<span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','f913fc79-eeb4-4e16-a7fc-75608384d9b0')]).parameter_name"/>
                        </div>
                        

                        <table style="margin-top:20px">
                            <tr cols="12">
                                <td colspan="1" style="text-align: center;font-weight: bold;">Sr no 
                                </td>
                                <td colspan="1" style="text-align: center;font-weight: bold;">Dry Weight (after 24 hour in oven)
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold;">Weight (wt. after 10 minutes emersion in water)
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold;">Weight (wt. after 24 hour emersion in water)
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold;">Initial Water Absorption, %
                                </td>
                                <td colspan="2" style="text-align: center;font-weight: bold;">Final Water Absorption, %
                                </td>
                                <!-- <td colspan="2">Protocol
                                </td> -->
								<th colspan="2" style="text-align: center;font-weight: bold;">
									<span>
										<span t-esc="eln.material.test_parameter"/>
										
									</span>
								</th>
                                
                            </tr>

                            <t t-set="i" t-value="0"/>
                            <tr t-foreach="data.water_absorbtion_table" t-as="r">
                                <td colspan="1" style="text-align: center;">
                                    <div>
                                        <span t-esc="i + 1" />
                                        <t t-set="i" t-value="i+1"/>
                                    </div>
                                </td>
                                <td colspan="1" style="text-align: center;">
                                    <span t-esc="r['dry_wt_oven']"/>
                                </td>
                                <td colspan="2" style="text-align: center;">
                                    <span t-esc="r['wt_10_min']"/>
                                </td>
                                <td colspan="2" style="text-align: center;">
                                    <span t-esc="r['wt_24_hr']"/>
                                </td>
                                <td colspan="2" style="text-align: center;">
                                    <span t-esc="r['initial_water_absorbtion']"/>
                                </td>
                                <td colspan="2" style="text-align: center;">
                                    <span t-esc="r['final_water_absorbtion']"/>
                                </td>
                                <td colspan="2" style="text-align: center;">
                                    <span t-esc="r['protocol']"/>
                                </td>
                                
                            </tr>
                        </table>
                        

                    </div>

					<div style="page-break-inside: avoid;">
						<div style="margin-top:20px" class="noteContainer">
							<table>
								<tr>
									<td style="padding: 5px; font-style: italic; ">

										<b>Notes:-</b>
											<t t-if="data.notes_id">
											<t t-foreach="data.notes_id" t-as="n">
												<span><t t-esc="n.sr_no"/>. <t t-esc="n.notes"/></span>
											</t>
										</t>
									</td>
								</tr>
							</table>
						</div>
						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Checked By
									</b>
								</div>
								<div style="height: 40px;">
									<t t-if="eln.sample_id.checkby_signature_required">
										<div t-if="eln.sample_id.check_by.employee_id.signature">
											<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
										</div>
										
									</t>
								</div>
								<div>
									<b>
										<span t-esc="eln.sample_id.check_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>
							<div>
								<!-- <div>
									<img t-attf-src="/lerm_civil/static/src/img/stamp.png" alt="Image"/>
								</div> -->
								<div style="padding-top:5px">
									Format No. <span t-esc="eln.material.test_format_no"/>
								</div>
							</div>
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,' + eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.approved_by.job_title"/>) 
									</b>
								</div>
								
							</div>
						</div>
						<!-- <div style="text-align:center;margin-top:25px">
							......End of Report......
						</div> -->
						<div style="margin-top: 50px; text-align: center;">
							<p style="border-top: 1px dashed #000; padding-top: 10px;">
								...... End Of Report......
							</p>
						</div>
					</div>

				</div>
			</t>
		</t>
	</template>
</odoo>