<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_preast_kerb_form" model="ir.ui.view">
        <field name="name">mechanical.precast.kerb.form</field>
        <field name="model">mechanical.precast.kerb</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                <group  style="white-space: nowrap; width:70%;">
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                   <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                     <!-- Dimension -->

                    <div invisible="dimension_visible == False" style="text-align:center">
                      <h1>
                          <field name="dimension_name" readonly="1" nolabel="1"/>
                          <field name="dimension_visible" invisible='1'/>
                      </h1>
                    </div>
                    
                   
                     <div invisible = "dimension_visible == False"  >
                    <field name="dimension_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no" />
                                <field name='lengthh' class="blue-input" decoration-info="lengthh != 0"/>
                                <field name='width' class="blue-input" decoration-info="height != 0"/>
                                <field name='height' class="blue-input" decoration-info="height != 0"/>
                                
                            </tree>
                    </field>
                    </div>

                    <div class="d-flex gap-3" invisible="dimension_visible == False"> 
                         <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False">
                          <tbody>
                             <tr>
                                <td><label class="fw-bold" for="avrg_length"></label>
                                </td>
                                <td>
                                    <field name="avrg_length"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_length_confirmity"></label>
                                </td>
                                <td>
                                    <field name="avrg_length_confirmity"
                                        decoration-success="avrg_length_confirmity == 'pass'" 
                                        decoration-danger="avrg_length_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_length_nabl"></label>
                                </td>
                                <td>
                                    <field name="avrg_length_nabl"
                                        decoration-success="avrg_length_nabl == 'pass'" 
                                        decoration-danger="avrg_length_nabl == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                      <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False">
                          <tbody>
                             <tr>
                                <td><label class="fw-bold" for="avrg_width"></label>
                                </td>
                                <td>
                                    <field name="avrg_width"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_width_confirmity"></label>
                                </td>
                                <td>
                                    <field name="avrg_width_confirmity"
                                        decoration-success="avrg_width_confirmity == 'pass'" 
                                        decoration-danger="avrg_width_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_width_nabl"></label>
                                </td>
                                <td>
                                    <field name="avrg_width_nabl"
                                        decoration-success="avrg_width_nabl == 'pass'" 
                                        decoration-danger="avrg_width_nabl == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                     <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False">
                          <tbody>
                             <tr>
                                <td><label class="fw-bold" for="avrg_height"></label>
                                </td>
                                <td>
                                    <field name="avrg_height"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_height_confirmity"></label>
                                </td>
                                <td>
                                    <field name="avrg_height_confirmity"
                                        decoration-success="avrg_height_confirmity == 'pass'" 
                                        decoration-danger="avrg_height_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_height_nabl"></label>
                                </td>
                                <td>
                                    <field name="avrg_height_nabl"
                                        decoration-success="avrg_height_nabl == 'pass'" 
                                        decoration-danger="avrg_height_nabl == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>

                    
                    <!-- Transverse Strength -->

                    <group  invisible="transverse_visible == False" style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="transverse_name" readonly="1" nolabel="1"/>
                            <field name="transverse_visible" invisible="1"/>
                        </h1>
                    </group>
                    <div class="custom_table_borders" style="width: 100%;"  invisible="transverse_visible == False">
                        <field name="transverse_table" nolabel="1">
                        <tree editable="bottom">
                          <field name="trial_no"/>
                          <field name="required_load"/>
                          <field name="observed_test_result"/>
                          <field name="protocol"/>
                          <field name="requirement"/>
                        </tree>
                        </field>
                    </div>


                    <group  invisible="water_absorbtion_visible == False" style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="water_absorbtion_name" readonly="1" nolabel="1"/>
                            <field name="water_absorbtion_visible" invisible="1"/>
                        </h1>
                    </group>
                    <div class="custom_table_borders" style="width: 100%;"  invisible="water_absorbtion_visible == False">
                        <field name="water_absorbtion_table" nolabel="1">
                        <tree editable="bottom">
                          <field name="dry_wt_oven"/>
                          <field name="wt_10_min"/>
                          <field name="wt_24_hr"/>
                          <field name="initial_water_absorbtion"/>
                          <field name="final_water_absorbtion"/>
                          <field name="protocol"/>
                        </tree>
                        </field>
                    </div>
                     

                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />


                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>