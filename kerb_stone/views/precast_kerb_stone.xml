<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_preast_kerb_form" model="ir.ui.view">
        <field name="name">mechanical.precast.kerb.form</field>
        <field name="model">mechanical.precast.kerb</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                <group  style="white-space: nowrap; width:70%;">
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </group>
                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                   <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>

                    <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                    <div class="d-flex gap-2"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="temp"></label>
                                    </td>
                                    <td>
                                        <field name="temp" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="humidity" ></label>
                                    </td>
                                    <td>
                                        <field name="humidity" class="blue-input"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>



                     <!-- Dimension -->

                    <div invisible="dimension_visible == False" style="text-align:center">
                      <h1>
                          <field name="dimension_name" readonly="1" nolabel="1"/>
                          <field name="dimension_visible" invisible='1'/>
                      </h1>
                    </div>
                    
                   
                     <div invisible = "dimension_visible == False"  >
                    <field name="dimension_lines" nolabel="1" >
                            <tree editable="bottom"  class="custom_table_borders">
                                <field name="serial_no" />
                                <field name="kerb_id" width="120" />
                                
                                <field name='lengthh' class="blue-input" decoration-info="lengthh != 0" width="120"/>
                                <field name='width' class="blue-input" decoration-info="height != 0" width="120"/>
                                <field name='height' class="blue-input" decoration-info="height != 0" width="120"/>
                                <field name='remarks' class="blue-input" decoration-info="remarks != 0"  width="120"/>
                                
                            </tree>
                    </field>
                    </div>

                    <div class="d-flex gap-3" invisible="dimension_visible == False"> 
                         <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False">
                          <tbody>
                             <tr>
                                <td><label class="fw-bold" for="avrg_length"></label>
                                </td>
                                <td>
                                    <field name="avrg_length"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_length_confirmity"></label>
                                </td>
                                <td>
                                    <field name="avrg_length_confirmity"
                                        decoration-success="avrg_length_confirmity == 'pass'" 
                                        decoration-danger="avrg_length_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_length_nabl"></label>
                                </td>
                                <td>
                                    <field name="avrg_length_nabl"
                                        decoration-success="avrg_length_nabl == 'pass'" 
                                        decoration-danger="avrg_length_nabl == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avrg_length_report_type">Report Type</label></td>
                                <td><field name="avrg_length_report_type" class="blue-input" decoration-info="avrg_length_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                      <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False">
                          <tbody>
                             <tr>
                                <td><label class="fw-bold" for="avrg_width"></label>
                                </td>
                                <td>
                                    <field name="avrg_width"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_width_confirmity"></label>
                                </td>
                                <td>
                                    <field name="avrg_width_confirmity"
                                        decoration-success="avrg_width_confirmity == 'pass'" 
                                        decoration-danger="avrg_width_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_width_nabl"></label>
                                </td>
                                <td>
                                    <field name="avrg_width_nabl"
                                        decoration-success="avrg_width_nabl == 'pass'" 
                                        decoration-danger="avrg_width_nabl == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avrg_width_report_type">Report Type</label></td>
                                <td><field name="avrg_width_report_type" class="blue-input" decoration-info="avrg_width_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>

                     <table class="table table-sm table-bordered w-50 custom_table_borders" invisible="dimension_visible == False">
                          <tbody>
                             <tr>
                                <td><label class="fw-bold" for="avrg_height"></label>
                                </td>
                                <td>
                                    <field name="avrg_height"/>
                                </td>
                            </tr>
                              <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_height_confirmity"></label>
                                </td>
                                <td>
                                    <field name="avrg_height_confirmity"
                                        decoration-success="avrg_height_confirmity == 'pass'" 
                                        decoration-danger="avrg_height_confirmity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label class="fw-bold" for="avrg_height_nabl"></label>
                                </td>
                                <td>
                                    <field name="avrg_height_nabl"
                                        decoration-success="avrg_height_nabl == 'pass'" 
                                        decoration-danger="avrg_height_nabl == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="avrg_height_report_type">Report Type</label></td>
                                <td><field name="avrg_height_report_type" class="blue-input" decoration-info="avrg_height_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>
                    </div>


                     <!-- compressive Strength -->

                    <div invisible="compressive_strength_visible == False" style="text-align:center">
                      <h1>
                          <field name="compressive_strength_name" readonly="1" nolabel="1"/>
                          <field name="compressive_strength_visible" invisible='1'/>
                      </h1>
                    </div>

                    <div invisible="compressive_strength_visible == False" class="custom_table_borders">
                        <field name="compressive_strength_table" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no' width="120"/>
                                <field name='age' class="blue-input" decoration-info="age != 0" width="120"/>
                                <field name='height' class="blue-input" decoration-info="height != 0" width="120"/>
                                <field name='diameter' class="blue-input" decoration-info="diameter" width="120"/>
                                <field name='hd_ratio' readonly="1" width="120"/>
                                <field name='correction_factor' readonly="1" width="120"/>
                                <field name='area' readonly="1" width="120"/>
                                <field name='volume' readonly="1" width="120"/>
                                <field name='weight'  class="blue-input" decoration-info="weight" width="120"/>
                                <field name='density' readonly="1" width="120"/>
                                <field name='load'  class="blue-input" decoration-info="load" width="120"/>
                                
                                <field name='compressive_strength' readonly="1" width="120"/>
                            </tree>
                        </field>
                    </div>
                    
                    

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not compressive_strength_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Compressive Strength</strong></td>
                                <td>
                                    <field name="avg_compressive_strength"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Conformity</strong></td>
                                <td>
                                    <field name="avg_compressive_strength_confirmity"
                                        decoration-success="avg_compressive_strength_confirmity == 'pass'"
                                        decoration-danger="avg_compressive_strength_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong for="avg_compressive_strength_nabl">NABL</strong></td>
                                <td>
                                    <field name="avg_compressive_strength_nabl"
                                        decoration-success="avg_compressive_strength_nabl == 'pass'"
                                        decoration-danger="avg_compressive_strength_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="compressive_strength_report_type">Report Type</label></td>
                                <td><field name="compressive_strength_report_type" class="blue-input" decoration-info="compressive_strength_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>


                  

                    <!-- Water Absorption -->

                    <div invisible="water_absorption_visible == False" style="text-align:center">
                      <h1>
                          <field name="water_absorbtion_name" readonly="1" nolabel="1"/>
                          <field name="water_absorption_visible" invisible='1'/>
                      </h1>
                    </div>

                    <div invisible="water_absorption_visible == False" class="custom_table_borders">
                        <field name="water_absorbtion_table" nolabel="1">
                            <tree editable="bottom">
                                <field name='serial_no' width="120"/>
                                <field name='m1' class="blue-input" decoration-info="m1 != 0" width="120"/>
                                <field name='m2' class="blue-input" decoration-info="m2 != 0" width="120"/>
                                <field name='water_absorption' width="120"/>
                                <field name='average' readonly="1" width="120"/>
                                <field name='remark'  class="blue-input" decoration-info="remark" width="120"/>
                            </tree>
                        </field>
                    </div>
                    
                    

                    <table class="table o_form_table w-50 mt-2 custom_table_borders" invisible="not water_absorption_visible">
                        <tbody>
                            <tr>
                                <td><strong>Average Water Absorption</strong></td>
                                <td>
                                    <field name="average_water_absorption"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Conformity</strong></td>
                                <td>
                                    <field name="average_water_absorption_confirmity"
                                        decoration-success="average_water_absorption_confirmity == 'pass'"
                                        decoration-danger="average_water_absorption_confirmity == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong for="average_water_absorption_nabl">NABL</strong></td>
                                <td>
                                    <field name="average_water_absorption_nabl"
                                        decoration-success="average_water_absorption_nabl == 'pass'"
                                        decoration-danger="average_water_absorption_nabl == 'fail'"
                                        readonly="1"/>
                                </td>
                            </tr>
                             <tr>
                                <td><label class="fw-bold" for="water_absorption_report_type">Report Type</label></td>
                                <td><field name="water_absorption_report_type" class="blue-input" decoration-info="water_absorption_report_type != 0"/></td>
                            </tr>
                        </tbody>
                    </table>









                    <notebook>
                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes" />
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />


                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>