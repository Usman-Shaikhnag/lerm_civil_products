<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mechanical_preast_kerb_form" model="ir.ui.view">
        <field name="name">mechanical.precast.kerb.form</field>
        <field name="model">mechanical.precast.kerb</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                <div >
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    </div>

                    <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>

                     <div class="custom_table_borders" style="margin-top: 15px;">
                      <field name="sample_parameters">
                        <tree>
                          <field name="parameter_name"/>
                          <field name="test_method"/>
                        </tree>
                      </field>
                    </div>


                    <!-- Dimension  -->

                    <div invisible="not dimension_visible" >
                        <h1 class="text-center">
                            <field name="dimension_name" readonly="1" nolabel="1" style="margin:20px 0px"/>
                            <field name="dimension_visible" invisible="1" style="margin:20px 0px"/>
                        </h1>
                    </div>

                    <div invisible = "dimension_visible == False" class="custom_table_borders">
                        <field name="dimension_table" nolabel="1">
                            <tree editable="bottom">
                                <field name='sr_no' width="15%"/>
                               
                                <field name='length' class="blue-input" decoration-info="length != 0" width="20%"/>
                                <field name='width' class="blue-input" decoration-info="width != 0" width="20%"/>
                                <field name='height' class="blue-input" decoration-info="width != 0" width="20%"/>
                                 <field name='remarks' class="blue-input" decoration-info="remarks != 0" width="25%"/>
                            </tree>
                        </field> 
                    </div>


                     <div class="d-flex gap-2" invisible="not dimension_visible">  
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="avg_length">Average Length</label>
                                    </td>
                                    <td>
                                        <field name="avg_length"/>
                                    </td>
                                </tr>
                                 <tr>
                                <td><label class="fw-bold" for="avg_length_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_length_conformity"
                                        decoration-success="avg_length_conformity == 'pass'" 
                                        decoration-danger="avg_length_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_length_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_length_nabl"
                                        decoration-success="avg_length_nabl == 'pass'" 
                                        decoration-danger="avg_length_nabl == 'fail'"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="avg_width">Average Width</label>
                                    </td>
                                    <td>
                                        <field name="avg_width"/>
                                    </td>
                                </tr>
                                 <tr>
                                <td><label class="fw-bold" for="avg_width_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_width_conformity"
                                        decoration-success="avg_width_conformity == 'pass'" 
                                        decoration-danger="avg_width_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_width_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_width_nabl"
                                        decoration-success="avg_width_nabl == 'pass'" 
                                        decoration-danger="avg_width_nabl == 'fail'"/>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="avg_height">Average Height</label>
                                    </td>
                                    <td>
                                        <field name="avg_height"/>
                                    </td>
                                </tr>
                                 <tr>
                                <td><label class="fw-bold" for="avg_height_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_height_conformity"
                                        decoration-success="avg_height_conformity == 'pass'" 
                                        decoration-danger="avg_height_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_height_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_height_nabl"
                                        decoration-success="avg_height_nabl == 'pass'" 
                                        decoration-danger="avg_height_nabl == 'fail'"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table>
                    </div>  
                    
                   <!-- Transverse Strength -->
                    <div invisible="not transverse_visible" >
                        <h1 class="text-center">
                            <field name="transverse_name" readonly="1" nolabel="1" style="margin:20px 0px"/>
                            <field name="transverse_visible" invisible="1" style="margin:20px 0px"/>
                        </h1>
                    </div>

                    <div invisible = "transverse_visible == False" class="custom_table_borders">
                        <field name="transverse_table" nolabel="1">
                            <tree editable="bottom">
                                <field name='sr_no' width="10%"/>
                               
                                <field name='width' class="blue-input" decoration-info="width != 0" width="15%"/>
                                <field name='height' class="blue-input" decoration-info="height != 0" width="15%"/>
                                <field name='span' class="blue-input" decoration-info="span != 0" width="20%"/>
                                 <field name='failure_load' class="blue-input" decoration-info="failure_load != 0" width="20%"/>
                                 <field name='transverse_strength' width="20%"/>
                            </tree>
                        </field> 
                    </div>


                     <div class="d-flex gap-2" invisible="not transverse_visible"> 
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="avg_failure_load">Average Failure Load (kN)</label>
                                    </td>
                                    <td>
                                        <field name="avg_failure_load"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="avg_transverse_strength">Average Transverse Strength (MPa)</label>
                                    </td>
                                    <td>
                                        <field name="avg_transverse_strength"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                <tr>
                                <td><label class="fw-bold" for="avg_transverse_strength_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_transverse_strength_conformity"
                                        decoration-success="avg_transverse_strength_conformity == 'pass'" 
                                        decoration-danger="avg_transverse_strength_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_transverse_strength_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_transverse_strength_nabl"
                                        decoration-success="avg_transverse_strength_nabl == 'pass'" 
                                        decoration-danger="avg_transverse_strength_nabl == 'fail'"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table> 
                        </div>



                        <!-- Water Absorbtion -->

                   
                    <div invisible="not water_absorbtion_visible" >
                        <h1 class="text-center">
                            <field name="water_absorbtion_name" readonly="1" nolabel="1" style="margin:20px 0px"/>
                            <field name="water_absorbtion_visible" invisible="1" style="margin:20px 0px"/>
                        </h1>
                    </div>

                    <div invisible = "water_absorbtion_visible == False" class="custom_table_borders">
                        <field name="water_absorbtion_table" nolabel="1">
                            <tree editable="bottom">
                                <field name='sr_no' width="10%"/>
                               
                                <field name='dry_weight' class="blue-input" decoration-info="dry_weight != 0" width="20%"/>
                                <field name='wet_weight' class="blue-input" decoration-info="wet_weight != 0" width="20%"/>
                                 <field name='water_absorbed' width="25%"/>
                                 <field name='water_absorption' width="25%"/>
                            </tree>
                        </field> 
                    </div>


                        <table class="table table-sm table-bordered w-50 custom_table_borders" style="white-space:nowrap;">
                            <tbody>
                                
                                <tr>
                                    <td>
                                        <label class="fw-bold" for="avg_water_absorption">Average  Water Absorption (%)</label>
                                    </td>
                                    <td>
                                        <field name="avg_water_absorption"/>
                                    </td>
                                </tr>
                                <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_conformity">Conformity</label></td>
                                <td>
                                    <field name="avg_water_absorption_conformity"
                                        decoration-success="avg_water_absorption_conformity == 'pass'" 
                                        decoration-danger="avg_water_absorption_conformity == 'fail'" 
                                        readonly="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="fw-bold" for="avg_water_absorption_nabl">NABL</label></td>
                                <td>
                                    <field name="avg_water_absorption_nabl"
                                        decoration-success="avg_water_absorption_nabl == 'pass'" 
                                        decoration-danger="avg_water_absorption_nabl == 'fail'"/>
                                </td>
                            </tr>
                               
                            </tbody>
                        </table> 





                         <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                     
                    <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />


                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>