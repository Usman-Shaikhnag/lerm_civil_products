                    </group>


                        <field name="child_lines1" class="custom_table_borders" nolabel="1">
                            <tree editable="bottom">
                                <field name='depth1'/>
                                <field name='depth2'/>
                                <field name='depth3'/>
                                <field name='depth4'/>
                                <field name='depth5'/>
                                <field name='depth6'/>
                                <field name='depth7'/>
                                <field name='dx_avg'/>
                              
                            </tree>
                           
                         </field> 
                        

                  
                    
                     <group style="white-space: nowrap; width:80%;margin-top:20px;">
                        <h1>
                            <field name="observed_value_name" readonly="1" nolabel="1"/>
                        
                        </h1>
                    </group>
                   

            
                  
                  



                     <div class="custom_table_borders" style="width:100%;">
                            <table style="width: 100%; border-collapse: collapse;">
