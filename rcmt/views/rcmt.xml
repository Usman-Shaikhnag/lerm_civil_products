                                          <field name="initial_current3" nolabel="1" class="blue-input"/>
                                        </td>
                                    </tr>


                                     <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="initial_temprrature1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="initial_temprrature1" nolabel="1" class="blue-input"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="initial_temprrature2" nolabel="1" class="blue-input"/>
                                        </td>
                                           <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="initial_temprrature3" nolabel="1" class="blue-input"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="final_voltage1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="final_voltage1" nolabel="1" class="blue-input"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="final_voltage2" nolabel="1" class="blue-input"/>
                                        </td>
                                           <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="final_voltage3" nolabel="1" class="blue-input"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="final_curent1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="final_curent1" nolabel="1" class="blue-input"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="final_curent2" nolabel="1" class="blue-input"/>
                                        </td>
                                           <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="final_curent3" nolabel="1" class="blue-input"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="final_tempreture1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="final_tempreture1" nolabel="1" class="blue-input"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="final_tempreture2" nolabel="1" class="blue-input"/>
                                        </td>
                                           <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="final_tempreture3" nolabel="1" class="blue-input"/>
                                        </td>
                                    </tr>

                                   




                                    
                                    
                                </tbody>
                            </table>
                        </div>

                      <group style="white-space: nowrap; width:80%;margin-top:20px;">
                        <h1>
                            <field name="depth_name" readonly="1" nolabel="1"/>
                        
                        </h1>
                    </group>


                        <field name="child_lines1" class="custom_table_borders" nolabel="1">
                            <tree editable="bottom">
                                <field name='depth1' class="blue-input" decoration-info="depth1 != 0"/>
                                <field name='depth2' class="blue-input" decoration-info="depth2 != 0"/>
                                <field name='depth3' class="blue-input" decoration-info="depth3 != 0"/>
                                <field name='depth4' class="blue-input" decoration-info="depth4 != 0"/>
                                <field name='depth5' class="blue-input" decoration-info="depth5 != 0"/>
                                <field name='depth6' class="blue-input" decoration-info="depth6 != 0"/>
                                <field name='depth7' class="blue-input" decoration-info="depth7 != 0"/>
                                <field name='dx_avg'/>
                              
                            </tree>
                           
                         </field> 
                        

                  
                    
                     <group style="white-space: nowrap; width:80%;margin-top:20px;">
                        <h1>
                            <field name="observed_value_name" readonly="1" nolabel="1"/>
                        
                        </h1>
                    </group>
                   

            
                  
                  



                     <div class="custom_table_borders" style="width:100%;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                        Parameters
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                          Specimen-01
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                          Specimen-02
                                        </th>
                                        <th style="border: 1px solid black; text-align: center; color: black; padding: 10px 20px;">
                                          Specimen-03
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="specimen1_ov1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="specimen1_ov1" nolabel="1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="specimen2_ov1" nolabel="1"/>
                                        </td>
                                           <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="specimen3_ov1" nolabel="1"/>
