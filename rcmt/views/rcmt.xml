                                </tbody>
                            </table>
                        </div>

                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="margin-top:20px;">
                        <tbody>
                            <tr>
                                <td><label for="overall_average">Average </label></td>
                                <td><field name="overall_average"/></td>
                            </tr>
                            
                             <tr>
                             <td><label for="overall_average_conformity" class="text-bold">Conformity</label></td>
                              <td><field name='overall_average_conformity'
                                       decoration-success="overall_average_conformity == 'pass'" 
                                       decoration-danger="overall_average_conformity == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                           <tr>
                            <td><label for="overall_average_nabl" class="text-bold">NABL</label></td>
                            <td><field name="overall_average_nabl"
                                       decoration-success="overall_average_nabl == 'pass'" 
                                       decoration-danger="overall_average_nabl == 'fail'" 
                                       readonly="1"/></td>
                           </tr>
                        </tbody>
                    </table>



                    
                <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
