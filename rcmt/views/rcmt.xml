                                            <label for="specimen2"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="specimen2" nolabel="1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="specimen3" nolabel="1"/>
                                        </td>
                                           <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="specimen4" nolabel="1"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="specimen1_depth1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="specimen1_depth1" nolabel="1"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="specimen2_depth2" nolabel="1"/>
                                        </td>
                                           <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="specimen3_depth3" nolabel="1"/>
                                        </td>
                                    </tr>


                                     <tr>
                                        <td style="border: 1px solid black; color: black; padding: 8px 10px;">
                                            <label for="specimen1_ov3"/>
                                        </td>
