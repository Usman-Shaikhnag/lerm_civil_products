                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                            <field name="diameter_specimen1" nolabel="1" class="blue-input"/>
                                        </td>
                                        <td style="border: 1px solid black; text-align: center; padding: 8px 10px;">
                                          <field name="diameter_specimen2" nolabel="1" class="blue-input"/>
                                        </td>
