                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>



                       
                      <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>


        <record id="view_rcmt_prefill_data_form" model="ir.ui.view">
            <field name="name">rcmt.prefill.data.form</field>
            <field name="model">rcmt.prefill.data</field>
            <field name="arch" type="xml">
                <form string="Prefill Data">
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="sample_id"/>

                    </group>
                    <footer>
                        <button name="prefill_data" string="Prefill Data" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_rcmt_prefill_data_wizard" model="ir.actions.act_window">
            <field name="name">Prefill Data</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">rcmt.prefill.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_rcmt_prefill_data_form"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>