									</span>
								</td>
								
                               
								
								<td rowspan="3" style="text-align: center; vertical-align: middle;">
									<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','78954gh24-391c-4d7b-818d-28f7b75ea261')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
											<span t-field="parameter.permissable_limit"/>
										</t>
									</t>
								</td>
								
							</tr>


