										<span style="font-weight: bold;">
											Sr No
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											 Thickness of specimen, mm (L)

										</span>
									</th>
									
									
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Diameter of specimen, mm
										</span>
									</th>
									<th style="text-align: center;">
										<span style="font-weight: bold;">
											Applied Voltage V

										</span>
									</th>
									<th style="text-align: center;">
									<span style="font-weight: bold;">
										Initial Current mA

									</span>
									</th>
									<th style="text-align: center;">
									<span style="font-weight: bold;">
										Final Current mA

									</span>
							     	</th>
									<th style="text-align: center;">
									 <span style="font-weight: bold;">
										Initial Temp °C

									 </span>
									 
									</th>

									<th style="text-align: center;">
									 <span style="font-weight: bold;">
										Final Temp °C


									 </span>
									 
									</th>
									<th style="text-align: center;">
									 <span style="font-weight: bold;">
										Depth of penetration mm


									 </span>
									 
									</th>

										<th style="text-align: center;">
