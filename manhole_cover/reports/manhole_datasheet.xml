<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="manhole_datasheet">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			<t t-call="lerm_civil.data_sheet_header_generaltemplate">
                <div style="text-align:center;font-size:18px">
                    Manhole Cover Frame Test Data Sheet
                </div>

                <div class="container_eln" style="margin-top:5px">
				 <table style="margin-top:20px">
				<tr cols="12">
					
					<td colspan="6">Job No :
                        <![CDATA[&nbsp;]]>
                         <span t-field="eln.kes_no"></span>
                    </td>
					<td colspan="6">Test Start Date: 
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.start_date"></span>
                    </td>
				</tr>
                <tr>
                  <td colspan="6">Material: <span t-field="eln.material"></span>
                </td>
                 <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                </td>
                </tr>
                <tr style="height:50px" cols="12">
                    <td colspan="4">Performed By :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.technician.name"/>
                    </td>
                    <td colspan="4">Witness Name :
                        <![CDATA[&nbsp;]]>
                        <span t-field="eln.witness_description"/>
                    </td>
                    <td colspan="4">Witness Signature :
                        <![CDATA[&nbsp;]]>
                        <span style='padding:20px'></span>
                    </td>
                </tr>
			</table>
		</div>
					<!-- LOAD TEST & PERMANENT SET TEST DATA -->
                <div t-if="data.load_permanent_set_test_lines" style="margin-top:20px">
						<div style="text-align:center;font-size:18px">
							LOAD TEST &amp; PERMANENT SET TEST DATA 
							<span>
								<t t-set="load_line" t-value="data.load_permanent_set_test_lines and data.load_permanent_set_test_lines[0]"/>
								<t t-if="load_line">
									: Should safely sustain a load of <t t-esc="load_line.specified_load"/> kN and hold for minimum <t t-esc="load_line.load_holding_time"/> seconds.
								</t>
							</span>
						</div>

					<table style="margin-top:20px" width="100%">
							<tr cols="12">
								<td colspan="1">Sr.No 
								</td>
								<td colspan="4"> initial gauge
								</td>
								<td colspan="4">final gauge
								</td>
								<td colspan="3">permanent set
								</td>
								<td colspan="3">specified load
								</td>
								<td colspan="3">load holding time
								</td>
								
							</tr>

							<t t-set="i" t-value="0"/>
							<tr t-foreach="data.load_permanent_set_test_lines" t-as="r">
								<td colspan="1">
									<div>
										<span t-esc="i + 1" />
										<t t-set="i" t-value="i+1"/>
									</div>
                  				</td>
								<td colspan="4">
									<span t-esc="r['initial_gauge']"/>
								</td>
								<td colspan="4">
									<span t-esc="r['final_gauge']"/>
								</td>
								<td colspan="3">
									<span t-esc="r['permanent_set']"/>
								</td>
								<td colspan="3">
									<span t-esc="r['specified_load']"/>
								</td>
								<td colspan="3">
									<span t-esc="r['load_holding_time']"/>
								</td>
								
							</tr>
						</table>
					</div>




						<table style="margin-top:20px"  width = "100%">
							<tr cols="12">
								<td colspan="6">Average Permanent Set:	
									<![CDATA[&nbsp;]]>
								</td>
                                <td colspan="6">
									<span t-field="data.average_permanent_set"/>
								</td>
							</tr>
                            
							
						</table>

						<table style="margin-top:20px" padding= "30px" width = "100%">
						<span>Remark</span>
							<tr cols="12">
								<td colspan="6">Load Test Result:	
									<![CDATA[&nbsp;]]>
								</td>
                                <td colspan="6">
									<span t-field="data.load_test_result"/>
								</td>
							</tr>
							<tr cols="6">
								<td colspan="6"> Permanent Set:	
									<![CDATA[&nbsp;]]>
								</td>
                                <td colspan="6">
									<span t-field="data.permanent_set_test_result"/>
								</td>
							</tr>
						</table>

				<!-- 2. DEFECTS & WORKMANSHIP TEST DATA					-->
                <div t-if="data.defects_workmanship_test_data_line" style="margin-top:20px">
						<div style="text-align:center;font-size:18px">
							DEFECTS &amp; WORKMANSHIP TEST DATA	
							<span>
								<t t-foreach="env['lerm.parameter.master'].search([('internal_id','=','fefc06a7-a312-44d8-b0c1-70166720935d')]).parameter_table" t-as="parameter">
									<t t-if="parameter.grade.id == eln.grade_id.id">
										<span t-field="parameter.permissable_limit"/>
									</t>
								</t>
							</span>
						</div>


						<table style="margin-top:20px" width="100%">
							<thead>
							<tr cols="12">
								<td colspan="2">Speciman No</td>
								<td colspan="2">Visual Inspection Parameter</td>
								<td colspan="2">Specified Requirement (IS 12592)</td>
								<td colspan="3">Observed Condition</td>
								<td colspan="3">Confromity</td>
							</tr>
							</thead>
							<tbody>
							<t t-set="i" t-value="0"/>
							<tr t-foreach="data.defects_workmanship_test_data_line" t-as="r">
							
								<td colspan="2">
									<span t-esc="r['specimen_no']"/>
								</td>
								<td colspan="2">
									<span t-esc="r['visual_inspection_parameter']"/>
								</td>
								
								<!-- <td colspan="2">
									<span t-esc="r['specified_requirements']"/>
								</td> -->
								<td colspan="2">
									<span t-field="r.specified_requirements"/>
								</td>
								<td colspan="3">
									<span t-field="r.observed_conditions"/>
								</td>
								<td colspan="3">
									<span t-field="r.con"/>
								</td>								
							</tr>
							</tbody>
						</table>
					</div>&#160;

				<div style="display:flex;">
                    <div style="width:100%;">
                        <table class="table table-sm o_form_table table-bordered custom_table_borders" style="width:98%;">
                            <tbody><span>Remark</span>
                                
								<tr cols="6">
								<td colspan="6">DEFECTS &amp; WORKMANSHIP:	
									<![CDATA[&nbsp;]]>
								</td>
                                <td colspan="6">
									<span t-field="data.defects_workmanship_test_result"/>
								</td>
							</tr>
                                
                            </tbody>
                        </table>
                    </div>
                    </div>


  <div class="authorizeRowDataSheet">
                <div>
                    <div>
                        <b>
                            Tested By 
                        </b>
                        
                    </div>
                     <!-- <div style="height: 40px;">
						<t t-if="eln.sample_id.testedby_signature_required">
								<t t-if="eln.tested_by_signature_datasheet">

									<div t-if="eln.sample_id.filled_by.employee_id.signature">
										<img t-att-src="'data:image/png;base64,' + eln.sample_id.filled_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
									</div>
									
								</t>
							</div> -->
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.filled_by.name"/>
                        </b>
                    </div>
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.filled_by.job_title"/>)
                        </b>
                    </div>
                </div>
                <div style="margin-left:500px">
                    
                    <div>
                        <b>
                            Checked By
                        </b>
                    </div>
                  <!-- <div style="height: 40px;">
						<t t-if="eln.sample_id.checked_by_signature_datasheet">
							<div t-if="eln.sample_id.check_by.employee_id.signature">
								<img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
							</div>
							
						</t>
					</div> -->
                    <div>
                        <b>
                        <span t-esc="eln.sample_id.check_by.name"/>
                        </b>
                    </div>
                    
                    <div>
                        <b>
                            (<span t-esc="eln.sample_id.check_by.job_title"/>)
                        </b>
                    </div>
                </div>
            </div>			
		
		</t>
	</t>
</template>
</odoo>
