<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	   <template id="manhole_report">
		<t t-call="web.html_container">
			<!-- <t t-call="web.basic_layout"> -->
			 <t t-call="lerm_civil.custom_layout_header_footer_lerm_eln">
			

			

				<div class="container_eln">
					<div t-foreach="eln" t-as="o">
					
						<table style="margin-top:10px;">
							<tr>
								<td colspan="12">Customer Party Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.customer.name"/><br/>
									<span t-field="o.srf_id.customer.street"/>
									<span t-field="o.srf_id.customer.street2"/>
									<span t-field="o.srf_id.customer.city"/>
									<span t-if="o.srf_id.customer.zip" t-field="o.srf_id.customer.zip"/>
									<span t-field="o.srf_id.customer.state_id"/>
											,
									<span t-field="o.srf_id.customer.country_id"/>
								</td>
							</tr>
							<tr>
								
								<td colspan="12">Project / Site Address : <![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.name_work"/>
								</td>
							</tr>
							<tr>
								<td colspan="12">Sample Description : <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_description"/>
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td colspan="6">Test Start Date :<![CDATA[&nbsp;]]>
									<span t-field="o.start_date"/>
								</td>
								<td colspan="6">Test End Date :<![CDATA[&nbsp;]]>
									<span t-field="o.end_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Sample Id Mark: <![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.client_sample_id"/>
								</td>
								<td colspan="6">Sample Receipt Date :<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.sample_received_date"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Size :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.size_id.size"/>
								</td>
								<td colspan="6">Grade :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.grade_id.grade"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Brand :
									<![CDATA[&nbsp;]]>
									<span t-field="o.sample_id.brand"/>
								</td>
								<td colspan="6">Consultant Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.consultant_name1"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Client Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client"/>
								</td>
								<td colspan="6">Client Reference :
									<![CDATA[&nbsp;]]>
									<span t-field="o.srf_id.client_refrence"/>
								</td>
							</tr>
							<tr>
								<td colspan="6">Discipline :
									<![CDATA[&nbsp;]]>
									<span t-field="o.discipline.discipline"/>
								</td>
								<td colspan="6">Group :
									<![CDATA[&nbsp;]]>
									<span t-field="o.group.group"/>
								</td>
							</tr>

							<tr>
								<td colspan="12">Material/Test Name :
									<![CDATA[&nbsp;]]>
									<span t-field="o.material.name"/>
								</td>
							</tr>
							
								<tr t-if="o.material.source_sample">
									<td colspan="12">Source of Sample: <![CDATA[&nbsp;]]><span t-field="o.material.source_sample"/></td>
								</tr>

							
								<tr t-if="o.material.test_method_adopted">
									<td colspan="12">Test method adopted: <![CDATA[&nbsp;]]>
									<span t-field="o.material.test_method_adopted"/></td>
								</tr>
						</table>
					</div>
					
					<div>
						<t t-set="load_param" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','902f262d-e3c2-4e2d-881b-38f1ca647406')], limit=1)"/>
						<t t-set="defects_param" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','fefc06a7-a312-44d8-b0c1-70166720935d')], limit=1)"/>
						<table>
							<thead>
							<tr>
								<td>Sr. No</td>
								<td>Test Parameter</td>
								<td>unit</td>
								<td>Specified Requirements (IS 12592 : 2002)
								<span t-field="eln.material.specifications"></span>
								</td>
								<td>Observed Test Result</td>
								<td>Confirmity</td>
							</tr>
						</thead>
								<tbody>
								<tr>
									<td>1</td>
									<td>LOAD TEST</td>
									<td>KN</td>
									
									<td>
										<t t-set="load_line" t-value="data.load_permanent_set_test_lines and data.load_permanent_set_test_lines[0]"/>
										<t t-if="load_line">
											Should safely sustain a load of <t t-esc="load_line.specified_load"/> kN and hold for minimum <t t-esc="load_line.load_holding_time"/> seconds.
										</t>
									</td>
									<td>
										<span t-field="data.load_test_result"/>
									</td>
									<td>Pass</td>
								</tr>
								<tr>
									<td>2</td>
									<td>PERMANENT TEST</td>
									<td>mm</td>
									<td>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','195616f3-5162-4ee3-a16e-52e6266e1307')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
                                                <span t-field="parameter.permissable_limit"/>
                                        </t>
									</t>
									</td>
									<td>
										<span t-field="data.permanent_set_test_result"/>
									</td>
									<td>Pass</td>
								</tr>
								<tr>
									<td>3</td>
									<td>DEFECTS &amp; WORKMANSHIP</td>
									<td>--</td>
									<td>
										<t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','fefc06a7-a312-44d8-b0c1-70166720935d')]).parameter_table" t-as="parameter">
										<t t-if="parameter.grade.id == eln.grade_id.id">
                                                <span t-field="parameter.permissable_limit"/>
                                        </t>
									</t>
									</td>
									<td>
										<span t-field="data.defects_workmanship_test_result"/>
									</td>
									<td>Pass</td>
								</tr>
								</tbody>
						</table>
					</div>


					<div style="page-break-inside: avoid;">
						<div style="margin-top:20px" class="noteContainer">
							<div>
								<b>Note :-</b>
							</div>
							<div>
								<ul>
									<li>
										The Test Report(s) is/are valid only to the sample submitted to the laboratory.
									</li>
									<li>
										Sample(s) was/were not drawn by laboratory.
									</li>
									<li>
										This Report may not be reproduced in except full/ part without the permission of the Lab Head of the Laboratory.
									</li>
									<li t-if="eln.has_witness">
										Test witnessed by : <span t-esc="eln.witness_name"/>
										
									</li>
									<li t-if="eln.remarks">
										<span t-esc="eln.remarks"/>
									</li>
								</ul>
							</div>
						</div>




						
						 



						<div class="signatureContainer girdgird">
							<div>
								<div>
									<b>
										Reviewed By
									</b>
								</div>
								<div style="height:20px">

								</div>
								<div>
									<b>
										<span t-esc="eln.technician.name"/>
									</b>
								</div>
								<div>
									<b>
										(<span t-esc="eln.sample_id.check_by.job_title"/>)
									</b>
								</div>
							</div>

							<div>
						<div>
							<img t-attf-src="/lerm_civil/static/src/img/stamp1.png" alt="Image"/>
						</div>
						<div style="padding-top:5px">
							Format No. <span t-esc="eln.material.test_format_no"/>
						</div>
					</div>
							
							<div>
								<div>
									<b>
										Approved By 
									</b>
									
								</div>
								<!-- <div style="height:20px">

								</div> -->
								<div style="height: 40px;">
											<t t-if="eln.sample_id.approveby_signature_required">
												<div t-if="eln.sample_id.approved_by.employee_id.signature">
													<img t-att-src="'data:image/png;base64,%s' % eln.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;"/>
												</div>
												
											</t>
										</div>
								<div>
									<b>
									<span t-esc="eln.sample_id.approved_by.name"/>
									</b>
								</div>
							
								<div>
									<b>
										 (<span t-esc="eln.sample_id.approved_by.job_title"/>)
									</b>
								</div>
								
								<!-- <div>
									<b>
										(Authorized Signatory)
									</b>
								</div> -->
							</div>
						</div>
						<div style="text-align:center;margin-top:25px">
							......End of Report......
						</div>
					</div>

				</div>
			</t>
		</t>
	</template>
</odoo>