<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_layout_header_footer_lateral_pile_load">
            
            <div class="header" style="width:100%; margin:0; padding:0; overflow:visible; display:block;">
            <t t-set="lab" t-value="o.lab_id.sudo()"/>
            <t t-set="master_lab" t-value="env['lerm.lab.master'].sudo().search([], limit=1)"/>

            <table style="width:100%;
                        border-collapse:collapse;
                        margin:0;
                        padding:0;
                        display:table;
                        table-layout:fixed;">
                <tr>
                    <td style="padding:3px;">Test Report No :</td>
                    <td style="padding:3px;">
                        <t t-esc="o.report_no"/>
                    </td>

                    <td style="padding:3px;">Report Issue Date :</td>
                    <td style="padding:3px;">
                        <t t-esc="o.rec_date_str"/>
                    </td>

                    <td style="padding:3px;">ULR No.</td>
                    <td style="padding:3px;">
                        <t t-esc="o.ulr"/>
                    </td>
                </tr>
            </table>
        </div>

        <t t-out="0"/>

        <div class="footer">
            <table style="width:100%; border-collapse:collapse; font-family:'Times New Roman',Times,serif; font-size:12pt; table-layout:fixed; border:1px solid #000;">
                <colgroup>
                    <col style="width:40%;"/>
                    <col style="width:40%;"/>
                    <col style="width:20%;"/>
                </colgroup>
                <tr>
                    <td style="border:1px solid #000; padding:8px 14px; vertical-align:middle; text-align:left; height:65px;">
                        <b>Location:</b> <span t-esc="o.pile_no"/>
                    </td>
                    <td style="border:1px solid #000; padding:8px 14px; vertical-align:middle; text-align:center;">
                        <b>Report No:</b> <span t-esc="o.report_no"/>
                    </td>
                    <td style="border:1px solid #000; padding:8px 14px; vertical-align:middle; text-align:center; font-weight:bold;">
                        <span class="page"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

</odoo>
