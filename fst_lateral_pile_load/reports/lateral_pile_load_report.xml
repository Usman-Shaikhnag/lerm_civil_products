<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lateral_report_paperformat" model="report.paperformat">
        <field name="name">Lateral Pile Load Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">34</field>
        <field name="header_line" eval="False"/>
    </record>

    <record id="lateral_pile_load_report" model="ir.actions.report">
        <field name="name">Lateral Pile Load Report</field>
        <field name="model">fst.lateral.pile.load.test</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">fst_lateral_pile_load.lateral_pile_load_template</field>
        <field name="print_report_name">'Lateral_Pile_Load_Report'</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="model_fst_lateral_pile_load_test"/>
        <field name="paperformat_id" ref="lateral_report_paperformat"/>
    </record>

    <template id="lateral_pile_load_template">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs and docs[0]"/>
            <t t-set="lab" t-value="o.lab_id.sudo()"/>
            <t t-set="master_lab" t-value="env['lerm.lab.master'].sudo().search([], limit=1)"/>

            <t t-call="fst_lateral_pile_load.custom_layout_header_footer_lateral_pile_load">
            <style>
                @page { margin-top: 40mm; }
                body { font-family: 'Times New Roman', Times, serif; font-size: 10pt; color: #000000; margin: 0; padding: 0; }
    
                h2.report-title { text-align: center; font-size: 13pt; font-weight: bold; margin: 12px 0 8px 0; text-transform: uppercase; letter-spacing: 1px; }
                h3.section-heading { font-size: 14pt; font-weight: bold; margin: 25px 0 15px 0; text-transform: uppercase; font-family: 'Times New Roman', serif; }
                h4.sub-heading { font-size: 12pt; font-weight: bold; margin: 22px 0 15px 0; font-family: 'Times New Roman', serif; }
                p.section-text { font-size: 11pt; line-height: 1.9; text-align: justify; margin-bottom: 18px; font-family: 'Times New Roman', serif; }
                table.meta-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 10pt; margin-bottom: 8px; }
                table.meta-table td { border: 1px solid #000000; padding: 4px 6px; vertical-align: middle; }
                table.meta-table td.label { font-weight: bold; background: #f3f3f3; white-space: nowrap; width: 28%; }
                table.toc-table { width: 100%; border-collapse: collapse; font-size: 11pt; }
                table.toc-table thead tr th { border-bottom: 1px solid #000; padding: 6px 4px; text-align: left; font-weight: bold; }
                table.toc-table td { padding: 5px 4px; vertical-align: top; }
                table.toc-table td.toc-srno { width: 10%; text-align: left; }
                table.toc-table td.toc-page { width: 12%; text-align: right; }
                table.dial-table { width: 100%; border-collapse: collapse; font-size: 8pt; }
                table.dial-table th { background-color: #244061; color: #ffffff; border: 1px solid #000; padding: 2px; text-align: center; }
                table.dial-table td { border: 1px solid #000; padding: 2px; text-align: center; }
                table.summary-table { width: 100%; border-collapse: collapse; font-size: 10pt; margin-bottom: 10px; }
                table.summary-table th { background-color: #244061; color: #ffffff; border: 1px solid #000; padding: 4px; text-align: center; }
                table.summary-table td { border: 1px solid #000; padding: 4px; text-align: center; }
                table.signature-table { width: 80%; margin: 30px auto 0 auto; border-collapse: collapse; }
                table.signature-table td { width: 50%; vertical-align: top; padding: 10px; border: 1px solid #000; text-align: center; }
                .page-break { page-break-after: always; }
                .text-center { text-align: center; }
                .bold { font-weight: bold; }
                .page { margin-top: 20px; font-family: 'Times New Roman', Times, serif; }
                .end-of-report { text-align: center; font-weight: bold; margin-top: 20px; font-size: 11pt; }
                .annexure-page { width: 100%; padding-top: 110mm; text-align: center; page-break-after: always; page-break-inside: avoid; }
                .annexure-title { font-family: 'Times New Roman', serif; font-size: 30pt; font-weight: bold; margin-bottom: 22px; }
                .annexure-subtitle { font-family: 'Times New Roman', serif; font-size: 26pt; font-weight: bold; text-transform: uppercase; }
            </style>

            <main>
                <div class="page">

                    <!-- ═════ FIRST PAGE / COVER ═════ -->
                    <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
                        <colgroup>
                            <col style="width:20%;"/>
                            <col style="width:16%;"/>
                            <col style="width:24%;"/>
                            <col style="width:14%;"/>
                            <col style="width:14%;"/>
                            <col style="width:12%;"/>
                        </colgroup>
                        <tr style="height:12mm;">
                            <td style="border:1px solid #000; padding:2px 4px; font-weight:bold; background:#f3f3f3; vertical-align:middle; font-size:8.5pt;">Test Report no :</td>
                            <td style="border:1px solid #000; padding:2px 4px; vertical-align:middle; font-size:7.5pt; word-break:break-all; overflow:hidden;">
                                <span t-esc="o.report_no"/>
                            </td>
                            <td style="border:1px solid #000; padding:2px 4px; font-weight:bold; background:#f3f3f3; vertical-align:middle; font-size:8.5pt;">Report Issue Date :</td>
                            <td style="border:1px solid #000; padding:2px 4px; vertical-align:middle; font-size:7.5pt; word-break:break-all; overflow:hidden;">
                                <span t-esc="o.rec_date_str"/>
                            </td>
                            <td style="border:1px solid #000; padding:2px 4px; font-weight:bold; background:#f3f3f3; vertical-align:middle; font-size:8.5pt;">ULR No.</td>
                            <td style="border:1px solid #000; padding:2px 4px; vertical-align:middle; font-size:7.5pt; word-break:break-all; overflow:hidden;">
                                <span t-esc="o.ulr"/>
                            </td>
                        </tr>
                    </table>

                    <div style="height:18mm;"></div>

                    <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle; height:30mm;">
                                <b>Customer Party Name:</b><br/>
                                <span t-esc="o.client"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle; height:30mm;">
                                <b>Project / Site Address:</b><br/>
                                <span t-esc="o.site_location"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;">
                                            <b>Name of Work:</b>
                                            <span t-esc="o.work_name"/>
                                        </td>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;">
                                            <b>Report Date:</b>
                                            <span t-esc="o.rec_date_str"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;">
                                            <b>Pile ID:</b>
                                            <span t-esc="o.pile_no"/>
                                        </td>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;"></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;">
                                            <b>Discipline:</b>
                                            <span t-esc="o.discipline"/>
                                        </td>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;">
                                            <b>Group:</b>
                                            <span t-esc="o.group"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle;">
                                <table style="width:100%; border-collapse:collapse;">
                                    <tr>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;">
                                            <b>Test Standard:</b>
                                            <span t-esc="o.test_standard"/>
                                        </td>
                                        <td style="border:none; padding:2px 4px; width:50%; vertical-align:middle;">
                                            <b>Contractor:</b>
                                            <span t-esc="o.contractor"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle;">
                                <b>Test Name:</b>
                                Initial Lateral Pile Load Test
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; vertical-align:middle;">
                                <b>References:</b>
                                <span t-esc="o.test_standard"/>
                            </td>
                        </tr>
                    </table>

                    <div style="page-break-before: always;"></div>

                    <!-- ═════ TABLE OF CONTENTS ═════ -->
                    <div style="text-align:center; font-size:13pt; font-weight:bold; letter-spacing:2px; margin-bottom:30px; text-transform:uppercase;">
                        TABLE OF CONTENTS
                    </div>

                    <div style="border-top:2px solid #000; margin-bottom:16px;"></div>

                    <table style="width:100%; border-collapse:collapse; font-size:11pt;">
                        <thead>
                            <tr style="border-bottom:1px solid #000;">
                                <th style="padding:6px 4px; text-align:left; font-weight:bold; width:10%;">Sr. No.</th>
                                <th style="padding:6px 4px; text-align:left; font-weight:bold;">Description</th>
                                <th style="padding:6px 4px; text-align:right; font-weight:bold; width:12%;">Page No.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.content_ids" t-as="line">
                                <td style="padding:5px 4px; text-align:left; vertical-align:top; width:10%;">
                                    <span t-if="line.sequence != 0" t-esc="line.sequence"/>
                                </td>
                                <td style="padding:5px 4px; text-align:left; vertical-align:top;">
                                    <span t-esc="line.description"/>
                                </td>
                                <td style="padding:5px 4px; text-align:right; vertical-align:top; width:12%;">
                                    <span t-esc="line.page_no"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="border-bottom:2px solid #000; margin-top:16px;"></div>
                    <div style="page-break-before: always;"></div>

                    <!-- ═════ 1. GENERAL PHILOSOPHY ═════ -->
                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h3 style="font-size:14pt; font-weight:bold; text-transform:uppercase; margin-top:25px; margin-bottom:15px; font-family:'Times New Roman',serif;">1. GENERAL PHILOSOPHY</h3>
                        <p style="font-size:11pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                            <span t-esc="o.general_philosophy"/>
                        </p>
                    </div>

                    <!-- ═════ 2. METHODOLOGY ═════ -->
                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h3 style="font-size:14pt; font-weight:bold; text-transform:uppercase; margin-top:25px; margin-bottom:15px; font-family:'Times New Roman',serif;">2. METHODOLOGY FOR LATERAL PILE LOAD TESTING:</h3>

                        <h4 style="font-size:12pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.1 Scope of Work:</h4>
                        <p style="font-size:11pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                            <span t-esc="o.scope_of_works"/>
                        </p>
                    </div>

                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h4 style="font-size:12pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.2 Reference:</h4>
                        <ul style="margin-left:40px; padding-left:25px; line-height:2; font-size:11pt; font-family:'Times New Roman',serif; list-style-type:disc;">
                            <li>IS 2911 (Part 4) - 2013 - Code of practice for design and construction of pile foundations - Part 4 Load Test on Piles.</li>
                        </ul>
                    </div>

                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h4 style="font-size:12pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.3 Equipments Used:</h4>
                        <ul style="margin-left:40px; padding-left:25px; line-height:2; font-size:11pt; font-family:'Times New Roman',serif; list-style-type:disc;">
                            <li>Hydraulic Jack - 100 MT Capacity</li>
                            <li>Pressure Gauge - 0-280 kg/cm2 with LC of 5.0 kg/cm2</li>
                            <li>Dial Gauges - 2 Nos of Dial Gauges of 25 mm travel with LC of 0.01 mm</li>
                        </ul>
                    </div>

                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h4 style="font-size:12pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.4 Setting up of Testing Apparatus</h4>
                        <p style="font-size:11pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                            <span t-esc="o.setup_apparatus"/>
                        </p>
                    </div>

                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h4 style="font-size:12pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.5 Load Test Procedure</h4>
                        <p style="font-size:11pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                            <span t-esc="o.test_procedure"/>
                        </p>
                    </div>

                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h4 style="font-size:12pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.6 Preparation of Test Report</h4>
                        <p style="font-size:11pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                            <span t-esc="o.preparation_report"/>
                        </p>
                    </div>

                    <div style="page-break-inside:avoid; break-inside:avoid;">
                        <h4 style="font-size:12pt; font-weight:bold; margin-top:22px; margin-bottom:15px; font-family:'Times New Roman',serif;">2.7 Conclusion</h4>
                        <p style="font-size:11pt; line-height:1.9; text-align:justify; margin-bottom:18px; font-family:'Times New Roman',serif;">
                            <span t-esc="o.conclusion"/>
                        </p>
                    </div>

                    <!-- ═════ SIGNATURE ═════ -->
                    <div style="margin-top:30px; text-align:center; font-size:12pt; page-break-inside:avoid;">
                        <table style="width:80%; margin:0 auto; border-collapse:collapse;">
                            <tr>
                                <td style="width:50%; vertical-align:top; padding:10px; border:1px solid #000;">
                                    <b>Checked By</b><br/>
                                    <div t-if="o.sample_id.check_by.employee_id.signature">
                                        <img t-att-src="'data:image/png;base64,%s' % o.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width:280px; max-height:55px; margin-top:1px; z-index:-10;"/>
                                    </div>
                                    <br/><br/><br/>
                                    <span t-esc="o.sample_id.check_by.name or o.signatory_name"/>
                                </td>
                                <td style="width:50%; vertical-align:top; padding:10px; border:1px solid #000;">
                                    <b>Approved By</b><br/>
                                    <div t-if="o.sample_id.approved_by.employee_id.signature">
                                        <img t-att-src="'data:image/png;base64,%s' % o.sample_id.approved_by.employee_id.signature.decode('utf-8')" style="max-width:280px; max-height:55px; margin-top:1px; z-index:-10;"/>
                                    </div>
                                    <br/><br/><br/>
                                    <span t-esc="o.sample_id.approved_by.name or o.signatory_name"/>
                                    <br/>
                                    (<span t-esc="o.signatory_designation"/>)
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="annexure-page">
                        <div class="annexure-title">
                            Annexure I
                        </div>
                        <div class="annexure-subtitle">
                            (TEST READINGS)
                        </div>
                    </div>

                    <!-- ═════ TABLE 2 : DIAL GAUGE READING (LOADING & UNLOADING) ═════ -->
                    <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0;">TABLE 2 : DIAL GAUGE READING (LOADING &amp; UNLOADING)</h3>
                    <table style="width:100%; border-collapse:collapse; font-size:8pt;">
                        <thead>
                            <tr style="background-color:#244061; color:#ffffff;">
                                <th style="border:1px solid #000; padding:2px;">Date</th>
                                <th style="border:1px solid #000; padding:2px;">Time</th>
                                <th style="border:1px solid #000; padding:2px;">Load (Tonne)</th>
                                <th style="border:1px solid #000; padding:2px;">Applied Pressure (kg/cm<sup>2</sup>)</th>
                                <th style="border:1px solid #000; padding:2px;">Pressure under plate (t/m<sup>2</sup>)</th>
                                <th style="border:1px solid #000; padding:2px;">Dial A (mm)</th>
                                <th style="border:1px solid #000; padding:2px;">Dial B (mm)</th>
                                <th style="border:1px solid #000; padding:2px;">Dial C (mm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color:#d9e1f2; font-weight:bold;">
                                <td style="border:1px solid #000; padding:2px; text-align:center;" colspan="8">LOADING</td>
                            </tr>
                            <tr t-foreach="o.loading_reading_ids" t-as="r">
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.reading_date_str"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.reading_time_str"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.load_tonne"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.applied_pressure"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.pressure_under_plate"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.dial_a"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.dial_b"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.dial_c"/>
                                </td>
                            </tr>
                            <tr style="background-color:#d9e1f2; font-weight:bold;">
                                <td style="border:1px solid #000; padding:2px; text-align:center;" colspan="8">UNLOADING</td>
                            </tr>
                            <tr t-foreach="o.unloading_reading_ids" t-as="r">
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.reading_date_str"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.reading_time_str"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.load_tonne"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.applied_pressure"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.pressure_under_plate"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.dial_a"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.dial_b"/>
                                </td>
                                <td style="border:1px solid #000; padding:2px; text-align:center;">
                                    <span t-esc="r.dial_c"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="annexure-page">
                        <div class="annexure-title">
                            Annexure II
                        </div>
                        <div class="annexure-subtitle">
                            (LOAD VS. DEFLECTION PLOT)
                        </div>
                    </div>

                    <div style="page-break-before: always;"></div>

                    <!-- ═════ TABLE 2A(i) : LOAD VS SETTLEMENT SUMMARY ═════ -->
                    <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0;">LOAD ON PLATE vs AVERAGE SETTLEMENT vs CUMULATIVE SETTLEMENT</h3>
                    <table style="width:100%; border-collapse:collapse; font-size:10pt;">
                        <thead>
                            <tr style="background-color:#244061; color:#ffffff;">
                                <th style="border:1px solid #000; padding:4px;">Sr No</th>
                                <th style="border:1px solid #000; padding:4px;">Load on Plate (t)</th>
                                <th style="border:1px solid #000; padding:4px;">Average Settlement (mm)</th>
                                <th style="border:1px solid #000; padding:4px;">Cumulative Settlement (mm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.loading_summary_ids" t-as="s">
                                <td style="border:1px solid #000; padding:4px; text-align:center;">
                                    <span t-esc="s.sequence"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:center;">
                                    <span t-esc="s.load_tonne"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:center;">
                                    <span t-esc="s.avg_settlement"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:center;">
                                    <span t-esc="s.cumulative_settlement"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ═════ LOAD - DISPLACEMENT GRAPH ═════ -->
                    <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0; text-align:center;">LOAD - DISPLACEMENT GRAPH</h3>
                    <div style="text-align:center; margin:20px 0;">
                        <img t-if="o.graph_image"
                            t-att-src="'data:image/png;base64,%s' % o.graph_image.decode('utf-8')"
                            style="width:80%; border:1px solid #cccccc;"/>
                    </div>

                    <!-- ═════ DISPLACEMENT SUMMARY ═════ -->
                    <table style="width:55%; margin:0 auto; border-collapse:collapse; font-size:10pt;">
                        <thead>
                            <tr style="background-color:#244061; color:#ffffff;">
                                <th colspan="2" style="border:1px solid #000; padding:5px 8px; text-align:center;">Displacement Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="border:1px solid #000; padding:4px 8px;">Gross Displacement</td>
                                <td style="border:1px solid #000; padding:4px 8px;"><t t-esc="o.gross_settlement"/> mm</td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #000; padding:4px 8px;">Net Displacement</td>
                                <td style="border:1px solid #000; padding:4px 8px;"><t t-esc="o.net_settlement"/> mm</td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #000; padding:4px 8px;">Rebound</td>
                                <td style="border:1px solid #000; padding:4px 8px;"><t t-esc="o.rebound"/> mm</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="annexure-page">
                        <div class="annexure-title">
                            Annexure III
                        </div>
                        <div class="annexure-subtitle">
                            (SITE PHOTOGRAPHS)
                        </div>
                    </div>

                    <div style="page-break-before: always;"></div>

                    <!-- ═════ SITE PHOTOGRAPHS ═════ -->
                    <h3 style="font-size:11pt; font-weight:bold; margin:14px 0 6px 0;">SITE PHOTOGRAPHS</h3>
                    <t t-foreach="o.site_image_ids" t-as="img">
                        <div style="margin:16px 0; text-align:center;">
                            <img t-att-src="'data:image/png;base64,%s' % img.image.decode('utf-8')"
                                t-att-alt="img.caption"
                                style="width:60%; border:1px solid #ccc;"/>
                            <p style="text-align:center;"><span t-esc="img.caption"/></p>
                        </div>
                    </t>

                    <p class="end-of-report">*END OF REPORT*</p>

                </div>
            </main>
            </t>
        </t>
    </template>

</odoo>
