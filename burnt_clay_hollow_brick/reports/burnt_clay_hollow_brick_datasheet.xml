<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="bchb_datasheet">
        <t t-call="web.html_container"> 
            <t t-call="lerm_civil.mechanical_data_sheet_header">
                <div style="text-align:center;font-size:18px;font-weight: bold">
                        Burn Clay Hollow Brick 
                </div>
                
                <div class="container_eln" style="margin-top:5px">
                    <table style="margin-top:20px">
                        <tr cols="12">
                            
                            <td colspan="6">Job No :
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.kes_no"></span>
                            </td>
                            <td colspan="6">Test Start Date: 
                                <![CDATA[&nbsp;]]>
                                <span t-field="eln.start_date"></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6">Material: <span t-field="eln.material"></span>
                            </td>
                            <td colspan="6">Test End Date: <span t-field="eln.end_date"></span>
                            </td>
                        </tr>

                            <tr style="height:50px" cols="12">
                                <td colspan="4">Performed By :
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="eln.technician.name"/>
                                </td>
                                <td colspan="4">Witness Name :
                                    <![CDATA[&nbsp;]]>
                                    <span t-field="eln.witness_name"/>
                                </td>
                                <td colspan="4">Witness Signature :
                                    <![CDATA[&nbsp;]]>
                                    <span style='padding:20px'></span>
                                </td>
                            </tr>
                    </table>
                </div>
                
                <div class="container_eln pageSeperater" style="margin-top:5px">
                    <!-- Crushing Value -->
                    <div t-if="data.crushing_visible" style="margin-top:20px;">
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 15px;">
                            Crushing Value
                        </div>

                        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                            <thead>
                                <tr style="background-color: #f0f0f0; text-align: center;">
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Sr No.</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Mould + Aggregate (W1)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight of Empty Mould (W2)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Weight Passing 2.36 mm Sieve (W3)</th>
                                    <th style="border: 1px solid #ccc; padding: 8px;" colspan="2">Aggregate Crushing Value (A.C.V) = W3/(W1-W2)x 100</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="k" t-value="0"/>
                                <tr t-foreach="data.crushing_value_child_lines" t-as="r" style="text-align: center;">
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
                                        <span t-esc="k + 1" />
                                        <t t-set="k" t-value="k+1"/>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
                                        <span t-esc="r['w1']"/>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
                                        <span t-esc="r['w2']"/>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
                                        <span t-esc="r['w3']" />
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;" colspan="2">
                                        <span t-esc="r['acv']" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table style="margin-top: 20px; width: 100%; border-collapse: collapse; font-size: 14px;">
                            <tr style="font-weight: bold; background-color: #f9f9f9;">
                                <td colspan="6" style="text-align: right; padding: 8px; border: 1px solid #ccc;">Average Crushing Value (%) :</td>
                                <td colspan="6" style="padding: 8px; border: 1px solid #ccc;">
                                    <span t-field="data.average_crushing_value"/>
                                </td>
                            </tr>
                        </table>

                        <t t-set="prepared_by_obj" t-value="env['eln.parameters.result'].search([('eln_id','=', eln.id), ('parameter.internal_id','=','ea70f185-651e-456c-83ec-253420b76855')], limit=1).technician"/>
                        <div class="signatureContainer noPageBreak girdgird">
                            <div>
                                <div>
                                    <b>Prepared By</b>
                                </div>
                                <div style="height: 40px;">
                                    <t t-if="eln.tested_by_signature_datasheet and prepared_by_obj">
                                        <div t-if="prepared_by_obj.employee_id.signature">
                                            <img t-att-src="'data:image/png;base64,%s' % prepared_by_obj.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;" />
                                        </div>
                                    </t>
                                </div>
                                <div>
                                    <b>
                                        <span t-esc="prepared_by_obj.name or ''" />
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="prepared_by_obj.job_title or ''"/>)
                                    </b>
                                </div>
                            </div>
                            <div style="margin-left:600px">
                                <div>
                                    <b>Checked By</b>
                                </div>
                                <div style="height: 40px;">
                                    <t t-if="eln.sample_id.checked_by_signature_datasheet">
                                        <div t-if="eln.sample_id.check_by.employee_id.signature">
                                            <img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;" />
                                        </div>
                                    </t>
                                </div>
                                <div>
                                    <b>
                                        <span t-esc="eln.sample_id.approved_by.name"/>
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="eln.sample_id.approved_by.job_title"/>)
                                    </b>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dimension -->
                    <div t-if="data.dimension_visible" style="margin-top:20px;">
                        <div style="text-align:center;font-size:18px">
                            <span t-field="env['lerm.parameter.master'].sudo().search([('internal_id','=','65a8f5a6-5915-49b9-8fdd-70dc724bab58')]).parameter_name" />
                            <span>
                                <t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','65a8f5a6-5915-49b9-8fdd-70dc724bab58')]).parameter_table" t-as="parameter">
                                    <t t-if="parameter.grade.id == eln.grade_id.id">
                                        <span t-field="parameter.specification" />
                                    </t>
                                </t>
                            </span>
                        </div>
                        <table style="margin-top:20px">
                            <thead>
                                <tr cols="12">
                                    <td style="text-align:center;">Sr No</td>
                                    <td style="text-align:center;">Length</td>
                                    <td style="text-align:center;">Width</td>
                                    <td style="text-align:center;">Height</td>
                                    <td style="text-align:center;">Cross Sectional Area</td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0" />
                                <tr t-foreach="data.dimension_child_lines" t-as="r">
                                    <td style="text-align:center;">
                                        <div>
                                            <span t-esc="i + 1" />
                                            <t t-set="i" t-value="i+1" />
                                        </div>
                                    </td>
                                    <td style="text-align:center;">
                                        <span t-esc="r['length']" />
                                    </td>
                                    <td style="text-align:center;">
                                        <span t-esc="r['width']" />
                                    </td>
                                    <td style="text-align:center;">
                                        <span t-esc="r['height']" />
                                    </td>
                                    <td style="text-align:center;">
                                        <span t-esc="r['area']" t-options='{"widget": "float", "precision": 2}' />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="margin-top:2px">
                            <tr>
                                <td colspan="6">Average Length</td>
                                <td colspan="6">
                                    <span t-field="data.avg_length" t-options='{"widget": "float", "precision": 2}' />
                                </td>
                                <td colspan="6">Average Width</td>
                                <td colspan="6">
                                    <span t-field="data.avg_width" t-options='{"widget": "float", "precision": 2}' />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">Average Height</td>
                                <td colspan="6">
                                    <span t-field="data.avg_height" t-options='{"widget": "float", "precision": 2}' />
                                </td>
                                <td colspan="6">Average Cross Sectional Area</td>
                                <td colspan="6">
                                    <span t-field="data.avg_area" t-options='{"widget": "float", "precision": 2}' />
                                </td>
                            </tr>
                        </table>
                        <t t-set="prepared_by_obj" t-value="env['eln.parameters.result'].search([('eln_id','=', eln.id), ('parameter.internal_id','=','65a8f5a6-5915-49b9-8fdd-70dc724bab58')], limit=1).technician"/>
                        <div class="signatureContainer noPageBreak girdgird">
                            <div>
                                <div>
                                    <b>Prepared By</b>
                                </div>
                                <div style="height: 40px;">
                                    <t t-if="eln.tested_by_signature_datasheet and prepared_by_obj">
                                        <div t-if="prepared_by_obj.employee_id.signature">
                                            <img t-att-src="'data:image/png;base64,%s' % prepared_by_obj.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;" />
                                        </div>
                                    </t>
                                </div>
                                <div>
                                    <b>
                                        <span t-esc="prepared_by_obj.name or ''" />
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="prepared_by_obj.job_title or ''"/>)
                                    </b>
                                </div>
                            </div>
                            <div style="margin-left:600px">
                                <div>
                                    <b>Checked By</b>
                                </div>
                                <div style="height: 40px;">
                                    <t t-if="eln.sample_id.checked_by_signature_datasheet">
                                        <div t-if="eln.sample_id.check_by.employee_id.signature">
                                            <img t-att-src="'data:image/png;base64,' + eln.sample_id.check_by.employee_id.signature.decode('utf-8')" style="max-width: 200px;max-height: 35px;margin-top:1px; z-index: -10;" />
                                        </div>
                                    </t>
                                </div>
                                <div>
                                    <b>
                                        <span t-esc="eln.sample_id.approved_by.name"/>
                                    </b>
                                </div>
                                <div>
                                    <b>
                                        (<span t-esc="eln.sample_id.approved_by.job_title"/>)
                                    </b>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
