                                          <t t-set="dimension" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','ae2b8807-7dfa-408f-8a3c-898129521768')])"/>
                                          <t t-foreach="dimension.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                      </td>
                                  </t>

								  <!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" width="20%">
                                         <t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','ae2b8807-7dfa-408f-8a3c-898129521768')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
                                      </td>
                                  </t>
								</tr>
								
								
							</tbody>
						</table>

						</div>


