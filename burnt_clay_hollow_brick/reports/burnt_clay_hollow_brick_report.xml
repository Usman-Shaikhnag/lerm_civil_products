								<tr t-foreach="data.dimension_lines" t-as="r" style="text-align: center;">
									<td style="text-align:center;border: 1px solid black; padding: 2px;" width="200">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; " width="20%">
                                          <span t-field="data.avrg_length" t-options='{"widget": "float", "precision": 2}'/>
