								      <t t-if="o.sample_id.location_name">
											 <span t-field="o.sample_id.location_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td style="font-size:16px;" colspan="1">Sample ID  :-</td>
								<td style="font-size:16px;" colspan="1">

								  <t t-if="o.sample_id.client_sample_id">
											<span t-field="o.sample_id.client_sample_id"/>
										</t>
									<t t-else="">-</t>
								
								</td>
                                </tr>

							
							<tr>
								<td style="font-size:16px;" colspan="1">Samples Description :-</td>
								<td style="font-size:16px;" colspan="1">
								      <t t-if="o.material and o.material.lab_name or o.sample_id.size_id">
											<span t-field="o.sample_id.size_id"/> <![CDATA[&nbsp;]]> <![CDATA[&nbsp;]]> <span t-field="o.material.lab_name"/>
										</t>
									<t t-else="">--</t>
								</td>

                                <td style="font-size:16px;" colspan="1">Date of Receipt :-</td>
								<td style="font-size:16px;" colspan="1">

								  <t t-if="o.sample_id.sample_received_date">
											<span t-field="o.sample_id.sample_received_date"/>
										</t>
									<t t-else="">--</t>
								
								</td>
							</tr>

							<tr>
								<td style="font-size:16px;" colspan="1">#Source of Sample	 :-</td>
								<td style="font-size:16px;" colspan="1">
								<span t-field="o.sample_id.source_of_sample"/>
								</td>

								<td style="font-size:16px;" colspan="1">Date of Performance of Test :-</td>
								<td style="font-size:16px;" colspan="1">
									<t t-if="o.start_date and o.end_date">
											<span t-field="o.start_date"/><![CDATA[&nbsp;]]> to <![CDATA[&nbsp;]]> <span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
								</td>
							</tr>

							<tr>
								<!-- <td colspan="1">Condition of Sample  :-</td>
								<td colspan="1">
									<span t-field="o.sample_id.sample_condition"/>
								</td> -->

								<td style="font-size:16px;" colspan="1">Discipline  :-</td>
								<td style="font-size:16px;" colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>

									<td style="font-size:16px;" colspan="1">Date of Report Issue :-</td>
										<td style="font-size:16px;" colspan="1" >
											<t t-if="o.end_date">
											<span t-field="o.end_date"/>
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr>

                            <!-- <tr>
								<td colspan="1">Discipline  :-</td>
								<td colspan="1">
									<t t-if="o.sample_id.group_id">
											<span t-field="o.sample_id.group_id"/>
										</t>
									<t t-else="">-</t>
								</td>

									<td colspan="1">Test Method Followed :-</td>
										<td colspan="1" >
											<t t-if="o.material.test_method_adopted">
											<span t-field="o.material.test_method_adopted"/>
										</t>
									    <t t-else="">-</t>
										</td>
								
							</tr> -->

                            <!-- <tr>
									<td colspan="1">Temperature :-</td>
										<td colspan="1" >
											<t t-if="data.data_temperature is not None">
											<span t-field="data.data_temperature"/>   °C
										</t>
									<t t-else="">-</t>
										</td>

									<td colspan="1">Humidity :-</td>
										<td colspan="1" >
											<t t-if="data.data_humidity is not None">
											<span t-field="data.data_humidity"/>   °C
										</t>
									<t t-else="">-</t>
										</td>
								
							</tr> -->
							

                            <tr>
								<td style="font-size:16px;" colspan="1">Reference No.  :-</td>
								<td style="font-size:16px;" colspan="3">
									<t t-if="o.srf_id.client_refrence">
											<span t-field="o.srf_id.client_refrence"/>
										</t>
									<t t-else="">-</t>
								</td>
								
							</tr>

							</table>
					</div>


					<!-- 1 Compressive strength  -->

					<div  t-if="data.compressive_strength_visible and (data.comp_strength_nabl == 'pass' and nabl or (data.comp_strength_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)" style="page-break-inside: avoid;">
				     	<div style="text-align: center; font-size: 22px; font-weight: bold; margin-bottom: 10px;margin-top: 20px;">
							Compressive Strength
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size:16px;">
							<thead>
								<tr style="text-align: center;">
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;" width="10%">Sr No.</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;vertical-align: middle;"  width="20%">Compressive Strength (N/mm2)</th>
									<th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"   width="20%">
									  Average Compressive Strength (N/mm²)
                                     </th>
									 <th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"   width="25%">
									  Specifications
                                     </th>
									 <th style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"  width="25%">
									  Test Method
                                     </th>
								</tr>
							</thead>
							
							<tbody>
								<t t-set="k" t-value="0"/>
								<t t-set="total_rows" t-value="len(data.compressive_strength_lines)"/>
								<tr t-foreach="data.compressive_strength_lines" t-as="r" style="text-align: center;">
									<td style="text-align:center;border: 1px solid black; padding: 6px;" width="10%">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" width="20%">
										<span t-esc="r['comp_strength_1']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; " width="20%">
                                          <span t-field="data.avrg_compressive_strength" t-options='{"widget": "float", "precision": 2}'/>
                                      </td>
                                  </t>

								  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" width="25%">
									     <t t-set="compressive" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','9418326f-da29-405e-97ff-db38ed227b16')])"/>
                                          <t t-foreach="compressive.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                      </td>
                                  </t>
								  <!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" width="25%">
                                         <t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','9418326f-da29-405e-97ff-db38ed227b16')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
                                      </td>
                                  </t>
								</tr>
								
								
							</tbody>
						</table>

						</div>


						<!-- Water Absorption  -->

						<style>
    table th, table td {
        font-size: 16px !important;
    }
</style>

					<div  t-if="data.water_absorbtion_visible and (data.water_absorption_nabl == 'pass' and nabl or (data.water_absorption_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)" style="page-break-inside: avoid;">
					<div style="text-align: center; font-size: 22px; font-weight: bold; margin-bottom: 10px;margin-top: 20px;page-break-inside: avoid !important;break-inside: avoid !important;">
							Water Absorption
