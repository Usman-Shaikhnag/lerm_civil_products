					<t t-if="data.efflorescence_visible and ((data.report_type == 'nabl' and nabl) or (data.report_type == 'non_nabl' and not nabl))">

					<div  t-if="data.efflorescence_visible" style="page-break-inside: avoid !important;break-inside: avoid !important;">
