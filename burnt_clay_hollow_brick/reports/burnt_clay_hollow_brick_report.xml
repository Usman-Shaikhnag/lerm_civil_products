									<td style="text-align:center;border: 1px solid black; padding: 6px;" width="10%">
										<span t-esc="k + 1" />
										<t t-set="k" t-value="k+1"/>
									</td>
									<td style="text-align:center;border: 1px solid black; padding: 6px;" width="20%">
										<span t-esc="r['water_absorption']" t-options='{"widget": "float", "precision": 2}'/>
									</td>
									<!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle; " width="20%">
                                          <span t-field="data.avrg_water_absorption" t-options='{"widget": "float", "precision": 2}'/>
                                      </td>
                                  </t>

								  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" width="25%">
                                         <t t-set="water_" t-value="env['lerm.parameter.master'].sudo().search([('internal_id','=','f8429317-d4e2-46aa-9047-1d457a81fe50')])"/>
                                          <t t-foreach="water_.parameter_table" t-as="parameter">
                                                <t t-if="parameter.grade.id == eln.grade_id.id">
                                                    <span t-field="parameter.permissable_limit"/>
                                                </t>
                                            </t>
                                      </td>
                                  </t>
								  <!-- Average Column (ONLY once with rowspan) -->
								
                                  <t t-if="k == 1">
                                      <td t-att-rowspan="total_rows" style="border: 1px solid black; padding: 6px;text-align:center; vertical-align: middle;" width="25%">
                                          <t t-foreach="env['lerm.parameter.master'].sudo().search([('internal_id','=','f8429317-d4e2-46aa-9047-1d457a81fe50')]).parameter_table" t-as="parameter">
												<t t-if="parameter.grade.id == eln.grade_id.id">
														<span t-field="parameter.specification"/>
												</t>
											</t>
                                      </td>
                                  </t>
								</tr>
								
								
							</tbody>
						</table>

						</div>


						<!-- Dimension  -->

					<t t-set="length_nabl" t-value="(data.avrg_length_nabl == 'pass' and nabl) or ((data.avrg_length_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>

                    <t t-set="width_nabl" t-value="(data.avrg_width_nabl == 'pass' and nabl) or ((data.avrg_width_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>

                   <t t-set="height_nabl" t-value="(data.avrg_height_nabl == 'pass' and nabl) or ((data.avrg_height_nabl == 'fail' or eln.sample_id.scope != 'nabl') and not nabl)"/>

				<style>
.dimension-section {
    page-break-inside: avoid !important;
}
</style>

				   

					<div class="dimension-section"  t-if="data.dimension_visible and (length_nabl or width_nabl or height_nabl)" >
					<div style="text-align: center; font-size: 22px; font-weight: bold;margin-bottom: 10px;margin-top: 20px;page-break-inside: avoid !important;break-inside: avoid !important;">
							Dimension
						</div>

						<table style="width: 100%; border-collapse: collapse; font-size:16px;">
							<thead>
								<tr style="text-align: center;">
									<th style="text-align:center;border: 1px solid black; padding: 2px;vertical-align: middle;" width="200">Sample No</th>
									<th  style="text-align:center;border: 1px solid black; padding: 8px;width:80px;vertical-align: middle;"  width="20%">
