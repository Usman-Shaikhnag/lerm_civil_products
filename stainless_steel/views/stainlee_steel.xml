<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="stainless_steel_view" model="ir.ui.view">
        <field name="name">stainless.steel.form</field>
        <field name="model">stainless.steel</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                     <group>
                        <field name="srf_id" invisible="1"/>
                        <field name="sample_id" readonly="1"/>
                        <field name="eln_ref" readonly="1"/>
                        <!-- <field name="grade" readonly="1"/> -->
                        <field name="parameter_id" invisible="1"/>
                        <field name="eln_state" />
                    </group>
                    <!-- <group style="white-space: nowrap; width:70%;">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </group> -->

                     <style>
                        .blue-input input {
                            background-color: #d8ecff !important;   /* हलका Blue background */
                            border-color: #3b82f6 !important;        /* Blue border */ 
                        }

                        .o_list_view .o_data_cell.blue-input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                             }

                        /* Input when the cell goes into edit mode */
                        .o_list_view .o_data_cell.blue-input input {
                             background-color: #d8ecff !important;
                             border-color: #3b82f6 !important;
                            }
                    </style>


                     <div invisible="stainless_steel_visible == False" style="text-align:center">
                        <h1>
                          <field name="name" readonly="1" nolabel="1"/>
                          <field name="stainless_steel_visible" invisible='1'/>
                        </h1>
                    </div>

                     <!-- <group style="border: 2px solid black; border-collapse: collapse;width:50%" invisible="stainless_steel_visible == False">
                        <field name="requirement1"/>
                    </group> -->

                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="requirement1"></label></td>
                                    <td style="width:50%;"><field name="requirement1"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                        </div>

                        <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="requirement2"></label></td>
                                    <td style="width:50%;"><field name="requirement2"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                        </div>

                        <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="requirement3"></label></td>
                                    <td style="width:50%;"><field name="requirement3"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                        </div>


                    <div class="d-flex gap-2">
                        <table class="table table-sm o_form_table table-bordered w-50 custom_table_borders" style="width:50%;">
                            <tbody>
                                <tr>
                                    <td style="width:50%;"><label for="temperature"></label></td>
                                    <td style="width:50%;"><field name="temperature"/></td>
                                </tr>
                               
                            </tbody>
                        </table>
                        </div>
                   

                

                    <div invisible="stainless_steel_visible == False" class="mb-3">
                    <field name="child_lines"  >
                            <tree editable="bottom" class="custom_table_borders">
                             
                                <field name="serial_no" />
                                <field name="sample_identity" />
                                <field name="blank" />
                                <field name="uts" />
                                <field name="yield_sterss" />
                                <field name="elongation" />
                                <field name="bend" />
                                
                              
                            </tree>
                    </field>
                  

                    </div>

                  

                    <notebook>

                        <page string="Notes">
                            <div class="custom_table_borders" style="margin-top: 15px;">
                                <field name="notes_id" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sr_no" width="100"/>
                                        <field name="notes"  />
                                    </tree>
                                </field>
                                
                            </div>
                        </page>

                    </notebook>

                     <button
                            type="object"
                            class="oe_highlight" 
                            name="open_eln_page"
                            string="Submit"
                            />
                </sheet>
            </form>
        </field>
        </record>

    </data>
</odoo>